<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="name" for="node" attr.name="name" attr.type="string"/>
  <key id="type" for="node" attr.name="type" attr.type="string"/>
  <key id="status" for="node" attr.name="status" attr.type="string"/>
  <key id="desc" for="node" attr.name="description" attr.type="string"/>
  <key id="label" for="edge" attr.name="label" attr.type="string"/>
  <key id="status" for="edge" attr.name="status" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <node id="北方同盟"><data key="name">北方同盟</data><data key="type">组织(联盟)</data><data key="status">provisional</data><data key="desc">将视线挪往北方定睛一看，便可观察到正在撤退当中的『北方同盟』的大军。；「回到正题吧，我就是依靠使徒勒伽西的力量构筑出了覆盖大陆的魔法阵。毕竟是千年前的东西，效果极为强力。『北方同盟』必将败北。一切顺利哦。」</data></node>
    <node id="『龙之咆哮』"><data key="name">『龙之咆哮』</data><data key="type">魔法(龙系·声)</data><data key="status">provisional</data><data key="desc">接着，它吼出一道足以震破鼓膜──不，是足以让常人听了双耳喷血的雄叫。；即使对艾尔芬里斯来说只是用于辅助的声与风也足以将我掀飞。</data></node>
    <node id="支配之王（Lord）"><data key="name">支配之王（Lord）</data><data key="type">人物/存在(北方同盟盟主·称号)</data><data key="status">provisional</data><data key="desc">因为作为北方同盟盟主的『支配之王（Lord）』将会消失；全都经由咱和涡涡他们的手；「『北方同盟』的『支配之王』会消失⋯⋯？这、这话是什么意思⋯⋯？」</data></node>
    <node id="『并列思考』"><data key="name">『并列思考』</data><data key="type">魔法(技能)</data><data key="status">provisional</data><data key="desc">失去了技能『并列思考』的我因为无法对思考进行分割，所以导致思考一旦开始加速就会停不下来。</data></node>
    <node id="钢蛛"><data key="name">钢蛛</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">像巨型蜘蛛的头目『钢蛛』和食肉植物『兜牢宫』都相当棘手——</data></node>
    <node id="过密次元的真冬"><data key="name">过密次元的真冬</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">「——『过密次元的真冬』！！」；我直接碰触防壁，对其进行干涉。打算扰乱魔法的构筑以让这堵光之墙崩坏。；理所当然的，我的『魔法相杀』没有这么容易就成功。灌注了异常大量魔力的光之墙将我的干涉弹开了。</data></node>
    <node id="次元之冬"><data key="name">次元之冬</data><data key="type">魔法(冬系妨害)</data><data key="status">provisional</data><data key="desc">「魔法『次元之冬』！」；少女释放出的柔和之风，跟我的『次元之冬』非常相似。；我加强了身上『次元之冬』的力量，试图抵抗这股暴风，但是效果平平。</data></node>
    <node id="维斯•海利普洛佩"><data key="name">维斯•海利普洛佩</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">最后维斯牺牲，我与莱纳联手终于得以战胜仇敌。；经过维斯的调解，我们两个现在应该能做到齐心协力。；再加上对维斯的魔力和灵魂的吸收，他各项属性的数值都有了飞跃性的提升。</data></node>
    <node id="六十层"><data key="name">六十层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">这之后，诺斯菲还是一样给罗德戴着高帽，迷宫攻略也由此一帆风顺。越接近六十层，没有战意的光属性怪物越多，所以攻略一直都是越来越轻松。；我和莱纳就这么丝毫没有消费HP和MP便抵达了六十层。；到了这里的话，基本上以后就没有难关了吧。毕竟越往上走，迷宫的难度就会越低。</data></node>
    <node id="『维度』"><data key="name">『维度』</data><data key="type">技能(涡波固有)</data><data key="status">provisional</data><data key="desc">我连忙调整『维度』以便听不到她们这段秘密交涉。；而且我也想把这作为模范展示给斯诺看。也许我和莉帕都保持这种尊重他人隐私的态度的话，总有一天斯诺也能停止自己的窃听行为吧。；低阶层的要吐不平的岩石表面不同，还有某些墙壁发着光，复杂的迷宫之中『维度』成为了关键。</data></node>
    <node id="捩菖蒲"><data key="name">捩菖蒲</data><data key="type">魔法(次元魔术)</data><data key="status">provisional</data><data key="desc">「啊A──，Ci、次元魔术──『捩菖蒲』！！」；接着，透明的魔力绽放，化作了一朵花。；两者方一接触，冰蛇便遭到捩转扭曲，一瞬间便破碎、四散开来。</data></node>
    <node id="DeepDurahan"><data key="name">DeepDurahan</data><data key="type">人物(世界奉还阵召唤怪物)</data><data key="status">provisional</data><data key="desc">DeepDurahan Rank45——；然而DeepDurahan的铠甲却弹反了玛利亚的炎剑。牵动战车的战马们也丝毫不介意足以熔断钢铁的火焰。；「了不得啊。真不愧是杀掉了那位大姐一次的恶魔。感觉多叫点这家伙出来的话就能搞定了呢」</data></node>
    <node id="罗德•缇缇"><data key="name">罗德•缇缇</data><data key="type">人物(守护者·风之理的盗窃者)</data><data key="status">provisional</data><data key="desc">刚一醒过来，我便遭遇了『风之理的盗窃者』罗德•缇缇；不同于『火之理的盗窃者』阿尔缇和『木之理的盗窃者』艾德，罗德看上去并没有什么隐瞒。；她是一个水准在缇亚和玛利亚之上的魔法使。</data></node>
    <node id="隐居的老夫妇"><data key="name">隐居的老夫妇</data><data key="type">人物(罗德养亲·兽人)</data><data key="status">provisional</data><data key="desc">在大陆北方的边境出生，被双亲舍弃，再被一对隐居的老夫妇收养便是她物语的开始。；在丧尽天良的南军士兵的加害下，老夫妇失去了生命。；以某个草原上的一间小屋为背景，兽人老爷爷和老奶奶开心地笑着。</data></node>
    <node id="基督·欧亚"><data key="name">基督·欧亚</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">你就是基督·欧亚？；「是的，我就是基督，是这里的店员。」；应该有一个叫基督的家伙在这里打工吧？</data></node>
    <node id="赛莉"><data key="name">赛莉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「会、会长！这不是会长嘛！果然是要回到『史诗探索者』了是吗！？是这么回事对吧！？」；防御力3对魔力3；小女孩──赛莉酱注意到了访客，冲着我喊道。</data></node>
    <node id="魔石『门』的戒指"><data key="name">魔石『门』的戒指</data><data key="type">物品(魔石道具)</data><data key="status">provisional</data><data key="desc">【魔石『门』的戒指】寄宿着『门』的力量的戒指；在我的目送下，海莉使用仅有的魔力捏碎了戒指。接着，一连串的魔法构筑便造出了魔法门。</data></node>
    <node id="Torsion"><data key="name">Torsion</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">『Torsion』虽然能造出次元之花但杀伤力极低，『DistanceMute』就连将食指伸入无机物中都很费力。</data></node>
    <node id="缇莉·琉克"><data key="name">缇莉·琉克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：缇莉·琉克HP212/222MP201/205职业：魔法使；那么，在那些贵族当中不得不认真对待的，就是刚才谈到的希达尔克家了，也就是俗称的四大贵族之一。概而言之，赫勒比勒夏因、希达尔克、沃克、阿雷亚斯、在这四个姓氏面前可一定得恭顺些啊。；真怀念啊。以前，格连还在『史诗探索者』的那个时候，我在公会还居于末席呢，不过直到现在我还是能记起那时候的情景啊。在优秀却弱势的格连身后，斯诺一直都在发牢骚呢。</data></node>
    <node id="技能『魔法战斗』"><data key="name">技能『魔法战斗』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">我回想起昨天与战斗专家拉丝缇娅拉的训练中，自己学会了『魔法战斗』这个技能。；编织1.07诈术1.34魔法战斗0.72锻冶0.69</data></node>
    <node id="甲壳海妖"><data key="name">甲壳海妖</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">【怪物】甲壳海妖：位阶7</data></node>
    <node id="Light・幻影（Phantom）"><data key="name">Light・幻影（Phantom）</data><data key="type">魔法(光属性·诺斯菲)</data><data key="status">provisional</data><data key="desc">「光魔法『Light・幻影（Phantom）』」；而LizardFlyer丝毫没有犹豫地继续在闪光中突进，并用它们那锋利的翅膀将诺斯菲的身体斩断──看上去似乎如此，但实际上却像是穿过了三维影像一样掠过了她的身体。</data></node>
    <node id="阿雷亚斯流共鸣剑术"><data key="name">阿雷亚斯流共鸣剑术</data><data key="type">技能(剑技·共鸣)</data><data key="status">provisional</data><data key="desc">这是只有我们两人才能使出的剑技，是只有使用相同的『剑术』才能实现的同调，是只有以同一个人为师才能做到的共鸣。虽然不能说是共鸣魔法，但是亦可以称之为共鸣剑术，感觉到这一点，我喊道：；「──阿雷亚斯流共鸣剑术！『雪风』！！」；喊出我想好的台词之后，蜈蚣的躯体便在斩击之下零零散散地坠落到地面。</data></node>
    <node id="火犬"><data key="name">火犬</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">火犬：位阶17；数量近百的怪物们仍然健在。</data></node>
    <node id="连接"><data key="name">连接</data><data key="type">魔法(据点设置)</data><data key="status">provisional</data><data key="desc">「⋯⋯那么，请您至少前进到通往五十六层的阶梯吧。阶梯附近的怪物数量应该最少，在那里的话，我想应该可以安全地使用『连接』」；「终于到了。这附近的话应该是安全的吧。──魔法『连接』」；在我生成紫色的门扉之后，诺斯菲接着我立刻使用出别种魔法。</data></node>
    <node id="缇亚"><data key="name">缇亚</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「所以说，你口中的大小姐是谁，是缇亚吗？」；反正我也不相信缇亚说自己是男性的主张；「我知道了。我的名字叫缇亚，没有姓氏。仅仅只是缇亚而已，随便你怎么称呼都行。」</data></node>
    <node id="巨型西瓜虫"><data key="name">巨型西瓜虫</data><data key="type">人物(本土大型怪物)</data><data key="status">provisional</data><data key="desc">『维度』感知到了庞大的体积和魔力，我无奈之下只好换了条路继续前进。；这次看到的是巨型的西瓜虫一样的家伙。；『维度』发现的巨型西瓜虫的行动带有鲜明的目的性。</data></node>
    <node id="次元决战演算『先谭』"><data key="name">次元决战演算『先谭』</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">次元魔术！──『次元决战演算『先谭』』！！」；──我能够认知到的次元的数量增加了一个。；『次元决战演算『先谭』』完全预测出了帕林库洛接下来的动作。</data></node>
    <node id="狂怒者"><data key="name">狂怒者</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">大型怪物是全身上下都长满了黑色体毛的、四手四脚的异形大猩猩·狂怒者。</data></node>
    <node id="光之御旗（NosfyFlag）"><data key="name">光之御旗（NosfyFlag）</data><data key="type">魔法(魅惑之光·先天咒术式)</data><data key="status">provisional</data><data key="desc">「⋯⋯生前的我，因为身体里被先天性地植入了某个咒术式的缘故，所以处于一种时常向周围散布某种『咒术』的状态。不过现在我已经可以对该种咒术进行控制了。看来正如涡波大人预言的那样，在成为守护者的过程中得到了一定的净化呢」；很不可思议地，这道光中蕴含的力量仿佛可以将一切都吸纳进去。；「是带有魅惑力量的光。我就是依靠这道光统率南方的士兵们的」</data></node>
    <node id="缇达・兰斯"><data key="name">缇达・兰斯</data><data key="type">人物(千年前·守护骑士)</data><data key="status">provisional</data><data key="desc">以及那名少女的骑士缇达・兰斯、诺文・阿雷亚斯、法芙纳・赫勒比勒夏因。；似乎缇达、诺文、法芙纳三骑士的强大在千年前也是超群绝伦的。；话是这么说，其中三分之二现在已经都变成魔石了就是。</data></node>
    <node id="技能『异邦人』"><data key="name">技能『异邦人』</data><data key="type">技能(固有)</data><data key="status">provisional</data><data key="desc">「⋯⋯没，没什么，没那回事。确实是很特殊的魔法，但也就是那样而已。让人在意的，不如说是固有技能那边吧。正体不明的技能『？？？』还有技能『异邦人』这两个」；「姑且来说，在莱文教的传承中『异邦人』这一存在，被认为是超出『理』之外的来访者⋯⋯⋯确实记载着异邦人能够更容易地抵达『理』来着」</data></node>
    <node id="勒伽西"><data key="name">勒伽西</data><data key="type">人物(使徒)</data><data key="status">provisional</data><data key="desc">就是没有在传承中留下事迹的『第三名使徒勒伽西』的记忆」；「我认为帕林库洛是为了实现使徒勒伽西的愿望而行动的。；乍一看去，只是一个衣衫褴褛的孩子。但是在那张稚嫩的面孔上，确实有几许帕林库洛和西娅的面影。</data></node>
    <node id="振动魔法"><data key="name">振动魔法</data><data key="type">魔法(斯诺使用)</data><data key="status">provisional</data><data key="desc">「嗯⋯⋯⋯稍微有点在意，就用振动魔法听了下⋯⋯」；就算展开着『维度』，但是如果不好好注意的话，就算斯诺的魔力在附近潜藏着，似乎也是没法察觉的。这次算是学到了。；「⋯⋯对了。那个，斯诺。你使用振动魔法的窃听行为能不能戒掉呢？我觉得那么做有点不太好」</data></node>
    <node id="RioshethEagle"><data key="name">RioshethEagle</data><data key="type">怪物(五十五层断崖带·鸟型)</data><data key="status">provisional</data><data key="desc">「怪物」RioshethEagle：级别53；和二十层附近的里约鹰的名字很像。不出意外应该是它的上位种。；悬崖边的战斗没办法回收魔石让人不开心，我们继续应对着敌人的袭击。和里约鹰一样有着呼唤同伴的特性。结果我们最后不得不把周围的RioshethEagle全部打倒。</data></node>
    <node id="阿雷亚斯家的宝剑诺文"><data key="name">阿雷亚斯家的宝剑诺文</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">我看向『阿雷亚斯家的宝剑诺文』和玛利亚。；现在这里有『地之理的盗窃者』和『火之理的盗窃者』的魔石。；我一边苦笑，一边让她看向挂在我腰间的『阿雷亚斯家的宝剑诺文』。</data></node>
    <node id="西娅"><data key="name">西娅</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「非常感谢，真的非常感谢！我还以为接下来要作为奴隶度过后半生了呢！刚巧我正决定要怀抱着希望迎接奴隶生活的时候，你就来救我了!!」；「……等等。为什么你会认识勒伽西家的『人柱』？」；尽管给我一种与『魔石人类』相似的异样感，但是她的状态栏上并没有『素体』二字。</data></node>
    <node id="Growth"><data key="name">Growth</data><data key="type">魔法(强化·辅助)</data><data key="status">provisional</data><data key="desc">把魔法的效果进一步增强吧。——『Growth』『SensePress』『BranchwoodSheild』。；一口气就构筑出了三道魔法。接着祖母绿色的魔力便浸透了二人的身体。；「虽然不利于教育，但是事情到这一步也没有别的办法。鄙人也参战好了。把魔法的效果进一步增强吧。──『Growth』『SensePress』『BranchwoodSheild』」</data></node>
    <node id="五十六层"><data key="name">五十六层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">「⋯⋯那么，请您至少前进到通往五十六层的阶梯吧。阶梯附近的怪物数量应该最少，在那里的话，我想应该可以安全地使用『连接』」；不到一个小时之后，我们就找到了通往五十六层的阶梯。接着，我在那附近挑了个合适的场所使用魔法。；如果她的话不假，那么有这个『连接』和『一再反转之光』的组合，通往五十六层的折跃点就可以确保了。</data></node>
    <node id="Sehr・Wind"><data key="name">Sehr・Wind</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">一阵疾风向敌人袭去。对使用翅膀飞舞在空中的生物来说，这是一道绝对无法忽视的风之奔流。；莱纳的『Sehr・Wind』便遭到了『魔法相杀』；尽管是情急之下胡乱构筑的魔法，但依靠消耗掉一个作为魔法道具的戒指，总算是勉强形成了暴风形态的攻击魔法。</data></node>
    <node id="PiercePigeon"><data key="name">PiercePigeon</data><data key="type">人物(迷宫62层怪物)</data><data key="status">provisional</data><data key="desc">【怪物】PiercePigeon：位阶60；PiercePigeon自由自在地漫步着。就像水族馆里的鱼一样，即使看到了我们也没有改变自己的步调无忧无虑地走来走去。；「怪物」PiercePigeon：级别60</data></node>
    <node id="转光枪（Brionac）"><data key="name">转光枪（Brionac）</data><data key="type">武器(光属性·长枪)</data><data key="status">provisional</data><data key="desc">「是的，就是『妹妹』唷。⋯⋯那么，我先用枪好了。再来就是『转光枪（Brionac）』」；罗德对诺斯菲喊自己姐姐一事感到雀跃，诺斯菲则莞尔一笑。接着，她在光之棒的前端附上枪刃，将武器作成长枪的模样。</data></node>
    <node id="艾利巴茨·利拜斯"><data key="name">艾利巴茨·利拜斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「艾利巴茨·利拜斯。真愧你记得呢。；「依靠现有的预算和目前动员的人数，到明天晚上就能完工了。我一定会让它顺利完工的。」；「还有的话……对了，你去哪里买点木棒带着比较好。算是给斯诺使用的武器。反正给她用的迟早都会损毁，使用木棒战斗比较经济。并且听你说的，对付水晶系的怪物打击似乎很有效的样子。」</data></node>
    <node id="缇娅拉"><data key="name">缇娅拉</data><data key="type">人物(传说·圣人/莱文教缔造者)</data><data key="status">provisional</data><data key="desc">但是因为圣人『缇娅拉』非常非常强，所以只用一根手指就给它们全撂倒了。；圣人『缇娅拉』构筑了魔法的基础，并缔造了莱文教。使徒西斯带着一同战斗的英雄们巡回各地播撒着奇迹。；在那之后，圣人缇娅拉甚至还缔造出一大宗教，企图进行自己的『再诞』。执念如此之深的人，根本不可能会给后人留下正确的历史记载。</data></node>
    <node id="技能『锻冶』"><data key="name">技能『锻冶』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">只要在这里，从现在开始，与锻冶技术的专家们比试一番，学会技能『锻冶』就行了。；编织1.07诈术1.34魔法战斗0.72锻冶0.69；但是，确认了自己的状态之后，确实看到了『锻冶』这一项的增加。</data></node>
    <node id="公会"><data key="name">公会</data><data key="type">设施(情报收集场所)</data><data key="status">provisional</data><data key="desc">首先是要去酒馆或者公会收集情报吗！？；太好了，幸好没去什么酒馆和公会收集情报……</data></node>
    <node id="TauzSchuss·Wind"><data key="name">TauzSchuss·Wind</data><data key="type">技能(莱纳·风魔法)</data><data key="status">provisional</data><data key="desc">——『天路垂临』『续道碧霄』——！；千年前的大魔法于此重现。；——风魔法『TauzSchuss·Wind』！！</data></node>
    <node id="相川阳滝"><data key="name">相川阳滝</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">她是我在这世上唯一无二的妹妹，名叫相川阳滝。；阳滝罹患顽疾。；而让她变成这样的罪魁祸首则是我。</data></node>
    <node id="五十四层"><data key="name">五十四层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">惯例的微微张开『维度』掌握下一层的情况，立马突入了进去。悬崖边的战斗十分的辛苦，但是下一层应该会轻松不少。；以地上为目标的迷宫攻略让我有种奇怪的感觉，我们向着五十四层前进。这里也是由悬崖包围的特殊区域不过基本是石造的普通回廊。</data></node>
    <node id="波尔札克"><data key="name">波尔札克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">雷鲁那家伙既然有参加，那波尔札克应该也不会缺席。</data></node>
    <node id="『魔石线』"><data key="name">『魔石线』</data><data key="type">载体(世界奉还阵载体)</data><data key="status">provisional</data><data key="desc">他对作为『世界奉还阵』的载体的『魔石线』进行直接的接触、干涉、并祈愿。；──然而，『世界奉还阵』却开始了脉动。；但是，『魔石线』就像是回应了帕林库洛的愿望一样再次发光，并开始剧烈震动。</data></node>
    <node id="最深部之誓约者"><data key="name">最深部之誓约者</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">【技能『最深部之誓约者』发动了】；以特定的感情为交换使精神安定下来；与还不完善的技能『？？？』不同，技能『最深部之誓约者』能够任意调节。</data></node>
    <node id="『连接』"><data key="name">『连接』</data><data key="type">魔法(转移)</data><data key="status">provisional</data><data key="desc">开来她也经过『连接』来这边了。；一边前往设置有『连接』的办公室。；接着，海莉捏碎了一个戒指，发动魔法『连接』。魔法门显现于平原，大小甚至能容许一匹军马通过。</data></node>
    <node id="『始祖』"><data key="name">『始祖』</data><data key="type">人物(传说)</data><data key="status">provisional</data><data key="desc">被唤作『始祖』的传说级魔法使负责处理我的威胁。；她是『始祖』的最高杰作，是和我一样特化了杀人性能的存在。</data></node>
    <node id="技能『缝纫』"><data key="name">技能『缝纫』</data><data key="type">技能(生产)</data><data key="status">provisional</data><data key="desc">接着，我又回想起之前使用另一个生产技能『缝纫』时遭受的失败。；当时因为一味重视实用性的原因，让我给所有人准备的泳衣都成了茶色的土货而蒙受了惨痛的失败。塞拉那时的叱责让我至今难忘。；与之前不同，这次没有『并列思考』所以作业速度有所下滑。但能够将注意力彻底集中到一件上应该可以提高缝纫的精度。</data></node>
    <node id="BloodSword"><data key="name">BloodSword</data><data key="type">道具(迷宫拾得剑)</data><data key="status">provisional</data><data key="desc">顺带一说「BloodSword」算是寿终正寝了。果然要修复断折的刀剑没有那么简单。</data></node>
    <node id="次元斩裂剑"><data key="name">次元斩裂剑</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">「──『次元斩裂剑』！！」；这把剑，扭曲了世界。；因为被切断的刀身，就漂浮在空中，甚至没有落下。</data></node>
    <node id="帕林库洛・勒伽西"><data key="name">帕林库洛・勒伽西</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">名字：帕林库洛・勒伽西HP0／512MP392／392职业──无；接着，他用化作黑色液体的手腕刺穿了自己的胸口。这已经超越了自残行为，是彻底的自杀了。；二十守护者（TwentyGuardian）暗之理的盗窃者</data></node>
    <node id="西娅·勒伽西"><data key="name">西娅·勒伽西</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">今天也要进行迷宫探索。跟以往不同，在出现了西娅·勒伽西队伍这一对手之后，必须要提高探索的效率才行。；「说不定是海莉酱和西娅酱吧……？虽然我不觉得她那样的身体状况能在那之后这么快过来就是了……」；「就是这样，那位使徒的力量在大约十年前由我的侄女西娅继承了。」</data></node>
    <node id="藏书室"><data key="name">藏书室</data><data key="type">地点(魔王城内)</data><data key="status">provisional</data><data key="desc">穿过没有人在的食堂和大厅，我来到了藏书室前。用森严的荷包锁锁着的厚重门扉牢牢地嵌在墙壁之中。；使用从罗德那里入手的钥匙，我推开藏书室的大门。随着金属锈蚀的声音和落下的阵阵灰尘，我意识到这里已经有相当长的时间没被使用过了。；看了一眼藏书室内部的样子，我便不由地露出苦笑。要是空间狭窄和书柜林立之类倒还好说。真正的问题在于是这里就像是遭遇了地震一样，大量的书籍都掉到了地上。</data></node>
    <node id="SkyRunner"><data key="name">SkyRunner</data><data key="type">怪物(五十五层·风属性·狼型)</data><data key="status">provisional</data><data key="desc">对手的怪物是像狼一样野兽型的怪物。和一般的狼不一样的是那四只脚。并非拥有血肉的脚而是由高密集的魔力构成踏在空中走着。；「怪物」SkyRunner：级别52；察觉到袭击的SkyRunner回过头。</data></node>
    <node id="技能『神铁锻冶』"><data key="name">技能『神铁锻冶』</data><data key="type">技能(生产)</data><data key="status">provisional</data><data key="desc">不过，才刚刚接受雷纳尔多的教导学会技能『神铁锻冶』的我能做到的事情也不多。；因此，不光用上技能『锻冶』和技能『神铁锻冶』，我久违地连『缝纫』也动员上了。</data></node>
    <node id="Foam"><data key="name">Foam</data><data key="type">魔法(次元魔法)</data><data key="status">provisional</data><data key="desc">两名少女的脚边溅起水花一般的大量泡沫，形态跟次元魔法『Foam』类似。</data></node>
    <node id="形式・捩菖蒲（Torsion）"><data key="name">形式・捩菖蒲（Torsion）</data><data key="type">魔法(次元属性·涡波·攻击魔力)</data><data key="status">provisional</data><data key="desc">将始祖涡波释放的魔法『Torsion』进行再现──的程度虽然做不到，但只是模仿的话应该没有问题。；「──魔法『形式・捩菖蒲（Torsion）』！」；三秒的时间用于魔力构筑可以说足够了，我顺利地在『新月琉璃』的剑身上附着了次元的歪曲。</data></node>
    <node id="拟神之眼"><data key="name">拟神之眼</data><data key="type">技能(拉丝缇娅拉固有)</data><data key="status">provisional</data><data key="desc">「然后就是关于涡波的能力的事情了呢⋯⋯⋯感觉涡波的『表示』，要比我的『拟神之眼』级别更高啊⋯⋯」；就我来说，能够将状态的数值一直表示到小数点后两位0.00的地步。但是拉丝缇娅拉则根本看不到小数点。而且装备物品和道具也看不了。怪物这类生物的情报虽然在某种程度上能够看到，但是无机物的情报则完全得不到。；「我的话，只要看到了『异邦人』这个显示就没什么需要怀疑的了呢。不管怎么说，与莱文教有不浅关系的人，一定程度上都是知道异世界的存在的」</data></node>
    <node id="诺斯菲"><data key="name">诺斯菲</data><data key="type">人物(迷宫六十层守护者)</data><data key="status">provisional</data><data key="desc">【六十守护者（SixtyGuardian）】光之理的盗窃者；我的名字叫做诺斯菲。；我是南之『御旗』——不对，是迷宫的守护者『光之理的盗窃者』诺斯菲。</data></node>
    <node id="巨狼"><data key="name">巨狼</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">这些穿着饱负幻想性的人们正在回廊的道中央与身长足足三米的巨狼上演着酣畅的武打戏。；只听一道沉闷的声音，大剑嵌入了狼的首级。；狼浑身散发着翠绿色的光芒消失了。</data></node>
    <node id="技能『所有物』"><data key="name">技能『所有物』</data><data key="type">技能(异空间魔法)</data><data key="status">provisional</data><data key="desc">「分析魔法『表示』虽然很厉害，但是异空间魔法『所有物』更了不得啊⋯⋯」；「大概是，次元魔术和古代魔法的应用吧。那样的话应该是做得出这个效果的⋯⋯应该吧」；就定为『注视（Analyze）』『持有物品（The・Pouch）』了。</data></node>
    <node id="芬里尔・阿雷亚斯"><data key="name">芬里尔・阿雷亚斯</data><data key="type">人物(阿雷亚斯家当主·元剑圣)</data><data key="status">provisional</data><data key="desc">剑技就与身为元『剑圣』的阿雷亚斯家现任当主芬里尔・阿雷亚斯的全盛期同等了。；总之『芬里尔』也记录在我的血里，借用下他的技术学起来会不会更快呢？</data></node>
    <node id="技能『并列思考』"><data key="name">技能『并列思考』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">那就我对付一匹，另一匹交给身后三人对付好了。姑且用『并列思考』做好使用『次元之冬・终霜』的准备。；我使用『并列思考』确认着状况，并推导出最合适的理由。；我立刻将『并列思考』发挥到极限。</data></node>
    <node id="罗德"><data key="name">罗德</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">而罗德则坐在价值不菲的椅子上，以优雅的姿势品着红茶。；既然这样，那干脆就从朋友关系飞跃到家人好了！成为家人的话就没问题了吧？；也就是说，人家是姐姐，莱纳就是弟弟喽。</data></node>
    <node id="店长"><data key="name">店长</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">与店长和玲小姐他们打了个照面后；不知何时从厨房里走出来的店长正以仁王之姿站在我的身后。；不愧是接近20级的男人，即使面对那来势汹汹的一行人，店长也不让寸分。</data></node>
    <node id="始祖涡波"><data key="name">始祖涡波</data><data key="type">人物(千年前·始祖)</data><data key="status">provisional</data><data key="desc">这也是理所当然的。毕竟这名假面男子的名字就叫『涡波』啊。；「诶？啊啊，这个、那个……在我的世界里是挺常见的词来着哦，这些……」；「结果到头来，我创造的并非『魔法』而是『咒术』啊。</data></node>
    <node id="《LivingLegend》号"><data key="name">《LivingLegend》号</data><data key="type">道具(魔石船)</data><data key="status">provisional</data><data key="desc">在魔石船《LivingLegend》号的甲板上；驶向本土的航程可为一帆风顺。；在我和莉帕将船的航行稳定下来之后</data></node>
    <node id="艾尔・昆图斯"><data key="name">艾尔・昆图斯</data><data key="type">人物(新人探索者·原奴隶)</data><data key="status">provisional</data><data key="desc">他是一名比莱纳还要小的──大概也就十二岁左右的少年。名字叫艾尔・昆图斯。；理由也很简单，因为艾尔是我花钱雇来的。；我们既不曾问过你的名字，也不会去到处宣扬与你相遇过的事情。</data></node>
    <node id="猛毒火蜥蜴"><data key="name">猛毒火蜥蜴</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">「作为可以潜藏在岩浆中的代价，这个怪物的基本能力很低呢。只用一击就能打倒了。」</data></node>
    <node id="康纳·塔利亚"><data key="name">康纳·塔利亚</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「哦哦，竟然是……！恕我失礼了。在下是塔利亚家的当主、康纳·塔利亚。说到『史诗探索者』的话，难不成您是那个——」；『Dimension』告知我自己现在正握着几枚金币。</data></node>
    <node id="拉丝缇娅拉·弗茨亚茨"><data key="name">拉丝缇娅拉·弗茨亚茨</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：拉丝缇娅拉·弗茨亚茨HP735/735MP338/338职业：骑士；魔法战斗2.27血术5.00神圣魔法1.03；拉丝缇娅拉跟以前相比有些许的成长。顺带一说我把『新月琉璃』借给她用了。原因是她的爱剑、天剑『诺亚』留在了大圣堂那边。</data></node>
    <node id="珍珠鱼"><data key="name">珍珠鱼</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">珍珠鱼：位阶29</data></node>
    <node id="海因"><data key="name">海因</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">你真啰嗦啊，海因。我们现在不就应该加强戒备才对么？；「别太为难一个孩子了。这有悖我们的骑士道。」；「等、等一下，您应当避免与其他探索者的接触！」</data></node>
    <node id="王之器"><data key="name">王之器</data><data key="type">人物(艾德所称呼的战场少女)</data><data key="status">provisional</data><data key="desc">在我视线前方的，是用奇妙的植物将一名陌生的女孩子包裹起来的艾德老师。；就先确保王之器好了。反正对鄙人的计划来说涡波大人本来就不是必要的呢。；说着，艾德走近躺在远处的女孩子。</data></node>
    <node id="托尔普・特鲁克"><data key="name">托尔普・特鲁克</data><data key="type">人物(长生种·龙种)</data><data key="status">provisional</data><data key="desc">咱记得在世界树那边有作为『最后的纯血树人种』的『斯科纳・伊格德拉西尔』、以及在联合国开拓地有作为『最后的纯血龙种』的『托尔普・特鲁克』来着」</data></node>
    <node id="帕林库洛的宝剑"><data key="name">帕林库洛的宝剑</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">接着，帕林库洛缓缓地拔出了挂在腰间的宝剑。；这回不是以前那种摆设用的玩应儿了。；虽说不如『阿雷亚斯家的宝剑诺文』但是确实是大陆最高级的名剑。</data></node>
    <node id="HighSkyBeryl"><data key="name">HighSkyBeryl</data><data key="type">物品(魔石)</data><data key="status">provisional</data><data key="desc">【HighSkyBeryl】；支配天空的魔力的集合体。；掉落自最高级的风属性怪物。</data></node>
    <node id="威尔·琉克"><data key="name">威尔·琉克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「我是不会放弃的哦……威尔，格连……因为她跟你们不一样，是真正的『最强』。是我发现的希望……是我的『最强的英雄』啊……」</data></node>
    <node id="『Default』"><data key="name">『Default』</data><data key="type">魔法(次元魔术)</data><data key="status">provisional</data><data key="desc">「──魔法『Default』！」；使用新的次元魔术，我将上空的空间予以压缩。；我的身体就这样以冲天之势被掷向上空──这是完全无视物理法则的跳跃。</data></node>
    <node id="五十一层"><data key="name">五十一层</data><data key="type">地点(迷宫·空洞层)</data><data key="status">provisional</data><data key="desc">但是有问题的是之后的五十一层。；完全的空洞的层数在等着。；然后，和六十六层同样广阔的空间与高度但是──中央却没有螺旋的楼梯。</data></node>
    <node id="南军高官"><data key="name">南军高官</data><data key="type">人物(南军·无名职务称呼)</data><data key="status">provisional</data><data key="desc">在这当中，剩下最后一名级别和素质都特别突出的男子。从他那与别人不一样的军装来看，应该是一名军队的高官。；「——啊啊，啊、啊啊AaaA！将军，帕林库洛·勒伽西！全都、全都是一场骗局吗！？」；「你一开始就打算牺牲我们吗……！？」</data></node>
    <node id="技能『？？？』"><data key="name">技能『？？？』</data><data key="type">技能(固有·正体不明)</data><data key="status">provisional</data><data key="desc">「⋯⋯没，没什么，没那回事。确实是很特殊的魔法，但也就是那样而已。让人在意的，不如说是固有技能那边吧。正体不明的技能『？？？』还有技能『异邦人』这两个」；「嗯～，姆姆─，呜～嗯。⋯⋯Unknown？不行，总觉得是带有恶意的技能⋯⋯，那就恶意（ILLWILL）？就叫技能『？？？（IllWill）』怎么样！？」；顺道一说，仅仅在技能『？？？』的问题是我有所保留。为了大事化小，我只说明它会将一部分感情消除而已。</data></node>
    <node id="五十九层"><data key="name">五十九层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">正因为是六十层正上方的楼层，那阵光芒强的限制着视线。但是，我有着『维度』，风魔法使的两人也用『风』把握着物件的大概位置。不用说，有光的专家诺斯菲在这层的难易度不在话下。；但是，那些石头都闪烁的光辉这点与其他阶层不同。；仅仅只是一句话，只是这一句基础魔法，灼烧眼睛一般的光也中和的像六十层一样温和。</data></node>
    <node id="诺文"><data key="name">诺文</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">【三十守护者（ThirtyGuardian）】地之理的盗窃者；没错，如果心脏的跳动停止了，我就会完全怪物化。把那个怪物化的我打倒了，第三十之试练也就完成了。要来吗？；啊啊，是了，我的愿望是将我的剑展现给世人。这是我自幼少之时便怀抱的梦想。这一点是不会错的……唯有这个愿望是我绝对不会搞错的……</data></node>
    <node id="DarkFisher"><data key="name">DarkFisher</data><data key="type">魔法(暗系妨害)</data><data key="status">provisional</data><data key="desc">「『DarkFisher』」；帕林库洛的影子中突然伸出无数的触手。为了避免被触手碰到，我大幅度地拉开了距离躲开了这个魔法。；就是魔法构筑的速度有点太快了。而且魔力的量也有了不小的增幅。</data></node>
    <node id="莱纳"><data key="name">莱纳</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「我是莱纳。基督先生，有劳你了。；像我这种被收养来的贵族，也就只有保护姐姐大人这点儿价值了。；姓名：莱纳·赫勒比勒夏因HP142/172MP23/50职业：骑士</data></node>
    <node id="『堕落使徒』"><data key="name">『堕落使徒』</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">我记得莱纳爱用的『堕落使徒』现在处于断折的状态。虽然多亏了诺文和艾利巴茨的调整让外表还看得过去，但我打算借这个机会把那把剑也修好。；既然其他的精神污染道具都得到了修复，那『堕落使徒』应该也没有问题。；雷纳尔多将目光投向了莱纳最常使用的剑『堕落使徒』</data></node>
    <node id="白色的少女"><data key="name">白色的少女</data><data key="type">人物(魔石人类)</data><data key="status">provisional</data><data key="desc">在拉丝缇娅拉房间的床上面，横躺着一名白色的少女。；治疗的途中，拉丝缇娅拉确实要求提供数个的魔石来用。到了现在才终于明白，那名吐着鲜血的少女从『所有物』中取出魔石的真正理由。；她确实对于海因先生的名字有所反应。他们之间毫无疑问有着什么关系存在。</data></node>
    <node id="雷纳尔多·沃尔斯"><data key="name">雷纳尔多·沃尔斯</data><data key="type">人物(千年前·将军)</data><data key="status">provisional</data><data key="desc">其中就有『雷纳尔多・沃尔斯』这个名字出现。；果然那位老人在佩艾希亚名气不小。上面记载说他率军打了不少胜战。；既然如此，那是将战前数年的和平时期给再现出来了吗。不过，如果是这样又没法解释雷纳尔多的年龄。</data></node>
    <node id="艾利巴茨"><data key="name">艾利巴茨</data><data key="type">人物(锻冶师)</data><data key="status">provisional</data><data key="desc">『阿雷亚斯家的宝剑诺文』上的装饰在艾利巴茨的作品中风格还算是偏稳重那边的。；多亏在艾利巴茨那里稍稍练习过一点，基本的东西我已经掌握了。；艾利巴茨──他是这个公会专属的锻冶师。</data></node>
    <node id="三名年幼魔石人类（不同型号）"><data key="name">三名年幼魔石人类（不同型号）</data><data key="type">人物(魔石人类·群体)</data><data key="status">provisional</data><data key="desc">虽然剩下那三人似乎也是『魔石人类』，但长相并没有多相似，那么应该就是跟露洁她们不・同・型・号的了。；那三个人看上去都还年幼，级别也只有个位数，露洁能让她们待机真是万幸。；「老、老师他会死吗⋯⋯？」</data></node>
    <node id="WhiteSnake"><data key="name">WhiteSnake</data><data key="type">怪物(迷宫·白蛇)</data><data key="status">provisional</data><data key="desc">尾随其后袭来的是在地面疾行的白蛇──；「怪物」WhiteSnake：级别60；这家伙的体型也跟通常的蛇相近。而且外皮也跟PiercePigeon一样闪闪发光。</data></node>
    <node id="LivingLegend号"><data key="name">LivingLegend号</data><data key="type">载具(船)</data><data key="status">provisional</data><data key="desc">如果放到以前，斯诺现在肯定都藏到LivingLegend号的船底去了。；「在我不在的这段时间里，就拜托你保护好船上的大家了」</data></node>
    <node id="拉丝缇娅拉"><data key="name">拉丝缇娅拉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">我是在说拉丝缇娅拉大小姐；雷迪安特在报出「拉丝缇娅拉」这个名字的时候，特意将声音压低了。；虽然我自己也不知道拉丝缇娅拉所在何处</data></node>
    <node id="西娅・勒伽西"><data key="name">西娅・勒伽西</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">是个不大点儿的小女孩。跟海莉比起来要矮了一个头。；少女将栗色的头发扎成两束。她表情丰富蹦蹦跳跳地喊道。；「终，终于连通上了！太好了──！！」</data></node>
    <node id="『Firefly』"><data key="name">『Firefly』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「──我的眼睛，也看见了。缇亚，按照预定动手。──魔法『Flame・决战炎域』、『萤火』」；接着，火玉就像是活物一样动起来，飞向我感知到的怪物。；火玉在空中排列成轮状开始旋转。接着生成了无数的火轮。然后火轮伸展向怪物所在的位置，化作了炎之筒。</data></node>
    <node id="飞鱼"><data key="name">飞鱼</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">在那当中出现得尤其频繁的就是这个飞鱼了。</data></node>
    <node id="TowersSus・Wind"><data key="name">TowersSus・Wind</data><data key="type">魔法(风系大魔法)</data><data key="status">provisional</data><data key="desc">「──『千之大剑啊，咆哮怒吼吧』！」；因此，在现代已经失传的大魔法再度复苏。；六十六层的平原上随即生成了数量不计的如同高塔一般巨大的风之大剑。</data></node>
    <node id="克劳"><data key="name">克劳</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">此时此刻，我正在与老朋友克劳交谈，打算从他的嘴里套点情报出来。；克劳是我第一天在这家店工作时便结下缘份的朋友。；「喂，克劳！你丫再纠缠我家新人不放的话，小心我揍飞你哦！」</data></node>
    <node id="砂上漂"><data key="name">砂上漂</data><data key="type">人物(迷宫怪物·31层)</data><data key="status">provisional</data><data key="desc">现身的是蜘蛛形态的大型怪物。；──SandSurface级别32──；令人失望的事，在散尽的火焰中出现的，是胸口嵌着水晶弹扔坚持挣扎的SandSurface。</data></node>
    <node id="IllusionistKnight"><data key="name">IllusionistKnight</data><data key="type">怪物(迷宫·人形铠甲)</data><data key="status">provisional</data><data key="desc">此时，诺斯菲刚好结果了一匹WhiteSnake。但莱纳正与他的对手、会动的铠甲（LivingArmor）IllusionistKnight陷入胶着。；IllusionKnight的特征非常明显。它是拥有可以完全抵消物理攻击的防御力，使用一柄闪耀光芒的剑进行战斗的战士。丝毫没有能够使用魔法的迹象，一切全凭『剑术』说话。；敌人也没有放过这个空隙用剑挥出一计斜切──但、并・没・有・击・中。本应斩断莱纳身体的光芒四射的剑产生了微小的偏差。简直就像外行胡乱使出的斩击一样挥空了。</data></node>
    <node id="里约鹰"><data key="name">里约鹰</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">是鸟型的怪物。</data></node>
    <node id="史诗探索者"><data key="name">史诗探索者</data><data key="type">组织(公会)</data><data key="status">provisional</data><data key="desc">变现的协议搞定之后，从文书处理工作中解放出来的我在史诗探索者的本部内移动着。；在走向史诗探索者工房的路上，我的心情渐渐激动起来。；这孩子即使是在『史诗探索者』里，也是特别不听人说话那一类的。不过就她这样还不是最不听人说话的，这一点也正是『史诗探索者』恐怖的地方。</data></node>
    <node id="Sylph・堕落使徒"><data key="name">Sylph・堕落使徒</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">现在这把剑既具有对风属性的抗性，同时还可以减轻使用风魔法时的负担。；握在他右手上的是强化了风魔法效力的新生魔剑。；「Sylph・堕落使徒」</data></node>
    <node id="艾尔娜"><data key="name">艾尔娜</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">她的名字是艾尔娜。；「我是兽人艾尔娜，是个战士。这边这位不怎么开口的女孩子是斯诺。是斥候哦。」</data></node>
    <node id="『阿雷亚斯家的宝剑诺文』"><data key="name">『阿雷亚斯家的宝剑诺文』</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">但在那支队伍中有我的熟面孔，于是我从『所有物』中取出了『阿雷亚斯家的宝剑诺文』，接着面朝那支队伍前来的方向。；结果很简单──『阿雷亚斯家的宝剑诺文』在避开诺瓦露的脏器的情况下刺穿了她的腹部。</data></node>
    <node id="迪亚布罗·西斯"><data key="name">迪亚布罗·西斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">迪亚布罗·西斯；他自己道出的名字也跟『表示』上显示的不同。；「是基督吗！？是我、缇亚啊！！」</data></node>
    <node id="艾德"><data key="name">艾德</data><data key="type">人物(四十守护者)</data><data key="status">provisional</data><data key="desc">四十守护者（FortyGuardian）木之理的盗窃者；正是海莉她们解放的四十层的守护者。；身着跟学者一样的白衣，鼻子上还戴着跟异世界不合拍的眼镜。</data></node>
    <node id="大蜈蚣"><data key="name">大蜈蚣</data><data key="type">人物(大空洞产出怪物)</data><data key="status">provisional</data><data key="desc">「是数量的问题⋯⋯跟之前不同，这次足足出现了十匹。我想不动用数支正规部队的话是处理不了的」；所谓之前的怪物，说的是级别超过了30的在空中游走的大蜈蚣。那种级别的怪物原本是应当以人类顶尖水平的20级精锐组队才能讨伐的对手。</data></node>
    <node id="莱纳•赫勒比勒夏因"><data key="name">莱纳•赫勒比勒夏因</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：莱纳•赫勒比勒夏因HP369/369MP102/246职业：骑士；盘踞在空中的那条龙非常棘手。我已经挑战过好几次了，但是完全找不到攻略的法门。；基督由我这个风属性的骑士带着飞，用不着你跟来。</data></node>
    <node id="漩涡蚁狮"><data key="name">漩涡蚁狮</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">漩涡蚁狮：位阶29；那个洞跟下一层连接在一起，而填补那个洞的漩涡蚁狮的消失使得沙子一口气崩塌到下面去了。</data></node>
    <node id="芬里尔·阿雷亚斯"><data key="name">芬里尔·阿雷亚斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">另一个人选是冠以『剑圣』之名的男人，芬里尔·阿雷亚斯。；他跟格连在一个地方。乍一看下是个初老的长者，但身体全无衰老的迹象。哪怕不用『Dimension』，他的装着呈现的身体线条也诉说着肌肉的厚实。眼锐如鹰的他令许多贵族敬畏三分，应当是个不输格连的强者。；「在战胜了『剑圣』芬里尔·阿雷亚斯之后，他自己堂堂正正地作出了宣言。」</data></node>
    <node id="LizardFlyer"><data key="name">LizardFlyer</data><data key="type">人物(迷宫65层怪物)</data><data key="status">provisional</data><data key="desc">【怪物】LizardFlyer：位阶61；乍一看去，直径一千米内平均有十匹。；这就意味着LizardFlyer并非利用剑压避开了我们的攻击——而是一边用眼睛看着，一边活动自己的躯体避开的。</data></node>
    <node id="闪耀吧炎之剑"><data key="name">闪耀吧炎之剑</data><data key="type">魔法(火焰系奥义)</data><data key="status">provisional</data><data key="desc">火焰呈螺旋状攀升，随着体积的膨胀最终贯穿了天际。将所有降下的雨水全数蒸发，扫清覆盖在天边的乌云，代之以誓要烧尽世界的烈火。；「──『闪耀吧炎之剑』！！」；伴随着这句魔法的宣言，火焰改变了形状。变作了逆十字架的火焰继续熊熊燃烧。其姿态确实符合『剑』的定义。但是作为『剑』来说又显得过于庞大。</data></node>
    <node id="黯淡之龙"><data key="name">黯淡之龙</data><data key="type">人物(迷宫外怪物)</data><data key="status">provisional</data><data key="desc">【怪物】黯淡之龙：位阶26；感觉不到敌意。岂止如此，我甚至在龙的双眸中看到了知性的光。；但黯淡之龙并没有变成光芒消失。看来变成光消失是迷宫特有的现象。大概是迷宫被编入了相应的魔法术式吧。</data></node>
    <node id="DivineShield"><data key="name">DivineShield</data><data key="type">魔法(防壁)</data><data key="status">provisional</data><data key="desc">「——Di、『DivineShield』！！」；随即诞生的魔法防壁在毫厘之间挡下了我的双手。；虽然这股魔力的密度惊人，但这也表示西斯丧失了从容。</data></node>
    <node id="海因·赫勒比勒夏因"><data key="name">海因·赫勒比勒夏因</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「——双重展开、鲜血魔法『海因·赫勒比勒夏因』！」；与赫勒比勒夏因的剑术很像。虽然完成度相当低，但其中确实有海因·赫勒比勒夏因的影子。；「海因·赫勒比勒夏因在莱纳大人的体内？……啊啊，原来如此。</data></node>
    <node id="ColorlessUnicorn"><data key="name">ColorlessUnicorn</data><data key="type">人物(迷宫62层怪物)</data><data key="status">provisional</data><data key="desc">【怪物】ColorlessUnicorn：位阶59；之所以浑身洁白，是因为在这一层可以当做迷彩色吧。；「怪物」ColorlessUnicorn：级别59</data></node>
    <node id="斯诺"><data key="name">斯诺</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「终、终于还是到了这一天了呢……加油啊我，要上了……」；「我也去对付帕林库洛吧……我不去做的话，总觉得今后也无法前进。」</data></node>
    <node id="雷鲁·桑库斯"><data key="name">雷鲁·桑库斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">名字：雷鲁·桑库斯 HP312/322MP0/0职业：闘士；别墅崩毁了。；「只要戴着那个手环，你和妹妹就能幸福。这点我向你保证。为了实现这一点，我制定了完美的计划，足以让你成为劳拉维亚的英雄，并让你的妹妹得到幸福。」</data></node>
    <node id="暗之理的盗窃者"><data key="name">暗之理的盗窃者</data><data key="type">守护者称号(暗之理)</data><data key="status">provisional</data><data key="desc">帕林库洛那娴熟的防御能力和『暗之理的盗窃者』的特性结合在一起，实在是棘手至极。；在这个场合下，就算是打破了『地之理的盗窃者』那绝对防御能力的共鸣魔法『致亲爱的一闪』恐怕都无法成为有效的攻击手段。</data></node>
    <node id="五十层"><data key="name">五十层</data><data key="type">地点(迷宫·罗德的阶层)</data><data key="status">provisional</data><data key="desc">「这，这里就是五十层⋯⋯⋯罗德的阶层⋯⋯」；广阔的世界是一片草原。；就好像坚持这自己的风属性一般，宛如叩击身体一般的狂风吹了过来，仅此而已。</data></node>
    <node id="冰结剑·冰刃"><data key="name">冰结剑·冰刃</data><data key="type">魔法(冰结系)</data><data key="status">provisional</data><data key="desc">为了不输给莱纳的气势，我也从『所有物』中取出『新月琉璃』发动了『魔力冻结化』；「──『冰结剑・冰刃』！！」；这个名为『冰结剑・冰刃』的魔法并不单单是伸长冰剑长度那么简单，同时延伸的还有冷气。</data></node>
    <node id="Centidreadnought"><data key="name">Centidreadnought</data><data key="type">人物(怪物)</data><data key="status">provisional</data><data key="desc">「怪物」Centidreadnought：级别32；是在空中飞舞的巨型蜈蚣。；「没错。虽然斯诺大人此前应该是前往迎击了，但好像还是有漏网之鱼。斯诺大人她也还没有回来」</data></node>
    <node id="风龙（艾尔芬里斯）"><data key="name">风龙（艾尔芬里斯）</data><data key="type">怪物(迷宫六十六层支配者)</data><data key="status">provisional</data><data key="desc">而支配这整座天空的，便是那条体型甚于云海的自由的『风龙（艾尔芬里斯）』；看上去真的就像茶褐色天花板在蠢动一般。；正如莱纳所言，只有到了六十五层和六十六层中间的位置它才会袭击过来。</data></node>
    <node id="拉丝缇娅拉的手记"><data key="name">拉丝缇娅拉的手记</data><data key="type">道具(手记)</data><data key="status">provisional</data><data key="desc">这个，是我的手记。继续积攒记载的量的话，总有一天会让它成为英雄谭的；为了将英雄拉丝缇娅拉大人的冒险流于后世，即使是牺牲睡眠时间也不能忘了记录哦；我看向了摆在桌子上的拉丝缇娅拉的手记。</data></node>
    <node id="《维度》"><data key="name">《维度》</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">对后卫两人的HP成长感到放心，我将『维度』浸透到32层。；我的『维度』也做出了一样的判断，虽然具体没法把握，但是玛利亚的索敌能力不亚于『维度』；几分钟后就出现了新的怪物，『维度』捕捉到了接近我们的怪物的身影。</data></node>
    <node id="无序之风"><data key="name">无序之风</data><data key="type">魔法(风系妨害)</data><data key="status">provisional</data><data key="desc">「那个，禁止呦。『无序之风』」；柔和的风吹了过来，我正在发动的魔法被『魔法相杀』了。；那种既灵动又致密的魔法构筑，令我感到了战栗。</data></node>
    <node id="光魔法"><data key="name">光魔法</data><data key="type">魔法体系(光属性)</data><data key="status">provisional</data><data key="desc">「⋯⋯那我来带路吧。但是在那之前，我有事要问你。诺斯菲，你的魔法能够对精神产生作用是吗？」；「但是，与暗魔法不同的是，光魔法没有办法强制改变他人的内心想法。必须经由彼此心意相通、得到互相的认可之后，才终于可以对特定的感情进行缓和。因此涡波大人您所担心的那种行径，靠光魔法是做不到的，请您放心」；「没错。这充满和平性质的条件，我想应该就是光魔法与暗魔法最大的不同点了吧。因为怪物们也不想平白无故地送死，所以我才能够利用它们的这份心思解决问题」</data></node>
    <node id="古尔亚德"><data key="name">古尔亚德</data><data key="type">地点(国/势力)</data><data key="status">provisional</data><data key="desc">抵达位于联合国南部的古尔亚德时，人数只剩计划中的一半。</data></node>
    <node id="理的盗窃者"><data key="name">理的盗窃者</data><data key="type">人物/存在(称号·千年前的敌对者)</data><data key="status">provisional</data><data key="desc">千年前的战斗说到底都是我和『理的盗窃者』之间的问题</data></node>
    <node id="斯科纳・伊格德拉西尔"><data key="name">斯科纳・伊格德拉西尔</data><data key="type">人物(长生种·树人)</data><data key="status">provisional</data><data key="desc">咱记得在世界树那边有作为『最后的纯血树人种』的『斯科纳・伊格德拉西尔』、以及在联合国开拓地有作为『最后的纯血龙种』的『托尔普・特鲁克』来着」；「不不，咱要是遇见那帮人的话只会被单方面欺凌的，所以咱一直避免见到那些家伙来着⋯⋯那帮人的性格真的是糟透了呀⋯⋯」</data></node>
    <node id="保管室"><data key="name">保管室</data><data key="type">地点(佩艾希亚城内·绘画)</data><data key="status">provisional</data><data key="desc">罗德以体操坐的姿势待在满是被撕碎的绘画的保管室里。不光眼角泛着泪光，她的鼻子也都哭红了。；已经锈蚀的藏书室的大门是敞开的，但通往保管室的门却像是在拒绝他人一样上了锁。；但是如果我们真的用这种方式破壊掉这扇门的话，那么这扇门就永远不会再向我们敞开了。不论是物理上，还是精神上，都是如此。</data></node>
    <node id="缇达"><data key="name">缇达</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">先前，我打倒了令人类感到束手无策的缇达。；【二十守护者】暗之理的盗窃者；「呵呵呵，我乃镇守二十层的守护者、暗之理的盗窃者缇达。请多指教了。」</data></node>
    <node id="兜牢宫"><data key="name">兜牢宫</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">像巨型蜘蛛的头目『钢蛛』和食肉植物『兜牢宫』都相当棘手——</data></node>
    <node id="宝石鱼"><data key="name">宝石鱼</data><data key="type">怪物(迷宫·鱼形)</data><data key="status">provisional</data><data key="desc">宝石鱼级别29──；是在29层就有的大型七色鱼。；是在沙地里游动的鱼形怪物，速度快还耐打，多加留意</data></node>
    <node id="斯诺的义母"><data key="name">斯诺的义母</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">然而两人却完全不像，那是一名金发艳丽，眼若饥鹰，威风凛凛的女性。尽管身着的礼服有相似之处，但两人在性格上着实是完全相悖的。；「说的很好……你就是为此才存在的。切记不要搞错了这一点……」；「斯诺，你差不多也该去面对自己的使命了。你血脉的力量，应该为了这个世界、为了国家社稷、为了沃克家而使用。只有这样才能让你的人生变得充实，为什么你就是不明白呢？」</data></node>
    <node id="艾尔芬里斯"><data key="name">艾尔芬里斯</data><data key="type">怪物(风龙)</data><data key="status">provisional</data><data key="desc">【怪物】艾尔芬里斯：位阶67；等级在黯淡之龙的两倍以上。体型则是十倍——不、搞不好足足有五十倍。；是风龙小艾尔芬里斯呢。嗯~，真让人怀念啊~。</data></node>
    <node id="PaleGriffin"><data key="name">PaleGriffin</data><data key="type">人物(迷宫63层怪物)</data><data key="status">provisional</data><data key="desc">徘徊在六十三层的主要的怪物叫做PaleGriffin。是一种上半身是鸟，下半身是野兽形态的怪物。；莱纳用风强化剑的威力，将PaleGriffin逼入了绝境。然而，没等我们结果它，PaleGriffin就突然飞到特高的地方，然后开始竭力嘶吼。；这种类型的怪物一般来说不追你追得横跨一整个阶层是不会停的。</data></node>
    <node id="伊丽莎白・沃尔斯"><data key="name">伊丽莎白・沃尔斯</data><data key="type">人物(佩艾希亚·骑士·贝丝酱成年态)</data><data key="status">provisional</data><data key="desc">名字：伊丽莎白・沃尔斯HP721／721MP103／143职业：骑士；力量15.91体力14.46技巧12.01速度6.44贤能5.04魔力6.72素质1.52；先天技能：斧术0.89火魔法1.56地魔法1.67</data></node>
    <node id="Jaeger·Wind"><data key="name">Jaeger·Wind</data><data key="type">技能(莱纳·风魔法)</data><data key="status">provisional</data><data key="desc">——魔法『Jaeger·Wind』！！；是啊，是那家伙教我的。虽然掌握的还不完全，不过是适合立即发动的魔法。；「──『Jaeger・Wind』！」</data></node>
    <node id="艾尔米拉德·希达尔克"><data key="name">艾尔米拉德·希达尔克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：艾尔米拉德·希达尔克HP200/201MP299/299职业：骑士；「——『FlameBlast』！！」；大家放心。看我将它们全部冲垮！——『TidalWave』！！</data></node>
    <node id="联合国"><data key="name">联合国</data><data key="type">组织(国家联合)</data><data key="status">provisional</data><data key="desc">如今的大小姐已经化身为联合国力量的象征。</data></node>
    <node id="兰斯"><data key="name">兰斯</data><data key="type">人物(骑士·诺斯菲三骑士之一)</data><data key="status">provisional</data><data key="desc">不过就是因为『暗之理』被兰斯先拿走了，所以就把余剩的东西拨给了我罢了。</data></node>
    <node id="白石玉衣"><data key="name">白石玉衣</data><data key="type">道具(防具)</data><data key="status">provisional</data><data key="desc">使用『表示』看一下，发现赛莉酱的衣服算是件不错的东西。；──白石玉衣；防御力3对魔力3──</data></node>
    <node id="次元之戒"><data key="name">次元之戒</data><data key="type">道具(魔法戒指·MP储存)</data><data key="status">provisional</data><data key="desc">这本来是结婚仪式上使用的魔法戒指。是将双方的思念和魔力结合在一起，通过交换的方式缔结羁绊的礼装。；仅仅如此，戒指的名字就改变了。；「次元之戒」</data></node>
    <node id="异世界"><data key="name">异世界</data><data key="type">地点(涡波的原世界)</data><data key="status">provisional</data><data key="desc">「感觉大家都很简单就相信了啊⋯⋯⋯异世界什么的，是能让人这么容易就接受的事情吗？」；我向了解莱文教的传承的两人询问移动到异世界的可能性。；「如果我要回到原来的世界的话，你们觉得怎么做比较好？」</data></node>
    <node id="莉帕"><data key="name">莉帕</data><data key="type">人物(知性魔法)</data><data key="status">provisional</data><data key="desc">「——『我正是那』，『慕影死神（Grim·R·Reaper）』。」；最为异常的一点在于，即使我对她使用『注视』，也根本无法掌握女孩的情报。；好吧！我只说要点。那家伙『被看到的时候无法存在，另外只能在没有被注视的情况下实体化』，她是从这样的规则中诞生的童话般的敌人。</data></node>
    <node id="南方联盟"><data key="name">南方联盟</data><data key="type">组织(联盟)</data><data key="status">provisional</data><data key="desc">而在充当我散步场所的要塞之下，则是因这场战术性胜利而欢呼雀跃的『南方联盟』的士兵。；现在我在大陆上设置的魔法阵是秘传的魔法这件事，在『南方联盟』是重要机密。；「……我相信。因为您确实给予了我们这样的希望。在这座要塞之内，已经没有任何人怀疑您的力量了。我们都将您视作了拯救世界的使徒，无比尊崇。」</data></node>
    <node id="魔法相杀"><data key="name">魔法相杀</data><data key="type">技能(魔力干涉)</data><data key="status">provisional</data><data key="desc">理所当然的，我的『魔法相杀』没有这么容易就成功。灌注了异常大量魔力的光之墙将我的干涉弹开了。；不过我现在除了『魔法相杀』之外也用不了别的魔法，同时还要保护身体能力不强的玛利亚。</data></node>
    <node id="店员姐姐"><data key="name">店员姐姐</data><data key="type">人物(魔法屋店员·精灵耳)</data><data key="status">provisional</data><data key="desc">一进去就听到了曾几何时的精灵耳小姐姐的声音。；「啊、是那个时候的有钱人？呜哇，这是有一年没见了吧？」；「但凡是客人，我都会在力所能及的范围内记住样貌的。这毕竟是服务业的基本嘛」</data></node>
    <node id="赛鲁多拉"><data key="name">赛鲁多拉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">是龙人巨汉，赛鲁多拉。既是孤为数不多的理解者，更是在这个情况下助力最大的人物。；毕竟这个蓝色头发的男子是在没有任何加护的情况下，就能跟上觉醒为『理的盗窃者』的孤的魔人。虽说因为孤的存在而遭到了掩盖，但这个男人毫无疑问有哪里不对劲。；[……明白了。那么从今往后，我就以『支配之王（Lord）』的名号称呼你了]</data></node>
    <node id="罗德・缇缇"><data key="name">罗德・缇缇</data><data key="type">人物(五十之守护者)</data><data key="status">provisional</data><data key="desc">「五十之守护者」风之理的盗窃者；「你是被称为『支配之王』。一千年前的国王没错吧？」；「──哈哈，确实是呢。即使没有了记忆，还是能明白人家的本质呢。」</data></node>
    <node id="大圣堂地下的沉眠少女"><data key="name">大圣堂地下的沉眠少女</data><data key="type">人物(已逝·原文未命名)</data><data key="status">provisional</data><data key="desc">结果我看到了一名躺在白色床单上沉睡的少女。不、不对，定睛细看之后我注意到少女并非陷入了沉眠，她已经与世长辞了。；「我按顺序来跟你解释。这名少女的事你先不要多做考虑」；「原来如此。我明白怎么回事了。也就是说，躺在那里的少女就是最终要成为缇娅拉大人的『容器』对吧」</data></node>
    <node id="同死神相伴的魔女"><data key="name">同死神相伴的魔女</data><data key="type">人物(传闻称号)</data><data key="status">provisional</data><data key="desc">「据说是『同死神相伴的魔女』用火焰魔法将迷宫的出入口熔解了。整个迷宫的周围都化作了熔岩地带，要恢复通行似乎要等上很久的时间。⋯⋯这个还是亲自去看看情况比较好吧。咱有点半信半疑的说」；看到这副光景，我能够深刻地感受到应当是打造出这个状况的『她』那绝对不许任何人进入西迷宫的意志。；在斯诺也确认过后，我算是断定『同死神相伴的魔女』的身份了。</data></node>
    <node id="神铁锻冶"><data key="name">神铁锻冶</data><data key="type">技能(锻冶系)</data><data key="status">provisional</data><data key="desc">而且雷纳尔多还是拥有技能『神铁锻冶』的人物。；也就是将魔术式铭刻到修好的武器和防具上，将魔石的力量予以最大限度的激发。；当然，即使烦恼他也没有停下手把手传授我『神铁锻冶』的动作。</data></node>
    <node id="缇娅拉·弗茨亚茨"><data key="name">缇娅拉·弗茨亚茨</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「说不定，莱文教的始祖缇娅拉就跟异世界有某种联系呢。就像现在的我与涡波一样。」</data></node>
    <node id="维度・决战演算"><data key="name">维度・决战演算</data><data key="type">魔法(维度系)</data><data key="status">provisional</data><data key="desc">「咕！──『维度・决战演算』！！」；意识到同伴的处境会越来越危险的我决定转变战术，通过消耗更多的MP加快战斗的节奏。；一道轨迹划过，双剑成功地斩断了帕林库洛的脚。然而──失去了脚部的帕林库洛将一只手臂液体化，使之流淌到腿部，立马又恢复了行走能力。</data></node>
    <node id="使徒勒伽西"><data key="name">使徒勒伽西</data><data key="type">人物(使徒)</data><data key="status">provisional</data><data key="desc">「都不是，其实使徒一共有三位。第三位使徒从始至终没有发挥任何作用，只是在一旁作壁上观而已。自然也没有留下任何传承。但是即使如此他也是确实存在的。而那第三位使徒的名字是勒伽西。使徒勒伽西。」；「我问你。如果我说现在使徒大人就在我的身体里，你真的会相信吗？」；「回到正题吧，我就是依靠使徒勒伽西的力量构筑出了覆盖大陆的魔法阵。毕竟是千年前的东西，效果极为强力。『北方同盟』必将败北。一切顺利哦。」</data></node>
    <node id="Ex・Wind"><data key="name">Ex・Wind</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">「──基督，做好准备！『Ex・Wind』！！」；身后的风炸裂开来。</data></node>
    <node id="『维度・决战演算』"><data key="name">『维度・决战演算』</data><data key="type">魔法(次元魔术)</data><data key="status">provisional</data><data key="desc">「──看招！魔法『形式』『维度・决战演算』『Default』！！」；与此同时，我利用『维度・决战演算』把握艾尔芬里斯的双眼和『龙之风』的动向，探明在它认识之外的空间并进行移动。</data></node>
    <node id="世界奉还阵"><data key="name">世界奉还阵</data><data key="type">魔法(术式)</data><data key="status">provisional</data><data key="desc">「这个『世界奉还阵』在同我联结着。换句话说，我现在的MP是无限的。不仅如此，现在我就连这种事都做得到哦？」；魔力不断物质化，形成了鸟的脏器，骨胳，血肉，羽毛，最终一只怪鸟便诞生了。；「毕竟『世界奉还阵』跟『迷宫』是同一系统的术式，进行这种程度的『想起收束』简直轻而易举。不如说这才是『世界奉还阵』原本的用途才对」</data></node>
    <node id="玛利亚"><data key="name">玛利亚</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">我将玛利亚留在家中，来到了酒馆。；特别是带着玛利亚升级的事。；和玛利亚一起潜入迷宫的时候</data></node>
    <node id="五十七层"><data key="name">五十七层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">就这样，再次没有收到任何障碍的我们通过了五十九层，顺带保持这个步调通过了五十八层与五十七层。在这途中，找到了华丽的支柱支撑的房间，被吹倒的圣殿，但是不是十分的难以通过。；现在通过的低五十七层，那是最甚的东西。地上的探索者谁都不会认为这是迷宫吧。不论怎么说，宽五十米的回廊一直线的连接着下一个楼梯。就感觉好像在大街上走着。；不顾我和莱纳的担心，诺斯菲一个人在大理石制的回廊里前进着。</data></node>
    <node id="『DistanceMute』"><data key="name">『DistanceMute』</data><data key="type">魔法(次元魔术)</data><data key="status">provisional</data><data key="desc">「──魔法『DistanceMute』！！」；闪耀淡紫色光芒的右臂无视坚硬的龙鳞一举刺入风龙体内。；如果用魔导书中的台词来解释的话，就在这一瞬间相川涡波的『领域』和艾尔芬里斯的『领域』连接在一起了。</data></node>
    <node id="AngeloBaïOnnette"><data key="name">AngeloBaïOnnette</data><data key="type">魔法(风属性·罗德·武器构筑)</data><data key="status">provisional</data><data key="desc">「那就让姐姐给你表演一下自己厉害的地方吧！──『AngeloBaïOnnette』！」；堪称是守护者的特征的浓郁魔力最终收束成了两件武器。罗德手中的是用风构成的铳剑，诺斯菲那光属性的魔力最后固定成了棒状。</data></node>
    <node id="DarkCloth"><data key="name">DarkCloth</data><data key="type">魔法(暗系强化)</data><data key="status">provisional</data><data key="desc">「──『DarkCloth』」；从影子里溢出的黑色液体缠绕上怪物们的身体，最后变成了铠甲的模样。恐怕是暗属性的强化魔法吧。说不定这个魔法还对怪物们的精神施加了某种影响。；冰刃因为黑色铠甲的阻挠无法发挥十足的力道。结果我没能切断黑铠拦住怪物们的脚步。</data></node>
    <node id="风之矢"><data key="name">风之矢</data><data key="type">魔法(风属性·罗德)</data><data key="status">provisional</data><data key="desc">「──『风之矢』！！」；几乎斥满整座回廊的魔力被瞬时压缩，变成纤细的箭簇。；没有丝毫的偏差，两支箭同时命中，敌人在同时丧命。</data></node>
    <node id="圣人缇娅拉"><data key="name">圣人缇娅拉</data><data key="type">人物(传说)</data><data key="status">provisional</data><data key="desc">「这次举办的是圣人缇娅拉·弗茨亚茨的圣诞祭。她是大陆家喻户晓的构建出魔法的基础的圣人——」；而且她可是最先创造出魔法的人哦。另外，弗茨亚茨也是她缔造的。」；据上面说，在遥远的过去盛行许多『诅咒』类的魔法。不过在圣人缇亚拉这么一个人物构建出魔法的基础后，诅咒这一类的魔法似乎就走向了荒废。</data></node>
    <node id="Connection"><data key="name">Connection</data><data key="type">魔法(转移门)</data><data key="status">provisional</data><data key="desc">「——『Connection』！」；留下这句话，海莉便咏唱出『Connection』离开了。；使用熟练的动作驾车出发后，我立刻使用了『Connection』。</data></node>
    <node id="六十五层"><data key="name">六十五层</data><data key="type">地点(迷宫阶层)</data><data key="status">provisional</data><data key="desc">而与之相对地，六十五层的构造可谓是壅塞至极。；这些数量众多的阶梯在一起构成了森罗万象的三维迷宫。；以无机质的石造阶梯构成的三维迷宫是中央区域所特有的。右侧区域有许多从天而降的瀑布，左侧则是生长着直插天际的大树的区域。</data></node>
    <node id="缇缇"><data key="name">缇缇</data><data key="type">人物(魔人·『支配之王』)</data><data key="status">provisional</data><data key="desc">丫头你的名字就叫缇缇好了。怎么样，很可爱的名字吧？；虽然不知道为什么，但是彼此之间的意思能够互通⋯⋯大概就像这种感觉吧；就好像『世界』在有意催促人家快些长大一样。</data></node>
    <node id="六十六层"><data key="name">六十六层</data><data key="type">地点(迷宫阶层)</data><data key="status">provisional</data><data key="desc">「因为六十六层是『天空』嘛。没有回廊和错综复杂的路径，是货真价实的『天空』」；在草原的正中央，耸立着如高塔一般的螺旋阶梯。；这片草原直径有二十公里，边缘被石壁和天花板包围。高度约一千米。</data></node>
    <node id="技能『诈术』"><data key="name">技能『诈术』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">既然已经学会了『编织』『诈术』，证明了诺文所言不虚，就有尝试的价值。；编织1.07诈术1.34魔法战斗0.72锻冶0.69</data></node>
    <node id="LineSquitter"><data key="name">LineSquitter</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">LineSquitter：位阶1</data></node>
    <node id="技能『魔力冰结化』"><data key="name">技能『魔力冰结化』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">技能『魔力冰结化』延长剑身，在冰沙中舞动，将袭来的触手全部切断，伤口在冰沙的影响下又被瞬间冻结。冻伤一并剥夺了伽鲁夫纳多杰里的再生能力。</data></node>
    <node id="『次元之冬·终霜（Di·Winter·Frost）』"><data key="name">『次元之冬·终霜（Di·Winter·Frost）』</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">那就我对付一匹，另一匹交给身后三人对付好了。姑且用『并列思考』做好使用『次元之冬・终霜』的准备。</data></node>
    <node id="相川涡波"><data key="name">相川涡波</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：相川涡波HP4/51MP72/72职业：；Name：KanamiAikawaHP4/51MP72/72；——【召唤】欢迎回来，相川涡波——</data></node>
    <node id="海莉・维斯普洛佩"><data key="name">海莉・维斯普洛佩</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">纯白色的头发扎成一缕，像尾巴一样垂在身后。白得几乎透明的肌肤让人分不清头发与皮肤的界限。冰雪一般的淡青色双眸，薄樱色的双唇。少女如同一件艺术品一样纯白。；名字：海莉・维斯普洛佩HP289／352MP172／512－200职业：无；──先天技能：次元魔术1.79水魔法1.03风魔法1.77神圣魔法1.24</data></node>
    <node id="侯普思·约克鲁"><data key="name">侯普思·约克鲁</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：侯普思・约克鲁HP253/282MP0/0职业：骑士</data></node>
    <node id="格连"><data key="name">格连</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">来讲讲联合国『最强』的探索者格连与守护者战斗的故事吧。；目前，『正道』的铺设一直到二十三层为止；即使是最强的探索者格连也未能战胜镇守迷宫第十层和第二十层的守护者</data></node>
    <node id="行路渐歧（Default）"><data key="name">行路渐歧（Default）</data><data key="type">魔法(次元魔术·空间断层)</data><data key="status">provisional</data><data key="desc">「──De、A、De『行路渐歧（Default）』！！」；但是，距离却反而缩短了。；『始祖涡波』仅仅依靠一句咏唱，便在世界上打造出一个空间断层。</data></node>
    <node id="注视"><data key="name">注视</data><data key="type">技能(鉴定/察知)</data><data key="status">provisional</data><data key="desc">我一边跑一边对状态剧变的塞拉使用『注视』。；接着，我注意到了她的异常。；我使用『注视』详细地鉴定剑的水准。</data></node>
    <node id="技能『表示』"><data key="name">技能『表示』</data><data key="type">技能(分析魔法)</data><data key="status">provisional</data><data key="desc">「然后就是关于涡波的能力的事情了呢⋯⋯⋯感觉涡波的『表示』，要比我的『拟神之眼』级别更高啊⋯⋯」；就我来说，能够将状态的数值一直表示到小数点后两位0.00的地步。但是拉丝缇娅拉则根本看不到小数点。而且装备物品和道具也看不了。怪物这类生物的情报虽然在某种程度上能够看到，但是无机物的情报则完全得不到。；就定为『注视（Analyze）』『持有物品（The・Pouch）』了。</data></node>
    <node id="斐勒卢托"><data key="name">斐勒卢托</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">负责主办这场仪式的，是代理宰相斐勒卢托，以及一个作为元老院代表的特使。；他的名字是斐勒卢托·利奥斯——是担任这个国家代理宰相一职的壮年男性。；让所有人都获得幸福就是你的工作。</data></node>
    <node id="佩艾希亚的骑士们"><data key="name">佩艾希亚的骑士们</data><data key="type">人物(群体)</data><data key="status">provisional</data><data key="desc">刚一起身，我就重新开始搜集周围的地形情报──紧接着，不需要魔法，我的肉眼直接确认了身边有数名表情诧异但却架好了武器的骑士。；「──难、难道说、是骑士团长大人！？」；却发现当事人居然是自己正在搜捕的犯人，他们会惊讶也无可奈何。</data></node>
    <node id="『Flame・Accel』"><data key="name">『Flame・Accel』</data><data key="type">魔法(热系·加速)</data><data key="status">provisional</data><data key="desc">「呼──。『Flame・Accel』」；雷纳尔多的铁拳缠绕着赤色的魔力，一计通天炮二话不说直接击中莱纳的下颚。</data></node>
    <node id="『耶梦加得之霜』"><data key="name">『耶梦加得之霜』</data><data key="type">魔法(冻结系)</data><data key="status">provisional</data><data key="desc">「『耶梦加得之霜』！！」；我则向右移动，用冻结魔法冻住巨鬼。</data></node>
    <node id="SehrWind"><data key="name">SehrWind</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">「『SehrWind』！！」；「──『SehrWind・Madness』！！我的攻击手段也不光有剑而已！；「粉碎他的四肢！──『SehrWind・Madness』！！」</data></node>
    <node id="『次元之理的盗窃者』"><data key="name">『次元之理的盗窃者』</data><data key="type">人物(莉帕的创造者·千年前)</data><data key="status">provisional</data><data key="desc">「啊。但是创造出人家的那个术者，毫无疑问是很强的哦。说起来，他在当时好像是被称作『次元之理的盗窃者』来着。」；创造出莉帕这一『诅咒』的次元魔法使。；那也就是说，他是决定莉帕的命运——杀死诺文这一使命的人。对这样一个人，我实在是拿不出什么好印象。</data></node>
    <node id="『炎之矢』"><data key="name">『炎之矢』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「──『炎之矢』！」；近似于镭射的魔法通过玛利亚造出的火焰枪身，贯穿了远处的怪物。；追着在空中飞动的怪物，准确地射穿了要害。</data></node>
    <node id="魔石"><data key="name">魔石</data><data key="type">道具(怪物掉落)</data><data key="status">provisional</data><data key="desc">就这样被击穿心脏的RioshethEagle变成了光，魔石向着悬崖下方掉了下去。；说实话，结束语帕林库洛的战斗，身体中的『魔石』被剥离让我极具弱化了。『素质』被削减，特定的技能也被弱化。</data></node>
    <node id="『暗之理的盗窃者』"><data key="name">『暗之理的盗窃者』</data><data key="type">人物(守护者)</data><data key="status">provisional</data><data key="desc">因为帕林库洛的──不对，『暗之理的盗窃者』的魔力，世界渐渐被涂成了黑色。；焦红色的荒原被漆黑所浸染。无论是大地还是天空都涂上漆黑，超越了黑夜，整个世界都被封入黑暗之中。只有太阳依旧高悬于天际。；「──『呜呼，我正是那犯下死罪者』，『暗之理的盗窃者』──」</data></node>
    <node id="阿雷亚斯家的宝剑"><data key="name">阿雷亚斯家的宝剑</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">离开了座位的我，从『持有物品』中拔出了『阿雷亚斯家的宝剑诺文』。；将魔力送进『阿雷亚斯家的宝剑诺文』，强行将剑的形状转变为盾牌。；由于『阿雷亚斯家的宝剑诺文』不在</data></node>
    <node id="菲伊？厄鲁斯"><data key="name">菲伊？厄鲁斯</data><data key="type">人物(奴隶商人·地下商人)</data><data key="status">provisional</data><data key="desc">──名字：菲伊？厄鲁斯HP33／33MP0／0职业商人──；是一个眼睛细长，有点胖的中年男人。将大量灿烂的装饰品戴在身上，穿着包裹身体的上等丝绸。光他身上的这些物件也许就能抵上一间豪宅吧。；但是，心中却并不平静。『管理人类的工作』，也就是说进行着奴隶商人的工作。</data></node>
    <node id="克洛伊"><data key="name">克洛伊</data><data key="type">人物(军人)</data><data key="status">provisional</data><data key="desc">得知此事后，克洛伊小姐便主动提议愿意帮我们修缮船帆，而我们也欣然领受了她的好意。；在军舰重重保护下的客船甲板上，按照贵族公馆的样式准备好了桌椅，招待我们的茶会就在这里举办。与我们一同出席的，首先是作为船队最高负责人的克洛伊小姐──；「那个⋯⋯我们这边的船队是由总数过千的成员组成的。因为这次的任务是对国家要人的护送，所以才特地出动了这个级别的部队⋯⋯」</data></node>
    <node id="贝丝"><data key="name">贝丝</data><data key="type">人物(兽人·猫耳少女)</data><data key="status">provisional</data><data key="desc">然而，名唤贝丝的猫耳少女仰望着黑色的天空，露出了灿烂的笑容。；我正要跟着她进去的时候，注意到猫耳女孩贝斯在冲我挥手。；我一看到骑士团长大人，脑袋里就只有骑士团长大人这一个称呼！会心口一紧，觉得除此之外再没有任何别的称呼方式了！</data></node>
    <node id="基督"><data key="name">基督</data><data key="type">人物(莱纳的主君)</data><data key="status">provisional</data><data key="desc">想必是罗德的风魔法导致的吧。我的主君基督的魔法要比这安静多了。；主君基督是因为信赖我才将这个任务托付给我的。我绝对不能辜负他的信赖。；但是，身为我主君的基督却战胜了诺文。</data></node>
    <node id="次元魔术"><data key="name">次元魔术</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">「涡涡你、完全没有风魔法的才能呀⋯⋯⋯不，应该是因为你太偏向次元魔术了吧」；「涡涡那么做也确实是最有效率的方法呢。你以前就能依靠次元魔术捏造出其他属性魔法的效果来着，所以不用勉强自己学习其他属性的魔法也无所谓哦」；也就是说，能够将次元魔术教授给我的人就只有『始祖涡波（自己）』了。无可奈何之下，我只能寻找其他的途经。</data></node>
    <node id="爷爷"><data key="name">爷爷</data><data key="type">人物(魔人·北境老夫妇·缇缇养祖父)</data><data key="status">provisional</data><data key="desc">一个面带笑容、穿着一眼就能看出是累经年月的淡茶色衣服的、慈祥和蔼的老爷爷。他应该跟我一样也是魔人吧。因为他手脚指的模样与章鱼的触手很相似。不是章鱼就是水母，总之血中混有水栖生物的可能性很高。；──那丫头你就是咱们的同胞了。大家都是家人，家人之间互相帮助有什么不好的吗？；没有血缘关系也无所谓。咱们有咱们自己的规矩，决定是否是家人也一样。按照那个规矩来说，丫头你就是老夫的家人</data></node>
    <node id="水晶蚁"><data key="name">水晶蚁</data><data key="type">人物(迷宫怪物·31层)</data><data key="status">provisional</data><data key="desc">──水晶蚁 级别26──；结果却没能击穿水晶蚁的水晶躯体。仅仅烧焦了表面，外加被水晶楔刺破了一点而已。；在数量作战的猛攻下，水晶蚁终于化作光芒消失了。</data></node>
    <node id="雷纳尔多・沃尔斯"><data key="name">雷纳尔多・沃尔斯</data><data key="type">人物(锻冶师)</data><data key="status">provisional</data><data key="desc">名字：雷纳尔多・沃尔斯HP589／589MP123／123职业：锻冶师；后天技能：锻冶3.12神铁锻冶1.26精工1.55炼铁1.98；不仅有前所未见的高级别，而且技能也相当丰富。不少数值还比我和莱纳更优秀。如果是在地上，他毫无疑问是英雄级别的人物。</data></node>
    <node id="芙兰琉莱"><data key="name">芙兰琉莱</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">因为之前跟帕林库洛交谈的时候就确认了不是芙兰琉莱；双马尾大小姐、芙兰琉莱·赫勒比勒夏因挺着胸如此说道。；「我是赫勒比勒夏因家的七女，芙兰琉莱。基督大人，很荣幸与您相识。」</data></node>
    <node id="克洛伊·希达尔克"><data key="name">克洛伊·希达尔克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">在这之中，我──辅佐南方『代理总司令』斯诺・沃克的『代理副传令官』克洛伊・希达尔克正感到烦闷不已。；「不可以⋯⋯我可是辅佐斯诺大人的副官，必须要比任何人都振作才行⋯⋯」；与我有着相似的家境，但却在比我还要小的年纪朝着我的梦想一往无前的少女──这就是斯诺・沃克大人。</data></node>
    <node id="深红弥诺陶洛斯"><data key="name">深红弥诺陶洛斯</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">【怪物】深红弥诺陶洛斯位阶：20</data></node>
    <node id="五十五层"><data key="name">五十五层</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">并不是五十五层见到的闪着光辉的怪物在等着，倒不如说是六十六层附近出现的凶猛的风属性的怪物。天花板微微的提高了，看惯的岩石构成的不整洁的回廊。；把挡道的SkyRunner打倒，我们进入了下一个区域。石造的回廊的样子变了，变得更加粗糙。与其说是墙壁不如说是被夹在了悬崖的谷底的险峻岩道。；不如说，已经没什么平坦的道路了，有时也会出现不得不通过断崖绝壁的画面。</data></node>
    <node id="海莉·维斯普洛佩"><data key="name">海莉·维斯普洛佩</data><data key="type">人物(魔石人类)</data><data key="status">provisional</data><data key="desc">姓名：海莉·维斯普洛佩HP289/352MP172/512-200职业无；次元魔法1.79水魔法1.03风魔法1.77神圣魔法1.24；纯白色的头发扎成一缕，像尾巴一样垂在身后。白得几乎透明的肌肤让人分不清头发与皮肤的界限。冰雪一般的淡青色双眸，薄樱色的双唇。少女如同一件艺术品一样纯白。</data></node>
    <node id="一再反转之光（Re・Light）"><data key="name">一再反转之光（Re・Light）</data><data key="type">魔法(光属性·诺斯菲)</data><data key="status">provisional</data><data key="desc">「⋯⋯原来如此。这就是LizardFlyer，是将风化做了自身的感觉器官呢。不过，感官越是灵敏，我的魔法效果就越好──魔法『一再反转之光（Re・Light）』」；虽然这魔法不像她说的那样真能匹敌光速，但光毫无疑问发挥了作用。沐浴在这道闪光之下的LizardFlyer回天乏术，在『魔法相杀』成功之前就已经受到魔法的影响了。；「──魔法『一再反转之光』」</data></node>
    <node id="Rokh·Bringer"><data key="name">Rokh·Bringer</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">折断的『Rokh·Bringer』漂浮在空中。因为这把魔剑断成了两截，因此被分成了剑刃方与剑柄方两部分。这两者的锋利侧都冲向了我。；在莱纳『魔力风刃化』的修补下，折断的『Rokh·Bringer』完美地化身为两把长剑。风之魔剑舞动着向我袭来。</data></node>
    <node id="港口军阶最高的联合国军人"><data key="name">港口军阶最高的联合国军人</data><data key="type">人物(联合国军·无专名职务称呼)</data><data key="status">provisional</data><data key="desc">就这样，在港口军阶最高的联合国军人的带领下，我们来到了一艘停泊在港口角落的大船面前。；「不，因为昨天刚刚给我们发来联络，所以驱动船行驶的魔力等各方面还没有准备好⋯⋯毕竟这艘船的燃料消耗量实在是不俗⋯⋯」；「真、真不愧是『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』大人⋯⋯」</data></node>
    <node id="缇莉・琉克"><data key="name">缇莉・琉克</data><data key="type">人物(魔法使)</data><data key="status">provisional</data><data key="desc">是『史诗探索者』的魔法使缇莉・琉克小姐。；看来，在我离开之后，公会的文案工作就由她来负责了。；「你说什～么呢。史诗探索者的会长一职永久保留。它永远都是属于涡波君的东西哦？」</data></node>
    <node id="斐勒卢托・夏鲁梭斯"><data key="name">斐勒卢托・夏鲁梭斯</data><data key="type">人物(弗茨亚茨大圣堂神官)</data><data key="status">provisional</data><data key="desc">神官的目光十分浑浊，扭曲的黑卷毛颇有个性。；「在拉丝缇娅拉大人来之前，就由我『斐勒卢托』来招待诸位吧。由过去曾主持过缇娅拉大人的再诞仪式的我『斐勒卢托』来负责招待。」；「斐勒卢托⋯⋯？为什么你这等地位的人会来招待我们⋯⋯」</data></node>
    <node id="魔石人类"><data key="name">魔石人类</data><data key="type">人物(群体)</data><data key="status">provisional</data><data key="desc">「难、难道说，我称呼您名字的发音有什么地方不正确吗⋯⋯？如果是这样，那实在是万分抱歉。我们是战斗用的『魔石人类』，血中没有刻下有关普通教育的知识、所以⋯⋯」；「您言重了，能为现人神服务是我们无上的荣幸」；少女们看向拉丝缇娅拉的眼神中混杂着憧憬和尊敬。</data></node>
    <node id="斯特鲁"><data key="name">斯特鲁</data><data key="type">怪物(39层植物型)</data><data key="status">provisional</data><data key="desc">首先是一匹长得像霸王花的巨型赤色花。名字叫『斯特鲁』。；斯特鲁不管看不看得到敌人都播撒出花粉。让人联想到24层的火蜥蜴。；四分五裂到被切成一百块以上的地步，斯特鲁才终于变成了光芒消失。</data></node>
    <node id="持有物品"><data key="name">持有物品</data><data key="type">技能(物品收纳)</data><data key="status">provisional</data><data key="desc">这种能力跟我的『持有物品』没什么差别。果然那是他开发的某种魔法吧。；我从『持有物品』中取出纸张和羽毛笔，画出了兵力的分布。</data></node>
    <node id="芙洛拉"><data key="name">芙洛拉</data><data key="type">人物(公主)</data><data key="status">provisional</data><data key="desc">「啊、这不是涡波大人吗？呵呵，看来又劳烦您出手相助了呢」；然而正统派公主看到这一连串的情节、赶忙靠近过来为她出头。；「芙洛拉、多谢你的心意了。不过还是算了吧。咱觉得打从这趟旅行开始的时候，这份命运就是注定的了。咱只能在可能的限度内陪在他们身边了」</data></node>
    <node id="最深部"><data key="name">最深部</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">「再将世界上所有的『魔力』全部灌注到器量拓展的阳滝的体内。之后再把阳滝带到『最深部』，将她升华到超越『怪物』的更高的次元。只要这样的话，那么阳滝的病和这个特殊的假死状态就都可以治好了。理论上来说呢」；「没错。所以，要想出让被大陆吞噬的『魔石』给『想起收束（Drop）』的系统啊。顺带打造出开拓一条通往这个世界的『最深部』的道路。呵呵，终于到了重新启动那个计划的时候呢⋯⋯！」；「放心吧，缇娅拉。我已经不会再丢下你一个人了。我的身体也会被保存在『最深部』的。如果一切顺利，成功抵达了最深部的话，我们三人就能够再会了。呐，这不是HappyEnd吗？」</data></node>
    <node id="阿尔肯"><data key="name">阿尔肯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">他是个9级的剑士，名叫阿尔肯。；如果你输了那就卖身来凑钱好了。</data></node>
    <node id="杂货铺店主"><data key="name">杂货铺店主</data><data key="type">人物(佩艾希亚·兽人女性·粮铺)</data><data key="status">provisional</data><data key="desc">如果我记得没错，那这个店确实应该是卖粮食的杂货铺。；死者是一个被拦腰斩断的兽人女性。；这几天我经常在她这里买东西，受了她不少的照顾。</data></node>
    <node id="水之理的盗窃者"><data key="name">水之理的盗窃者</data><data key="type">人物(理的盗窃者)</data><data key="status">provisional</data><data key="desc">「看来『水之理的盗窃者』没能成为容器啊……虽然很让人伤感，但这也无可奈何。盟友也不要哭了。替代品的话还是有的……」</data></node>
    <node id="魔王城"><data key="name">魔王城</data><data key="type">地点(城堡·迷宫第66层里侧)</data><data key="status">provisional</data><data key="desc">欢迎你回到我们的『魔王城』；这个还是涡涡命名的呢；这座古堡的外貌呈圆锥状，里面有着森林一般广大的庭院。</data></node>
    <node id="草绿色头发的女孩"><data key="name">草绿色头发的女孩</data><data key="type">人物(罗德幼年·回忆像)</data><data key="status">provisional</data><data key="desc">纤细的身材，草绿色的头发，背后长有一对轻巧的羽翼。；事实上，这个女孩子也确实将小石头看做了宝物。；然而听到这番话，小女孩猛地一颤，接着便战战兢兢地起身，她在害怕。</data></node>
    <node id="新月琉璃"><data key="name">新月琉璃</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">一把用化作盾牌的『阿雷亚斯家的宝剑诺文』防住，另一把用从『持有物品』中拔出的『新月琉璃』接下来。；我在毫厘之间用『新月琉璃』挡开莱纳的『魔力风刃化』。；我拿着『新月琉璃』</data></node>
    <node id="塞拉"><data key="name">塞拉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">我一下就明白了没办法跟这样的她正常沟通，于是朝站在一旁跟我一样脸色阴沉的身着女仆装的兽人女性怒吼：；「不是、她们要放火的时候我是有阻止过的……不过这也要看对象不是么……我也没办法用太激烈的言辞劝大小姐，所以，呐……？」；而塞拉也觉得比起我的指示还是拉丝缇娅拉的更正确吧。</data></node>
    <node id="Zeitlos·Wind"><data key="name">Zeitlos·Wind</data><data key="type">魔法(风)</data><data key="status">provisional</data><data key="desc">「啊，那·个·行·为也禁止哦。『Zeitlos·Wind』。」；柔和的风吹了过来，『Dimension』因『魔法相杀』而被化解。</data></node>
    <node id="魔力风刃化"><data key="name">魔力风刃化</data><data key="type">魔法(应用技术)</data><data key="status">provisional</data><data key="desc">「不瞒你说，其实我已经擅自给你那招取名叫『魔力风刃化』了」；就先叫它魔剑『魔力风刃化（AirFalchion）』──不，干脆就结合起来叫魔法『风刃剑』怎么样？」；话说魔法的效果还真提升了啊，我去，我自己也被吓到了诶。</data></node>
    <node id="『北方』王国"><data key="name">『北方』王国</data><data key="type">地点(过去王国·于迷宫66层里侧重现)</data><data key="status">provisional</data><data key="desc">涡涡用次元魔法，将过去存在的『北方』王国，就那样做了出来。；那么，有能力做出这种事的人只会是一千年前的『始祖涡波』。</data></node>
    <node id="『FlmaeArrow・散花』"><data key="name">『FlmaeArrow・散花』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「──『FlmaeArrow・散花』！」；这股热量跟之前在大圣堂见到的相比简直判若云泥。威力虽然比单发的『炎之矢』逊色，但即使如此仍然是可以被称为镭射的凶恶魔法，如同闪光一般奔驰而出。；白色火焰在红色火焰的引导下，袭向了聚齐起来的怪物们。</data></node>
    <node id="兵蚁群"><data key="name">兵蚁群</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">「可不是么，遇到兵蚁群的时候真是捏了把冷汗</data></node>
    <node id="炎之蛇（耶梦加得之炎）"><data key="name">炎之蛇（耶梦加得之炎）</data><data key="type">魔法(玛利亚炎系)</data><data key="status">provisional</data><data key="desc">『炎之蛇（耶梦加得之炎）』从她的脚边诞生。；足足有八匹火蛇诞生于世。；八匹炎蛇像是锁链一般紧紧地络合在一起捆住了西斯的光之障壁。</data></node>
    <node id="『暗之理的盗窃者』的『魔石』"><data key="name">『暗之理的盗窃者』的『魔石』</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">『暗之理的盗窃者』的『魔石』──从不断咒怨着的帕林库洛的胸口脱落而出。；轻盈地、毫无征兆地、帕林库洛力量的源泉，就这样掉落在地。；帕林库洛之所以能跟我争锋，全都是因为这个魔石的存在。也就是说这个魔石可谓是万恶之源。</data></node>
    <node id="AllConfess"><data key="name">AllConfess</data><data key="type">道具(迷宫拾得轻盔)</data><data key="status">provisional</data><data key="desc">被折断的「BloodSword」的剑身重新接合，满是伤痕的轻盔「AllConfess」也被修补完善。；防御力4耐魔力1</data></node>
    <node id="罗德·缇缇"><data key="name">罗德·缇缇</data><data key="type">人物(迷宫五十层守护者)</data><data key="status">provisional</data><data key="desc">罗德·缇缇？或者说，和以前一样，放轻松叫人家『国王酱』也可以哦。；【五十守护者（FiftyGuardian）】风之理的盗窃者；那头有着梦幻般色彩的翠绿色长发</data></node>
    <node id="龙之风"><data key="name">龙之风</data><data key="type">魔法(龙系)</data><data key="status">provisional</data><data key="desc">连干涉都极其困难的『龙之风』向我们袭来，打算封住我们的行动。；无数的暴风就如开花弹一样炸裂开来，像蹂躏糕点一样将阶梯撕得粉碎。</data></node>
    <node id="西斯"><data key="name">西斯</data><data key="type">人物(使徒)</data><data key="status">provisional</data><data key="desc">那是指引导了圣人缇娅拉的使徒西斯大人呢？</data></node>
    <node id="空白之戒"><data key="name">空白之戒</data><data key="type">道具(戒指)</data><data key="status">provisional</data><data key="desc">这样戒指就有三个了。我先将它们分别戴到食指中指无名指上试了一试。；昨天晚上我将魔力注入了所有的「空白之戒」中，应该储存了远超『表示』的大量魔力。</data></node>
    <node id="GreenHighElement"><data key="name">GreenHighElement</data><data key="type">人物(迷宫64层怪物·精灵)</data><data key="status">provisional</data><data key="desc">【怪物】GreenHighElement：Rank65；它用跟莉帕相似的瞬间移动紧咬住我们不放。；但这道风却被精灵一饮而尽。岂止是造成伤害，两种风就这样直接混合在一起，让怪物变得更巨大了。</data></node>
    <node id="DistanceMute"><data key="name">DistanceMute</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">那三种魔法的名字是『Torsion』、『Default』、『DistanceMute』。效果分别是『无法干涉的攻击魔法』『无法闪避的空间魔法』『无法防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余。；毕竟这个是将手伸进对方的体内，直接抽出灵魂的魔法啊。物理上的防御力再高也没意义的。；置于我手中的是一颗光芒黯淡的魔石。『魂』被拔除的桌子就这样化作光芒消失了。</data></node>
    <node id="克洛伊・希达尔克"><data key="name">克洛伊・希达尔克</data><data key="type">人物(军人·舰队指挥官)</data><data key="status">provisional</data><data key="desc">将金色的长发扎成三股辫之后结成了团子状盘在脑后的发型，两侧的横发异样得长，刘海则剪的齐平。样貌给人一种秀丽凛然的感觉。；面前这名女性的名字叫克洛伊・希达尔克。；但从这一连串的行动中也不难看出船员们对克洛伊・希达尔克的信赖之深厚。</data></node>
    <node id="大蛤"><data key="name">大蛤</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">怪物的名字也单纯得不得了，就叫大蛤；结果让我陷入了『状态：中毒』的窘境。</data></node>
    <node id="干死帕林库洛小队"><data key="name">干死帕林库洛小队</data><data key="type">组织(讨伐小队)</data><data key="status">provisional</data><data key="desc">就是这样我们要以4人小队行动喽。队伍名就叫『干死帕林库洛小队』；「总而言之，要跟涡波一起去本土的也就我和玛利亚酱还有缇亚而已了。这样就漂亮地4对3了呢」；但是却有两个人用险恶的笑容称赞起这个名字。</data></node>
    <node id="帕林库洛·勒伽西"><data key="name">帕林库洛·勒伽西</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">穿着漂亮的军服，又被授以将军之类的了不起的军衔，还能指挥着成千上万的士兵，在作为『境界战争』最前线的要塞城墙上迈步。；然而现实却完全相反。到头来，我却成为了一个欺骗者，只为了一己私欲游戏人间。；「——帕林库洛长官。您在这里啊！」</data></node>
    <node id="艾尔米拉德"><data key="name">艾尔米拉德</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「但是在你跟艾尔米拉德的决斗中，可是做了与之同等的事情哦。夫君。」；「啊，有过那种事来着……在我意识最朦胧的时期做的来着，差点忘了……不对，是想给忘了……」</data></node>
    <node id="『维度·决战演算』"><data key="name">『维度·决战演算』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">这次也是很浪费地使用着魔力。因为战斗中不再使用『维度・决战演算』而是以技能『感应』为中心作战，所以MP还有很多。；『维度・决战演算』。给这个魔法命名的创造者就是我。但是直到游戏通关──抵达迷宫最深部为止，可能都不会再使用到『维度・决战演算』了吧，这让我心中有些不忍。；思考着要不要把技能『感应』袭名为技能『感应・决战演算』，索敌行动结束了。</data></node>
    <node id="爪瑙蝎"><data key="name">爪瑙蝎</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">蝎子状的怪物、爪瑙蝎以灵活的动作将缇亚的攻击全数化解。</data></node>
    <node id="戒指『晶盾』"><data key="name">戒指『晶盾』</data><data key="type">道具(魔法道具·戒指)</data><data key="status">provisional</data><data key="desc">接着，使用『Quartz』对钻石进行干涉，再依靠『维度』规避误差，将魔石和戒指结合起来，我费尽心力打造的魔法道具就完工了。；──戒指『晶盾』；寄宿着『QuartzShield』力量的戒指──</data></node>
    <node id="所有物"><data key="name">所有物</data><data key="type">魔法(次元收纳)</data><data key="status">provisional</data><data key="desc">同雷纳尔多进行的锻冶工作，不仅让我在『所有物』中积攒了铜币，磨砺了技能，还得到了预想不到的更多收获。；因为莱纳用目光控诉，所以我只好将『阿雷亚斯家的宝剑诺文』从『所有物』中取了出来。</data></node>
    <node id="『Sylph・堕落使徒』"><data key="name">『Sylph・堕落使徒』</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">他连忙深深地鞠了一躬并对获赠『Sylph・堕落使徒』的事道谢。；「唔姆。因为老朽的改造，让『堕落使徒』完全变成风属性的武器了呐。；装备者的风魔法+0.50</data></node>
    <node id="Dragon・Ardor"><data key="name">Dragon・Ardor</data><data key="type">魔法(振动球)</data><data key="status">provisional</data><data key="desc">「给我把它轰飞！──『Dragon・Ardor』！！」；威力受到削弱的光矢和振动球碰撞在一处──想当然耳，是斯诺的魔法其势占优。</data></node>
    <node id="弗茨亚茨"><data key="name">弗茨亚茨</data><data key="type">地名</data><data key="status">provisional</data><data key="desc">这里的住宿条件跟弗茨亚茨那边一样，都提供伙食；食堂的装潢跟以前在弗茨亚茨住过的旅店也很像。；如果不是从斐勒卢托或者弗茨亚茨的神官之类的可疑人物</data></node>
    <node id="『Flame·决战炎域』"><data key="name">『Flame·决战炎域』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「──我的眼睛，也看见了。缇亚，按照预定动手。──魔法『Flame・决战炎域』、『萤火』」；玛利亚随时在周围展开火焰。这恐怕就是那个叫『Flame・决战炎域』的魔法了吧。进入这个领域的所有怪物，都会被缇亚的『炎之矢』贯穿当场毙命。；利用火焰拓展了感觉器官的玛利亚感知到了远处敌人的动静。</data></node>
    <node id="『加速』"><data key="name">『加速』</data><data key="type">技能(移动加速·涡波)</data><data key="status">provisional</data><data key="desc">继续『加速』──，『加速』『加速』『加速』──！；对这『加速』的『代价』应该是要失去『安全』吧。；屏住呼吸，虽然曾有几次受到敌人的攻击，但是本来的攻略时间降到了一半以下这是毋庸置疑的，就这样，我们的迷宫探索加速成功了。</data></node>
    <node id="佩露修娜·库艾伽"><data key="name">佩露修娜·库艾伽</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">其中还有『天上之七骑士』的总长佩露修娜·库艾伽。；姓名：佩露修娜·库艾伽HP421/434MP105/105职业：骑士；这个名唤佩露修娜·库艾伽的黑骑士，就是实力冠绝『天上之七骑士』全员的最强骑士——！</data></node>
    <node id="技能『感应』"><data key="name">技能『感应』</data><data key="type">技能(涡波固有)</data><data key="status">provisional</data><data key="desc">这时候我察觉到了异常。技能『感应』发现了危险，促使我赶紧采取措施。；我遵从技能『感应』的直觉，尽量在不触犯塞拉小姐的情况下推进对话。；但是，这其中并没有什么恶意。似乎只是为我着想的忧虑而已。技能感应也没有什么反应，所以我觉得不是什么重要的问题也就什么都没说。</data></node>
    <node id="使徒迪普拉库拉"><data key="name">使徒迪普拉库拉</data><data key="type">人物(传说·使徒)</data><data key="status">provisional</data><data key="desc">「事不宜迟那我们这就出发吧。目标是南方弗茨亚茨本国的世界树。去了那里的话，应该就能遇到被称为千年前的贤者的使徒迪普拉库拉了吧。如此一来，我们一定能获知击败『支配之王』的方法，说不定还能知道如何找到涡波先生──」；「与其说使徒大人会有反应、不如说肯定会被吓到的啊！不、已经不是被吓到的级别了，里面的使徒大人可是会死翘翘的哦！」；如今的南方已经没有多少可用之才了。在过去，以『使徒迪普拉库拉』为首，加上『诺斯菲・弗茨亚茨』『诺文・阿雷亚斯』『缇达・兰斯』『法芙纳・赫勒比勒夏因』等人，我们要面对太多棘手的敌人，但现在一个都没有！</data></node>
    <node id="『表示』"><data key="name">『表示』</data><data key="type">魔法(系统)</data><data key="status">provisional</data><data key="desc">莱纳・赫勒比勒夏因加入了队伍。；如此这般，映于视界的『表示』上这样写道。；一脸津津有味地开发出『表示』这一魔法的我的那副模样总觉得历历在目。</data></node>
    <node id="『天路垂临』『续道碧霄』"><data key="name">『天路垂临』『续道碧霄』</data><data key="type">技能(风属性轻量咏唱)</data><data key="status">provisional</data><data key="desc">「那莱纳就练习一下程度比较轻的咏唱吧。『天路垂临』『续道碧霄』──虽然这也是会让情绪高昂的咏唱，但很快就会恢复的，放心尝试吧」；「『天路垂临』『续道碧霄』」</data></node>
    <node id="莱文教"><data key="name">莱文教</data><data key="type">组织(宗教)</data><data key="status">provisional</data><data key="desc">「我的话，只要看到了『异邦人』这个显示就没什么需要怀疑的了呢。不管怎么说，与莱文教有不浅关系的人，一定程度上都是知道异世界的存在的」；「嗯，有的。在莱文教的传承中，有暗示异世界存在的文献⋯⋯」；即使在弗茨亚茨的图书馆里也没有得到这份情报。因为她们都是莱文教中地位甚高之人，所说的话可信性不低。</data></node>
    <node id="海莉"><data key="name">海莉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">是昨天海莉的话为这份自信蒙上了阴影。「我并不觉得你是成长了」这句话不时在耳边回响。；「说不定是海莉酱和西娅酱吧……？虽然我不觉得她那样的身体状况能在那之后这么快过来就是了……」；「不，她之前说过是一个队伍。那么除了那两个人之外由其他伙伴的话也不是不可能。但是，说到底——」</data></node>
    <node id="使徒西斯"><data key="name">使徒西斯</data><data key="type">人物(传说·正义的使徒)</data><data key="status">provisional</data><data key="desc">「接着，以世界的崩坏为目的的敌对方的『使徒』先生，最后被正义的『使徒』西斯还有圣人缇亚拉给收拾掉了。这样战争也宣告结束喽。可喜可贺可喜可贺~。」；圣人『缇娅拉』构筑了魔法的基础，并缔造了莱文教。使徒西斯带着一同战斗的英雄们巡回各地播撒着奇迹。；「西、西斯大人……？」</data></node>
    <node id="斯诺·沃克"><data key="name">斯诺·沃克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：斯诺·沃克HP511/533MP211/240职业：斥候；龙之加护1.09最适行动1.89古代魔法2.02；「……要是有人牺牲就好了。如果有人死掉的话就可以回去了。」</data></node>
    <node id="千年前的魔导书"><data key="name">千年前的魔导书</data><data key="type">道具(魔导书)</data><data key="status">provisional</data><data key="desc">被记载于千年前的魔导书内的知识实在令人叹服。；我于是去确认了作者的名讳，但上面并没有我的名字。然而，可以确信作者拥有与我相近的感性。；可以推定这本书的执笔过程与我这样的异邦人脱不了干系</data></node>
    <node id="结晶格雷姆"><data key="name">结晶格雷姆</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">让我们这趟顺利的迷宫探索蒙上阴影的，就是出现在二十六层中部位置的怪物，结晶格雷姆。；虽然是钝系打击，但是对付这个结晶格雷姆则很有效。</data></node>
    <node id="跃犬"><data key="name">跃犬</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">这是位阶8的怪物，跃犬。</data></node>
    <node id="夏比"><data key="name">夏比</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">而且混有夏比的血的缇缇跟水还相当不对付</data></node>
    <node id="波鲁扎克"><data key="name">波鲁扎克</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：波鲁扎克·阿尔德HP340/351MP0/0职业：剑士；睡眼惺忪的格连登场了。在他后面跟着波鲁扎克。；「格连他妹自己估计不会主动说，所以我就替她讲好了……别看她那样子，其实她挺擅长核算和文案整理的工作。</data></node>
    <node id="QuartzBlade·Size"><data key="name">QuartzBlade·Size</data><data key="type">技能(剑技)</data><data key="status">provisional</data><data key="desc">「──『QuartzBlade・Size』！！」；直通天际的树精就像一根柴火般自上而下地被斩成两半。</data></node>
    <node id="军团蝠"><data key="name">军团蝠</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">最后的Boss名为军团蝠。</data></node>
    <node id="XiphiasSpear"><data key="name">XiphiasSpear</data><data key="type">怪物(水栖)</data><data key="status">provisional</data><data key="desc">「怪物」XiphiasSpear：级别35；它的躯体跟鲸鱼相仿，足以和『LivingLegend号』相匹敌。上颚像旗鱼一样尖锐细长，全身覆有的鱼鳞则是为怪物所特有的甲壳。；XiphiasSpear是真的聪明，至今为止面对缇缇的远距离攻击，它全都利用潜入水下并在船后现身袭击的方式化解了。但它的优势也就到此为止了。</data></node>
    <node id="『维度・多重展开』"><data key="name">『维度・多重展开』</data><data key="type">魔法(次元魔术·派生应用)</data><data key="status">provisional</data><data key="desc">──『维度・多重展开』；我心里默默地念着「打扰了」，便开始观察所有锻冶师的动作。并将他们的所有动作都把握，记忆下来。</data></node>
    <node id="伽鲁夫纳多杰里"><data key="name">伽鲁夫纳多杰里</data><data key="type">人物(迷宫怪物·Boss)</data><data key="status">provisional</data><data key="desc">【怪物】伽鲁夫纳多杰里位阶35——；但是，它那被切断的身体和触手的断面蠢动着，瞬间就完成了修复。看来作为防御力不足的补充，它有相当强大的再生能力。；也就是说伽鲁夫纳多杰里的鸣叫声中含有呼唤远方之水的魔力。</data></node>
    <node id="InvisibleField"><data key="name">InvisibleField</data><data key="type">魔法(防壁)</data><data key="status">provisional</data><data key="desc">西斯赶忙利用神圣魔法构筑出防壁。；「——『InvisibleField』！」；在冰火二重天的压制下啊，西斯的表情变得严肃起来。</data></node>
    <node id="地之理的盗窃者"><data key="name">地之理的盗窃者</data><data key="type">守护者称号(地之理)</data><data key="status">provisional</data><data key="desc">『地之理的盗窃者』的『魔石』，持有『其水晶绝对不会破碎』的理。符合这一准则的力量可以无限地发挥。；更重要的是，放开『地之理的盗窃者』的魔石的我也没有LevelDown。</data></node>
    <node id="『某人』"><data key="name">『某人』</data><data key="type">人物(迷宫建造者·身份不明)</data><data key="status">provisional</data><data key="desc">但是，会有这么凑巧让人能够呼吸的空间存在让我产生了一种违和感。在这样的空间里，水压和气压居然能保持平衡，只能认为是『某人』有意做的手脚。；『某人』为了挑战35层的探索者特地准备了这个空间——；那个『某人』为了让人更容易地通过35层而制造出了这个『休息地点』。这么想的话，这个空间存在的理由就可以说明了。</data></node>
    <node id="黑环萤"><data key="name">黑环萤</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">【怪物】黑环萤：位阶2；黑环萤落到地面之后便随着一阵光芒消失了，剩下的只有一颗仄暗透明的结晶。</data></node>
    <node id="阿尔文·科尔森"><data key="name">阿尔文·科尔森</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：阿尔文·科尔森HP165/172MP0/0职业：剑士；先天技能：缝纫1.10</data></node>
    <node id="？？？"><data key="name">？？？</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">与还不完善的技能『？？？』不同，技能『最深部之誓约者』能够任意调节。；但是，因为那份感情被技能《？？？》给分解和重塑，现在已经丧失了原样。；对玩弄感情的技能的愤怒源源不断地上涌。</data></node>
    <node id="魔法『心异解放』"><data key="name">魔法『心异解放』</data><data key="type">魔法(精神系妨害)</data><data key="status">provisional</data><data key="desc">「赌上，我的全部！传到到吧！───魔法『心异解放』！！」；『毒』一般呼吸变得十分苦闷，『沉默』一般喉咙难以出声，『麻痹』一般身体发麻。接着，明明『恐惧』使得身体不断颤抖，『高扬』使得身体发热。；察觉到技能『？？？』的发动的帕林库洛，把事先准备好的精神魔法叠加了上来。</data></node>
    <node id="Gravity・Greed"><data key="name">Gravity・Greed</data><data key="type">魔法(重力系)</data><data key="status">provisional</data><data key="desc">这次只要我一个人就够了！就让你看看跟一年前的不同之处吧、英雄大人！──『Gravity・Greed』！！；原本还需要和身后的露洁共鸣并通过『咏唱』才能使出的魔法在现在的她手下只要一瞬间便可使出。；接着，诺瓦露的面前便生成了可以碾碎一切的『重力』之球。</data></node>
    <node id="『过密次元的真冬』"><data key="name">『过密次元的真冬』</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">之前我迫于其迅速，使用了『过密次元的真冬』来迎击。；但是这一次不同了。</data></node>
    <node id="守护炎（Egis）"><data key="name">守护炎（Egis）</data><data key="type">技能(玛利亚)</data><data key="status">provisional</data><data key="desc">像是缇亚的狙击呀，拉丝缇娅拉的无双呀，还有玛利亚的守护炎（Egis）呀之类的，原因大抵出自这些。</data></node>
    <node id="技能『编织』"><data key="name">技能『编织』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">既然已经学会了『编织』『诈术』，证明了诺文所言不虚，就有尝试的价值。；编织1.07诈术1.34魔法战斗0.72锻冶0.69</data></node>
    <node id="ShineArrow"><data key="name">ShineArrow</data><data key="type">魔法(光属性·诺斯菲)</data><data key="status">provisional</data><data key="desc">「──『ShineArrow』」；尽管音量不同，但释放出的魔法却很类似。；箭簇那精致美丽的形状足以证明二者的魔力操作已经臻于完美。接着，两支箭以令人胆寒的速度向PaleGriffin袭去。</data></node>
    <node id="迪普拉库拉"><data key="name">迪普拉库拉</data><data key="type">人物(传说·背叛的使徒)</data><data key="status">provisional</data><data key="desc">虽然托两位使徒所赐大陆变得繁荣昌盛，但不知为何其中一名使徒却宣告背叛，他与『北方』的狂王协力将世界搅了个天翻地覆。；「——就这样，将挡在路上的敌人们变为了同伴的圣人『缇娅拉』连连击退『北方』的军队。最后打败了狂王，还说服了背叛的使徒『迪普拉库拉』。——到最后都是和平主义者呢，这个人。不过，背叛的使徒死不知悔改，以自己的性命为代价发动了足以毁灭整个大陆的凶恶的『魔法阵』。」；诺文和莉帕两人会穿越到这个时代的原因就是它了吧。</data></node>
    <node id="塞拉·雷迪安特"><data key="name">塞拉·雷迪安特</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">名字：塞拉·雷迪安特；我的名字是塞拉·雷迪安特，是隶属于弗茨亚茨的『天上之七骑士』的一员。；想必是对我方才的反应不太满意吧，雷迪安特的愤怒形于颜色</data></node>
    <node id="日樱小姐"><data key="name">日樱小姐</data><data key="type">人物(酒馆女性店员)</data><data key="status">provisional</data><data key="desc">而这就连日樱小姐过来也不例外。；「咦、这是怎么了。基督君，发生了什么吗⋯⋯？」；而且日樱小姐这个常识人也没有意见，所以应该是没问题的。</data></node>
    <node id="法芙纳・赫勒比勒夏因"><data key="name">法芙纳・赫勒比勒夏因</data><data key="type">人物(千年前·守护骑士)</data><data key="status">provisional</data><data key="desc">以及那名少女的骑士缇达・兰斯、诺文・阿雷亚斯、法芙纳・赫勒比勒夏因。；「──呼。既然是这样，那唯一需要警惕的就只剩下法芙纳・赫勒比勒夏因而已了。除了他之外的人都不会一见到小子就袭击过来的」；一听这姓氏很明显就是莱纳的祖先大人。据说现在在地上赫勒比勒夏因家也是骑士名门，应该不会有错吧。</data></node>
    <node id="贝斯"><data key="name">贝斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">我一边感叹莱纳人生的悲哀，一边将贝斯的点心摆到桌上。；吃吧，本来就是贝斯送给你们的，当然没关系。；在以规模宏大为傲的魔王城后方，想不到会有一个各种各样的花尽情绽放的空间，而贝斯就在那里眺望着微风吹拂下的花朵。</data></node>
    <node id="指挥"><data key="name">指挥</data><data key="type">技能(指挥系·涡波)</data><data key="status">provisional</data><data key="desc">昨天掌握的技能『指挥』，能发挥它最大性能就是莱纳了。倒不如说，正因为是和莱纳一起战斗才掌握了『指挥』这个技能。；「跟着基督的指示走，感觉战斗很容易呢⋯⋯」；「不，还差的远呢。技能『指挥』的数值还很低呢」</data></node>
    <node id="锯齿甲虫"><data key="name">锯齿甲虫</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">【怪物】锯齿甲虫：位阶3；刺了好一顿之后，锯齿甲虫就随着光芒一同消失了。同时掉落了一颗黑色的结晶。</data></node>
    <node id="『始祖与魔王的魔剑BraveFluorite』"><data key="name">『始祖与魔王的魔剑BraveFluorite』</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">顺带一说，缇缇的『始祖与魔王的魔剑BraveFluorite』也顺利回收了。</data></node>
    <node id="雷琪"><data key="name">雷琪</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「真是厉害啊，这个『魔石人类』。能在那种状态下，强行破除了结界。</data></node>
    <node id="露洁"><data key="name">露洁</data><data key="type">人物(魔石人类)</data><data key="status">provisional</data><data key="desc">就像双胞胎一样相似的长相，说话的声音也像极了。但是还是有一个很大的区别，那就是她们的颜色。大声打招呼的孩子头发是红色的，比较文静的那个头发是黑色的。她们身上那满是花边的两件洋服也以红色和黑色作分。；「非也，露洁我们也不是白给的，相川涡波先生，你的实力如何，我们还是能看出来的。唔姆，自诞生以来，我们这还是第一次见到英雄啊。请多关照，红色的名叫露洁，黑色的叫诺瓦露。因为长相相似分辨起来不容易，你就用颜色为特征来区分我们吧。」；「因为嘛~、要是露洁我们去战斗的话，体内的魔石会减少的呀~。还是说，莱纳君想让柔弱的我们早点死掉么？」</data></node>
    <node id="阿尼艾斯·柯鲁纳"><data key="name">阿尼艾斯·柯鲁纳</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：阿尼艾斯·柯鲁纳HP143/147MP156/156职业：魔法使；「没错！我听说相川先生不仅是一个熟练的魔法使，还是一个探索者！请作为临时教师——不对，如果可以，请来做我们的家庭教师吧！然后将公会和迷宫的事情教授给我们可以吗！？」</data></node>
    <node id="玲小姐"><data key="name">玲小姐</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">或许是店长和玲小姐考虑到我的特殊情况而特别照顾了一下吧。；一边干着服务员的工作，一边探听我和雷迪安特之间的对话的玲小姐对我招呼道；见我愣在原地不动，酒馆身材高挑的看板娘玲小姐出声催促。</data></node>
    <node id="Care Full"><data key="name">Care Full</data><data key="type">技能(莱纳·神圣魔法)</data><data key="status">provisional</data><data key="desc">基督你的手却、可恶！──『Care
Full』！」；莱纳用神圣魔法修复着我的右手。</data></node>
    <node id="雷鲁"><data key="name">雷鲁</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">其中有劳拉维亚的雷鲁·桑库斯还有格连·沃克。以及弗茨亚茨的海因·赫勒比勒夏因。尽管是因为大贵族的身世而获得的关系，但小时候的我们是货真价实的好友。；这个约定已经得到了雷鲁的践行，所以我没抱什么期待。不过帕林库洛似乎没有那个意思。；被雷鲁和格连，以及海因称作朋友的——名为帕林库洛的少年此时就存在于我们面前。</data></node>
    <node id="Impulse"><data key="name">Impulse</data><data key="type">魔法(冲击)</data><data key="status">provisional</data><data key="desc">「——『Flame』！『Impulse』！！」；在这股爆炎之内还混入了无属性的冲击魔法。混合魔法就如投入湖中的石子一般在大地上激荡出波纹。；玛利亚的一击将守护帕林库洛的士兵统统震飞到十米之外。</data></node>
    <node id="诺文・阿雷亚斯"><data key="name">诺文・阿雷亚斯</data><data key="type">人物(千年前·守护骑士)</data><data key="status">provisional</data><data key="desc">以及那名少女的骑士缇达・兰斯、诺文・阿雷亚斯、法芙纳・赫勒比勒夏因。；「不，缇达和诺文的话已经无需担心了。因为他们两个已经全被我打倒了」；话是这么说，其中三分之二现在已经都变成魔石了就是。</data></node>
    <node id="帕林库洛"><data key="name">帕林库洛</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">之前同那个叫帕林库洛的骑士的接触虽然让我有所预感。；因为之前跟帕林库洛交谈的时候就确认了不是芙兰琉莱；「我的名字是帕林库洛·勒伽西。是联合国北部的弗茨亚茨的骑士。别看我这样，我姑且也有『天上之七骑士（CelestialKnights）』这么个了不起的职位。」</data></node>
    <node id="经理"><data key="name">经理</data><data key="type">人物(职务称呼·劳拉维亚魔法屋经理)</data><data key="status">provisional</data><data key="desc">「不才是这间店的经理。幸会，『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』大人。这便是本店现在能为您提供的所有魔石了」；「好、好的！当然没问题，这就准备！只是，这笔事项过于重大，我需要转交给本店的最高负责人接手！」；「感谢惠顾！期待您下次的光临！！在您下次过来之前绝对会为你备齐所有种类的魔石，请务必再次光临！！」</data></node>
    <node id="菲洛·艾尔巴特"><data key="name">菲洛·艾尔巴特</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">我就是为了这种场合才待在这艘船上的。也就是说是受雇的定心丸。；被祖国驱逐失去了骑士身份的我，为了混口饭吃而跟海盗们混在了一起。像我这样的原骑士用处还是挺多的。；「……擅长火魔法和神圣魔法。而且是比起蛮力更善用技巧的类型。看样子，你原来是骑士呢。」</data></node>
    <node id="天上之七骑士"><data key="name">天上之七骑士</data><data key="type">组织(弗茨亚茨骑士团)</data><data key="status">provisional</data><data key="desc">现在不仅是『天上的七骑士』的末席</data></node>
    <node id="日樱"><data key="name">日樱</data><data key="type">人物(瓦尔德的酒馆看板娘)</data><data key="status">provisional</data><data key="desc">此时浮现在我脑海中的，是在劳拉维亚的『舞闘会』决赛中看到的店长和店员日樱小姐的面容。；是看板娘日樱小姐的声音。；真的是基督君诶！这一年里你长高了──然而并没有！还是那个基督君呢！一点儿没变！！</data></node>
    <node id="翠之护身符"><data key="name">翠之护身符</data><data key="type">道具(首饰)</data><data key="status">provisional</data><data key="desc">可以保护身体抵御风属性攻击的首饰、【翠之护身符】。效果你知道吗？；钱的事情不用在意。将来你有钱了再付也行。不过要对罗德保密啊。；那是一条闪着翠色光辉的项链。雷纳尔多将它递到我手上。</data></node>
    <node id="阿尔缇"><data key="name">阿尔缇</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">虽然因为阿尔缇和芙兰琉莱的登场导致我对她的印象淡薄了一些；【十守护者】火之理的盗窃者；被缇达唤作阿尔缇的少女也散发着不负于他的压迫感。</data></node>
    <node id="Dimension"><data key="name">Dimension</data><data key="type">魔法(次元魔法)</data><data key="status">provisional</data><data key="desc">「――『Dimension·多重展开』。」；我将『Dimension‧多重展开』切换成『Dimension‧决战演算』，并准备迎击。；柔和的风吹了过来，『Dimension』因『魔法相杀』而被化解。</data></node>
    <node id="『支配之王』"><data key="name">『支配之王』</data><data key="type">称号·传说</data><data key="status">provisional</data><data key="desc">不过，北方诸国自信的原因，在『大灾厄』爆发的数月后──以传说中的『支配之王（Lord）』再临为标志终于被揭开。</data></node>
    <node id="古奈尔"><data key="name">古奈尔</data><data key="type">人物(吸血种)</data><data key="status">provisional</data><data key="desc">名字：古奈尔・库洛尼科尔・修尔斯・历基亚・英格利特；她就是那位传说中的『历基亚国名誉欠番姫』、同时也是英格利特大商会的领头人古奈尔酱」；在浑身颤抖了好一会儿之后，古奈尔酱一边疯狂摇头一边用假到爆的语气否定着。</data></node>
    <node id="沙鼠"><data key="name">沙鼠</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">通过『注视』，我得知怪物的名字叫做沙鼠</data></node>
    <node id="维度"><data key="name">维度</data><data key="type">魔法(探知)</data><data key="status">provisional</data><data key="desc">迫于压力，我连忙使用『维度』；于是我即刻停止魔法开发，转而使用『维度』；不过因为我拥有『维度』这一不讲道理的索敌能力，所以没什么难办的。只要在阶梯与阶梯之间沿着捷径跳跃的话，应该很快就能抵达上一层。</data></node>
    <node id="世界冰蛇"><data key="name">世界冰蛇</data><data key="type">魔法(冰结系攻击)</data><data key="status">provisional</data><data key="desc">「魔法『世界冰蛇』！！」；这是完全将MP的消费置之度外使出的冰结魔法。在展开『过密次元的真冬』的情况下使用这招，就算是『并列思考』也因为负荷过重发出了悲鸣。；这是因为『世界冰蛇』中凝聚了相当的质量和魔力。</data></node>
    <node id="大将军"><data key="name">大将军</data><data key="type">人物(职务称呼)</data><data key="status">provisional</data><data key="desc">尽管这只是在大将军负伤期间代行总司令职务的位子；按照原本的安排，为了配合大将军的负伤和斯诺大人的升职是想要调任一些虽然年轻但能力优秀的士官的。</data></node>
    <node id="『最深部之誓约者』"><data key="name">『最深部之誓约者』</data><data key="type">技能(前『？？？』)</data><data key="status">provisional</data><data key="desc">「──现在正是将我引导之时！！！『最深部之誓约者（The・Covenanter）』啊啊啊啊──！！」；The・Covenanter。我赋予它许下必将抵达最深部的誓约之人这一名字。；就这样，历经千年的岁月终于得到名字的技能实现了升华。</data></node>
    <node id="水晶蚂蚁"><data key="name">水晶蚂蚁</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">水晶蚂蚁：位阶26；斯诺立马展开追击，将水晶蚂蚁给打碎击毙了。</data></node>
    <node id="『龙之风』"><data key="name">『龙之风』</data><data key="type">魔法(龙系·风)</data><data key="status">provisional</data><data key="desc">再加上席卷而来的『龙之风』，这一撞在人眼中看来与台风直击无异。将之与灾厄同列毫不夸张。；这家伙的『龙之风』应该具备与阿尔缇的火焰相似的代行知觉器官的机能。；不过它为了再度探明我的所在而立刻将『龙之风』的领域向更广的范围扩展。更广的范围──这就意味着它将注意力偏向了远处。</data></node>
    <node id="虹之格雷姆"><data key="name">虹之格雷姆</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">虹之格雷姆：位阶27</data></node>
    <node id="沃尔斯"><data key="name">沃尔斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">「难道说沃尔斯老爷子其实是个很了不起的人？」；「那是当然。你可要好好尊敬人家哦」</data></node>
    <node id="混账三骑士"><data key="name">混账三骑士</data><data key="type">人物(集体称呼·据缇缇)</data><data key="status">provisional</data><data key="desc">可不要把人家跟那群脑子有病的混账三骑士相提并论呀；跟诺文和缇达不一样很温柔呢</data></node>
    <node id="雷纳尔多"><data key="name">雷纳尔多</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">这个在『佩艾希亚』也是一等一的物件啊。；就得将他身上所有的装备都仔细确认一番才好。装备也是要讲究平衡性的。；得打造出上好的武器让他免于依赖这种自爆用的道具才可以。首先就从这把剑开始着手吧。</data></node>
    <node id="佩艾希亚"><data key="name">佩艾希亚</data><data key="type">地点(人工空间·记忆收束城市)</data><data key="status">provisional</data><data key="desc">有关千年前的事，还有『这里』──『佩艾希亚』的事情一并呐」；我们走出了房间，在没有其他人居住的城堡里迈步。；以大量使用佩艾希亚特有的香料烤成的牛排为首，其它还有鸡肉海菜汤、蒸猪肉菜卷什么的。</data></node>
    <node id="幻之紫腕（DistanceMute）"><data key="name">幻之紫腕（DistanceMute）</data><data key="type">魔法(次元魔术·最高等)</data><data key="status">provisional</data><data key="desc">『噶啊、啊啊──A、Di──Di『幻之紫腕（DistanceMute）』！！』；旋即，原本抓在我肩膀上的手臂竟然轻而易举地伸入了我的体内。；根据其魔法构筑来看，这是一种可以无视物质存在的境界的最高等的次元魔术。而他的目的也显而易见。</data></node>
    <node id="WindLever"><data key="name">WindLever</data><data key="type">怪物(鸟型)</data><data key="status">provisional</data><data key="desc">魔力不断物质化，形成了鸟的脏器，骨胳，血肉，羽毛，最终一只怪鸟便诞生了。；WindLever 级别35──；为了对抗它的巨大身躯，我对剑身的长度做出调节。接着我一剑斩断无视我飞走的WindLever的翅膀，又对跌落的它补上第二剑斩落首级，解决掉它之后我重新回头面对帕林库洛。</data></node>
    <node id="帕林库洛的部下"><data key="name">帕林库洛的部下</data><data key="type">人物(南方联盟士官)</data><data key="status">provisional</data><data key="desc">他就是『南方联盟』分配给我的一名优秀的部下。；「千年后的未来……？我也是莱文教的信徒，对此有一定的了解……那是指引导了圣人缇娅拉的使徒西斯大人呢？还是致使北之王疯狂的使徒迪普拉库拉呢？」；应该是以前见过西娅·勒伽西吧。从而得知了她那低得异常的属性。</data></node>
    <node id="森之女王"><data key="name">森之女王</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">距离瓦尔德的迷宫入口最近的是『森之女王』。；我见证了『火焰箭』贯穿森之女王的咽喉并将其击毙的瞬间。</data></node>
    <node id="法芙纳"><data key="name">法芙纳</data><data key="type">人物(千年前·守护骑士)</data><data key="status">provisional</data><data key="desc">「在三骑士当中还没有出现的就只剩法芙纳了呢。⋯⋯说来惭愧，关于法芙纳的事，人家也不是很清楚。因为那家伙一直到最后都在极力避免跟人家一对一啊。人家知道的就只有他是『血之理的盗窃者』这一点罢了。；另外还有其他在千年前的南北战争中登场的人、像是诺斯菲的三骑士还有使徒这些人也拜托了</data></node>
    <node id="北之王"><data key="name">北之王</data><data key="type">人物(王)</data><data key="status">provisional</data><data key="desc">还是致使北之王疯狂的使徒迪普拉库拉呢？」</data></node>
    <node id="Default"><data key="name">Default</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">『Default』的效果是打造出次元的断层。；完成度高到能被『表示』认可的魔法目前只有『Default』而已。；「怎、怎么回事──！？──『Default』！！」</data></node>
    <node id="勒伽西家"><data key="name">勒伽西家</data><data key="type">家族(贵族武门)</data><data key="status">provisional</data><data key="desc">我所出身的勒伽西家，在贵族当中也是位高权重的家系，是优秀军人辈出的武门世家。；据说我的父亲、祖父、曾祖父，全都是身着这身军服报效国家，最终战死沙场。；「那个是勒伽西家秘传的魔法啦。然后我在小时候对它进行了改良，引而不发直到现在。一旦发动的话，对面肯定会陷入一片混乱的。」</data></node>
    <node id="新月琉璃制直剑"><data key="name">新月琉璃制直剑</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">我拿出了『新月琉璃』。；「对，那可是我自满的剑哦」；「很不错嘛这个。又坚固又轻便，还很锋利！」</data></node>
    <node id="赫勒比勒夏因家的神圣双剑『片翼』"><data key="name">赫勒比勒夏因家的神圣双剑『片翼』</data><data key="type">道具(武器)</data><data key="status">provisional</data><data key="desc">【赫勒比勒夏因家的神圣双剑『片翼』】；这个本来就是件宝物。但是，可惜的是失去了双剑中的另一把，无法发挥出原本的力量。；「赫勒比勒夏因家的神圣双剑『片翼』」</data></node>
    <node id="维度・曲战演算"><data key="name">维度・曲战演算</data><data key="type">魔法(次元属性·涡波·支援)</data><data key="status">provisional</data><data key="desc">「──『维度・曲战演算（Difference）』！！」；是专门用来制造误差的魔法。；首先利用『维度・决战演算』对空间的把握计算出敌人挥剑的轨迹。接着使用『Default』将剑即将通过的空间扭曲，破壊敌人的攻击和防御。就跟次元属性的『次元之冬』差不多。</data></node>
    <node id="Sylph·Rokh·Bringer"><data key="name">Sylph·Rokh·Bringer</data><data key="type">物品(魔剑)</data><data key="status">provisional</data><data key="desc">【Sylph·Rokh·Bringer】；攻击力11；装备者风魔法+0.50</data></node>
    <node id="『感应』"><data key="name">『感应』</data><data key="type">魔法(技能)</data><data key="status">provisional</data><data key="desc">不光是技能『感应』，从以往的经验中锻炼出来的直觉也是这样判断的。；我丝毫不觉得守护者会凭如・此・简・单・的・行・为就消失。</data></node>
    <node id="芙洛拉・塞斯提亚"><data key="name">芙洛拉・塞斯提亚</data><data key="type">人物(王族公主)</data><data key="status">provisional</data><data key="desc">「幸会，涡波大人。我是塞斯提亚国的芙洛拉・塞斯提亚。此次承蒙您出手相助，实在是感激不尽」；「芙洛拉殿下是塞斯提亚国国王的次女，拥有王位的第四继承权。虽然一直以来都住在海对面的联合国，但因为最近开拓地的局势也变得凶险起来，所以她接下来要回到本国的王都」；年纪看上去比我要稍微高一些，身高则略低于我。一头栗色的长发打理得非常漂亮，整个人的气质也相当高雅。在她身后还站着两名侍女。</data></node>
    <node id="青色魔石"><data key="name">青色魔石</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">那是一颗如蓝宝石般美丽的青色魔石。；接着，她将手中闪烁着的青色魔石展示给涡波看。；『水之理的盗窃者』的魔石开始吸收『始祖涡波』体内的『魔力』。话是这么说，但是青色魔石仍在睡眠状态。这是无意识的吸收。</data></node>
    <node id="支配之王"><data key="name">支配之王</data><data key="type">人物(千年前之王·据艾德)</data><data key="status">provisional</data><data key="desc">「——鄙人要再次打造一个王国，等待『支配之王（lord/洛德）』的归来。她必将于不远的将来从『那里』脱身吧。而这一次，胜利将紧握于『支配之王』手中。势必要经由我们的双手，为·大·陆·带·来·和·平·与·安·宁——！没错，因为这才是王的心愿，亦是鄙人的心愿——！！」；「正是。涡波大人的水准甚至可以成为『支配之王』再临之前的『王』的替代品。毕竟是有相应的实绩的人。」；「──鄙人要再次打造一个王国，等待『支配之王（Lord/罗德）』的再临。她必将于不远的将来从『那里』脱身吧。而这一次，胜利将紧握于『支配之王』手中。势必要经由我们的双手，为大陆带来和平与安宁──！没错，因为这才是王的心愿，亦是鄙人的心</data></node>
    <node id="艾米丽"><data key="name">艾米丽</data><data key="type">人物(魔石人类·神圣魔法使)</data><data key="status">provisional</data><data key="desc">这边这位、真的是快要不行了哦⋯⋯；这名银发黑瞳的少女是在探索时使用神圣魔法为艾尔君打后援的魔法使。；在状态栏上记有『素体』这一技能。再看她身上这种不协调的氛围，可以肯定她是一名『魔石人类』</data></node>
    <node id="『北』的王国"><data key="name">『北』的王国</data><data key="type">地点(千年前·王国)</data><data key="status">provisional</data><data key="desc">在这个什么都没有的区域，涡涡用次元魔术，将过去存在的『北』的王国，就那样做了出来。</data></node>
    <node id="CallOuter"><data key="name">CallOuter</data><data key="type">道具(迷宫拾得防具)</data><data key="status">provisional</data><data key="desc">看着「CallOuter」「AllConfess」「BloodSword」这些原本因为精神污染而没法使用的东西，我不由地期待起来。；防御力6</data></node>
    <node id="悬影"><data key="name">悬影</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">怪物的名字叫悬影。</data></node>
    <node id="赫勒比勒夏因之神圣双剑『片翼』"><data key="name">赫勒比勒夏因之神圣双剑『片翼』</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">「赫勒比勒夏因之神圣双剑『片翼』」；是我过去在迷宫的祭坛上入手的逸品。；「这把剑带有赫勒比勒夏因家的铭文，我觉得应该是适合莱纳使用的，但这个似乎原本是成对使用的武器，只有这一把的话好像没办法发挥出本来的力量」</data></node>
    <node id="石英巨蟹"><data key="name">石英巨蟹</data><data key="type">怪物</data><data key="status">provisional</data><data key="desc">石英巨蟹位阶31；和螃蟹的习性一样，石英巨蟹是横向行走的怪物。；然而破碎的只有石英巨蟹的蟹钳而已。『阿雷亚斯家的宝剑诺文』毫发无损。</data></node>
    <node id="HolyElement"><data key="name">HolyElement</data><data key="type">人物(迷宫61层怪物·精灵)</data><data key="status">provisional</data><data key="desc">【怪物】HolyElement：位阶62；明明位阶很高，但这些徘徊着的精灵系怪物对我们并没有什么兴趣。；「怪物」HolyElement：级别62</data></node>
    <node id="魔石人类的少女"><data key="name">魔石人类的少女</data><data key="type">人物(魔石人类·再诞容器)</data><data key="status">provisional</data><data key="desc">目前在我的身体里有四成，那边那孩子的体内差不多有五成]；所以这孩子是好好地走过了属于她自己的人生的。虽然寿命不到一年，但她确实以她的身份走完了自己的人生。；她本人亲自表示愿意在死后让缇娅拉大人使用自己的身体」</data></node>
    <node id="『所有物』"><data key="name">『所有物』</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">于是莱纳匆忙开始收拾房间里的私人物品。话虽如此，不过东西本来就不多。毕竟大部分物品都放在我的『所有物』当中。；我从『所有物』中取出在迷宫深部入手的魔石，还有金钱的分配都迅速处理妥当。</data></node>
    <node id="感应"><data key="name">感应</data><data key="type">技能(感知·涡波)</data><data key="status">provisional</data><data key="desc">莱纳怀疑我的意识是否清醒。但是，那是技能『感应』──结合了至今为止的所有经验做出来的决定。对于那个预感，确实的感觉到了某种确信。</data></node>
    <node id="维斯·海利普洛佩"><data key="name">维斯·海利普洛佩</data><data key="type">人物(莱纳体内之魂)</data><data key="status">provisional</data><data key="desc">更重要的是，在你体内的维斯·海利普洛佩又是怎么说的？；那便是维斯·海利普洛佩；经过维斯的调解，我们两个现在应该能做到齐心协力。</data></node>
    <node id="劳拉维亚"><data key="name">劳拉维亚</data><data key="type">地点(国)</data><data key="status">provisional</data><data key="desc">对于曾经以『史诗探索者』会长的身份守护过劳拉维亚的我来说，这个国家就像自家的庭院一样。；这一切，都跟劳拉维亚内熟练的锻冶师的动作一模一样。；这座城堡还被河流所围绕着。是条大到足以令我想起劳拉维亚的法芙拉河的河流，而其仅仅只用一座桥连接着城外。</data></node>
    <node id="维度・多重展开"><data key="name">维度・多重展开</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">「──『维度・多重展开』」；扩大了魔法感知的范围，对于时间、地点和其他人的存在一一进行确认。；尽管整座城堡都被涵盖在『维度』里面，最终我还是连一个人都没见到。</data></node>
    <node id="诺瓦露"><data key="name">诺瓦露</data><data key="type">人物(魔石人类)</data><data key="status">provisional</data><data key="desc">就像双胞胎一样相似的长相，说话的声音也像极了。但是还是有一个很大的区别，那就是她们的颜色。大声打招呼的孩子头发是红色的，比较文静的那个头发是黑色的。她们身上那满是花边的两件洋服也以红色和黑色作分。；「非也，露洁我们也不是白给的，相川涡波先生，你的实力如何，我们还是能看出来的。唔姆，自诞生以来，我们这还是第一次见到英雄啊。请多关照，红色的名叫露洁，黑色的叫诺瓦露。因为长相相似分辨起来不容易，你就用颜色为特征来区分我们吧。」；「是了，是了。看上去确实很了不起呢，这位英雄大人。请务必要成为我们的伙伴……不，可能的话，希望你能成为我的主人，呵呵、呵呵呵，成为我所侍奉的主人——！」</data></node>
    <node id="雷纳尔多•沃尔斯"><data key="name">雷纳尔多•沃尔斯</data><data key="type">人物(兽人·锻冶师)</data><data key="status">provisional</data><data key="desc">姓名：雷纳尔多•沃尔斯HP589/589MP123/123职业：锻冶师；如果是在地上，他毫无疑问是英雄等级的人物。；莱纳尔多将桌上的金币拿起来看了看之后冲我摇了摇头。</data></node>
    <node id="Divaplays・Arrow"><data key="name">Divaplays・Arrow</data><data key="type">魔法(神圣·共鸣光矢)</data><data key="status">provisional</data><data key="desc">「我们未尝不知自己的力量有所不足！不过，力量不足的人也有力量不足的人特有的战斗方式！『永久浮沉矣』！『于无垠之魂中延展之梦兮』『听此咏诵森罗万象之赞歌』！──『Divaplays・Arrow』！」；除了刻在血中的自动进行的『咏唱』之外，还加上了她们亲口诵祷的『咏唱』，两者合二为一最终释放出神圣魔法。；为缇缇所特有的「自由之风」充斥整个战场，三名『魔石人类』赌上性命打造的光矢顷刻间便冰消瓦解。</data></node>
    <node id="玛利亚·迪斯特拉斯"><data key="name">玛利亚·迪斯特拉斯</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：玛利亚·迪斯特拉斯HP39/P35/3541M职业：奴隶；「……我叫玛利亚。我的名字是玛利亚。」；先天技能：炯眼1.43</data></node>
    <node id="堕落使徒"><data key="name">堕落使徒</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">握着『阿雷亚斯家的宝剑诺文』和『堕落使徒』倒在地上的莱纳。以及我最珍爱的正在睡眠状态中的妹妹阳滝。；右手握着『诺文』，左手握着『堕落使徒』，我向前迈出一步。</data></node>
    <node id="WindWing"><data key="name">WindWing</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">「──风魔法『WindWing』！！」；但包裹在他身上的风之衣确实能够无视重力。；莱纳抓住我的手之后继续飞翔。</data></node>
    <node id="『LivingLegend号』"><data key="name">『LivingLegend号』</data><data key="type">载具(客船)</data><data key="status">provisional</data><data key="desc">「这里不是弗茨亚茨，而是『LivingLegend』号。我们已经是探索者了，必须要学会忍耐才行。」；那是在『LivingLegend号』上的拉丝缇娅拉的房间里。；最后又回到了『LivingLegend号』上的拉丝缇娅拉的房间。</data></node>
    <node id="菲伊・厄鲁斯"><data key="name">菲伊・厄鲁斯</data><data key="type">人物(恶德商人·奴隶商)</data><data key="status">provisional</data><data key="desc">我夺走了菲伊・厄鲁斯的全部，将他驱逐。；虽然我给他留下了最低限度的金钱，但今后他还能东山再起的可能性怕是很低吧。；不愧是名震五国的恶德商人，只是路过一下就携带着如此不寻常数量的财产。</data></node>
    <node id="赫勒比勒夏因之神圣双剑·片翼"><data key="name">赫勒比勒夏因之神圣双剑·片翼</data><data key="type">物品(武具)</data><data key="status">provisional</data><data key="desc">【赫勒比勒夏因之神圣双剑·片翼】；遗失了片翼，失去了原本的力量；「——这个没有诅咒呢。好像是以前的赫勒比勒夏因家的宝剑来着。」</data></node>
    <node id="拉古涅·卡伊库欧拉"><data key="name">拉古涅·卡伊库欧拉</data><data key="type">人物</data><data key="status">provisional</data><data key="desc">姓名：拉古涅·卡伊库欧拉HP152/153MP34/34职业：骑士；相对的是从她空着的另一只手上伸出了一把固体化的魔力之刃。；姓名：拉古涅·卡伊库欧拉HP158/161MP36/36职业：骑士</data></node>
    <node id="毒之火蜥蜴"><data key="name">毒之火蜥蜴</data><data key="type">人物(迷宫生物)</data><data key="status">provisional</data><data key="desc">【怪物】毒之火蜥蜴：位阶23</data></node>
    <node id="风龙"><data key="name">风龙</data><data key="type">人物(怪物·迷宫第六十六层)</data><data key="status">provisional</data><data key="desc">现在确实是因为风龙的阻碍陷入困境了对吧；其实我已经有对付那条风龙的办法了。要说不足的话，就是需要用到的魔法消耗甚大这点吧。；不光是魔法的问题，装备的问题也解决了，攻略风龙的自信越来越充分。</data></node>
    <node id="圣女大人"><data key="name">圣女大人</data><data key="type">人物(传说)</data><data key="status">provisional</data><data key="desc">我记得自己曾入宫觐见，还成为了圣女大人的近卫骑士。</data></node>
    <node id="魔法『致亲爱的一闪』"><data key="name">魔法『致亲爱的一闪』</data><data key="type">魔法(剑技)</data><data key="status">provisional</data><data key="desc">最好可以处在随时都能使用『致亲爱的一闪』的状态。</data></node>
    <node id="次元之理的盗窃者"><data key="name">次元之理的盗窃者</data><data key="type">人物(千年前始祖)</data><data key="status">provisional</data><data key="desc">而他的相貌就跟预料中一样，长着跟我一模一样的脸。除『相川涡波』之外不可能是别人的男子跪坐在石制地砖上。；如果要给这名男子起一个名字的话，就是『次元之理的盗窃者』。此外无他。；都是你们的唆使，让我创造出什么『咒术』，结果就是这玩意儿！</data></node>
    <node id="涡波邀请格连入队被拒"><data key="name">涡波邀请格连入队被拒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「格连，姑且一问。⋯⋯你要不要也加入我的队伍？」；「⋯⋯这个做不到啊。你的队伍，换言之不就是帕林库洛的受害者群体吗？我没有那个资格啊」；性格姑且不论，格连的才能是绝对OK的。而且性别也是最棒的，能够缓和我现在身边的男女比例。</data></node>
    <node id="诺斯菲翻脸宣战与黑光自白"><data key="name">诺斯菲翻脸宣战与黑光自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──唉。看来是没用了呢。」；「果然，我就只有涡波大人而已呢。非涡波大人不可啊。呵呵，呵呵呵呵」；这可是即使过上几万年也能与过去相连的有趣空间</data></node>
    <node id="斯诺精神创伤再现与战逃（168话）"><data key="name">斯诺精神创伤再现与战逃（168话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这一变化就跟缇达一样。帕林库洛只针对斯诺解放出了『暗之理的盗窃者』的力量。；遭到威胁的斯诺浑身发抖。；帕林库洛正要结果浑身发抖的斯诺时，莉帕的镰刀挡下了他的攻击，斯诺幸免于难。</data></node>
    <node id="罗德咏唱自白与魂之魔法阵"><data key="name">罗德咏唱自白与魂之魔法阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这一次铺展而成的魔法阵大小已经超越星辰。；咚地一声，罗德踏立其上。；明明她已经驻足不动，却以更甚以往的劲头吟诵「加速」的咏唱。</data></node>
    <node id="千年前真相：救阳滝计划与勒伽西背叛（记忆之旅）"><data key="name">千年前真相：救阳滝计划与勒伽西背叛（记忆之旅）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在那不留任何生息的死之荒野上，『始祖涡波』与『缇娅拉』迎面而立。；「你忘了吗？是相当久之前的事了哦？——就是『迷宫』啊。」；「唔，更高的次元？可是将所有的魔力集中到一个地方，这不是跟西斯姐的目的一样吗？」</data></node>
    <node id="第三天晨间状态确认与全戒充魔"><data key="name">第三天晨间状态确认与全戒充魔</data><data key="type">event</data><data key="status">provisional</data><data key="desc">名字：相川涡波HP293／293MP945／945职业：探索者；这两天的工作也有了成果，我的锻冶技能顺利成长了。；昨天晚上我将魔力注入了所有的「空白之戒」中，应该储存了远超『表示』的大量魔力。</data></node>
    <node id="搜刮死者与『表示』规则习得"><data key="name">搜刮死者与『表示』规则习得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">异象陡生，空间扭曲着将肉干吞没。</data></node>
    <node id="海因侯普思遭遇与决斗②"><data key="name">海因侯普思遭遇与决斗②</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「你是、那时候的少年……原来如此，你就是大小姐心仪之人吗……」</data></node>
    <node id="斯诺窃听暴露与逃亡"><data key="name">斯诺窃听暴露与逃亡</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我找到船内的斯诺。；一个人待在房间里的斯诺，肩膀猛地一抖，接着甩了甩脑袋，然后看向天空「诶嘿嘿～」地笑着打算跟我装没事儿人。；斯诺一下子吓得脸都绿了，拔腿就跑。</data></node>
    <node id="阳滝死讯直受（涡波）"><data key="name">阳滝死讯直受（涡波）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">也就是说，不管我是『魔石人类』还是『相川涡波』，确实都无所谓了，因为『相川阳滝』已死，她已经不在这个世界上了。；阳滝已死。；这一事实化作了楔子，扎进了我的心头，想拔也拔不出来。</data></node>
    <node id="轮盘ALL-IN连胜与赌场禁用"><data key="name">轮盘ALL-IN连胜与赌场禁用</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『阳』的三之二⋯⋯ALL-IN的这位客人，您赢得了72倍的赌金⋯⋯」；从游戏的后半段开始就一直盯着赢个不停的我看着的店员们低下了头。恐怕是想找出我出千的证据，却什么都没看出来吧。；然后被赌场方告知不能继续使用赌场设施。我没有多做纠缠便同意了。</data></node>
    <node id="缇缇『自由之风』制压全域"><data key="name">缇缇『自由之风』制压全域</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『自由之风』啊！去把她们的『咏唱』分解掉！！」；缇缇毫不客气地摁着敌人的脑袋砸向地面，令之当场昏厥；作为追击，风像鸟笼一般从周围将三名『魔石人类』紧紧裹住。</data></node>
    <node id="斯诺窃听发觉与清晨对质"><data key="name">斯诺窃听发觉与清晨对质</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这时候我察觉到了异常。技能『感应』发现了危险，促使我赶紧采取措施。；「啊，那个－⋯⋯，昨天那事被你听到了吗⋯⋯？」；「嗯⋯⋯⋯稍微有点在意，就用振动魔法听了下⋯⋯」</data></node>
    <node id="死后黑暗：守护者规则宣读与孤之留恋作答"><data key="name">死后黑暗：守护者规则宣读与孤之留恋作答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——《理的盗窃者》死后会成为《守护者》，在千年后的《迷宫》里等待具备资格者的到来。那名具备资格之人应当可以让《守护者》消失，所以希望《守护者》们等到那个时候——如此这般。；想必所有的答案都潜藏在《过去》之中吧。；还有光是回想就能引人发狂的《千年后日谈》等着自己。</data></node>
    <node id="剑与盾的最终激突（胜负未揭）"><data key="name">剑与盾的最终激突（胜负未揭）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是用黑色液体防住了炎之剑掉头的帕林库洛。；「缇达！！这对手不得了！帮我一把──！！」；「阿尔缇！！把力量借给我！给我足以将那个男人烧成灰烬的火焰──！！」</data></node>
    <node id="劳拉维亚社交舞会"><data key="name">劳拉维亚社交舞会</data><data key="type">event</data><data key="status">provisional</data><data key="desc">内容是邀请我参加劳拉维亚举办的『舞会』。；「我反而忐忑得很。看样子，这回之所以找我参加，是因为我受到了劳拉维亚王族的注意……」</data></node>
    <node id="涡波vs艾尔米拉德北区第四轮对决"><data key="name">涡波vs艾尔米拉德北区第四轮对决</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那、那个，也就是说要将『英雄的名誉』和『跟斯诺大人之间的婚约权』作为赌注进行一对一的战斗是吗？现在就开始并且无规则？」；『一之月联合国综合骑士团舞会』北区第四轮比赛，现在开始！！</data></node>
    <node id="复活阳滝计划确立（师徒和解后的千年计划）"><data key="name">复活阳滝计划确立（师徒和解后的千年计划）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「也、也是啊。接下来的事情更重要呢。不能再失败了。──『接下来』就是让阳滝苏醒过来了」；虽然技术性的东西由缇娅拉来提供，但是计划的主导者是涡波。看来这两人在这两个方面是有适性的问题。就像是恢复了曾经的师徒关系一样，缇娅拉的双眼闪着光聆听涡波的设想。；「是啊，问题都解决了。──接下来，我打算用上一千年的时间，将阳滝的身体净化到一级为止。接着，再将我的灵魂送入她的身体内，一边收集被迷宫『想起收束（Drop）』的『魔力』和『魔石』一边向『最深部』进发。虽然这样避免不了自身实力的弱化，但是在预定中缇娅拉也会在千年后进行『再诞』，所以可以放心」</data></node>
    <node id="冰火魔树与无名爆裂魔法对决"><data key="name">冰火魔树与无名爆裂魔法对决</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不，准确来说是玛利亚一个人想出来的魔法才对……我只是为了实现她的杀意而帮忙构成魔法术式罢了。；以我的身体为根基树立而起的冰结魔力化作了淡青色的树干。冻结的空气接连构成水晶色的枝芽。再配以玛利亚的火炎，薄青色的大树在火炎的熏染下，绽放出真红之花。；就这样，『DarkSphere』在我们两人的合力之下遭到了强行的『魔法相杀』。</data></node>
    <node id="决赛第一阶段(师徒剑术对决)"><data key="name">决赛第一阶段(师徒剑术对决)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">缇亚拙劣的剑技、在酒馆学到的异世界剑术知识、从迷宫探索者们身上偷学的技术、缇达强硬的刚剑——明明是将我在迷宫中的经验全部络合升华而出的『剑术』，但是诺文仍然完全地防御下来。；无法回避的剑终究还是将我的剑击飞了，『新月琉璃制直剑』此刻正飞舞在空中。</data></node>
    <node id="海因的解放与单骑叛乱"><data key="name">海因的解放与单骑叛乱</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就算海因·赫勒比勒夏因这枚棋子会就此倾折也在所不惜——……</data></node>
    <node id="裸泳骚动与泳装制作决意"><data key="name">裸泳骚动与泳装制作决意</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「诶～，裸泳不是很好的吗。呐，玛利亚酱，要一起游吗？」；「即使死了我也不要。」；「不是，因为有涡波先生在，就这样露出肌肤实在有点⋯⋯」</data></node>
    <node id="莱纳对塞拉的决斗败北"><data key="name">莱纳对塞拉的决斗败北</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——毕竟我昨天在与塞拉的决斗中被一边倒地击败了。；我清楚地记得灯光之下、月华满地，在酒馆后面发生的决斗迎来了怎样的结局。；顺带一说，那场决斗的赌注，是如果我赢了的话『塞拉就要将她知道的事和盘托出』——如果塞拉赢了那么就『只将原委告知于我但不可以向涡波透露分毫』。</data></node>
    <node id="决战风龙日程确定·请假与对罗德保密"><data key="name">决战风龙日程确定·请假与对罗德保密</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不光是魔法的问题，装备的问题也解决了，攻略风龙的自信越来越充分。；「嗯。对老朽而言，也是希望小子你越早回到地上越好。明天你就放心去挑战吧。；「不过，不要勉强啊。一旦死了的话，那就什么都白费了。难关恐怕不止六十六层而已」</data></node>
    <node id="拉丝缇娅拉现身地下房间"><data key="name">拉丝缇娅拉现身地下房间</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就在这时，伴随一阵长靴踢踏石板的声音，一名新的来访者走进了房间。；「接下来的话让我来讲怎样？」；来者正是话题的中心人物拉丝缇娅拉・弗茨亚茨。</data></node>
    <node id="『流星』余波重创与按预定生还"><data key="name">『流星』余波重创与按预定生还</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『流星』的直击──被我躲过了。；名字：相川涡波HP32／353MP134／1165－200职业：探索者；重新审视被『流星』撕裂的世界，我确认了一切都在按照预定进行。</data></node>
    <node id="莱纳与艾德的一对一交锋（小树枝对双剑）"><data key="name">莱纳与艾德的一对一交锋（小树枝对双剑）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">仅仅一个小树枝居然能跟宝剑交锋，甚至进发出火光；看来他想要回避战斗，只打算回收作为目标的东西。</data></node>
    <node id="魔法命名传授与『风刃剑』初实证"><data key="name">魔法命名传授与『风刃剑』初实证</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「晓得了。那我就试试好了。毕竟要是喊两声就能变强的话也挺合适的不是么」；「──魔、魔法，──『风刃剑』！」；「太嫩了，莱纳！你的想像还不够啊！</data></node>
    <node id="圣诞祭落幕之战"><data key="name">圣诞祭落幕之战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，以相川涡波这个异邦人中途脱队为结，许许多多人的愿望齐聚一堂的圣诞祭终于落下了帷幕——</data></node>
    <node id="艾德的愿望与『支配之王』的誓约"><data key="name">艾德的愿望与『支配之王』的誓约</data><data key="type">event</data><data key="status">provisional</data><data key="desc">⋯⋯那么，就请您将更多的『现在』、将这个时间赐给我吧；不，『支配之王』。自己想要的是和平。因为自己对这个国家的这个村子──不，自己最喜欢的就是这个家；是、是这样吗⋯⋯可是对自己来说，这就是比金币还要贵重的『宝物』了呀⋯⋯</data></node>
    <node id="泳装制作着手"><data key="name">泳装制作着手</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为学会了锻造技能的缘故，我对制作物品觉醒了兴趣。；途中，经过了白色的少女和缇亚的房间。；两个人，都如同死了一般的熟睡着。</data></node>
    <node id="无言共鸣『冰・Aegis』再发动与莉帕『连接』魔力传送"><data key="name">无言共鸣『冰・Aegis』再发动与莉帕『连接』魔力传送</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我紧紧地握住拉丝缇娅拉的手，将冷气传向她脸旁。；接着我发动了没有内在的冻结魔法。是只有我一个人使用的话便没有任何意义，紧紧作为框架的魔法。；正处于混乱当中的拉丝缇娅拉眼中闪过理解之光。她随即将自己的感情压制住，把自己的冻结魔法灌注到我的冻结魔法中产生共鸣。</data></node>
    <node id="涡波决意检验心意并夜访拉丝缇娅拉"><data key="name">涡波决意检验心意并夜访拉丝缇娅拉</data><data key="type">event</data><data key="status">provisional</data><data key="desc">唯一有可能的就是拉丝缇娅拉了吧。；我决定要尽早采取行动。并且发誓不能欺骗自己，实事求是地去检验。；下定决心后，我前往拉丝缇娅拉的房间。</data></node>
    <node id="涡波只身迎击七艘海盗船队"><data key="name">涡波只身迎击七艘海盗船队</data><data key="type">event</data><data key="status">provisional</data><data key="desc">水柱在『LivingLegend号』附近升起。；拓展『维度』，我发现了远处的船队。数量为七。来了一群。；「没办法。先给他们抓起来，然后问问看为什么这么执着于我们吧」</data></node>
    <node id="说服罗德·向居民报平安"><data key="name">说服罗德·向居民报平安</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「意思是说，只要让艾德对你不抱有期待就可以了吧？；罗德恢复了气力，回握我伸出的手。；对此，罗德点了点头。接着，她以稳健的步伐——坐·到·了·王·座·上。</data></node>
    <node id="奴隶解放与西斯误认骚动"><data key="name">奴隶解放与西斯误认骚动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">被海盗们捕获的奴隶们所有人都没有受伤。；「⋯⋯谢谢你，大哥哥」；「西、西斯大人⋯⋯？」</data></node>
    <node id="缇亚的剑术梦想之争"><data key="name">缇亚的剑术梦想之争</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「可是，没有时间了啊。我必须要尽快得到『力量』和『金钱』才行……」</data></node>
    <node id="技能『？？？』对策甲板商谈"><data key="name">技能『？？？』对策甲板商谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那么，使用拉丝缇娅拉和缇亚的魔法，能解决技能『？？？』的问题吗？可能的话我想给它消除掉」；「不不，再怎么说消除技能这种事也是前所未闻啊⋯⋯」；「封印应该也做不到吧。恐怕，帕林库洛那家伙不仅仅用了魔法，还使用了『咒术』吧。而且还是借用了『暗之理的盗窃者』缇达的力量，就算是我们也模仿不来的⋯⋯」</data></node>
    <node id="零消耗抵达六十层"><data key="name">零消耗抵达六十层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这之后，诺斯菲还是一样给罗德戴着高帽，迷宫攻略也由此一帆风顺。越接近六十层，没有战意的光属性怪物越多，所以攻略一直都是越来越轻松。；我和莱纳就这么丝毫没有消费HP和MP便抵达了六十层。；可以说回到地上这事儿已经是稳了。跟像被『将死』一样困在六十六层进退两难的时候比起来，前途一片光明。</data></node>
    <node id="缇亚约会与芙兰琉莱谈话"><data key="name">缇亚约会与芙兰琉莱谈话</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『基督』必须由我来守护……这一次必须由『我（私）』来……」；「莱纳是吗？莱纳他说是要做『舞斗大会』警备员的志愿者来着。他说因为在我们参加『舞斗大会』的期间很闲所以……」</data></node>
    <node id="并列思考丧失自认（强化论）"><data key="name">并列思考丧失自认（强化论）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为『并列思考』是妹妹的才能，因此现在的我在思考上没有多少余力。；果然，我再次确认了技能『并列思考』实在是一项画蛇添足的力量。；可能失去技能『并列思考』对我来说并不是弱化，而是一种强化吧。</data></node>
    <node id="涡波与莱纳的柯尔库和解"><data key="name">涡波与莱纳的柯尔库和解</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽说是在找人，但是名字并不是我们。如果我读唇正确的话，他在说的是『栗色的头发』『个头小但是吵人』『西娅·勒伽西』。；「哈啊……果然基督·欧亚，并不是什么坏人啊。你还是跟我们第一次见面那时一样……」；「是啊……我一定会搞清楚的，绝对会。不靠任何人的一家之言，而是用我自己的眼睛——」</data></node>
    <node id="女孩失宝奔逃·孤惊觉其为幼年自己（视角合一）"><data key="name">女孩失宝奔逃·孤惊觉其为幼年自己（视角合一）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就好像冥冥之中注定了一样，女孩来了个平地摔。；结果握在她手中的小石头也因为摔的这一跤脱手了。；那前面是──地・狱・啊。</data></node>
    <node id="探索模式转换：莉帕领队·遇敌即砍"><data key="name">探索模式转换：莉帕领队·遇敌即砍</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「难得大家一起来一次，每个人都发挥自己的专长才是最合适的呀。而且因为焦虑而临时抱佛脚的话，没准会酿成恶果的」；就这样，在领队莉帕的指引下，我们一行人在31层继续前进着。；这也是因为塞拉小姐的攻击一般没法给敌人造成伤害的原因。我考虑起应该专门为她的『兽化』形态准备相应的武器。</data></node>
    <node id="第五次探索·宣言直返地上与强行军"><data key="name">第五次探索·宣言直返地上与强行军</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着，我和莱纳取捷径直接转移到了昨天在五十七层尽头设置的传送点。；这是第五次探索，并且又变回了两人小队。；「莱纳，我们要在这次的迷宫探索中直接回到地上。」</data></node>
    <node id="海莉莱纳介入·再诞对质与海莉出阵"><data key="name">海莉莱纳介入·再诞对质与海莉出阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——不可」；拂去透明的风之裳，银发少女现身了。；「你听好，少年。帕林库洛是没有能力让死者复生的」</data></node>
    <node id="托口信与莱纳离队"><data key="name">托口信与莱纳离队</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我很快就会带妹妹赶回来。到那时，我们两个再好好谈一谈吧。我希望你替我这样转告她」；就这样，留在房间里的人只剩下我和缇缇。；这样一来，从和帕林库洛决战之后便一直待在我身边的莱纳就离队了。队伍变成了只有我和缇缇的二人组。</data></node>
    <node id="沙海祭坛诅咒剑（Raked・Blade）鉴定与破壊"><data key="name">沙海祭坛诅咒剑（Raked・Blade）鉴定与破壊</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在跟斯诺一起进行迷宫探索的时候，我在24层的祭坛上找到了『堕落使徒』；攻击力5精神污染+1.50；一瞬间就像发生了化学反应般，剑开始喷发出薄雾。</data></node>
    <node id="诺文败北与消失开始(莉帕袭击)"><data key="name">诺文败北与消失开始(莉帕袭击)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">结果便是『新月琉璃制直剑』抵在了他心脏的正后方。；他还有最后一个牵挂存在。</data></node>
    <node id="当前：挣脱前日谭·死亡诅咒半死体化（夏比变异种显现）·涡波导回更早世界"><data key="name">当前：挣脱前日谭·死亡诅咒半死体化（夏比变异种显现）·涡波导回更早世界</data><data key="type">event</data><data key="status">provisional</data><data key="desc">也就是从涡波的魔法《次元决战演算『前日谭』》的力量中挣脱了出来。；所以孤才需要你和莱纳留在这里啊啊啊啊啊啊！！；这是在理的盗窃者们死亡之际发动的『诅咒』。</data></node>
    <node id="柯尔库安全宣言与本土望见"><data key="name">柯尔库安全宣言与本土望见</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「请问是要到『柯尔库』了吧⋯⋯？不过我听说现在的本土正处于战时，没问题吗⋯⋯」；「确实本土正处于战争，但『柯尔库』是安全的。战火绝对不会烧到柯尔库城下。请放心吧，涡波大人、芙洛拉殿下」；「毕竟镇守『柯尔库』的，可是我们的代理总司令──斯诺・沃克大人啊！无论发生什么问题，斯诺大人都会予以解决的！！」</data></node>
    <node id="第二次迷宫探索出发（新阵容）"><data key="name">第二次迷宫探索出发（新阵容）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「也就是说，今天的成员是我，拉丝缇娅拉，莉帕，塞拉？」；在我重游戏性的思考下，对队伍平衡的失调感到了些许的担心。；这丫头今天也是一副要尽情享受自由的嘴脸。总有一天，就算是强拉我也要给她带进迷宫去。</data></node>
    <node id="千年前涡波与罗德邂逅·咒术Dealing契约成立·编入北方"><data key="name">千年前涡波与罗德邂逅·咒术Dealing契约成立·编入北方</data><data key="type">event</data><data key="status">provisional</data><data key="desc">孤与『世界的异物（涡波）』邂逅了。；[缇达、诺文、法芙纳这三骑士。再加上诺斯菲。用你『支配之王』所拥有的力量将这些『理的盗窃者』压制住，在那期间我要去杀掉作为一切元凶的使徒]；[你就等好吧，罗德。我很快就会动手的。我一定会把你的国家毁掉。说实话，我早就看这个国家不顺眼了。</data></node>
    <node id="过去视确认与同伴情报交换"><data key="name">过去视确认与同伴情报交换</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──呼。斯诺，果然原因出在玛利亚身上。我刚才用『维度』透过留存在此地的魔力确认了当时的情况，不会有错的」；「另外还有莉帕和格连，而且连西娅酱也在玛利亚身边」；比起莉帕，斯诺更在意格连的问题。想来也是，因为我此前在『史诗探索者』得到的消息也说他正投身于战事之中，或许是在中途抽身了吧。</data></node>
    <node id="世界奉还阵『完全解放』·超大型怪物召唤潮"><data key="name">世界奉还阵『完全解放』·超大型怪物召唤潮</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「将暴走中的『世界奉还阵』给『完全解放』──，同时进行『同化』──！！」；紧接着，新的怪物们如同浮出海面一般自地面诞生。；『世界奉还阵』的范围可是囊括了本土的一半之多，变换对象远远不止战场上这几万人！几十万──不，成千上万的活物都将被吞噬到大陆之内！</data></node>
    <node id="锻冶师承揭示与神铁锻冶断定"><data key="name">锻冶师承揭示与神铁锻冶断定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──会长，你之前说自己练习了锻冶，请问是在什么地方练习的？」；「真不愧是艾利巴茨，果然看得出来吗。我之前有幸能在传承了千年前的锻冶技术的人手下工作。我想应该是多亏了这个原因」；「说起连我也见所未见的技术的话，那毫无疑问就是『神铁锻冶』的领域了。我方便打听一下那个流传有千年前的锻冶技术的地方是哪里吗？可能的话我想去拜会一下」</data></node>
    <node id="弥诺陶洛斯战与次元雪开发"><data key="name">弥诺陶洛斯战与次元雪开发</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】深红弥诺陶洛斯位阶：20</data></node>
    <node id="誓约再燃·章末未知之风"><data key="name">誓约再燃·章末未知之风</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是至今为止从来不曾有过的感觉。是单纯想要回应他人的信赖的意念。；「『加速加速加速』！『天路垂临』『续道碧霄』──！！」；所以我不可能向世界祈乞，对我来说──世界是『敌人』</data></node>
    <node id="全员滞留一万年计划提案"><data key="name">全员滞留一万年计划提案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──不过，请您放心！涡波大人！我们已经想好了可以让所有人都接受的计划！呋呋呋，这是罗德和我一起考虑出来的令人满意的主意！！」；「震惊，其实涡波大人根本就没有去『地上』的必要！只要大家都留在『这里』生活，那一切就可以解决了！；您就花上一万年的时间留在『这里』回顾过去怎样？</data></node>
    <node id="西斯的言语攻势与『Shunposhion・Feather』逃脱"><data key="name">西斯的言语攻势与『Shunposhion・Feather』逃脱</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那么，为什么，没有多珍惜提亚呢？」；让我构建的魔法在一瞬间停止了；再见了『基督』，魔法『Shunposhion・Feather』！</data></node>
    <node id="艾德一行动向（北上兴国/莱纳被捕）"><data key="name">艾德一行动向（北上兴国/莱纳被捕）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「艾德老师他带着西娅和露洁还有诺瓦露一起前往『北方』去了。说是为了兴建国家而要招笼人才来着。；「他找帕林库洛复仇结果被反杀了，之后就被关进了牢房里」</data></node>
    <node id="帕林库洛捏碎心脏·完死体化"><data key="name">帕林库洛捏碎心脏·完死体化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">亲手捏碎了自己心脏的帕林库洛缓缓地说：；二十守护者（TwentyGuardian）暗之理的盗窃者；『表示』也将帕林库洛确认为怪物。</data></node>
    <node id="拉丝缇娅拉拒绝告白真因判明（怒为缇娅拉）"><data key="name">拉丝缇娅拉拒绝告白真因判明（怒为缇娅拉）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">昨天听到基督告白的时候，你说你讨厌他，那是真的吗？；竟然还跟与她神似的『魔石人类（我）』告白什么的；既然涡波那时候受到了跟我一样的回复魔法，那他肯定也看到了千年前记忆的片段不是么。</data></node>
    <node id="城门外居民集议（罗德失约晨）"><data key="name">城门外居民集议（罗德失约晨）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在人群的前方能够看到贝丝酱的身影。她以十分不安的样子窥伺着城内的状况。；「其实我和罗德大人本来约好了昨天晚上碰头的。但是，昨天不论我怎么等她都没有来⋯⋯！而且今早也没有外出的迹象，总感觉很奇怪，这究竟是──！」；「早上罗德大人没有来回飞这种事，有多久没发生了⋯⋯」</data></node>
    <node id="涡波一年沉眠判明"><data key="name">涡波一年沉眠判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">别勉强，基督。不管怎么说，你毕竟睡了一整年。；是啊，一年。据罗德所说，自那场战斗结束之后已经过去一年了。；想要把你们和那坚硬的水晶完美地分离开来也要费上好一番功夫哦。</data></node>
    <node id="始祖涡波躯壳『再诞』为相川阳滝"><data key="name">始祖涡波躯壳『再诞』为相川阳滝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──就这样，『身体』和『魔石』产生了错装。；『始祖涡波的身体』得到了『阳滝的灵魂』；『水之理的盗窃者』的魔石开始吸收『始祖涡波』体内的『魔力』。话是这么说，但是青色魔石仍在睡眠状态。这是无意识的吸收。</data></node>
    <node id="归宅佩艾希亚·发现罗德于保管室独泣"><data key="name">归宅佩艾希亚·发现罗德于保管室独泣</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在诺斯菲的带领下，我们穿过了『连接』，回到了罗德的世界──佩艾希亚之中。；利用『连接』从迷宫探索者中抽身的我一回到佩艾希亚便立刻展开了『维度』；尽管在迷宫里分别之后还没过一个小时，她人就已经在城堡里了。由此可见她飞行的速度有多快。</data></node>
    <node id="白色少女苏醒现身甲板"><data key="name">白色少女苏醒现身甲板</data><data key="type">event</data><data key="status">provisional</data><data key="desc">海里六人。甲板上有我一人。『维度』把握到了在这七人之外的第八个人的行动。；不过现在的她就连维持『维度』这种基础魔法都很吃力。；一连串果决的行动让我明白她打算与我们相见。</data></node>
    <node id="斯诺病房对谈与自立"><data key="name">斯诺病房对谈与自立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「斯诺你『真正的愿望』并不是『活在沃克家』，而是『逃离沃克家』。」；「——接下来，我要去同沃克家诀别……！涡波要跟我一起来吗？」</data></node>
    <node id="海莉乱入救援与城堡镇压"><data key="name">海莉乱入救援与城堡镇压</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——不行，少年。『Sehr·Wind』」；此间海莉的风魔法也没有停歇。她将士兵们一个接一个地吹飞到城墙上，通过撞击让他们失去意识。；「冷静下来。你好不容易才坚持保持自我到现在。请千万不要大意。一定要保持冷静」</data></node>
    <node id="报酬交涉"><data key="name">报酬交涉</data><data key="type">event</data><data key="status">provisional</data><data key="desc">玛利亚最后用十分无语的表情从我手里接过了五十枚铜币</data></node>
    <node id="旗舰接舷与克洛伊初会面"><data key="name">旗舰接舷与克洛伊初会面</data><data key="type">event</data><data key="status">provisional</data><data key="desc">似乎是船队总指挥的人制止了部下的攻击意图。；接着我们与其中最大最豪华的一艘船接舷，随后便跳到了那艘船上。；「打扰了。请问这是这支舰队的旗舰吗？」</data></node>
    <node id="莱纳对诺斯菲开战：杀意宣言与双咏唱"><data key="name">莱纳对诺斯菲开战：杀意宣言与双咏唱</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「先把话跟你讲清楚了，我一上来就会出全力哦。跟之前不一样这次我不会再大意了，光之守护者。──诺文！Sylph・堕落使徒！」；接着将刚才通过模仿基督的『咏唱』而得到的魔力全部灌注进去。；「『加速』『加速』『加速』『加速加速加速』──！！」</data></node>
    <node id="真『咏唱』与魔・法『■道落土』构筑（风之道路）"><data key="name">真『咏唱』与魔・法『■道落土』构筑（风之道路）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『此身乃是于地狱路上疾走之魂』──！！」；「──魔・法『■道落土（Lord・Of・Lord）』！！」；看到我突然在风之道上疾走，罗德连忙中断了对『Ex・Wind』的构筑，并代之以无数的风刃。</data></node>
    <node id="千年留恋与悔恨的总吐露"><data key="name">千年留恋与悔恨的总吐露</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为人家还有弟弟在、所以不能就那么被逼上绝路后、死掉。作为、姐姐、人家有、守护弟弟的使命。；结果那时候只有涡涡你一个人能够理解；人家想要回去。回到那个有爷爷和奶奶、还有艾德在的……那片草原</data></node>
    <node id="罗德要求涡波永留『这里』被拒、说服决裂"><data key="name">罗德要求涡波永留『这里』被拒、说服决裂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">成为孤的『臣子』，去说服莱纳成为孤的『弟弟』！」；若是依靠与涡波的共鸣魔法，那延长『这里』的寿命也并非不可能。只是那个空间魔法必须以涡波留在『这里』为条件。；真正被你爱惜、被你保存起来的那幅画上画着的『家人』是艾德！不是莱纳！</data></node>
    <node id="魔王城旅店住宿契约"><data key="name">魔王城旅店住宿契约</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「谁让你们没问人家嘛～。⋯⋯啊，对了！如果你们想使用城堡里的房间的话，就收你们一天十枚铜币好了～。从今天开始，『魔王城』旅店就正式开始营业啦～」；『顺带一说，如果被逮捕的话就要关三天的禁闭！这条法律是人家刚刚想好的！毕竟人家可是国王哟！』；「那就好──接着吧，这是住宿费。城堡内的一个房间我就先借用了。这是今天的，明天之后的钱等我在『这里』赚到钱之后再付」</data></node>
    <node id="涡波×拉丝缇娅拉特训"><data key="name">涡波×拉丝缇娅拉特训</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——好、好嘞，来特训吧！」；魔法使对决以拉丝缇娅拉的胜利告终了。；拉丝缇娅拉和我都学会了一个新技能。</data></node>
    <node id="60层守护者接触计划（章末）"><data key="name">60层守护者接触计划（章末）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我一个人进入六十层，先跟守护者交谈试试。；虽说是守护者，但他们原本也是人类。好好谈一谈的话总能互相理解的。；要是个像罗德那样对『始祖涡波』态度友好的家伙就好了……</data></node>
    <node id="乱战歼灭——涡波后方指挥与新魔法双初用"><data key="name">乱战歼灭——涡波后方指挥与新魔法双初用</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──魔法『Default』！！诺斯菲、莱纳！我会将看上去难对付的敌人先拉到远处，你们注意按照顺序打倒它们！」；「罗德！你给我待着别动！！」；被我责怪一番之后，罗德总算明白自己做了错事。眼角泛起泪光的她随即将手中的铳剑雾散掉。</data></node>
    <node id="涡波的身份动摇与誓愿再确认"><data key="name">涡波的身份动摇与誓愿再确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">千年前的圣人缇娅拉是相川涡波的弟子？；还有，现在一个人在这里的我又是『谁』？；我最重要的妹妹。相川阳滝，难道早在千年之前就已经死了吗！？</data></node>
    <node id="雷纳尔多的铁拳制裁与装备甄别"><data key="name">雷纳尔多的铁拳制裁与装备甄别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">雷纳尔多的铁拳缠绕着赤色的魔力，一计通天炮二话不说直接击中莱纳的下颚。；「哟西。接下来就把这小子的魔法道具也给调整一下好了」；「这个还能用，这个可不行」「这个也是自残用的吗。破壊掉算了」</data></node>
    <node id="挑衅论战与罗德身份逻辑崩坏"><data key="name">挑衅论战与罗德身份逻辑崩坏</data><data key="type">event</data><data key="status">provisional</data><data key="desc">支撑自己所拥有的身份的逻辑产生了动摇，让罗德陷入了过呼吸的症状。；⋯⋯因此『暗之理的盗窃者』便质问我，这样的我凭什么能够做相川涡波这个人呢。他还说过我根本就连名字都没有。说我是『魔石人类』。说我希望拯救妹妹的想法也是虚假的。；虽然这还只是我的猜测，不过想必罗德在千年前就是勉强自己摆出王的样子，而最后的结果就是她真的获得了与王相符的强大。</data></node>
    <node id="『冬之异世界・四重奏』冰沙化决胜与核心两断·获称号"><data key="name">『冬之异世界・四重奏』冰沙化决胜与核心两断·获称号</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我果断地消费这些魔力，强化『冰・Aegis』；关键在于要用我们的冰粒侵蚀伽鲁夫纳多杰里制造的水域。；渐渐的，水域被隆冬之雪染白。</data></node>
    <node id="升6级与深层突破"><data key="name">升6级与深层突破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「基督！神父说我升到6级了呢！」</data></node>
    <node id="罗德真本事·世界崩壊余波波及"><data key="name">罗德真本事·世界崩壊余波波及</data><data key="type">event</data><data key="status">provisional</data><data key="desc">轰隆一声，大地开始颤动。；「⋯⋯哦呀？这可真是这可真是、看来罗德终于使出真本事了呢」；再仰望天空，就可以看到一道非现实的龟裂。接着，随着裂痕的拓展，天空也开始七零八碎地剥落。不仅如此，再将视线偏向身旁，就能看到密布于大地之上的无数裂缝。</data></node>
    <node id="第五十之试练开幕·崩壊世界近战"><data key="name">第五十之试练开幕·崩壊世界近战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">以崩壊的世界为舞台，『风之理的盗窃者』的『试练』就此开幕。；「碍事──！！」；足足有一栋建筑物质量的瓦砾，在罗德拳下也跟一块饼干没什么两样。</data></node>
    <node id="千年孤独崩坏史（两百年至一千年·放弃作为孤）"><data key="name">千年孤独崩坏史（两百年至一千年·放弃作为孤）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——在『这里』的生活就这样经•过•了•两•百•年。；而六百年之后，已经连记忆都不剩多少。；这就是孤放弃作为孤的瞬间。</data></node>
    <node id="63~61层通层与白色怪物"><data key="name">63~61层通层与白色怪物</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——『WindFlamberge』！！；莱纳用风强化剑的威力，将PaleGriffin逼入了绝境。然而，没等我们结果它，PaleGriffin就突然飞到特高的地方，然后开始竭力嘶吼。；我们已经不作休息地连续行进四个小时了。</data></node>
    <node id="城堡中庭奇袭（压制西斯）"><data key="name">城堡中庭奇袭（压制西斯）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我的目标只有目前身在城堡中庭的西斯一个；几乎化身为炮弹的我已经在中庭着弹。；结果西斯的双翼顷刻间便被踢碎，化作了无数飘散的魔力之羽。</data></node>
    <node id="海莉MP枯竭与生命燃烧再开"><data key="name">海莉MP枯竭与生命燃烧再开</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──MP64／512－200──；「──你在松懈些什么！战斗还没结束呢！还差的远呢！！」；──282／341──</data></node>
    <node id="缇缇天职确认（庭师）"><data key="name">缇缇天职确认（庭师）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呼～。哎呀，涡涡的杰作没有浪费掉真是太好了太好了～。⋯⋯不过，既然人家没有成为勇者的天赋的话，那人家到底该做什么好呢？虽然就算这个问题得不到答案人家应该也能消失，但还是想知道啊」；「我说你啊，你自己之前不是说了么。当个『庭师』啊？」；「这样吗。果然，人家就应该作为『庭师』走完自己的人生啊」</data></node>
    <node id="公会运营首日与迷宫再开"><data key="name">公会运营首日与迷宫再开</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊、嗯。但是，与其说是今天的工作，不如说是七天的工作都结束了啊……」</data></node>
    <node id="『妻子』事实揭露"><data key="name">『妻子』事实揭露</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为诺斯菲可是涡涡的『妻•子』啊！！；妻子。也就是说，诺斯菲是『始祖涡波』的妻子了呗。；……我•们•并•没•有•许•下•爱•的•誓•言。那不过是徒具形式的婚姻。是充斥着虚伪和欺瞒的契约。</data></node>
    <node id="口头约定兑现·拥抱（物语第一章HappyEnd宣言）"><data key="name">口头约定兑现·拥抱（物语第一章HappyEnd宣言）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——那么，你给我个拥抱好了？；就是抱住我。啾地一下抱紧我。像这样的，物语的主人公对女主角做的那种感觉的；像这样的事情不都是英雄谭里的惯用套路吗。为了以后撰写英雄谭做一下参考</data></node>
    <node id="涡波玛利亚猛攻与西斯神圣魔法铁壁"><data key="name">涡波玛利亚猛攻与西斯神圣魔法铁壁</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就好像叩击山峦一般的感觉。全力斩下的刀刃被弹开，我和玛利亚被推回了后方。；「玛利亚！支持就交给你了！就和刚才那种程度就行！」；恐怕这个世界上没有剑士能够防住这个剑术，就算如此，也没能够到西斯。</data></node>
    <node id="柯尔库北关突破（ch144）"><data key="name">柯尔库北关突破（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「玛利亚，在门上开个洞出来！」；「──『炎之矢』」；同时我投出了匕首，拉丝缇娅拉释放出了杀伤力低的风魔法。</data></node>
    <node id="罗德的『绘画』魔石抽取（最后一击准备）"><data key="name">罗德的『绘画』魔石抽取（最后一击准备）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『维度・多重展开』」；我使出全力让自己的魔力浸透在被罗德的飞踢搅得一团糟的世界中──然后总算找到了苦苦追寻的目标。；我遵・循・罗・德・的・期・望，伸手抓住那些画并施以魔法。</data></node>
    <node id="缇缇勇者断念与装身托付"><data key="name">缇缇勇者断念与装身托付</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「不干了不干了。看来人家跟勇者不相衬呢。想来勇者原本就不是那么简单的工作呢。至少不是人家做的来的啊。──就是这样，脱掉脱掉全都脱～掉─」；不到一分钟的时间，身着民族服饰和总司令衣装再加上翠色铠甲的全新斯诺就诞生了。虽然因为是缇缇以个人眼光挑选的铠甲所以有些浮夸，但斯诺的外套很好地遮住了铠甲，看上去意外的自然。；「没关系。因为人家似乎不适合成为勇者啊。所以人家已经放弃使用它了。于是乎，人家决定把它托付给心爱的斯诺」</data></node>
    <node id="冻结魔法丧失确认（魔石拔除后）"><data key="name">冻结魔法丧失确认（魔石拔除后）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那么既然我在使用阳滝的身体，照理说我也是能使用冻结魔法的。；然而，因为『水之理的盗窃者』的魔石被拔除，现在我完全失去了那方面的才能。；恐怕是我身上只有次元属性魔力的缘故吧。如今我真的是只剩下这一种属性了。</data></node>
    <node id="队伍分派（四人离队/斯诺任领队）"><data key="name">队伍分派（四人离队/斯诺任领队）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——所以我和玛利亚接下来要去跟帕林库洛决战」；「不行，拉丝缇娅拉。你现在这幅状态哪还能战斗。再说，以帕林库洛为对手你的相性太差了」；「塞拉，拉丝缇娅拉的事就拜托你了」</data></node>
    <node id="Boss狙击日（三Boss）"><data key="name">Boss狙击日（三Boss）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【获得了称号『缭乱踏破』】</data></node>
    <node id="罗德咏唱失控·过呼吸"><data key="name">罗德咏唱失控·过呼吸</data><data key="type">event</data><data key="status">provisional</data><data key="desc">究竟是因为激烈的争辩还是感情的压迫呢，罗德表现出过呼吸的症状。；「——『加速』『加速』『加速』——『孤乃袈夙（加速）之魂』！；「罗德！！快停下你那『咏唱』!会让你失去冷静的！！」</data></node>
    <node id="罗德三策建议"><data key="name">罗德三策建议</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「有了有了。既然提升级别这个正攻法被锁死了，那你们能采取的对策也就剩下这么几个了。首先是第一条：锻炼技能和魔法」；「多攒点钱，雇人帮你们就好了啦。虽然除了我之外没有能打倒那条龙的人，但能影响战局的人还是不缺的」；「然后就是第三条──也是我最推荐的方法：多准备一下能够对付那条龙的装备不就好了嘛」</data></node>
    <node id="罗德的留恋问答与涡波'第二次'承诺"><data key="name">罗德的留恋问答与涡波'第二次'承诺</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我说，罗德。你有什么希望我做的吗？你的留恋是什么呢？」；「──嗯～，人家想想哦。要是你能陪人家一起生活在『这里』的话，那人家会很开心的哟？因为人家的留恋，就是和平安稳地生活在『这里』呀」；「⋯⋯这就有点难为我了啊。我必须尽快回到地上才行，所以没办法在『这里』生活的。⋯⋯但是，如果你有什么其他的愿望，如果我能做到的话，那我会尽全力为你实现的。这句话绝无虚假，罗德」</data></node>
    <node id="阳滝被守护者艾德带走(莱纳证言)"><data key="name">阳滝被守护者艾德带走(莱纳证言)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「抱歉，掉下来的只有我们两个。你的妹妹在你昏倒的时候被守护者艾德带走了。」；「不好意思，我没能保护好她。当时我还不知道她是你的妹妹。」；「艾德那家伙是天生的教育者，而且痴迷于建国运动。恐怕他是为了建国而在网罗人才吧。</data></node>
    <node id="Centidreadnought分割捕获战"><data key="name">Centidreadnought分割捕获战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我首先冲Centidreadnought的腹部使出一记横斩，就这样将它那庞大的躯体一刀两断。当然，剑闪远远不止于此。接在第一剑之后，我又从各个方向挥出十余计斜斩。；在它陨落之际我仍然在不断释放斩击，等到敌人的身体触及地面时，它那巨大的身体已经被我切成了上百段。；因为『Shift』和『次元斩裂剑』只是引发空间错位的魔法，并不具备物理层面的攻击力。因此我做的并不是真正意义上的将敌人身体斩断，而是通过空间的错位扰乱它飞行的感觉。</data></node>
    <node id="迷宫20-27层攻略与魔剑销毁"><data key="name">迷宫20-27层攻略与魔剑销毁</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在确认过数天内公会都不会有什么工作后，我们来到了迷宫的第二十层。；今天的成果是将迷宫攻略到了二十七层。</data></node>
    <node id="御殿对峙:『臣子』要求与拒绝"><data key="name">御殿对峙:『臣子』要求与拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">此时此刻，孤要你负起当年的责任！成为孤的『臣子』，去说服莱纳成为孤的『弟弟』！；今天早上我确实跟罗德说过「我会帮你」「我会实现你的愿望」，但如果要我现在再说一遍，那我做不到。；若是依靠与涡波的共鸣魔法，那延长『这里』的寿命也并非不可能。只是那个空间魔法必须以涡波留在『这里』为条件。</data></node>
    <node id="前祭游玩"><data key="name">前祭游玩</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这个身着好几件厚实到让人看着都觉得热的衣服的少女，正是迷宫的守护者阿尔缇。</data></node>
    <node id="神殿演说与仪式拒绝"><data key="name">神殿演说与仪式拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">直·到·成·为·英·雄·为·止的故事、才是我真正的梦想！是我一直以来的梦想！」</data></node>
    <node id="缝衣恶趣味骚动与信赖波动"><data key="name">缝衣恶趣味骚动与信赖波动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">⋯⋯不过算了。只要装备确实修好了就行。⋯⋯就是有点恶趣味罢了」；「要是把这些全穿在身上的话，感觉不是跟舞台上的演员一样了么⋯⋯？感觉用在迷宫探索的话有点辣眼睛的说⋯⋯」；虽然我作为生产者向前迈进了一步，但代价却是让莱纳对我的信赖产生了磨损。得想点办法挽回才行⋯⋯⋯</data></node>
    <node id="莱纳起身宣战与双剑对峙"><data key="name">莱纳起身宣战与双剑对峙</data><data key="type">event</data><data key="status">provisional</data><data key="desc">将『阿雷亚斯家的宝剑诺文』当做手杖，我摇摇晃晃地站起身。；我也不再用麻烦的敬语，将两把剑横举挡在基督的身前。；右手握着『诺文』，左手握着『Rokh·Bringer』，我向前迈出一步。</data></node>
    <node id="柯尔库入市与旅店投宿（ch137）"><data key="name">柯尔库入市与旅店投宿（ch137）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">以了解本土状况的缇亚为向导，我们在街上行进。；使用适当的假名，同服务员交流。渐渐习惯以假名示人的自己好像有点可悲。；就这样开了两间价格最高的房间。已经不会愁钱的事了所以大手大脚的花就是。</data></node>
    <node id="涡波放弃救援士兵与玛利亚制止"><data key="name">涡波放弃救援士兵与玛利亚制止</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「大家！请立刻逃到『魔法阵』的范围之外去！现在行动还来得及！在这期间我会──！！」；「不要把目光从敌人身上移开。这也是帕林库洛・勒伽西的攻击──，我们还在战斗中」；可能的话，我真的想拯救所有人。因为『我』就是那样一个人。在几乎失去了一切的现在，我反而越发清楚地意识到自己的这一性格。只有去救他们，才能让我确信我还是我。</data></node>
    <node id="海莉之死（决斗落幕与消散）"><data key="name">海莉之死（决斗落幕与消散）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">海莉的剑精准地刺穿了帕林库洛的胸膛。；在海莉跟帕林库洛战斗的期间，雨势渐衰。乌云褪去，缕缕阳光透过云层射来。；留下这句话，海莉彻底变成光消失了。</data></node>
    <node id="海莉的颠覆推测揭示——涡波=『再诞』用魔石人类"><data key="name">海莉的颠覆推测揭示——涡波=『再诞』用魔石人类</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「恐怕，现在在这里的少年不识『相川涡波』本人。和『圣人缇娅拉』的容器大小姐一样，『使徒西斯』的容器缇亚一样，────少年是，始祖的」；『相川涡波』为了『再诞』而准备的『魔石人类』吧。所以，少年是绝对没办法跨越的。」；「我是，⋯⋯⋯，『魔石人类』⋯⋯⋯？不是千年前的『始祖涡波』本人⋯⋯⋯？」</data></node>
    <node id="缇缇拦截未知飞行者"><data key="name">缇缇拦截未知飞行者</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「有个跟人家同水准的飞行能力者正在朝这边赶过来！！」；丢下这句话之后，缇缇便张开双翼冲上了天穹。；「翠色的辉翼⋯⋯？偏偏在这种时候⋯⋯！」</data></node>
    <node id="柯尔库翻墙潜入"><data key="name">柯尔库翻墙潜入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在地平线那边看到了街道的样子。使用『维度』找到了大路之后，我们换上了旅行者的装束。；不不，不会有间谍能拥有我们这种级别的能力的啦⋯⋯⋯只要一瞬间就跨越墙壁的话连『魔石线』也不会有反应的。顶多只是觉得是鸟这类小动物飞过去了而已；就这样，我们成功地侵入了港口城市柯尔库。</data></node>
    <node id="乐园传言引发移民流入与南军归还要求遭拒"><data key="name">乐园传言引发移民流入与南军归还要求遭拒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[启禀『支配之王』，在向移民打听过之后，据说是因为在现在的南方有一个传言，传言说在北方的尽头有一座乐园]；凡是从南方逃到这里的同胞统统是我们的家人——就这么说！！归还之事没得谈！！]；后来之所以能解决这些问题，全都仰赖弟弟艾德的力量。尽管在战斗方面没有任何才能，但艾德在操办这些踏实的事务和琐碎的问题上的能力却是出类拔萃的。</data></node>
    <node id="主角苏醒于迷宫回廊"><data key="name">主角苏醒于迷宫回廊</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——【召唤】欢迎回来，相川涡波——；原来我正横卧在一栋石制的回廊里。</data></node>
    <node id="斯诺免职令出示与判明"><data key="name">斯诺免职令出示与判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">当身边的船员们急急忙忙地装卸着船上的货物时，我将塞拉给我的介绍信递给了克洛伊小姐。；她在接过信件浏览起来之后⋯⋯脸色变得越来越青。；「诶⋯⋯这个是、斯诺大人的『免职令』⋯⋯？怎么会，为什么这么快就⋯⋯？」</data></node>
    <node id="技能『？？？』圣诞祭后再发动（ch126）"><data key="name">技能『？？？』圣诞祭后再发动（ch126）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「不是的，我刚才没有在生你的气。只是技能『？？？』发动了，让我有点不爽而已⋯⋯⋯拉丝缇娅拉在刚才那样的情况下仍能实现共鸣实际上是帮了大忙的」；技能『？？？』的发动是自圣诞祭之后未有的。再加上技能『并列思考』的并用，我根本无法停止无意识的思考。；「──这次也、就当没发生过吧。那只是个人工呼吸而已。是为了解决战斗必须的。除此之外没有更多的意义了。好吗？」</data></node>
    <node id="酒宴翌晨·宿醉缺席与昨夜暴走判明"><data key="name">酒宴翌晨·宿醉缺席与昨夜暴走判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">看来是昨天喝太多，我直接睡倒了。；「哦、你也醒了啊。哈哈，昨天可真是有意思。不过，多亏了酒劲让你把真心话说出来也挺好的啊。不，与其说是真心话，不如说是少年时期特有的暴走才对吧⋯⋯」；「不，没到那个程度⋯⋯不过敬语是全都甩飞了，所以以后最好不要在同伴以外的人面前喝酒哦⋯⋯？」</data></node>
    <node id="莱纳夜袭与诺文介入"><data key="name">莱纳夜袭与诺文介入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「……我也实在不是骗你，但是海因·赫勒比勒夏因喜欢我这名少女。并且，他也喜欢著名叫基督的少年。所以，他为这对少年少女献出了自己的性命。不是作为一名骑士，而是以一个人的身份——」；诺文给他的是魔剑『Rokh·Bringer』——这把剑经由诺文的魔力很好地重新接合了。跟平时的『魔力物质化』不一样，我从中感知到了地属性的魔力。似乎是使用了特殊的魔法进行修复的。</data></node>
    <node id="赫勒比勒夏因之神圣双剑·片翼入手与空祭坛"><data key="name">赫勒比勒夏因之神圣双剑·片翼入手与空祭坛</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是一把具有羽翼设计感的乳白色的剑。；「──这个没有诅咒呢。好像是以前的赫勒比勒夏因家的逸品来着哦」；「但是，这似乎只是双剑中的一把，好像是凑齐两把才会更强的样子⋯⋯，就只有它一个的话也没什么意义呢」</data></node>
    <node id="涡波的初次告白"><data key="name">涡波的初次告白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">只是那个时候，我的感情又一次被技能『？？？』夺走了。但现在不一样。在技能『？？？』升华为『最深部之誓约者』之后，我的感情已经恢复了原貌。；「因为我！喜欢你啊！！」；「⋯⋯是、是・真・的・吗？」</data></node>
    <node id="契约执行：三骑士分割成功·王与近卫骑士团长消失·艾德追击遭拒"><data key="name">契约执行：三骑士分割成功·王与近卫骑士团长消失·艾德追击遭拒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[——时候到了。一切都跟安排好的一样。多亏了赛鲁多拉和艾德，对三骑士的分割成功了。接下来我会舍弃这个国家，去追杀使徒西斯]；结果就在北与南双方的战争发展到最高潮的时候，作为王的孤和近卫骑士团长涡波从佩艾希亚消失了。；[——涡波大人啊啊！为什么！？您为什么要背叛我等！？]</data></node>
    <node id="缇娅拉大人的血·回收进度报告"><data key="name">缇娅拉大人的血·回收进度报告</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们这一年里一直在蒐集被散播出去的『缇娅拉大人的血』。；目前在我的身体里有四成，那边那孩子的体内差不多有五成]；如果快的话只要几天时间，缇娅拉大人应该就能回到这个世界了</data></node>
    <node id="缇缇记忆回归·千年『悲鸣』（五十层世界）"><data key="name">缇缇记忆回归·千年『悲鸣』（五十层世界）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──想・回・家。；啊啊，这就是为什么即使在『这里』玩耍了一千年也没能得偿所愿的原因。；『这里』到底是哪里！？</data></node>
    <node id="Flashback发作与沉入『千年前的梦』"><data key="name">Flashback发作与沉入『千年前的梦』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我总觉得罗德和诺斯菲都应该跟她们现在的样子有所不同。；那不是她们现在这样身着朴素服饰的样子，而是穿着与王的身份相符的奢华服饰的两人的姿态。；「对了⋯⋯⋯我是在那时候与她们相遇的⋯⋯」</data></node>
    <node id="升级作业与状态栏确认（32层休整）"><data key="name">升级作业与状态栏确认（32层休整）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为要给玛利亚和缇亚升级，所以确认了周围的安全之后就开始进行升级作业。；名字：迪亚波罗・西斯HP220／232MP869／989职业：剑士；还是老样子，缇亚的魔力数值成长异常地多。但是玛利亚的成长度也一样异常，让我很惊讶。</data></node>
    <node id="各国魔法屋扫货巡游"><data key="name">各国魔法屋扫货巡游</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这个流程先是在古尔亚德──然后是瓦尔德──总之在各国的大型店铺中反复上演。通过这个方式，我们基本将市面上所有类型的魔石都买到了手。；刚看到一个翠发美女突然现身，紧接着就听到了她那离谱的要求；而且既然深知她的兴奋是因为千年地下生活的压抑，我就不能去强加制止。我不可能制止。</data></node>
    <node id="涡波自省（失败连锁自觉）"><data key="name">涡波自省（失败连锁自觉）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">都是因为我太天真。；因为提升了级别加上拥有『并列思考』的缘故，我可能觉得自己比谁都聪明了。；在迷宫和伽鲁夫纳多杰里的一战，与海莉的对话，以及这份自傲──我的失败一个接一个。不管力量怎么变强，跟以前相比还是没什么改变的自己真是让人厌恶。</data></node>
    <node id="维度・多重展开侦查六十五层全貌"><data key="name">维度・多重展开侦查六十五层全貌</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『维度・多重展开』！」；因为『魔法相杀』的缘故，密布于六十五层的LizardFlyer周边的情况我无法掌握。但除开这些，将『维度・多重展开』拓展到深处之后，总算是找到了前往六十四层的阶梯──不对，应该是大洞更为准确。；以无机质的石造阶梯构成的三维迷宫是中央区域所特有的。右侧区域有许多从天而降的瀑布，左侧则是生长着直插天际的大树的区域。</data></node>
    <node id="三人晚餐·诺文败北真相与魔石之剑出示"><data key="name">三人晚餐·诺文败北真相与魔石之剑出示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「不，已经不在了。因为诺文已经被基督打倒了啊」；因为莱纳用目光控诉，所以我只好将『阿雷亚斯家的宝剑诺文』从『所有物』中取了出来。；「好滴，那人家也要以符合守护者的方式消失为目标喽。既然阿雷亚斯那家伙将自己的剑术留给你们两人继承了，那人家就把魔法传授给你们好了！」</data></node>
    <node id="莱纳被雷纳尔多·沃尔斯带走(判明)"><data key="name">莱纳被雷纳尔多·沃尔斯带走(判明)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——嗯？好奇怪啊。莱纳这是跑到哪里去了呢。我确实是将他送到这里来了，怎么看不到人……」；「皆因雷纳尔多·沃尔斯所致……其人察觉并参与到发生于此处的战斗后，将莱纳带走了……」；看来有危险的不仅仅是莱纳。</data></node>
    <node id="支配之王千年史（君临·被弑·地底千年）"><data key="name">支配之王千年史（君临·被弑·地底千年）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一个本来只是家家酒游戏中的王最终成为真正的王者的战斗就此开幕，而少女缇缇的时间则因为『诅咒』而停滞不前。；在这之后，一个虚伪的王让一个陷入绝境的国家死灰复燃。接着，从家家酒游戏中脱胎而成的小孩子在数十年的时间里作为王者君临于佩艾希亚，其恶果便是北方的崩壊。最后『支配之王（Lord）』被南方的诺斯菲所杀。但是因为『理的盗窃者』的诅咒，就连死都成了奢望，只能堕入地底不得不再做整整一千年的王──而魂也由此濒于死壊。；然而，如果自己能好好地将心中的痛苦告知艾德的话，应该就可以避免那样的结局了。自己最大的理解者一定不会是涡波，而是自己的弟弟。</data></node>
    <node id="莱纳自爆装备检视"><data key="name">莱纳自爆装备检视</data><data key="type">event</data><data key="status">provisional</data><data key="desc">用于增幅魔力的戒指和令魔力爆发的戒指……这个则是用来强制加速的……？；这小子根本就没想着活着回来。这些装备全都是为了跟敌人同归于尽而准备的。；居然到了被说成个人风格的地步了吗……那不尽快想点办法可不行啊。</data></node>
    <node id="塞拉『兽化』上阵与阵型转换"><data key="name">塞拉『兽化』上阵与阵型转换</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「是啊我知道啊！但是人家今天就是想当魔法使嘛QAQ！我也想像魔法使一样，叭～！地一下就把敌人都歼灭掉嘛！」；回过头去，面前的塞拉小姐已是『兽化』的姿态了。；我将她脱下的女仆装收进『所有物』中，接着我们改变了阵型。</data></node>
    <node id="诺斯菲'千年前老婆'曝光骚动"><data key="name">诺斯菲'千年前老婆'曝光骚动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">也就是说斯诺你是涡涡在这个时代的妻子；她是涡涡千年前的老婆啊；再加上我们双方都决定要把结婚的事实当做不存在所以婚姻关系已经被废弃了</data></node>
    <node id="望台揭示：魔王城=迷宫66层里侧"><data key="name">望台揭示：魔王城=迷宫66层里侧</data><data key="type">event</data><data key="status">provisional</data><data key="desc">位于城堡最上层的了望台。；欢迎你回到我们的『魔王城』；「『这·里』是·迷·宫·里·面·哦。」</data></node>
    <node id="阿尔缇随行与善意试探"><data key="name">阿尔缇随行与善意试探</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为阿尔缇的突击，我得以从怪物的攻击中脱身。</data></node>
    <node id="39层猎场开设与斯特鲁讨伐"><data key="name">39层猎场开设与斯特鲁讨伐</data><data key="type">event</data><data key="status">provisional</data><data key="desc">藤蔓一瞬间就被斩断，敌人冲到了它的面前。无法应对从三个方向袭来的斩击，斯特鲁的花瓣绽裂，茎也被拦腰斩断。；「⋯⋯嗯，不错。就这样继续和39层的怪物战斗吧。找出最容易对付的敌人，然后用它来刷经验」；在那之后，消化了积攒的经验值的拉丝缇娅拉和斯诺也升上了20级。</data></node>
    <node id="斯诺的深夜来访与『夫君』骚动"><data key="name">斯诺的深夜来访与『夫君』骚动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「……抱歉，涡波。你跟玛利亚的谈话，我都听到了。」；「——唔~嗯。……夫、夫君怎么样？」；「不可能是骗你的啦。我就跟玛利亚一样，爱涡波爱得要死哦。」</data></node>
    <node id="次元魔术彻夜开发与Default习得"><data key="name">次元魔术彻夜开发与Default习得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从昨天大概傍晚的时候开始，直到差不多今天早上为止；次元魔术：维度1.69连接1.03形式1.07Default1.00；而我没能学会的另外两种魔法对魔力的消耗程度远在『Default』之上。</data></node>
    <node id="涡波以劳拉维亚经验劝诫与罗德落泪"><data key="name">涡波以劳拉维亚经验劝诫与罗德落泪</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「败在了『暗之理的盗窃者』手下的我，记忆和自我都被改窜得暧昧不清，并与不是阳滝的妹妹一起被囚禁在了虚假的幸福之中；「孤已经决定要做一个孩子！孤要与诺斯菲一同将孩童时代从头来过！诺斯菲也答应孤会一起变回孩子！；「为何！为何只有孤不行！？你不是都实现了诺文的愿望了吗！？你不是听取了诺斯菲的愿望了吗！</data></node>
    <node id="城堡之梦第三场·千年前结局记忆再生"><data key="name">城堡之梦第三场·千年前结局记忆再生</data><data key="type">event</data><data key="status">provisional</data><data key="desc">到了第三次，这座城堡对我而言已不再陌生。；先前那祥和的氛围已是烟消云散。；男子很难得地没有戴着假面。</data></node>
    <node id="五十一层空洞『Default』垂直突破"><data key="name">五十一层空洞『Default』垂直突破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「哈啊，没办法、用『Default』好了。」；从石造的地面到上空的距离时⋯⋯两千两百七十四米七十八厘米三毫米──不，四毫米左右。小数点以下的误差在容许范围内。；「──魔法『Default』」</data></node>
    <node id="招式命名论战"><data key="name">招式命名论战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「说起来，你怎么不用在迷宫喊得贼起劲的那个『魔弹（FlyShoots）』了？」；「姆？啊啊，毕竟那招是涡涡教人家喊得，不是人家自己起的名字嘛。虽然用那个确实更强力一些⋯⋯但只要不是万不得已人家是不会用的」；「明明必杀技的名字就是越长越好的说⋯⋯</data></node>
    <node id="涡波三目的宣言与继续战斗确认"><data key="name">涡波三目的宣言与继续战斗确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">⋯⋯即使如此，我也要战斗。这一切还没有结束」；我的目的大致上分为三个。；第二是缇亚。为了夺回同伴，我必须打败西斯。</data></node>
    <node id="大圣堂侦察与阿尔缇确认"><data key="name">大圣堂侦察与阿尔缇确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呵呵呵，还差一点了啊……还差一点就……」</data></node>
    <node id="圣血散播与回收作业揭示"><data key="name">圣血散播与回收作业揭示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊真是的，麻烦死了。就是说在我们不在的一年间，之前的再诞仪式又被举行了？」；一年前，大小姐和我确实是为了找到『缇娅拉大人的血』而回到弗茨亚茨的。；「『缇娅拉大人的血』非常特殊。就算是被洒到荒郊野岭，她的血也会自行活动向圣杯回笼。像这样、咕噜咕噜～⋯⋯的感觉。为了防止血重新回到圣杯之内，帕林库洛便将血散播到了『人』这一容器之中，如此一来血就无法再聚集到同一个地方了」</data></node>
    <node id="基督再谈方针宣言与主从握手"><data key="name">基督再谈方针宣言与主从握手</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「所以呢，吾主接下来打算怎么办？就这么一蹶不振了？还是说对拉丝缇娅拉死心了？」；「驱使我向她告白的这份心意可没有不上不下到一被拒绝就轻言放弃的地步。而且理所当然的，我也不会就这样一蹶不振」；「等时间空下来之后，我要重新做好万全的准备再去找她谈一谈。今天的告白实在是太操之过急了。而且还有很多别的疑点」</data></node>
    <node id="涡波苏醒与记忆回溯（世界奉还阵后）"><data key="name">涡波苏醒与记忆回溯（世界奉还阵后）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「――阳滝！！」；我是和帕林库洛在黑暗中进行了一场恶战；然后，在莱纳和海莉的帮助下，我应该已经完美的达到了复仇的目的。</data></node>
    <node id="斯诺夜访·窃听坦白与自我厌恶风波"><data key="name">斯诺夜访·窃听坦白与自我厌恶风波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我重新检查船的重要部分时，看到了斯诺的身影。；[……抱歉，涡波。你跟玛利亚酱的谈话，我都听到了]；当我一帮玛利亚说话，斯诺的瞳孔就失去了光泽，她就这样陷入了自我厌恶中。</data></node>
    <node id="风龙挑战开战"><data key="name">风龙挑战开战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这是第二次讨伐龙了吗⋯⋯」；跟第一次不同，这次要依靠我一个人的力量屠龙。；哪怕在『最深部之誓约者』的帮助下消除了与妹妹相关的不安，我也必须用最快的速度回到地上。</data></node>
    <node id="雷纳尔多讲述罗德千年前王姿与艾德宰相义弟身份"><data key="name">雷纳尔多讲述罗德千年前王姿与艾德宰相义弟身份</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「是的。但是，罗德作为王那时候的形象我怎么都难以想像⋯⋯⋯实话跟您说，我有点怀疑历史记载的真假」；要说可能知道的人，那估计也只有宰相阁下了吧。；「宰相⋯⋯⋯您说的难道是艾德吗？」</data></node>
    <node id="圣人缇娅拉的后继者选定（莱纳）"><data key="name">圣人缇娅拉的后继者选定（莱纳）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">正与某个人物如出一辙。；而且也是偶然中的偶然──那个圣人缇娅拉也和莱纳・赫勒比勒夏因进行了相同的思考并得到了同样的答案。；『圣人缇娅拉』选中的后继者</data></node>
    <node id="罗德制服涡波（速度压制）"><data key="name">罗德制服涡波（速度压制）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「休想――逃！」；我将『Dimension‧多重展开』切换成『Dimension‧决战演算』，并准备迎击。；次元魔法千真万确地把握了她的动作。但是，她的速度却快到让人无法反应，罗德就这样迅速贴近并制住了我的双腕。</data></node>
    <node id="舞斗大会结果快马送达"><data key="name">舞斗大会结果快马送达</data><data key="type">event</data><data key="status">provisional</data><data key="desc">昨天快马已经送来了在联合国的『舞斗大会』的结果。；估计他本人会表示否定，但是从他赢得『舞斗大会』冠军的那一刻起，他就无法逃离这份使命了。</data></node>
    <node id="精神攻击地狱"><data key="name">精神攻击地狱</data><data key="type">event</data><data key="status">provisional</data><data key="desc">状态：混乱5.29精神污染1.00黑暗1.00</data></node>
    <node id="斯诺入室禁令与辞职宣言"><data key="name">斯诺入室禁令与辞职宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「对了，从今天开始所有人不许擅自进入我的房间。这是总司令的命令，敢违背的话就处以极刑。而且我会哭的」；「斯诺大人会哭！？⋯⋯不不，就算您说不许进入、可是接下来还有怪物讨伐的报告书以及招待塞斯提亚和历基亚国公主的事情要处理啊！」；「那、那这样吧，什么总司令什么英雄我都不干了算了？」</data></node>
    <node id="戒指『晶盾』锻造（初魔法道具制作）"><data key="name">戒指『晶盾』锻造（初魔法道具制作）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，我第一次尝试打造自己的魔法道具。；说着，我取出『阿雷亚斯家的宝剑诺文』；接着，使用『Quartz』对钻石进行干涉，再依靠『维度』规避误差，将魔石和戒指结合起来，我费尽心力打造的魔法道具就完工了。</data></node>
    <node id="海莉拦截与『魔石人类』揭示（辩论）"><data key="name">海莉拦截与『魔石人类』揭示（辩论）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">自离开劳拉维亚之后，我马上就察觉到了自身的异常。；恐怕存·在·于·此·的·少·年·并·不·是『相·川·涡·波』。；『素体』……在那个不明不白的技能下面，不是就有技能『素体』吗……」</data></node>
    <node id="血传与代价咏唱修练"><data key="name">血传与代价咏唱修练</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我与『火之理的盗窃者』在真正意义上的邂逅，是在与主人他们一起参加祭典的那一天。</data></node>
    <node id="增援合流与战局扩大"><data key="name">增援合流与战局扩大</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『FlameArrow·散花（FallFlower）』！」；玛利亚打造出火炎行进的管道，缇亚的火矢则经由这条道路射出。；【状态】身体强化24.77魔力强化30.98魔法障壁3.28</data></node>
    <node id="缇缇战死·艾德被掳"><data key="name">缇缇战死·艾德被掳</data><data key="type">event</data><data key="status">provisional</data><data key="desc">以数量上千的士兵为对手，自己的力量远远不足。；双臂被敌人斩断，心脏被武器捅碎，浑身插满镝矢，伴随着大量的失血，自己的生命也就走到了尽头。；不对！她没有死！『支配之王（Lord）』是不会死的！因为她跟我约好了啊！约好了要给我奖赏的！那个『支配之王（Lord）』是绝对不可能在约定实现之前死掉的！！</data></node>
    <node id="船旅第二日剑术特训：涡波传授拉丝缇娅拉诺文剑技并切磋获胜"><data key="name">船旅第二日剑术特训：涡波传授拉丝缇娅拉诺文剑技并切磋获胜</data><data key="type">event</data><data key="status">provisional</data><data key="desc">要把诺文・阿雷亚斯的剑技传授给我吗？；好喽，首先来试着切磋几下吧。一边看一边学；一定程度的剑术较量过后，我战胜了拉丝缇娅拉。</data></node>
    <node id="晶盾授予与试戴（回程路上）"><data key="name">晶盾授予与试戴（回程路上）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这个？这是我打造的魔法道具；当然没问题。不如说，这戒指就给你好了。本来就是为了交给谁才打造出来的；啊，这边的话能轻易戴上！</data></node>
    <node id="『连接』五十五层近路计划改定"><data key="name">『连接』五十五层近路计划改定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「帮大忙了，诺斯菲。就这样进到三十层，设置『连接』是再好不过了⋯⋯⋯」；说先『正道』的结界十分的碍事。接着是怪物有可能破壊掉『连接』。这两点。；没有守护者的阶层──也就是说，三十层为止的近路计划失败了。但是，如果在五十五层设置『连接』的话就能缩短十层数量的路程。照这个步调还有几天就能够到达地上。</data></node>
    <node id="拘束与审讯"><data key="name">拘束与审讯</data><data key="type">event</data><data key="status">provisional</data><data key="desc">名唤基督·欧亚的这么一个少年，在十四天前，突如其来地从迷宫内现身了。</data></node>
    <node id="诺文的童年起点(阿雷亚斯家旧宅)"><data key="name">诺文的童年起点(阿雷亚斯家旧宅)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这栋宅邸才是我的『家』。；一直一个人、持续不停地挥剑。剑就是自己的全部。</data></node>
    <node id="决赛前晨景(女孩子们的对峙)"><data key="name">决赛前晨景(女孩子们的对峙)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——没、没有，真的没事。我只是稍微跟缇亚小姐吵了一架而已……说是吵架，其实就是小孩子斗嘴那种级别的……！」；「你想太多啦。……涡波，你不用担心就这么去吧。如果有什么万一，还有我和斯诺还有塞拉酱在。你不是信任着我们的吗？」</data></node>
    <node id="涡波升到20级（人类极限领域）"><data key="name">涡波升到20级（人类极限领域）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">出发之前又让拉丝缇娅拉进行了升级，升级获得的点数全部点到了魔力上。；──名字：相川涡波HP369／370MP520／920－400职业：探索者；我终于也进入了20级以上的领域了。</data></node>
    <node id="民众声援与罗德的过呼吸恶化"><data key="name">民众声援与罗德的过呼吸恶化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">故尔看到了罗德那辉耀夺目的姿态，欢呼声便自远处传响。；果然罗德陛下还是回来了啊！；但只是听到声援就让她变得喘不过气来。</data></node>
    <node id="酒馆四人桌（魔法知识讲座）"><data key="name">酒馆四人桌（魔法知识讲座）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">基本上来说，只有通过将先人的睿智刻入血中的方式，才能习得魔法。魔法是不可能无中生有的。</data></node>
    <node id="魔王城茶话会与家人化骚动"><data key="name">魔王城茶话会与家人化骚动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而罗德则坐在价值不菲的椅子上，以优雅的姿势品着红茶。；这都是为了尽可能地治愈作为贵族的养子被抚养长大而妄自菲薄的莱纳。；如果留在隔绝于世的『这里』，那这份幸福应该能永远持续下去吧。</data></node>
    <node id="帕林库洛战后涡波弱化（体内魔石剥离）"><data key="name">帕林库洛战后涡波弱化（体内魔石剥离）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">说实话，结束语帕林库洛的战斗，身体中的『魔石』被剥离让我极具弱化了。『素质』被削减，特定的技能也被弱化。；不会再畏惧了。已经不会想着再从这个世界逃走了。不会再搞错自己的愿望了。不会再独自一个人烦恼迷失自我了。</data></node>
    <node id="千年前战争史实口述(诺斯菲)"><data key="name">千年前战争史实口述(诺斯菲)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那就是向使徒西斯大人复仇却被反杀的涡波大人在那之后被•交•托•到•了我的手上。；但是初战却反被击败并落入了敌人的手中。在那之后使徒西斯为了将我吸收到自己的阵营，便让当时作为南之『御旗』的诺斯菲与我缔结了婚姻关系。；然后我开始打造迷宫，并遭到了使徒勒伽西的欺骗，演变成了现在的状况。</data></node>
    <node id="诺斯菲头痛发作与留恋膨胀（探索强行继续被劝止）"><data key="name">诺斯菲头痛发作与留恋膨胀（探索强行继续被劝止）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「是、这样、吗⋯⋯──呜、好痛！」；诺斯菲突然抱头蹲下。；事发突然，我大吃一惊。自从进入迷宫以来，我第一次看到她因疼痛而变了表情。</data></node>
    <node id="首次迷宫探索（30-34层）"><data key="name">首次迷宫探索（30-34层）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">圣诞祭那天从大圣堂出逃的时候我就感受到了，将一大群伙伴编组成一个个队伍这种事，仅仅是思考的过程就让人很愉快。；之前我迫于其迅速，使用了『过密次元的真冬』来迎击。；就这样，『LivingLegend小队（暂定）』的初阵——首次探索活动拉开了帷幕。</data></node>
    <node id="留守组烧毁海盗船事件"><data key="name">留守组烧毁海盗船事件</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那艘船一开始是假扮成商船来跟我们交涉的……但是船员的代表一看到我们都是小孩子，态度就豹变，袭击过来了啊。」；早上袭击过来的对手，她用火胁迫给人赶回去了。但是，到了中午又有别的海盗船跑来了。；回到了船上——不过，面前等待着我们的却是一片火海。</data></node>
    <node id="西娅夺还作战成功"><data key="name">西娅夺还作战成功</data><data key="type">event</data><data key="status">provisional</data><data key="desc">西娅夺还作战顺利地取得了成功。；以能够在海上自由行动的我和莱纳为对手，船员们根本没有还手之力。；非常感谢，真的非常感谢！我还以为接下来要作为奴隶度过后半生了呢！</data></node>
    <node id="拉丝缇娅拉的留守决断"><data key="name">拉丝缇娅拉的留守决断</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「因为、我的力量已经不足以和你们同行了⋯⋯我现在能做的就只有在这里维系各国之间的合作，在力所能及的范围内为玛利亚她们的旅程提供援助而已了吧⋯⋯？」；「我已经没有战斗的力量了，这点毋庸置疑。──所以，我决定采取其它的『方法』和艾德等人对抗。利用自己作为现人神的权限，就算不能立刻让南方战胜北方，但至少也可以准备一个与艾德和使徒西斯对等谈判的场所。既然在战斗中派不上用场，那就选择交涉，概以言之就是这么回事了」；「这真的是你自己的选择吗⋯⋯？你没有说谎吧？没有像以前那场仪式一样被动了什么手脚吗？」</data></node>
    <node id="藏书室探索与佩艾希亚史书发现"><data key="name">藏书室探索与佩艾希亚史书发现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">话是这么说，但要说找东西我还是很擅长的。只要稍稍展开『维度』，寻找与魔法有关的东西就好了。；其中最吸引我眼球的，则是历史书和英雄谭。；这个国家的历史书和英雄谭。──那就等于是与佩艾希亚的英雄『支配之王（罗德/Lord）』相关的资料。</data></node>
    <node id="诀别早餐与感情剥夺"><data key="name">诀别早餐与感情剥夺</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【技能『？？？』暴走了】</data></node>
    <node id="阿雷亚斯流共鸣剑术『雪风』创始·千米蜈蚣崩落"><data key="name">阿雷亚斯流共鸣剑术『雪风』创始·千米蜈蚣崩落</data><data key="type">event</data><data key="status">provisional</data><data key="desc">但是最后阻挡在我们面前的是身长超过一千米的飞舞于空中的巨型蜈蚣，它像一座城墙般矗立在我们面前；尽管我们两人的剑技都是即兴使出，但是确实达到了可以被唤作技的领域。；「──阿雷亚斯流共鸣剑术！『雪风』！！」</data></node>
    <node id="四人组逃亡与归宅"><data key="name">四人组逃亡与归宅</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『FlameArrow・散花（FallFlower）』</data></node>
    <node id="涡波对西斯开战（未完）"><data key="name">涡波对西斯开战（未完）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好的我明白了，你走好⋯⋯，你觉得我会这么说吗！──玛利亚、拜托了！」；玛利亚也立刻进入临战态势。在做好随时可以释放魔法的准备后，她简短地答应了一声。；「缇亚，搞不好可能会连你一两条腿一并斩断！抱歉了！」</data></node>
    <node id="涡波通读藏书室史书与『支配之王』英雄谭"><data key="name">涡波通读藏书室史书与『支配之王』英雄谭</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在之后的书页上记载着对罗德的介绍。；将历史书泛泛地浏览过一遍之后，我将目光移向了『支配之王（Lord）』的英雄谭。；但是刚将书翻开，我就注意到了异常之处。书中有几页被撕碎了。</data></node>
    <node id="雷纳尔多工房访问与委托失败"><data key="name">雷纳尔多工房访问与委托失败</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──啊啊，你说风龙是吗。那估计就是说『艾尔芬里斯』了吧。虽然谈不上绝对，但是能有效对付那家伙的魔法道具确实是有的」；「虽然有点对不住，不过这钱用不了。这不是能在『这里』使用的金币。原因仅此而已」；「⋯⋯不行。全都是破烂。就凭这些是不够代付费用的哦？」</data></node>
    <node id="艾德对涡波的畏惧与『初次见面』冲击"><data key="name">艾德对涡波的畏惧与『初次见面』冲击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『木之理的盗窃者』的战意立马消散的一干二净。；「初、初次、见面？您的意思是说，不认识鄙人艾德了吗？」；「──怎、怎么会是这样？也就是说，涡波大人不仅是『魔法阵』和『迷宫』，就连『再诞』也失败了？无论是谁的『悲愿』都没能实现？所以对守护者的规则才会这样不完善？要是这样的话，在那之后世界到底变成什么样了──！」</data></node>
    <node id="舞斗大会警备日与斯诺身世披露"><data key="name">舞斗大会警备日与斯诺身世披露</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「……『舞斗大会』差不多要开始了。因为这个，有不少三教九流涌进了劳拉维亚，这可能会导致治安恶化，所以我们正好帮忙维持治安。」；「以前那时候，我还是个很可爱的女孩子来着。对公会的工作干劲满满的、每天都很开心。因为那个时候的我还怀抱着梦想。」</data></node>
    <node id="长生种情报提供"><data key="name">长生种情报提供</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊─，没帮上忙真是不好意思。毕竟咱一直都在极力避免跟使徒大人还有『理的盗窃者』的问题扯上关系来着。不过，咱觉得其它从千年前留存至今的人或许会知道会长当时的经历哦？」；咱记得在世界树那边有作为『最后的纯血树人种』的『斯科纳・伊格德拉西尔』、以及在联合国开拓地有作为『最后的纯血龙种』的『托尔普・特鲁克』来着」；「不不，咱要是遇见那帮人的话只会被单方面欺凌的，所以咱一直避免见到那些家伙来着⋯⋯那帮人的性格真的是糟透了呀⋯⋯」</data></node>
    <node id="千年前史核对（诺斯菲口述×涡波重构）"><data key="name">千年前史核对（诺斯菲口述×涡波重构）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">后来又因为涡波大人逃到了北方的缘故，我就统率自己的国家实行了侵略。最后自己被『支配之王』所杀，这就是全部了⋯⋯⋯真的就仅此而已；「是的，虽然最后您似乎还是取得了胜利，但初战却是您的败北。；决心为妹妹的死复仇的我去追杀逃到南方的使徒西斯。</data></node>
    <node id="深夜意识沉没（睡魔或烂醉不可辨）"><data key="name">深夜意识沉没（睡魔或烂醉不可辨）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不仅如此，我甚至感到思考在原地打转，问题总是会在相同的地方陷入困局。；在几个小时的谈笑过程中，思考和视野两方的世界都在越发远去，意识到这点的我扶住额头。；──然而这到底是睡魔还是烂醉的前兆呢。</data></node>
    <node id="教会汇合与二次入迷宫"><data key="name">教会汇合与二次入迷宫</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而后发动了名为『维度·决战演算』的衍生魔法。</data></node>
    <node id="千年前北方凯旋·与罗德初遇即错过"><data key="name">千年前北方凯旋·与罗德初遇即错过</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是一位乘在狰狞凶猛的巨兽背上，身后追随着成千上万的士兵，沐浴在喝彩与赞赏的风暴中高歌猛进的年轻女王。；虽然这些旅人不知为何用魔法进行了变装，但我还是认得出他们都是谁。金发的女性是使徒西斯。黑发少女是阳滝。最年少的少女为缇娅拉。而戴着假面的少年则是『始祖涡波』。；最初的相遇，我与罗德彼此错过了。</data></node>
    <node id="六十层守护者初遇·抚摸未消失"><data key="name">六十层守护者初遇·抚摸未消失</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【六十守护者（SixtyGuardian）】光之理的盗窃者；请您触碰、抚摸我吧。哪怕只有一次，若能得到涡波大人的抚摸，那我便能消失了吧。；就这么足足摸了有十•五•分•钟。</data></node>
    <node id="『不带期待的弟弟』方案成立·罗德复元"><data key="name">『不带期待的弟弟』方案成立·罗德复元</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「对你来说『家人』的存在应该是不可或缺的。就因为一直都没有一个心意相通的人陪在你身边，所以你才不论过了多久都没办法消失。我认为原因只可能出在这里」；「意思是说只要让艾德对你不抱有期待就可以了吧。那么，我和莱纳两人这就去敲打他一番。那之后，我再告诉他说罗德现在已经变成了无可救药的废柴你不要再对她抱有什么幻想了。接着把『对你不抱有期待的弟弟』带过来。那就没有问题了吧？」；罗德向身体注入力量，握住我伸出的手。</data></node>
    <node id="莱纳被捆与获释"><data key="name">莱纳被捆与获释</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，莱纳他现在被我绑起来丢在走廊那里了，有劳您去回收一下。因为要是我去说的话，总觉得会闹得不愉快，能拜托涡波大人代我向他道歉么？」；但在走廊的角落里倒是躺着被魔法制成的闪着光芒的绳子捆了个结结实实的莱纳。；「──那、那个女人！你没事吧，基督！没被那家伙做什么吧！？」</data></node>
    <node id="世界奉还阵质询与勒伽西意志说"><data key="name">世界奉还阵质询与勒伽西意志说</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呐，海莉。你了解有关这个『魔法阵』的事情吗？那家伙称呼这东西为『世界奉还阵』来着。难道说这个跟千年前的『魔法阵』是同样的东西吗？」；「诶诶，没错。帕林库洛打算再现千年前的『魔法阵』。他想将整个战场作为『代价』，展开『世界奉还阵』」；「『世界奉还阵』的发动只有那一次⋯⋯，据说当时整个大陆九成的生命都因其而灭亡⋯⋯⋯恐怕这一次还会导致一样的结果吧」</data></node>
    <node id="克洛伊晨间拦阻与说服"><data key="name">克洛伊晨间拦阻与说服</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──你、你在『早上好』个什么劲啊！到头来还是睡在斯诺大人的房间里了啊！真是龌蹉！你在斯诺大人的房间里到底干了什么！？昨天到很晚的时候我还能听见有声音从里面传来呢！」；正如昨天给你的介绍信上写的那样，从代理总司令的职位上离职的斯诺也会跟我一起走；作为掌管柯尔库城的副官，我绝对不会退缩</data></node>
    <node id="抵达第二迷宫都市达利尔"><data key="name">抵达第二迷宫都市达利尔</data><data key="type">event</data><data key="status">provisional</data><data key="desc">马车在公路上不断前进，终于到了用肉眼就可以看到天边的黑云的位置。按照古奈尔酱的话，那应该就是笼罩在『第二迷宫都市达利尔』上空的黑云了吧。；第二迷宫都市达利尔是一座既没有城墙也不设关卡的都市。；不过对我们旅人而言这自然是再好不过，无需多费周折便可轻松入城。入城之后，我们立马下了马车前往街上漫步。古奈尔酱的车队需要补给和休养，我则需要与同伴们汇合。</data></node>
    <node id="大圣堂突破战"><data key="name">大圣堂突破战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错！听好了，要·由·你·去救人！我给你断后！」</data></node>
    <node id="西娅夺还作战"><data key="name">西娅夺还作战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「在港口哦。……好像正要被贩卖到国外去。」；「是啊！——『既临风王玉座，其人永无他路可行』魔法『Wind·放浪者』！」；以能够在海上自由行动的我和莱纳为对手，船员们根本没有还手之力。于是成功营救了西娅的我们，现在正在远离港口的街上跟西娅面对面。</data></node>
    <node id="罗德吆喝劝退风龙（六十六层和平突破）"><data key="name">罗德吆喝劝退风龙（六十六层和平突破）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在草原上前进的罗德逐渐接近艾尔芬里斯，并开始将缠绕在她身上的浓郁魔力聚集到一处。然而，聚集的地方跟昨天不同，并非手臂而是喉咙。；「艾尔芬、里斯酱啊啊啊啊啊啊啊──────！！」；「人家要过去一下，拜托借个光好伐────！！」</data></node>
    <node id="涡波自述咒术记忆全失"><data key="name">涡波自述咒术记忆全失</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「要说这方面的话，那涡涡可是有关『代价』领域的专家──准确来说是『咒术』的专家吧⋯⋯，你还有印象吗？」；罗德将谈及的对象转向了在旁观的我。看来她觉得让我做『咏唱』的导师更合适。不过，有关那个技术的记忆我现在完全想不起来。</data></node>
    <node id="幼年好友关系断绝"><data key="name">幼年好友关系断绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而与那些友人的关系断绝的时间点，是在我的侄女出生五年之后。；当然了，曾经一同发誓要来到这里的青梅竹马们，如今已是没有一人在我身边。我抛下了一切，只为了自己，站在这里。</data></node>
    <node id="第三枚戒指交付（三戒齐备）"><data key="name">第三枚戒指交付（三戒齐备）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">将工房收拾了一番后，雷纳尔多将戒指交付给我。；这样戒指就有三个了。我先将它们分别戴到食指中指无名指上试了一试。；「知道了，这边的事就放心吧。小子你专心挑战迷宫便是」</data></node>
    <node id="坠落之梦与黑暗中的悔恨之声"><data key="name">坠落之梦与黑暗中的悔恨之声</data><data key="type">event</data><data key="status">provisional</data><data key="desc">所以，我坠落着、坠落着、不断地坠落着。；直至内心的最深部──；突然间，一道含混不清的声音传来。</data></node>
    <node id="沃尔斯带走莱纳之揭示与诺斯菲灭将提案"><data key="name">沃尔斯带走莱纳之揭示与诺斯菲灭将提案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「皆因雷纳尔多・沃尔斯所致⋯⋯⋯其人察觉并参与到发生于此处的战斗后，将莱纳带走了⋯⋯」；考虑到『结界』的构造，我明知只有那个男人可以无视规则行动，却未能防患于未然。；需要在『这里』继续保有意识的只有『你』和『我』、再加上『涡波大人』和『莱纳』，这四人就足够了。</data></node>
    <node id="孤置身碧青二色的世界（前日谭第一幕）"><data key="name">孤置身碧青二色的世界（前日谭第一幕）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">回过神来，『孤』发现自己置身于一个只有两种色彩的世界。；以地平线为界，碧与青二色将世界两分。；不是这里、而是在一个令人窒息的环境中，孤在和涡波战斗着。</data></node>
    <node id="『LivingLegend号』出港（赴本土柯尔库）"><data key="name">『LivingLegend号』出港（赴本土柯尔库）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，在港口军阶最高的联合国军人的带领下，我们来到了一艘停泊在港口角落的大船面前。；当然，更为正经的理由则是她在守护者的力量弱化的现在连日进行不眠不休的飞行本身具有一定的危险性。；「我看了一下，对我们而言这样就足够了，所以就以现在这个状态出港吧。不用担心，魔力那边我会想办法的。航海方面有我们两个人也没问题，事不宜迟我这就出发了」</data></node>
    <node id="罗德劫走诺斯菲（女孩子间的谈话）"><data key="name">罗德劫走诺斯菲（女孩子间的谈话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「可是人家也有好多想跟诺斯菲说的话嘛！同样作为女孩子！──没错，这是女孩子间的谈话！」；在你想起来之前，可怜得不得了的诺斯菲都是属于人家的哦！走吧，诺斯菲！」；接着罗德就这么用公主抱的姿势带着诺斯菲飞出了庭院。因为她这出手诱拐的速度实在是太快，以至于我没能反应过来。</data></node>
    <node id="海莉的拦路对峙与禁止通行宣言"><data key="name">海莉的拦路对峙与禁止通行宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我在等着你⋯⋯⋯不会让你继续前进了，少年。」；海莉阻挡在前进的路上。；「现在，去那三人的所在地的话，无法预测到底会发生什么，至少，请在艾德老师离开了后再去。」</data></node>
    <node id="『感应』首发警报与晶盾收纳"><data key="name">『感应』首发警报与晶盾收纳</data><data key="type">event</data><data key="status">provisional</data><data key="desc">警报声甚大，不停地嘶吼着这么下去会死翘翘。；正是莉帕无名指上的戒指。；啊，这个，不好意思。莉帕，虽然有点抱歉，但是你能先把那个戒指收起来吗？</data></node>
    <node id="帕林库洛怪物化与『第二十之试炼』开幕"><data key="name">帕林库洛怪物化与『第二十之试炼』开幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就像化作了水晶蜘蛛的诺文一样，帕林库洛也彻底舍弃了人形。一只形态不定的漆黑恶魔诞生了。；「既然这样，那不尽到义理可不行啊⋯⋯⋯不管怎么说，似乎『今天，我会在这里消失』啊。听好了哦，这就是我专属的开场白──」；「──『盗窃了暗之理的罪人将迎来第二度的死亡』，『只因我乃背负一次死亡亦无法偿清之罪孽的大罪人』──」</data></node>
    <node id="番外战(训练场四对一)"><data key="name">番外战(训练场四对一)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，在没有观众的训练场里，『舞斗大会』的番外战开幕了。；『舞斗大会』的番外战以我的胜利而告终。</data></node>
    <node id="乱花钱租下新居"><data key="name">乱花钱租下新居</data><data key="type">event</data><data key="status">provisional</data><data key="desc">锁本身虽然很笨重很古风，但它确实可以牢固地关死房门。</data></node>
    <node id="涡波苏醒与自我同一性确立"><data key="name">涡波苏醒与自我同一性确立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">于是，我取回了意识。；我就是『相川涡波』。作为证明的『魔石（魂』就在这里。；我既是『基督』也是『涡波』，即使『千年前的始祖涡波』也是『相川涡波』──说得极端点，我也是『阳滝』。</data></node>
    <node id="海莉与莱纳乱入阵心"><data key="name">海莉与莱纳乱入阵心</data><data key="type">event</data><data key="status">provisional</data><data key="desc">拂去透明的风之裳，银发少女现身了。；「如果你牵上那只手，就是帕林库洛的胜利了哟，少年。战斗还远远没有结束。你万万不可输给他的诱惑」；「⋯⋯你、你为什么会在这里？」</data></node>
    <node id="两军会战与决斗场介入"><data key="name">两军会战与决斗场介入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">原本分散着部队被整合到一起，南北双方都组织了上万的大军。；当我产生疑问的时候，雨势越来越强。不一会儿就变成暴雨，笼罩在整个战场之上。；玛利亚的一击将守护帕林库洛的士兵统统震飞到十米之外。</data></node>
    <node id="莱纳编入涡波队伍"><data key="name">莱纳编入涡波队伍</data><data key="type">event</data><data key="status">provisional</data><data key="desc">莱纳・赫勒比勒夏因加入了队伍。；姑且无视在我们身后「人家也是同伴！人家也是同伴！」地闹个不停的守护者</data></node>
    <node id="佩艾希亚寿命告知重演·罗德狂暴暴风"><data key="name">佩艾希亚寿命告知重演·罗德狂暴暴风</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「罗德，你这是在说什么话。『永远』之流、根本不存在于这个世界。所有的事物都必将迎来灭亡」；「说实话，我实在听不下去了。哪怕是为了你好，我也必须尽早跟你说清楚，那个空间──『佩艾希亚』的寿命已经所剩无多了。你方才说的『永远』是不现实、也不可能的」；「不，就要结束了。在我看来，那个空间的寿命也就只有一个月了」</data></node>
    <node id="魔王城庭院茶会"><data key="name">魔王城庭院茶会</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而罗德则坐在价值不菲的椅子上，以优雅的姿势品着红茶。；若是在毫无矫揉造作的状态下，恐怕真正的罗德原本就是一位完美的大小姐。因而现在这副假冒大小姐的模样，其实才是她有意为之的吧。；莱纳坚持说自己不做随从伺候别人的话就不舒服什么的</data></node>
    <node id="罗德独自飞返佩艾希亚（离队）"><data key="name">罗德独自飞返佩艾希亚（离队）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯人家今天、就先回去了」；「认真地飞回去的话很快就到了，没问题的⋯⋯⋯感觉脑袋热得发涨，人家去冲个凉冷静一下⋯⋯⋯涡涡，抱歉了⋯⋯」；没有理会我的制止，罗德展开翅膀飞走了。她飞翔的速度是如此之快，以至于没有任何阻止在迷宫里逆走的罗德的办法。</data></node>
    <node id="涡波经『连接』穿门前往『史诗探索者』本部"><data key="name">涡波经『连接』穿门前往『史诗探索者』本部</data><data key="type">event</data><data key="status">provisional</data><data key="desc">把甲板上的宝石全都收进『所有物』，我咏唱魔法。；──魔法『连接』；对象不再是迷宫，而是『史诗探索者』的本部。</data></node>
    <node id="千年前：『支配之王』与近卫骑士团长涡波消失·弃北赴南"><data key="name">千年前：『支配之王』与近卫骑士团长涡波消失·弃北赴南</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──『支配之王』和『近卫骑士团长涡波』消失了。；──舍弃了北方的人民，前往南方不知所踪。我们的两位英雄就这样背叛了我们。；如果雷纳尔多所言属实，那么因为这场背叛，佩艾希亚最终毁灭了。</data></node>
    <node id="明日弗茨亚茨访问计划确立"><data key="name">明日弗茨亚茨访问计划确立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">干脆明天就直接去弗茨亚茨好了。正好那家伙就在大圣堂，离这里也不算远。与同伴汇合的话，对付艾德的战力也能增加了。；「嗯？没问题没问题，人家现在精神着呢，就算再过个一百年都没事哦？」；我想明天去拜访一下拉丝缇娅拉</data></node>
    <node id="诺文拘束与决赛资格保全"><data key="name">诺文拘束与决赛资格保全</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然甚少有家具和装饰品，但这里是个非常宽敞的房间。只可惜，难得有如此广阔的空间，却挤满了一大群全副武装的男人，很是杀风景。；在与格连之后的比赛——与芬里尔·阿雷亚斯的比赛中，我公开了自己怪物的身份。我知道格连自那之后就一直在东奔西走，为我的参赛权利作保。</data></node>
    <node id="千年前·商会发展、历基亚国建国与尼特千年"><data key="name">千年前·商会发展、历基亚国建国与尼特千年</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在那之后，因为她跟我兴趣相投所以就一起行动了，并且就是在我们共同行动的时候组建了英格利特商会。当然，这也不全是因为兴趣相投，对她来说也有以商会为后盾保护成为稀有人种的自己的目的。但因为我还有其它的问题要处理，所以不久就离开了商会。虽然作为『会长』的我不在了，但古奈尔仍然坚持运营商会为人民服务。；用从我那里获得的异世界的知识为武器，英格利特商会发展为了执世界牛耳的一等一的大商会。而且后来她也没有被卷入千年前的『世界奉还阵』，岂止如此，她甚至利用大战的混乱以财力为工具在大陆西面建成了一个中立国。；那就是她的国家──『历基亚国』</data></node>
    <node id="诺斯菲与始祖涡波邂逅（自失期照料·父亲大人呼喊）"><data key="name">诺斯菲与始祖涡波邂逅（自失期照料·父亲大人呼喊）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是始祖涡波与诺斯菲。；「⋯⋯涡波大人，请走这边」；「父亲大人⋯⋯」</data></node>
    <node id="阳滝所在揭示——『她就在我的身体里』"><data key="name">阳滝所在揭示——『她就在我的身体里』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『阳滝』她就在这里⋯⋯！就在我的身体里⋯⋯！！一直都在！！」；自己一直在寻找的妹妹、『阳滝』的所在之处──就是我的身体本身。；「现在这里一共有两个魔石！既有我自己的『次元之理的盗窃者』的魔石！又有阳滝的『水之理的盗窃者』的魔石！这两个同时存在啊！！」</data></node>
    <node id="迎接滞留开拓地王族的护送任务（进行中）"><data key="name">迎接滞留开拓地王族的护送任务（进行中）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">先前滞留在开拓地联合国的王族们即将抵达这个港口都市。；迎接国家要人兹事体大，绝对不能在这个时候让此等大敌杀到眼前。</data></node>
    <node id="涡波失去技能『并列思考』（自述）"><data key="name">涡波失去技能『并列思考』（自述）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">失去了技能『并列思考』的我因为无法对思考进行分割，所以导致思考一旦开始加速就会停不下来。</data></node>
    <node id="涡波读尽风之剑术·激怒方针"><data key="name">涡波读尽风之剑术·激怒方针</data><data key="type">event</data><data key="status">provisional</data><data key="desc">尽管牺牲了一根手臂，但拜此所赐我可以仔细观察罗德战斗的方式。；技能『剑术』的数值在短时间内有了飞跃性的增长；所以这些口角只是我为了将她激怒而故意为之</data></node>
    <node id="第三次迷宫探索·66→63层突破"><data key="name">第三次迷宫探索·66→63层突破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这样一来就是地下生活的第五天，同时也是第三次挑战迷宫。；那是因为艾尔芬里斯听到了罗德的请求之后，居然还真点了点头飞离了螺旋阶梯旁边。；——光魔法『Light•幻影（Phantom）』。</data></node>
    <node id="缇娅拉身世讲授"><data key="name">缇娅拉身世讲授</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这是当然的啊。因为圣人缇娅拉就是『我』啊。」</data></node>
    <node id="露店淘宝与发夹赠礼"><data key="name">露店淘宝与发夹赠礼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">说着我为缇亚戴上了『艾丽娅的发夹』。</data></node>
    <node id="宝石处理商谈决意与同伴去留：斯诺拒行、莉帕留守"><data key="name">宝石处理商谈决意与同伴去留：斯诺拒行、莉帕留守</data><data key="type">event</data><data key="status">provisional</data><data key="desc">但是欧尼酱、这么多的水晶和黄金，你打算怎么办呢？；所以我打算去找人商量下。你要一起来吗？；就算拿到换钱的地方，这些也超过了个人交易的资金范畴了。</data></node>
    <node id="后卫魔法组合开发（玛利亚耳语提案）"><data key="name">后卫魔法组合开发（玛利亚耳语提案）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我说，玛利亚。要怎样才能像你那样驱使火焰呢？我是非常想做到那个级别的⋯⋯」；「──但是，这是个好机会。我有些想尝试的东西，缇亚你把耳朵凑过来点」；路上，基本上都是我和拉丝缇娅拉砍瓜切菜地打倒怪物。</data></node>
    <node id="生还与缇亚谵言"><data key="name">生还与缇亚谵言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我、我是缇亚……不是、西、斯……」</data></node>
    <node id="目击雷纳尔多与诺斯菲豪宅对峙"><data key="name">目击雷纳尔多与诺斯菲豪宅对峙</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不断映入脑海的是焦烟腾腾的废墟，空空如也的商店，塞满烧焦尸体的仓库，以及驻扎着士兵的城寨。然后我在一户豪宅之中找到了熟悉的两人。；在足以召开舞会的广阔前廊，负伤的雷纳尔多和『光之理的盗窃者』诺斯菲正在对峙。；佩艾希亚的大地发生了巨大的地震。我被迫解除了『维度』，体势也崩溃了。</data></node>
    <node id="锻冶考验与仓库密谈·拯救罗德的托付"><data key="name">锻冶考验与仓库密谈·拯救罗德的托付</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「小子。你调查一下罗德现在在哪里」；「与之相对地──，希望你能去拯救罗德那丫头。就凭老朽我们的话，恐怕已经没办法救她了」；「在我力所能及的范围内我会尽量帮忙的⋯⋯」</data></node>
    <node id="半死体帕林库洛十秒败北与坦白问答"><data key="name">半死体帕林库洛十秒败北与坦白问答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——冰结魔法『耶梦加得之霜』！」；正好经历了十秒左右的攻防。战斗就这样宣告结束了。；足以打倒30层守护者的实力以及诺文的魔石。在这两样东西面前，帕林库洛无可奈何地愿意向我坦白——看上去是这么回事。</data></node>
    <node id="涡波DistanceMute特攻被弱化版化解·遭擒"><data key="name">涡波DistanceMute特攻被弱化版化解·遭擒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">可是连手指都不动一下，顷刻间所有的空间扭曲就被修复了。；「──魔法『DistanceMute』！！」；「因而，这也在我的意料之中。──『DistanceMute』。只让我的右手，与您那产生错位的次元相位相合便是。多少有点勉强就是了」</data></node>
    <node id="32层飞行怪歼灭战（组合魔法确立）"><data key="name">32层飞行怪歼灭战（组合魔法确立）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──我的眼睛，也看见了。缇亚，按照预定动手。──魔法『Flame・决战炎域』、『萤火』」；缇亚的魔法的『路径』──不对，是在空中造出了『枪身』；在压倒性的热量下，敌人坚硬的水晶躯体被熔出一个大洞。</data></node>
    <node id="缇达击杀与遗愿"><data key="name">缇达击杀与遗愿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我希望你们能照着这个势头将阿尔缇的</data></node>
    <node id="第三十之试练(瓦尔法拉=三十层再现)"><data key="name">第三十之试练(瓦尔法拉=三十层再现)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这·里、这·大·剧·场·船『瓦·尔·法·拉』正·是·三·十·层！地之理的盗窃者诺文的阶层！虽然强行借用，外加有所赶工而招待不周，但是你大可将此处视为迷宫三十层！来吧，开始『第三十之试练』吧！真正的决赛、这才刚刚开始——！！」；「还没结束呢！我们的决赛还没完！请千万不要插手！！」</data></node>
    <node id="帕林库洛缠缚与『心异解放』连击"><data key="name">帕林库洛缠缚与『心异解放』连击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">中途开始帕林库洛便放弃了防御。；帕林库洛利用了『世界奉还阵』，支付了『代价』，削减了生命，打算发动最后的黑暗魔法。；但是，我马上抑制住了技能发动。现在技能『？？？』发动的话，有可能会失去对帕林库洛的战意。</data></node>
    <node id="首次迷宫探索成果确认"><data key="name">首次迷宫探索成果确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">首次迷宫探索结束，我们在甲板上确认这次探索的成果。；仅仅几个小时就完成了目标的一半，还得到了大量的经验值，级别的平均化也堪称完美，不仅如此还没有任何人受伤。；今天的探索就是我曾经梦寐以求的『割草一样的探索』。没毛病。</data></node>
    <node id="涡波的决意：带罗德走出"><data key="name">涡波的决意：带罗德走出</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我要做的就是拎住这个小孩子的脖子，带着她一起走到外面的世界去。仅此而已。；既是为了我自己，也是为了罗德，我必须将那・个・胜・利得到手。；一心只为实现那个未来，我奋力自立足点跃起。</data></node>
    <node id="鲜血魔法黑化与缇缇格挡"><data key="name">鲜血魔法黑化与缇缇格挡</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着诺斯菲的身上开始涌现出大量赤黑色的雾霭。；「──鲜血・魔・法『相川涡波/相川阳滝』」；旗帜与铳剑相咬合，鸣起钝重的声音。</data></node>
    <node id="技能『？？？』第二次暴走（死亡危险×恋心复合·水中战）"><data key="name">技能『？？？』第二次暴走（死亡危险×恋心复合·水中战）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──说到底，技能『？？？』的发动只是时间上的问题而已。；就像拼命隐瞒的事情，最终说漏一样。就像天崩地裂，被吸入黑洞中一样。就像一切都白费一样。我产生了一种安详感──看准这个间隙，技能『？？？』钻了空子。；死亡的危险和恋心，这两者中任意一个单独出现的话我都能忍耐。但是在两者复合，又身处水中战斗的状况下就不一样了。</data></node>
    <node id="一年后重访瓦尔德的酒馆（日樱·店长·克劳再会）"><data key="name">一年后重访瓦尔德的酒馆（日樱·店长·克劳再会）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">也是我曾经工作过的地方。；「欢迎光临。请问客人要点──等等、诶？请、请这边坐、不是，诶？⋯⋯诶？」；「你们都给我安静点！这小子是相信我、相信这家店才过来的。谁敢对他出手先过了我这关再说。⋯⋯不，其实仔细想想的话，新人你已经比我要强了啊？」</data></node>
    <node id="强夺军马与昼夜疾走"><data key="name">强夺军马与昼夜疾走</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「卫兵一共有二十七人。……就去袭击北边那批吧。跟我来。」；「——『FlameSphere』！」；我们抵达了一座名叫克拉布布布布布布布布布布布布布布布尔的新城市。</data></node>
    <node id="缇亚的噩梦呓语与叫醒"><data key="name">缇亚的噩梦呓语与叫醒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『人家』──不对，不是这样的。对不起，基督──」；我过去也听过这样的呓语。那是在迷宫第五层与缇达交战后，背着缇亚回去的路上，也听过一样的话。；总感觉她那青色的双目正发着光。</data></node>
    <node id="拉古涅情报解禁：艾德治世与北逃宰相"><data key="name">拉古涅情报解禁：艾德治世与北逃宰相</data><data key="type">event</data><data key="status">provisional</data><data key="desc">弗茨亚茨已经成为了联合国的龙头了；他证明了不论是谁都能够对这个世界的魔力加以操纵；跟『先天技能』配合在一起进行『咏唱』并产生『代价』这一现象</data></node>
    <node id="魔法屋再访与魔石购入"><data key="name">魔法屋再访与魔石购入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我使出『维度』探索看上去能淘到新东西的店铺。过程中发现了一家眼熟的魔法屋。是我和玛利亚以前造访过的那间。；「真的吗？如果可以的话希望能每个都准备两个」；今天我一共入手了四份次元属性的魔石，就先从它们开始练起吧。</data></node>
    <node id="告白失败确认与再告白宣言"><data key="name">告白失败确认与再告白宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「唔姆！失恋之旅就要开始了呢！」；「才、才没有哭好吧！真正的告白要等到回来之后再做的说、我完全没有因为被甩的事感到伤心的说！而且多亏了塞拉我现在信心满满的说！」；讲道理，现在联合国对我来说就是告白失败的伤心之地。可能的话我真想赶紧出发赶紧回来，然后重新告白一次洗刷惨痛的经历。</data></node>
    <node id="涡波先谭预知确认·舍弃无伤回避"><data key="name">涡波先谭预知确认·舍弃无伤回避</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一旦被击中就是消灭。；就算用『维度・曲战演算』改变罗德的轨迹恐怕也没有意义。无论到哪里都避不开她攻击的余波。不对，说到底我的魔法能否起作用都是个问题。；直到刚才为止我们之间的战斗都只是小打小闹，其过程甚至没有出现在『次元决战演算『先谭』』当中，但现如今我眼前的这一幕却曾在其中出现过。</data></node>
    <node id="迷宫进度：抵达六十层（自报）"><data key="name">迷宫进度：抵达六十层（自报）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我好不容易才抵达六十层，明明按理来说回到地上只是时间的问题了，但是现在这样就算我想回也不能回了啊。；不过，今天在迷宫里打拼了一天，你应该累了吧？</data></node>
    <node id="告白被甩公开与斯诺再挑战宣言"><data key="name">告白被甩公开与斯诺再挑战宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这小子在人家面前被人狠狠地甩掉了哦；我一回到地上就同她告白，结果只得到了冰冷的回绝；「⋯⋯既然被甩了、那也行吧。毕竟拉丝缇娅拉大人本来就领先我一步」</data></node>
    <node id="诺斯菲『诅咒』净化说明与罗德解脱宣言"><data key="name">诺斯菲『诅咒』净化说明与罗德解脱宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯生前的我，因为身体里被先天性地植入了某个咒术式的缘故，所以处于一种时常向周围散布某种『咒术』的状态。不过现在我已经可以对该种咒术进行控制了。看来正如涡波大人预言的那样，在成为守护者的过程中得到了一定的净化呢」；「是带有魅惑力量的光。我就是依靠这道光统率南方的士兵们的」；「对实力强悍的人是没有效果的。像涡波大人和罗德就可以将光的力量完全无效化。对那边的莱纳应该也是不起效的」</data></node>
    <node id="第二拳·佩艾希亚物理毁灭"><data key="name">第二拳·佩艾希亚物理毁灭</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德挥出的第二拳，为这个满是疮痍的世界带来了终结。；就像是空手碎瓦片一样──整个世界被劈・裂・为两半。；当然，做到这样的话结界也保不住了。</data></node>
    <node id="缇缇对艾德的诘问（未答）"><data key="name">缇缇对艾德的诘问（未答）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「艾德！你刚才为什么不阻止她们！？你忘了自己说过什么了吗！？」；「你刚才做的事跟千年前南方那帮人有什么不同！为了自己的利益，丝毫不在乎被利用的弱者！」；「这就是你想要的佩艾希亚吗！？把这些人当做弃子，对你来说完全无所谓吗！？」</data></node>
    <node id="双手环同时破碎与诅咒消失"><data key="name">双手环同时破碎与诅咒消失</data><data key="type">event</data><data key="status">provisional</data><data key="desc">碎片飞舞，涡波露出得意的笑容。但他的『手环』下场也一样。我挥下的重拳连同他的左臂一起重创，『手环』被砸的粉碎。；此时此刻，所有苦难的源头终于被粉碎。</data></node>
    <node id="涡波梦中记忆回放：妹妹阳滝与求医无果"><data key="name">涡波梦中记忆回放：妹妹阳滝与求医无果</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我不可能认错——她就是我的妹妹相川阳滝。；因·为·我·的·错，妹妹受了苦。；我寻找着能够对医治『相川阳滝』一事点头的人——</data></node>
    <node id="涡波的恋爱自答与告白冻结"><data key="name">涡波的恋爱自答与告白冻结</data><data key="type">event</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉·弗茨亚茨曾·经·是我最喜欢的人。这一点在圣诞祭前夜已经确定了。；那是一幅『浑身是血的我，与熊熊燃烧的船一同沉没』的光景。；拥有数度救我一命的功绩的技能『？？？』，告诉我说「你小子敢去的话就会死翘翘」。</data></node>
    <node id="35层阶梯浸水受阻与折返"><data key="name">35层阶梯浸水受阻与折返</data><data key="type">event</data><data key="status">provisional</data><data key="desc">紧接着我们就找到了前往35层的阶梯。；在浸于水中的阶梯之前，我们开始了作战会议。；一边感慨今天的迷宫探索真是乱七八糟，我一边背过身，在回廊的角落造出『连接』</data></node>
    <node id="守护者消灭机制再实证"><data key="name">守护者消灭机制再实证</data><data key="type">event</data><data key="status">provisional</data><data key="desc">阿尔缇是因为其它的某种留恋获得实现，从而导致自己消失的。</data></node>
    <node id="缇亚身世·使徒西斯篇"><data key="name">缇亚身世·使徒西斯篇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是因为在我诞生于世的时候，母亲因将我视作恶魔而恐惧不已，结果就没有赋予我名字的缘故。；以当年少许的歉收为口实，我便被献给了国家。</data></node>
    <node id="无序之风封感知·强制同行"><data key="name">无序之风封感知·强制同行</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那个，禁止呦。『无序之风』」；柔和的风吹了过来，我正在发动的魔法被『魔法相杀』了。；这个少女不仅仅是拥有着速度和力量。魔法方面也同样优秀。不，更确切地说，恐怕魔法才是她真正擅长的地方。</data></node>
    <node id="涡波初抵六十层·第六位守护者诺斯菲苏醒"><data key="name">涡波初抵六十层·第六位守护者诺斯菲苏醒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">正因为抱着这种感想，我才丝毫不敢大意地摆出临战态势并对她使用『表示』；「六十守护者（SixtyGuardian）」光之理的盗窃者；好似从睡梦中醒来的一名少女缓缓起身。</data></node>
    <node id="斯诺的告白与涡波的保留回答"><data key="name">斯诺的告白与涡波的保留回答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[不可能是骗你的啦。我就跟玛利亚酱一样，爱涡波爱得要死哦]；[——唔~嗯。……夫，夫君怎么样？]；[拜托了，斯诺。那样这艘船就糟了。享年一日就要去见上帝]</data></node>
    <node id="决斗首次交锋"><data key="name">决斗首次交锋</data><data key="type">event</data><data key="status">provisional</data><data key="desc">可是，她不费吹灰之力便避开了我的进攻，并在躲避的同时反手挥剑直取我的脖颈。；教科书般的后发制人。</data></node>
    <node id="艾尔芬里斯再讨伐（二人联动）"><data key="name">艾尔芬里斯再讨伐（二人联动）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">刚冲进六十六层这个开阔的空间，我们立刻兵分两路。；千年前的大魔法于此重现。；——风魔法『TauzSchuss·Wind』！！</data></node>
    <node id="莱纳脱队与战备便条"><data key="name">莱纳脱队与战备便条</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「莱纳去了弗茨亚茨，这样就只剩下我们两个人了啊⋯⋯虽然多亏了莱纳我才能了无牵挂地出发，不过还是有些寂寞啊⋯⋯」；既然会有这样的便条，那就说明在我和缇缇前往旅店之前，莱纳就已经预料到这种展开了吧。；如果基督心焦气躁地打算立刻离开联合国的话，缇缇务必要出手将他敲晕。</data></node>
    <node id="向莱纳坦白只会次元魔术"><data key="name">向莱纳坦白只会次元魔术</data><data key="type">event</data><data key="status">provisional</data><data key="desc">使用你之前攻击帕林库洛那家伙的冻结魔法的话，应该很容易就能给那条龙击落不是吗？；「冻结魔法是我妹妹的才能，现在的我只会使用次元魔术而已⋯⋯」；我现在有自信能用好的魔法只有『维度』『形式』『连接』这三个而已。</data></node>
    <node id="玛利亚新魔法试炼"><data key="name">玛利亚新魔法试炼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是以消耗HP为必要条件的魔法。</data></node>
    <node id="涡波领悟留恋实现之因·怒极开战（章末）"><data key="name">涡波领悟留恋实现之因·怒极开战（章末）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我拒绝她索求契约之证的时候，她的留恋得到了实现。其中的理由，我现在终于明白了。；那时候诺斯菲肯定也跟现在一样，看到我痛苦的表情，她感到非常开心。；而她也借此得知了自己的愿望，所以现在在全力地让我感到困扰。</data></node>
    <node id="34层伽鲁夫纳多杰里Boss战：洪水、渡氧之吻与技能『？？？』第二次暴走"><data key="name">34层伽鲁夫纳多杰里Boss战：洪水、渡氧之吻与技能『？？？』第二次暴走</data><data key="type">event</data><data key="status">provisional</data><data key="desc">正好我也学会了『锻冶』技能，正值筹备新装备的时候。能得到上等的魔石的话，说不定也能打造出堪比『新月琉璃』的武器。；我下定决心，吻上拉丝缇娅拉的樱唇。然后将自己积攒的氧气全部送进她的口中。；──技能『？？？』暴走了。</data></node>
    <node id="第三天作战部署(手环破坏重申)"><data key="name">第三天作战部署(手环破坏重申)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「现在就是关键时刻了。涡波要比诺文更快地结束比赛，跟我们汇合。我们则要好好地修理斯诺一顿。然后在不会有任何人妨碍的准决赛中破坏掉『手环』。——上吧！」</data></node>
    <node id="决斗规则约定成立"><data key="name">决斗规则约定成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">要是把对方杀了就自动判负，只有让对方主动投降才算真正的胜利。；如果我赢了的话，我要你再也不许在我面前露脸。；不过，决斗的形式必须是一对一。</data></node>
    <node id="螺旋阶梯破壊·止步六十五层"><data key="name">螺旋阶梯破壊·止步六十五层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">位于平原中央的螺旋阶梯遭到破壊，无法登上六十五层。；使用『Default』的话倒是能上的去。不过，经过刚才这场不计消耗的战斗，目前剩下的MP让我舍不得这么早。不惜消费作为备用魔力的『次元戒指』也要去挑战未知的六十五层什么的，我还是有所忌惮。；「先回去吧。不能急躁冒进」</data></node>
    <node id="四少女初恋状态判明与封印骚动"><data key="name">四少女初恋状态判明与封印骚动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">精神系的魔法大概也解除了；「──也就是说，这些孩子全员，都对涡涡陷入了见到初恋般的状态喽！」；果然『连接』这东西还是很危险</data></node>
    <node id="玛利亚妹妹身份揭晓(涡波自责)"><data key="name">玛利亚妹妹身份揭晓(涡波自责)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">玛利亚是我的妹妹！？我怎么能没去怀疑，怎么能没察觉到啊！？我对妹妹(阳滝)的心意就只有这种程度吗！啊啊、啊啊啊、我这是何等的不堪！给两人的身份搞错也太对不起她们了吧！！</data></node>
    <node id="帕林库洛真意告白——'我一直都是为了胜过涡波才战斗的'"><data key="name">帕林库洛真意告白——'我一直都是为了胜过涡波才战斗的'</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──啊啊，我不想输」；「事到如今我终于明白了⋯⋯！我跟你们不一样！我不光是要战斗，我更想赢啊！我想要超越涡波！我想要和真正的涡波战斗，然后超越他！是啊，就是这样！我想要展现出自己不逊于被那家伙所憧憬的英雄的一面啊！这就是我的愿望！对帕林库洛来说，战斗不是游戏！我一直都是为了胜过涡波才战斗的啊！！」；但是，我却在恶寒的驱使下，决定了结他。</data></node>
    <node id="海莉发作倒下·魔石夺除与收容决定"><data key="name">海莉发作倒下·魔石夺除与收容决定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──却突然跪倒在地。；「哈啊哈啊⋯⋯！在，在这种时候发作？何等不堪！」；「反正也要回去了。就带上她一起回船上仔细诊断好了」</data></node>
    <node id="光之战场移入与三对一合围"><data key="name">光之战场移入与三对一合围</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为六十六层的表里二侧重合在一起，另一处战场也移动到了这边。；罗德！！作为你的朋友，我在问你到底发生了什么！请你好好回答我！！；如今我和缇缇还有莱纳三个人对诺斯菲形成了合围，局势由二对二转变为了三对一。</data></node>
    <node id="六十六层初战：艾尔芬里斯攻防败退"><data key="name">六十六层初战：艾尔芬里斯攻防败退</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我拿着『新月琉璃』，莱纳则握着『阿雷亚斯家的宝剑诺文』和『RokhBringer』，都是随时准备迎击的状态。；——风魔法『WindWing』！！；虽然看到位阶就知道会很难对付、不过真没想到能到这种地步……完全没有胜算……</data></node>
    <node id="围攻濒死帕林库洛（四强连击·魔石线发光）"><data key="name">围攻濒死帕林库洛（四强连击·魔石线发光）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">帕林库洛这次要以斯诺、塞拉、拉丝缇娅拉、莉帕这四个在大陆难觅敌手的顶级实力者为对手。；但是面对袭来的敌人，帕林库洛却不为所动依旧专心于魔法构筑上。甚至连拉开距离都放弃了，将手置于地面用于魔法构筑。；吸收了帕林库洛的血的中庭开始产生淡淡的光芒。</data></node>
    <node id="西行旅途开启（柯尔库汇合斯诺后赴西迷宫遗址）"><data key="name">西行旅途开启（柯尔库汇合斯诺后赴西迷宫遗址）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在柯尔库与斯诺汇合的我们目前正驱车向西行驶。；当下的目的地是被冠以『西迷宫』这个名字的我和帕林库洛的战场的遗址。；不仅地理环境已经烂熟于胸，同时也有『维度』帮忙避开危险的军队，所以已经整整一天都平安无事了。</data></node>
    <node id="罗德破坏佩艾希亚出入口（据诺斯菲·章外）"><data key="name">罗德破坏佩艾希亚出入口（据诺斯菲·章外）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">看来她没有注意到我的信号，跑去破壊佩艾希亚的出入口了；虽然将『门』破壊掉确实是一种办法，但绕的实在是太远了啊</data></node>
    <node id="病房对话（精神剧变）"><data key="name">病房对话（精神剧变）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">简直就像是中了什么魔法——就跟使用了『？？？』的我一样精神产生了剧变。；——基督也好、基督的愿望也好，都由『我（私）』来守护。</data></node>
    <node id="DistanceMute突破与繋心『交流』"><data key="name">DistanceMute突破与繋心『交流』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『DistanceMute』！覆盖我的全身！！」；魔法的效果简单粗暴地被发挥了出来。就像幽灵穿过墙壁一般，我的身体得以在结界中移动。；「──『DistanceMute・繋心（Access）』！」</data></node>
    <node id="诺斯菲光魔法镇伏六十五层LizardFlyer"><data key="name">诺斯菲光魔法镇伏六十五层LizardFlyer</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不想被罗德一个人占尽风头的诺斯菲赤手空拳地进入了六十五层打先锋。接着，她完全不在乎敌人的位置，毫无防备地走在延伸于空中的阶梯上。；看到诺斯菲即将被它们所伤，我连忙作势欲冲，但却被罗德摁住了肩膀，迟了一步。；「没事的啦。那可是诺斯菲的说」</data></node>
    <node id="缇亚性别公开（泳装事件）"><data key="name">缇亚性别公开（泳装事件）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「涡波⋯⋯⋯这个，不是女式的么⋯⋯」；「不不，其实我一开始就没相信缇亚是男孩子来着？」；「我记得，使徒西斯确实是女性。⋯⋯来着吧？」</data></node>
    <node id="准决赛打假赛(手环互破坏规则)"><data key="name">准决赛打假赛(手环互破坏规则)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「所以我们准备了『手环』。而涡波选手也戴着类似的『手环』。对这个『手环』的争夺——或者说以破坏对方的手环为目标是不是就显得公平了些呢。这样如何？」；这样一来，打假赛的准备就大功告成了。</data></node>
    <node id="涡波亲口自报全名（古尔亚德）"><data key="name">涡波亲口自报全名（古尔亚德）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错。给，这是介绍信。顺带一说我是劳拉维亚直辖公会『史诗探索者』的会长『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』──」；我终于还是亲口说出了这个名字。；尽管这是为了节省时间的无奈之举，但总觉得心里有什么重要的东西就这样丧失了。</data></node>
    <node id="『魔石人类』谎言当面揭穿"><data key="name">『魔石人类』谎言当面揭穿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊，我恢复过来了！而且还知晓了真相！也知道了你这个人是多么卑劣地颠倒了是非！什么『魔石人类』啊！我才不是呢！你这个大骗子！！」；「──！！啊啊，原来如此啊！你都知道了啊！哈哈，我还挺有自信能骗过你的来着呢！感觉如何！？我编的故事挺有意思的吧！？涡波小哥！！」；「哈、哈哈！少年，只依靠自己就恢复过来了吗！？之前那次我可是施加了数量过百的精神魔法才好不容易给你拉回来的哦！！」</data></node>
    <node id="诺斯菲自明留恋真目（『说任性的话』）"><data key="name">诺斯菲自明留恋真目（『说任性的话』）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「看起来是这样的，涡波大人。对我来说所谓的『犯错』，只是对至今为止的『正确的事』进行否定罢了。没错，只要去『否定』就足够了⋯⋯」；「⋯⋯嗯。呵呵，简要来说的话，我想要的也就是让人听我说些任性的话而已吧」；「因为在之前的人生中我一句任性的话都没说过⋯⋯，所以就变得只要能化解那份怨念便怎样都好了吧。实在是太容易了，反倒让人觉得扫兴呢。呵呵呵」</data></node>
    <node id="新人骑士发现涡波与团长代理情报窃听"><data key="name">新人骑士发现涡波与团长代理情报窃听</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这时我被徘徊在街道的几名新人兽人骑士发现了。；「找到了！是背叛的骑士涡波！！」；「绝对要找到他！这里离沃尔斯家很近！再等一下团长代理就会过来了！在此之前一定要拖住他！」</data></node>
    <node id="LivingLegend号甲板午餐会"><data key="name">LivingLegend号甲板午餐会</data><data key="type">event</data><data key="status">provisional</data><data key="desc">玛利亚没对迟来的我埋怨什么，温柔地邀我入座。；午饭是以新鲜的海鱼为主体的豪华大餐。应该是用斯诺她们钓上来的鱼做的吧，从刺身到烤鱼应有尽有。；玛利亚端起小盘子，为我挑选起类似馅饼的料理。</data></node>
    <node id="飞越城墙：LivingLegend小队战斗打响"><data key="name">飞越城墙：LivingLegend小队战斗打响</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了救回现在缺席的同伴，LivingLegend小队的战斗就要打响了。；玛利亚坐在兽化的塞拉身上，剩下四个人经过一段长距离的助跑后──；再然后就是打倒帕林库洛，安全地以迷宫的最深部为目标，去帮阳滝。</data></node>
    <node id="涡波剑技斩尽风矢毫发无损"><data key="name">涡波剑技斩尽风矢毫发无损</data><data key="type">event</data><data key="status">provisional</data><data key="desc">现在在我眼前的风矢数量为三百四十四──其中会击中我的数量共计五十四──另外二百九十将在之后改变轨道袭击背后；在累计三次的剑闪挥出后，便在箭雨中开辟出了一道缝隙。；──就这样，数秒后，现场只剩下毫发无损的我，方才还数不清的风矢已全部被剑葬送。</data></node>
    <node id="独闯宣言与监视分工"><data key="name">独闯宣言与监视分工</data><data key="type">event</data><data key="status">provisional</data><data key="desc">要是新魔法顺利的话，我想只要一击就能打倒那条龙了；「今天只是去尝试一下所以我一个人去就可以了」；「⋯⋯我知道了。那我今天不看好罗德可不行啊」</data></node>
    <node id="帕林库洛之战落幕与世界奉还阵暴走崩坏"><data key="name">帕林库洛之战落幕与世界奉还阵暴走崩坏</data><data key="type">event</data><data key="status">provisional</data><data key="desc">与帕林库洛・勒伽西的战斗终于闭幕。；无数的地裂重合在一起，还能称作平地的地方已经不复存在。</data></node>
    <node id="涡波冻结海面赴小岛采沙约10公斤"><data key="name">涡波冻结海面赴小岛采沙约10公斤</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──魔法『冻结』；我将海面冻住，在海上跑起来。；然后将海岸上的沙子和石头装进了袋子，之后收回了『所有物』中。</data></node>
    <node id="涡波的决意（尽头无物→攻略宣言）"><data key="name">涡波的决意（尽头无物→攻略宣言）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">尽管我对罗德的留恋毫无头绪，也没有余裕去详细询问莱纳的过去，但至少可以像这样帮他们一点小忙。；虽然不知为何，但我渐渐能体会到罗德的心情了。；但是，在那条路的尽头什么也没有。</data></node>
    <node id="十层对话（阿尔缇体内）"><data key="name">十层对话（阿尔缇体内）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这里正所谓是我的体内。</data></node>
    <node id="斯诺·沃克独力出击讨伐怪物群"><data key="name">斯诺·沃克独力出击讨伐怪物群</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我・去・解・决」；「那我去去就回。这座港口就拜托你们了。我马上就会赶回来的，大家一如往常就好」；斯诺大人展开了那对唯她独有的龙之翼，随后飞出了窗外。</data></node>
    <node id="抵达本土与柯尔库潜入"><data key="name">抵达本土与柯尔库潜入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了隐藏『LivingLegend号』，我们将它停靠在本土东北部瓦尔德本国东端的海崖下。；「总而言之，要跟涡波一起去本土的也就我和玛利亚还有缇亚而已了。这样就漂亮地4对3了呢。」；「就是这样，我们要以4人小队行动喽。队伍名就叫『干死帕林库洛小队』。」</data></node>
    <node id="平原对峙：魔石人类告知后的辩论与放行"><data key="name">平原对峙：魔石人类告知后的辩论与放行</data><data key="type">event</data><data key="status">provisional</data><data key="desc">被示以我是『魔石人类』的可能性，确实让我受到了打击。看来我似乎有可能不是相川涡波。；两个人统合在一起什么的，是不可能做到的！我就没能做到啊！！」；「所以，请你从那儿让开。海莉・维斯普洛佩」</data></node>
    <node id="阿尔缇的愿望与守护者真相"><data key="name">阿尔缇的愿望与守护者真相</data><data key="type">event</data><data key="status">provisional</data><data key="desc">随着留恋的实现，我们会变得越来越弱，待到愿望成真的时候，我们便会消失。；「——我想要成就一段恋爱。」</data></node>
    <node id="柯尔库出发·赴达利尔"><data key="name">柯尔库出发·赴达利尔</data><data key="type">event</data><data key="status">provisional</data><data key="desc">另外再把这边使用的地图也给你们吧；「这样的话，那么沿着北边的山脉前进是最好的。具体的路线是──」；旅途必备的物品不仅在马车中应有尽有，就连我们在『LivingLegend号』上的私人物品都收拾好了。</data></node>
    <node id="诺斯菲留恋宣告（渴望犯错）"><data key="name">诺斯菲留恋宣告（渴望犯错）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「因・为、正・确・的・做・法・永・远・都・不・会・得・到・报・偿」；就在我故作老成做着正确的事的期间，我失去了所有的一切。；我一直、一直都──渴・望・犯・错・啊」</data></node>
    <node id="南方魔人狩猎侵略·村庄毁灭"><data key="name">南方魔人狩猎侵略·村庄毁灭</data><data key="type">event</data><data key="status">provisional</data><data key="desc">按照书上的记载来说就是「南方以魔人狩猎为理由发动了侵略」，仅仅凭此一言，这『漂亮的石子』就从自己的手中滑落，掉进了深渊之中。；一切都发生于两个人遥遥看到故乡的草原被大火吞没的那一刻。；在南方士兵们的手下，自己的家被火烧得不留片瓦，村里的魔人惨遭屠戮，森林里的朋友们化作鱼肉，那片草原俨然成为人间地狱。</data></node>
    <node id="屋顶魔弹战·骑士认出支配之王与叱退援军"><data key="name">屋顶魔弹战·骑士认出支配之王与叱退援军</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就在这时、『维度』察觉到了以超高速向我射来的子弹。；休想逃、涡波！就算你逃也没用，因为就算是在这个距离战斗孤也一样很强！！；在爆裂弹的攻击下，一个又一个的屋顶纷纷塌陷，硝烟随着接连不断的爆炸声四处弥漫。</data></node>
    <node id="共鸣奇袭与首击（冰Aegis冻结眷属→假想诺文・阿雷亚斯→水晶剑）"><data key="name">共鸣奇袭与首击（冰Aegis冻结眷属→假想诺文・阿雷亚斯→水晶剑）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">保持着我和拉丝缇娅拉的魔法能够生效而敌人却无法察觉的距离，我们开始了咏唱。；「共鸣魔法『冰・Aegis』」；原本『次元之冬・终霜』仅具有打乱敌人平衡的冰冻效果，但是在拉丝缇娅拉的帮助下升华了。共鸣魔法完成的刹那间，水中的怪物们便迎来了冰之洗礼。</data></node>
    <node id="屋顶对话与涡波的答案"><data key="name">屋顶对话与涡波的答案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——我·的·妹·妹·不·在·这·个·异·世·界。；不回去不行。哪怕是拼·上·这·条·命，唯有妹妹，我必须让她幸福。即使拼上性命，也必须要让妹妹幸福不可。</data></node>
    <node id="海上战斗不利条件判明"><data key="name">海上战斗不利条件判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了保护船体，缇缇不能在空中战斗这点真是吃亏。而且混有夏比的血的缇缇跟水还相当不对付，再加上我失去了使用冻结魔法的能力不能直接在海面上行动。；注意到这些不利已经是在战斗开始之后的事情了。与此相对，XiphiasSpear作为水栖怪物在海里战斗那是真真正正的如鱼得水。</data></node>
    <node id="缇缇的动物交流之力判明（支配之王同源·翼人种推测）"><data key="name">缇缇的动物交流之力判明（支配之王同源·翼人种推测）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从白色到茶色各式各样的四足小动物。虽然不晓得具体的种类，但都长着一双可爱的耳朵──它们全都是我的朋友。；虽然不知道为什么，但是彼此之间的意思能够互通⋯⋯大概就像这种感觉吧；虽说这实在有些脱离常轨让人难以置信，不过这肯定是操纵毒的力量才能做到的，不会有错。而且是跟传说中的『支配之王（Lord）』一样的力量</data></node>
    <node id="贝丝赠曲奇"><data key="name">贝丝赠曲奇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">但却在门口被贝丝酱叫住了。她就跟早上一样，脸红得像着火一般。；她跑到我身边，将放在漂亮的桃色手帕上的曲奇递给我。</data></node>
    <node id="XiphiasSpear海上决战"><data key="name">XiphiasSpear海上决战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们现在就在海上以赛车的形式和这么一个怪物进行赛船比试。；XiphiasSpear是真的聪明，至今为止面对缇缇的远距离攻击，它全都利用潜入水下并在船后现身袭击的方式化解了。但它的优势也就到此为止了。；结果『始祖和魔王的魔剑BraveFluorite』砰地一下就从缇缇的双手中飞了出去。</data></node>
    <node id="伊丽莎白・沃尔斯地震截击登场"><data key="name">伊丽莎白・沃尔斯地震截击登场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──终于・找・到・了」；从黑暗中走出了一名身材高挑的女性。；我眼前这名女性就是之前那个幼小的贝丝酱。而眼前的她则是贝丝酱成长后的姿态，这在我使用『表示』之前就已经一目了然。</data></node>
    <node id="格连初会与斯诺的崩坏"><data key="name">格连初会与斯诺的崩坏</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊，终于……终于！我终于明白了……！」；——到『舞斗大会』开始还有两天，还有两天一切都将做出了断。</data></node>
    <node id="技能『？？？』命名『最深部之誓约者』"><data key="name">技能『？？？』命名『最深部之誓约者』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我既是『基督』也是『涡波』，既是『千年前的始祖涡波』也是『相川涡波』——说得极端点，我也是『阳滝』。；「——『阳滝』她就在这里……！就在我的身体里……！！一直都在！！」；「——现在正是引导我前进之时！！！『最深部之誓约者（The·Covenanter）』——！！」</data></node>
    <node id="涡波对帕林库洛剑战（言语压制·渐趋下风·168话）"><data key="name">涡波对帕林库洛剑战（言语压制·渐趋下风·168话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">明明我的臂力和剑术都远胜他一筹，却被他轻描淡写地挡住了攻击。；那你是为了什么，为了谁在战斗啊？这场战斗真的是你的心愿吗？；随着内心战意的萎靡，我挥剑的速度也成比例地减慢。</data></node>
    <node id="西斯的讨伐宣言与身体归还拒绝"><data key="name">西斯的讨伐宣言与身体归还拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「总之，我要先去帕林库洛・勒伽西那边。接下来『我们』要先行一步，送他归西。对这件事，缇亚酱也没有反对意见」；「不知为何，使徒勒伽西虽然一直没有干劲，但是他心里在盘算着什么也不尽了然。不过毫无疑问，那个使徒一定才是世界和平的最大敌人⋯⋯！是不得不打倒的敌人⋯⋯！」；从她的态度看来，我跟西斯之间既不是敌对关系，但是也不能算是合作关系。几个问答之间，西斯一直是背过身的状态，不曾与我面对面交谈。</data></node>
    <node id="诺斯菲的败因评定与莱纳的自省"><data key="name">诺斯菲的败因评定与莱纳的自省</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错，正是如此。赫勒比勒夏因，是你输了。你还是太过弱小。；「与在这里的另外三人相比，你那短浅的人生是最大的短板。而这份不足，是你无论如何也无法弥补的」；「再进一步来说的话，现在的你根本就没有发挥好自身具备的力量。想必是用了什么不正当的手段才将自己增强到现在的级别的吧？我说得直接一点好了，仅仅倚赖借来的力量勉力支撑，内在却单薄如纸──这便是我对你的印象了」</data></node>
    <node id="深夜绑缚审问与旧友自白"><data key="name">深夜绑缚审问与旧友自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──总而言之，人家成功给她绑来喽～」；「再不经意也别干出诱拐王族的事情好不好⋯⋯」；「放、放开哇啊啊啊啊啊！咱不想死死死！咱还想活下去哇哇哇哇哇──！！」</data></node>
    <node id="贝丝到访·诺斯菲移交战场"><data key="name">贝丝到访·诺斯菲移交战场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一名少女骑士冲进了前廊──是贝丝。；贝丝在行了一礼之后，竟然站到了诺斯菲的身旁，而不是雷纳尔多的。；如果迎来死亡，那么希望你能够死在涡波大人的面前。</data></node>
    <node id="二十一层护玛利亚苦战"><data key="name">二十一层护玛利亚苦战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——魔法『Dimension·决战演算』『多重展开』『Foam』『Ice』『Freeze』！！」</data></node>
    <node id="始祖和魔王的魔剑BraveFluorite锻造"><data key="name">始祖和魔王的魔剑BraveFluorite锻造</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「唉，那个、请问方便我借用一下工房吗⋯⋯？」；「不用，给这丫头的装备随便做做就得了」；「这样啊。那我就搭把手好了。毕竟好不容易有机会能和会长一起做事啊」</data></node>
    <node id="阳滝再诞提案与涡波拒绝"><data key="name">阳滝再诞提案与涡波拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——就让你见到『相川阳滝』怎样？」；「字面意思。凭借我的力量，是可以让相川阳滝复活的。这样一来少年你那未来永劫的战斗便可以告终了」；少年你就报上『基督（救世主）』的名字，在一旁守护不幸的相川兄妹让他们得到幸福便是。</data></node>
    <node id="告白失败后的酒馆消沉夜"><data key="name">告白失败后的酒馆消沉夜</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在大圣堂的告白之后，我们被好好地款待了一番，之后也得到了周详的礼送。；缇缇毫不留情地讲出了其中的缘由。；看来连店长都因为担心我而过来了。</data></node>
    <node id="甲板全员公开·异世界出身与技能全明示"><data key="name">甲板全员公开·异世界出身与技能全明示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在那里聚集着六名同伴。办事利索的玛利亚在甲板中央设置好一张大桌子，六个人关系融洽的围着桌子坐着。；「那个，在吃早饭之前我有话要说。是非常重要的事情，希望大家能好好听我说⋯⋯」；──将我的一切和盘道出。</data></node>
    <node id="侍女奇袭与莱纳Ex・Wind迎击"><data key="name">侍女奇袭与莱纳Ex・Wind迎击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">加下来就和我猜到的一样，负责杂务的两名少女从怀中取出短剑，分两路向我袭来。；「──『Ex・Wind』！」；站在桌子上的莱纳连玻璃杯都没有弄倒就把敌人的武器短刀给击飞了。</data></node>
    <node id="涡波魔法开发：Default完成→DistanceMute拔魂实证"><data key="name">涡波魔法开发：Default完成→DistanceMute拔魂实证</data><data key="type">event</data><data key="status">provisional</data><data key="desc">次元魔法：Dimension1.69Connection1.03Foam1.07Default1.00；我要将存在于其领域之中最为醒目的『魂』给拔除——；经过一整晚的研究和练习，『DistanceMute』终于完成了。</data></node>
    <node id="双守护者对峙与和解(佩艾希亚中庭)"><data key="name">双守护者对峙与和解(佩艾希亚中庭)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">身兼一对巨大的羽翼和巨型铳剑的罗德，其姿态正可谓是与五十层的守护者这一身份相符的怪物。；噗咻地，像是没了燃料一样，罗德的魔力顷刻间消散殆尽。；罗德和诺斯菲手握着手，过去的仇怨渐渐化解。</data></node>
    <node id="涡波对帕林库洛冻结攻防（尸体补给破局）"><data key="name">涡波对帕林库洛冻结攻防（尸体补给破局）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">然而不管他怎么后退，速度的差距都是不可逆转的。我立刻斩伤他的身体，并进行冻结，他仅剩的一只手臂也被我斩飞、击碎了。帕林库洛的黑色身躯正以肉眼可见的速度被削减着。；一接触到帕林库洛的身体，怪物的尸体便在黑色的浸染下液体化了。接着，怪物转化成的黑色液体重新补足了帕林库洛残缺的身体。；一道轨迹划过，双剑成功地斩断了帕林库洛的脚。然而──失去了脚部的帕林库洛将一只手臂液体化，使之流淌到腿部，立马又恢复了行走能力。</data></node>
    <node id="回收莱纳·信任表态"><data key="name">回收莱纳·信任表态</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，莱纳他现在被我绑起来丢在走廊那里了，有劳您去回收一下。；在我看来诺斯菲那家伙说的话全都可疑得不得了。说得直接一点吧，你难道不觉得她说的全是假话吗？」；「或许如此。但就算是这样，我也想相信她……」</data></node>
    <node id="罗德自白：加速的空壳人生"><data key="name">罗德自白：加速的空壳人生</data><data key="type">event</data><data key="status">provisional</data><data key="desc">都是时间擅自加速的错！；在孤成为『风之理的盗窃者』的时候，在那个失去了弟弟的时候，孤人生的时钟就壊了啊、它再也不曾动过！！；你说失去了妹妹的自己的时间就像停滞了一样</data></node>
    <node id="夜间魔法训练"><data key="name">夜间魔法训练</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我逐渐地可以在手掌上生成精致的冰雕了。</data></node>
    <node id="臣民的谢罪与缇缇的解放"><data key="name">臣民的谢罪与缇缇的解放</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们一直都没能察觉你的心声；您以自己的魂为代价，为我们展现了希望。对此我们心中只有感激，哪里还能有什么怨恨呢；真正想得到帮助的，明明一直一直都是人家自己</data></node>
    <node id="深层之梦与三重意志传达"><data key="name">深层之梦与三重意志传达</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我明白的，想必自己每天晚上都会在梦中看到这段『曾经的记忆』。；可一旦醒来，我就会把这一切都忘掉。这·是·注·定·的。</data></node>
    <node id="涡波×莱纳房内魔法战（拦逃闹战）"><data key="name">涡波×莱纳房内魔法战（拦逃闹战）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我和莱纳都是超过20级的存在。；正所谓，这场战斗乃是世界最顶级的也没有错。；磅！的门被进入屋子的罗德打开。</data></node>
    <node id="诺文消失(千年生涯终焉)"><data key="name">诺文消失(千年生涯终焉)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">察觉到这一点，观众们缓缓开始鼓掌。；断断续续的台词说到最后，诺文便从世界上消失了。</data></node>
    <node id="拉丝缇娅拉夜访与入队"><data key="name">拉丝缇娅拉夜访与入队</data><data key="type">event</data><data key="status">provisional</data><data key="desc">所以请让我和你一起组队吧、求你了，这是我的愿望……」</data></node>
    <node id="对菲伊？厄鲁斯的人身抵债赌局(逆转·全财产剥夺)"><data key="name">对菲伊？厄鲁斯的人身抵债赌局(逆转·全财产剥夺)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「如果所持金额不足的话，要支付作为替代的东西。你们年轻貌美⋯⋯⋯而且我也正巧经营着管理人类的工作⋯⋯⋯也就是说，不够的部分就得用你们的身体来偿还了呢⋯⋯」；虽然一开始我占据优势，但局势渐渐偏向他那一边，我持有的金币逐渐减少。这个男人毫无疑问掌握着整场胜负。；「不，现在还只是布局的阶段哦。我想利用对方的千术，将它原原本本地奉还回去。」</data></node>
    <node id="31层宝石鱼迎击与阵型确认"><data key="name">31层宝石鱼迎击与阵型确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一刹那的邂逅，宝石鱼的背鳍旋即被斩飞。；宝石鱼在空中被切成两半，在落入沙海之前就化作光芒消失了。；看来，只要不是像21层周边那种人海战术的话，缇亚和玛利亚应该就可以高枕无忧了。</data></node>
    <node id="餐厅和食宴与罗德身世问答（ch169）"><data key="name">餐厅和食宴与罗德身世问答（ch169）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「菜单上的东西全都要！管够上不要停！这顿饭是为了祝涡涡康复嘛！」；「在来到这里之前，我还在地上的时候……那个时候有我和莱纳，以及一个陷入沉眠的女孩子。最后这位女孩子，罗德你真的没有见过吗？」；「那么，等我在地上把事情都办完了，我会再过来的。到时候我们再一起玩吧。」</data></node>
    <node id="宅邸崩塌中涡波救出莱纳"><data key="name">宅邸崩塌中涡波救出莱纳</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『连接』无法设置在正濒临崩塌的宅邸。因为障碍物过多『Default』也没法使用。我只能自己跑了。；「──『维度・多重展开』！！」；「雷纳尔多先生现在正在前廊战斗！我们先往那边赶！！」</data></node>
    <node id="状态彻查与吸血鬼判明"><data key="name">状态彻查与吸血鬼判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我立马使出了『表示』；名字：古奈尔・库洛尼科尔・修尔斯・历基亚・英格利特；HP25／25MP112／112职业：吸血种</data></node>
    <node id="北方重启境界战争与北方同盟结成（南方视角回顾）"><data key="name">北方重启境界战争与北方同盟结成（南方视角回顾）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">于是率先重整态势的北方诸国抓住了这个机会，重新挑起了一度偃旗息鼓的战争。；但被怀疑丧失理智的北方诸国在先后向南方宣布敌对之后渐次组成了『北方同盟』这一势力。</data></node>
    <node id="奴隶少女诓骗未遂与两队合流"><data key="name">奴隶少女诓骗未遂与两队合流</data><data key="type">event</data><data key="status">provisional</data><data key="desc">少女颤抖着向我伸出了手，我们两人的手正要重合──；「STO──P！！」；「──就地解散，请不要怂恿涡波先生。」</data></node>
    <node id="南方异变：三骑士成理的盗窃者·圣女诺斯菲登场·孤寄望亡国"><data key="name">南方异变：三骑士成理的盗窃者·圣女诺斯菲登场·孤寄望亡国</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是名为阿雷亚斯、兰斯、赫勒比勒夏因的三名人类男子。；就跟孤当初在北方突然得势一样，那名叫诺斯菲的少女突然间就以救世主的身份显现于世。；无论是曾几何时，天空开始被暗云笼罩这种异常事态发生了也好——、还是本应是『理的盗窃者』的特权的魔法能够被普通人使用了也罢——、不管发生什么，孤一直都作为完美的王，毫不动摇地行动着</data></node>
    <node id="帕林库洛复活阳滝宣言"><data key="name">帕林库洛复活阳滝宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──不过少年也充分战斗过来了。虽然算不上全部，但是我们的愿望也算是有所实现。所以，我也得给少年相应的回礼才可以啊⋯⋯⋯对了⋯⋯⋯──就让你见到『相川阳滝』怎样？」；这是完全超越了死这一救赎的，可谓是实现我夙愿的无上救赎──；是最棒的HappyEnd。</data></node>
    <node id="第二迷宫封锁与达利尔大混乱（过去视所见）"><data key="name">第二迷宫封锁与达利尔大混乱（过去视所见）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">没过多久，『第二迷宫都市达利尔』便被混乱的漩涡所吞没。；幸运的是，炎龙将螺旋阶梯全部熔化时，刚好最后一个探索者逃到了『大洞』之外。真是再差一点就会变成将活人烧成泥水的大惨剧了。；岩浆在她的影响下逐渐冷却，最终生成了一条通往曾经是迷宫入口的道路。</data></node>
    <node id="涡波左臂被余波震断·罗德转入近身捕获"><data key="name">涡波左臂被余波震断·罗德转入近身捕获</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我确实完美地避开了魔弹『重崩色之非风剑』；难道真的仅靠余波就震断了我一根手臂吗。；呋哈哈哈、这样一来近身战就是孤的完胜了！！</data></node>
    <node id="光之御旗支配与莱纳的抗拒"><data key="name">光之御旗支配与莱纳的抗拒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">它要支配的不是『血』而是我自身。；战斗不会孕育出任何好的结果。来吧，先把你手中的剑收起来，让我们谈一谈吧。；跟我谈谈。跟我谈谈。谈一谈、谈一谈谈一谈谈一谈谈一谈谈一谈谈一谈谈一谈⋯⋯──）</data></node>
    <node id="公馆北奇袭·军马强夺（ch144）"><data key="name">公馆北奇袭·军马强夺（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「士兵的数量有二十七人⋯⋯⋯就袭击北面的数人好了。走这边。」；然后，就这样飞跃过北面的栅栏，对着待机的士兵展开了奇袭。；首先，落地的同时拉丝缇娅拉绕到士兵的后面，勒住她的脖子让他昏了过去。</data></node>
    <node id="甲板游泳教学（全员脱沉）"><data key="name">甲板游泳教学（全员脱沉）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">游泳教学进行了大概一个小时左右，我的体力就消耗殆尽了。；不过也多亏了自己如此辛劳，所有人算是都摆脱了进水必沉的状态。；按照预想，后卫二人组要掌握游泳技巧是不太容易的。</data></node>
    <node id="帕林库洛真相宣告与涡波崩溃—再起"><data key="name">帕林库洛真相宣告与涡波崩溃—再起</data><data key="type">event</data><data key="status">provisional</data><data key="desc">恐怕绝对时间连一秒都没过吧。但是，就在这不到一秒的时间里，我的感情彻底反转了。；你一直执着的『相川阳滝』也早就死了，也就是说你至今为止的战斗，全都是没有意义的！；西斯没有错失这个机会，挣脱了我的拘束。</data></node>
    <node id="使徒勒伽西背叛——迷宫完成前夜的背刺"><data key="name">使徒勒伽西背叛——迷宫完成前夜的背刺</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──『诶诶，正如你察觉到的，数年之后，使徒勒伽西背叛，并与涡波战斗了。他用狡猾的手段骗过了存活到最后的缇娅拉和阿尔缇两人，并与涡波决裂』；就这样，在这程记忆之旅的最后。眼看『迷宫』即将完成计划就要启动，涡波却遭到了勒伽西的背刺。；就这样，始祖涡波被逼之下不得不在不完全的状况下实行计划。</data></node>
    <node id="同伴装备委托与新阶层魔石"><data key="name">同伴装备委托与新阶层魔石</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「仔细一想的话，我的同伴、一半都是小孩子的尺寸啊⋯⋯」；「我知道同伴们的衣服尺寸，现在就下单可以吗？希望你能打造些从头到脚都有一定防御力的东西」；当然这件事对反应敏感的塞拉小姐是绝对保密的就是了。</data></node>
    <node id="罗德'修行'致莱纳魔力耗空瘫倒"><data key="name">罗德'修行'致莱纳魔力耗空瘫倒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">映入我眼帘的便是瘫倒在床上的莱纳。明明我才离开这里一个小时，莱纳的魔力就空空如也了。；「诶？就是让他修行地稍微认真了点儿哦？没事的没事的，等明天他就会满血复活的」；莱纳虽然瘫倒在床，但呼吸还是很平稳的。</data></node>
    <node id="北方领土恢复·南北休战成立与'任务终结'之落空"><data key="name">北方领土恢复·南北休战成立与'任务终结'之落空</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[——成功了……！北方的领土，恢复了战前的状况！哈哈、终于全都夺回来了……！！]；北方诸国的国力得到恢复，并在孤的影响下团结在了一起。北与南的势力回到了均衡状态，接下来只剩缔结休战协定就可以了。；——这·样·一·来·孤·的·任·务·终·于·结·束·了。</data></node>
    <node id="海因共赴与记忆走马灯"><data key="name">海因共赴与记忆走马灯</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着，『我的魔力』和『海因的魔力』——『次元属性的魔力』与『从灵魂中泄漏而出的魔力』融合在了一起。</data></node>
    <node id="手环破坏尝试与双拒绝"><data key="name">手环破坏尝试与双拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">换言之，这是无关乎我自己意志的行为，也就是说，有某种东西操弄了我的感情。；就像是在保护比自己的生命还重要的事物一样，擅自行动着。</data></node>
    <node id="围巾约定兑现(织围巾和解)"><data key="name">围巾约定兑现(织围巾和解)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">眼前的状况不禁让我回想起了那曾经的每一天。这三个人曾在一起其乐融融地织过围巾。但如今却可谓时移世易，恐怕三人间的氛围再也不复当初了吧。；看到织好的围巾，莉帕笑了，我也一样。</data></node>
    <node id="六十三层双守护者共斗歼灭PaleGriffin"><data key="name">六十三层双守护者共斗歼灭PaleGriffin</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「正好让我看看你的手腕有没有退步吧。而且我也想活动一下这副变得有些迟钝的身体」；「确实，我居然会跟你肩并肩战斗，这在生前根本就是天方夜谭呢」；「那就让姐姐给你表演一下自己厉害的地方吧！──『AngeloBaïOnnette』！」</data></node>
    <node id="轻量咏唱练习（莱纳成·涡波败）"><data key="name">轻量咏唱练习（莱纳成·涡波败）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接在罗德之后，莱纳也模仿她咏唱起来。；接着，就像咏唱中的台词一样，打造出了一条空气流动的道路。但是从我手中释放出来的却只有次元属性的魔力。因而我没办法操纵这道风。；「看来莱纳这边已经很好地掌握了呢」</data></node>
    <node id="八件泳衣制作完成"><data key="name">八件泳衣制作完成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在太阳西沉之前，总算是成功制成了八件泳衣。；一切都多亏了状态和技能的犯规般的恩惠啊。；不过材料倒是让我烦恼了一下。在我原来世界的服饰知识里，橡胶对于泳衣来说是必要的，但是在异世界里可没有那东西。</data></node>
    <node id="『先谭』再发动·确认亿分之一胜利未来"><data key="name">『先谭』再发动·确认亿分之一胜利未来</data><data key="type">event</data><data key="status">provisional</data><data key="desc">连碰都碰不到罗德便败北的未来──内心彻底屈服于诺斯菲的未来──尽管抵抗的意志尚存，但却被徒刑于地下的未来──莱纳牺牲的未来──四个人同归于尽，佩艾希亚彻底崩壊的未来──；那是不到亿分之一的微小的可能性。；但却是对我稍微温柔了一些的世界。是相川涡波和莱纳・赫勒比勒夏因以『支配之王（罗德）』和『光之御旗（诺斯菲）』为对手，并取得了胜利的世界。</data></node>
    <node id="水晶魔法Quartz护住基督"><data key="name">水晶魔法Quartz护住基督</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——水晶魔法『Quartz』！！」；水晶就像苔藓一样覆盖地面，并裹住了倒在我身后的基督。；艾德的袖中伸出藤蔓打算接触基督，但是却被水晶给挡下了。</data></node>
    <node id="二十二·二十三层突破与制图"><data key="name">二十二·二十三层突破与制图</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这里就是终点了。总之今天的目标算是达成了吧。」</data></node>
    <node id="门戒离船与西娅·勒伽西登场"><data key="name">门戒离船与西娅·勒伽西登场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我的目送下，海莉使用仅有的魔力捏碎了戒指。接着，一连串的魔法构筑便造出了魔法门。；「──姆，姆姆？好奇怪呀⋯⋯」；但是，在我来到他她旁之前，门伴随着挺大的声音打开了。</data></node>
    <node id="涡波胜利宣言与战后崩溃"><data key="name">涡波胜利宣言与战后崩溃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我打倒他了⋯⋯⋯是我赢了⋯⋯，我战胜帕林库洛了⋯⋯！」；「得赶紧带上阳滝和莱纳⋯⋯、离开这里才行⋯⋯」；必须要全部收回作为胜利者的报酬才行。</data></node>
    <node id="涡波的六人集结宣言与二人归船（ch144）"><data key="name">涡波的六人集结宣言与二人归船（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「当然不眠不休的前进我一个人就够了，你们两个先回船上休息。而且，还希望你们向船上的三人说明下理由。」；「不，刚好相反。在和帕林库洛接触前，一定要把六人都叫上。接着。希望在状态万全的六人合力下压制住帕林库洛和使徒西斯。所以，就把我一人的疲劳控制在最小限度就可以了。」；那样只是圣诞祭的晚上的重复。这次像诺文的时候一样全员一起战斗，再一起平安无事的回到联合国。</data></node>
    <node id="LivingLegend号出航与七人甲板誓师(周回二度)"><data key="name">LivingLegend号出航与七人甲板誓师(周回二度)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「名字就叫『LivingLegend号』！」；于是『LivingLegend号』开始缓缓地向着海上进发。；随后，总算推断出了向着瓦尔德本土的航路，使航行稳定下来。</data></node>
    <node id="拉丝缇娅拉情报收集（大圣堂传闻听取）"><data key="name">拉丝缇娅拉情报收集（大圣堂传闻听取）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">您知道方才提到的那位拉丝缇娅拉・弗茨亚茨现在在哪里吗；然后拉丝缇娅拉大人在尽情地体验过外面的世界之后，就接受了自己的使命回到了大圣堂，现在就在致力于完成那份使命；就是拉丝缇娅拉重新回到了弗茨亚茨，甚至与之协作共事这点。</data></node>
    <node id="元夫妻话题挖出与失忆回避"><data key="name">元夫妻话题挖出与失忆回避</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「唔恩，真是好吃啊，诺斯菲！果然是一个好妻子呢！」；但是，这边只好使出完全不记得的话题来做到完美的回避了。；「──A，啊啊，能做出这么好吃的东西一定是一个好妻子不会错呢？Jie，接下来，比起这个！今天也想继续去挑战迷宫呢，莱纳会一起去的对吧！？」</data></node>
    <node id="千年前瘫痪期·与诺斯菲的邂逅(记忆)"><data key="name">千年前瘫痪期·与诺斯菲的邂逅(记忆)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是『始祖涡波』与诺斯菲。；纵使瞳孔连焦点都对不上，但目光彷徨的『始祖涡波』至少还能勉强进食。；「父亲大人……」</data></node>
    <node id="基督人生初次饮酒（麦芽酒）"><data key="name">基督人生初次饮酒（麦芽酒）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">举到我面前的麦芽酒（啤酒）散发着浓浓的麦香。；我紧紧地盯着酒杯看了好几秒。；「虽然我是第一次喝酒，不过感觉还不错啊」</data></node>
    <node id="恋心复归——技能升华后对拉丝缇娅拉的感情回归"><data key="name">恋心复归——技能升华后对拉丝缇娅拉的感情回归</data><data key="type">event</data><data key="status">provisional</data><data key="desc">自己那因空腹而变得羸弱不堪的身体突然涌上一股热意。；在技能『？？？』升华为技能『最深部之誓约者』之后，对她的感情已经重新回到了我的心中。；那毫无疑问是我对她的『恋心』</data></node>
    <node id="闭店时遇露宿兜帽少年"><data key="name">闭店时遇露宿兜帽少年</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「顺带一说我不是女孩子。所以用不着担心。」</data></node>
    <node id="练级实验日"><data key="name">练级实验日</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『经验值的分配始终均等，与级别差无关』『分配的极限距离在一百米左右』</data></node>
    <node id="海莉身世自白"><data key="name">海莉身世自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">制造出我所用的材料，就是海因・赫勒比勒夏因的身体。我是被用于海因・赫勒比勒夏因的『再诞』而制造的存在，但是结果却失败了。；我并非你的同伴海因，而是作为你们的敌人海莉出现在这里。⋯⋯好了那么说明就到此为止。舍此之外已无需多言。快杀了我吧。那样一来一切就结束了；虽然我也有这样的预感，但是当这些话从少女口中亲自道出，预感便转换为了确信。</data></node>
    <node id="帕林库洛之死"><data key="name">帕林库洛之死</data><data key="type">event</data><data key="status">provisional</data><data key="desc">失去了魔石的帕林库洛身体开始溶解。跟海莉和士兵们一样，他的肉体被转化为白色的魔力粒子。即使这样帕林库洛也没有摆出打算停止『世界奉还阵』的样子。看来他那自己也停止不了的说辞并不是谎言。；他还没有放弃战斗。；「永别了，帕林库洛⋯⋯」</data></node>
    <node id="西斯的自白：契约·千年史观·再邀请"><data key="name">西斯的自白：契约·千年史观·再邀请</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──呵呵，有劳你将迪亚波罗酱培育到此等程度。容我道谢，盟友。多亏了你，才终于获得了足以让我显现于这个时代的『魔力』呢」；「纵使你不欲与我相会，我等重逢亦是必然。自盟友向『迪亚波罗・西斯』报上『涡波』之名时起，此间一切已是注定。此即『西斯』与『涡波』订下契约使然。因此，哪怕肉体早已腐朽作灰，则无论既经几世，魂与魂也必将再度联结。不管此间有何等变故，我们终将再会──不可动摇、不可改篡，此乃世界之『理』也」；「你问我、是『谁』吗。果然，连这都不明白吗。⋯⋯啊哈，啊哈哈哈哈哈！果然啊，这也就是说、涡波你失败了啊！怪不得此间你所为之事皆如此谬不可言。竟然做出妨碍缇娅拉，却协助我再临这等荒唐行径，原来是</data></node>
    <node id="始祖涡波退场与阳滝肉身再诞"><data key="name">始祖涡波退场与阳滝肉身再诞</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啧！我明明把自己能收集起来的『毒』全都灌进去了，结果只用那么一颗魔石就给全吸收掉了吗！原本可是想要他维持『怪物』的姿态多肆虐一会儿的啊！」；实力深不可测的『怪物』、也就是『始祖涡波』的退场实在是帮了我一个大忙。；被咒布包裹住身体的阳滝就这样诞生了。</data></node>
    <node id="地下生活方针决定（章题事件）"><data key="name">地下生活方针决定（章题事件）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那当然没问题啦。不如说人家正希望你们那么做呀。毕竟你们两个能永远住在这里才是最棒的嘛」；「OK～。那么涡涡就去贝丝酱的家里工作，莱纳则要跟着人家干活喽」；距我苏醒以来，应该已经过去了很长的时间。然而，天空却跟我醒来时一样昏暗。漫步于不知是昼是夜的街道，我们就这样暂且返回了『魔王城』</data></node>
    <node id="斐勒卢托的鸿门宴招待"><data key="name">斐勒卢托的鸿门宴招待</data><data key="type">event</data><data key="status">provisional</data><data key="desc">撤销了弗茨亚茨对您的追捕命令的人就是我；而且拿来款待我们的这些东西也不知道里面加了些什么，根本无从下手。；此时大量骑士陆陆续续地集结到两侧的房间中。在谈话的过程中我们正逐渐被包围着。</data></node>
    <node id="玛利亚夜访与和解"><data key="name">玛利亚夜访与和解</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[涡波先生……，你现在方便吗？]；[那一天，我背叛了涡波先生。恩将仇报，甚至要夺走涡波先生的性命……]；[……我已经失去《眼睛》了。所以，我已经无法明白涡波先生是否在说谎了。我只能相信你了]</data></node>
    <node id="冒险者领队砍伤主角并以其为饵"><data key="name">冒险者领队砍伤主角并以其为饵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这里可是迷宫，而且还是在『管理领域之外』的地方。你应该有所觉悟了吧，小鬼。」；「很好，就是这个位置！攻击！把路堵死！！」</data></node>
    <node id="罗德・缇缇入队与最后的迷宫探索"><data key="name">罗德・缇缇入队与最后的迷宫探索</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「队伍」；罗德・缇缇加入了队伍。；『表示』上跳出的这个显示，意味着我们在这个地下的战斗全部都得到了回报。</data></node>
    <node id="斯诺与莉帕甲板宝石嬉戏：斯诺炼金无敌宣言"><data key="name">斯诺与莉帕甲板宝石嬉戏：斯诺炼金无敌宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">闪闪发光耶！这些全都是宝石吗！？；有这个力量的话，简直无敌。以后再也不用为钱发愁了。；我、我刚才什么的没说哦⋯⋯？</data></node>
    <node id="舞斗大会首日三轮"><data key="name">舞斗大会首日三轮</data><data key="type">event</data><data key="status">provisional</data><data key="desc">其实答案很简单。诺文单纯是用『魔力物质化』将刀刃附加于小树枝上，然后轻轻一挥横扫了整·个·竞·技·场。；『次元之冬』无法干涉写在魔法道具之中的已经完成的魔法。</data></node>
    <node id="海因最期（瓦尔德郊外）"><data key="name">海因最期（瓦尔德郊外）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，骑士海因这枚棋子倒下了。</data></node>
    <node id="赴豪宅途中骑士追捕"><data key="name">赴豪宅途中骑士追捕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">时间拖得越久，敌人增加的越多。；我必须趁早与莱纳和雷纳尔多汇合，然后和他们一起逃到迷宫里去。；我终于抵达了作为目的地的豪宅。</data></node>
    <node id="诺文魔石宝石变现委托（史诗探索者受理）"><data key="name">诺文魔石宝石变现委托（史诗探索者受理）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「使用诺文的魔石的力量，可以随意量产这样的优质矿石。你有把这些变现的办法吗？可以的话，我希望能以『史诗探索者』为中介，向大型机关变现⋯⋯」；「我知道了，要把这些宝石变现是吗。没关系，我来帮你。这单子『史诗探索者』接了。既然是斯诺粉丝应援会名誉会长暨妹夫同志的要求，我就没有拒绝的理由了」；「──哟西，清点结束。我会负起责任把这些都换成现金的。毕竟是为了未来的义弟嘛！」</data></node>
    <node id="少年之旅与泪洸之夜"><data key="name">少年之旅与泪洸之夜</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我决心以一个少年而非使徒西斯的身份开始一段冒险。；我遇到了那个脸上有火伤痕迹的黑发黑目的少年。</data></node>
    <node id="斯诺监听宣战与取下计划"><data key="name">斯诺监听宣战与取下计划</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「有·斯·诺·在·啊。我想，此时此刻，就连这个瞬间，我们的对话也一定都被斯诺听到了啊。」；『……莱文教的现人神。我要超越你。』</data></node>
    <node id="次元之戒诞生（空白之戒充能·名变）"><data key="name">次元之戒诞生（空白之戒充能·名变）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">大概过了四五十分钟后，一个魔法戒指便完成了。；仅仅如此，戒指的名字就改变了。；「次元之戒」</data></node>
    <node id="涡波自认失忆期喜欢过帕林库洛"><data key="name">涡波自认失忆期喜欢过帕林库洛</data><data key="type">event</data><data key="status">provisional</data><data key="desc">如果是，在圣诞祭那天，帕林库洛没有背叛，而是与我一起攻略迷宫的话──就那样在一起度过一段年月，我应该也会说出跟格连一样的话。；毕竟失去记忆时的我，是喜欢他这个人的。；我确确实实，曾经喜欢过他这个人⋯⋯⋯</data></node>
    <node id="致亲爱的一闪·断臂"><data key="name">致亲爱的一闪·断臂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『至亲之友、在此作别』。『被世界拒绝的剑啊』『由我们来继承』──！！」；「这就是，赌上我们全力的、最后的一击啊啊啊啊！──魔法『致亲爱的一闪』！！！！！！！」；诺斯菲的左臂从肩口开始被整个斩飞。</data></node>
    <node id="艾德的再临誓愿宣言与愿望互换"><data key="name">艾德的再临誓愿宣言与愿望互换</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「但是这并不意味着鄙人放弃了哦。鄙人的战斗，这次依然要继续。这一次绝对要扫清千年前的遗憾！鄙人要、鄙人要──」；「──鄙人要再次打造一个王国，等待『支配之王（Lord/罗德）』的再临。她必将于不远的将来从『那里』脱身吧。而这一次，胜利将紧握于『支配之王』手中。势必要经由我们的双手，为大陆带来和平与安宁──！没错，因为这才是王的心愿，亦是鄙人的心愿──！！」；「⋯⋯因为我是个探索者，所以想要前往迷宫的最深部」</data></node>
    <node id="次元魔术传授限定与藏书室钥匙取得"><data key="name">次元魔术传授限定与藏书室钥匙取得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">看来就连擅长魔法的罗德都没办法将上位的次元魔术传授给我。；「嗯～，城内的藏书室里应该有吧。对现在的涡涡来说，直接读千年前的魔导书的确是最好的办法。啊，那藏书室的入场费就收你十枚铜币好了呢！」；「这、这就是藏书室的钥匙、请您笑纳」</data></node>
    <node id="艾尔芬里斯讨伐（第二次屠龙）"><data key="name">艾尔芬里斯讨伐（第二次屠龙）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">使用『Default』缩短空间的距离，乘到艾尔芬里斯的背上。之后直接用『DistanceMute』拔除『魔石』。就这么简单。；我攥住艾尔芬里斯的魔石──并篡夺、拔除之。；仅仅一头艾尔芬里斯的消亡，就造就了泪洸（TearRay）的天候。级别达到60的怪物魔力密度有多高一目了然。</data></node>
    <node id="缇缇的告别与弃王宣言"><data key="name">缇缇的告别与弃王宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在这光粒仅剩无多的草原之上，诺斯菲追问到。；「⋯⋯诺斯菲，对不起。人家已经决定要回到弟弟所在的地方了。接着，告诉他人家已经不想再当什么王了。──那样就结束了。一切都结束了。在那以上的任何东西人家都不需要了，人家已经想起来了啊。」；「嗯。因为人家正是为了扫清心中的后悔而启程的⋯⋯」</data></node>
    <node id="失忆期与缇亚的约会（回忆）"><data key="name">失忆期与缇亚的约会（回忆）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">失去了记忆时的我曾跟缇亚约会过。；穿着可爱的衣服，缇亚就像一个女孩子一样开心地笑着。一起看戏剧，一起吃晚饭，但是在那期间，她没有一刻放开过我的手。</data></node>
    <node id="缇亚的动机自白"><data key="name">缇亚的动机自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">名为缇亚的少年才终于能作为缇亚活下去。</data></node>
    <node id="夺回缇亚之战的作战会议"><data key="name">夺回缇亚之战的作战会议</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没什么时间了我简单地说一下。最重要的不是打倒帕林库洛，而是夺回缇亚。这一点绝对不要搞错了」；「首先，捕获缇亚的任务由我和玛利亚负责。不管使徒西斯想说什么，总之先让她失去意识丢回船上去」；「在我们捕获西斯期间，希望你们四个能拖住帕林库洛和守护者艾德。我们跟艾德姑且还不是敌对关系，先瞪着他给他牵制住就好」</data></node>
    <node id="莱纳装备检查·自杀式道具判明"><data key="name">莱纳装备检查·自杀式道具判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「用于魔力增幅的戒指和魔力爆发用的戒指⋯⋯⋯这个则是用来强制加速的⋯⋯？不管怎么看，这小子的想法都危险得不得了啊⋯⋯」；「这小子根本就没想着活着回来。这些装备全都是为了跟敌人同归于尽而准备的」；在精通武器装备的雷纳尔多眼中看来，这些似乎全都是用于自杀式袭击的道具。</data></node>
    <node id="瞭望台真相揭示——魔王城与66层背面"><data key="name">瞭望台真相揭示——魔王城与66层背面</data><data key="type">event</data><data key="status">provisional</data><data key="desc">位于城堡的最上层的了望台。；从城堡顶部往下望去，能清楚的理解『这里』的全貌。这座古堡的外貌呈圆锥状，里面有着森林一般广大的庭院。；平原啊，海啊，之类的什么也不存在，有的只是一片虚无。因为这一点，看起来就像是这座城堡和整座城市正在一片黑暗中漂浮一样。</data></node>
    <node id="斯诺与缇缇初会·义姐妹成立"><data key="name">斯诺与缇缇初会·义姐妹成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「你、你好。我是斯诺。请多关照。⋯⋯总感觉这个情节之前也有过一次来着」；「看来你也跟诺文一样呢」；和以前不同，这一次，斯诺在行过一礼后向作为守护者的缇缇伸出了手。</data></node>
    <node id="酒馆后方决斗开始"><data key="name">酒馆后方决斗开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">最后，在互相对着『魔石线』起誓后，我们同时拔剑出鞘。；「——魔法『Dimension·决战演算』、魔法『Foam』。」</data></node>
    <node id="艾德接引提案与罗德的激烈拒绝"><data key="name">艾德接引提案与罗德的激烈拒绝</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「住手，涡涡。唯有这件事绝对不行」；「因为，如果现在和艾德见面的话，那人家又非得摆出完美的王的做派不可！花费了一千年的时间，好不容易才让作为『支配之王』的人家成为了过去！事到如今岂能再恢复原状！！」；伴随着Baki的声音玉座的顶端部分被捏碎了。然而罗德并不在乎，她继续喊道。</data></node>
    <node id="涡波对诺瓦露之战（魔人化vs千算相杀）"><data key="name">涡波对诺瓦露之战（魔人化vs千算相杀）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『Growth』！！『CureRegeneration』！！」；这次只要我一个人就够了！就让你看看跟一年前的不同之处吧、英雄大人！──『Gravity・Greed』！！；缇缇用风保护着附近的帐篷和建筑物，露洁则操纵周围的树木守护自己和其余的同伴。</data></node>
    <node id="诺瓦露魔人化现身与宣战"><data key="name">诺瓦露魔人化现身与宣战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──好久不见了，劳拉维亚帅气的英雄大人。⋯⋯你还记得我是谁吗？；名字：布蕾娅斯HP156／156职业：圣人；「不，我记得啊。你不就是一年前在『柯尔库』和我战斗过的诺瓦露么⋯⋯」</data></node>
    <node id="始祖记忆复苏之梦(罗德→诺斯菲)"><data key="name">始祖记忆复苏之梦(罗德→诺斯菲)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为使徒勒伽西而没能继承的『始祖涡波』的记忆的碎片纷纷复苏。毋庸置疑，随着蕴藏在身的『魔之毒』不断增加，我的记忆也会逐渐修复。；——与罗德相遇的记忆。；射入水中的光越来越多。可以预料到，在光填满这水中世界的时候，我的梦便会宣告结束。</data></node>
    <node id="涡波与斯诺的一年经历交换"><data key="name">涡波与斯诺的一年经历交换</data><data key="type">event</data><data key="status">provisional</data><data key="desc">首先是在一年前和帕林库洛的决战告终之后，我坠入了迷宫深处这件事。；在与我分别之后，她代替我力求将队伍带领好的事。以及向艾德和使徒发起挑战，结果连战连败的事。；因为我相信涡波一定会回来的⋯⋯</data></node>
    <node id="黑暗反省会与誓言"><data key="name">黑暗反省会与誓言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">———并·且，只·要·这·份·誓·言·尚·在，这·个·故·事·就·不·会·迎·来·终·结。</data></node>
    <node id="技能『？？？』发动（游泳日当日回顾）"><data key="name">技能『？？？』发动（游泳日当日回顾）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">也一点点地失去了之前的从容。；一时疏忽缩短了自己与拉丝缇娅拉的距离，结果却一口气拉远了太多。居然发动了技能『？？？』实在是最大的失误。；祸不单行地加上了海莉的登场。她的存在无时无刻不骚动着我的内心。海莉的出身、性格、思想这些所有的一切，都给我施加着压力。</data></node>
    <node id="第三次迷宫探索出发（四人新队伍）"><data key="name">第三次迷宫探索出发（四人新队伍）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">可是，这样子队伍就有四个人了哪。；而且还有两名守护者。从探索迷宫的战力来考虑，是迄今为止最高的队伍了呢。；今天是地下生活的第五天──第三次挑战迷宫。</data></node>
    <node id="风之臂显现与诺斯菲束缚解脱"><data key="name">风之臂显现与诺斯菲束缚解脱</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──我从来不曾向这个世界祈乞过、一次都没有！！」；就在我如此痛斥之时，一道强风自我体内席卷而出。；见到长棍的前端被这道风抵回，诺斯菲首次露出了疑惑不解的表情。</data></node>
    <node id="魔剑强化完工（工房第三日收官）"><data key="name">魔剑强化完工（工房第三日收官）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">现在这把剑既具有对风属性的抗性，同时还可以减轻使用风魔法时的负担。对要以艾尔芬里斯为对手战斗的风魔法使而言，可谓再合适不过的武器。；六十六层的侦查也完毕──不如说，已经打倒了艾尔芬里斯一次，还将它的魔石拿去强化莱纳的剑了。可以说万无一失。；以及通过神铁锻冶的修复获得再生的千年前的轻盔和胸甲。</data></node>
    <node id="五十五层SkyRunner奇袭战"><data key="name">五十五层SkyRunner奇袭战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们从SkyRunner的死角发动袭击。；最初的一击──莱纳的双剑与SkyRunner的钩爪相咬合，双方被弹向后方。接着，是第二次的交锋。看到莱纳和SkyRunner同时突进后我发动了无咏唱的魔法。；把那个情报元，真的是很轻微──用『维度・决战演算』更改两者的攻击轨道。恐怕，仅偏离了连一厘米都没有的距离。但是却得到了巨大的收益。</data></node>
    <node id="古奈尔木桶登场与失态否认"><data key="name">古奈尔木桶登场与失态否认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「其实除了芙洛拉殿下之外，还有一位王族在这艘船上的⋯⋯」；接着，随着木桶盖被掀开，一名身材纤细的少女从里面钻了出来。；最先映入我眼中的，是一直留到少女腰际的黑色长发以及穿在她身上的『和服』</data></node>
    <node id="涡波拒绝救济之手与诀别"><data key="name">涡波拒绝救济之手与诀别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我终于还是没有牵起帕林库洛向我伸出的救济之手。；人活着就是一件痛苦而艰辛的事情啊，帕林库洛；驱使着站都站不稳的身体，我再次对帕林库洛引剑相向。</data></node>
    <node id="35层水下探索（首度突入·至36层阶梯）"><data key="name">35层水下探索（首度突入·至36层阶梯）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好了，那今天我就和斯诺和莉帕还有缇亚四个人去一趟」；跟昨天交战的伽鲁夫纳多杰里的眷属们不同，是跟鲟鱼一样扁平的鱼。但是身体两侧却像刀刃一样锐利。一旦遭到直击，估计身体会被漂亮的切成两段吧。；接着我轻而易举地用剑斩杀了行动迟钝的四匹敌人。</data></node>
    <node id="二重奏剑宣言与四剑四重攻势"><data key="name">二重奏剑宣言与四剑四重攻势</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──我要上了，『光之理的盗窃者』。这便是我真正的共鸣魔法、『血与魂的共鸣』『将世界斩裂的生命之双剑』！其名为──『赫勒比勒夏因・二重奏剑』！！」；──在双重击出的魔法之上，再辅以双重的魔法。；『赫勒比勒夏因之神圣双剑』释放的第三和第四道魔法是无法被我用魔法予以『相杀』的。</data></node>
    <node id="草原化绝壁·坠入奈落之底·百年寻宝不得"><data key="name">草原化绝壁·坠入奈落之底·百年寻宝不得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而到这个时候，这片草原也已经化作了名副其实的坡道。；最终坡道化作了一道绝壁，而我就在上面向下坠落、坠落──然后狠狠地撞到了奈落之底，我就那样连打了好几个滚。；我最终坠落的地方，是一个前后左右都被石壁包围起来的洞穴。</data></node>
    <node id="组队连捷与MP管理"><data key="name">组队连捷与MP管理</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在打倒了约三十匹怪物的时候，我的MP终于所剩不多。</data></node>
    <node id="正道工事与怪物群危机接管"><data key="name">正道工事与怪物群危机接管</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「说来很简单，就是经由劳拉维亚之手，对数日前变为普通房间的迷宫第十层和第二十层的『正道』进行整备。」；「太好了，谁都没有死……」</data></node>
    <node id="海因与素体初遇"><data key="name">海因与素体初遇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">十八岁那年，在刚被拔擢为『天上之七骑士』后没过多久，我与大小姐邂逅了。</data></node>
    <node id="兑换所变现与情报收集"><data key="name">兑换所变现与情报收集</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——总计入手了差不多百枚铜币和十枚银币。</data></node>
    <node id="深层'某人'推测与34层进发"><data key="name">深层'某人'推测与34层进发</data><data key="type">event</data><data key="status">provisional</data><data key="desc">30层之外，在联合国内不管是怎样的探索者都不曾涉足。所以我们之前才能随心所欲地寻找那些保存完好的祭坛。；也就是说，现在在这个迷宫深处还存在着某个人。比我们更早地来到33层，从祭坛取走了剑的『某人』──；剩下的就是剑圣芬里尔和『天上的七骑士』队伍了。</data></node>
    <node id="决斗开幕：帕林库洛重创与半死体化自刎"><data key="name">决斗开幕：帕林库洛重创与半死体化自刎</data><data key="type">event</data><data key="status">provisional</data><data key="desc">帕林库洛轻轻一跳。；反手一记横斩，水晶之间划过了帕林库洛的双眼，夺去了他的光明。；「不，还没完。我还没完。接下来是『半死体』化」</data></node>
    <node id="速归地上方针确立与『连接』轮休制"><data key="name">速归地上方针确立与『连接』轮休制</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「今天，在城里来回游走，想着做些填补⋯⋯但，已经是极限了。和两人的谈话确信了这点。罗德无论何时崩溃都不奇怪，诺斯费也是感觉到了和以往的气氛不太一样。可能，没有多少时间了」；「还有，还好好的计算过时间了哦。我已经完全的记住了四十层左右的路实际还剩下的层数只有16层而已。那么，这十六层一层要两小时来考虑，必要的时间是三十二个小时。接着，知道路的四十层毫不浪费的前进的话我想只要二十小时，合计的话⋯⋯」；「恩──简单地说，只要两天不眠不休的进发的话就能结束啦」</data></node>
    <node id="杂货铺兽人女店主之死确认"><data key="name">杂货铺兽人女店主之死确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">整个店铺都被破壊殆尽。货架被破壊，商品散落一地到处都是剑痕──而且在店的另一头还有一具尸 体。；死者是一个被拦腰斩断的兽人女性。；「这个人，在这个时间轴上已经死了啊」</data></node>
    <node id="帕林库洛败北·维斯牺牲(涡波回想补录)"><data key="name">帕林库洛败北·维斯牺牲(涡波回想补录)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">得到『暗之理的盗窃者』的力量，发动了千年前的『世界奉还阵』的帕林库洛俨然成为了我最糟糕的敌人。；最后维斯牺牲，我与莱纳联手终于得以战胜仇敌。；我的记忆就在这里断片，接着一觉睡醒发现自己置身于一座陌生的城堡。</data></node>
    <node id="诺斯菲留恋部分解消（魔力衰减·身体稀薄）"><data key="name">诺斯菲留恋部分解消（魔力衰减·身体稀薄）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">她的魔力正以肉眼可见的速度衰减着。；她的存在淡薄到几乎要从世界上彻底消失一般⋯⋯⋯；「诶⋯⋯，身、身体变稀薄了⋯⋯？这个是、留恋的解消⋯⋯？」</data></node>
    <node id="水攻与《冻结》击杀黑环萤"><data key="name">水攻与《冻结》击杀黑环萤</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】黑环萤：位阶2</data></node>
    <node id="千年监禁·深渊崩溃至发笑"><data key="name">千年监禁·深渊崩溃至发笑</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样──过去了一・千・年。；这奈落之底──这既不许生亦不许死的黑暗『地狱』，就是我的世界。；在此地狱之中，一个空有长大的身体却内心脆弱的孩子，一边说着不要这样一边哭着。</data></node>
    <node id="次元戒指破碎·圣双剑片翼备齐"><data key="name">次元戒指破碎·圣双剑片翼备齐</data><data key="type">event</data><data key="status">provisional</data><data key="desc">紧接着，就像是证明这点一般，基督赠给我的『次元戒指』突然破碎。；「怎么可能⋯⋯⋯你为何会、使用次元魔术⋯⋯？」；自我的肩膀处伸出的风之臂将一把剑从『什么也没有的空间』中拔出。</data></node>
    <node id="赛后大混乱与魔石争夺"><data key="name">赛后大混乱与魔石争夺</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——果然，不管是怎样的权力机关，在这『瓦尔法拉』之内都不好使！警备兵的诸位请逮捕少年骑士！还有要搞事的人也一并抓起来！！」；「啧，『天上之七骑士』也混进来了吗……！」</data></node>
    <node id="海莉恶化发作与守护者的治疗"><data key="name">海莉恶化发作与守护者的治疗</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「咕、呜呜──，所以少年，你听我说──，你不能变得跟我──！！」；「不、不好了不好了啊！这是又恶化了啊！应该早点把艾德老师叫来的！」；莱纳的光包裹住海莉的身体。但是，莱纳的魔法却遭到其他魔法的从旁干涉。</data></node>
    <node id="船队遇袭发现与援助决断"><data key="name">船队遇袭发现与援助决断</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们发现有一支船队正遭受怪物的袭击，于是缇缇立马斗志昂扬地表示说要去助他们一臂之力。我也没有理由反对她的提议，于是我们就挑起了与在怪物群中相当于BOSS地位的怪物的战斗。；我的『维度』把握到了在远处遭受袭击的船队光是以XiphiasSpear的眷属为对手就陷入了无法行动的窘境。；所以正如缇缇所说，即使多少有些勉强也得将它打倒。</data></node>
    <node id="『维度・决战演算』抵达新领域"><data key="name">『维度・决战演算』抵达新领域</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『维度・决战演算』！！」；『维度』将逼近眼前的无数绿点转化为信息送给大脑处理，这几乎让我的大脑因运转过热而沸腾。；将魔力注入『维度・决战演算』之中，把思考和感知能力磨练到极限，延长我的体感时间。</data></node>
    <node id="南北总体战爆发（上万大军会战）"><data key="name">南北总体战爆发（上万大军会战）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">原本分散着部队被整合到一起，南北双方都组织了上万的大军。；两军相接之前，箭雨和魔法便夺去了无数的生命；而身为南军将领的帕林库洛也不出所料地在指挥着部队。</data></node>
    <node id="罗德破窗闯入与住宿费谈判"><data key="name">罗德破窗闯入与住宿费谈判</data><data key="type">event</data><data key="status">provisional</data><data key="desc">伴随着咣啷一声，窗户被推开，罗德飞进了房内。被她抱在腰边的莱纳则是一脸深感抱歉的表情，于是我就明白罗德是不顾莱纳的制止带着他强行冲过来的。；「诶、那个，减少一半怎么样？」</data></node>
    <node id="别墅会合与海莉的警告"><data key="name">别墅会合与海莉的警告</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「虽然如果能一直维持现在这样抵达最深部就好了。但是这一定只是虚幻缥缈的梦吧。我虽然想去相信。但是你们两人已经、变得跟我一样了。跟我一样——然后——」；莱纳的光包裹住海莉的身体。但是，莱纳的魔法却遭到其他魔法的从旁干涉。；「已经来了。治疗的问题就请交给鄙人吧，莱纳大人。」</data></node>
    <node id="涡波苏醒于无名古堡（战后）"><data key="name">涡波苏醒于无名古堡（战后）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──从梦中清醒了过来。；只有一张床的单调摆设，充满霉味的石造空间。没有任何其他人或者是生物存在的迹象。；然后，在莱纳和海莉的帮助下，应该已经完美的达到了复仇的目的才对。</data></node>
    <node id="罗德家人宣言与宠弟作战"><data key="name">罗德家人宣言与宠弟作战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">既然这样，那干脆就从朋友关系飞跃到家人好了！；「这座城堡就跟孤儿院差不多喽！从今天起大家都是家人了哟！」；「好滴。那么哥哥我也来喂你饼干吃吧」</data></node>
    <node id="雷纳尔多的临别送行"><data key="name">雷纳尔多的临别送行</data><data key="type">event</data><data key="status">provisional</data><data key="desc">啊啊，当然了，而且是以最理想的形式啊。都到了让老朽不知道该说些什么感谢你的地步了；很漫长吗……？；不过，总算是有人来接你了啊……这一刻，已经等了一千年了……</data></node>
    <node id="锻冶速习与戒指『晶盾』打造"><data key="name">锻冶速习与戒指『晶盾』打造</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——『Dimension·多重展开』。」；检查了一下自己的状态栏，看到上面确实多了『锻冶』这一项。；「我是专门搞魔法道具的，所以教授你这方面的知识也最容易……好嘞，搞一发怎么样？形状要做个怎样的？手环这样的饰品随便挑，项链呀发夹之类的也都没问题。」</data></node>
    <node id="35层阶梯海莉遭遇战"><data key="name">35层阶梯海莉遭遇战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">出现在面前的一名未曾见过的女孩子。；使用『阿雷亚斯家的宝剑诺文』接下双剑的攻击，我开始探查少女剑术的本源。这种似曾相识的战斗方式，毫无疑问是赫勒比勒夏因家的剑术。；「你了解得真清楚呢，少年……！但是，你猜错了！——『Dimension』！」</data></node>
    <node id="玛利亚赤瞳看破与涡波的争吵"><data key="name">玛利亚赤瞳看破与涡波的争吵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">当我即将要透露出自己追帕林库洛一直到这里的目的时──却被玛利亚给打断了。；不对，是・你・想被帕林库洛・勒伽西所救、对吗？；「你根本不是为了阻止『世界奉还阵』才来这里的，反倒是──」</data></node>
    <node id="孤儿院反乱·王都夺还作战（英雄谭第二章真貌）"><data key="name">孤儿院反乱·王都夺还作战（英雄谭第二章真貌）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[孤之名为『支配之王（lord）』、罗德。希望能向诸位借一份力]；[艾德你们这边的话，就去把现在变成俘虏的沃尔斯将军他们解救出来吧。；这道风，是所有北方的魔人期望的【自由之风】！是将南方的侵略者驱逐殆尽的希望之风！！『Sehr·Wind』——！！！！</data></node>
    <node id="缇缇×莱纳劝酒攻防"><data key="name">缇缇×莱纳劝酒攻防</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊！你这家伙、放开我！要是他耍酒疯的话你去制服！？说什么胡话，你难道想在这里重现六十六层的大战不成！？」；「姆！？姆姆姆？确实，跟以前比起来对酒的分解速度变慢了⋯⋯？是因为六十六层的战斗过后，守护者的力量减弱的原因⋯⋯？」；说着莱纳向日樱小姐点了杯水。不过理所当然的，缇缇并不会放过他。</data></node>
    <node id="技能？？？连环暴走与退还"><data key="name">技能？？？连环暴走与退还</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——一·切·都·被·退·还·了·回·来。</data></node>
    <node id="一年后重返地面·弗茨亚茨再访"><data key="name">一年后重返地面·弗茨亚茨再访</data><data key="type">event</data><data key="status">provisional</data><data key="desc">第二天──回到久违的地面的我们漂亮地睡到了正午。；一小时不到我们就到达了弗茨亚茨；我们不在的这一年里，说不定⋯⋯是那家伙──</data></node>
    <node id="『注视』对人与技能常识观察"><data key="name">『注视』对人与技能常识观察</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一般来说一个人的技能也就一两个而已。</data></node>
    <node id="佩艾希亚再现时间轴切换为『北之大帝国』"><data key="name">佩艾希亚再现时间轴切换为『北之大帝国』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">城市的规模相较之前扩展到了令人难以置信的程度。；现在存在于『这里』的，是在战争中扩大了领土，而且正处于战争之中的『北之大帝国』；在结界方面的专家诺斯菲的帮助下，『这里』现在是以孤的记忆为基点对环境进行再现的</data></node>
    <node id="罗德诺斯菲毁门夹击与背靠背对峙"><data key="name">罗德诺斯菲毁门夹击与背靠背对峙</data><data key="type">event</data><data key="status">provisional</data><data key="desc">逃跑必经的门被破壊之后，意味着我们被封死在了这个空间之内。；这两人正是千年前『北』与『南』的最强战力。；「──骑士莱纳。我命你接下来将诺斯菲彻底压制住，直到我与罗德的谈话（战斗）结束为止。</data></node>
    <node id="柯尔库港驻港手续（克洛伊斡旋）"><data key="name">柯尔库港驻港手续（克洛伊斡旋）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">抵达了坐落于本土东端的柯尔库港之后，我们立刻前往办理『LivingLegend号』的驻港手续。；结束了手续的办理，我们纷纷下了船照各自原本的目的行动了起来。</data></node>
    <node id="血刻咏唱解明与斐勒卢托自白"><data key="name">血刻咏唱解明与斐勒卢托自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一边持续释放着这等水平的魔力，MP却・完・全・没・有・变・动。；──恐怕这些少女的血中刻有咒术『咏唱』的语句。；甚至超越了拉丝缇娅拉大人的水平</data></node>
    <node id="缇亚的告别与玛利亚的处决之约"><data key="name">缇亚的告别与玛利亚的处决之约</data><data key="type">event</data><data key="status">provisional</data><data key="desc">出现在我眼前的，是充斥于整间屋子的羽毛形状的魔力粒子，还有一对耀眼的白色羽翼。；「不是啊，涡波⋯⋯⋯这是、这是更早之前就已经开始的东西⋯⋯⋯所以说，已经迟了啊──」；「如果『缇亚』完全消失了的话⋯⋯到那个时候，玛利亚、你要将我给⋯⋯」</data></node>
    <node id="女性化指摘与剪发（女装提案拒绝）"><data key="name">女性化指摘与剪发（女装提案拒绝）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不知不觉间感觉你身上女性的氛围越来越浓了啊；还以为叫醒的我是个不认识的女人呢；一旦我的『魂』本身也对女性身体予以了认可的话，那『身体』的性状向那边进行变化的可能性也不是没有。</data></node>
    <node id="拉丝缇娅拉强行参战与追击出发"><data key="name">拉丝缇娅拉强行参战与追击出发</data><data key="type">event</data><data key="status">provisional</data><data key="desc">请冷静一下！涡波先生！就这样放着拉丝缇娅拉小姐不管了吗；庆幸的是，我了解西斯的目的地，还有回收拉丝缇娅拉的余裕。；但是，拉丝缇娅拉也想我靠近，抓住了我的肩膀『连接』的构建中断了。</data></node>
    <node id="七人大逃亡(Connection 闭幕)"><data key="name">七人大逃亡(Connection 闭幕)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我、莉帕、拉丝缇娅拉、缇亚、玛利亚、斯诺、塞拉七人就这样从大剧场船『瓦尔法拉』消失了。；「莱纳！我们要去追帕林库洛！如果你也想要为兄长报仇的话，就追着我们去『本土』吧！在那里给一起做个了结！！」</data></node>
    <node id="一年后再会（我回来了/欢迎回来）"><data key="name">一年后再会（我回来了/欢迎回来）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「欢迎回来，涡波。真是好久不见了」；「嗯～。准确的场所虽然不知道，但我还是能确信你一定活在某个地方。毕竟是涡波嘛」；在『表示』的『状态』中也没有任何异常。再将我拥有的各项有关技能全部动员，也没看出她在说谎。</data></node>
    <node id="艾德战后现身独白与魔石回收企图"><data key="name">艾德战后现身独白与魔石回收企图</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「……呵呵，想不到计划进展的居然如此顺利。」；「这样一来棋子就集齐了！而且还是不亚于千年前的阵容！这样终于——」；再这样下去的话，王之器就危险了</data></node>
    <node id="水晶玉封存与坠入大陆底部（世界奉还阵之战终结）"><data key="name">水晶玉封存与坠入大陆底部（世界奉还阵之战终结）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那场战斗之后，精疲力尽的我们被『世界奉还阵』吞没了。当时我借助基督的剑……也就是诺文的力量，用他的水晶保护了我们两个人的身体，结果虽然免于被溶解，但还是掉到了大陆的深处。也就是『这里』、这所谓的『迷宫里侧』。」；「呼~，那也没办法嘛，就算是人家，想要把你们和那坚硬的水晶完美地分离开来也要费上好一番功夫哦。是因为水晶太硬了哦？不是人家的错哦？」</data></node>
    <node id="别墅初战：涡波玛利亚vs西斯，西斯脱走"><data key="name">别墅初战：涡波玛利亚vs西斯，西斯脱走</data><data key="type">event</data><data key="status">provisional</data><data key="desc">要知道『阿雷亚斯家的宝剑诺文』就连迷宫深层的水晶都能轻易斩裂；「——『FlameArrow』！」；「——魔法『冰结剑（IceFlamberge）』！」</data></node>
    <node id="船队甲板茶会招待与同船提案"><data key="name">船队甲板茶会招待与同船提案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在军舰重重保护下的客船甲板上，按照贵族公馆的样式准备好了桌椅，招待我们的茶会就在这里举办。与我们一同出席的，首先是作为船队最高负责人的克洛伊小姐──；再加上帮助自己的人是那个『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』的话，正好可以借这个机会搞好关系，以便日后能有个照应。；「克洛伊。方才袭来的怪物阵仗远远超过了我们的料想。陷入苦战绝非你的过错」</data></node>
    <node id="涡波的拒绝（心上人优先的抉择）"><data key="name">涡波的拒绝（心上人优先的抉择）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">首先是妹妹阳滝──接着是缇亚、玛利亚、斯诺、莉帕、塞拉、在异世界关照过我的那些恩人们──最后则是、拉丝缇娅拉──；理由再简单不过了。因为我早已有了心上人。仅此而已。；「不、不行⋯⋯⋯唯有这件事我做不到、绝对不行⋯⋯！」</data></node>
    <node id="艾米丽咏唱被阻与境遇自白"><data key="name">艾米丽咏唱被阻与境遇自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『炽烈之炎，熔断前敌』『我自衔尾，逡巡蹒跚，如梦似幻』──」；「这、这咏唱是──！──『维度・千算相杀』！！」；「就算你这么问、只是因为这一年来支付『代价』的『咏唱』已经成为了世界的一般常识了呀。我想但凡是使用魔法的人基本都知道的⋯⋯」</data></node>
    <node id="艾德（白樱传声）对始祖涡波的怒斥与讨伐宣言"><data key="name">艾德（白樱传声）对始祖涡波的怒斥与讨伐宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">负责传递艾德声音的『白樱』颤悚着，只见树叶和白花纷扬而下。接着便是一道仿佛呕出鲜血的怒吼盈满了『第二迷宫都市达利尔』；（涡波大人──不、你这可憎的始祖！始祖涡波！！）；千年前，就因为你的错，北方的黎民百姓尽皆惨遭戮杀！你不仅不愿悔改，甚至还要再来一次吗！</data></node>
    <node id="艾德的鉴定与两队分离"><data key="name">艾德的鉴定与两队分离</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——虽然不是很擅长，但是也只得一用了啊。咒·术『注视鉴定』。」；「虽说是光辉照人的原石，但是这样是没法做『后备之王』的。实在是太过扭曲了……要说有这个资格的，就只有这位盲眼的少女而已了吗——」；「——那么我们赶紧去帕林库洛·勒伽西那边吧。不赶紧一点的话就赶不上了——」</data></node>
    <node id="特训成果检验·水晶蚁战（31层）"><data key="name">特训成果检验·水晶蚁战（31层）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「能不能先让我和拉丝缇娅拉来应敌呢？有不少特训的成果想检验一下」；莉帕和塞拉小姐在迷宫本来就不是主力，所以没有遭到反对我的提议就得到通过了。；「『FlameCutter』『FlameCutter』『FlameCutter』！！」</data></node>
    <node id="对等伙伴握手与斯诺的不逃避宣言"><data key="name">对等伙伴握手与斯诺的不逃避宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[在我看来，涡波现在非常的焦躁哦。所以，我希望你能再放松一些……。不然的话，我会很不安的哦……]；[——但是，果然我还是要努力一下。我觉得与守护者缇达有关的话，自己不能再去逃避了。不然的话，是没法继续前进的]；以前的斯诺不具备这份强大。颇有两天前依靠自己的力量奋起的斯诺的风格。</data></node>
    <node id="涡波拉丝缇娅拉决意特训"><data key="name">涡波拉丝缇娅拉决意特训</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不知为何，我们俩开始互相伤害起来。；这可不行。；对啊对啊！特训，来特训吧！这也是英雄谭的王道发展啊！！</data></node>
    <node id="呼唤缇亚与MP倒计时"><data key="name">呼唤缇亚与MP倒计时</data><data key="type">event</data><data key="status">provisional</data><data key="desc">缇亚，能听到吗！我来救你了！能听到的话就给个回应！！；她的MP正以相当剧烈的速度减少着。；要是那个『魔石人类』也跑来这边的话，说实话就不妙了呀</data></node>
    <node id="全海域龙卷风歼灭战"><data key="name">全海域龙卷风歼灭战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──全员听令！接下来将发动风属性的广域魔法歼灭敌人！所有人停止攻击，准备应对冲击！传令员务必将此令转达给船队全体的每一名成员！魔法的影响范围是整个海域！！」；接着，从其它方向诞生的又一道暴风也席卷而成。随后还有第三道、第四道──从四面八方而来的暴风汇合在一处。成百上千的暴风络合在一起，不到一秒便化作了覆盖整个海域的巨型龙卷风。；附着在船上的怪物却纷纷被风抽离到高空。</data></node>
    <node id="谒见室寻获罗德（玉座后的咏唱）"><data key="name">谒见室寻获罗德（玉座后的咏唱）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">离开深鞠了一躬的贝丝酱酱和居民们，我赶忙折返回城内。尽管边走边发动着『维度』，但罗德已经不在昨天的保管室里了。；在位于谒见室最深处的玉座──的后面，她正以体育座的姿势待在那里。；「『我无法抉择行进之路』『我乃风』──、以及『妾身之灵魂将得以加速』『得以加速』『得以加速』、『得以加速』──⋯⋯」</data></node>
    <node id="命名「艾德」与『支配之王』王国游戏确立"><data key="name">命名「艾德」与『支配之王』王国游戏确立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──既然这样，那你的名字就叫『艾德』好了！是个好名字吧！？；其实这名字是自己现想的。原本是不久前死掉的这附近的一只小动物的名字。因为爷爷奶奶当初就是把曾经亡逝的重要之人的名字给了自己，所以自己也就模仿了这个行为；艾德它是在这一年来──每一天都陪在人家身边的朋友。而且也是『支配之王』的第一个家臣。它是第一个超越了单纯的协助关系，成为了作为魔人的人家的同伴的存在⋯⋯</data></node>
    <node id="技能『？？？』任意解放·混乱突破与『反馈』"><data key="name">技能『？？？』任意解放·混乱突破与『反馈』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">并非自动的，我任意的让技能『？？？』发动着。────技能『？？？』暴走了。；────状态：混乱10.87────；连本带利的全部，回来了。积攒的恶感情与记忆─────绝望，孤独感，焦躁，耻辱，压力，不快感，恐怖，污染────以及，『爱情』回来了。</data></node>
    <node id="涡波与斯诺时隔一年再会"><data key="name">涡波与斯诺时隔一年再会</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「住手、缇缇！她就是斯诺！斯诺・沃克！她不是我们的敌人！！」；──就这样，在此时此刻、时隔一年的岁月，青色的龙人少女斯诺・沃克终于和我再会了。；「呜、呜哇啊啊、呜哇啊啊啊啊啊啊啊啊！！涡、涡波──！涡波涡波涡波！我的涡波！是涡波啊啊啊啊啊──！！」</data></node>
    <node id="新家三人晚宴"><data key="name">新家三人晚宴</data><data key="type">event</data><data key="status">provisional</data><data key="desc">玛利亚还在家里等着我。</data></node>
    <node id="雷纳尔多断后·崩宅送离"><data key="name">雷纳尔多断后·崩宅送离</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯等等，小子。⋯⋯贝丝就让老朽来对付。；「小子，你・想・错・了」；「──『Earthquake』！！」</data></node>
    <node id="涡波呼唤阳滝与记忆之旅"><data key="name">涡波呼唤阳滝与记忆之旅</data><data key="type">event</data><data key="status">provisional</data><data key="desc">仅此而已，『世界奉还阵』中的世界就不断震颤起来——那种振动化作某个『声音』传回。；毫无疑问，声音来·自·于·我·的·体·内；回想起来的确确实实是『我』自己的记忆。</data></node>
    <node id="技能群三重死亡预告与涡波的动弹不得"><data key="name">技能群三重死亡预告与涡波的动弹不得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是一幅《浑身是血的我，与熊熊燃烧的船一同沉没》的光景。；我打消了与缇亚商谈的念头，烦恼着。；我急忙冷却兴奋的感情，好不容易将技能的发动遏制住。</data></node>
    <node id="40层『大草原』初入·守护者不在"><data key="name">40层『大草原』初入·守护者不在</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「不，我觉得那里没有任何人在的可能性很高」；「不过也不是什么壊事。只是去最深部的话就没有非要打倒所有守护者的必要呢。不如说，能推给她们那边的队伍反而让我们变轻松了呀」；不管是阿尔缇还是诺文，只要跟守护者一起行动，就必然会被拉去被他们的留恋搞得团团转。</data></node>
    <node id="向居民报平安（哭泣隐匿的圆话）"><data key="name">向居民报平安（哭泣隐匿的圆话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我的大脑高速运转起来并开始圆话。；「啊─，那是因为⋯⋯昨天，我从迷宫把罗德以前的朋友带来了的缘故。因为跟她聊了一整晚，所以罗德今天睡过头了来着」；「是真的哦。大概中午左右就会从城堡里出来了，具体的事等到那个时候再问罗德吧。其余的诸位也都可以放心了」</data></node>
    <node id="海盗晨袭与千年前说明回"><data key="name">海盗晨袭与千年前说明回</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在天还没亮的时间里，我们之所以就起了床（斯诺除外），那就是因为海盗们跑来偷袭，还朝我们射出了炮弹。；无可奈何之下，睡眼惺忪的我和拉丝缇娅拉就要去击退袭击过来的海盗船。；『战争』在我不擅长应付的单词里是排第二位的。只要跟这个扯上关系，必然会见到排行第一位的『奴隶』一词，所以在用『Dimension』收集信息的时候我都有意给过滤掉了。</data></node>
    <node id="莱纳与塞拉潜入大圣堂地下"><data key="name">莱纳与塞拉潜入大圣堂地下</data><data key="type">event</data><data key="status">provisional</data><data key="desc">基督现在已经离开联合国了。而且这里又是铺设了数重结界的地下。我想我们的谈话是绝对不会被基督听到的；而这一切都是为了知晓拉丝缇娅拉当前的计划。先前之所以小心谨慎地与基督分头行动，实际上就是了此行的布局。；次元魔术没有那么便利啦。而且基督对付诸信任的人非常天真，所以他是不会用次元魔术监视我的行动的。</data></node>
    <node id="涡波记忆统合(基督与涡波融合)"><data key="name">涡波记忆统合(基督与涡波融合)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从最初迷失在迷宫的时候开始，直到败给帕林库洛为止的时间──所有这些都回想起来了。；我的叫声传入了主持人的麦克风，会场里的所有人都能听到。</data></node>
    <node id="缇缇与艾德的一年大冒险"><data key="name">缇缇与艾德的一年大冒险</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这就是那些没有被收录在英雄谭中的冒険。；像是将来到河边的精灵招待到自己家里、与在北方作祟的夜之怪异战斗、将飞在天上的怪鸟驯服、请求路过的魔法使教授自己魔法、太得意忘形结果惹怒了都会里的大人物、为了救出被掳作人质的艾德而参加武斗大会、去退治出现在东北方的大平原的翼龙等等──嘛，与翼龙的战斗结果基本都是惨败来的，不过依靠作为自己特技的交流能力总算是得以息事宁人──于自己而言，这就是不负于『支配之王』传说的大冒険。；而且如此众多的事件竟然只是被凝缩于一年之中。</data></node>
    <node id="莱纳风魔法基础特训（木勺浮空）"><data key="name">莱纳风魔法基础特训（木勺浮空）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德将木制的勺子递给莱纳，之后摆出了一副跃跃欲试地要挠莱纳痒痒的架势。；收在他们手中的勺子在风的作用下离手几公分后浮在了空中。虽然罗德的勺子就像是固定在了空中一样一动不动，但莱纳那边则逊色不少，勺子噗噜噗噜地摇晃着。；结果，莱纳只坚持了几分钟就无法维持风的平衡，被罗德处以了狂挠侧腹之刑。</data></node>
    <node id="雷纳尔多揭示佩艾希亚真相·托付救罗德"><data key="name">雷纳尔多揭示佩艾希亚真相·托付救罗德</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为『这里』就是为了杀死罗德那丫头才被创造出来的空间啊……；『这里』是小子你在一千年前为了罗德而创造的空间。因此，『这里』实现了罗德当时所有的愿望。；相应的，我希望你能去救救罗德那丫头。就凭我们的话，恐怕已经没办法救她了。</data></node>
    <node id="诺文胜格连后被群众包围"><data key="name">诺文胜格连后被群众包围</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是因为他在昨天的比赛中对战拥有『最强』之名的格连·沃克并取得了胜利所致。；因此很多人将诺文视为下一任的『最强』而心怀期待。</data></node>
    <node id="60层挑战决心与分头作战案"><data key="name">60层挑战决心与分头作战案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">再然后也成功地在六十层之前设置好了『连接』。；「要去的。我要去挑战并将守护者召唤出来。不过，总有一种不祥的预感⋯⋯」；「好，那么我们分两头行动吧。莱纳就守候在『连接』跟前。我一个人进入六十层，先跟守护者交谈试试。</data></node>
    <node id="涡波苏醒与战后状况确认"><data key="name">涡波苏醒与战后状况确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">当我打算拓展『维度』的时候，房间的门被推开，玛利亚现身了。；「太好了⋯⋯⋯那么，那之后莱纳他们怎么样了？」；「守护者对我们失去了兴趣，就那样离开了。⋯⋯比起这个，涡波先生，那个守护者的魔法对你的影响呢？」</data></node>
    <node id="DistanceMute开锁侵入绘画保管室·拼合被毁画像"><data key="name">DistanceMute开锁侵入绘画保管室·拼合被毁画像</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德嘱咐过我不要进入其它的房间。但这也就意味着她在其他房间里有不想被我看到的东西。；「⋯⋯魔法『DistanceMute』」；「太好了、成功了⋯⋯⋯不知道再出来的时候能不能再像这样把锁锁上啊⋯⋯？」</data></node>
    <node id="图书馆死神调查"><data key="name">图书馆死神调查</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这个童话的传承十分悠久，因此非常深入人心，甚至到了在这个世界提起童话的话，第一个就会想到『慕影死神』的地步。；消灭『死神』的方法只有一个。就是逆着它从死角处发来的攻击施以回击。</data></node>
    <node id="舞闘大会遗留文书处理委托"><data key="name">舞闘大会遗留文书处理委托</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，涡波君⋯⋯⋯如果可以的话，能拜托你帮忙处理一下这些文书吗⋯⋯？这里面好多都是因为你在『舞闘大会』中取胜还跑掉产生的问题来着⋯⋯」；「我知道了⋯⋯⋯都是突然抛弃了会长的责任走掉的我的错，帮忙也是自然的⋯⋯」；一看发现，身旁的波鲁扎克露出了饱含歉意的表情。</data></node>
    <node id="就寝前的状态确认（涡波与莱纳）"><data key="name">就寝前的状态确认（涡波与莱纳）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">名字：相川涡波HP353／353MP1165／1165－200职业（Class）：探索者；技能『锻冶』的数值提高到了可以独当一面的级别，不知不觉间还新增了技能『指挥』『后卫技术』。；名字：莱纳・赫勒比勒夏因HP409／409MP102／281职业（Class）：骑士</data></node>
    <node id="海莉战死与玛利亚送还"><data key="name">海莉战死与玛利亚送还</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──那天、和帕林库洛决战的那天，只有玛利亚能跟在你的身边。我能做的就只有在船上等你和玛利亚回来，所以我很努力地等着。等啊等等啊等一刻不停地等待着⋯⋯可是，最后回来的却只有玛利亚一个人。是涡波你用『连接』送她回来的？」；「不，那是海莉送她回去的。她当时跟我说是送到了一个安全的地方⋯⋯」；「没错，海莉和莱纳赌上了自己的性命前来助阵。而海莉她⋯⋯也死在了那里，虽然如此，但最后我和莱纳两个人总算是打败了帕林库洛。只是，因为没来得及逃出那里，结果我们两个人被『世界奉还阵』吞没，掉到了地下。因为掉到了迷宫的深层，所以花了很长的时间才回到了这里」</data></node>
    <node id="『维度・千算相杀』实测（对缇缇）"><data key="name">『维度・千算相杀』实测（对缇缇）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「姆，刚才吞下的魔法是吗？好啊，那就──『Wind・Scythe』」；接着就在全新的『维度』被发动的同时，缇缇射出的风刃便在瞬间雾散而去。；看到如此漂亮的『魔法相杀』，缇缇大感惊讶。</data></node>
    <node id="六十六层突入与战前部署"><data key="name">六十六层突入与战前部署</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为保万全，我展开了『维度・决战演算』之后进入了六十六层。；但今天，我却带着犯规的招数前来挑战。只要被我接触到，就有将它无力化的自信，胜算这次姑且是有的。；一级一级地向上攀登，同时在脑海里仿真战斗的场景。按照计划，我打算使用两次魔法就决出胜负。</data></node>
    <node id="『DistanceMute』完成——桌之魂拔除实验（得魔石·桌化光消散）"><data key="name">『DistanceMute』完成——桌之魂拔除实验（得魔石·桌化光消散）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好、好的，成功了⋯⋯！这样就能挑战六十六层了⋯⋯！」；经过一整晚的研究和练习，『DistanceMute』终于完成了。；『魂』被拔除的桌子就这样化作光芒消失了。这幅光景同迷宫内的怪物临终之际一模一样。</data></node>
    <node id="自室会合诺斯菲·探索送别"><data key="name">自室会合诺斯菲·探索送别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">根据她方才那番话可以明白我和罗德的谈话她全都知道了。；「如您所说，我也正有此意。⋯⋯所以呢，我打算就这样在这里等罗德过来。十分遗憾，这次的迷宫探索我无法与您同行了」；「呵呵，感谢您的体贴。您真是好温柔啊，涡波大人。那我就继续这样遂行我的任性了。啊啊，任性真是好啊。就好像内心得到了清洗一样呢。呋呋呋，总觉得，我可能很快就要因为留恋实现而消失了呀」</data></node>
    <node id="涡波经宝剑强启地魔法『Earth』操沙遭反噬"><data key="name">涡波经宝剑强启地魔法『Earth』操沙遭反噬</data><data key="type">event</data><data key="status">provisional</data><data key="desc">然而流入脑海中的却全都是『剑术』的知识。从始至终都是彻头彻尾的『剑术』；──地魔法『Earth』；沙子就像被磁铁吸引的铁砂一样，开始吸附到剑上。</data></node>
    <node id="贝丝点心赠答与离别告知"><data key="name">贝丝点心赠答与离别告知</data><data key="type">event</data><data key="status">provisional</data><data key="desc">没错、一直一直、永远永远，我都想这样做下去」；「那我在这里工作的期间就有劳你了。虽然我迟早会离开『这里』就是了」；贝丝酱的表情整个僵住了。她含英咀华般将我的话再三重复。</data></node>
    <node id="涡波对罗德近身剑战与超臂力投掷"><data key="name">涡波对罗德近身剑战与超臂力投掷</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊，接招吧！罗德──！！」；通过回抽剑柄末端的柄头，叩击袭向自己的剑刃将其错开，借此实现了防御。；「──『W・I・N・D』」</data></node>
    <node id="技能命名会与涡波定名（IllWill·注视·持有物品）"><data key="name">技能命名会与涡波定名（IllWill·注视·持有物品）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊，技能『问号问号问号』。这个是最棘手的」；「嗯～，姆姆─，呜～嗯。⋯⋯Unknown？不行，总觉得是带有恶意的技能⋯⋯，那就恶意（ILLWILL）？就叫技能『？？？（IllWill）』怎么样！？」；「⋯⋯说的也是。我知道了，就那么定了」</data></node>
    <node id="五十层中央『召还』人影出现"><data key="name">五十层中央『召还』人影出现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">暴风雨的中央──五十层的中心有人影出现了。；跪在地上的人影，现在正好站了起来。；那是，守护者的阶层有人进来后的『召还』现象。</data></node>
    <node id="点燃一切（业火宣言）"><data key="name">点燃一切（业火宣言）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「把主人、还给、我……还、给……」</data></node>
    <node id="39层狩场化与40层大草原抵达（第五次探索）"><data key="name">39层狩场化与40层大草原抵达（第五次探索）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我于是确信了39层是很方便用来狩猎的猎场。；「祭坛上的道具又没了……」；只靠目视就能从这一端望到尽头。但是40层守护者却并没有出现。</data></node>
    <node id="双守护者再会与和解（罗德临战变形·入住许可·称赞试留恋未成）"><data key="name">双守护者再会与和解（罗德临战变形·入住许可·称赞试留恋未成）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，涡涡和莱纳，欢迎回──不是、噫！诺斯菲！？」；不停尖叫的罗德全身都开始喷出魔力，她解开了自己的马尾辫；「诶诶，那是当然。我对你已经没有什么怨恨了，也不打算再跟你战斗」</data></node>
    <node id="异属性魔法仿效试炼"><data key="name">异属性魔法仿效试炼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在这之后我又尝试了塞拉的神圣魔法『Growth』、莱纳的风魔法『Ex・Wind』、沃尔斯爷孙的炎与地属性的复合魔法『Flame・Accel』；和拉丝缇娅拉的『冰BatteringRam』那足以在空中打造出一桩巨槌的气势相比，我顶多只能创造出一个手掌大小的冰锥。；这充其量只是依靠才能进行的仿效而已，离真货相去甚远。</data></node>
    <node id="士兵死守掩护帕林库洛撤离（涡波杀意萌生）"><data key="name">士兵死守掩护帕林库洛撤离（涡波杀意萌生）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">朝我袭来的是一支铁箭。；「——帕林库洛长官！」；那是一名作为军人来说显得有些年轻的男子。尽管跟我比起来倒是年长，但是跟其他人相比就年轻得多。</data></node>
    <node id="北方行目标确立"><data key="name">北方行目标确立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「来吧，目标是本土！前往艾德等人所在的『北方』──」；去和同伴们汇合，然后救回缇亚和阳滝，解决了这些之后再做好万全的准备前往大圣堂，在那里一雪前耻。</data></node>
    <node id="西斯逃走（左脚烧失）"><data key="name">西斯逃走（左脚烧失）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">即使左脚已经被烧成灰烬不复存在，还是坚持使用白翼浮在空中。；一飞冲天的西斯已经消失在了云层之中。；我们终究是没有让手染上同伴鲜血的觉悟的不成熟之人，在现实面前，我们的天真还是造就了失败。</data></node>
    <node id="信与疑的分歧（莱纳直谏）"><data key="name">信与疑的分歧（莱纳直谏）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我看来诺斯菲那家伙说的话全都可疑得不得了。说得直接一点吧，你难道不觉得她说的全是假话吗？；视情况而定，她不光可能成为我们回到地上的障碍，甚至会成为威胁我们生命的敌人。；「再一点就好⋯⋯⋯我希望你能再稍微信任她一些⋯⋯」</data></node>
    <node id="艾德撤退并回收王之器少女"><data key="name">艾德撤退并回收王之器少女</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就先确保王之器好了。反正对鄙人的计划来说涡波大人本来就不是必要的呢；接着一根巨树便从地上钻出。巨树的根干开裂，将女孩子和艾德裹进去。；二人的气息从战场上彻底消除了。</data></node>
    <node id="64层GreenHighElement战"><data key="name">64层GreenHighElement战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">它用跟莉帕相似的瞬间移动紧咬住我们不放。；莱纳！这样就行！继续用魔法攻击！；将莱纳的风像芳醇的食粮一样吸收起来的精灵体型已经膨胀到了原来的十倍。</data></node>
    <node id="双守护者五十七层口角激化（魔力对峙）"><data key="name">双守护者五十七层口角激化（魔力对峙）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然被罗德的风吹飞，但我立刻就调整好姿势落地。诺斯菲和莱纳也是一样。毕竟我们三个都不是会被这种随意释放的『SehrWind』程度的风伤到的人。；「吵死了吵死了吵死了！诺斯菲你吵死人了啊！！还不够、还远远不够啊！所以去地上什么的、绝对不要！！绝对不去！！」；「你就是有在装乖！留恋之所以是留恋，不就是因为它实现不了么！？要是真能那么简单就正视得了，那人家从一开始就不会存在于『这里』！诺斯菲明明就连自己的留恋是什么都还不清不楚，却在这里装出一副了不起的样子──！！」</data></node>
    <node id="三十层守护者诺文与慕影死神遭遇"><data key="name">三十层守护者诺文与慕影死神遭遇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【三十守护者（ThirtyGuardian）】地之理的盗窃者；「死心吧。只要我在附近，你就不可能再实体化了。无论是一毫米的空隙还是一秒的空档，我都是不会给你的。」</data></node>
    <node id="罗德与涡波的空战·河道一击"><data key="name">罗德与涡波的空战·河道一击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德没有放过这个机会，紧紧抓住我的左臂──接着以背摔的姿势将我掷出。；「──『Sehr・Wind』！！」；拳头砸穿一滴水都不剩的河底</data></node>
    <node id="Sylph·Rokh·Bringer锻造完成"><data key="name">Sylph·Rokh·Bringer锻造完成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我利用MP自然回复的时间，研磨在昨天重获新生的『赫勒比勒夏因家的神圣双剑』『CallOuter』『AllConfess』。；——呼，我这边完成了哦，小子。；只用一天就打造出了与我的『新月琉璃』匹敌的宝剑，让我对雷纳尔多高超的技艺叹服不已。</data></node>
    <node id="六十五层突围·抵达六十四层"><data key="name">六十五层突围·抵达六十四层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">数分过后，向我们袭来的LizardFlyer数量已经超过两位数。不管怎么拖，一旦解除了魔法的束缚，对手就又会追上来，数量越来越多也是必然的。现在的状态就像滚雪球。；「──基督，做好准备！『Ex・Wind』！！」；多亏了莱纳妙不可言的判断，我们终于冲过了通往六十四层的位于天花板的洞穴。</data></node>
    <node id="涡波说服失败与道歉"><data key="name">涡波说服失败与道歉</data><data key="type">event</data><data key="status">provisional</data><data key="desc">败在了『暗之理的盗窃者』手下的我，记忆和自我都被改窜得暧昧不清；回想起自己在劳拉维亚的生活，我将那份后悔传达给罗德。；「涡波说的话统统都是大人的理论！倘若孤真能一切都按照这些理论行事，那怎会有什么烦恼！</data></node>
    <node id="技能『？？？』命名『最深部之誓约者』并升华发动"><data key="name">技能『？？？』命名『最深部之誓约者』并升华发动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──现在正是将我引导之时！！！『最深部之誓约者（The・Covenanter）』啊啊啊啊──！！」；就这样，历经千年的岁月终于得到名字的技能实现了升华。；混乱减少1.00──</data></node>
    <node id="时代相联结——涡波于自造迷宫中苏醒'重新来过'"><data key="name">时代相联结——涡波于自造迷宫中苏醒'重新来过'</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在黑暗的回廊中，在自己打造的迷宫中醒来的『涡波（我）』；简直就像是第一次迷失在异世界中一样的涡波，又一次开始『重新来过』；明明是自己打造的『迷宫』，我却像是被拐进来一样畏惧着。</data></node>
    <node id="33层至34层无双推进（前卫无事可做）"><data key="name">33层至34层无双推进（前卫无事可做）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不过就是点水，在压倒性的热量面前没有任何意义。；在我们驾着剑站着的时候，战斗就结束了。；我们抱着后卫二人组的大腿，在33层势如破竹。</data></node>
    <node id="帕林库洛的幸福感劝与三十层交易成立"><data key="name">帕林库洛的幸福感劝与三十层交易成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——在当下这个时间点，涡·波·和·玛·利·亚·的·愿·望·已·经·实·现·了，这点毋庸置疑。即使如此，涡波你仍然要探寻真实与否吗？；「那么，拉丝缇娅拉·弗茨亚茨、迪亚布罗·西斯。听到这些名字你有想到什么吗？」</data></node>
    <node id="六十六层艾尔芬里斯初战（完败脱离）"><data key="name">六十六层艾尔芬里斯初战（完败脱离）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">穿过『连接』的我们三人就这样来到了六十六层。；无数的暴风就如开花弹一样炸裂开来，像蹂躏糕点一样将阶梯撕得粉碎。；「这、这也太硬了！暂停！先逃离这里！！」</data></node>
    <node id="光感染四剑失败与三骑士之名暴露"><data key="name">光感染四剑失败与三骑士之名暴露</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这就好像是同时以我的三名骑士为对手进行战斗一样；这一次光感染的对象既不是我本人也不是我的『血』，而是我们手中的四把『剑』；是阿雷亚斯、兰斯、赫勒比勒夏因你们几个对吧！你们这三个可恨的骑士！还是老样子，我这个主人的话你们一丁点儿都听不进去！！</data></node>
    <node id="斯诺当众老公宣言与形象崩塌"><data key="name">斯诺当众老公宣言与形象崩塌</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「嗯！他就是我一直在寻找的老公哦。诶嘿嘿～」；我想，这应该就是斯诺用一年时间塑造起来的高大形象轰然倒塌的瞬间了吧。；「老公！？请、请您不要开玩笑！」</data></node>
    <node id="甲板海水浴与游泳练习"><data key="name">甲板海水浴与游泳练习</data><data key="type">event</data><data key="status">provisional</data><data key="desc">莉帕虽然还是有些笨拙，但似乎已经变得可以在水中行动了。；「啊阿，是真的。35层完全就在水里面。如果不能游泳就完全无法前进」；「是的。远在帕尼亚的故乡不只海，河川或湖泊都很少见⋯⋯」</data></node>
    <node id="王近卫骑士团由天上魔石唤回现世"><data key="name">王近卫骑士团由天上魔石唤回现世</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那魔力的光辉──不，这魔石（魂）的光辉我曾经见过。；他们魔力的光芒和那些魔石当时在天上闪烁着的淡薄光芒一模一样。；他们到昨天为止还作为魔石漂浮在天空。和平的世界不需要带剑的骑士，这也是理所当然的。</data></node>
    <node id="魔石服用与魔法习得"><data key="name">魔石服用与魔法习得</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呼。这样应该就可以了吧。──魔法『Shift』」；看来是通过对魔石的服用让使用者强行理解了术式，然后达到了可以在实践中使用的状态。想必这就是所谓的将术式写在血中吧。；「──呜、想吐⋯⋯胃好胀⋯⋯！好不容易才得到治愈的我的胃要⋯⋯！！」</data></node>
    <node id="翠之护身符赠与"><data key="name">翠之护身符赠与</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是一条闪着翠色光辉的项链。雷纳尔多将它递到我手上。；首先是可以保护身体抵御风属性攻击的魔石呐。</data></node>
    <node id="斐勒卢托逐出房间与四少女留置"><data key="name">斐勒卢托逐出房间与四少女留置</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我就说路上怎么总有人来拖延时间，果然都是斐勒卢托你从中作梗对吧」；「⋯⋯涡波阁下。那我们以后有机会再见吧。毕竟我也还没有使出全力呢啊⋯⋯──没错，我手上还有很多的牌可以打。今天的招待还只是冰山一角罢了」；结果前脚还没迈出去，拉丝缇娅拉又命令他将四名『魔石人类』少女留下来。</data></node>
    <node id="变现现金送达工房"><data key="name">变现现金送达工房</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就在这时，缇莉和波鲁扎克走进了工房。；「啊，果然还在这里！你要的现金我都准备好了哦！」；波鲁扎克抱着装有大量金币的袋子还有文件。看来以后是不用为钱发愁了。</data></node>
    <node id="陌生的声音唤醒罗德·命其拾读书"><data key="name">陌生的声音唤醒罗德·命其拾读书</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──罗德，快想起来」；「──做不到也得做。听我的，快去把那个捡起来」；「我为了搞出那本书可是把命都折了。你再不愿意也得给我读」</data></node>
    <node id="涡波的无双亲告白与斯诺的异世界同行约定"><data key="name">涡波的无双亲告白与斯诺的异世界同行约定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「感觉不错呢。再说我也必须跟涡波的双亲打个招呼才行！」；不存在的，我现在只有阳滝一个亲人。；「好啊，当然没关系。等我带赛鲁多拉过去的话就把斯诺也带上」</data></node>
    <node id="超限《前日谭》再构筑与万众唤魂"><data key="name">超限《前日谭》再构筑与万众唤魂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">尽管从《表示》看来我的MP已经空空如也。；无数淡薄的泪洸开始于空中飘洒。而泪洸的诞生之源正是空中的魔石。；大家的魂早就在五百多年以前损耗殆尽了</data></node>
    <node id="夫妻关系暴露（罗德揭破·诺斯菲终结话题）"><data key="name">夫妻关系暴露（罗德揭破·诺斯菲终结话题）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「等、等一下，罗德。你这话是什么意思」；「⋯⋯那意思就是说，过去的我跟诺斯菲缔结了婚姻关系？」；「你们两个人就是夫妻啊！所以诺斯菲才会坚持战斗的不是吗！？明明她那么辛苦，涡涡你实在是太过分了！」</data></node>
    <node id="火暗大战终焉·战场歼灭"><data key="name">火暗大战终焉·战场歼灭</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『火之理的盗窃者』与『暗之理的盗窃者』的全力激战。；投身战争的数万士兵已经灰飞烟灭，整个战场也被摧毁到一大堆地图要作废的程度。；最后剩下的只有三人。</data></node>
    <node id="前廊对峙·诺斯菲留恋自白"><data key="name">前廊对峙·诺斯菲留恋自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">诺斯菲以轻快的步伐向旁边一跳便躲开了我的一闪。；因为这个模样便是诺斯菲的真心。；「既然如此，那你就是我的敌人⋯⋯！就算被我在这里斩杀，你也不会有怨言吧！！」</data></node>
    <node id="菲伊・厄鲁斯全财产剥夺与驱逐"><data key="name">菲伊・厄鲁斯全财产剥夺与驱逐</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──金额不足的部分要用别的东西来支付哦。这也是理所当然的吧？随身物品、马车上的货物、契约书、各种各样的物品都要拿来抵账。我们这边也没什么时间，就不客气地收下了。」；我夺走了菲伊・厄鲁斯的全部，将他驱逐。；这里是赌场准备的隐蔽房间。</data></node>
    <node id="罗德狂暴暴风吹飞三人（章末骤变）"><data key="name">罗德狂暴暴风吹飞三人（章末骤变）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯你在骗人。骗人骗人骗人、你骗人啊！」；「吵、吵死了！！」；罗德终于无法忍耐，浑身战栗起来，并狂暴地解放出自己身上的魔力。</data></node>
    <node id="千年前八杰名录与六十层军议"><data key="name">千年前八杰名录与六十层军议</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「首先是曾作为南之『御旗』的诺斯菲。以及那名少女的骑士缇达・兰斯、诺文・阿雷亚斯、法芙纳・赫勒比勒夏因。此外便是北之『狂王』罗德。加上她麾下的艾德、涡波、赛尔德拉。战时属这八人名声最为显赫」；「如果诺斯菲的三名守护骑士是六十层的守护者的话，你要切记绝对不可与之相战。；「不，缇达和诺文的话已经无需担心了。因为他们两个已经全被我打倒了」</data></node>
    <node id="工房访问与装备商谈"><data key="name">工房访问与装备商谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">思考的结果促使我去收集一些战斗用的武器。换句话说就是搜集『装备』了。；「会、会长！这不是会长嘛！果然是要回到『史诗探索者』了是吗！？是这么回事对吧！？」；要我说的话，我想要在『舞闘大会』里佩露修娜小姐穿的黑铠那种级别的物件。</data></node>
    <node id="魔石船LivingLegend号启航（船旅开始）"><data key="name">魔石船LivingLegend号启航（船旅开始）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">离开古尔亚德的港口，我们总算摆脱追兵得到了自由的时间。；在我和莉帕将船的航行稳定下来之后，我们在拉丝缇娅拉的主导下分配好了各自的房间。；大家各自前往私室，休养因『舞斗大会』而疲惫的身心。</data></node>
    <node id="海莉别离与追击出发（马车）"><data key="name">海莉别离与追击出发（马车）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「各种事上都有劳你帮忙了，海莉。等你救出莱纳之后，一定要赶快逃到这个『魔石线』影响不到的地方，说不定有我们阻止帕林库洛失败的可能。那样的话海莉你的身体在『世界奉还阵』中会非常危险」；「那么再会了。我去关押莱纳的地方了──」；留下这句话，海莉便咏唱出『连接』离开了。</data></node>
    <node id="对罗德的掩护接触（量尺寸·收装备·拒野餐）"><data key="name">对罗德的掩护接触（量尺寸·收装备·拒野餐）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯嗯？哦呀，是涡涡。你不是应该去锻冶场工作吗？」；本来是很唐突的要求，但莱纳丝毫没有感到不乐意。他毕恭毕敬地交出自己身上所有的装备，也很配合地接受了『维度』对尺寸的衡量。；「那么那么，明天咱们三个人一起去野餐怎么样！这边的工作也告休一天！」</data></node>
    <node id="『重崩色之非风剑』贯穿佩艾希亚结界"><data key="name">『重崩色之非风剑』贯穿佩艾希亚结界</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这一招正是过去的你所传授的力量！这份罪过，你就好好品尝吧！！；「──『维度・曲战演算』！！」；一个宛如教科书插图里的黑洞一样巨大的漆黑洞穴凿穿了名为『佩艾希亚』的结界。</data></node>
    <node id="城墙坦白（最后的独白）"><data key="name">城墙坦白（最后的独白）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一切早都已经结束了。而我面前的人，也不过是一具迟早要死的尸体。；「我问你。如果我说现在使徒大人就在我的身体里，你真的会相信吗？」；「……我相信。因为您确实给予了我们这样的希望。在这座要塞之内，已经没有任何人怀疑您的力量了。我们都将您视作了拯救世界的使徒，无比尊崇。」</data></node>
    <node id="65层LizardFlyer遭遇战与突破"><data key="name">65层LizardFlyer遭遇战与突破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">伤口深达两公分。如果它的目标是我的手，那现在应该已经切断我两根手指了。；紧接着，莱纳的『Sehr·Wind』便遭到了『魔法相杀』。；由此推测这家伙没有办法同时进行移动和『魔法相杀』。</data></node>
    <node id="涡波拒绝自我牺牲·选择分头回地上带艾德"><data key="name">涡波拒绝自我牺牲·选择分头回地上带艾德</data><data key="type">event</data><data key="status">provisional</data><data key="desc">好歹是这么多天来一起吃住的同性友人。；那只不过是会让我的内心感到轻松的选择而已。；现在正确的做法，是就算兵分两路也要尽快将艾德带回来。只要能回到地上，增援要多少有多少。所以──！</data></node>
    <node id="罗德化星攀升·咏唱削魂·涡波制止无效"><data key="name">罗德化星攀升·咏唱削魂·涡波制止无效</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「既、既然如此！那就使用无法回避无法化解的魔法便是！你就后悔自己让孤使出这招好了──！！」；用翠色的羽翼包裹身体，向上再向上，罗德以下坠的势头扶摇直上。；于是，将此世一切魔力纠集于一身的罗德，终于化作了一颗星。</data></node>
    <node id="使徒西斯显现与宣言"><data key="name">使徒西斯显现与宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——别来无恙。『进展如此顺利』实是一桩美事，盟友。」；自盟友向『迪亚布罗·西斯』报上『涡波』之名时起，此间一切已是注定。；在那之后活下来的，我记得是缇娅拉和勒伽西还有阿尔缇三个人来着？</data></node>
    <node id="带回艾德之托与涡波承诺（兼夺回阳滝）"><data key="name">带回艾德之托与涡波承诺（兼夺回阳滝）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">如果有跟王关系最接近的艾德阁下在，那么罗德那一直为人不解的留恋说不定也能被揭晓了啊。；如果小子方便的话，老朽倒是希望你能把他从地上带来⋯⋯」；把阳滝从艾德手上夺回来之后，就给他绑了一路带到这里便是。这样刚刚好。</data></node>
    <node id="海因『再诞』成败大争辩"><data key="name">海因『再诞』成败大争辩</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──你在复活海因这件事上失败了」；我那时候是因为成功了才感到悲伤；「──即使如此，作为海因的友人，我也要断言存在于此的『魔石人类』就是海因・赫勒比勒夏因！」</data></node>
    <node id="诺文得到答案(我就是我宣言)"><data key="name">诺文得到答案(我就是我宣言)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——我就是我！诺文·阿雷亚斯！！」；「我真正想要的既不是『英雄』也不是『最强』之类的虚名，更不是阿雷亚斯家的繁荣！对我来说『荣光』不过是过眼云烟！我想要的是更『微小的光』啊！！」</data></node>
    <node id="魔石构造解析（维度・决战演算）"><data key="name">魔石构造解析（维度・决战演算）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「对吧？现在有这么多研究材料摆在眼前呢。我很快就搞定，你稍微等一会儿。──魔法『维度・决战演算』」；和当初跟玛利亚一起购买魔石的时候比起来，我次元魔术的力量已经有了质的飞跃；这东西虽然以鲜血魔法和『DistanceMute』的复合为基本，但也混杂着类似于神圣魔法的东西。这些所谓的魔石，毫无疑问跟始祖和圣人的力量有瓜葛。在此之上，这个世界的人们又经过自己的手将新的魔法写了进去，由此改良成了可以让人习得魔法的魔石。</data></node>
    <node id="艾尔艾米丽再会于魔法屋练习场"><data key="name">艾尔艾米丽再会于魔法屋练习场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">他们就是几天前我们三个从地下一路逆行返回地上的时候遇到的艾尔君和艾米丽酱。；「居然还能见到两位前辈真是让人高兴。我们现在正在用之前从你们那里得来的钱进行魔法的强化⋯⋯可是艾米丽她偏偏把院子里的人偶给打壊了⋯⋯」；「他们两个人可是店里的常客哟，跟小哥你不一样经常照顾店里的生意呢。所以就让他们随意使用院子里的魔法练习场了。另外你们两个不用放在心上哦，练习的人偶被破壊也是它的命运呢」</data></node>
    <node id="境界战争前线小胜（北方同盟撤退）"><data key="name">境界战争前线小胜（北方同盟撤退）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">将视线挪往北方定睛一看，便可观察到正在撤退当中的『北方同盟』的大军。而在充当我散步场所的要塞之下，则是因这场战术性胜利而欢呼雀跃的『南方联盟』的士兵。；「喂喂，才那种程度的小胜就让你得意忘形了吗？敌人很快又会反扑的。……可别大意了哦，不然我可就操心了。」；当然，我说的进展顺利并不是指方才带领『南方联盟』的军队小胜『北方同盟』这件事。</data></node>
    <node id="『本土』抵达与藏船"><data key="name">『本土』抵达与藏船</data><data key="type">event</data><data key="status">provisional</data><data key="desc">照计划一抵达本土，迷宫探索就要告一段落了。；为了隐藏『LivingLegend号』，我们将它停靠在本土东北部瓦尔德本国东端的海崖下。；因为之前帮助过奴隶以及对付过海盗的缘故，我们乘着这艘船的情报很可能已经泄露了。</data></node>
    <node id="传说终末之战落幕——缇娅拉说服始祖涡波"><data key="name">传说终末之战落幕——缇娅拉说服始祖涡波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在那生息嚼类已不留一人的死之荒野上，『始祖涡波』与『缇娅拉』迎面而立。；「──师父！已经没事了！阳滝姐还活着！你已经不用再战斗了！！」；最终，始祖涡波跪倒在地，像个孩子一般失声痛哭。</data></node>
    <node id="『DistanceMute・繋心』记忆确认"><data key="name">『DistanceMute・繋心』记忆确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「算了、会长直接用你擅长的魔法看看咱的脑子好了⋯⋯咱真的没有说谎啊⋯⋯不如说咱一开始就知道面对会长说谎是没用的了⋯⋯说到底，咱魅惑的魔眼被会长的魅惑的魔法所覆写，根本就做不到反抗会长的说⋯⋯」；「──魔法『DistanceMute・繋心』」；我麻溜利索地将手插进古奈尔酱的胸口打造出『连接』</data></node>
    <node id="总攻：共鸣魔法与自由之风开路"><data key="name">总攻：共鸣魔法与自由之风开路</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不仅如此。数都数不过来的风之枪将天空吞噬，如雨点般落了下来。；「就凭这种程度的魔法！──『Light・VariantWall』！！」；在上空落下的莱纳，将他手中的一把剑像飞镖一样丢了过来。</data></node>
    <node id="阳滝魔石被夺与兄妹身魂颠倒"><data key="name">阳滝魔石被夺与兄妹身魂颠倒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——而『水之理的盗窃者（阳滝）』的『魔石』也从我体内被剥离。；——就这样，『身体』和『魔石』产生了错装。；就这样，一名少女『再诞』于这个世界。</data></node>
    <node id="主角大剑击杀巨狼"><data key="name">主角大剑击杀巨狼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【获得了称号『深翠之始』】</data></node>
    <node id="涡波习得『诈术』并夺尽菲伊的诈术1.33"><data key="name">涡波习得『诈术』并夺尽菲伊的诈术1.33</data><data key="type">event</data><data key="status">provisional</data><data key="desc">得到了技能『诈术』；因为不能用《Dimension》所以花了不少时间。然而，我终于夺尽了男人的『诈术1.33』，并到达了『诈术1.34』；在赌局前为止如他所言，我是个连『诈术』的基本都不明白的臭小子而已。只不过，那个臭小子在赌局的数十分之间，就超越了菲伊？厄鲁斯花费几十年岁月培养出来的『诈术』</data></node>
    <node id="诺斯菲的败北承认与退却"><data key="name">诺斯菲的败北承认与退却</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「简、简直是在开玩笑！这等魔法，岂不是连命运都能操控在手！这已经超越强弱的次元了！！」；「真是没有办法。我承认是我输了。这场战斗，在这个次元属性的魔力被您使用出来的时间点上，就注定了是我的失败。⋯⋯既然已经无法切实获胜，那我也不会再打下去了。因为再继续使用光之『咏唱』的话就危险了。⋯⋯呵呵，留恋又进一步增加了呢。」；「──『连接』。那么就请容我暂且退却去准备一下对策吧。如果现在非要与您那次元魔术一决胜负的话于我来说实在不利⋯⋯不，岂止如此，是胜算全无呢。」</data></node>
    <node id="鲜血魔法宣言与双后卫提案（探索前彩排）"><data key="name">鲜血魔法宣言与双后卫提案（探索前彩排）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">本小姐今天就给你展示一下，鲜血魔法的真正价值；我拔出『阿雷亚斯家的宝剑诺文』，在空中散布水晶粒子，然后沐浴着闪闪发光的水晶，我也壊笑起来。；涡波先生，拉丝缇娅拉小姐，你们到底在做什么</data></node>
    <node id="艾德成为『木之理的盗窃者』并宣示兽人改称宏愿"><data key="name">艾德成为『木之理的盗窃者』并宣示兽人改称宏愿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[——啊啊！是『支配之王』啊，您来得正是时候！鄙人终于也做到了！现在鄙人已经成为『木之理的盗窃者』了！！]；[请看！这份力量，您觉得如何！？鄙人也听从了使徒阁下的建议，『盗取了理』！啊啊，这样鄙人终于能帮上您的忙了。；[呋呋，难道说过去太久您给忘了吗？就是以前说过的，总有一天要将『魔人』这个词从世界上抹去那件事啊！]</data></node>
    <node id="王族逃亡曝光·孤被拥立·北方反乱军成立与新生佩艾希亚国诞生"><data key="name">王族逃亡曝光·孤被拥立·北方反乱军成立与新生佩艾希亚国诞生</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[——你、你说什么！？现在城内一个佩艾希亚王族都没有……？]；[这怎么可能！！竟然舍弃了臣民自己逃了！？正因为王必须守护人民，所以才是王族不是吗！？；这就是以『支配之王』为首脑，以佩艾希亚城为据点的北方反乱军揭竿而起的瞬间。</data></node>
    <node id="乐园宣告与国民光粒子化升天·无自我再现"><data key="name">乐园宣告与国民光粒子化升天·无自我再现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[啊啊，我们终于来到了啊……来到了这个所有的魔人都向往的『乐园』……感激不尽、『支配之王』陛下。我已经……不再有……任何、留恋——]；[『这里』是为了所有人都能幸福而存在的世界……是涡波和孤共同打造的，最后的『乐园』]；随着宣言的传达，有一半的国民心满意足地消失了。对此孤全都带着笑容在一旁为他们送别。</data></node>
    <node id="『素体』发现与『异邦人』说法冲突"><data key="name">『素体』发现与『异邦人』说法冲突</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那个，魔石人类全员，有着技能『素体』，这难道不是『魔石人类』的证明吗⋯⋯？但是我却没有那个⋯⋯！」；「────什，你在说什么？在那里不是写着吗⋯⋯，『素体』⋯⋯⋯在看不见的技能下面好好地有着『素体』技能⋯⋯」；「等，等等。在哪里不是写着『异邦人』吗⋯⋯？」</data></node>
    <node id="魔王城苏醒后情报确认·阳滝不在判明（ch169）"><data key="name">魔王城苏醒后情报确认·阳滝不在判明（ch169）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——也就是说，我是掉到『这里』的是吗。」；「有哦，涡涡是和莱纳一起掉下来的。」；「没有哦？只有你们两个。之后你再问一下莱纳，就知道是真的了。」</data></node>
    <node id="诅咒最终防卫发动(不罚的大英雄)"><data key="name">诅咒最终防卫发动(不罚的大英雄)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">唯一的方向，那就是，；——守·护·这·个·手·环。；『——好了，这样条件就凑齐了。来吧，涡波小哥。为了你最爱的妹妹，去把面前的敌人给打倒吧？』</data></node>
    <node id="海莉≠海因判定讨论（血与魂）"><data key="name">海莉≠海因判定讨论（血与魂）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">白色少女海莉的余韵完全从现场消散之后，拉丝缇娅拉发声道：；「不不，那个不是明摆着的么。那孩子不是海因，完完全全是两个人呢。不管是外表还是气质都是。说到底只是因为有记忆所以有些相似罢了。再说了，圣人缇娅拉的『再诞』之魔法怎么可能是帕林库洛模仿的来的嘛」；「不不，只有记忆的话说不上『再诞』的吧⋯⋯？」</data></node>
    <node id="尴尬时间·拉丝缇娅拉暴走夺窗逃跑与心意确认完成"><data key="name">尴尬时间·拉丝缇娅拉暴走夺窗逃跑与心意确认完成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">本来明明只是一个无聊的口头约定的延伸而已。但是，却像恋人一样互相拥抱了起来，我们彼此都注意到了这一点。；拉丝缇娅拉睁大双眼，耳朵也红透。；看到再差一点蜡烛就要燃尽，拉丝缇娅拉终于无法忍耐地叫喊。</data></node>
    <node id="失忆坦白与身世互报"><data key="name">失忆坦白与身世互报</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「其实现在的我没有千年前的记忆。所以说，我并不认得你是谁。；「所以，让我重新自我介绍一下吧。我的名字叫相川涡波。你呢？」；「──我的名字叫做诺斯菲。曾经作为南方阵营的『御旗』置身于战争之中。</data></node>
    <node id="诺斯菲承认受托调整环境·看穿地上计划"><data key="name">诺斯菲承认受托调整环境·看穿地上计划</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──居然能在这么短的时间里，从罗德手中逃走，然后摆脱对您充满敌意的街道来到这里。呋呋呋，您真是一如既往啊。真的是『一如既往』」；「诺斯菲──！！快住手！现在立刻让『这里』变回原样！这全都是你做的不是吗！？」；「涡波大人是打算带上赫勒比勒夏因以及沃尔斯一起逃到『未来（地上）』去对吧」</data></node>
    <node id="古奈尔车队重逢与捕获同行"><data key="name">古奈尔车队重逢与捕获同行</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然驾驶着足以让二十人搭乘的马车，但我们一共只有三人。与之相对的，古奈尔酱则是数十人的车队。；「唔姆，有道理。就是这样⋯⋯好滴、捕获成功！」；缇缇以干净利落的动作溜到古奈尔酱的身后给她抱了起来。</data></node>
    <node id="莉帕『连接』转移撤退（战场2对2化·168话）"><data key="name">莉帕『连接』转移撤退（战场2对2化·168话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">至少也要让姐姐们脱离这个地方才行；「──『连接』！」；这样一来战场上就少了四名同伴，状况转变为2对2了。</data></node>
    <node id="涡波真正的『升级』与技能『？？？』发动"><data key="name">涡波真正的『升级』与技能『？？？』发动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我也『LevelUP』到了更高的阶段。；不仅仅是数值上的『LevelUP』，而是真正意义上的『升级』；通过对过去的克服，取回了感情。</data></node>
    <node id="诺斯菲流星押送涡波至佩艾希亚御殿"><data key="name">诺斯菲流星押送涡波至佩艾希亚御殿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">设置在自己房间的『连接』和五十七层的『连接』就都消失了。可以肯定这也是诺斯菲事先做了什么手脚。；在我确认了可供逃跑的途径遭到削减之后，诺斯菲也松开了以几乎捏断骨头的力道握紧我手臂的手。；「我回来了。成功把人带回来了哦，罗德」</data></node>
    <node id="战后治疗与再出发动机"><data key="name">战后治疗与再出发动机</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为至今以来老是在大战之后遭人偷袭所以还是小心为上。但是，确认到周围真的已经没有敌人之后，我安心得一屁股坐了下来。；「⋯⋯也是。不赶快行动的话有可能会饿死呢。毕竟现在里侧的街道已经完全崩壊了呢。」；「啊，这个不用担心！接下来的迷宫探索人家也好帮忙的！人家认真起来的话，六十六层什么的很快就结束了！大概还很轻松哦！」</data></node>
    <node id="缇亚受嘲与斗殴风波"><data key="name">缇亚受嘲与斗殴风波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，确实，能使用魔法是很了不起。不过，等级只有1级的话，可是比路边的小孩子还低的哦。</data></node>
    <node id="祭坛巡回：诅咒武具连破与碎片回收（31~33层）"><data key="name">祭坛巡回：诅咒武具连破与碎片回收（31~33层）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们一行人一边在31层、32层、33层寻找祭坛一边前进。；对32层的飞行系怪物，我们基本上采取无视的方针。虽然有呼唤增援的事，但是多亏了莉帕的暗魔法，很容易就甩掉了。；基本上都是带有诅咒的东西，『精神污染』这个描述可以说是必有的。</data></node>
    <node id="十匹大蜈蚣群现西面山地（急报）"><data key="name">十匹大蜈蚣群现西面山地（急报）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──希达尔克大人，有报告说西面的山地又出现了之前那个怪物」；「是数量的问题⋯⋯跟之前不同，这次足足出现了十匹。我想不动用数支正规部队的话是处理不了的」</data></node>
    <node id="诺斯菲篡改『异邦人召唤』代罗德显现五十层"><data key="name">诺斯菲篡改『异邦人召唤』代罗德显现五十层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯呵呵。好久没尝试过了，本来还挺不放心来着，看来是顺利成功了呢。虽说有不少的限制，不过运用我原本的魔法这些问题便迎刃而解了」；我对执行召唤的术式进行了『交流（篡改）』，将召唤对象从罗德转变为了我自己；技能『感应』也警报大作，告诫我不要贸然接近出现在五十层的六十层守护者（SixtyGuardian）。</data></node>
    <node id="《这里》术理崩坏与表里缝合"><data key="name">《这里》术理崩坏与表里缝合</data><data key="type">event</data><data key="status">provisional</data><data key="desc">曾几何时间，构建于周围的《■道落土（Lord·Of·Lord）》已经被解除。；孤真正渴求的根本、根·本·不·是《这·里》；这一次世界并非是因为物理上的力量被破坏的，而是源于魔法术理的法则产生的崩坏。</data></node>
    <node id="使徒勒伽西之力篡夺（『再诞』仪式）"><data key="name">使徒勒伽西之力篡夺（『再诞』仪式）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「就是这样，那位使徒的力量在大约十年前由我的侄女西娅继承了。」；没法放任成为了『再诞』容器的侄女不管啊。于是，看着西娅一天天地变得不再是自己认识的那个西娅了，我的愤怒最终达到了极点。简直就像是英雄谭里登场的少年一样，将那个使徒的力量全部夺走了。因此西娅保持了她的弱小与纯真，我则变成了这样一个喜好阴险魔法的可疑男子了。；「啊~，这个嘛……我平时不是总说么。是真是假由听的人决定。」</data></node>
    <node id="拉丝缇娅拉复归与BOSS搜索请战（水之阶层行进中）"><data key="name">拉丝缇娅拉复归与BOSS搜索请战（水之阶层行进中）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「寻找祭坛什么的简直蠢爆了再也不干了！继续朝深处前进吧！果然迷宫探索的醍醐味还是强敌呀！所以我们快去打倒怪物吧！」；在莉帕的努力下，拉丝缇娅拉满状态复活了。；最主要的目的还是魔石。BOSS怪物掉落的魔石，比一般的怪物掉落的纯度要高很多。</data></node>
    <node id="翌晨态度逆转：「万一」委托与威光压问"><data key="name">翌晨态度逆转：「万一」委托与威光压问</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「早上好呀～，会长！啊，让咱给你揉揉肩吧！？」；「抱歉⋯⋯咱们敞开天窗说亮话吧，魔王大人的事情，咱希望会长能施以援手⋯⋯」；「没事的。那家伙不会真的强迫别人做自己不愿意做的事情的」</data></node>
    <node id="诺斯菲求见罗德（涡波以朋友立场设限后允诺）"><data key="name">诺斯菲求见罗德（涡波以朋友立场设限后允诺）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">脸上一直挂着柔和的笑容的诺斯菲表情染上了一丝阴霾。；「⋯⋯涡波大人，请务必让我与罗德相见」；「⋯⋯我也没法断言说自己一点儿都不恨她。毕竟杀死我的人就是她呀。</data></node>
    <node id="汇合抉择与南行提议"><data key="name">汇合抉择与南行提议</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「人家觉得无所谓哦。要不就先去南边吧」；对走过千年人生的她来说，这可能只是稍微绕个远路而已吧。因为她很清楚该回去的地方，也知道该和自己一起回去的人选，所以并不急于一时。；──正当我对如何抉择感到迷茫之时，一道反对的声音从意料之外的方向传来。</data></node>
    <node id="十五层刷怪与教会升级"><data key="name">十五层刷怪与教会升级</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【状态】</data></node>
    <node id="午餐戒指修罗场"><data key="name">午餐戒指修罗场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">正当我打算就这样保持沉默穿过设置在办公室的『Connection』的时候——技能『感应』敲响了警报。；啪啦一声，戒指落到了桌上。；「诶，这个？是大哥哥刚才送给人家的。」</data></node>
    <node id="共鸣魔法定名『Flame・Aegis（守护炎）』"><data key="name">共鸣魔法定名『Flame・Aegis（守护炎）』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">让涡波来决定吧？涡波不是自创了很多魔法来着；『Aegis』怎么样？在我的世界中，象征着守护某人的意思；这个魔法是为了守护涡波先生的魔法。──那就叫它共鸣魔法『Flame・Aegis（守护炎）』好了</data></node>
    <node id="真名呼称与铳剑决斗的终局"><data key="name">真名呼称与铳剑决斗的终局</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德！不，缇缇！！；我的《新月琉璃》将缇缇的《风之铳剑》——给斩断了。；——没错，是我赢了！！我不是一直都说了么！你很弱啊！</data></node>
    <node id="基督×莱纳'两个人都能获救的道路'对谈"><data key="name">基督×莱纳'两个人都能获救的道路'对谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这都是考虑到优先顺序的问题啊⋯⋯！哪怕是为了大家，也不能牺牲基督，而应该牺牲我才对⋯⋯！」；「──争论哪一方应该牺牲之类的事还是算了吧。莱纳，我们就两个人一起互相帮助，一起去寻找两个人都能获救的道路好了。；这就是像石头一样顽固的莱纳态度终于软化的瞬间。</data></node>
    <node id="大堡垒『维度』侦察：中庭三人异常魔力对峙（ch144）"><data key="name">大堡垒『维度』侦察：中庭三人异常魔力对峙（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">同时广阔的展开『维度』；意识伸展了出来。这是和一种鸟在空中飞翔的主观感很相似。感官延伸到了堡垒，空间的情报传入了脑海里。；那之中有个最异常的地方─────那就是中央的庭院。</data></node>
    <node id="千年前之梦·第二夜：魔法开发与四人北上"><data key="name">千年前之梦·第二夜：魔法开发与四人北上</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而是未在之前的梦中出现的第四个登场人物。；「才怪，我根本没什么病！健康得很！阳滝，是你在骗她才对吧！」；「西斯，我们去『北方』吧。必须收集更多的魔力才行。」</data></node>
    <node id="抚摸消逝之愿未成（十五分钟）"><data key="name">抚摸消逝之愿未成（十五分钟）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">若能得到涡波大人的抚摸，那我便能消失了吧。是啊，我的愿望真的仅此而已」；少女将双手合并在一起，祈望着自己的消逝。；──终于，一场永劫无尽的战斗结束了。</data></node>
    <node id="火焚击杀锯齿甲虫"><data key="name">火焚击杀锯齿甲虫</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】锯齿甲虫：位阶3</data></node>
    <node id="『并列思考』全解放·感情洪流自力克服"><data key="name">『并列思考』全解放·感情洪流自力克服</data><data key="type">event</data><data key="status">provisional</data><data key="desc">────说着我将抑制着的『并列思考』完全解放了。；第一次的『反馈』时，靠着帕林库洛的精神魔法逃出了循环。丑陋的哭泣呼喊，帕林库洛来帮助了我。；这是属于『我的东西』</data></node>
    <node id="始祖涡波与罗德初遇（凯旋游行远观·错过）"><data key="name">始祖涡波与罗德初遇（凯旋游行远观·错过）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">金发的女性是使徒西斯。黑发少女是阳滝。最年少的少女为缇娅拉。而戴着假面的少年则是始祖涡波──也就是我吧。；「总觉得⋯⋯，那个国王大人，好像很痛苦的样子。现在也是，总觉得她在渴求着什么人能拯救她⋯⋯」；最初的相遇，我与罗德彼此错过了。</data></node>
    <node id="海莉・维斯普洛佩遭遇战（突如其来的再会）"><data key="name">海莉・维斯普洛佩遭遇战（突如其来的再会）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">她在一丝不挂的状态下钻出水面，并被我目击到这一幕。；「──『镌刻次元之风啊』、『绞杀世界之音吧』──」；「──『Sehr・Wind』！」</data></node>
    <node id="63层PaleGriffin遭遇与呼群撤退"><data key="name">63层PaleGriffin遭遇与呼群撤退</data><data key="type">event</data><data key="status">provisional</data><data key="desc">徘徊在六十三层的主要的怪物叫做「PaleGriffin」。；这家伙是一遇到危险就撒腿逃跑然后呼唤同伴群殴的类型。；「不了。暂时撤回六十四层吧」</data></node>
    <node id="塞拉遭世界奉还阵集中削弱（168话）"><data key="name">塞拉遭世界奉还阵集中削弱（168话）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">将咒术『世界奉还阵』的对象集中设置为塞拉・蕾蒂安忒；塞拉跑动的速度突然开始减慢。；不，不光是魔力。塞拉的存在本身都在变薄弱。</data></node>
    <node id="精神污染装备修复训练（成败清单）"><data key="name">精神污染装备修复训练（成败清单）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，原本带有精神污染的问题儿童们纷纷获得新生。；我记得这些都是在三十三层附近陪拉丝缇娅拉寻宝的时候捡来的东西。因为『表示』上显示有精神污染的字样，所以全都被我破壊了。；当然，成果算不上完美。有几件的修理以失败告终，再也无法使用了。</data></node>
    <node id="水晶魔法『Quartz』显现：沙石化为宝石金砂、甲板宝石长河"><data key="name">水晶魔法『Quartz』显现：沙石化为宝石金砂、甲板宝石长河</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──水晶魔法『Quartz』──；转换成了操纵水晶的『地之理的盗窃者』的魔力，侵蚀着飞舞的沙粒。；我得到了『窃夺世界之理』的一部分力量。</data></node>
    <node id="天上之七骑士舞会遭遇"><data key="name">天上之七骑士舞会遭遇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「唔……你是基督·欧亚……？」；「不可以。涡波是我的会长，是我的搭档。我不能将他让给弗茨亚茨。」</data></node>
    <node id="出发准备与史诗探索者送别"><data key="name">出发准备与史诗探索者送别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在工房入手了足够的装备和资金之后，我们就离开了公会『史诗探索者』；「一路走好～。要保重哦，缇缇酱～」；我毫不吝惜地将在联合国少有的高级魔石大卖特卖，结果又入手了天文数字的现金。</data></node>
    <node id="挑战艾德一方与四败于『支配之王』"><data key="name">挑战艾德一方与四败于『支配之王』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「可是，到了那个时候，艾德的身边已经有『支配之王』在了。而且还有被使徒控制的缇亚」；「『支配之王』只用一只手就把我摆平了⋯⋯！简直、简直就像是在玩弄一个小孩子一样⋯⋯！就像是在说我跟她不在一个层次上一样⋯⋯！！」；「到头来，我们一共和『支配之王』战斗过几次来着⋯⋯？我记得一共是四次吧，全部都是完败啊⋯⋯越是战斗，过程就越是凄惨，我现在还记得呢。啊啊，好不甘心啊⋯⋯看到『支配之王』以骇人的速度不断强化，我甚至觉得好不讲道理⋯⋯所以，在进一步惨败之前，我们不得不收手」</data></node>
    <node id="缇缇被压制与艾尔芬里斯舍身"><data key="name">缇缇被压制与艾尔芬里斯舍身</data><data key="type">event</data><data key="status">provisional</data><data key="desc">确认到这一点的诺斯菲击破缇缇的防御架势之后，向她使出一记回旋踢。；明明缇缇勉强用铳剑的末端防住了这记踢击，却还是被一脚踢上高空。；『光之理的盗窃者』的全力一击，将龙那坚硬的腹部击穿，光枪一直插穿至飞龙的嵴背。但是，也就到那为止了。尽管艾尔芬里斯的龙血如雨般洒落，它仍旧凭借自己那强韧的身躯将光枪挡下，护住了缇缇。</data></node>
    <node id="诺斯菲说服罗德·解放沃尔斯灵魂"><data key="name">诺斯菲说服罗德·解放沃尔斯灵魂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊，可怜的罗德。既然这样，就让我来消除你的后顾之忧好了。」；需要在『这里』继续保有意识的只有『你』和『我』、再加上『臣子』和『弟弟』，这四人就足够了。至于其他人就让他们彻底成为观众吧。；还是让沃尔斯将军的灵魂获得解放吧。</data></node>
    <node id="城内带路与Dimension封禁"><data key="name">城内带路与Dimension封禁</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊，那·个·行·为也禁止哦。『Zeitlos·Wind』。」；柔和的风吹了过来，『Dimension』因『魔法相杀』而被化解。；即使是之前的海因，使用同样的魔法时，充其量也只能做到妨碍罢了。</data></node>
    <node id="军势分析与帕林库洛负伤泄露判读"><data key="name">军势分析与帕林库洛负伤泄露判读</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我从『所有物』中取出纸张和羽毛笔，画出了兵力的分布。顺便也取出了各地区的地图，将军队的调动实时地传达给她。；玛利亚很娴熟地听取着我的汇报。而且她时不时还能够在我说出通过『维度』获得的情报之前说中军队的动作，看来她确实很擅长这方面的事。；「──看来军队的行动活性化了呢」</data></node>
    <node id="魔剑命名权让渡与『表示』判定"><data key="name">魔剑命名权让渡与『表示』判定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我一边同她道谢，一边对成品使用『表示』；我的『表示』能力给这把剑起了「始祖和魔王的魔剑」这么个名字。；「既然这样，那么这把剑的名字就叫『Fluorite』──不，『BraveFluorite』！这满溢而出的是勇气之光、那么它就叫『圣剑BraveFluorite』了！！」</data></node>
    <node id="世界奉还阵完全发动与战场生命溶解"><data key="name">世界奉还阵完全发动与战场生命溶解</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——是以，『在此宣誓』。『苍穹既失，必由吾夺还』，『苍穹既逝』『必由吾复苏』。『除天地之戾气，还世界以晴天』——」；「咒术构筑完毕——『世界奉还阵』启动」；可以说是象征着该人物人生本身的『Level』——堪称是其人生命本身的『最大HP』——像是被刨子一点点刨除一样减少着。</data></node>
    <node id="涡波竞技场护婚宣誓"><data key="name">涡波竞技场护婚宣誓</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——我在此宣誓！斯诺·沃克本人希望同我结为连理！其人之爱寄存于我，因而若想与斯诺·沃克完婚之人，势必先行战胜于我！不然，倘此剑高悬，则斯诺·沃克便永无成婚之理！！」</data></node>
    <node id="菲伊旧奴隶全员安置"><data key="name">菲伊旧奴隶全员安置</data><data key="type">event</data><data key="status">provisional</data><data key="desc">你们的所有权现在转移到了我手上。；从『表示』的状态来看，对于他们来说护卫的工作正可谓是天职。；还有就是想要被解放的人也请和我说。我不会对之后的事负责，但只要你们想，我就会解放你们。</data></node>
    <node id="断崖带RioshethEagle迎击战"><data key="name">断崖带RioshethEagle迎击战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而且，不仅没有立足点，还要在体势不妙的情况下战斗，但我们并不焦躁。只要有魔力的情况下，就绝对不会衰弱死。不论如何，我们都对彼此的配合有着绝对的信赖。；就这样被击穿心脏的RioshethEagle变成了光，魔石向着悬崖下方掉了下去。；接着，重复着迎击与爬坡二十分钟左右，终于到达了五十四层的楼梯前。</data></node>
    <node id="涡波身体恶化至极限"><data key="name">涡波身体恶化至极限</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「……糟透了。又想吐头又痛，还天旋地转的。意识也很模糊，感觉什么都搞不懂了。」；视觉机能几乎作废，我现在的视野有如淹没在水中。</data></node>
    <node id="下毒饮品警示与全名称呼"><data key="name">下毒饮品警示与全名称呼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『相川涡波・基督・欧亚・弗茨亚茨・冯・瓦尔德沃克』大人。请用这边的。您原先的饮品里被投放了药物」；果然没猜错，这里面是被下过毒的。</data></node>
    <node id="『维度』展开索敌与古奈尔脱逃"><data key="name">『维度』展开索敌与古奈尔脱逃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「古奈尔就拜托斯诺你了！──魔法『维度』！！」；「她刚才就逃掉了！在你们谈话的期间，她一边祈求着再也不见一边使出浑身的劲儿跑远了！！」；一边将『维度』布满『第二迷宫都市』，最先捕捉到的便是正在拼命逃跑的古奈尔酱</data></node>
    <node id="银铠组遭遇与拉丝缇娅拉治愈"><data key="name">银铠组遭遇与拉丝缇娅拉治愈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那就再见啦，相川涡波。啊，对了，我的名字是拉丝缇娅拉。你可要记好哦。」</data></node>
    <node id="涡波与帕林库洛最终剑斗"><data key="name">涡波与帕林库洛最终剑斗</data><data key="type">event</data><data key="status">provisional</data><data key="desc">尔虞我诈已经成为过去式。；「这样魔石就一人一个，条件终于公平了！而这最后的战斗，我绝对不会输！！」；彼此都只是在用稚嫩拙劣的剑攻击对方而已。简直就像是两个小孩子打架一样难登大雅之堂。</data></node>
    <node id="千年记忆物语的落幕"><data key="name">千年记忆物语的落幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德声嘶力竭的悲鸣为这段无比漫长的故事拉上了帷幕。；是由仿若天国般幸福的十一年、将那份幸福葬送的令人窒息的一百年、以及充斥诅咒和疯狂的一千年三个部分构成的物语。；释放出魔法《DistanceMute》的我的左臂也从罗德的胸口抽离。</data></node>
    <node id="莱纳专用装备·衣物制作（第三日完工）"><data key="name">莱纳专用装备·衣物制作（第三日完工）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">首先，为了跟莱纳的发色相匹配，对色彩的平衡进行调整。接着，为了强调他作为骑士的身份，还得施加一些即兴设计的纹章。；不知为何。我在设计独创的纹章时感到特别激动。因为总觉得这就跟设计相川涡波队伍的标志一样。；因此，不光用上技能『锻冶』和技能『神铁锻冶』，我久违地连『缝纫』也动员上了。</data></node>
    <node id="别墅再会·露洁诺瓦露初对面"><data key="name">别墅再会·露洁诺瓦露初对面</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「欢迎回来！莱纳君～！」；「非也，露洁我们也不是白给的，相川涡波先生，你的实力如何，我们还是能看出来的。唔姆，自诞生以来，我们这还是第一次见到英雄啊。请多关照，红色的名叫露洁，黑色的叫诺瓦露。因为长相相似分辨起来不容易，你就用颜色为特征来区分我们吧」；「不是什么双胞胎。只是制造她们的『素体』相似罢了」</data></node>
    <node id="拘束预案敲定与刑具借用·留船决定"><data key="name">拘束预案敲定与刑具借用·留船决定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">但是清醒之后，又会开始暴走也说不定⋯⋯」；「可以从『史诗探索者』那里借来拘束用的道具。；总而言之，已经确定在状态稳定之前要一直待在船上了。</data></node>
    <node id="帕林库洛『魔法阵』发动宣言与杀戮授权"><data key="name">帕林库洛『魔法阵』发动宣言与杀戮授权</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──没办法了！使徒，我要发动事先准备的『魔法阵』了！；只凭她这副表情，就足以让我认识到帕林库洛的『魔法阵』有多危险了。；刚才的发言很有可能是为了帮助西斯脱困。</data></node>
    <node id="『这里』国民总退场（咒术忘却扩散）"><data key="name">『这里』国民总退场（咒术忘却扩散）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──咒术『忘却扩散（Reverse）』！！；触及旋风的人，都在一瞬间化作了齑粉；罗德要让存在于『这里』的国民全部退场</data></node>
    <node id="五十守护者罗德初遇"><data key="name">五十守护者罗德初遇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一个少女从窗外飞进了房间；【五十守护者（FiftyGuardian）】风之理的盗窃者；「初、初次见面……我是相川涡波……」</data></node>
    <node id="『维度』北方全域观测与军势预测失败"><data key="name">『维度』北方全域观测与军势预测失败</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我进一步拓展开『维度』，把握整个战场的情况。既然已经决定了要在两军混战的时候袭击帕林库洛，我就必须了解这场战争的动向。；我用『维度』将瓦尔德本土北部平原全部覆盖住。不过考虑到我现在的魔力，密度真的很小很小。；我按照地图的显示，顺便确认着地名。瓦尔德国北面的科斯特地区和科纳地区。还有北面的劳拉维亚国的利维拉地区和阿尔德纳地区。通过掌握这四个地区的状况，我得以观测到与这场战争有关的所有士兵的行动。</data></node>
    <node id="海因真决斗"><data key="name">海因真决斗</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——『Sehr·Wind』。」</data></node>
    <node id="金砂双少女遭遇与基督误认"><data key="name">金砂双少女遭遇与基督误认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——别管那么多、总之快带我去见帕林库洛！」；在两名少女抵达东南方的国家古尔亚德附近时，我的远超追踪也迎来了极限。</data></node>
    <node id="千年前北方战争与支配之王弃军逃走（据雷纳尔多讲述）"><data key="name">千年前北方战争与支配之王弃军逃走（据雷纳尔多讲述）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我等北方诸国与南方国家那时进行着一场战争。而罗德则是君临于战争顶端的御旗。；在战争即将迎来胜利的时候，『支配之王（Lord）』和『近卫骑士团长』两人却逃走了。对自己率领的所有士兵见死不顾，舍弃应当守护的人民，就那样不知所踪」；听到这危险的说法，我皱紧了眉头。打造出这个空间的恐怕就是我。</data></node>
    <node id="第二次『雪风』·帕林库洛大卸八块仍笑"><data key="name">第二次『雪风』·帕林库洛大卸八块仍笑</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「上吧，莱纳！阿雷亚斯流共鸣剑术──」；「──雪，──『雪风』！！」；帕林库洛的所有黑色手臂全部被从根部斩断，他失去了所有的武器。胴体也被拦腰斩成两段，上半身和下本身分了家。黑翼和狼足也一样满是疮痍，无法支持他移动了。</data></node>
    <node id="阿尔肯赌局（悬影竞赛）"><data key="name">阿尔肯赌局（悬影竞赛）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们就获得了十一个悬影的掉落物。</data></node>
    <node id="千年前死神战争生涯"><data key="name">千年前死神战争生涯</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不消多久，我便在战场上被冠以『死神』之名，令人闻风丧胆。；为了讨伐南军的『死神』，当时的北军打出了最强的一张牌。</data></node>
    <node id="『应有的姿态』暴露：自相残杀危机"><data key="name">『应有的姿态』暴露：自相残杀危机</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──因此准确地说，是我身体的异变遭到了强行治愈，恢复了『正常』；──我身上的魔法在逐渐解除。；──『漆黑的天空』──高耸宏伟的城堡──数不清的人痛苦地喘息着──守护着人们的戴着假面的男子与少女</data></node>
    <node id="白樱通信机来电（艾德）"><data key="name">白樱通信机来电（艾德）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">（──请・诸・位・留・步）；（总算是上钩了啊。如此异质的魔力，鄙人绝不可能认错。好久不见了）；（我等的『支配之王』啊、久疏问候，您别来无恙吗？）</data></node>
    <node id="西娅·勒伽西登场与海莉离船"><data key="name">西娅·勒伽西登场与海莉离船</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「她·是·我·们·队·伍·的·领·队，西娅·勒伽西。听名字你们可能就知道了，她是帕林库洛的侄女。」；姓名：西娅·勒伽西HP23/23MP17/17职业：探索者；「不过，xiangchuan·wobo这名字真是稀奇啊~。Xiangchuan什么的，真是相当罕见的名字……嗯？xi、xiangchuang……？啊，诶、相川·涡波？真的假的？」</data></node>
    <node id="艾德举手投降与中立离场"><data key="name">艾德举手投降与中立离场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着甚至为了表明自己没有战意，直接举起了双手。；那么鄙人投降。这就离开这里。毕竟想问的已经都问完了呢；在我们与西斯对峙的期间，三对六转变为二对六了。</data></node>
    <node id="扉页『支配之王』·罗德否认己名·第一章『支配之王的觉醒』开幕"><data key="name">扉页『支配之王』·罗德否认己名·第一章『支配之王的觉醒』开幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">写在上面的是『支配之王』四个字。；而第一章的题名就是『支配之王的觉醒』；「没错，的・确・不・对。就像你觉得这不对一样，你所在的地方也不是什么深渊，也许你觉得周围都是悬崖峭壁，但其实那是一条平坦的大道──！」</data></node>
    <node id="莉帕的介入与后宫提案"><data key="name">莉帕的介入与后宫提案</data><data key="type">event</data><data key="status">provisional</data><data key="desc">现在你要是轻易采取什么行动的话，真的会死掉的哦？；无论是谁，都不会接受大哥哥与别人在一起的事实的。毫无疑问。；「——唔嗯~。要不然就把大家都迎娶为妻吧。你选一个喽。」</data></node>
    <node id="涡波经『连接』回归史诗探索者本部"><data key="name">涡波经『连接』回归史诗探索者本部</data><data key="type">event</data><data key="status">provisional</data><data key="desc">离开联合国南部的海面，我来到了劳拉维亚。；我打算半永久地保持留在这个房间里的『连接』；「早，早上好～⋯⋯⋯还是该说我回来了比较好吗？」</data></node>
    <node id="涡波决意转变（弃逃·誓亲自了断并改变未来）"><data key="name">涡波决意转变（弃逃·誓亲自了断并改变未来）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在五十层从诺斯菲面前逃走，在御殿又从罗德身边逃走！从千年前北方的人民的叱责中逃走、从贝丝的面前逃走、一路逃啊逃逃啊逃就知道逃！；「被托付了罗德的事的人是我・自・己・啊⋯⋯！艾德才是跟现在的『这里』毫无关系的人才对不是吗⋯⋯！！」；『这里』不仅仅是清算罗德的罪孽的地方，同时也是清算『始祖涡波』的罪孽的场所。</data></node>
    <node id="魔石携带品变现与财政破产"><data key="name">魔石携带品变现与财政破产</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我留下可能在地上还派的上用场的新月线形石之类的魔石，其余积攒的魔石则全部在这里变现了。再加上似乎只能在这里换钱，所以就顺便把『所有物』中能卖钱的东西也全部兜售了。；虽然魔石呀钻石呀什么的不值几个钱，但是丝线和锥子之类的日用品能卖个高价这点算是不幸中的万幸。视文化和状况的不同，需求和价值似乎会产生巨大的差别。；最惨的是，在千年前的世界，如果要学习魔法的话根本不需要使用魔石，而是依靠自己的力量掌握这点。由此，我也理解了为什么在这个时代，魔石的价值跟会跟千年后有这么大的出入了。</data></node>
    <node id="始祖涡波躯壳召唤"><data key="name">始祖涡波躯壳召唤</data><data key="type">event</data><data key="status">provisional</data><data key="desc">亦即帕林库洛没能成功驱使自己那已经被封印的魔力。；『始祖涡波』的躯壳！我想你也知道的，这家伙的体内可没有灵魂！；当我确认完那串模糊不清的名字时，假面男子的假面如同风化崩溃的沙尘一样散落而去。</data></node>
    <node id="沃克家诀别宣战(当主对峙)"><data key="name">沃克家诀别宣战(当主对峙)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">斯诺的义母优雅地坐在房间中央的椅子上。在她周围，守候着众多侍从和身强力壮的警卫。；「如果你打算违背斯诺的意愿把她抓起来的话，我就要叫人了。虽说斯诺在比赛中战败，但是她仍然是『舞斗大会』的参赛者。她的人身自由由联合国保障。</data></node>
    <node id="第五次迷宫探索出发·直接回归地上宣言"><data key="name">第五次迷宫探索出发·直接回归地上宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">通过到五十七层尽头为止的捷径。；但那说到底，都是在保证了妹妹（我）的身体的『安全』基础上，以『脚踏实地地前进』为方针所说的『最快速度』；所以，我为了不后悔而做出了打算进行『最高难度』的迷宫探索的宣言。</data></node>
    <node id="七人游泳练习开始"><data key="name">七人游泳练习开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这样的话就跟玛利亚她们一起练习吧。一定会很开心的」；在船内的隐蔽处换好泳衣之后，与同伴们一起七个人的游泳练习就开始了。</data></node>
    <node id="公馆客房初战：光腕格挡与『炎之矢』直击"><data key="name">公馆客房初战：光腕格挡与『炎之矢』直击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">目前就好像缇亚和西斯共同存在的状态，刚才的抓取没有理由会被避开，不论速度和技术我都是压倒性的有利。；就好像叩击中空的管子一样发出共鸣声，剑被弹开了。；随着西斯的动作，玛利亚咏唱的魔法直接命中了西斯。</data></node>
    <node id="帕林库洛黑剑偷袭与濒死"><data key="name">帕林库洛黑剑偷袭与濒死</data><data key="type">event</data><data key="status">provisional</data><data key="desc">然而魔法的构筑却被从身后袭来的黑刃打断了。；他回收了我刚才脱手的缇达的魔石，将之变成了一把黑剑向我发动了攻击。；但是魔法的构筑就白费了。明明光是对付『始祖涡波』就已经很吃力，再加上帕林库洛，我的计算完全乱套了。</data></node>
    <node id="缇亚的濒死抉择"><data key="name">缇亚的濒死抉择</data><data key="type">event</data><data key="status">provisional</data><data key="desc">梦想固然比生命更重要，但基督却比我的梦想还要重要啊。；从现在开始，『我（私）』的一切都将献予基督——</data></node>
    <node id="诺斯菲夜袭·索求夫妻『证明』"><data key="name">诺斯菲夜袭·索求夫妻『证明』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">与昨天不同的是诺斯菲正骑在我的身上，从秀口中伸出粉红色的柔舌舔舐着我的脸颊。；我现在正呈大字体仰面躺在床上，而双手双脚都被通过魔法制造出来的耀眼的绳子捆了起来。；「是了，这是理所当然的……！因为我们原本可是夫妻啊……！</data></node>
    <node id="屋顶追逃与脱鞋甩踪（贝丝恸哭震动佩艾希亚）"><data key="name">屋顶追逃与脱鞋甩踪（贝丝恸哭震动佩艾希亚）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">以佩艾希亚的街道为场景展开的捉鬼游戏就这么开始了。；我将『烧焦的异界鞋』收进『所有物』中，尽可能减轻脚步声。；啊啊，团长大人是真的从『这里』逃走了⋯⋯！！」</data></node>
    <node id="水晶魔法『Quartz』觉醒"><data key="name">水晶魔法『Quartz』觉醒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——水晶魔法『Quartz』——」；我得到了『窃夺世界之理』的一部分力量。；普通的石头变成了宝石，沙子变成了金砂</data></node>
    <node id="石英巨蟹初遭遇战（涡波单杀+三人连携）"><data key="name">石英巨蟹初遭遇战（涡波单杀+三人连携）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">路上遭遇了一种第一次见到的怪物。；水晶发出竹子断折般的清脆声音破碎了。；玛利亚的火焰阻碍了石英巨蟹的视野，拉丝缇娅拉挡开蟹钳的攻击。接着缇亚射出『炎之矢』，将石英巨蟹吹飞。</data></node>
    <node id="魔法屋购物与鉴定"><data key="name">魔法屋购物与鉴定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是种非常稀有而且久远的属性。</data></node>
    <node id="弗茨亚茨城后最终决战：双半死体对决·世界奉还阵吞噬二人"><data key="name">弗茨亚茨城后最终决战：双半死体对决·世界奉还阵吞噬二人</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[就、就算这样我也不如你吗！？既然如此，那就再撰取更多的力量——！给我更多更多的力量——！只要用这『世界奉还阵』的话啊啊啊啊——！！]；孤也拿出了全力化作了『半死体』，结果演变成了怪物和怪物相争的巅峰对决。；——到最后，根本没能说服诺斯菲，两个人就一起同归于尽了。</data></node>
    <node id="帕林库洛位置情报与书信入手"><data key="name">帕林库洛位置情报与书信入手</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我知道哦！叔父大人的话，在距离这边稍微偏北的方向。据说他现在正在最前线指挥军队来着！」；「基督，她不可能把那么细节性的东西记得一清二楚的，你就放弃吧。如果你想知道的话，就跟我们去别墅那边好了。看到留在那里的书信的话，立马就知道了。」；我一边将西娅给我的书信收进『持有物品』，一边用『Dimension』规划逃走的路线。</data></node>
    <node id="贝丝街道遭遇与协助请求决裂"><data key="name">贝丝街道遭遇与协助请求决裂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──伊丽莎白・沃尔斯很强。；由此看来，她与其他的骑士不同，记忆是连续的。；而雷纳尔多先生在这个情况下正一个人孤军奋战──」</data></node>
    <node id="五十六层阶梯折跃点确保（连接×一再反转之光）"><data key="name">五十六层阶梯折跃点确保（连接×一再反转之光）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不到一个小时之后，我们就找到了通往五十六层的阶梯。接着，我在那附近挑了个合适的场所使用魔法。；「终于到了。这附近的话应该是安全的吧。──魔法『连接』」；在我生成紫色的门扉之后，诺斯菲接着我立刻使用出别种魔法。</data></node>
    <node id="仿造共鸣魔法开发与冰Aegis完成"><data key="name">仿造共鸣魔法开发与冰Aegis完成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">姑且就先从简单的冻结魔法开始吧。一开始先模仿玛利亚她们的做法比较合适；绝大多数都以失败告终，成功的只有对『Flame・Aegis』的仿造魔法一个而已。；没办法。首先还是试着去提高自己魔力的操作水平好了</data></node>
    <node id="成员分组与『干死帕林库洛小队』结成"><data key="name">成员分组与『干死帕林库洛小队』结成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「总而言之，要跟涡波一起去本土的也就我和玛利亚酱还有缇亚而已了。这样就漂亮地4对3了呢」；「那可不行。我总觉得你会擅自跑去战斗，然后就被人家反杀掉」；「那么我们就出发吧。也不能去海岸那种容易被发现的地方靠岸，我们就从这里直接翻上那座悬崖吧。我背着玛利亚酱跳上去，缇亚就拜托涡波了」</data></node>
    <node id="涡波杀意初立与『次元斩裂剑』"><data key="name">涡波杀意初立与『次元斩裂剑』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是我第一次遵从自己的心情，以杀死对手为目的去战斗。；为了牵引出它力量的一部分，我仅释放出了次元属性的魔力。；「──『次元斩裂剑』！！」</data></node>
    <node id="千年前·吸血鬼一族歼灭战"><data key="name">千年前·吸血鬼一族歼灭战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──而最初的一张照片则是『在某个公馆的地下、四肢被木桩钉穿的古奈尔酱』；无法容忍『魔人吸血鬼』的恶行的当时的我的战斗记录──就是『相川涡波』与『古奈尔・库洛尼科尔・修尔斯・历基亚・英格利特』的故事的情节。；从她的记忆看来，当时的我的姿态跟被唤作始祖涡波的时候相比，更接近于现在的我。虽然穿着的式样是异世界的风格，但头发和样貌几无变化。</data></node>
    <node id="雇佣护送的报酬结清与加护送别"><data key="name">雇佣护送的报酬结清与加护送别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">把这一路的报酬付给你吧；我和缇缇都将自心而发的魔力灌注于「赐予他们一些加护吧」的祈愿之中。；像是被什么诅咒缠上了身一样颤抖了一番</data></node>
    <node id="『置换』：使徒西斯凭体显现"><data key="name">『置换』：使徒西斯凭体显现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">缇亚的魔力咕咚咕咚地开始脉动。魔力开始了转换，就像血液循环一般。；「──别来无恙。『进展如此顺利』实是一桩美事，盟友」；『感应』发来了强烈的警告。</data></node>
    <node id="玛利亚的深夜谢罪与告白"><data key="name">玛利亚的深夜谢罪与告白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那一天，我背叛了涡波先生。恩将仇报，甚至要夺走你的性命……」；玛利亚拒绝了契约。；本人玛利亚最喜欢的人就是相川·涡波。</data></node>
    <node id="任性之托：让罗德恢复精神"><data key="name">任性之托：让罗德恢复精神</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我敏锐的感觉技能捕捉到了她的动作。但因为她的举动中没有任何敌意，也没有蕴含丝毫魔力，所以我没有挥开她的手。；「──那请您听我说句任性的话吧。如果可以，能否请您让我的『朋友』罗德恢复精神呢？倒不至于让您说服她。至少让她恢复到以往的状态就好」；「可能的话，我想跟罗德和好。因为我和罗德是『朋友』啊」</data></node>
    <node id="探病与圣诞祭得知"><data key="name">探病与圣诞祭得知</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我会在成为与基督相配的存在之后再回到你身边的……！」</data></node>
    <node id="巨型西瓜虫讨伐（第二次救援作战）"><data key="name">巨型西瓜虫讨伐（第二次救援作战）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──啊，不对、稍等一下。这个感觉、它好像是在追着什么⋯⋯？在它的前进方向上有其他人⋯⋯？」；我拓展『维度』的范围，结果发现了和我们一样驾着马车移动的团体。马车一共有四辆，应该说是车队更准确。；「毕竟是认识的人被缠上了啊⋯⋯」</data></node>
    <node id="罗德示范风属性咒术咏唱与代价揭示"><data key="name">罗德示范风属性咒术咏唱与代价揭示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在解释的过程中，罗德的魔力突然膨胀。；『玉座既临路一条』；──风魔法『风』！」</data></node>
    <node id="归乡创伤与我（私）之死"><data key="name">归乡创伤与我（私）之死</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那孩子是我的弟弟。在我不知道的情况下，我居然有弟弟了。；「那我呢？」；这一瞬间，便是『我（私）』人生的终点。</data></node>
    <node id="玛利亚怒斥·打醒自暴自弃的涡波"><data key="name">玛利亚怒斥·打醒自暴自弃的涡波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那道火焰轻微的拂过我的右脸。；「──帕林库洛是绝对，绝对不会拯救涡波先生的。他是敌人。除了敌人不可能是别的，所以请你不要再『自暴自弃』了，快继续跟帕林库洛战斗，拿出你的全力来⋯⋯！」；我曾那样厌恶海莉的自杀行为，结果现在自己却在做一样的事。</data></node>
    <node id="诺文南区身份揭露与被捕"><data key="name">诺文南区身份揭露与被捕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从南面很远处传来了古怪的声音。；下一场准决赛是我对拉丝缇娅拉，诺文则要对战瓦尔德的国家代表。</data></node>
    <node id="魔法使对决：拉丝缇娅拉胜涡波"><data key="name">魔法使对决：拉丝缇娅拉胜涡波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我展开魔法之冬，妨碍拉丝缇娅拉的魔法构筑，让冰箭雾散。；毫无疑问，这场魔法对决，我正处于劣势。；『冰BatteringRam（冰霜破城槌）』！！</data></node>
    <node id="总力战分击协议与开战"><data key="name">总力战分击协议与开战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在烈焰的环绕之下，两名守护者与两名挑战者相向而立。；接下来只要还有一丝希望，我都会战斗到最后；四个人的利害达成了一致。</data></node>
    <node id="西迷宫熔封判明（同死神相伴的魔女传闻）"><data key="name">西迷宫熔封判明（同死神相伴的魔女传闻）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「据说是『同死神相伴的魔女』用火焰魔法将迷宫的出入口熔解了。整个迷宫的周围都化作了熔岩地带，要恢复通行似乎要等上很久的时间。⋯⋯这个还是亲自去看看情况比较好吧。咱有点半信半疑的说」；『大洞』周遭已经化作了熔岩之海。；「既然传闻说是什么『同死神相伴的魔女』，那应该不会有错了⋯⋯」</data></node>
    <node id="二十四层熔岩突破未遂"><data key="name">二十四层熔岩突破未遂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】毒之火蜥蜴：位阶23</data></node>
    <node id="罗德揭示『诺斯菲是涡涡的妻子』·双技能同时警报"><data key="name">罗德揭示『诺斯菲是涡涡的妻子』·双技能同时警报</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「才不好啊！人家也是女孩子，只有这件事绝对不能就这么算了！不管忘了什么都无所谓，但是诺斯菲是涡涡绝对不能忘记的人啊！因为、因为──！！」；「因为诺斯菲可是涡涡的『妻子』啊！！」；你要问为什么，那是因为按理来说只有在我快死翘翘的时候才最为活跃的技能们──『感应』和『最深部之誓约者』居然同时发动了诶。</data></node>
    <node id="涡波恐惧发作与莱纳看护"><data key="name">涡波恐惧发作与莱纳看护</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就是说如果我带着诺斯菲去见地上的同伴们的话，那危险度比我在迷宫里差出40级以上的地方探索还高呗。⋯⋯好吧，有道理，我无法否定。；大家可以想像一下，让我跟她们再会的时候「啊，介绍一下，这位是我老婆诺斯菲」试试，空气当场冻结？不存在的，朋友，这句话会直接成为我的遗言。；说实话。好恐怖，我不敢回地上了。</data></node>
    <node id="魔王城别名与无人之谜问答"><data key="name">魔王城别名与无人之谜问答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为没有相应的订单啊。就算有也都是生活用的魔法道具而已；需求不是没有。但现在已经没有人待在会产生需求的场所了；「没错，就是『佩艾希亚城』」</data></node>
    <node id="帕林库洛怪物化·合成兽自强化"><data key="name">帕林库洛怪物化·合成兽自强化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错，我已经没法对怪物们进行制御了。本来我就有不死身的特性，虽然这样做不好看所以我不太喜欢，但是拿来当自爆战术用用也没什么不妥」；「──不过，就让我借用一匹的身体好了」；抓住一匹有八只眼睛的巨狼，帕林库洛身上的黑色液体向它涌去。黑色液体像活着的触手一样将巨狼缠绕起来。</data></node>
    <node id="海莉残渣消散——真正的永别"><data key="name">海莉残渣消散——真正的永别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──『诶诶。然后，该道别了。被『世界奉还阵』吞噬的我的残渣已经所剩无几。但是，涡波君能在完全消灭之前来到这里真是太好了』；最后，海莉嫣然一笑。；她就这样笑着、消失了。</data></node>
    <node id="佩艾希亚首都陷落与孤儿院沦陷"><data key="name">佩艾希亚首都陷落与孤儿院沦陷</data><data key="type">event</data><data key="status">provisional</data><data key="desc">位于大陆北方中心地带的佩艾希亚首都，被南军攻克了。城陷之时正是北方战败的瞬间。；自然而然的，孤儿院也遭到占领，成为押放非军属的所谓『污秽的魔人』的地方。；[——缇缇姐姐大人……我们在这之后究竟会被怎么样呢……？]</data></node>
    <node id="涡波的战术指示"><data key="name">涡波的战术指示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">对于战胜『光之理的盗窃者』而言所必须的，既不是我也不是莱纳。；「这里先交给我！缇缇那边就拜托你了！在『这里』的话，她可以跟那个时候的莱纳一样，无止境地变强！你去让她注意到这点！！」；只要在『这里』战斗，缇缇就是最强的。</data></node>
    <node id="古尔亚德出航与高速渡海"><data key="name">古尔亚德出航与高速渡海</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从古尔亚德的港口出发的我和缇缇目前正在驾船航行。；在缇缇的风的加持下，整艘船就像上了喷气式发动机一样驰骋在辽阔的海面上。；以风圈残云的气势在海上掀起一阵阵的轰鸣，让擦肩而过的其他船只咄咄称奇、将睡眠和魔法重复上演的几天就这样过去──我们终于抵达了本土的港口城市『柯尔库』附近的海域。</data></node>
    <node id="诺斯菲指控涡波千年前罪行（欺骗害死住民）"><data key="name">诺斯菲指控涡波千年前罪行（欺骗害死住民）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「你⋯⋯、你是说『佩艾希亚』变成这样都是我的错吗？」；「正・是。在这佩艾希亚曾经生活着成千上万的人。而涡波大人您却欺骗了他们所有人──并最终害死了他们。如果说这都不是罪孽，那还有什么能算得上罪孽呢。</data></node>
    <node id="奴隶拍卖场潜入与玛利亚初遇"><data key="name">奴隶拍卖场潜入与玛利亚初遇</data><data key="type">event</data><data key="status">provisional</data><data key="desc">果然是奴隶的拍卖场。</data></node>
    <node id="弗茨亚茨图书馆敌情调查（无果）"><data key="name">弗茨亚茨图书馆敌情调查（无果）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">现如今有可能成为敌人的是『光之理的盗窃者诺斯菲』『木之理的盗窃者艾德』『使徒西斯』这三人。；不过，我跟缇缇讲明此行的意图之后，她却表示「诶、那种东西不可能留得下来的吧？」；靠着塞拉的介绍信获得了浏览的权限</data></node>
    <node id="缇亚真性暴露与打晕稳定化"><data key="name">缇亚真性暴露与打晕稳定化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊~那个啊。是有说过呢。对不起，缇亚，那是骗你的。」；幸好缇亚的身体能力不高，她很快就被我和拉丝缇娅拉捕获，并就这样借拉丝缇娅拉之手让她失去了意识。</data></node>
    <node id="告白延期·静观其变决断（三条件）"><data key="name">告白延期·静观其变决断（三条件）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">至少，到我能够对自己的心意抱有自信之前，先静观其变好了；也对啊。再等一等为好。知道欧尼酱与妹妹重逢……、或者说，至少也得等到击败帕林库洛·勒伽西为止呢；——直到解决技能《？？？》为止。</data></node>
    <node id="莱纳许誓『咏唱』完成契约"><data key="name">莱纳许誓『咏唱』完成契约</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「骑士莱纳・赫勒比勒夏因，愿意助你实现方才的誓言。；『亦・于此起誓，种种罪过，吾当清偿』『纵此世之终结至来，此誓亦无毁弃之日』──」；仍然完成了某种『契约』。很明显莱纳也付出了一份绝对无法无视的『代价』</data></node>
    <node id="缇缇的初泣与《支配之王》消灭"><data key="name">缇缇的初泣与《支配之王》消灭</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——在·那·一·天，在她的心脏被捣碎的那一刻，她就到极限了。；抛下自己立场和名字，缇缇像一个孩子般不顾什么颜面地哭了起来。；缠绕在缇缇身上的凶恶魔力也一并雾散。</data></node>
    <node id="拉丝缇娅拉・弗茨亚茨现身"><data key="name">拉丝缇娅拉・弗茨亚茨现身</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──斐・勒・卢・托。」；从房门开始，骑士们纷纷屈膝下跪，一名长发中络合着金银二色的少女走了进来。；──来者正是拉丝缇娅拉・弗茨亚茨。</data></node>
    <node id="咒术复得与复合咒术『咏唱』成立"><data key="name">咒术复得与复合咒术『咏唱』成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我对这件事予以正确认可的瞬间，『表示』的技能栏里边追加上了过去的技能『咒术』；「──咒・术『连接』、──咒・术『维度』！！」；「──复・合・咒・术『咏・唱』</data></node>
    <node id="千年前击沉友舰自白"><data key="name">千年前击沉友舰自白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「可、可是，跟千年前不一样，这次人家一艘船都没弄沉哦！？明明努力了好一把的说，应该再多夸奖人家一些才对嘛！！」；看来这丫头在千年前不惜击沉友方的船只也要将敌人打倒啊。难怪会被唤作『狂王』『魔王』之类的了。</data></node>
    <node id="新魔法试验与十层之门"><data key="name">新魔法试验与十层之门</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——咕。房间内的魔力太强了，门固定不了……！」</data></node>
    <node id="五十四层起强行军（『加速』连用·攻略时间减半）"><data key="name">五十四层起强行军（『加速』连用·攻略时间减半）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「接下来我也在前面挥剑吧。之后要更加的加快脚步才行」；就这样，认真的强行军开始了。；在祭坛上的珍宝神器也好全部无视。</data></node>
    <node id="阳滝魔石被剥离（幻之紫腕）"><data key="name">阳滝魔石被剥离（幻之紫腕）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『始祖涡波』没有伤及阳滝的身体，他那只『怪物』化的手温柔地抓住我的肩膀。；『噶啊、啊啊──A、Di──Di『幻之紫腕（DistanceMute）』！！』；『始祖涡波』的手握住了在我体内的──『魔石』</data></node>
    <node id="帕林库洛的复活许诺与涡波受降危机"><data key="name">帕林库洛的复活许诺与涡波受降危机</data><data key="type">event</data><data key="status">provisional</data><data key="desc">少年你就报上『基督（救世主）』的名字，在一旁守护不幸的相川兄妹让他们得到幸福便是。；我深陷于这份诱惑之中。如同一个寻求双亲的刚诞生不久的婴儿那般彷徨。；待到手与手相触之际，我的故事便会落幕吧。</data></node>
    <node id="马车上的赛鲁多拉情报问答"><data key="name">马车上的赛鲁多拉情报问答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然我自认过度发掘他人的过去不太好，但经历过那场战斗之后的缇缇似乎已经释怀。既然如此，那么我就当做这是通过说服将五十层守护者击破的报酬，尽情地去打听好了。；「首先我想问的是，这个赛鲁多拉是『理的盗窃者』吗？如果是的话，那么他就可能在七十层以下现身」；「可能的话，希望你再说得详细一些。另外还有其他在千年前的南北战争中登场的人、像是诺斯菲的三骑士还有使徒这些人也拜托了」</data></node>
    <node id="莱纳继承升级（真LevelUp）"><data key="name">莱纳继承升级（真LevelUp）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——怎能就这样把她交给你（世界）！若要支付『代价』我自会清偿！；——莱·纳『LevelUp（升·级）』了。；我确确实实地目睹了证明其神圣性的灵魂之光。</data></node>
    <node id="拉丝缇娅拉无双与组队规则实验"><data key="name">拉丝缇娅拉无双与组队规则实验</data><data key="type">event</data><data key="status">provisional</data><data key="desc">感觉如此一来也多多少少地搞清组队系统的机制了。</data></node>
    <node id="玛利亚素质壁垒告白"><data key="name">玛利亚素质壁垒告白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「越是升级，玛利亚反而越跟不上我们的水平。</data></node>
    <node id="『维度』检索发现学者手记·读至'二英雄背叛'绝笔"><data key="name">『维度』检索发现学者手记·读至'二英雄背叛'绝笔</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了知晓这个后续，我使用『维度』对周围的书进行检索。；似乎是住在这座城里的学者的手记。作者为了将之后的事流传下来，把・后・来・发・生的事记录在了手记中。；──『支配之王』和『近卫骑士团长涡波』消失了。</data></node>
    <node id="假名由来自白与政体杂谈"><data key="name">假名由来自白与政体杂谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这是在我原来的世界里非常有名的宗教和大陆的名字，我索性就拿来用了。</data></node>
    <node id="诺斯菲大笑自嘲生前称谓"><data key="name">诺斯菲大笑自嘲生前称谓</data><data key="type">event</data><data key="status">provisional</data><data key="desc">用与一贯贤淑的她不相称的表情，仿佛自暴自弃一样放声大笑。；这是在自上而下地做出鄙视之后，发自内心的『嘲讽』；我这种人居然也能称什么『圣女』做什么『偶像』、叫什么『御旗』说什么『精灵』，可笑至极。</data></node>
    <node id="玛利亚全魔力解放·闪耀吧炎剑扫讨与力竭昏倒"><data key="name">玛利亚全魔力解放·闪耀吧炎剑扫讨与力竭昏倒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「要做的话必须得我来做！如果要削减生命的话，就让我来吧！」；「你给我回想一下缇亚最后说的话啊！你给我回想一下离别前拉丝缇娅拉的表情啊！你给我回想一下在城堡战斗的斯诺的姿态啊！大家，全都是为了你，为了涡波先生你啊！！」；「就算涡波先生不叫涡波，我们也不在乎的。属于我们的涡波先生，就是现在存在于此的『你』啊。千年前也好，魔石人类也罢。我们喜欢的，就是现在存活在这里的你。大家，都是为了帮上你的忙，才会这么努力的哦！你快给我明白过来！！」</data></node>
    <node id="涡波对始祖涡波战（剑与次元魔术）"><data key="name">涡波对始祖涡波战（剑与次元魔术）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「都到这一步了怎么能就这么输掉！更何况对手还是自己！！──『耶梦加得之霜』！！」；两者方一接触，冰蛇便遭到捩转扭曲，一瞬间便破碎、四散开来。；『始祖涡波』仅仅依靠一句咏唱，便在世界上打造出一个空间断层。</data></node>
    <node id="MP枯竭与『连接』归船"><data key="name">MP枯竭与『连接』归船</data><data key="type">event</data><data key="status">provisional</data><data key="desc">差不多MP要用光了。拜托你使用『连接』了，涡波先生；蹑手蹑脚地走过『连接』。怀疑人生的拉丝缇娅拉也一样跟在我后面。；我们就这样回到了『LivingLegend号』上。</data></node>
    <node id="拉古涅决斗③"><data key="name">拉古涅决斗③</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从她空着的另一只手上伸出了一把固体化的魔力之刃。</data></node>
    <node id="莱纳的最终确认与同伴宣言"><data key="name">莱纳的最终确认与同伴宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我说，基督。我有一点想事先问清楚、对罗德和诺斯菲──你是打算帮助她们两个吗？」；「我知道，多谢了，莱纳。主要是罗德那边，我已经不觉得她是障碍（敌人）了」；「你不用向我道谢的。我是守护基督和拉丝缇娅拉的骑士──不，即使没有这些，我也是你的『同伴』啊」</data></node>
    <node id="HP补偿冻结与缇亚舍身"><data key="name">HP补偿冻结与缇亚舍身</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不够的MP会由命——、由最大HP来补偿。</data></node>
    <node id="诺斯菲×莱纳初会（诅咒残渣发作·摸头试留恋）"><data key="name">诺斯菲×莱纳初会（诅咒残渣发作·摸头试留恋）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「赫勒比勒夏因？」；听到他的名字，诺斯菲有些惊讶。不过她仍然优雅地向莱纳行了一礼。；被诺斯菲用从下往上看的小眼神请求的莱纳表现出了过剩的反应。</data></node>
    <node id="斯诺辞任总司令（章末预告）"><data key="name">斯诺辞任总司令（章末预告）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这位英雄斯诺・沃克，在之后与相川涡波重逢，并且其人所处境遇让罗德・缇缇生怒，结果立马就辞去了总司令的职务。；在那时，克洛伊・希达尔克才看到了斯诺・沃克这名少女真正的姿态。</data></node>
    <node id="战后对质——罗德留恋坦白与归还被拒"><data key="name">战后对质——罗德留恋坦白与归还被拒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯你为什么要做这种事。好好跟我解释一下」；「因、因为嘛⋯⋯，如果继续这样一帆风顺地前进下去的话，大家不是就会回到地上了么。人家一听到涡涡说结束了什么的──⋯⋯啊、对、对了！呐、要不就像刚才一样每到一层就把所有的怪物都消灭如何！？这样的话应该就能多拖延点时间了！！」；「罗德，这我做不到。我不尽快回到地上不行。妹妹和同伴们都在等我。拜托你了，请你理解我⋯⋯」</data></node>
    <node id="LivingLegend号探索方针会议（计划半毁改案）"><data key="name">LivingLegend号探索方针会议（计划半毁改案）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「首先，A队伍暂定为斯诺，缇亚，塞拉小姐。B队伍为拉丝缇娅拉，玛利亚，还有莉帕。这个组合的平衡性应该是最好的」；就依靠莉帕将魔力分给我进行补充；「呜呼呼，进入迷宫之前队伍就半毁了呢。事事不如意呀！真让人受不了呐！」</data></node>
    <node id="舞闘大会后逃亡·赌场筹钱开始"><data key="name">舞闘大会后逃亡·赌场筹钱开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">距从『舞闘大会』逃亡只过了几小时。；于是拉丝缇娅拉对我说着「稍微去赌场大闹一番赚个痛快吧。啊，绝对不准输哦。」便把我和塞拉小姐扔到了这里。；不过，只要入手了船的话，休息多长时间都可以。我在心中如此重复强调，驱使着疲惫的身体继续行动。</data></node>
    <node id="平等论战（莱纳自贬发言）"><data key="name">平等论战（莱纳自贬发言）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这世上的一切都是在级别序列的支配之下的。；他的话中甚至透露出一种只要为了我哪怕牺牲生命也在所不惜的危险想法。；我们是平等的。至少在人家眼中，莱纳绝对不是什么地位低下的人──」</data></node>
    <node id="废村宿营与彻夜MP回复（决前夜）"><data key="name">废村宿营与彻夜MP回复（决前夜）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「要赶上明天的袭击的话，现在先到这附近的村子去吧。在那里休息一晚上是最合适的」；那是一个因为战争的影响而被废弃的村子。虽然没有什么食物，不过能借一间屋子休息就很不错了。；这里什么都没有。使用『维度』进行确认，周围也没有几个士兵。可能这里是没什么战略价值的地方吧。</data></node>
    <node id="诺斯菲袭击未遂（昨夜·本章回想）"><data key="name">诺斯菲袭击未遂（昨夜·本章回想）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然昨晚的事件以未遂告终，可是被她袭击这事仍然是事实。身体反射性地打了个颤。</data></node>
    <node id="宝剑削装饰风波——剑发光'拒绝'·作罢"><data key="name">宝剑削装饰风波——剑发光'拒绝'·作罢</data><data key="type">event</data><data key="status">provisional</data><data key="desc">语毕，我便注意到『阿雷亚斯家的宝剑诺文』隐隐约约地闪起了光。看上去就像是因为害怕而瑟瑟发抖的样子。；『抱、抱歉，雷纳尔多先生。剑本人似乎不愿意这样，能不能算了呢？』；根据次元魔术的用法，通过『魔石』听取装备的声音可能也不是天方夜谭。</data></node>
    <node id="莱纳提议分头行动·主从托付成立"><data key="name">莱纳提议分头行动·主从托付成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「基督，我们分头行动吧。让我留守在这里。这件事比起你来还是我更合适」；「说实话，这个国家──弗茨亚茨在我看来非常可疑。而且拉丝缇娅拉她的样子也有些不对劲。这点我和涡波想的一样。⋯⋯所以，就让我来代替基督守护她好了。这样你就不用担心了，赶快去本土北方把妹妹和同伴们带回来吧。等回来之后你想跟拉丝缇娅拉再告白一次什么的怎么都随便。我向你发誓绝对会在你回来之前守护好拉丝缇娅拉」；「遵命。吾主」</data></node>
    <node id="帕林库洛零魔力触发世界奉还阵（自爆祈愿）"><data key="name">帕林库洛零魔力触发世界奉还阵（自爆祈愿）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为强行运用魔力的反噬，帕林库洛右臂的皮肤绽裂。；他对作为『世界奉还阵』的载体的『魔石线』进行直接的接触、干涉、并祈愿。；我现在确实没有办法使用魔力了！『理的盗窃者』的力量和『使徒』的力量也都丧失了！</data></node>
    <node id="再诞大作战再开宣言·莱纳塞拉骑士礼"><data key="name">再诞大作战再开宣言·莱纳塞拉骑士礼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那么骑士莱纳・赫勒比勒夏因发誓会助你们的计划一臂之力。；赶快趁基督不在的期间把所有的事情都办完；来进行缇娅拉大人『再诞』大作战的再开宣言吧！」</data></node>
    <node id="公会入会连场战"><data key="name">公会入会连场战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——因为，涡波可是要成为『史诗探索者』的公会会长的啊。」</data></node>
    <node id="玛利亚记忆自解放(手环熔解)"><data key="name">玛利亚记忆自解放(手环熔解)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「玛利亚！那天我对你讲明了自己的一切！你听过那些之后说自己愿意相信我！所以我也相信玛利亚！如果你在这里放弃，那么你当时对阿尔缇所说的一切都会化为乌有！在这种地方停下脚步，那样真的好吗！？」；「『哥哥』什么的，根本就没有那样理想的存在！没有啊！！」</data></node>
    <node id="装备赠答承诺与愿望听取"><data key="name">装备赠答承诺与愿望听取</data><data key="type">event</data><data key="status">provisional</data><data key="desc">结果就因为这点不小心，导致我不得不给所有人都送件衣服。；在这之后，我听取并记下所有人想要的，而且将来必须要将这些做好并作为礼物送给她们。我本来只是想搞点朴素的、重视性能的装备而已，但是这个想法恐怕是没法实现的吧。</data></node>
    <node id="缇娅拉记忆显现与再诞方针（据塞拉）"><data key="name">缇娅拉记忆显现与再诞方针（据塞拉）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">但是在一年前，因为『木之理的盗窃者』的魔法，大小姐看到了缇娅拉大人的记忆，结果导致我们改变了看法。；所以我们便以『缇娅拉大人的再诞』为目标，而没有接受玛利亚『提高级别』的建议；这就是说她已经知道基督是莱文教始祖，迷宫则是始祖为了救助妹妹而打造的事了。</data></node>
    <node id="护送考试至十层"><data key="name">护送考试至十层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">斯诺取出一个瓶子将火焰纳入其中。</data></node>
    <node id="塞拉独断邀请莱纳入计划·拉丝缇娅拉追认"><data key="name">塞拉独断邀请莱纳入计划·拉丝缇娅拉追认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[根据我个人的判断，我邀请他成为了我们的同伴。；虽然大小姐说过必须对涡波保密，但对可否告知其他人则没有明确的指示，所以我认为这样也并无不可]；不过拉丝缇娅拉并没有过分咎责，反而向塞拉道了一声谢。</data></node>
    <node id="最后通牒与宣战布告（帕林库洛拒绝）"><data key="name">最后通牒与宣战布告（帕林库洛拒绝）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">帕林库洛，现在马上给我交出缇达的魔石；因为你砍了缇亚那一剑，还有唆使阿尔缇与玛利亚的事，我要让你用一只手和双眼来偿还；我将水晶剑的剑锋指向了帕林库洛。</data></node>
    <node id="颈环切断与首夜对话"><data key="name">颈环切断与首夜对话</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我就是个为了攻略迷宫而存在的奴隶啊。</data></node>
    <node id="LivingLegendParty（暂定）首次探索出发·宝石鱼初战开始"><data key="name">LivingLegendParty（暂定）首次探索出发·宝石鱼初战开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">通过『连接』，我们一口气来到了预先设置好出口的30层。；我用『维度』警戒着周遭，同时对状态进行最后的确认。；路上找到了一匹合适的怪物，我故意前去与之接触。这是为了在较早的阶段能够好好确认下队伍的实力。</data></node>
    <node id="缇缇拒绝归还与归乡恳愿（艾德动摇）"><data key="name">缇缇拒绝归还与归乡恳愿（艾德动摇）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我们的佩艾希亚已经毁灭了。并且千年前的『支配之王』也已经死了。这是无法逆转的事实。如果要强行扭转它⋯⋯那么就连人家和你的人生都会变得畸形」；（⋯⋯『兽人』是鄙人的愿望所在？没有这回事，『支配之王』。鄙人的愿望并不是『魔人』这一存在的消却。而是要作为『支配之王』的『宰相』，打・造・出・属・于・『魔人』的・乐・园。从始至终一直如此。没错，鄙人的愿望唯此一份，那就是与您携手！铸就世界的和平！！）；「一、一千年⋯⋯？别说得那么轻松！你根本就不明白！你根本不懂经历千年的岁月到底意味着什么！！」</data></node>
    <node id="拉丝缇娅拉来访·'不算数'宣言"><data key="name">拉丝缇娅拉来访·'不算数'宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——刚才我只是有点吓到了而已，你不要会错意了哦！！；我只是有点想做有英雄谭风格的事，结果不小心被那个场面给钓到了而已！失策……！；嗯，不算数不算数！嘛啊，对英雄谭的参考来说确实有点作用呢……，但是不应该轻易做那种事的。我反省过了</data></node>
    <node id="莱纳被射入超大门送往『试练』场所"><data key="name">莱纳被射入超大门送往『试练』场所</data><data key="type">event</data><data key="status">provisional</data><data key="desc">随着这道可爱的声音，莱纳就像曲棍球一样被她射进了巨大的『连接』当中。；他已经飞到其他场所去了。；恐怕就是罗德准备的用于『试练』的场所。</data></node>
    <node id="35层空气横穴（休息点）发现"><data key="name">35层空气横穴（休息点）发现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着在35层的中心附近，回廊上出现了一个奇怪的横穴。使用『维度』确认的话，发现那里面的空间没有水。；但是，会有这么凑巧让人能够呼吸的空间存在让我产生了一种违和感。在这样的空间里，水压和气压居然能保持平衡，只能认为是『某人』有意做的手脚。；「──我说，涡波。如果要休息的话，需要在这里烤烤火什么的吗？」</data></node>
    <node id="黯淡之龙讨伐（屠龙）"><data key="name">黯淡之龙讨伐（屠龙）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——大哥哥，诺文！把视线从我这里移开！！」；龙的头部被大斧劈中，头盖骨碎裂。脖颈吃下了诺文一剑，大量鲜血喷涌而出。</data></node>
    <node id="白色少女的治疗与病情告知"><data key="name">白色少女的治疗与病情告知</data><data key="type">event</data><data key="status">provisional</data><data key="desc">从迷宫返回之后，拉丝缇娅拉便一直使用着神圣魔法和鲜血魔法。；「这是『魔石人类』特有的症状喔。；但这孩子却因失血过多，还同时并发了魔力缺乏症。</data></node>
    <node id="王近卫骑士团五骑断罪截击战"><data key="name">王近卫骑士团五骑断罪截击战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">眼前的是用护臂和铠甲武装自己的五名男性兽人剑士。；「⋯⋯这个我们做不到。你的话语有着特别的力量。而且，我们并没有判断其真伪的能力。因此我们不会去听你所说的任何话语，虽然想听⋯⋯但却不能听。我们只为将任务完成。现在开始将『王近卫骑士团』团长──断罪！！」；「──魔法『维度・决战演算』！！」</data></node>
    <node id="病房之梦（阳滝与誓约）"><data key="name">病房之梦（阳滝与誓约）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「嗯，我跟你约好了。我们会永远在一起。」；所以——无论如何，我都绝对要回去。</data></node>
    <node id="出发宣言与千年契约重誓"><data key="name">出发宣言与千年契约重誓</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我·出·发·了；再把人家从『这里』带走吧！就像那一天一样！这一次不会再错了！；我和你在千年前定下的『契·约』，如今亦未失效</data></node>
    <node id="五十层宣言与第五十之试练开幕"><data key="name">五十层宣言与第五十之试练开幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接下来才是『风之理的盗窃者』的真本领！；接着，像是在呼应她咏唱的台词一般，这个宇宙也开始加速运转。；便是漂浮在远处的魂之星不知为何开始像天体一样回旋。</data></node>
    <node id="孤遇见捧翠色石子的绿发羽翼女孩"><data key="name">孤遇见捧翠色石子的绿发羽翼女孩</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了探寻原因而看了看周围，结果发现了一个坐在草原上的女孩子。；纤细的身材，草绿色的头发，背后长有一对轻巧的羽翼。；那是一块形状圆滑、半透明的翠色石子。虽然不比宝石那般通透，但在阳光的照射下却有种独特的光辉。</data></node>
    <node id="涡波觉醒记忆与身世推断"><data key="name">涡波觉醒记忆与身世推断</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我曾存在于千年前……？我被召唤到异世界的时间点不是在数周之前，而是在更遥远的过去……？」；「我也是跟其他守护者一样的，被迷宫『回想收束（Drop）』出来的怪物吗？」；而那『某种东西』是什么，我心里有底。</data></node>
    <node id="空间破碎第一拳·城堡彻底崩溃"><data key="name">空间破碎第一拳·城堡彻底崩溃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">把所有魔力向一点集中。；而是跟诺文释放『亡灵一闪』那时一样，有一种世界的理受到侵蚀的恐怖感。；啪吱一声──我眼前的空间开始龟裂。</data></node>
    <node id="贝丝寻获（『维度』大范围搜索）"><data key="name">贝丝寻获（『维度』大范围搜索）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">所幸这种找人的事儿我特别擅长，所以立马在佩艾希亚展开了大范围的『维度』，寻找她的身影。；「我找到她了。她正在『魔王城』的附近发呆⋯⋯⋯话说那个是花田吗⋯⋯」；听到贝丝酱的所在，雷纳尔多似乎若有所思的样子，不过他还是一口否决了我的提议。</data></node>
    <node id="拒绝·契约解除·诀别"><data key="name">拒绝·契约解除·诀别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">她的嘴角仿佛是因为喜悦而上扬，两道柳眉却似乎是因为悲伤而皱紧。；「──但是，我・却・讨・厌・相・川・涡・波・啊」；「所以我想，我和涡波的书，已经不再能讲述同一个故事了吧。仅此而已。所以，我们的『契约』也结束了」</data></node>
    <node id="HighSkyBeryl入手与鉴定"><data key="name">HighSkyBeryl入手与鉴定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「HighSkyBeryl」；看来我的『表示』对这个叫做HighSkyBeryl的魔石赞赏有加。；「──嚯哦，『HighSkyBeryl』吗。拿到了相当不错的东西啊。这个在『佩艾希亚』也是一等一的物件啊」</data></node>
    <node id="十级单飞与阿尔缇拦路"><data key="name">十级单飞与阿尔缇拦路</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在我身后、在我行走的这条道路上有一团燃烧的火焰。</data></node>
    <node id="升级·点数分配与系统制定者自认"><data key="name">升级·点数分配与系统制定者自认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">如果莱纳不会使用神圣魔法的话，我们就连级别都会被锁死。；「BonusPoint」获得了一点BonusPoint。；在『世界奉还阵』中看到过去的记忆之后，我已经明白打造出这个系统的人就是我自己了。</data></node>
    <node id="雷纳尔多工房·三剑装备与父之言"><data key="name">雷纳尔多工房·三剑装备与父之言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【赫勒比勒夏因之神圣双剑『片翼』】；哼。——『Flame•Accel』。；小子，你不用在意『这里』的问题。我等早就做好了无论何时崩坏都无妨的觉悟了。……不过嘛，罗德应该是例外吧。</data></node>
    <node id="死者复起：盗理成『理的盗窃者』并宣名『罗德』"><data key="name">死者复起：盗理成『理的盗窃者』并宣名『罗德』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了让这份虚荣和逞强化作真正的强大，纵使自己已经化作一具死尸，也还是向世界的法则发出了恳求。；经此誓言，自己便将理自世界中盗取入手。；此乃支配之王御前。杂碎还不退下</data></node>
    <node id="『闪耀吧炎之剑』战场扫讨"><data key="name">『闪耀吧炎之剑』战场扫讨</data><data key="type">event</data><data key="status">provisional</data><data key="desc">足以斩断世界的巨大炎之剑，由玛利亚挥下。；首先被召唤在周围的怪物们只在顷刻间便化作了灰烬。一瞬间就被炭化的它们最后连着炭一起被烧得灰飞烟灭。就如字面意思，连炭都不剩。；『炎之剑』连同『耐性』这个『理（Rule）』也一并烧尽了。</data></node>
    <node id="晨间集合·拉丝缇娅拉年龄被知晓（章前回溯）"><data key="name">晨间集合·拉丝缇娅拉年龄被知晓（章前回溯）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">今早大家在一起交谈过之后，玛利亚和缇亚都了解到了拉丝缇娅拉其实比自己年纪小的事实。一想到她还是个未经世事的3岁女孩，就只能温柔地守望着她了吧。</data></node>
    <node id="缇缇与莱纳的最后道别"><data key="name">缇缇与莱纳的最后道别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──缇缇，你可要好好和基督一起去解决跟艾德之间的因缘啊。就像你跟佩艾希亚的大家说过的那样，可千万不要再回到这里了哦？」；「嗯，人家会去和真正的弟弟相见的。然后，就那样结束所有这一切。⋯⋯人家和莱纳、就得在这儿说拜拜了？」；「是啊，我就是有仇记到死的类型。所以，我是永远不会忘的。和你一起度过的那段糟糕透顶的时间，我一定至死为止都不会遗忘。从今往后，永远永远。绝对的」</data></node>
    <node id="医院诊断"><data key="name">医院诊断</data><data key="type">event</data><data key="status">provisional</data><data key="desc">首先是被切断的右手，想要复原基本是不可能了。；因为纯度比人类已知的最高级魔石还要高，所以这笔交易可谓是前所未有。</data></node>
    <node id="全员参战夹击与魔力暴走化解"><data key="name">全员参战夹击与魔力暴走化解</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我立刻使用『过密次元的真冬』去妨害。但是这股魔力并不是用来构筑魔法的，而是有意让风属性魔力发生暴走。；我的斩击被冲击力化解了。同伴们好不容易创造的机会，就这么白费了。；「──呵呵，如果说会被你的剑击败的话，那到时候就像这样炸开便是」</data></node>
    <node id="『前日谭』发动与魂之『连接』（回归千年前）"><data key="name">『前日谭』发动与魂之『连接』（回归千年前）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「复合咒术『咏唱』！──『既然未来得以与现在联结』『则现在亦当与过去相连』──！」；察觉到我的魔法的危险性，罗德表情为之一变，她立马抬枪用铳剑射出风弹。；罗德为了阻止我的靠近而挥舞铳剑，但是太迟了。我抬起『新月琉璃』就是一剑将罗德的铳剑架开。</data></node>
    <node id="甲板钓鱼大赛与泳衣批判"><data key="name">甲板钓鱼大赛与泳衣批判</data><data key="type">event</data><data key="status">provisional</data><data key="desc">钓的最多的人是斯诺，她高兴地握拳作「斯诺大胜利！」状。；「呜哇～，涡波的品味一目了然啊～⋯⋯⋯超土诶⋯⋯」；「嗯─，那么下次做泳衣的时候塞拉酱你去帮涡波一把怎么样？」</data></node>
    <node id="涡波研读魔导书·次元魔术大成（翌晨可构筑）"><data key="name">涡波研读魔导书·次元魔术大成（翌晨可构筑）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">到了翌日一早，与之前不同，我可以成功构筑出那些次元魔术了。；有种自己一直欠缺的部分得到补足的感觉，就跟想起自己遗忘的东西时那种感觉很类似。；才能早已具备。我欠缺的正是这份确信──</data></node>
    <node id="《维度》索敌探索与大蛤中毒危机"><data key="name">《维度》索敌探索与大蛤中毒危机</data><data key="type">event</data><data key="status">provisional</data><data key="desc">结果让我陷入了『状态：中毒』的窘境。</data></node>
    <node id="海莉身世揭示（船上对谈）"><data key="name">海莉身世揭示（船上对谈）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「你也差不多察觉到了吧？答案很简单。为了制造我而用到的材料，就是海因·赫勒比勒夏因的身体。我是被用于海因·赫勒比勒夏因的『再诞』而制造的存在，但是结果却失败了。因此我才或多或少地跟海因有些相似，又或多或少地了解海因的事情。仅此而已。」；「好了好了，涡波你乖乖坐好~。……也就是说帕林库洛想要让海因『再诞』呢。通过模仿圣人缇娅拉『再诞』的仪式。」；对我这充满瑕疵的『魔石人类』……</data></node>
    <node id="崩坏倒计时告知与『拯救罗德』委托撤回"><data key="name">崩坏倒计时告知与『拯救罗德』委托撤回</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那个，已经到五十六层附近了」；「说实话，这都是因为六十层守护者积极的协助才能有这样的成果」；他甚至更进一步地看穿了我的承受范围，将自己委托给我的『拯救罗德』的请求也撤回了。就为了减轻我的负担⋯⋯⋯</data></node>
    <node id="以食结好与组队成立"><data key="name">以食结好与组队成立</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——我说，如果你愿意的话，要不要和我一起去迷宫？」</data></node>
    <node id="洗衣事件与初次探索中止"><data key="name">洗衣事件与初次探索中止</data><data key="type">event</data><data key="status">provisional</data><data key="desc">洗涤物还剩下些没洗呢；「⋯⋯让斯诺去做吧」；但是，因为尽是女孩子的衣物，我立马就被禁止进入现场了。说实话，介意这点的只有塞拉小姐一个人。</data></node>
    <node id="玛利亚代价再燃与涡波再起"><data key="name">玛利亚代价再燃与涡波再起</data><data key="type">event</data><data key="status">provisional</data><data key="desc">赶快砍死那边那个嬉皮笑脸的混蛋；足足有八匹火蛇诞生于世。；看来『世界奉还阵』的影响很可能对玛利亚无效。</data></node>
    <node id="诺斯菲承认败势宣告撤退"><data key="name">诺斯菲承认败势宣告撤退</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我这种利用对手的力量的魔法，在遇到你这种从别处借力的类型的时候发挥不出效果。；⋯⋯我必须承认。莱纳・赫勒比勒夏因很强。；综上所述，我要在这里打出撤退这张牌。</data></node>
    <node id="男子的复仇宣言与大陆级『维度』展开"><data key="name">男子的复仇宣言与大陆级『维度』展开</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我要复仇！对欺骗我的国家，对夺走了阳滝的使徒，还有站在使徒一方的『理的盗窃者』，不，甚至是这个世界的一切！全部杀无赦！我要找你们算清总账！；别以为你逃得了，西斯！我现在的『维度』就算覆盖整个大陆都不在话下！！；次元魔术笼罩了森林，跨越城堡，覆盖到整个大陆。</data></node>
    <node id="宝剑转投莱纳与第三个魔石发现"><data key="name">宝剑转投莱纳与第三个魔石发现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">说着，我将手中的『阿雷亚斯家的宝剑诺文』丢给莱纳。；就在他握住剑的一瞬间，侵蚀着莱纳的『世界奉还阵』的影响便消失了。在『理的盗窃者』的加护之下，他身体的溶解（LevelDown）停止了。；在玛利亚离开之后，照理说现在这里剩下的『理的盗窃者』的魔石应该只有『地』与『暗』两个了。不过实际上并非如此。这里还有第三个魔石。</data></node>
    <node id="斯诺一拳击杀Centidreadnought"><data key="name">斯诺一拳击杀Centidreadnought</data><data key="type">event</data><data key="status">provisional</data><data key="desc">听完我的说辞，斯诺在犹豫了片刻之后，缓缓地向它接近过去并挥下一拳。；只听吧唧一声，Centidreadnought的脑袋就被砸烂了。；「好的，搞定了。工作结束。所以赶紧回柯尔库去吧。让我们在那儿好好聊聊」</data></node>
    <node id="分别与自我厌恶"><data key="name">分别与自我厌恶</data><data key="type">event</data><data key="status">provisional</data><data key="desc">可是，我不想让混乱的数值超过10.00。</data></node>
    <node id="艾德的『面试』：涡波1对4"><data key="name">艾德的『面试』：涡波1对4</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──莱纳大人。请您同涡波大人交战，并将他逼入绝境」；「──『Sleep』。姑且先让领队像海莉大人一样先睡下吧」；艾德旋即发出战斗开始的信号。</data></node>
    <node id="莱纳自伤最强一击落空·被诺斯菲制压完败"><data key="name">莱纳自伤最强一击落空·被诺斯菲制压完败</data><data key="type">event</data><data key="status">provisional</data><data key="desc">被逼入绝境的我，无可奈何之下使出了被封印许久的手段。；赌上我生来最优的踏地，向诺斯菲释出我最强的剑闪。；诺斯菲从方才所在的地方消失得无影无踪，我的双剑徒劳地斩断了空气。</data></node>
    <node id="救援学院考试小队"><data key="name">救援学院考试小队</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】甲壳海妖：位阶7</data></node>
    <node id="诺斯菲断退路·挟持移送御殿"><data key="name">诺斯菲断退路·挟持移送御殿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不如说，从诺斯菲表态敌对的那一刻起，设置在我房间里的『Connection』和五十七层的『Connection』就消失了。；「我回来了。成功把人带回来了哦，罗德。」；真是糟透了，亏我好不容易才抵达五十层，现在居然又回到了六十六层里侧。</data></node>
    <node id="缇缇的LevelUP与艾尔芬里斯消散"><data key="name">缇缇的LevelUP与艾尔芬里斯消散</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是由已经消失了的大家所构成的魔力的残渣。；对吧，罗德！！──神圣魔法『魔力变换（LevelUP）』！！」；以万为记的臣民的力量都向缇缇聚集。就连乘坐的艾尔芬里斯也一样，就像解开的编织物一般，风龙就此消失。但从龙瞳中就可以看出，这正是它的心愿。</data></node>
    <node id="涡波宣告明晨全员公开身份与技能"><data key="name">涡波宣告明晨全员公开身份与技能</data><data key="type">event</data><data key="status">provisional</data><data key="desc">至今为止只有你一个人知道我的身份吧。那个，我不打算再隐瞒下去了；实际上其他方面还有很多隐藏起来的事。技能呀魔法呀之类的；借这个机会，我打算全部讲清楚</data></node>
    <node id="流星坠落与翠色魔石诞生（基督-罗德战场异变）"><data key="name">流星坠落与翠色魔石诞生（基督-罗德战场异变）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──但就在此时，一颗『流星』于远处坠落。；它以一道青色的线条将这个昏暗的世界撕裂。；不仅是我，前方的诺斯菲一样受到了这股冲击的波及。</data></node>
    <node id="城邑视察·兽人交流（ch169）"><data key="name">城邑视察·兽人交流（ch169）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，我们踏上了前往城邑的路。；「团长大人也醒过来了，我去把这件事告诉大家！！」；而在这里，我既是『始祖涡波』又是『近卫骑士团长』。</data></node>
    <node id="诺斯菲留恋无关联自白（不消失·浓度更高说）"><data key="name">诺斯菲留恋无关联自白（不消失·浓度更高说）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「诶？完全没有关系唷？；『这里』毫无疑问是只为罗德和涡波大人而存在的世界！这个状况也并非我的期望！我只是陪伴在您二人身旁而已！因此，这与我的留恋毫无瓜葛，我的留恋将是毫发无损！更不可能消失！；「你说这不是你的期望！？开什么玩笑！既然不是你的期望，那你为什么！为什么你会摆出那种表情来呢！！」</data></node>
    <node id="二号队伍31~33层探索与祭坛搜寻"><data key="name">二号队伍31~33层探索与祭坛搜寻</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【怪物】水晶蚁：位阶26；「嗯~，直接用剑砍不是更快吗？」；【怪物】砂上漂位阶32</data></node>
    <node id="抵达豪宅·雷纳尔多濒死发现"><data key="name">抵达豪宅·雷纳尔多濒死发现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯呵呵。真不愧是您，涡波大人」；相较于毫发无损的诺斯菲，雷纳尔多已经是满身疮痍，连回话的余裕都没有。；看到他这满身是血的姿态，用不着『表示』，我就知道他的情况万分危急。</data></node>
    <node id="共鸣魔法『Inviolable・冰Room』总冻结"><data key="name">共鸣魔法『Inviolable・冰Room』总冻结</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『『『──共鸣魔法『Inviolable・冰Room』』』』」；周围的空间被魔力所固定，我和莱纳还有缇缇的动作都戛然而止。；她们『魔石人类』四人的级别为10级上下。就算特化了魔力，数值也比莱纳要低很多。</data></node>
    <node id="双守护者遭遇与试练开场"><data key="name">双守护者遭遇与试练开场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">而你二位，就请接受我这『第二十之试练』吧！」</data></node>
    <node id="超大门（Large・连接）开启（借涡波之手强制发动）"><data key="name">超大门（Large・连接）开启（借涡波之手强制发动）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──次・元・魔・法『连接』」；尽管念出魔法名的人是诺斯菲，但发动者却是我。；而且颜色不是紫色而是白色，密度也相当不凡</data></node>
    <node id="守护者离去与别墅善后"><data key="name">守护者离去与别墅善后</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「守护者对我们失去了兴趣，就那样离开了。；「已经不受魔法的影响了。那家伙说的没错，作用只是暂时的。」；「太好了……那么，那之后莱纳他们怎么样了？」</data></node>
    <node id="舞斗大会报名与拉丝缇娅拉再会"><data key="name">舞斗大会报名与拉丝缇娅拉再会</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「嗯，要跟涡波在没有妨碍的情况下进行对决哦。然后，我要将你手上那个奇怪的手环给摧毁掉。」；——暧昧不清的过去，持续不断的头痛。缺乏整合性的记忆，来由不明的经验。</data></node>
    <node id="共鸣魔法『次元之冬・朔风』冻结帕林库洛"><data key="name">共鸣魔法『次元之冬・朔风』冻结帕林库洛</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「粉碎他的四肢！──『SehrWind・Madness』！！」；「冬之风啊，将黑暗冻结！！共鸣魔法『次元之冬・朔风』！！」；「这个魔法是、可恶！『Dark──！』」</data></node>
    <node id="宿怨决战开幕（帕林库洛先攻）"><data key="name">宿怨决战开幕（帕林库洛先攻）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">表示这里也在『魔石线』之上。同时宣告这里就是『世界奉还阵』的『中心』；我上了哦，少年──；此言一出，决战打响。</data></node>
    <node id="圣诞祭夜之战(回溯)"><data key="name">圣诞祭夜之战(回溯)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[要说的是在圣诞祭那天晚上，我和阿尔缇一起同涡波先生战斗的事情]；把家烧掉，在最后关头背叛，想要夺取你的性命，这可不是随便就能还得起的。；在阿尔缇的《试炼》中被逼得走投无路的我，试图将一切都堵在玛利亚身上。</data></node>
    <node id="出征前留守指示与海盗应对争论"><data key="name">出征前留守指示与海盗应对争论</data><data key="type">event</data><data key="status">provisional</data><data key="desc">确实，我也发现了这附近的海水跟之前的样子不同。气候也安定了下来，看似商船的船只随处可见。；「但是这里离战场也很近了，我觉得这附近可能会出现海盗船的。要是他们敢来的话我一定会全力迎击的哦？无需多言直接烧成灰」；「太天真了，涡波先生。你对那种恶人手下留情干什么」</data></node>
    <node id="涡波的自答断章——'为了拯救他人的『妹妹』而被调整出来的'"><data key="name">涡波的自答断章——'为了拯救他人的『妹妹』而被调整出来的'</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我不是『涡波』⋯⋯？我也⋯⋯没有什么妹妹⋯⋯？；那就是为了拯救他人的『妹妹』而被调整出来的。；面对那个答案，我──────</data></node>
    <node id="诺斯菲晨间无声近侍早餐"><data key="name">诺斯菲晨间无声近侍早餐</data><data key="type">event</data><data key="status">provisional</data><data key="desc">睁开朦胧的双眼，诺斯菲的脸庞就在鼻尖快要相互接触的距离。；认真的切分下来的面包，由红色和绿色的蔬菜所点缀色彩的汤，蒸鸡肉的色拉以及木质的被子里倒满了新鲜的果汁。；量方面的问题完全不用担心。为了能让我再添一碗的样子原本就有四人份左右的样子、</data></node>
    <node id="御殿决战开战(SehrWind炸裂)"><data key="name">御殿决战开战(SehrWind炸裂)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">对话一结束，罗德身上的魔力便开始剧烈膨胀。；「——『SehrWind』！」；以罗德那庞大的魔力释放出的『SehrWind』已经超越了暴风的等级——成为了爆炸的气浪。</data></node>
    <node id="相川阳滝怪物化（千年前）"><data key="name">相川阳滝怪物化（千年前）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是在阳滝化作怪物，始祖涡波与使徒西斯和缇娅拉决裂之后的事。；恐怕这是在妹妹化成怪物，我为了向使徒西斯复仇而单独行动的时期吧。</data></node>
    <node id="三名魔石人类三重『咏唱』光矢与斯诺迎击"><data key="name">三名魔石人类三重『咏唱』光矢与斯诺迎击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这些人是艾德老师的敌人！你们不是也听到了吗！？如果放任这帮人不管的话，我们大家的老师可是会死的哦！老师他会不见的！你们觉得这样好吗！？」；「我们未尝不知自己的力量有所不足！不过，力量不足的人也有力量不足的人特有的战斗方式！『永久浮沉矣』！『于无垠之魂中延展之梦兮』『听此咏诵森罗万象之赞歌』！──『Divaplays・Arrow』！」；「给我把它轰飞！──『Dragon・Ardor』！！」</data></node>
    <node id="罗德揭示『咏唱』=『咒术』体系"><data key="name">罗德揭示『咏唱』=『咒术』体系</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『咒术』的基本，大抵就是以什么为牺牲并将之转换为力量。被莱纳称作神圣魔法的『LevelUP』这个魔法，本质上其实就是『咒术』。它就是将『毒』作为代价牺牲掉之后转变为力量的」；本以为『咒术』是魔法的一个种类，但看来并非如此。『咒术』是一种独立的技术，与『魔法』在某些方面互为表里。；「嗯。因此所有人应该都在无意识的层面掌握了『咒术』的基础。之后只要将与『魔术式』不同的『咒术式』传授给你就可以了」</data></node>
    <node id="35层水中区域突破探索（第四次）"><data key="name">35层水中区域突破探索（第四次）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好了，那今天我就和斯诺和莉帕还有缇亚四个人去一趟。」；就这样，小小翼翼地探索35层到最后，终于找到了前往36层的阶梯。；「……不，今天就先到这里吧。把握了35层和36层的路就已经足够了。」</data></node>
    <node id="雷纳尔多致命一击与祖孙共逝（化光粒·无魔石）"><data key="name">雷纳尔多致命一击与祖孙共逝（化光粒·无魔石）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">即使被四散的碎片刺伤，雷纳尔多也没有一丝动摇，他将大斧扣入贝丝的肩膀。；斧刃顺势直抵心脏，毫无疑问是致命伤。；「这样就好，你没有必要原谅吾等⋯⋯」</data></node>
    <node id="藏书室·绘画保管室调查"><data key="name">藏书室·绘画保管室调查</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不是哦，是人家去调查了一番之后才变成那样滴！反正再也不会去第二次了！；——『支配之王』和『近卫骑士团长涡波』消失了。舍弃了北方的人民，前往南方不知所踪。；所有被毁掉的绘画，上面都刻画着『支配之王』的雄姿。</data></node>
    <node id="冻结魔法『冰之矢』再现成功"><data key="name">冻结魔法『冰之矢』再现成功</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯很好，这样应该就能行了吧？──冻结魔法『冰之矢』！」；伴随一道离弦之箭的声响，一根由魔力构成的冰箭在练习场疾驰而过。；以箭矢为形体的冰块就像RPG游戏中的魔法一样被我从掌中射出。冰矢旋即射穿了前方的人偶，过了几拍之后化作了水蒸气烟消云散。</data></node>
    <node id="决赛第二阶段(冬之异世界vs怪物化)"><data key="name">决赛第二阶段(冬之异世界vs怪物化)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">渐渐的，上空的水分化作结晶，固态化之后纷纷洒落。；有水晶在诺文的身体上产生。他被剥离的皮肤和所受剑伤的部位遍布水晶，皮肤亦在逐渐硬化。</data></node>
    <node id="行程思考：储粮与魔石购置"><data key="name">行程思考：储粮与魔石购置</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我松了口气，接着开始思索接下来的行程。好不容易得以节省的时间，因为给缇缇锻造武器的缘故反过来又延长了不少。；接下来是去储备粮食呢，还是去购买魔石呢，当我对此感到烦恼时，耳边传来了艾利巴茨的声音。</data></node>
    <node id="甲板全坦白（异邦人身世公开）"><data key="name">甲板全坦白（异邦人身世公开）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">当然，目的和出身也详细地讲过了。将自己不是这个世界的人的事实，明明白白地告知全员。；「原、原来如此啊……涡波是『异邦人』啊、怪不得……」；「顺带一说，我已经知道了哦。还有妹妹的事情也是。跟缇亚不一样呢。」</data></node>
    <node id="洪水中对拉丝缇娅拉的渡氧之吻（人工呼吸）"><data key="name">洪水中对拉丝缇娅拉的渡氧之吻（人工呼吸）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">不过这是在时间充裕的前提下才能做到的──我左臂抱着的拉丝缇娅拉口中正咕嘟咕嘟地喘出气泡。；我将自己的额头，贴在拉丝缇娅拉的额头上。；我下定决心，吻上拉丝缇娅拉的樱唇。然后将自己积攒的氧气全部送进她的口中。</data></node>
    <node id="宝石变现结算与资金挪用发觉"><data key="name">宝石变现结算与资金挪用发觉</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在先前的海上旅行中，我曾经用『阿雷亚斯家的宝剑诺文』生成了大量的宝石。之后我到『史诗探索者』拜托格连将这些宝石变现。看来过去了一年的时间，变现的事已经得到解决了。；「缇莉。与其说是保管、这不是还挪用了么」；「因为公会有时候陷入了财政危机嘛。不过加上了利息所以也没关系吧？」</data></node>
    <node id="阿尔缇驰援参战·耶梦加得之炎（168话末）"><data key="name">阿尔缇驰援参战·耶梦加得之炎（168话末）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">又要输了。当败北的挫折感有些许抬头时──；「──『我自衔尾，逡巡蹒跚，如梦似幻』『璀璨星辰，无限远泛，饕餮殄灭』、『耶梦加得之炎』－！！」；一道禁忌之炎在光之庭院内奔驰而过。</data></node>
    <node id="街头情报听取与同赴别墅"><data key="name">街头情报听取与同赴别墅</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那个，我是找帕林库洛有事才来这边的，你要是知道他在哪儿的话能告诉我么？」；「我知道哦！叔父大人的话，在距离这边稍微偏北的方向。据说他现在正在最前线指挥军队来着！」；「好的！我想想啊，叔父大人现在在──。那～个，好像是－、啊嘞？他在⋯⋯」</data></node>
    <node id="重力共鸣的庭院追捕战"><data key="name">重力共鸣的庭院追捕战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">双脚被轻而易举地推离地面，我被轰到了后面的墙壁上。老化的木制墙壁顷刻间被撞碎。；在莱纳『魔力风刃化』的修补下，折断的『堕落使徒』完美地化身为两把长剑。风之魔剑舞动着向我袭来。；但是被回避的『某物』却改变了前进的方向，朝逃掉的我追了过来。看来这魔法就跟捕捉猎物的野兽一样具有追踪功能。</data></node>
    <node id="拉丝缇娅拉战前流亡与修行"><data key="name">拉丝缇娅拉战前流亡与修行</data><data key="type">event</data><data key="status">provisional</data><data key="desc">圣诞祭那天魔力丧失殆尽，还要一边治疗负伤的缇亚一边逃亡。甩掉弗茨亚茨和瓦尔德两国派出的追兵，潜伏于南方的古尔亚德国。</data></node>
    <node id="森林战争地域强行穿越（ch144）"><data key="name">森林战争地域强行穿越（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">然后，我决定了不假思索的朝森林前进。；在人勉强能通过的路上，我用『维度』和剑确保了行进的安全。；当然，不断地这样应对会被认定为敌人是应该的。不出一会，就受到了士兵的攻击。但是，箭矢全部用剑挡开，魔法则用『次元之冬』防御，无视着通过了。</data></node>
    <node id="始祖涡波记忆复苏之梦（罗德相遇+诺斯菲邂逅两段回收）"><data key="name">始祖涡波记忆复苏之梦（罗德相遇+诺斯菲邂逅两段回收）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为使徒勒伽西的缘故而没能继承的始祖涡波的记忆的碎片纷纷复苏。；我知道在这之后要上演的将是非常重要的情节。</data></node>
    <node id="艾尔芬里斯初讨伐（涡波单独）"><data key="name">艾尔芬里斯初讨伐（涡波单独）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为保万全，我在展开『Dimension·决战演算』之后进入了六十六层。；使用新的次元魔法，我将上空的空间予以压缩。；由『Foam』造出的泡沫一点点地错捩世界，扰乱艾尔芬里斯的魔法感官。</data></node>
    <node id="34层水母BOSS战终结与接吻事故余波"><data key="name">34层水母BOSS战终结与接吻事故余波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样，34层的BOSS战落下了帷幕。──以最糟糕的形式。；那之后，在拉丝缇娅拉的强硬手段调解下勉强冷静下来的塞拉给我打了「没有下次了啊！」的预防针后，探索就再度开始了。；就像是胜利宣言一样，我谴责起技能『？？？』</data></node>
    <node id="拉丝缇娅拉房间的拥抱事件"><data key="name">拉丝缇娅拉房间的拥抱事件</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——那么，你给我个拥抱好了？」；「这样一来，终于……不会再寂寞了呢……」；「啊啊，终于……这样一来我的物语的第一章就迎来HappyEnd了呢……」</data></node>
    <node id="第三次（真正的）邀请与千年道别"><data key="name">第三次（真正的）邀请与千年道别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">缇缇，和我一起去找艾德吧。然后你就在那里真正从一个小孩子蜕变为大人就好；人家要回家了！所以，拜拜！大家，再见啦；我忤逆世界的理争取而来的时间终于结束，一切都复归于应有的姿态。</data></node>
    <node id="『世界奉还阵』怪物军团量产"><data key="name">『世界奉还阵』怪物军团量产</data><data key="type">event</data><data key="status">provisional</data><data key="desc">失去了意识之后，肉体的溶解速度也变得更快了。现在士兵们的身体已经丧失了原形，基本已经完全被转化为了魔力粒子。；伴随呜呜啦啦的声音，怪物们分别沿着独特的轨道向我们扑来。但是，不知为何它们全都无视了我的存在，冲玛利亚那边──；周围士兵们的粒子化不断加速，生成了十匹左右的怪物。而且在更远的位置上还有更多的怪物诞生出来。看来他打算利用整个战场不断地打造兽之军势。</data></node>
    <node id="诺文门客化与莉帕地化"><data key="name">诺文门客化与莉帕地化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「只要作为一个骑士取得成就的话，诺文好像就会死掉了，所以我打算协助他。看来守护者们只要实现了留恋就会消失哦。这比跟他战斗要安全多了。」；「——多么美丽的光芒！这就是太阳！？这就是『青空』！？啊啊，这是何等、何等的美啊！！」</data></node>
    <node id="恋爱戏剧计划全貌"><data key="name">恋爱戏剧计划全貌</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着，骰子被掷下。</data></node>
    <node id="光之御旗竖立·五十层光属性支配"><data key="name">光之御旗竖立·五十层光属性支配</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──『LightRod』、还有『光之御旗（NosfiFLAG）』」；但・凡・在・场・之・物・全・被・光・所・沁・染，整个五十层都被光属性的白色所支配。</data></node>
    <node id="对怪物帕林库洛：剑斗与精神攻防"><data key="name">对怪物帕林库洛：剑斗与精神攻防</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我要去救阳滝！我要去帮助我的同伴！仅此而已！」；已经没有余力构筑什么魔法了。；我引以为傲的思考能力已经剩不到十分之一。但是，明明什么都没法好好去想，时间的流逝却如此缓慢。都是因为高到离谱几乎跟『怪物』一样的状态的缘故吧。</data></node>
    <node id="求死劝说与对手之约"><data key="name">求死劝说与对手之约</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯不好意思，在我眼中看来，只觉得你是沉醉在自我的悲剧中而已。难道不是找到了一种轻松的死法就没头没脑地扑上去而已吗？」；不到一个月的人生什么的，未免太短了。；「我们是竞争谁先抵达最深部的对手关系。不会互相厮杀。就这样好了。──这之外的事看来是没戏了呢」</data></node>
    <node id="黑剑挑飞·决斗终结"><data key="name">黑剑挑飞·决斗终结</data><data key="type">event</data><data key="status">provisional</data><data key="desc">只有帕林库洛的黑剑被挑飞，在白色的日轮中舞动。；要想空手闯过我的阻拦难度有如登天，跟剑之间的距离又太远。；这便是这场决斗因帕林库洛的败北而告终的瞬间。</data></node>
    <node id="拉古涅再会与引路入堂"><data key="name">拉古涅再会与引路入堂</data><data key="type">event</data><data key="status">provisional</data><data key="desc">莱纳以本来是原『天上的七骑士』以及四大贵族赫勒比勒夏因家的人为后盾威胁着他们；接着，多亏了拉古涅的功劳我们一下子便进入了大圣堂。</data></node>
    <node id="技能感应觉醒(黑暗中)"><data key="name">技能感应觉醒(黑暗中)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我已经领会了阿雷亚斯流的奥义、技能『感应』真正的法门——；我成功地在毫厘之间避开了这一击。</data></node>
    <node id="涡波判读：千年南北战争再现计划"><data key="name">涡波判读：千年南北战争再现计划</data><data key="type">event</data><data key="status">provisional</data><data key="desc">并且，如果我的猜想没有错的话──他这么做都是为了让千年前的『北方』与『南方』的战争重新上演。；特意增强弗茨亚茨的实力让它成为南方的中心，为的也是再现当初的弗茨亚茨──不，是为了打造出与『支配之王（Lord）』相匹配的敌国。；在我心中，阻止艾德的优先顺位一下子就上升了。</data></node>
    <node id="地上同行邀请与雷纳尔多的重来之愿"><data key="name">地上同行邀请与雷纳尔多的重来之愿</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯雷纳尔多先生。等到『这里』崩壊之后，您要不要跟我一起去地上呢？」；「那么到时候就把贝丝那孩子带上一起去吧。即使只有一点也好，或许能够重头来过啊⋯⋯」</data></node>
    <node id="诺文的临终梦(庭院的朋友们)"><data key="name">诺文的临终梦(庭院的朋友们)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好厉害啊！」「真努力啊！」；之所以一直在挥剑，都是为了这个——</data></node>
    <node id="塞拉转达大小姐的拒绝理由与心意"><data key="name">塞拉转达大小姐的拒绝理由与心意</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「如今的大小姐已经化身为联合国力量的象征。所以无论如何都不能接受你的邀请。在与北方的『境界战争』激化的当下，包括所有盟国在内，弗茨亚茨绝对不可以对外表露出任何窘态。我希望你能明白这一点。虽然是我的猜想，不过我觉得大小姐她其实也是想和你一起走的」；「总而言之，我唯有这一句话可以告诉你。你没有必要再去找大小姐进行确认。大・小・姐・她・无・论・何・时・都・心・系・于・你，这点毋庸置疑。虽然她说讨厌你那话应该也不是假的，但她喜欢你的心情肯定要远远在那之上。而且程度恐怕比・你・喜・欢・她・还・要・深」；「总有一天，大小姐会将所有的一切亲口告诉你。能否请你等她到那个时候呢。务必、拜托了⋯⋯」</data></node>
    <node id="罗德假手滑挑起光属性怪物乱战"><data key="name">罗德假手滑挑起光属性怪物乱战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『维度』并没有漏过她表情的变化。；随着罗德这听起来就觉得假的叫声，一股蕴含着凶恶魔力的风随即诞生。；情况很不妙。不但我们目前所处的空间相对辽阔──而且在罗德视野范围之内就徘徊着数只丧失了敌意的怪物。</data></node>
    <node id="木之理守护者与涡波对峙·『水之理的盗窃者』误认"><data key="name">木之理守护者与涡波对峙·『水之理的盗窃者』误认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">木之理的盗窃者一看到我便异常惊讶。；他睁大了双眼，接着浑身洋溢出战意。；我连忙将手伸进『所有物』中握住剑。</data></node>
    <node id="涡波能力状态剧变(战后·失去水魔石)"><data key="name">涡波能力状态剧变(战后·失去水魔石)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">恐怕是因为在帕林库洛的战斗中失去了『水之理的盗窃者』的魔石吧。；看来在之前那场超越极限的战斗中，所有的『Connection』都被我在无意间解除了。；在许许多多的解除系魔法的影响下，那顽固到近乎诅咒般的『联结』也没撑住。</data></node>
    <node id="西斯的点数再分配（咒术『集中收束』重新修正）"><data key="name">西斯的点数再分配（咒术『集中收束』重新修正）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">咒术『集中收束』是不是有点在平衡方面出了点问题，很难行动，为什么在筋肉和力量上这么突出，明明我不是手持武器战斗的角色。；「没有办法，重新修正吧」；名字：迪亚波罗・西斯</data></node>
    <node id="雷鲁别墅遗址访问与真相说明"><data key="name">雷鲁别墅遗址访问与真相说明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「一个一个说吧……首先，那个手环确实有『守护涡波在异世界的生活』的作用，这一点并不假。如果失去了那个东西，你目前所有的幸福都会消逝。这个毋·庸·置·疑。所以说，守护住那个手环也是为你好。」；——妹·妹·的·名·字·有·蹊·跷。</data></node>
    <node id="御殿开战：SehrWind炸殿与暴风雨降临佩艾希亚"><data key="name">御殿开战：SehrWind炸殿与暴风雨降临佩艾希亚</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『SehrWind』！」；以罗德那庞大的魔力释放出的『SehrWind』已经超越了暴风的级别──成为了爆炸的气浪。；天气从未发生过变化的佩艾希亚，不知为何如今正被暴风雨所支配。</data></node>
    <node id="涡波英雄请战与迎击布阵"><data key="name">涡波英雄请战与迎击布阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「毋需多虑，克洛伊小姐。『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』正是为了这种紧急情况而存在的。我此去势在必得。你们没有必要勉强自己」；「又、又是、和斯诺大人一样──」；说着克洛伊小姐便将士兵聚集起来。只用刚才这么短的时间，她就将驻守在这座城里的士兵召集了起来并完成了迎击的准备。</data></node>
    <node id="罗德全力一击『Ex・Wind』流星坠落"><data key="name">罗德全力一击『Ex・Wind』流星坠落</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──因而！孤将再度、就此坠陨！；这便是！以孤之魂铸就的魔弹！；被当做立足点的魔法阵只在罗德一脚踏穿之后便粉碎无遗。</data></node>
    <node id="锻冶速习：观察+并行读书"><data key="name">锻冶速习：观察+并行读书</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──『维度・多重展开』；我心里默默地念着「打扰了」，便开始观察所有锻冶师的动作。并将他们的所有动作都把握，记忆下来。；赛莉酱还是打起精神接过这些书</data></node>
    <node id="贝丝宣战与街道剑战（势均力敌·直感之谜）"><data key="name">贝丝宣战与街道剑战（势均力敌·直感之谜）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「既如此，那之后剩下的就只有战斗而已了。；贝丝在顷刻间就冲到了我怀里。；两把剑同时挥出，『新月琉璃』和『炎之剑』就此交锋。</data></node>
    <node id="归还原世界方针问答"><data key="name">归还原世界方针问答</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我向了解莱文教的传承的两人询问移动到异世界的可能性。；「我觉得就这样继续以迷宫最深部为目标的方针就好。除此之外没有别的办法了」；「再考虑其他的可能性的话，就是涡波先生继续钻研自己的次元魔术了呢⋯⋯」</data></node>
    <node id="玛利亚队伍集结与南下出发（过去视所见）"><data key="name">玛利亚队伍集结与南下出发（过去视所见）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我倒是不觉得累呢。这样一来周围就没有旁人了。好了，差不多该把西娅她们叫出来了。为了不烧到她们两个，我先把温度调节一下。──『Heat』『火焰』」；玛利亚驱使着岩浆在『大洞』的侧面打造出给己方专用的阶梯，然后便打头走了起来。；就这样，以『魔女』『死神』『原最强』『帕林库洛的侄女』这一奇妙的组合构成的玛利亚队伍，在封锁了『第二迷宫』之后，离开了『第二迷宫都市达利尔』，踏上了往南方前进的路途──</data></node>
    <node id="午后探索队编成与斯诺捕获"><data key="name">午后探索队编成与斯诺捕获</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「航线已经改变了，所以没问题了哦。虽然会绕点远路，但是明天还是能抵达『本土』的吧？那么吃过午饭后，就要开始迷宫探索了呢。今天谁要去？」；首先拉丝缇娅拉举起手表示自己要加入。；我将『维度』扩展到覆盖整个船的级别，寻找连船遭到袭击的时候都不曾露脸的龙人，或者说是龙人NEET。</data></node>
    <node id="拉丝缇娅拉夜袭强制升级"><data key="name">拉丝缇娅拉夜袭强制升级</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「你可是我很重要的『候补』啊</data></node>
    <node id="36层浅滩探索与撤退决断"><data key="name">36层浅滩探索与撤退决断</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我们跨越了漩涡，在像瀑布一样的阶梯上降落着。就像是被掷到地上一样着了陆。；在36层等待着我们的，不再是遍布整个回廊的水，而是浅滩。；「⋯⋯不，今天就先到这里吧。把握了35层和36层的路就已经足够了」</data></node>
    <node id="涡波拒绝『？？？』独逃提案·选择共同战斗"><data key="name">涡波拒绝『？？？』独逃提案·选择共同战斗</data><data key="type">event</data><data key="status">provisional</data><data key="desc">──用最强的魔力构筑出最强的魔法的话，就能够打破现状。现在立刻削减生命就是。跟殒命相比这点生命的损耗实在是很划算──；确实只要削减最大HP使出『次元之冬・终霜』的话，只靠我一个人的力量也能够逃离这里的。；我已经决定不会再走上错误的道路了。不会再被任何人摆弄了。经过在联合国的战斗，我发过誓了。</data></node>
    <node id="五十九层『光』中和与无血连下至五十七层"><data key="name">五十九层『光』中和与无血连下至五十七层</data><data key="type">event</data><data key="status">provisional</data><data key="desc">带着大家一同向着五十九层进发。从这里开始就是完全初见的世界。这么想着便加强了警戒与次元魔术。；仅仅只是一句话，只是这一句基础魔法，灼烧眼睛一般的光也中和的像六十层一样温和。；就这样，再次没有收到任何障碍的我们通过了五十九层，顺带保持这个步调通过了五十八层与五十七层。在这途中，找到了华丽的支柱支撑的房间，被吹倒的圣殿，但是不是十分的难以通过。</data></node>
    <node id="拉丝缇娅拉超限发挥鲜血魔法：发色变白银、剑技再升"><data key="name">拉丝缇娅拉超限发挥鲜血魔法：发色变白银、剑技再升</data><data key="type">event</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉将鲜血魔法的力量发挥超限。；她的秀发发出五颜六色的光芒，最后演变为白银色。看来是借用了更多人的经验。；拉丝缇娅拉剑术的水准又提高了。</data></node>
    <node id="拉丝缇娅拉与玛利亚大打出手"><data key="name">拉丝缇娅拉与玛利亚大打出手</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「只是，在我们思考其它方法的时候──因为方针不同，我跟玛利亚大打了一架。就因为这个原因，我和塞拉现在才会在这里」；「这就是导致我和玛利亚大打出手的原因了呢。我一说自己已经跟不上大家所以决定放弃的时候，玛利亚她气得火冒三丈哦」；拉丝缇娅拉和玛利亚要是打起来那真是恐怖。之前玛利亚的炎之剑将大陆的表面削・平的事我现在还记忆犹新。她们要是在有人的地方打起来那可真不是开玩笑的。</data></node>
    <node id="雷纳尔多遗言（满足·牵挂孤独少女·促逃）"><data key="name">雷纳尔多遗言（满足·牵挂孤独少女·促逃）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">能够和自己的孙女一起迎接第二次的结局，足够了」；现在在『这里』，还有一个跟老朽的孙女一样的少女，抱着与她一样的烦恼，孤独地留在这个地方。；「事到如今，只有那丫头还是老朽的⋯⋯、⋯⋯──」</data></node>
    <node id="伽鲁夫纳多杰里咆哮唤洪水·战场强制水中化"><data key="name">伽鲁夫纳多杰里咆哮唤洪水·战场强制水中化</data><data key="type">event</data><data key="status">provisional</data><data key="desc">伽鲁夫纳多杰里的身体震动，位于身体下方的口部吐出爆音。；这是蕴含着大量魔力的咆哮。；利用『维度』的感知能力，我发现了洪水正自远处的回廊席卷而来。</data></node>
    <node id="最终剑斗：帕林库洛败亡与战场崩溃"><data key="name">最终剑斗：帕林库洛败亡与战场崩溃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——给我冻住吧，帕林库洛！——『冰结剑』！！」；只有帕林库洛的黑剑被挑飞，在白色的日轮中舞动。；帕林库洛就连一点骨灰也不剩地被『世界奉还阵』吞噬了。</data></node>
    <node id="涡波盘问光魔法（罗德在场验证）"><data key="name">涡波盘问光魔法（罗德在场验证）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「⋯⋯那我来带路吧。但是在那之前，我有事要问你。诺斯菲，你的魔法能够对精神产生作用是吗？」；因为我对精神魔法实在没有什么好印象，所以在意得不得了。；「但是，与暗魔法不同的是，光魔法没有办法强制改变他人的内心想法。必须经由彼此心意相通、得到互相的认可之后，才终于可以对特定的感情进行缓和。因此涡波大人您所担心的那种行径，靠光魔法是做不到的，请您放心」</data></node>
    <node id="午餐『维度』索敌发现莱纳（ch137）"><data key="name">午餐『维度』索敌发现莱纳（ch137）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『维度・多重展开』」；以旅店为中心，我将『维度』拓展到周围的民居、酒馆、工作场所等等各种各样的地方。；「莱、莱纳他在这儿⋯⋯！」</data></node>
    <node id="涡波抱玛利亚突破南军军阵"><data key="name">涡波抱玛利亚突破南军军阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">随即我便化作一匹快马奔驰在血肉横飞的战场上。；但凡有不走运地敢挡在我们路上的人，管你多强我统统都用魔法给打成了重伤；一边像锥子一般撕裂南军的包围网突进着</data></node>
    <node id="保管室门前相互谢罪·平行线对话（罗德拒归地上）"><data key="name">保管室门前相互谢罪·平行线对话（罗德拒归地上）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">已经锈蚀的藏书室的大门是敞开的，但通往保管室的门却像是在拒绝他人一样上了锁。；因而，我选择在门外呼唤她。但还未出声，便遭到了诺斯菲的制止。看来诺斯菲认为这里需要让作为将罗德逼到这个地步的自己负起责任来同她沟通才行。我理解了诺斯菲的意思，便退后一步转入观望。；「⋯⋯罗德，我回来了。你方便打开这道门吗？」</data></node>
    <node id="搜救无果与斯诺的振作"><data key="name">搜救无果与斯诺的振作</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我想你也知道，我们在那里什么都没能找到⋯⋯当时的感觉是真的糟透了啊。玛利亚她后悔得悲痛欲绝，斯诺更是对以后的事感到忧心忡忡，莉帕一脸寂寞的模样，我的精神直接就恍惚了⋯⋯塞拉她也挺慌张的哦？」；「简直就像涡波一样⋯⋯不，比涡波还要可靠，就是斯诺她带领大家振作起来的。原来斯诺她真正的性格是那样的啊。我都吓了一跳」</data></node>
    <node id="海莉对帕林库洛独战开幕"><data key="name">海莉对帕林库洛独战开幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「请不要阻止我。即使是为了我自己，这场战斗我也必须要独自进行。在这里与他战斗是对海莉・维斯普洛佩的人生而言绝对必要的经历」；「来吧，我来做你的对手。帕林库洛」；接着，以他的这声轻语为信号，雪白色的少女奔驰而出。</data></node>
    <node id="贝丝之魂唤回与谢罪"><data key="name">贝丝之魂唤回与谢罪</data><data key="type">event</data><data key="status">provisional</data><data key="desc">尽管勉强，但我的魔法《次元决战演算『前日谭』》总算是得以将她的魂成功唤回。；您之所以离开，都是为了帮助在这佩艾希亚里处境最悲惨的孩子。；我依旧没能回想起贝斯的事</data></node>
    <node id="返抵地上（六十六层之战两日后）"><data key="name">返抵地上（六十六层之战两日后）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">于是，在六十六层的那一战之后又经过了两天的时间。；总算是来到了连接迷宫第一层和地上世界的、这最后一条长廊──；紧接着，把濒死的莱纳夹在胳膊下面的缇缇也从后面现身。</data></node>
    <node id="『片翼』移交与莱纳专用化加工"><data key="name">『片翼』移交与莱纳专用化加工</data><data key="type">event</data><data key="status">provisional</data><data key="desc">说着我将其从『所有物』中取出。；「──终于完成了。将赫勒比勒夏因之神圣双剑加工成莱纳使用的形式。您看一下觉得如何？」</data></node>
    <node id="雷纳尔多工房锻冶首日"><data key="name">雷纳尔多工房锻冶首日</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就这样在街上居民们充满善意的关怀下，我们来到了雷纳尔多的宅邸。；那些都是街上的人拜托修理的东西。接下来就要着手把歪了的把手和漏洞给修补好。；直到日落为止，我和雷纳尔多都一直这样持续进行着锻冶工作。</data></node>
    <node id="复仇路概要与千年前终幕"><data key="name">复仇路概要与千年前终幕</data><data key="type">event</data><data key="status">provisional</data><data key="desc">欺骗、杀害『理的盗窃者』们。；不做多想地一味收集着『毒』，提升自己的级别，渐渐地变成了『怪物』；肌肤变得丑陋不堪，手臂的数目增加，长出了鳞片。</data></node>
    <node id="工房会长自曝与订制装备领取"><data key="name">工房会长自曝与订制装备领取</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「大家好。我是相川涡波」；「这位就是咱们公会的会长。传说中的那位。他出现一次可是超级稀奇的事儿哦，超级稀奇的」；在罗列于眼前的众多装备中，我首先审视的是玛利亚和缇亚专用的装备。</data></node>
    <node id="缇达分离——暗之魔石脱落·帕林库洛变回人形"><data key="name">缇达分离——暗之魔石脱落·帕林库洛变回人形</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『暗之理的盗窃者』的『魔石』──从不断咒怨着的帕林库洛的胸口脱落而出。；紧接着，帕林库洛那漆黑的身体崩溃。；象征着人外之物的部件如同雾一般消散，他的身体变回了人形。</data></node>
    <node id="六十层野餐茶会休憩"><data key="name">六十层野餐茶会休憩</data><data key="type">event</data><data key="status">provisional</data><data key="desc">到达六十层后罗德提议休息并高兴地主张着毫不相干的铁则显得十分得意。；从那个麻袋和包里取出来的东西是称之为野餐套装的东西。罗德把他们以没有一丝多余的动作在六十层展开。接着，仅数分钟里就准备完了上次在城堡的庭院里举行的茶会一样的事。；「差不多要中午了呢。既然没有带午饭过来，那么就来喝茶吧」</data></node>
    <node id="莱纳奉命阻截诺斯菲"><data key="name">莱纳奉命阻截诺斯菲</data><data key="type">event</data><data key="status">provisional</data><data key="desc">况且将诺斯菲拖住是基督对我下达的命令。他说过罗德的问题由自己想办法解决。；「我主基督已经有命在先！！你休想过去！诺斯菲诶诶诶诶诶诶────！！！！」；「啊啊、你这个人真是恶心死了！碍事碍事碍事！莱纳啊啊啊啊啊啊啊────！！！！」</data></node>
    <node id="缇亚右手回收失败"><data key="name">缇亚右手回收失败</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「被『迷宫』吞噬的。」</data></node>
    <node id="玛利亚侧对账（诀别与诱导）"><data key="name">玛利亚侧对账（诀别与诱导）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那滴眼泪划过了脸颊，在落到地上之前，便化作一缕火焰消失了。</data></node>
    <node id="古尔亚德港深夜购船"><data key="name">古尔亚德港深夜购船</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我现在是真的累得够呛，至于原因，那自然是拉丝缇娅拉所谓的「随便一赚」了，这些买船的钱都是她逼我去赚来的。我是真的想不到，自己居然会在和诺文的比赛之后跑去赌场，甚至使用技能『感应』在里面赚钱。；缇亚将庞大的魔力灌进了船内。</data></node>
    <node id="缇达战·物理阶段"><data key="name">缇达战·物理阶段</data><data key="type">event</data><data key="status">provisional</data><data key="desc">这是自我开始使用『维度』以来首次受到的攻击。</data></node>
    <node id="全名自报与『英雄』人设取信"><data key="name">全名自报与『英雄』人设取信</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我的名字是『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』。；既是强悍、高尚、善解人意的探索者、又是『舞闘大会冠军』的、完成了『屠龙』业绩的『公会会长』的；虽然我对真正成为那种理想的英雄这点敬谢不敏，但加以利用则是另一码事。</data></node>
    <node id="『DistanceMute』与『连接』『维度』共享"><data key="name">『DistanceMute』与『连接』『维度』共享</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『DistanceMute』」；我毫不犹豫地对缇缇使出了即死魔法。而缇缇也没有任何怀疑地接受了我的魔法。；我在彼此之间暂时构筑出『连接』，将另一个魔法获得的信息传递给缇缇。</data></node>
    <node id="莱纳加入队伍(和解成立)"><data key="name">莱纳加入队伍(和解成立)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">出发吧，基督。让我们两个人合力干掉那条龙。；莱纳•赫勒比勒夏因加入了队伍。；虽然是值得纪念的自己与莱纳的和解，但一想到设计出这个系统的是我本人，我便不由地感到有些不好意思。</data></node>
    <node id="罗德粉碎王之肖像画"><data key="name">罗德粉碎王之肖像画</data><data key="type">event</data><data key="status">provisional</data><data key="desc">之前曾在保管室里看到的一幅画如今正漂浮在罗德身边。；那是绘有完美的王之英姿的──肖像画的碎片。；将绘画彻底粉碎。</data></node>
    <node id="呼唤阳滝·体内应答与千年记忆回想"><data key="name">呼唤阳滝·体内应答与千年记忆回想</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「阳，『阳滝』────？」；────「──哥，哥哥────？」────；接着跨越了千年时间，我回忆起来了。</data></node>
    <node id="本土上陆与柯尔库潜入"><data key="name">本土上陆与柯尔库潜入</data><data key="type">event</data><data key="status">provisional</data><data key="desc">为了隐藏『LivingLegend号』，我们将它停靠在本土东北部瓦尔德本国东端的海崖下。；「总而言之，要跟涡波一起去本土的也就我和玛利亚还有缇亚而已了。这样就漂亮地4对3了呢。」；「不不，不会有间谍有我们这样的本事的哦……只要在一瞬间翻过城墙的话，『魔石线』是不会有反应的。顶多只是觉得是鸟这类小动物飞过去了而已。」</data></node>
    <node id="诺斯菲晨间袭击涡波（光绳捆绑索『证明』）"><data key="name">诺斯菲晨间袭击涡波（光绳捆绑索『证明』）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">与昨天不同的是诺斯菲正骑在我的身上，从秀口中伸出粉红色的柔舌舔舐着我的脸颊。；我现在正呈大字体仰面躺在床上。而双手双脚都被通过魔法制造出来的耀眼的绳子捆了起来。；「正是如此，请您立刻同意。──『LightKnife』」</data></node>
    <node id="缇缇北逃获救与成为家人（命名·定居）"><data key="name">缇缇北逃获救与成为家人（命名·定居）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">结果终于没了力气，一个人精疲力竭地倒在了草原上，当时本以为自己会就这样死掉来的。；非要解释的话，只能说是咱们没办法对你这样的小孩子见死不救啊，不然守护咱们的神明大人可是会降下天罚的啊。而且也无颜面对庇护咱们的佩艾希亚王家了。理由大抵就是这些了呐？；丫头你的名字就叫缇缇好了。怎么样，很可爱的名字吧？</data></node>
    <node id="奴隶市场再访与玛利亚竞拍"><data key="name">奴隶市场再访与玛利亚竞拍</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——主持人，我出双倍。」</data></node>
    <node id="全员集结与攻城开始"><data key="name">全员集结与攻城开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没什么时间了我简单地说一下。最重要的不是打倒帕林库洛，而是夺回缇亚。这一点绝对不要搞错了。」；首先，捕获缇亚的任务由我和玛利亚负责。；不管我是人类也好，是『怪物』也好，是『魔石人类』也罢，还是『相川涡波』都无妨。</data></node>
    <node id="帕林库洛无限魔力怪物军势召唤"><data key="name">帕林库洛无限魔力怪物军势召唤</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这个『世界奉还阵』在同我联结着。换句话说，我现在的MP是无限的。不仅如此，现在我就连这种事都做得到哦？」；WindLever Rank35——；木躯的双头犬，ツリーダイダス。飞在空中的大型蜥蜴，リザードフライ。雕首的巨人，ピッドジャイアント。独眼并长有两对翅膀的蝙蝠，ムーンレスフォウ。内部空荡却活动自如的铠甲，アンコンケラブル——不管哪一个都是Rank在30上下的怪物。</data></node>
    <node id="强化《维度》发现修缮道路"><data key="name">强化《维度》发现修缮道路</data><data key="type">event</data><data key="status">provisional</data><data key="desc">那是一条经过修缮的回廊。地面被整备得十分平整</data></node>
    <node id="深层祭坛道具再失"><data key="name">深层祭坛道具再失</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「祭坛上的道具又没了⋯⋯」；「说不定是海莉酱和西娅酱吧⋯⋯？虽然我不觉得她那样的身体状况能在那之后这么快过来就是了⋯⋯」；──说到底，在我们相遇的那一天，海莉很可能就已经抵达39层了。</data></node>
    <node id="涡波冲刺四十九层阶梯失败·转入剑戟交战"><data key="name">涡波冲刺四十九层阶梯失败·转入剑戟交战</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我咬了咬牙拔腿开跑。目标既不是诺斯菲也不是『连接』，而是通往四十九层的阶梯。；能感觉到她很惊讶于一直在做后卫的我『剑术』技能级别会有这么高。；虽然战斗已经持续了将近五分钟，但看她的样子就算打上一个小时也不会有什么问题。</data></node>
    <node id="『感应』警报与『Default』隔离（守护者接触阻止）"><data key="name">『感应』警报与『Default』隔离（守护者接触阻止）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">技能『感应』就在这时突然发动。；感觉到绝对不能让她们两个接触的我当即使用魔法。；「──魔法『Default』！！你们两个都先冷静下来！！」</data></node>
    <node id="世界奉还阵吞没与大空洞形成"><data key="name">世界奉还阵吞没与大空洞形成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错，海莉和莱纳赌上了自己的性命前来助阵。而海莉她⋯⋯也死在了那里，虽然如此，但最后我和莱纳两个人总算是打败了帕林库洛。只是，因为没来得及逃出那里，结果我们两个人被『世界奉还阵』吞没，掉到了地下。因为掉到了迷宫的深层，所以花了很长的时间才回到了这里」；「我们这边的话，等玛利亚一恢复好，就赶往了你们交战的地方。即使是在大陆的边缘，也能看到『世界奉还阵』那非同寻常的光芒，我们大家的情绪都非常混乱⋯⋯结果等赶到之后，应该是涡波你战斗的场所附近形成了一个大空洞，那周边都化作了熔岩地带。直径数十公里的范围内寸草不生。大地到处都是裂缝，大空洞里面就更不得了了」</data></node>
    <node id="帕林库洛完死体化与精神攻击·涡波崩溃"><data key="name">帕林库洛完死体化与精神攻击·涡波崩溃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着，他用化作黑色液体的手腕刺穿了自己的胸口。这已经超越了自残行为，是彻底的自杀了。；这副模样可以称得上是『完死体（Monster）』了。；二十守护者（TwentyGuardian）暗之理的盗窃者</data></node>
    <node id="涡波英雄传说大流传（舞闘大会后）"><data key="name">涡波英雄传说大流传（舞闘大会后）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">现在的你可是『最强』的『英雄』，同时还是『剑圣』以及『守护者杀手』。；在那之后演剧船『瓦尔法拉』还上演了讲述你这段活跃经历的戏剧；新英雄相川涡波的传说在联合国之地冉冉升起</data></node>
    <node id="伪善提案与莱纳目标确认"><data key="name">伪善提案与莱纳目标确认</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「一脸愁容地想这想那也无济于事的。等下次再遇到那两个人的时候，就把多得过头的金钱悄悄地塞进他们的口袋里便是。付诸实践的伪善总比空想中的真善要好」；比起过于遥远的目标，现在完成莱纳给出的目标更为实际。我从『所有物』中取出莱纳的便条重新确认上面的事项。；接下来我们要去的地方是──</data></node>
    <node id="缇娅拉的灵魂宣誓与幸福魔法之梦"><data key="name">缇娅拉的灵魂宣誓与幸福魔法之梦</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我一定会完全解明『理』的存在，创造出新的魔力法则；让所有人幸福的『魔法』什么的，已经不需要了啊！；太迟了啊！已经太迟了！！</data></node>
    <node id="千年前的战争·北方数度无血开城"><data key="name">千年前的战争·北方数度无血开城</data><data key="type">event</data><data key="status">provisional</data><data key="desc">根据弗茨亚茨流传下来的历史记载，在千年前的战争中，在南方的攻击下，北方曾发生过数度的无血开城。而当时南军的统帅全部都是作为『光之御旗』的诺斯菲。；她在无意识之中，更倾向于将对手制服而不是杀害，这才是她的战斗方式。毕竟连她拿来做武器的东西也是原本不具有杀伤性的『旗帜』。</data></node>
    <node id="六十六层死胡同确认（Savepoint困境）"><data key="name">六十六层死胡同确认（Savepoint困境）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">在六十六层和六十七层的，只有那个风龙而已。其它的怪物什么的，一匹都没有啊。而且我们还没办法在低阶层慢慢提升级别；我们完全被困在六十六层里了。所以，我一直都期待着涡波的苏醒来着⋯⋯；没有其他获得经验值的途径，我们被强迫只能在当前的级别下打破困境。</data></node>
    <node id="西区龙之咆哮余波"><data key="name">西区龙之咆哮余波</data><data key="type">event</data><data key="status">provisional</data><data key="desc">是夹带着魔力的——『龙之咆哮』。；拉丝缇娅拉她们正在跟斯诺比赛。</data></node>
    <node id="祖孙同咏杀招与以命换魔力"><data key="name">祖孙同咏杀招与以命换魔力</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『勖兮奋哉、吼哮不绝之焰』！『焦土踏破、疾驰无息之魂』！」；贝丝是为了获得胜利而绞尽了自己所有的魔力，雷纳尔多是为了同归于尽而绞尽了自己所有的生命力。；雷纳尔多的最大HP开始削减、削减、再削减，这全部都转化为了浓郁的魔力。</data></node>
    <node id="千年物语对斯诺托出·夜谈"><data key="name">千年物语对斯诺托出·夜谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">斯诺毕竟是要加入和使徒西斯的战斗的同伴；在那之后，阳滝因为使徒西斯的过失化作了怪物，而因此变得自暴自弃的我得到了圣人缇娅拉的拯救；──这段有关千年前的谈话一直持续到了夜里。</data></node>
    <node id="Dimension误视事故与记忆控制"><data key="name">Dimension误视事故与记忆控制</data><data key="type">event</data><data key="status">provisional</data><data key="desc">唯有对玛利亚的感情必须抑制住不可，不然，就会不可避免的意识到……</data></node>
    <node id="罗德千米铳剑狙击与追捕开始"><data key="name">罗德千米铳剑狙击与追捕开始</data><data key="type">event</data><data key="status">provisional</data><data key="desc">既然你希望将战斗拉长，那这边也按照预定将你包围、让你无路可逃便是。；毕竟『孤之弹丸亦是加速之魂』。没错、『日日夜夜』『加速不息』。；她的表情中带有绝对能成功狩猎猎物的魄力。罗德以一流猎人的熟练动作架起了铳剑。</data></node>
    <node id="出迷宫与警备兵情报"><data key="name">出迷宫与警备兵情报</data><data key="type">event</data><data key="status">provisional</data><data key="desc">毕竟在迷宫附近建有水渠的可只有这北面的『弗茨亚茨』一个啊。</data></node>
    <node id="二十层Connection设置成功"><data key="name">二十层Connection设置成功</data><data key="type">event</data><data key="status">provisional</data><data key="desc">果不其然，客厅和第二十层的空间完美地连接在了一起。</data></node>
    <node id="涡波的恋爱决断（章末悬念）"><data key="name">涡波的恋爱决断（章末悬念）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">被两个人告白，但是能够回应这份心意的对象顶多也只有一个人而已。；我如此决断。；将明确的答复，告知她们两人。</data></node>
    <node id="三人组逃亡与缇亚狂化危机"><data key="name">三人组逃亡与缇亚狂化危机</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「那么，『基督和玛利亚夺还作战』！开始！！」</data></node>
    <node id="莉帕夜访·后宫提案与纯爱宣言"><data key="name">莉帕夜访·后宫提案与纯爱宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">——唔嗯~。要不然就把大家都迎娶为妻吧。你选一个喽；字面意思呀。把姐姐们全员都收掉！不错嘛~，欧尼酱~。这可是后宫呢；这并不是后宫之类的什么好听的词儿。而是其它的更加糟糕的东西。</data></node>
    <node id="涡波身体状态恢复（帕林库洛受损+阳滝魔石违和感消失）"><data key="name">涡波身体状态恢复（帕林库洛受损+阳滝魔石违和感消失）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我能感觉到因为与帕林库洛的战斗而受损的力量现在重新恢复了。或者说是因为失去了阳滝的魔石而产生的违和感已经消失，应用于实战中的直觉重新趋于敏锐。；虽然只有数秒的时间，但是拜与『魔王』的剑闘所赐，我的『剑术』已经成长到了前所未有的高级别。</data></node>
    <node id="史诗探索者访问（宝石变现委托）"><data key="name">史诗探索者访问（宝石变现委托）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这要是传出去，本土的大人物们估计要激眼了。这种力量被把持在个人手中的话，国家的存在都会被轻易撼动的。」；「我知道了，要把这些宝石变现是吗。没关系，我来帮你。这单子『史诗探索者』接了。；「……这个做不到啊。你的队伍，换言之不就是帕林库洛的受害者群体吗？我没有那个资格啊。」</data></node>
    <node id="涡波的明日全员坦白宣言"><data key="name">涡波的明日全员坦白宣言</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[玛利亚……。到了明天，我会将自己的一切和盘托出]；因此，我要将来到异世界的事情，还有技能的事情，都告诉所有的同伴。；明天，把大家都叫来一起说。</data></node>
    <node id="新剑受领与二十六至二十九层Solo突破"><data key="name">新剑受领与二十六至二十九层Solo突破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">今天最重要的目的是测试『新月琉璃制直剑』的锋利度。；于是，我钻进了这个洞穴，坠入了三十层的空间。</data></node>
    <node id="诺斯菲留恋自白与部分消解"><data key="name">诺斯菲留恋自白与部分消解</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——因为、正·确·的·做·法·永·远·都·不·会·得·到·报·偿。」；明明好不容易才得到将涡波大人收入手中的机会，我却没有抓住。；我一直、一直都——渴·望·犯·错·啊。」</data></node>
    <node id="古利亚德港深夜购船(LivingLegend号·周回二度)"><data key="name">古利亚德港深夜购船(LivingLegend号·周回二度)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">黄昏的时候钱还不够，明明是这样，仅仅用了数小时，持有的金额就突然翻了千倍，他作为一个商人发出了颤抖的声音。；这里的金额已经是市价的一倍了，而且还都是崭新的金币；商人坦白地说出这条船是一艘失败作。</data></node>
    <node id="缇亚的体内抵抗与西斯的让步"><data key="name">缇亚的体内抵抗与西斯的让步</data><data key="type">event</data><data key="status">provisional</data><data key="desc">西斯的光之手产生了扭曲。；「⋯⋯是缇亚酱吗。这『技能』还挺令人怀念」；「──啊啊，无需担心。我是缇亚酱的同伴哟。我跟你发誓，会在力所能及的范围内听取你的愿望。唔嗯，虽然我本想要拉拢盟友过来，但是可爱的缇亚酱似乎不愿意，那就算了吧」</data></node>
    <node id="LizardFlyer战力分析与弱点发现"><data key="name">LizardFlyer战力分析与弱点发现</data><data key="type">event</data><data key="status">provisional</data><data key="desc">由此推测这家伙没有办法同时进行移动和『魔法相杀』；「──那家伙，难不成是特化了回避的怪物？估计用剑攻击的话它只要看看就能躲得开。相较于身体行动的速度，那家伙的动态视力更加异常。我们用剑进行防御也没有用」；而且这次还不能用『DistanceMute』这种作弊技。因为根本就摸不到敌人啊。</data></node>
    <node id="孤于迷宫苏醒·发现魔石与想起收束·佩艾希亚第二次复兴启动"><data key="name">孤于迷宫苏醒·发现魔石与想起收束·佩艾希亚第二次复兴启动</data><data key="type">event</data><data key="status">provisional</data><data key="desc">[这是将被那个魔法阵吞噬的佩艾希亚的人变成了魔石散落在这里了吗……那么涡波的意思就是让孤利用这些东西将佩艾希亚重现出来是吗……？；[——aAAAA！在那个地方！在那个时候、如果您没有抽身的话，佩艾希亚就不会灭亡了！不会灭亡的啊、『支配之王』啊啊啊啊啊啊！！]；——终•于•在•过•去•了•一•百•年•的•时•候，这个作业终于完成了。</data></node>
    <node id="抵达五十层（罗德阶层·草原暴风雨）"><data key="name">抵达五十层（罗德阶层·草原暴风雨）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这，这里就是五十层⋯⋯⋯罗德的阶层⋯⋯」；广阔的世界是一片草原。；「但是，基督。现在罗德那家伙在六十六层哪里。这种场合，守护者会怎么样呢。谁都不出来吗？」</data></node>
    <node id="第十之试练（决战）"><data key="name">第十之试练（决战）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「要上了，英雄（基督）。为你没有选择少女（玛利亚）一事，后悔至死吧——！」</data></node>
    <node id="海莉的自白崩溃——记忆混杂之苦全暴露"><data key="name">海莉的自白崩溃——记忆混杂之苦全暴露</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「无法忍受！不安的不安的不安的无法忍受！比死还要痛苦哦？！」；「能好好地活着吗，能好好地死去吗也不明白！因为很痛苦想快点解脱，『她（我）』这样对『我』说着！『我』也是，希望『她（我）』早点解脱！所以『我』也、一直寻找着死亡的地方！」；我了解到海莉所保持的镀金被剥落了。她那冷静的姿态是一张张的假面，我也了解了真正的海莉没有这样的余裕。</data></node>
    <node id="决斗再开：冰炎双蛇与黑刃钝响"><data key="name">决斗再开：冰炎双蛇与黑刃钝响</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──『耶梦加得之霜』！！」；「──『耶梦加得之炎』！」；冰与火两匹大蛇诞生，并扑向帕林库洛。</data></node>
    <node id="神铁锻冶技术观察"><data key="name">神铁锻冶技术观察</data><data key="type">event</data><data key="status">provisional</data><data key="desc">仔细观察的话，会发现铁锤上刻着魔术式。那是一把可以被称为魔法道具的铁锤。；铁器与锤子每次碰撞，魔力便沁染在铁器上。而魔力就像在强化铁器一般延伸成网状附着于铁的表面，在冷却的同时将铁的形态固定。；不光是单纯为了调节温度而使用的火焰魔法以及水魔法，还有可以补正铁器强度的地魔法。</data></node>
    <node id="返回地上的粮饷筹备与上工"><data key="name">返回地上的粮饷筹备与上工</data><data key="type">event</data><data key="status">provisional</data><data key="desc">说实话，我们两个现在是真的穷。；想也知道从六十六层赶往地上会是一段相当漫长的路途。；哪怕将每过一层需要花费的时间乐观地估计成一小时，单纯计算一下也是六十六小时</data></node>
    <node id="诺斯菲连镇六十四层GreenHighElement"><data key="name">诺斯菲连镇六十四层GreenHighElement</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「好嘞，又到了新一层了呢。那么按照顺序就轮到人家──」；「那肯定是诺斯菲更好了。毕竟我的目的是安全地回到地上啊」；「──魔法『一再反转之光』」</data></node>
    <node id="涡波逞强崩壊·受降"><data key="name">涡波逞强崩壊·受降</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「少年，你在流泪哦⋯⋯？」；──救救我吧⋯⋯」；就这样，我跪倒在地，双手掩面，像孩子一样哭了起来。</data></node>
    <node id="涡波迎击流星·风援与心灵呐喊"><data key="name">涡波迎击流星·风援与心灵呐喊</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「哈、哈哈！──『维度・多重展开！！』」；「给我把空间扭曲！──『Default』哦哦哦！！」；──一阵风就像是为了支持我的决心一样从旁吹来。</data></node>
    <node id="缇缇获赠轻铠路易芬理德"><data key="name">缇缇获赠轻铠路易芬理德</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「人家还想要一副铠甲！就挂在那里的那副！」；「嚯，品味相当不错嘛。那可是我倾尽心血打造的英雄风格的造型啊」；不知为啥这两人一下子就意气相投了。</data></node>
    <node id="六十六层风龙二度击破"><data key="name">六十六层风龙二度击破</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──风魔法『TowersSus・Wind』」；「──『Default』『DistanceMute』！！」；接着我以电光石火的速度将闪耀紫色光芒的右臂刺入艾尔芬里斯体内。</data></node>
    <node id="贝丝×雷纳尔多前廊决斗（同术抵消·身世对诉）"><data key="name">贝丝×雷纳尔多前廊决斗（同术抵消·身世对诉）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">然而前廊现在之所以还能维持原型，是因为相同属性且力道相仿的攻击常常遭到彼此的抵消。；「什──、你为什么会使用与我相同的魔法──！？」；「既然流着相同的血那也是理所当然的啊⋯⋯」</data></node>
    <node id="诺斯菲宣告罗德哭泣不止与泪之雨终结之愿（据诺斯菲声称）"><data key="name">诺斯菲宣告罗德哭泣不止与泪之雨终结之愿（据诺斯菲声称）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「如您所见。罗德她现在正在哭泣。纵使以笑颜示人，她的哭泣也未曾断绝」；没错，我想要让这场泪之雨得到终结」；毕竟这可是我的留恋呀，没有办法不是么？」</data></node>
    <node id="世界观动摇与？？？第四次暴走"><data key="name">世界观动摇与？？？第四次暴走</data><data key="type">event</data><data key="status">provisional</data><data key="desc">【技能『？？？』暴走了】</data></node>
    <node id="工房打工：全城修理·装备修复·护符受领"><data key="name">工房打工：全城修理·装备修复·护符受领</data><data key="type">event</data><data key="status">provisional</data><data key="desc">仔细观察的话，会发现铁锤上刻着魔术式。那是一把可以被称为魔法道具的铁锤。；看着【CallOuter】【AllConfess】【BloodSword】这些原本因为精神污染而没法使用的东西；【CallOuter】和【AllConfess】这两个在修理过后不再有精神污染的效果了。然而【BloodSword】算是寿终正寝了</data></node>
    <node id="旅行目的说明与古奈尔同行强要"><data key="name">旅行目的说明与古奈尔同行强要</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「唔姆。人家的弟弟艾德他现在将『相川阳滝』当做了『支配之王』的代行者肆意妄为，因为这个原因，人家和涡涡正要去找他。顺便还有个叫『使徒西斯』的家伙好像也干了壊事，所以要去教训她」；「啊、啊－⋯⋯感觉这几个名字相当令人怀念啊─。⋯⋯这些好像是『理的盗窃者』们对吧？」；「虽然缇缇觉得只要见到艾德跟他谈一谈就能解决问题，但我仍然觉得有同他爆发战斗的可能。所以我想着应该会是一场充满危险的旅途吧」</data></node>
    <node id="问答：过去与未来孰重（涡波答未来/现在·诺斯菲以时效已过挖苦）"><data key="name">问答：过去与未来孰重（涡波答未来/现在·诺斯菲以时效已过挖苦）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">涡波大人您觉得『过去』和『未来』──哪一个更重要？我呢、特别想知道的就是这个；「我知道了。⋯⋯一定要选的话，应该是『未来』吧。准确来说的话我认为『现在』是最重要的」；因为那都是千年前的事所以时效已过（可以被原谅）了是吗？</data></node>
    <node id="誓约者感情返还与『先谭』开眼"><data key="name">誓约者感情返还与『先谭』开眼</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「『最深部之誓约者』啊啊啊啊──！！把我对阳滝的感情，全都还来！！」；这份情感让『涡波』和『阳滝』产生亲和，转变为抵达『次元之理』的『力量』──！；──我能够认知到的次元的数量增加了一个。</data></node>
    <node id="缇亚的消失危机与诀别"><data key="name">缇亚的消失危机与诀别</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「涡波……不要、过来……！」；「如果『缇亚』完全消失了的话……到那个时候，玛利亚、你要将我……」；「基·督……」</data></node>
    <node id="缇亚身世坦白与营救同盟"><data key="name">缇亚身世坦白与营救同盟</data><data key="type">event</data><data key="status">provisional</data><data key="desc">其实我是某个国家的要人，现在正在逃亡的过程中……」</data></node>
    <node id="Centidreadnought袭港急报与迎击准备"><data key="name">Centidreadnought袭港急报与迎击准备</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「之前的那个怪物正从西面向我们这边袭来！虽然数量不是十只而是一只，但也是不可小觑的威胁。现在指挥部那边正在制定以驻守在『圣柯尔库堡』的兵力迎击的计划，可能的话希望克洛伊大人也能参与指挥」；「没错。虽然斯诺大人此前应该是前往迎击了，但好像还是有漏网之鱼。斯诺大人她也还没有回来」；「怪物」Centidreadnought：级别32</data></node>
    <node id="罗德『手滑』乱战·新魔法初阵"><data key="name">罗德『手滑』乱战·新魔法初阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">啊、哎呀—、手滑啦——！！！！；——『Dimension•曲战演算（Difference）』！！；——魔法『Foam•捩菖蒲（Torsion）』！</data></node>
    <node id="突发暴雨笼罩战场"><data key="name">突发暴雨笼罩战场</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就在我如此祈求的一瞬间。；仿佛是回应我的愿望一样，冰凉的雨滴落在我的脸颊上。；天气竟然在短时间产生了这么大的变化。</data></node>
    <node id="风之理的盗窃者罗德破窗会面"><data key="name">风之理的盗窃者罗德破窗会面</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我感觉到一股令人毛骨悚然的魔力。；「什、什么──，这个魔力是──！？」；在那一刻，伴随着如同巨大的气球被撕裂一般的破碎声，一个少女从窗户外飞进了房间。</data></node>
    <node id="决斗后半·Foam战术制胜"><data key="name">决斗后半·Foam战术制胜</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这样就算是我赢了吧？」</data></node>
    <node id="缇达现身"><data key="name">缇达现身</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呵呵呵，我乃镇守二十层的守护者、暗之理的盗窃者缇达。请多指教了。」</data></node>
    <node id="涡波誓师·冲出幽世"><data key="name">涡波誓师·冲出幽世</data><data key="type">event</data><data key="status">provisional</data><data key="desc">阻挡我回到地上的最大障碍，就是这名为千年前的『过去』。；哪怕是为了拯救已沦为痛苦囚虏的『风之理的盗窃者』，我也必须尽快突破『过去』和迷宫的阻拦，回到同伴们所在的地上。；在一千年之后，在这一刻，许下绝不止步的誓言，我冲上了前。</data></node>
    <node id="西斯白翼逃亡与男子黑紫魔力失控"><data key="name">西斯白翼逃亡与男子黑紫魔力失控</data><data key="type">event</data><data key="status">provisional</data><data key="desc">一股撕裂空气的杀意向西斯袭来。；感觉到生命危险的西斯发动了魔法，一对白色的羽翼伴随着闪光于她背后产生。；如果『变换』再继续下去，师父你的身体也会变成那样的！</data></node>
    <node id="塞拉指名基督决斗"><data key="name">塞拉指名基督决斗</data><data key="type">event</data><data key="status">provisional</data><data key="desc">此次前来所为无他，就是专程来找你决斗的。</data></node>
    <node id="涡波突进受挫与次元之戒"><data key="name">涡波突进受挫与次元之戒</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我挥动『阿雷亚斯家的宝剑诺文』向她斩去。；──剑刃在毫厘之间被阻挡了下来。；在诺斯菲的肩口被触及之前，一道由薄弱的黑光所构成的墙壁挡住了剑的去路。</data></node>
    <node id="舍身战法压制与诺斯菲中止反击"><data key="name">舍身战法压制与诺斯菲中止反击</data><data key="type">event</data><data key="status">provisional</data><data key="desc">把废物渣滓的命拿来当柴烧简直再合适不过了不是么──！！；这些全都是因为会对自己造成严重的损伤而被身边的人严令封印的招数。；再加上与罗德的约定，让她难以对我下狠手。现在诺斯菲已经完全中止了反击。</data></node>
    <node id="阿雷亚斯流剑术全传"><data key="name">阿雷亚斯流剑术全传</data><data key="type">event</data><data key="status">provisional</data><data key="desc">正因为『Dimension』把握到了这一剑中蕴藏的技艺，才让我为它的异常感到畏惧。能够予以形容的，除神技外无它。；「话说你真的在一天之内就将所有的东西都精进到大师级了啊……这样我能教你的就只剩下最终奥义了……」</data></node>
    <node id="海因战余波与拉丝缇娅拉归宅"><data key="name">海因战余波与拉丝缇娅拉归宅</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「真是的，都到这个时候了还说这个做什么啊……明明就只·剩·这·么·一·会·儿了……</data></node>
    <node id="五十层拦截战·被投回千年前的佩艾西亚"><data key="name">五十层拦截战·被投回千年前的佩艾西亚</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错，原定应在五十层得到召唤的确实是罗德。不过，就在不久前，我与执行召唤的术式进行了『交流』，将召唤对象从罗德转变为了我自己。；「直截了当地说，她正在为『试练』做准备。」；「此乃无上殊荣，赫勒比勒夏因。你·就·是·罗·德·的·新·弟·弟。」</data></node>
    <node id="涡波初次目视自身HP削减表示"><data key="name">涡波初次目视自身HP削减表示</data><data key="type">event</data><data key="status">provisional</data><data key="desc">第一次看到的表示。某人的最大HP在削减。；但是，我的身体却明白这是什么意思。我现在是在削减自己的生命使用魔法。</data></node>
    <node id="LizardFlyer初遭遇战·涡波负伤撤退"><data key="name">LizardFlyer初遭遇战·涡波负伤撤退</data><data key="type">event</data><data key="status">provisional</data><data key="desc">凡是活物就绝对无法避开的三道剑闪──好吧，却被LizardFlyer以轻盈的动作给避开了。；话音未落，LizardFlyer就潜入我的怀里，它那单薄却锐利的翅膀划过我的肩膀。；莱纳的『Sehr・Wind』便遭到了『魔法相杀』</data></node>
    <node id="千年前『结局』记忆再生"><data key="name">千年前『结局』记忆再生</data><data key="type">event</data><data key="status">provisional</data><data key="desc">受到影响的——只有我一人而已。；这幅状态很难称之为人，已经化作异形的『怪物』了。；「看来『水之理的盗窃者』没能成为容器啊……虽然很让人伤感，但这也无可奈何。盟友也不要哭了。替代品的话还是有的……」</data></node>
    <node id="帕林库洛教会密谈"><data key="name">帕林库洛教会密谈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">她将驱使自己那奇迹般的力量，将迷宫开拓至前人未至的领域</data></node>
    <node id="涡波发动『次元决战演算『前日谭』』"><data key="name">涡波发动『次元决战演算『前日谭』』</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没错，我要使用『次元决战演算『前日谭』』（维度・GradientRecall）。就是在迷宫和你战斗时用的那个」；「当然不会像那时候一样拼命的。这次不会进行对魂的『想起收束』，所以不用担心。我只是使用现存的魔力，调查一下招致这个惨状的人的去向而已。因为有些问题需要确认一下」；这便是魔法『次元决战演算『前日谭』』</data></node>
    <node id="战后致谢与『魔王』观感"><data key="name">战后致谢与『魔王』观感</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「非、非常感谢。『相川涡波・基督・欧亚・瓦尔德弗茨亚茨・冯・沃克』大人⋯⋯以及、这位风属性的大魔法使阁下」；「唔姆，不用客气。另外不要称呼人家什么大魔法使，叫勇者就好了」；但克洛伊小姐却一面点头一面退开一步。</data></node>
    <node id="莉帕迎回"><data key="name">莉帕迎回</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「太慢了─！」；「欧尼酱你不回来的话，没法吃午饭的呀─！所以赶紧回去吧─！」；莉帕手放在肚子上，生气地说。</data></node>
    <node id="海盗船烧毁击退（留守组）"><data key="name">海盗船烧毁击退（留守组）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">浓烟滚滚，船只像薪柴一样熊熊燃烧。船帆被火烧得不成原形，桅杆在火中摇摇欲坠。；「那艘船一开始是假扮成商船来跟我们交涉的⋯⋯，但是船员的代表一看到我们都是小孩子，态度就豹变，袭击过来了啊」；「看到一心遵守涡波的吩咐的玛利亚酱很困扰。我就擅自做出许可喽。跟她说『接下来还敢过来的家伙，就给他们的船烧成灰吧』来着！杀鸡儆猴嘛！</data></node>
    <node id="砂上漂战：莉帕骑乘兽化塞拉"><data key="name">砂上漂战：莉帕骑乘兽化塞拉</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我跟塞拉姐姐去会会它哦～。──魔法『维度・暗夜（Dark）』」；在塞拉小姐的巨体狠狠撞上SandSurface之后，莉帕的斩击接踵而来。SandSurface的一条腿被砍飞了出去。；充斥于现场的黑暗顷刻间全部消散。</data></node>
    <node id="雷纳尔多工房修理清空·转入锻冶训练"><data key="name">雷纳尔多工房修理清空·转入锻冶训练</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「没活儿了。昨天修得太多，做过头了」；让小子你有事做也是老朽的义务啊；看来我『所有物』的事暴露的一干二净。</data></node>
    <node id="看板知国势与图书馆翻译之谜"><data key="name">看板知国势与图书馆翻译之谜</data><data key="type">event</data><data key="status">provisional</data><data key="desc">抵达迷宫的最深部，也就是第一百层的话，似乎就能『实现任何愿望』。；日语被翻译成了这种奇妙的语言，而这种奇妙的语言也被翻译成了日语。</data></node>
    <node id="密室商谈·监视任务与魔法开发计划"><data key="name">密室商谈·监视任务与魔法开发计划</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──我希望莱纳你负责监视罗德」；「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『DistanceMute（幻之紫腕）』恐怕全都是最高位的魔法。──分别是『无法被干涉的攻击魔法』『无法被闪避的空间魔法』『无法被防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余」；「我想使用的是『无法被防御的即死魔法』──『DistanceMute』。如果学会这招，估计只要一击就能打倒『艾尔芬里斯』」</data></node>
    <node id="莱纳转移罗德注意力（前日）"><data key="name">莱纳转移罗德注意力（前日）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">昨天他为了将罗德的意识从我身上挪开而积累了相当的疲劳。；毕竟罗德不光在街上到处奔走，时不时还会想着打探窝在城里的我的状况</data></node>
    <node id="圣诞祭谢罪与拉丝缇娅拉的宽慰"><data key="name">圣诞祭谢罪与拉丝缇娅拉的宽慰</data><data key="type">event</data><data key="status">provisional</data><data key="desc">抱歉，拉丝缇娅拉。在大圣堂里说了那么一番豪言壮语，结果我却什么责任都没能尽到……。真的很抱歉；涡波你并不是英雄不是吗？；作为我的物语的《主人公》还是很努力了哦。涡波让我认识到了《我是我自己》这一点。</data></node>
    <node id="魔法双重发动相杀机制暴露与判明"><data key="name">魔法双重发动相杀机制暴露与判明</data><data key="type">event</data><data key="status">provisional</data><data key="desc">『维度・决战演算』确实掌握了空间内的所有魔法。而它的分析结果告诉我，方才『Default』一共被发动了两次。；在以诺斯菲为对手的时候，魔法会双重发动。；而且是以正反相抵的『相杀』形式──！</data></node>
    <node id="悬赏判明与绕路决定"><data key="name">悬赏判明与绕路决定</data><data key="type">event</data><data key="status">provisional</data><data key="desc">就像我们预想的那样，我们正航行的路线上似乎有不少海盗在活动。不仅如此，我们还被联合国冠上了赏金。；跟莉帕商量过之后，我们决定稍微绕一下远路。；「航线已经改变了，所以没问题了哦。虽然会绕点远路，但是明天还是能抵达『本土』的吧？那么吃过午饭后，就要开始迷宫探索了呢。今天谁要去？」</data></node>
    <node id="诺斯菲求教与涡波自认不知·邀共思（章末分头）"><data key="name">诺斯菲求教与涡波自认不知·邀共思（章末分头）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「啊啊⋯⋯，又是这样尽是失败⋯⋯⋯又是这样⋯⋯」；「我到底应该怎么做才好？请您教教我，涡波大人。如果说做正确的事也无法解决问题，那究竟应该⋯⋯」；「抱歉，这个我也不清楚⋯⋯」</data></node>
    <node id="诺斯菲复制家传剑法压制莱纳"><data key="name">诺斯菲复制家传剑法压制莱纳</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「呵呵，这剑法真是让人怀念呢。不过，正因为它令人感怀，所以我早已惯于应付了」；正好跟我手中的『阿雷亚斯家的宝剑诺文』『Sylph・堕落使徒』形状相仿。；诺斯菲一样习得了赫勒比勒夏因的双剑术。而且水准在我之上。</data></node>
    <node id="真留恋判明=说任性的话·任性委托"><data key="name">真留恋判明=说任性的话·任性委托</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「嗯。呵呵，简要来说的话，我想要的也就是让涡波大人听我说些任性的话而已吧。」；我的愿望不过只是『说任性的话』罢了，没错，我的愿望仅此而已。」；「那请您听我说句任性的话吧。如果可以，能否请您让我的『朋友』罗德恢复精神呢？</data></node>
    <node id="诺斯菲宣告莱纳为罗德的新弟弟（据诺斯菲声称）"><data key="name">诺斯菲宣告莱纳为罗德的新弟弟（据诺斯菲声称）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「可是说到罗德的家人，那不是已经有了么」；「此・乃・无・上・喜・悦，你・当・为・此・感・到・荣・幸，赫・勒・比・勒・夏・因。；只要有你（莱纳）在，艾德之流根本没有必要。这就是罗德得到的答案──」</data></node>
    <node id="剑与物资的交接分配"><data key="name">剑与物资的交接分配</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「不用，你还我可就壊事了。那本来就是专门给莱纳打造的东西。你当成我送你的礼物就行」；『阿雷亚斯家的宝剑诺文』被递到了我手边。；「这些以后就当成是莱纳的东西好了」</data></node>
    <node id="诺斯菲索求『契约的证明』（未遂）"><data key="name">诺斯菲索求『契约的证明』（未遂）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我很清楚这并不正确。但即使如此，我也要夺走涡波大人的一切。现在、就在这里⋯⋯」；「如果得到了那所谓契约的证明，你就能够满足了吗？你真的觉得这样就能实现自己的留恋了？虽然很抱歉，但我觉得肯定不是那样⋯⋯」；「舍此之外，我已经想不到别的了」</data></node>
    <node id="海莉的『连接』离场与生之决意"><data key="name">海莉的『连接』离场与生之决意</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着，海莉捏碎了一个戒指，发动魔法『连接』。魔法门显现于平原，大小甚至能容许一匹军马通过。；「我终于，明白自己该怎样去活了」；在我感到放心之时，海莉穿过了『连接』消失了。同时她的『连接』也在平原上的微风吹拂下消散。</data></node>
    <node id="涡波被投入连接·跨十六层坠至佩艾希亚御殿（章末）"><data key="name">涡波被投入连接·跨十六层坠至佩艾希亚御殿（章末）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「这样就将军了。我不会让您去地上的。诶诶、绝对不会──让您去地上」；超越次元，跨过整整十六层，坠落着。；我们从席卷着暴风雨的迷宫、一口气来到了鲜有人迹的静默之城。</data></node>
    <node id="涡波接入『世界奉还阵』·深渊感知与声音感应"><data key="name">涡波接入『世界奉还阵』·深渊感知与声音感应</data><data key="type">event</data><data key="status">provisional</data><data key="desc">发动技能次元魔术『维度』。接着，模仿海莉，打算让身体融化，使魔力进入『世界奉还阵』。首先全部理解『世界奉还阵』；没想到是如此的广阔的黑暗。帕林库洛说过把『世界奉还阵』和平『最深部』连接在了一起。通过他说的，正所谓可以称呼为世界深渊的世界，地面上张开的『世界奉还阵』的下面十分的广阔。；那里是满满的世界的『真理』『记忆』与『力量』</data></node>
    <node id="DistanceMute修炼遇瓶颈"><data key="name">DistanceMute修炼遇瓶颈</data><data key="type">event</data><data key="status">provisional</data><data key="desc">因为『Default』已经熟练掌握了，因此我集中练习的是『DistanceMute』；如果不削减生命去挑战『次元之理』的话，我可能没有办法掌握那份感觉。；经过刚才的魔法开发我的MP已经见底了。正在迷茫要不要削减生命使用魔法来着。不过还是想着今天先算了吧。</data></node>
    <node id="南军屠村·老夫妇之死与孤的觉醒复仇（英雄谭第一章真貌）"><data key="name">南军屠村·老夫妇之死与孤的觉醒复仇（英雄谭第一章真貌）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">全村的住房都变成了废墟，大家平日精心养育的家畜也都被残杀，街坊四邻的尸体被堆积在一处。；[——『孤』乃是支配这片大陆的翼人之王！继承最悠久的魔血的末裔，将此世上的一切纳入支配之下的王、『罗德（Lord）』！面对尔等草芥，孤绝无败北之理！！]；以老夫妇的死为契机发生的，孤的觉醒。</data></node>
    <node id="移居瓦尔德与酒馆就职"><data key="name">移居瓦尔德与酒馆就职</data><data key="type">event</data><data key="status">provisional</data><data key="desc">基督·欧亚（ChristEurasia）。这就是我在这个世界的名字。</data></node>
    <node id="涡波以DistanceMute与三连Default千米脱逃"><data key="name">涡波以DistanceMute与三连Default千米脱逃</data><data key="type">event</data><data key="status">provisional</data><data key="desc">罗德摆动以魔力生成的羽翼，精巧地操纵着在场的风。明明不是魔法，但风却能以生物般自如的行动挡住我的去路。；「──魔法『DistanceMute』！」；「──魔法『维度・多重展开』、『Default』『Default』『Default』！！」</data></node>
    <node id="决战终局——水晶双剑与冷气合击·帕林库洛完败冻结"><data key="name">决战终局——水晶双剑与冷气合击·帕林库洛完败冻结</data><data key="type">event</data><data key="status">provisional</data><data key="desc">质量大增的双剑开始颠覆战斗的局势。绝对不会被侵染的水晶不断斩裂黑刃。；帕林库洛打算用来强化黑刃的液体开始被『水之理的盗窃者』的冷气冻结。；「──给我冻住吧，帕林库洛！──『冰结剑』！！」</data></node>
    <node id="半小时锻冶实习"><data key="name">半小时锻冶实习</data><data key="type">event</data><data key="status">provisional</data><data key="desc">接着我就像漫步于自己长年使用的工房一样，手握锻冶用的道具，与艾利巴茨一起工作。；所幸次元魔术『维度』能够对毫米以下单位的动作进行调整。；这一切，都跟劳拉维亚内熟练的锻冶师的动作一模一样。</data></node>
    <node id="会长归迎骚动（史诗探索者玄关包围）"><data key="name">会长归迎骚动（史诗探索者玄关包围）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">虽然只是个挂名的会长，但自家公会的规模扩大还是令我感到非常高兴。走进新建筑物的大门，我告知了自己的归来。；「总之是可疑人物就对了。怎么说，先给他围起来？」；身穿长度及地的法衣的妙龄女性──缇莉・琉克随声音一同现身。看到可靠的公会大姐姐的登场，我激动地抬高了声调。</data></node>
    <node id="塞拉到访·交付通行文件"><data key="name">塞拉到访·交付通行文件</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「涡波。我把介绍信还有其它各种文件给你带来了。这些东西在你之后的行程中应该会派上不少用场。把它们收进你那个空间去吧」；我接过大量印有封蜡的羊皮纸。用『维度』随便浏览了一下，发现这些都是准许通过各国关卡的证明书和写给各地贵胄的人情信。</data></node>
    <node id="玛利亚移送与治疗布阵"><data key="name">玛利亚移送与治疗布阵</data><data key="type">event</data><data key="status">provisional</data><data key="desc">她捏碎了一个作为魔法道具的戒指，打造出翠绿色的魔法门。；「以少年现在的状态去战斗的话，又会让帕林库洛的精神攻击得逞的。现在先让莱纳帮你将受到污染的精神状态调整好。治疗的时间我会为你争取」；──状态：混乱7.87精神污染1.22认识阻碍0.23──</data></node>
    <node id="魔法屋全种类魔石采购（劳拉维亚）"><data key="name">魔法屋全种类魔石采购（劳拉维亚）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">所幸我既是史诗探索者的会长，同时又持有来自弗茨亚茨现人神的介绍信。；「──那个，虽然有些冒昧，不过请把这里所有种类的魔石都卖给我」；「而且所有种类各要两个哟！」</data></node>
    <node id="对RioshethEagle武器换装与零MP战术"><data key="name">对RioshethEagle武器换装与零MP战术</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──莱纳！对方明显是风魔法相性最差的对手！把『Sylph・堕落使徒』和『片翼』交换！还有和这家话战斗节约着使用风魔法！」；和里约鹰同样，不使用任何的风魔法，嘴和爪子的攻击才是主体。就算从莱纳的即死攻击中脱离出去，不使用风魔法追击，我控制住以后用投掷给予最后一击就好了。；节约魔力的关系，稍微拉长了点战斗时间，但没有什么特别的问题。这场战斗我们完全没有使用MP。</data></node>
    <node id="莉帕点破『维度』毫米级测量与玛利亚魔力外泄"><data key="name">莉帕点破『维度』毫米级测量与玛利亚魔力外泄</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──是没必要对吧。哥哥，因为有『维度』的关系，能清楚的得知细微到毫米级的尺寸吧？」；因为莉帕的发言，全员的视线往我身上集中了过来。；既凶恶又灼热的魔力爆了出来，似乎随时都有可能补捉到我并将我燃烧殆尽。</data></node>
    <node id="罗德转远程·魔弹风之矢箭雨追踪"><data key="name">罗德转远程·魔弹风之矢箭雨追踪</data><data key="type">event</data><data key="status">provisional</data><data key="desc">只将她摆动双翼，在顷刻间便飞到了数百米之外。；「『加速、而后进溅』、『花碎之瓣全数作风驱驰』！──魔弹（FlyShoots）『风之矢・散花（FallFlower）』！！」；风矢坠落有如骤雨倾盆。</data></node>
    <node id="塞拉赤手空拳镇压菲伊的护卫"><data key="name">塞拉赤手空拳镇压菲伊的护卫</data><data key="type">event</data><data key="status">provisional</data><data key="desc">塞拉小姐撕开自己的长裙，赤手空拳地走上前，面对着筋肉隆隆的男人们。；──紧接着，一个肌肉男便被击飞，撞到墙上。；拥有兽人的腕力补正，并且锻炼至人类最高水平的塞拉小姐的拳头，只是打向肌肉男的面门，就使体重百公斤以上的男人们飞在空中。</data></node>
    <node id="西区第四轮拉丝缇娅拉队vs斯诺队"><data key="name">西区第四轮拉丝缇娅拉队vs斯诺队</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「我绝对不会把『涡波』交给你们的……！他是我的东西！是我的！！」；「现在开始！！」</data></node>
    <node id="罗德坦白千年前迎涡波为臣之因与救世主告白"><data key="name">罗德坦白千年前迎涡波为臣之因与救世主告白</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「想来着实让人怀念啊。遥想当年，孤就是在这玉座之上、在一众臣子的反对之下，将涡波纳入麾下的啊」；千年前，孤究竟出于何种理由，才将作为南之『御旗』的丈夫的涡波，作为臣下迎入北方⋯⋯你知道吗？；真正的原因，是因为只有涡波曾劝孤舍弃王位</data></node>
    <node id="古奈尔脱队逃走"><data key="name">古奈尔脱队逃走</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「──然而这正是千载难逢的机会！就是现在！咱这就溜喽、后面的事就拜托你们了！等咱跑远了就会为了彼此再也不见而祈祷滴─！！」；见她突然狂奔起来，担任护卫的一干人等虽然吃惊但也只好追上去。；「算了，就放她去吧。看上去她是真的不想应付我们。这次只要知道有从千年前活到今天的人存在就足够了」</data></node>
    <node id="LivingLegend号黎明出航(本土)"><data key="name">LivingLegend号黎明出航(本土)</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「——大家，出发吧！就这样一路向『本土』进发！！」；在这个异世界中，我不再以基督·欧亚，而是以相川涡波的身份继续生活。</data></node>
    <node id="涡波悟得狂王/魔王因果·罗德即千年前传说之王"><data key="name">涡波悟得狂王/魔王因果·罗德即千年前传说之王</data><data key="type">event</data><data key="status">provisional</data><data key="desc">此时此刻，见到这一幕，我终于明白作为『支配之王』的罗德被敌人唤作『狂王』，被己方称为『魔王』的因果。；──这・就・是千年前的传说。；将濒临毁灭的诸国重新振兴统合在一起，继承最悠久高贵的血统的王中之王。</data></node>
    <node id="融合魔法着陆与『决斗场』结成"><data key="name">融合魔法着陆与『决斗场』结成</data><data key="type">event</data><data key="status">provisional</data><data key="desc">魔法『维度・决战演算』！；『火焰』！『Impulse』！！；这道火焰不是为了将接触到东西燃烧殆尽，而是为了将一切吹飞。</data></node>
    <node id="艾德天职探讨（老师）"><data key="name">艾德天职探讨（老师）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">「因为从小时候开始他就特别擅长学习啊。在那个村子里有着让学习好的人担任『牧师』的习俗，那『牧师』有没有可能是他的天职呢？」；我发掘通过联结获得的缇缇的记忆，回忆出艾德小时候的模样。想来确实，那个文静的少年，真的给人一种擅于冷静地排解他人烦恼的印象。；「──啊，说起来，他被身边的同伴们唤作『老师』来着哦」</data></node>
    <node id="孤发现自身年龄超百岁·创作咏唱『加速』自削"><data key="name">孤发现自身年龄超百岁·创作咏唱『加速』自削</data><data key="type">event</data><data key="status">provisional</data><data key="desc">孤、孤的年龄居然在一百岁以上……？；明明孤是一名叫缇缇的少女，但却被『支配之王（罗德）』这一存在加速侵蚀着。；[『加速』、『加速』『加速』『加速』。……『孤乃加速之魂』]</data></node>
    <node id="『感应』调波获诺文首肯：幻视栗发青年、魔法反转"><data key="name">『感应』调波获诺文首肯：幻视栗发青年、魔法反转</data><data key="type">event</data><data key="status">provisional</data><data key="desc">我依靠直觉发动技能『感应』；感觉剑的内部传来了人声。说什么「我自己也不擅长这方面的事呀」；那是对一个鼓着脸闹别扭的栗发青年的幻视。</data></node>
    <node id="柯尔拉纳潜入·独走再出发（ch144）"><data key="name">柯尔拉纳潜入·独走再出发（ch144）</data><data key="type">event</data><data key="status">provisional</data><data key="desc">新街道名为柯尔拉纳。；「不，不休息就出发。」；如果可以的话，我想赶在守护者艾德和使徒西斯之前到达帕林库洛的所在地。既然已经晚了，那么我一秒也不想浪费、</data></node>
    <node id="支配之王的归来与『后备之王』"><data key="name">支配之王的归来与『后备之王』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──鄙人要再次打造一个王国，等待『支配之王（Lord/罗德）』的再临。她必将于不远的将来从『那里』脱身吧。而这一次，胜利将紧握于『支配之王』手中。势必要经由我们的双手，为大陆带来和平与安宁──！没错，因为这才是王的心愿，亦是鄙人的心愿──！！」；「正是。涡波大人的水准甚至可以成为『支配之王』再临之前的『王』的替代品。毕竟是有相应的实绩的人」</data></node>
    <node id="迷宫之约：守护者与'具备资格者'"><data key="name">迷宫之约：守护者与'具备资格者'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——《理的盗窃者》死后会成为《守护者》，在千年后的《迷宫》里等待具备资格者的到来。那名具备资格之人应当可以让《守护者》消失，所以希望《守护者》们等到那个时候——如此这般。；所以孤才需要你和莱纳留在这里啊啊啊啊啊啊！！</data></node>
    <node id="咏唱的代价去向"><data key="name">咏唱的代价去向</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，不仅没有在行使什么魔法，她那翠色的魔力也丝毫没有增加。然而经由这份『咏唱』，她确实在支付着某种『代价』</data></node>
    <node id="帕林库洛事先准备的『魔法阵』（濒死续唱·涡波坐视）"><data key="name">帕林库洛事先准备的『魔法阵』（濒死续唱·涡波坐视）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最近这个词经常传入耳中。；到底是为什么，明明已经离死不远，明明我就在他身旁──帕林库洛却依旧继续着魔法构筑。；──就这么坐视不管了。</data></node>
    <node id="手环的破坏条件"><data key="name">手环的破坏条件</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就破坏那个手环吧。那样的话，我觉得你就能取回自我了。」</data></node>
    <node id="技能？？？真身"><data key="name">技能？？？真身</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">以一定的感情为交换，使精神安定下来。</data></node>
    <node id="莱纳的同归于尽装备与不归觉悟"><data key="name">莱纳的同归于尽装备与不归觉悟</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这小子根本就没想着活着回来。这些装备全都是为了跟敌人同归于尽而准备的」；「得打造出上好的武器让他免于依赖这种自爆用的道具才可以呐⋯⋯⋯首先就从这把剑开始着手吧⋯⋯」</data></node>
    <node id="斯诺的顿悟与'那个人'"><data key="name">斯诺的顿悟与'那个人'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「只·要·随·我·喜·欢·怎·样·都·行，说的是这个意思？也就是说，帕林库洛也做了一样的……？」</data></node>
    <node id="涡波终将拯救诺斯菲（缇缇确信）"><data key="name">涡波终将拯救诺斯菲（缇缇确信）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为人家相信，涡涡总有一天会拯救诺斯菲的</data></node>
    <node id="莉帕的不认输(三人战斗继续)"><data key="name">莉帕的不认输(三人战斗继续)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">所以战斗还远远没有结束。</data></node>
    <node id="诺斯菲的『留恋』之谜"><data key="name">诺斯菲的『留恋』之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">一同回去的，还有一个不清楚自身『留恋』的守护者。；——这•个•也•不•是？；这也意味着她的『留恋』变得越来越深重。</data></node>
    <node id="大圣堂一雪前耻之约"><data key="name">大圣堂一雪前耻之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">去和同伴们汇合，然后救回缇亚和阳滝，解决了这些之后再做好万全的准备前往大圣堂，在那里一雪前耻。</data></node>
    <node id="罗德真本事的兑现与世界崩壊进行"><data key="name">罗德真本事的兑现与世界崩壊进行</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯哦呀？这可真是这可真是、看来罗德终于使出真本事了呢」；再仰望天空，就可以看到一道非现实的龟裂。接着，随着裂痕的拓展，天空也开始七零八碎地剥落。不仅如此，再将视线偏向身旁，就能看到密布于大地之上的无数裂缝。；只能用世界崩壊来形容的光景如今就在眼前上演。</data></node>
    <node id="海莉的崩壊警告——涡波与缇亚'变得跟我一样'"><data key="name">海莉的崩壊警告——涡波与缇亚'变得跟我一样'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">感觉各方面的平衡都在崩溃。现在的我确实处于临近『崩壊』的状态吧。想起海莉的忠告，我自嘲着。；身体剧烈颤抖，身上淌满睡汗，心情差到极点。</data></node>
    <node id="阳滝之声发自涡波体内·'她在这里的理由'之谜"><data key="name">阳滝之声发自涡波体内·'她在这里的理由'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的里面声音发了出来，在『世界奉还阵』之中反响，恐怕是只能在这里面才能听到的细小的声音。在此之前，这个声音就是如此微弱而细小。；然后，阳滝在这里的理由明我也知道了。</data></node>
    <node id="白色少女的半年死线"><data key="name">白色少女的半年死线</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我想这支零破碎的身体，恐怕坚持不到半年了吧。」；「我想即使能够完全恢复⋯⋯，她或许也活不了多久了⋯⋯」；我还有很多想听这孩子说的事情⋯⋯不论如何一定要帮忙啊，拉丝缇娅拉</data></node>
    <node id="艾德×罗德再会——解开留恋/成佛的构想"><data key="name">艾德×罗德再会——解开留恋/成佛的构想</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「家人关系不一般──我也是同感呢。⋯⋯话说、怎么觉得比想像中要简单啊。搞不好只要让地上的艾德和地下的罗德相见，两个人立马就能成佛了呢」；「那么如果我去地上跟艾德打听的话，会不会就能明白罗德的留恋是什么了呢⋯⋯？」</data></node>
    <node id="第三个『魔石』之谜（或更多）"><data key="name">第三个『魔石』之谜（或更多）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在玛利亚离开之后，照理说现在这里剩下的『理的盗窃者』的魔石应该只有『地』与『暗』两个了。不过实际上并非如此。这里还有第三个魔石。；不，岂止三个，搞不好的话甚至有──！！；它又盗取了怎样的理，寄宿着怎样的力量呢。</data></node>
    <node id="舞斗大会=试练的期限"><data key="name">舞斗大会=试练的期限</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那个『试·练』开始了。不对，在更早之前，那一天，我第一次见到斯诺的时候，它恐怕就已经开始了。</data></node>
    <node id="四人共同点的中断之念"><data key="name">四人共同点的中断之念</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不知为何，我突然觉得不光是我，莱纳、罗德，甚至是诺斯菲，都需要得到像雷纳尔多这样的大人的话语。；我们四人的共同点，搞不好就是──</data></node>
    <node id="涡波拼命抑制的『不需注意到的事情』"><data key="name">涡波拼命抑制的『不需注意到的事情』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">再这么下去的话，连不需注意到的事情，我也要察觉到了。这么想着，我拼命地抑制着自己的思考。</data></node>
    <node id="缇亚的异常（困倦·『我』强调·白羽颤动·海莉的一瞥）"><data key="name">缇亚的异常（困倦·『我』强调·白羽颤动·海莉的一瞥）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如果说是看向拉丝缇娅拉的话我还能理解。但是她最后却看向缇亚，这让我猜不透她的意图。；「是啊⋯⋯，『我』是不必向你道歉的才对呢⋯⋯」；不过，在缇亚的身影消失在船舱的一瞬间，我视作装饰的白羽似乎微微颤动了一下。</data></node>
    <node id="本土追讨与三十层后探索双线"><data key="name">本土追讨与三十层后探索双线</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然路上打算抽时间推进迷宫探索，但基本上还是以搜索帕林库洛为要务的。；『火之理的盗窃者阿尔缇』和『地之理的盗窃者诺文』两人都教会了我许多。他们的教诲已经转化为了切实的力量。</data></node>
    <node id="佩艾希亚崩坏倒计时与罗德陪葬危机(更新)"><data key="name">佩艾希亚崩坏倒计时与罗德陪葬危机(更新)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">你能专程在『这里』迎来崩坏的一个月前出现。；若是依靠与涡波的共鸣魔法，那延长『这里』的寿命也并非不可能。只是那个空间魔法必须以涡波留在『这里』为条件。</data></node>
    <node id="六十六层天空摇动异变"><data key="name">六十六层天空摇动异变</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">感觉整个天空在摇动。漆黑的天空看上去有些不自然，就像暴风雨来临前活动激烈的云层一样。；「这里的天空一开始不就很奇怪吗？」</data></node>
    <node id="海莉队的先行与守护者魔石归属"><data key="name">海莉队的先行与守护者魔石归属</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不，岂止如此，说不定已经抵达40层之外了。；我知道她在担心什么。是在担忧守护者的魔石落入其他某人手中的事吧。</data></node>
    <node id="涡波话语的『特别的力量』"><data key="name">涡波话语的『特别的力量』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯这个我们做不到。你的话语有着特别的力量。而且，我们并没有判断其真伪的能力。因此我们不会去听你所说的任何话语，虽然想听⋯⋯但却不能听。我们只为将任务完成。现在开始将『王近卫骑士团』团长──断罪！！」</data></node>
    <node id="梦的记忆与异世界适应（再证）"><data key="name">梦的记忆与异世界适应（再证）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为梦的记忆，能够迅速的适应异世界已经察觉到了。还没有在异世界生活超过一个月，那场梦的原因感觉自己已经在异世界生活了好几年的感觉。；这是因为拉丝缇娅拉和玛利亚在旁边做榜样。还是说是依赖技能拷贝的原因状态的原因吗还是说────────梦的原因吗。我难以判断清楚。</data></node>
    <node id="黑云再现：千年前的悲剧即将重演的前兆"><data key="name">黑云再现：千年前的悲剧即将重演的前兆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「虽然浓度不比千年前，但毫无疑问是同种东西。在咱看来，只觉得这是千年前的悲剧即将重演的前兆」；「正是。从世界中泄漏出来的毒，为了寻找宿主而彷徨于世，而后就变作了这些黑云。因为这个原因，世界上所有的生物的级别都会变得易于上升。概而言之就是非常危险。另外，虽然只是推测，不过『兽人』的出生率应该也会上升吧」</data></node>
    <node id="缇缇的终局：见『真正的弟弟』并『结束所有这一切』"><data key="name">缇缇的终局：见『真正的弟弟』并『结束所有这一切』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，人家会去和真正的弟弟相见的。然后，就那样结束所有这一切。⋯⋯人家和莱纳、就得在这儿说拜拜了？」；「──缇缇，你可要好好和基督一起去解决跟艾德之间的因缘啊。就像你跟佩艾希亚的大家说过的那样，可千万不要再回到这里了哦？」</data></node>
    <node id="本土＝新战场宣告（ch224）"><data key="name">本土＝新战场宣告（ch224）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">啊啊，我终于重新来到了这个地方。；到了这个战场──</data></node>
    <node id="真名告知交易"><data key="name">真名告知交易</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如果基督将自己是『涡波』的事告知玛利亚的话，我就会将『我与缇娅拉』的关系告诉你。」</data></node>
    <node id="明日拉丝缇娅拉参战·一口气到39层"><data key="name">明日拉丝缇娅拉参战·一口气到39层</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「一切顺利呢。那么，明天我也要加入迷宫探索的队伍哦。最后的进度就由我来给画上句号！」；「原来如此。那么明天看来是能一口气到39层了呢⋯⋯」</data></node>
    <node id="雷纳尔多的'残留'发言"><data key="name">雷纳尔多的'残留'发言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">看・来・还・残・留・了・那・么・一・点・儿・啊</data></node>
    <node id="艾德动摇尽头的台词（章末悬置）"><data key="name">艾德动摇尽头的台词（章末悬置）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但我还是觉得缺了点什么。；因为刚发动『次元决战演算『前日谭』』而变得敏锐的感觉──、能够读取世界走向的技能『感应』──、至今为止和守护者战斗的经验──、全都告诉我事情不会那么简单。；（这样就、全都、结束了⋯⋯？鄙人重新变回弟弟⋯⋯──？）</data></node>
    <node id="负伤雷纳尔多×诺斯菲对峙"><data key="name">负伤雷纳尔多×诺斯菲对峙</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在足以召开舞会的广阔前廊，负伤的雷纳尔多和『光之理的盗窃者』诺斯菲正在对峙。</data></node>
    <node id="魔王城无人的原因（雷纳尔多搁置回答）"><data key="name">魔王城无人的原因（雷纳尔多搁置回答）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">需求不是没有。但现在已经没有人待在会产生需求的场所了；要不要回答你这个问题，看你接下来的表现而定</data></node>
    <node id="拉古涅与魔石的禁忌感应"><data key="name">拉古涅与魔石的禁忌感应</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">给谁都行，但是无论如何也不能把魔石交给拉古涅·卡伊库欧拉，直觉如此警示道。</data></node>
    <node id="莉帕的深层感情"><data key="name">莉帕的深层感情</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就算莉帕隐藏在深层心理中的感情跟好意相去甚远，我想要帮助莉帕的心情都没有改变。</data></node>
    <node id="黑暗中的声音"><data key="name">黑暗中的声音</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">然而，却感觉黑暗中传来了回应。</data></node>
    <node id="艾德的千年南北战争再现计划"><data key="name">艾德的千年南北战争再现计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">并且，如果我的猜想没有错的话──他这么做都是为了让千年前的『北方』与『南方』的战争重新上演。；特意增强弗茨亚茨的实力让它成为南方的中心，为的也是再现当初的弗茨亚茨──不，是为了打造出与『支配之王（Lord）』相匹配的敌国。；这一年的艾德的所有行动都是为了『支配之王（Lord）』，我们清楚地意识到了这点。</data></node>
    <node id="『维度』八变种统合的修行目标"><data key="name">『维度』八变种统合的修行目标</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">它的终点应当是『维度・多重展开』、『维度・决战演算』、『维度・千算相杀』、『维度・曲战演算』、『次元决战演算『前日谭』』、『次元决战演算『先谭』』八个变种的统合──如果能到达这一步，那我在战斗中便可立于不败之地。</data></node>
    <node id="涡波=魔石人类容器说（素体之谜）"><data key="name">涡波=魔石人类容器说（素体之谜）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">帕林库洛恐怕会在战斗中用更严酷的方式让你了解到这个事实吧。；技能『？？？』的效果，确实说得上是在对我进行『调整』。；只有莉帕感觉到了我的这种想法，她皱起了眉。</data></node>
    <node id="千年前战争的真结局与历史改窜疑云"><data key="name">千年前战争的真结局与历史改窜疑云</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">反而让我觉得她们才是真正的战犯，造成了大陆九成的死者，还强取豪夺地占取了胜利者的位置。；千年前那场战争的真正结局。难道战死者不应该是十成而非九成──其实所有人都死光了才对吗？正因如此，最后生存下来的圣人缇娅拉她们才能随意地扭曲这段历史不是吗？；「不管是『北方』还是『南方』，都没有叫这个名字的领袖哦。至少『缇娅拉』这个名字我应该是从来没听说过的啦」</data></node>
    <node id="消失的记忆（主角侧）"><data key="name">消失的记忆（主角侧）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">于此同时，我意识到自己一份重要的记忆作为代价消失了。</data></node>
    <node id="对常人『连接』的封印与否决"><data key="name">对常人『连接』的封印与否决</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最强的『理之盗窃者』直接制作出『连接』；以常人为对手的话这招还是封印起来比较好。；于是我跟缇缇许诺说『以后我不会再用了』</data></node>
    <node id="雷纳尔多未竟遗言（『只有那丫头还是老朽的⋯⋯』）"><data key="name">雷纳尔多未竟遗言（『只有那丫头还是老朽的⋯⋯』）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「事到如今，只有那丫头还是老朽的⋯⋯、⋯⋯──」；「她仍然孤身一人」、这指的想必就是罗德。</data></node>
    <node id="『船』购入目标(特殊船·船内『连接』)"><data key="name">『船』购入目标(特殊船·船内『连接』)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在那之后，我们找到了几个人也能开动的特殊的船，不过那需要过度的金钱。；「⋯⋯有些为难啊。比这里还大的赌场可没有多少。这样继续下去的话到时间结束为止都没办法入手『船』」；这不是什么壊事，能在船内安心设置『连接』的话，对今后也有好处。不过，的确大部分都只是拉丝缇娅拉的个人兴趣罢了。</data></node>
    <node id="帕林库洛的英雄剧本"><data key="name">帕林库洛的英雄剧本</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">于『舞斗大会』中获胜。大陆全土都被其威名震动</data></node>
    <node id="六十层不知底细的守护者"><data key="name">六十层不知底细的守护者</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我明白，毕竟在六十层还有不知底细的守护者。；是啊，最大的难关就是那里了吧。要是出来个不听人话的家伙就糟透了。</data></node>
    <node id="罗德的留恋"><data key="name">罗德的留恋</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，在那条路的尽头我们什么也得不到。既无法实现罗德的留恋，我也无法帮助妹妹和同伴们，莱纳那扭曲的生存方式也不会好转。；因为我们的强化是跟对罗德的救济有直接关系的，所以雷纳尔多一脸高兴地催促我动身。；这样吗……明天人家要一个人了吗……</data></node>
    <node id="艾德的战争重发意图（咏唱扩散）"><data key="name">艾德的战争重发意图（咏唱扩散）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在大圣堂那时候虽然我隐约有所预感，但看到连自己认识的少女都能使用还是让我感到头大。；他不惜做到这个地步也想要让已经偃旗息鼓的战争重新爆发吗？</data></node>
    <node id="总长的迅速拦截之谜"><data key="name">总长的迅速拦截之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我最先感到的违和感是总长等人的行动何以如此迅速。</data></node>
    <node id="战争激化的幕后搭桥牵线者"><data key="name">战争激化的幕后搭桥牵线者</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就像是有什么人在幕后搭桥牵线一样，就连各地的小国都变得崇武好战。战争的激化实在过早，南方的高层看不透北方的意图，全都怀疑北方是失去了理智。</data></node>
    <node id="基督自我变化之问（技能变化／成长／其它缘由·束缚解除）"><data key="name">基督自我变化之问（技能变化／成长／其它缘由·束缚解除）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是因为技能『？？？』变成了技能『最深部之誓约者』的缘故吗，还是因为跨越了和帕林库洛的战斗让我的身心得到成长的缘故呢。亦・或・是・因・为・什・么・其・它・的・缘・由。反正我现在终于能够察觉、并确信这一点了。；只是，这次的打击类型是『失恋』，在技能『？？？』还在的时候这种类型的精神打击是不可能产生的，所以我只是有些吃惊罢了。；不过，很・不・可・思・议・的是，我今天并不想遵守妹妹的禁令。就好像是某种一直束缚着自己的『什么东西』被解除了一样⋯⋯有种前所未有的解・放・感。</data></node>
    <node id="技能『？？？』的死之禁止"><data key="name">技能『？？？』的死之禁止</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">既然一切都没有意义，那我也不要继续活下去了。我想要休息。但是，因为技能『？？？』的缘故，我就连死都不被允许。</data></node>
    <node id="明日的全员坦白"><data key="name">明日的全员坦白</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「没错。但是今天已经晚了所以要等到明天再说。明天，把大家都叫来一起说。毕竟这事不能只让玛利亚一个人知道。」；「至今为止只有你一个人知道我的身份吧。那个，我不打算再隐瞒下去了。」；「我是来自异世界的那个。」</data></node>
    <node id="帕林库洛的种子网"><data key="name">帕林库洛的种子网</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">撒下的种子太多，最后到底哪个会结果还未为可知。</data></node>
    <node id="涡波的不祥预感"><data key="name">涡波的不祥预感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「实话跟您说，我有一种不详的预感⋯⋯⋯不知怎么，就是觉得不加快动作不行⋯⋯」</data></node>
    <node id="决赛对诺文(一切了结之地)"><data key="name">决赛对诺文(一切了结之地)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我不会再劝你什么了。接下来就交给诺文吧。明天决赛的时候我会带你一起去，然后在那里给一切做个了结吧。」</data></node>
    <node id="第五次『试练』逼近·涡波负有接受义务"><data key="name">第五次『试练』逼近·涡波负有接受义务</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">得知合计起来算是第五次的『试练』正在逼近；您有接受的义务。没错，这是作为抵达守护者阶层之人应尽的义务」</data></node>
    <node id="罗德的旧识自称与'被封印的姐姐'"><data key="name">罗德的旧识自称与'被封印的姐姐'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为姐姐我和涡涡之间的关系很好嘛；如果不喜欢『国王酱』的话，想要用被封印起来的『姐姐』称呼也行喔。；「切。虽然没有记忆这回事是真的，防御还是一如既往的坚固啊──」</data></node>
    <node id="被造物与真心"><data key="name">被造物与真心</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">全都是假他人之手塑造而成的『被·造·物』。</data></node>
    <node id="『这一次，我不会再放您去任何地方』"><data key="name">『这一次，我不会再放您去任何地方』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这样就将军了。我不会让您去地上的。是了、绝对不会，这一次，我不会再放您去任何地方。」</data></node>
    <node id="缇亚的身份撕裂"><data key="name">缇亚的身份撕裂</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我、我是缇亚……不是、西、斯……」</data></node>
    <node id="罗德的真『留恋』之谜"><data key="name">罗德的真『留恋』之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为人家的『留恋』，就是和平安稳地生活在『这里』呀。；不是这样的。即使在『这里』得到了和平与安宁，你的『留恋』也没有实现。；但是，即使抛弃一切也想要实现的东西，那就必定是作为佩艾希亚的王所无法达成的事吧。</data></node>
    <node id="『光之理的盗窃者』（诺斯菲）最终对峙"><data key="name">『光之理的盗窃者』（诺斯菲）最终对峙</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">现在就只剩下『光之理的盗窃者』要解决了。；从此刻起，一切不再是诺斯菲掌中之物。</data></node>
    <node id="千年前的真相：罗德与诺斯菲的王者姿态"><data key="name">千年前的真相：罗德与诺斯菲的王者姿态</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她们不应该像现在这样孩子气，而应该更加成熟才对。；那不是她们现在这样身着朴素服饰的样子，而是穿着与王的身份相符的奢华服饰的两人的姿态。</data></node>
    <node id="白色少女与海因的未明关系"><data key="name">白色少女与海因的未明关系</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她确实对于海因先生的名字有所反应。他们之间毫无疑问有着什么关系存在。；看起来也不像是失败的样子，这样的话不就像是⋯⋯」</data></node>
    <node id="黯淡之龙的遗言"><data key="name">黯淡之龙的遗言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接着不知为何，它的视线稍稍挪移，看向了我身旁的莉帕。</data></node>
    <node id="缇亚的剑认领（宝剑归属对证）"><data key="name">缇亚的剑认领（宝剑归属对证）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「咦、咦？基督……我的剑呢……？」</data></node>
    <node id="六十七层的两只更大规格的龙"><data key="name">六十七层的两只更大规格的龙</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，就算去了下一层，在那里等着的可是两只更大规格的龙哦？</data></node>
    <node id="海莉・维斯普洛佩的拦截"><data key="name">海莉・维斯普洛佩的拦截</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，为了配合我一样，那匹军马也稍微改变了路线。；和我一样，有着不然敌人逃走的能力的她。；从堡垒里出来的白色少女────海莉・维斯普洛佩。</data></node>
    <node id="格连的'那个时候'与假货自称"><data key="name">格连的'那个时候'与假货自称</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嘿~，感觉跟我从帕林库洛那儿听说的完全不一样啊……哎呀，是在好的意义上哦？不要会错意了哦？我不是在说你的坏话哦？你可别生气哦？」</data></node>
    <node id="瓦尔法拉后的围堵"><data key="name">瓦尔法拉后的围堵</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，没事的，到了那个时候涡波会为我做些什么的，所以也不用担心。」</data></node>
    <node id="诺斯菲『从大人变成一个孩子』的留言"><data key="name">诺斯菲『从大人变成一个孩子』的留言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我已经不会再忍耐了。因为，我好不容易才从大人变成一个孩子啊──」；这是在跟她自己说的吗。还是跟别的什么人说的呢。现在的我无从得知。</data></node>
    <node id="阿尔缇的悲恋往事"><data key="name">阿尔缇的悲恋往事</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「也，也就是说、阿尔缇也经历过一段无果的恋爱……？」</data></node>
    <node id="魔石拔除影响过小之谜"><data key="name">魔石拔除影响过小之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">首先是按理来说绝对不会改变的素质的数值有一点减少。与之相应地，魔力的数值也减少了。；我觉得这影响实在是有点太小了。；尽管我试图去揣摩理由，但终究找不到头绪。虽说这不算壊事所以到不了悲观的程度，但说实话也不是能让我高兴的事。</data></node>
    <node id="联合国悬赏与行踪暴露风险"><data key="name">联合国悬赏与行踪暴露风险</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">看这袭击的频度，总觉得是有什么理由。我想确认一下。；「没办法。先给他们抓起来，然后问问看为什么这么执着于我们吧」；「也是啊。得好好问一问呢。到时候说不定改变了路线就能减少敌袭的说」</data></node>
    <node id="挑战守护者与使徒（宝剑诺文收回之因）"><data key="name">挑战守护者与使徒（宝剑诺文收回之因）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接下来我就要去挑战守护者和使徒了</data></node>
    <node id="大姐的『魔石』回收计划"><data key="name">大姐的『魔石』回收计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不过如果能就这样顺利回收大姐的『魔石』的话那就再好不过──话是这么说，嘛啊，一时半会儿还是够呛的吧</data></node>
    <node id="玛利亚与最重要之物的相似"><data key="name">玛利亚与最重要之物的相似</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最重要的是，她实在是过·于·相·似·了</data></node>
    <node id="涡波的心之锁（感应诊断）"><data key="name">涡波的心之锁（感应诊断）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不仅支离破碎，在其上似乎还加了很多重锁的样子……坚固而不自由的锁……」；「是啊，没错。我的技能『感应』判断相川涡波的精神状态并不正常。……只是，除此之外我也不会多言。因为我是行将消失的存在，话虽然能说两句，但没法帮你这个忙。」</data></node>
    <node id="迷宫的吞噬"><data key="name">迷宫的吞噬</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「被『迷宫』吞噬的。」</data></node>
    <node id="『试练』=千年前的『过去』(北方同盟)"><data key="name">『试练』=千年前的『过去』(北方同盟)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「也好……那一切就依吾友所言……先进行『试练』吧……」；「这便是『这里』真正的姿态……这才是我等的真相。涡波啊，和孤一起历数罪状吧。就算要再花上一千年……」；直觉告诉我，这里是千年前被我和罗德舍弃的『北方同盟』。</data></node>
    <node id="对艾德之战将近（热身定位·既有核心钩推进）"><data key="name">对艾德之战将近（热身定位·既有核心钩推进）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">对把这个问题当做一大危机的军队来说可能有些失礼，但这场战斗于我而言只不过是与艾德战斗之前的热身运动罢了。</data></node>
    <node id="英雄斯诺·沃克形象的彻底颠覆（ch222总钩）"><data key="name">英雄斯诺·沃克形象的彻底颠覆（ch222总钩）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">────然而好景不长。；然而到头来，她还是不得不认同哥哥的评价。；因为至今为止树立起来的英雄斯诺・沃克的人物形象即将被彻底颠覆──</data></node>
    <node id="白发少女的'材料'之谜"><data key="name">白发少女的'材料'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">制造出我所用的材料，就是海因・赫勒比勒夏因的身体。；虽然我也有这样的预感，但是当这些话从少女口中亲自道出，预感便转换为了确信。</data></node>
    <node id="帕林库洛的真计划"><data key="name">帕林库洛的真计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这样一来圣诞祭就结束了吗。……到最后，还站着只有我一个。跟计划中一样，就我一个啊。」</data></node>
    <node id="级别的提升并不是成长──『什么东西』之谜"><data key="name">级别的提升并不是成长──『什么东西』之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是昨天海莉的话让这份自信蒙上了阴影。「我并不觉得你是成长了」这句话不时在耳边回响。；就像是觉得级别的提升并不是成长一样──我注意到了更为不同的『什么东西』；为了搞清楚那东西到底是什么，技能『并列思考』开始了运转。</data></node>
    <node id="迷宫建造者『某人』的体贴设计"><data key="name">迷宫建造者『某人』的体贴设计</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『某人』为了挑战35层的探索者特地准备了这个空间——；虽然因为规则的限制，到最后他也没告诉我这个『某人』是谁，但是从他的说辞看来打造出迷宫的人是确实存在的。</data></node>
    <node id="双守护者与千年前形象的违和"><data key="name">双守护者与千年前形象的违和</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">看上去她对我丧失记忆这件事并没有受到太大的冲击。；那个被冠以『狂王』『魔王』『支配之王』这些如雷贯耳的称号的存在？；我总觉得过去的罗德和诺斯菲跟她们现在的样子有所不同。</data></node>
    <node id="罗德康复后的异变(王座与『真正的愿望』)"><data key="name">罗德康复后的异变(王座与『真正的愿望』)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">对此，罗德点了点头。接着，她以稳健的步伐——坐·到·了·王·座·上。；「嗯，一路走好。另外，非常感谢你，涡·波……拜你所赐，人家真正的愿望好像终于能实现了……」；——那个罗德居然给人成熟的感觉？</data></node>
    <node id="涡波的现在/过去天秤（回地上 vs 救罗德）"><data key="name">涡波的现在/过去天秤（回地上 vs 救罗德）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我现在最担心的是地上的事。因此才欺骗罗德，并用最快的速度做着回到地上的准备。自己现在的计划跟雷纳尔多的委托是完全对立的。；我将『现在』和『过去』置于天秤上权衡起二者的重量。</data></node>
    <node id="玛利亚的正体：半守护者·盲眼少女·后备之王"><data key="name">玛利亚的正体：半守护者·盲眼少女·后备之王</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">要说有这个资格的，就只有这位盲眼的少女而已了吗──」；他朝玛利亚瞥了一眼。；她身上缠绕着不逊于守护者艾德的浓厚魔力，瞪视敌人。</data></node>
    <node id="光魔法学生劝诱计划（艾尔米拉德学院）"><data key="name">光魔法学生劝诱计划（艾尔米拉德学院）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那是一个把我的探索迷宫计划从根本上颠覆的情报。至于有多么重要，那就是回到地上以后一定要从艾尔米拉德学院里劝诱一个会使用光魔法的学生这般重要。</data></node>
    <node id="『支配之王（Lord）』本名的时代残留"><data key="name">『支配之王（Lord）』本名的时代残留</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">一瞬间斐勒卢托的身体挺直了起来；「缇缇⋯⋯？不，怎么会⋯⋯」；看来，『支配之王（Lord）』的本名在这个时代还有残留。</data></node>
    <node id="五十层世界=缇缇的一切展现（第五十之试练连接）"><data key="name">五十层世界=缇缇的一切展现（第五十之试练连接）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">同时也是将人家的一切展现而出的五十层的世界⋯⋯一个空空如也的地方。；那是淤积了整整一千一百一十一年的『悲鸣』</data></node>
    <node id="罗德与『以前』的涡波／被封印起来的『姐姐』"><data key="name">罗德与『以前』的涡波／被封印起来的『姐姐』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">罗德·缇缇？或者说，和以前一样，放轻松叫人家『国王酱』也可以哦。；因为涡涡永远都是涡涡，所以这个请求可做不到呢。如果不喜欢『国王酱』的话，用被封印起来的『姐姐』称呼也行哦。；虽然没有记忆这回事是真的，防御还是一如既往的坚固啊</data></node>
    <node id="勒伽西的千年后游戏（不安定的'重新来过'）"><data key="name">勒伽西的千年后游戏（不安定的'重新来过'）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">一切都是勒伽西为了在千年后再跟我一起玩。；通过在千年后打造出不安定的『重新来过』的状况。</data></node>
    <node id="缇缇对艾尔芬里斯的想起（内容未言明）"><data key="name">缇缇对艾尔芬里斯的想起（内容未言明）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，好的，知道了！人家终于想起来了！果然，你是──！！」</data></node>
    <node id="白发少女之谜"><data key="name">白发少女之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——与说是最大烦恼也不为过的少女的相遇。；让我莫名眼熟、一头白发、皮肤白皙、给人以飘渺之感的少女。；不过，我会觉得眼熟也是当然的。毕竟构成她的材料正是——</data></node>
    <node id="呼唤罗德的陌生声音之正体"><data key="name">呼唤罗德的陌生声音之正体</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──明明是这样，但却传来一道陌生的声音。；「我为了搞出那本书可是把命都折了。你再不愿意也得给我读」</data></node>
    <node id="海莉・维斯普洛佩的身世之谜（帕林库洛的土产）"><data key="name">海莉・维斯普洛佩的身世之谜（帕林库洛的土产）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接下来，我将会与她相遇。；与那名雪白的少女──；一股不明来由的怀念之情涌上心头。</data></node>
    <node id="『世界奉还阵』/『咒术』的本来归属"><data key="name">『世界奉还阵』/『咒术』的本来归属</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「基督！！魔力不足的话，你也使用『世界奉还阵』！！海莉也想帕林库洛一样！！你的话也能做到！不，这本来就是，你的『魔法阵』不是吗！？」；确实，有可能干涉这个『魔法阵』。如果千年前的记忆是正确的话，这个『咒术』本来就是我的东西。有尝试这个新的技能的价值。</data></node>
    <node id="北方统一战线数日内崩溃预断"><data key="name">北方统一战线数日内崩溃预断</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">毕竟再过几天『北方』的统一战线就会崩溃的</data></node>
    <node id="招待塞斯提亚与历基亚国公主的既定日程"><data key="name">招待塞斯提亚与历基亚国公主的既定日程</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「斯诺大人会哭！？⋯⋯不不，就算您说不许进入、可是接下来还有怪物讨伐的报告书以及招待塞斯提亚和历基亚国公主的事情要处理啊！」</data></node>
    <node id="『支配之王』被夺之谜（据骑士指控）"><data key="name">『支配之王』被夺之谜（据骑士指控）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「把我们的『支配之王』还给我们⋯⋯⋯那位大人是我们的希望⋯⋯是我们要活下去所必须的路标⋯⋯」；「没有『支配之王』的话，这个国家就会毁灭的⋯⋯」；「请告诉我们⋯⋯⋯为什么要带走我们的王⋯⋯？」</data></node>
    <node id="西斯的目的地与帕林库洛・勒伽西/守护者"><data key="name">西斯的目的地与帕林库洛・勒伽西/守护者</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">庆幸的是，我了解西斯的目的地，还有回收拉丝缇娅拉的余裕。；现在『感应』的警告声也在我的头上回响。；「在我看来现在涡波先生和拉丝缇娅拉小姐都很虚弱，即使如此也要去追缇亚小姐吗？即使知道前面有帕林库洛・勒伽西和守护者也要去吗」</data></node>
    <node id="莱纳燃烧生命后的生死悬置"><data key="name">莱纳燃烧生命后的生死悬置</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">MP枯竭之后还要使用魔法的话，代价就是将生命当做薪柴。恐怕这就是我今天使用的最后的魔法了。；话是这么说，那也要看您能否活下来呢</data></node>
    <node id="雷纳尔多的遗言式送别"><data key="name">雷纳尔多的遗言式送别</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哼⋯⋯⋯这样就好。你就这样离开这里，再也别回来了啊⋯⋯」；「徒劳罢了。等不到房子崩塌，我一瞬间就会结束这一切。我绝对不会让涡波大人逃走的」；尽管温柔，却又像遗言一般幽孱。</data></node>
    <node id="缇缇将对艾德传达之物"><data key="name">缇缇将对艾德传达之物</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在最后，缇缇到底会跟艾德传达些什么呢⋯⋯我一面对此感到在意，一面驱车出发。；在这段『归途』中，缇缇找到了形形色色的东西。</data></node>
    <node id="正统守护者的战斗终结规则"><data key="name">正统守护者的战斗终结规则</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哈哈，表情不错嘛，少年！果然，你已经完全跨越了『二十之试练』了啊！嘛啊，这点其实根本用不着确认了就是！如果我是正统的守护者的话，到这里就不得不结束战斗了才行呢⋯⋯──不过那跟我可没关系！！」</data></node>
    <node id="罗德狂暴暴风（吹飞三人）之冲突走向"><data key="name">罗德狂暴暴风（吹飞三人）之冲突走向</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「吵、吵死了！！」；罗德终于无法忍耐，浑身战栗起来，并狂暴地解放出自己身上的魔力。；可以与莱纳的『Sehr・Wind』相匹敌的暴风旋即席卷、吹飞在场的三个人。</data></node>
    <node id="弗茨亚茨之疑（艾德暗手）"><data key="name">弗茨亚茨之疑（艾德暗手）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这经过艾德上下其手的弗茨亚茨仍是深浅莫测。；这个国家──弗茨亚茨在我看来非常可疑。而且拉丝缇娅拉她的样子也有些不对劲。</data></node>
    <node id="始祖涡波授业之谜（重崩色之非风剑）"><data key="name">始祖涡波授业之谜（重崩色之非风剑）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这一招正是过去的你所传授的力量！这份罪过，你就好好品尝吧！！；这种喊法，跟我不久前教导莱纳的魔法运用方法如出一辙啊。</data></node>
    <node id="诺斯菲的三重自锁（诅咒/光之咏唱/半死体）"><data key="name">诺斯菲的三重自锁（诅咒/光之咏唱/半死体）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「可是，要是使用了『光之理的盗窃者』的『诅咒』的话，那就无法证明我对涡波大人的思慕了。所以绝对不可以。但是使用光之『咏唱』也不行，那样我好不容易才削减的良心又会恢复的。变成『半死体』就更不用说了。但是话是这么说，我也不能在这里打出密藏的手牌。⋯⋯啊啊，这实在是──」</data></node>
    <node id="共鸣魔法『形式・The──』（命名中断）"><data key="name">共鸣魔法『形式・The──』（命名中断）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我要将阳滝的冰之魔力和我的次元魔力结合在一起。编织出最强的魔法。；「──次元啊，给我冻结吧！共鸣魔法！『形式・The──』；但是魔法的构筑就白费了。</data></node>
    <node id="艾德接引计划（一月限·说服罗德返地）"><data key="name">艾德接引计划（一月限·说服罗德返地）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我觉得我必须尽快将艾德带到罗德的身边。我会在一个月之内把艾德带过来，并说服罗德，无论如何也要想办法给她送到地上。</data></node>
    <node id="涡波的南北罪孽（据诺斯菲声称）"><data key="name">涡波的南北罪孽（据诺斯菲声称）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">请您不要忘了即使偿清了对『北方』犯下的罪孽，在『南方』一样留有罪过有待您清偿。</data></node>
    <node id="世界树烧却计划（逼出迪普拉库拉）"><data key="name">世界树烧却计划（逼出迪普拉库拉）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">可得尽快去把弗茨亚茨本国的『世界树（Yggdrasil）』给烧了才行呢；「不过，我这个人生来就跟所谓最糟糕的情况有不解之缘⋯⋯所以请你还是做好会变成那样的觉悟吧，西娅」</data></node>
    <node id="帕林库洛的斗争火种计划(本土决战)"><data key="name">帕林库洛的斗争火种计划(本土决战)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「如果你要去追那家伙的话，他肯定是在西大陆——在『本土』那边。……帕林库洛在做着将你孕育成『斗争的火种』的打算。因为那家伙是秘密主义者，所以详情我也不清楚。但是事情闹得越大，那家伙肯定越高兴。要是去追他的话，你一定要小心。」</data></node>
    <node id="拉丝缇娅拉的过去誓约(第二次机会)"><data key="name">拉丝缇娅拉的过去誓约(第二次机会)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我曾发誓要蒐求真实，曾发誓不可踏入歧途。；我曾发誓，如果有第二次机会，那么我不可以再失败……！</data></node>
    <node id="阳滝之病与誓约"><data key="name">阳滝之病与誓约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">而让她变成这样的罪魁祸首则是我。</data></node>
    <node id="海莉证言可信度疑云（帕林库洛手脚/陷阱嫌疑）"><data key="name">海莉证言可信度疑云（帕林库洛手脚/陷阱嫌疑）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──说实话，我依然不觉得海莉的推测是完全正确的。；既然是帕林库洛主导了海莉的诞生，那么海莉的认识被下了什么手脚的可能性就不小。岂止如此，就连她挡在我面前都可能是帕林库洛的陷阱。；用『并列思考』浏览一遍目前的所有情报后，我发现了些微的异常。</data></node>
    <node id="技能『？？？』解决前禁告白"><data key="name">技能『？？？』解决前禁告白</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我摸清了技能『？？？』对于恋爱可以承受的界限。看来会发展到告白程度的爱意是不行的。；——技能『？？？』的发作就会让我丧失那份爱情，只留下拉丝缇娅拉一人。；——直到解决技能『？？？』为止。</data></node>
    <node id="与支配之王的相遇记忆（遮蔽中）"><data key="name">与支配之王的相遇记忆（遮蔽中）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">即使知道假面男子在跟『支配之王』交谈，却无法看清少女的面貌，也不知谈话的内容。；想要让这份记忆变得更加鲜明的话，就必须更接近这名假面男子才可以。；也就是说，必须进一步升级才可以。</data></node>
    <node id="缇缇的『最后的时间』（ch224再证）"><data key="name">缇缇的『最后的时间』（ch224再证）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">毕竟缇缇的人生是极其不幸的。；而这段旅程则是对缇缇而言的『最后的时间』。</data></node>
    <node id="缇亚的力量与金钱动机"><data key="name">缇亚的力量与金钱动机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我必须要尽快得到『力量』和『金钱』才行</data></node>
    <node id="拉丝缇娅拉一行的遭遇"><data key="name">拉丝缇娅拉一行的遭遇</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我这边早早就完事儿了。发生了这样那样的事有点不愉快啊，所以我就来这边了。」</data></node>
    <node id="携诺斯菲回地上的再会危机（技能警报）"><data key="name">携诺斯菲回地上的再会危机（技能警报）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这俩技能，明明我在迷宫里差点都要被怪物干死了也默不作声，现在倒是搁那里叫个不停。；就是说如果我带着诺斯菲去见地上的同伴们的话，那危险度比我在迷宫里差出40级以上的地方探索还高呗。⋯⋯好吧，有道理，我无法否定。；大家可以想像一下，让我跟她们再会的时候「啊，介绍一下，这位是我老婆诺斯菲」试试，空气当场冻结？不存在的，朋友，这句话会直接成为我的遗言。</data></node>
    <node id="风龙讨伐（六十六层挑战）开环"><data key="name">风龙讨伐（六十六层挑战）开环</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">要是新魔法顺利的话，我想只要一击就能打倒那条龙了；只要被我接触到，就有将它无力化的自信，胜算这次姑且是有的。；应着我的挑衅，遮盖天空的茶褐色巨体自上而下地朝我袭来。</data></node>
    <node id="佩艾希亚住民被害指控与涡波的千年前罪责"><data key="name">佩艾希亚住民被害指控与涡波的千年前罪责</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">而涡波大人您却欺骗了他们所有人──并最终害死了他们。；「你⋯⋯、你是说『佩艾希亚』变成这样都是我的错吗？」</data></node>
    <node id="『支配之王』的正体（阳滝之魂寄宿说）"><data key="name">『支配之王』的正体（阳滝之魂寄宿说）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然是我的推测，不过那个所谓的『支配之王』其实应该是『寄宿着阳滝的魂的我的身体』吧。根据在六十六层时从莱纳那里听来的话，我觉得应该八九不离十。；『支配之王』──我最后看到阳滝的时候她的级别只有个位数。</data></node>
    <node id="莱纳劝诱入伙布局（瓦尔法拉起手）"><data key="name">莱纳劝诱入伙布局（瓦尔法拉起手）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我不要。我绝对要让莱纳成为同伴。之前在『瓦尔法拉』唆使他来本土就是为了这一步布的局」；他是现在最有能力打破我一男六女队伍现状的逸材。哪怕有一个能跟我共患难的同性，我的胃就能少受点苦！；「但是你可不要搞错了！在搞清楚一切的真相之前，我可没有和你们打成一片的打算哦！」</data></node>
    <node id="三重意志与莉帕的回传"><data key="name">三重意志与莉帕的回传</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——莉·帕！！</data></node>
    <node id="『水之理的盗窃者』容器失败与替代品之谜"><data key="name">『水之理的盗窃者』容器失败与替代品之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">看来『水之理的盗窃者』没能成为容器啊；盟友也不要哭了。替代品的话还是有的⋯⋯</data></node>
    <node id="海莉的发作症状与船上详细诊断"><data key="name">海莉的发作症状与船上详细诊断</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哈啊哈啊⋯⋯！在，在这种时候发作？何等不堪！」；「那孩子，跟我一样⋯⋯？但是，这个症状⋯⋯！」；「不过，失血量实在太大了⋯⋯⋯不可能立马痊愈的。而且这孩子，似乎原本身体状况就很不好的样子⋯⋯」</data></node>
    <node id="恋慕剥夺与代价体系"><data key="name">恋慕剥夺与代价体系</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">技能『？？？』将『恋』与『爱』判断为了攸关我性命的情感？</data></node>
    <node id="拉丝缇娅拉'太弱'自称与现人神威压的反差"><data key="name">拉丝缇娅拉'太弱'自称与现人神威压的反差</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">昨天陪基督在大圣堂见她的时候，她表示自己「太弱」。可如今这股威压感令我只觉得那都是戏言。；出现在我面前的『现人神』之眼力，令我口干舌燥、几欲立刻向她屈膝下跪。</data></node>
    <node id="阳滝死讯的真伪与最深部确认"><data key="name">阳滝死讯的真伪与最深部确认</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是妹妹相川阳滝。除此之外不做他想。只要是为了她，无论以什么为牺牲都无妨。；「但是，阳滝这不是不在吗⋯⋯！她不在这里！就是因为她不在我身边，我才会这么拼命不是吗，可恶⋯⋯！！」；那么难道相川阳滝在千年前就已经走完了人生旅程，不在人世了吗？</data></node>
    <node id="「不能遇上的家伙」"><data key="name">「不能遇上的家伙」</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「行了，这样一来问题就解决了。好了，我也得准备准备赶回劳拉维亚本国了。不抓紧点的话，那几个不能遇上的家伙就要找上门来了。」</data></node>
    <node id="第五十之试练的胜负与真正内容"><data key="name">第五十之试练的胜负与真正内容</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接下来要开始的就是『第五十之试练』；所谓『第五十之试练』，就是一个小孩子拽住了打算离开游乐园的朋友的衣角──仅此而已。；带着她一起走到外面的世界去。仅此而已。</data></node>
    <node id="她那声『我』与'他存在于此的证明'"><data key="name">她那声『我』与'他存在于此的证明'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她那声『我』是指谁呢？；而这也正是，他存在于此的证明──是海莉在逞强的证明──是帕林库洛才是正确的证明──但同时也是海莉以海莉的身份生存着的证明。</data></node>
    <node id="诺斯菲留恋真形『渴望犯错』与章末危机"><data key="name">诺斯菲留恋真形『渴望犯错』与章末危机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『光之理的盗窃者』的留恋终于浮上水面。；不知不觉间，『光之理的盗窃者』已经来到了触手可及的距离。</data></node>
    <node id="升级条件未明"><data key="name">升级条件未明</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">经验值：805/100</data></node>
    <node id="海莉『就在他之中』的残响与三人之约"><data key="name">海莉『就在他之中』的残响与三人之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「虽然我就要在这里退场了，不过还是会一直在身旁看着你的哦。──就在他之中」；「果然，你是⋯⋯」；「不能再说下去了哦，莱纳。请遵守我们的约定」</data></node>
    <node id="缇亚的异常（'无知是罪'自诫）"><data key="name">缇亚的异常（'无知是罪'自诫）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──但是，也不能一直这样无知下去。无知的代价总有一天会找上门来的，涡波你可要切实注意」；「没错，无知是罪，明知无知却不肯求知，则是更大的罪」；但我总觉得缇亚这番话并不是对我说的，而是在对她自己讲的。</data></node>
    <node id="天选之子演说"><data key="name">天选之子演说</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">没错，我们是天选之子。</data></node>
    <node id="艾德的'棋子集齐/我王'计划"><data key="name">艾德的'棋子集齐/我王'计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这样一来棋子就集齐了！而且还是不亚于千年前的阵容；毕竟所有的魔石都是为了我王而存在的</data></node>
    <node id="六十六层存档点困境（无法离开亦无法突破）"><data key="name">六十六层存档点困境（无法离开亦无法突破）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然敌人很强大，不过总有一天我能够战胜它。我知道这座迷宫就是为了让人变强而设计出来的。毕竟创造者就是我本人嘛。；我们完全被困在六十六层里了。所以，我一直都期待着涡波的苏醒来着⋯⋯；简直就像是RPG游戏里进了无法离开的迷宫还保存了进度一样。</data></node>
    <node id="罗德对风龙的『怀念』与永久滞留意愿"><data key="name">罗德对风龙的『怀念』与永久滞留意愿</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是『风龙艾尔芬里斯』酱哟～。嗯～，真让人怀念啊～；「姆呋呋。慢慢来不着急哟～。如果能永远留在这里就更好不过了呢」；罗德也确信了。</data></node>
    <node id="涡波=容器/无名存在"><data key="name">涡波=容器/无名存在</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「现在存在于此的涡波小哥你，严格来说并不是相川涡波。只是真正的『相川涡波』为了『再诞』制造出的容器罢了」；既然我不过是个没有名字的『魔石人类』，那我到底是为了谁，为了什么才活到现在的呢。；而且可悲的是，如果真的有什么东西救得了我的话，那恐怕是……——</data></node>
    <node id="诺文的青空记忆"><data key="name">诺文的青空记忆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我也是同感啊，莉帕。那个淤塞不堪的天空跟这比起来简直判若云泥。」</data></node>
    <node id="缇达'正因为是现在才分离'之谜"><data key="name">缇达'正因为是现在才分离'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不对，不是这样。正因为是这个时候，缇达才跟我分离了吗⋯⋯⋯正因为是现在，才终于⋯⋯」</data></node>
    <node id="五十层『召还』人影之谜（预期罗德→另有其人）"><data key="name">五十层『召还』人影之谜（预期罗德→另有其人）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「但是，基督。现在罗德那家伙在六十六层哪里。这种场合，守护者会怎么样呢。谁都不出来吗？」；暴风雨的中央──五十层的中心有人影出现了。；那是，守护者的阶层有人进来后的『召还』现象。</data></node>
    <node id="缇亚的秘密不满与努力沉水"><data key="name">缇亚的秘密不满与努力沉水</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">探求让每个人的获得幸福的方法，缇亚也是。为了找到而努力了。；那个西斯，就这样让缇亚的努力沉入水中，把缇亚的一直秘密下来的不满就这样暴露出来。</data></node>
    <node id="海莉的今日必死"><data key="name">海莉的今日必死</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">请你务必在我的身后见证这一切。──少年」；以生命为代价，海莉绽放出最后的光辉。</data></node>
    <node id="海莉的谜言行与隐瞒"><data key="name">海莉的谜言行与隐瞒</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「呵呵，你又·做·出·了土里土气的东西了呢。」；「一定……曾在梦中见过这一幕吧……」；不过，不知道为什么，总觉得她的微笑中带有一丝谎言的味道。</data></node>
    <node id="全员装备赠答的修罗场再演预告"><data key="name">全员装备赠答的修罗场再演预告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">照这个模样，恐怕到了送装备的时候，还要像今天这样累个人仰马翻吧。就算对我而言只是为了强化队伍的实力，但是对她们来说，这可是异性送的礼物啊。</data></node>
    <node id="露洁与诺瓦露的余生（魔石折损）"><data key="name">露洁与诺瓦露的余生（魔石折损）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「因为嘛～、要是露洁我们去战斗的话，体内的魔石会减少的呀～。还是说，莱纳君想让柔弱的我们早点死掉么？」；「你不用记住她们的样子也无所谓。反正都是不久于人世的人。这样对你来说更好」；「是从研究院那边把她们带出来的。海莉小姐说是『因为跟我一样』什么的，所以也没办法喽」</data></node>
    <node id="地上再会之约"><data key="name">地上再会之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「那么，涡波大人。我先行一步到地上等您。那一日的誓言铭记在心，我会一直等待您的到来。请您不要忘了即使偿清了对『北方』犯下的罪孽，在『南方』一样留有罪过有待您清偿。请您千万千万，不要忘了我。」；「那就好，那么有朝一日让我们再次相见吧⋯⋯⋯等到下一次，我定会掳获您的身与心。」</data></node>
    <node id="罗德咏唱暗语身世（白樱陨堕/家族失诅咒秽等）"><data key="name">罗德咏唱暗语身世（白樱陨堕/家族失诅咒秽等）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『白樱陨堕孤身尚奔驰无息』『绮梦丧空余躯尚奔驰无息』『孕逝亡且疾驱尚奔驰无息』『家族失诅咒秽尚奔驰无息』；『驰骋战场驱至坟茔疾走地狱──纵达奈落之底，孤之加速亦无羁止』；所以自己对成为了王这件事感到追悔莫及、作出上述主张的咏唱如怒涛般席卷于整个世界。</data></node>
    <node id="涡波致命伤预知（先谭轨道的下一幕）"><data key="name">涡波致命伤预知（先谭轨道的下一幕）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">落地死的流星；这就是说罗德终于彻底被激怒，而我也踏上了通往那个胜利的道路。；所以我早就知道。在这之后，我没能躲过这颗『流星』并受到重创──不、是负上了致命伤。</data></node>
    <node id="涡波超限魔法的魂与魔石磨耗"><data key="name">涡波超限魔法的魂与魔石磨耗</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我能感觉到诸多重要之物与吐出的鲜血一同丧失。何止是最大HP的减少，就连魂本身都未能幸免于难。不光是我的肉体，体内的魔石也惨遭磨耗。</data></node>
    <node id="沃克兄妹的某起事件"><data key="name">沃克兄妹的某起事件</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯——，他·们·以·前关系确实很好的，但现在就有点微妙了。不管是格连还是斯诺，都因为某起事件而变了不少……我觉得他们的关系一定无法恢复如初了吧……」</data></node>
    <node id="缇缇实力弱化之疑"><data key="name">缇缇实力弱化之疑</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不不，我觉得自那之后你的实力应该变弱了哦！还是别想着跟以前一样比较好！！」；「姆姆姆！才、才没有那回事的说！！」</data></node>
    <node id="『漂亮的石子』——孤真正的留恋/宝物（孩童时期）"><data key="name">『漂亮的石子』——孤真正的留恋/宝物（孩童时期）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是那•一•天，在那片草原上找到的『漂亮的石子』。；即使与那•一•天遗失的『漂亮的石子』相比也不逊色。；——已•经•再•也•没•有•机•会•入•手•了。</data></node>
    <node id="莉帕的创造者『次元之理的盗窃者』与假面之梦"><data key="name">莉帕的创造者『次元之理的盗窃者』与假面之梦</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">做了个奇怪的梦。内容天马行空，毫无现实性的梦。具体是什么内容现在虽然记不清了，但是我知道是场恶梦。；听到假面一词，我血气上涌。；就在昨天，虽然是在梦中，但是我感觉看到过类似的人物。</data></node>
    <node id="同艾德爆发战斗的可能性（ch224）"><data key="name">同艾德爆发战斗的可能性（ch224）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「虽然缇缇觉得只要见到艾德跟他谈一谈就能解决问题，但我仍然觉得有同他爆发战斗的可能。所以我想着应该会是一场充满危险的旅途吧」</data></node>
    <node id="60层守护者对峙（光之理的盗窃者）"><data key="name">60层守护者对峙（光之理的盗窃者）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这种亮度、光芒……恐怕在六十层的守护者应该就是『光之理的盗窃者』了吧？；我一个人进入六十层，先跟守护者交谈试试。；就这样，向着迷宫的六十层，向着『光之理的盗窃者』所在的阶层，我迈出了前进的脚步。</data></node>
    <node id="圣诞祭仪式"><data key="name">圣诞祭仪式</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">况且大小姐您应该也没有让那个仪式功亏一篑的打算，没错吧？</data></node>
    <node id="再诞计划'现在还剩──'之未竟话头"><data key="name">再诞计划'现在还剩──'之未竟话头</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「没错，正如你所说。这一年来，所有的准备基本都已告成，现在还剩──」；「接下来的话让我来讲怎样？」</data></node>
    <node id="66层天空的违和感"><data key="name">66层天空的违和感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">感觉整个天空在摇动。漆黑的天空看上去有些不自然，就像暴风雨来临前活动激烈的云层一样。</data></node>
    <node id="缇亚的弟弟"><data key="name">缇亚的弟弟</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我想要变得和弟弟一样。</data></node>
    <node id="守护者全员等待涡波论(义务论)"><data key="name">守护者全员等待涡波论(义务论)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">所有的守护者、都·在·等·待·涡·波！；即使如此吾等也在等待『来自异界的救主（相川涡波）』！！；「……所以你觉得我有义务留在『这里』？」</data></node>
    <node id="瓦尔德本土追讨(周回二度·圣诞祭翻盘)"><data key="name">瓦尔德本土追讨(周回二度·圣诞祭翻盘)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「大家，我们的目标是瓦尔德『本土』，追赶身在『本土』的帕林库洛。」；「不能放着帕林库洛不管。现在，他的身体中寄宿着守护者缇达的魔石，极其危险。」；圣诞祭的那天，我输给了帕林库洛。</data></node>
    <node id="海莉'一直保持现状'之言"><data key="name">海莉'一直保持现状'之言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「说不定的话，也有一直保持现状──这样幸运的未来啊」；毫无疑问，这句话不是海莉对自己，而是对我说的。；不过，不知道为什么，总觉得她的微笑中带有一丝谎言的味道。</data></node>
    <node id="斯诺接送与致歉延期"><data key="name">斯诺接送与致歉延期</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我得赶紧做好准备，然后分秒必争地去把斯诺接回来」；看来斯诺为了不让公会的大家担心而做了妥善的处理。真难以相信如此完美的斡旋居然出自她的手腕。</data></node>
    <node id="法芙纳・赫勒比勒夏因（最后的三骑士）"><data key="name">法芙纳・赫勒比勒夏因（最后的三骑士）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那唯一需要警惕的就只剩下法芙纳・赫勒比勒夏因而已了。除了他之外的人都不会一见到小子就袭击过来的」；一听这姓氏很明显就是莱纳的祖先大人。</data></node>
    <node id="莱纳知道'那一天'之谜"><data key="name">莱纳知道'那一天'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这三个人……？感觉莱纳像是知道那一天发生的事情的样子啊。好奇怪诶……」</data></node>
    <node id="缇亚的真正姿态"><data key="name">缇亚的真正姿态</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她那已经失去的右臂前方展开了未知的魔法阵，光像金砂一般喷涌而出。；正体不明的魔法阵不仅仅在右臂，也在右眼和背后展开。缇亚那美丽的苍目中的一只发着光，背后的魔力粒子也像翅膀一样喷出。；我觉得这才是缇亚的真正姿态──也是我『真正的敌人』</data></node>
    <node id="世界奉还阵失控·神话级大陆灾难"><data key="name">世界奉还阵失控·神话级大陆灾难</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">失去了魔石的帕林库洛身体开始溶解。跟海莉和士兵们一样，他的肉体被转化为白色的魔力粒子。即使这样帕林库洛也没有摆出打算停止『世界奉还阵』的样子。看来他那自己也停止不了的说辞并不是谎言。；明明我已经连行走都很困难了，但『世界奉还阵』还在变本加厉地扭曲着大陆。；尽管附近的怪物们已经被我和莱纳一起排除了，但是远处仍然传来了凶暴的大型怪物的吼声。</data></node>
    <node id="阳滝『复活』非假货的确信"><data key="name">阳滝『复活』非假货的确信</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">尽管那只是帕林库洛的策略之一，但是作为我人生最终目标的妹妹，她确实在那里出现了。；那是自灵魂层面传来的直觉，我敢确信她绝对不是假货。</data></node>
    <node id="遗忘的誓言（车轮续转）"><data key="name">遗忘的誓言（车轮续转）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">舞台转换至劳拉维亚，忘记了自己的愿望，被囚禁在『试练』的牢笼中——继续着。</data></node>
    <node id="涡波留了一手(最信赖的后手)"><data key="name">涡波留了一手(最信赖的后手)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「设置在『史诗探索者』的『Connection』早就被解除了，不行的。……但是没关系，我也留了一手。」</data></node>
    <node id="罗德的'这・样・就・好・办・了'"><data key="name">罗德的'这・样・就・好・办・了'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，诺斯菲也在⋯⋯这・样・就・好・办・了，也是呢⋯⋯」</data></node>
    <node id="佩艾希亚结界外膜被轰碎（崩壊进程冲击）"><data key="name">佩艾希亚结界外膜被轰碎（崩壊进程冲击）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">被强行制造出的风穴旋即导致了周围空间的龟裂。空间的绽裂开始逐渐蔓延，让天空逐渐剥落塌陷。始祖打造出的结界的外膜，就像鸡蛋壳一样被轰碎了。</data></node>
    <node id="'真正的涡波'与'被那家伙所憧憬的英雄'指涉"><data key="name">'真正的涡波'与'被那家伙所憧憬的英雄'指涉</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「事到如今我终于明白了⋯⋯！我跟你们不一样！我不光是要战斗，我更想赢啊！我想要超越涡波！我想要和真正的涡波战斗，然后超越他！是啊，就是这样！我想要展现出自己不逊于被那家伙所憧憬的英雄的一面啊！这就是我的愿望！对帕林库洛来说，战斗不是游戏！我一直都是为了胜过涡波才战斗的啊！！」</data></node>
    <node id="诺文的最后牵挂(留恋复数)"><data key="name">诺文的最后牵挂(留恋复数)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">诺文的『留恋』是复数。；即便如此，诺文还是想要就此消失。</data></node>
    <node id="西斯的『使徒只剩一个』计划（封印勒伽西）"><data key="name">西斯的『使徒只剩一个』计划（封印勒伽西）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这样就完美了，使徒就只剩我一个。；既是『使徒』又是『人类』的我就可以去挑战了。事到如今，已经不再需要替角。」</data></node>
    <node id="缇缇的『诅咒』（时间停滞·不得死）"><data key="name">缇缇的『诅咒』（时间停滞·不得死）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">一个本来只是家家酒游戏中的王最终成为真正的王者的战斗就此开幕，而少女缇缇的时间则因为『诅咒』而停滞不前。；在这之后，一个虚伪的王让一个陷入绝境的国家死灰复燃。接着，从家家酒游戏中脱胎而成的小孩子在数十年的时间里作为王者君临于佩艾希亚，其恶果便是北方的崩壊。最后『支配之王（Lord）』被南方的诺斯菲所杀。但是因为『理的盗窃者』的诅咒，就连死都成了奢望，只能堕入地底不得不再做整整一千年的王──而魂也由此濒于死壊。</data></node>
    <node id="千年前悲剧的真相（决裂·背叛·涡波之死）"><data key="name">千年前悲剧的真相（决裂·背叛·涡波之死）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">恐怕在旅途的最后，等待着假面男子的、是绝望吧。；与使徒西斯决裂，变成了互相攻杀的死敌。；为圣人缇娅拉所背叛，没有了可以信赖的同伴。</data></node>
    <node id="斯诺的变心与'那样一条路'"><data key="name">斯诺的变心与'那样一条路'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——恐怕斯诺根本没有放弃跟我结婚这件事。</data></node>
    <node id="缇亚的梦呓与青目发光"><data key="name">缇亚的梦呓与青目发光</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「『人家』──不对，不是这样的。对不起，基督──」；缇亚不停地呼唤着我的名字，反复道歉。；总感觉她那青色的双目正发着光。</data></node>
    <node id="拉丝缇娅拉的一年挫败创伤"><data key="name">拉丝缇娅拉的一年挫败创伤</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这反而让我想仔细打听一下她在我们不在的一年里到底遭遇了怎样的挫败。</data></node>
    <node id="弗茨亚茨旧掌权者传说"><data key="name">弗茨亚茨旧掌权者传说</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在过去，大国弗茨亚茨的掌权者是个虽然蠢到无以复加，但又十分有意思的人物。</data></node>
    <node id="RokhBringer的制造者之谜"><data key="name">RokhBringer的制造者之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在迷宫里找到的诸多物品中，尤属这把剑的能力最为凶险。当时我身边要是没有斯诺的话，就中了这家伙的精神污染了。；这把剑的做工相当不错啊。不过，制造者到底是谁呢？不用『神铁』的技术就能够达到这种水平的话，我应该认识的才对啊……</data></node>
    <node id="莱纳的毙杀预案与二人胜法谋划"><data key="name">莱纳的毙杀预案与二人胜法谋划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我可能需要将拉丝缇娅拉拘束起来，并将圣人缇娅拉毙杀；──决・定・已・经・做・好・了。；在这个冰冷的地下室里。</data></node>
    <node id="『世界奉还阵』原本用途之谜"><data key="name">『世界奉还阵』原本用途之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「毕竟『世界奉还阵』跟『迷宫』是同一系统的术式，进行这种程度的『想起收束』简直轻而易举。不如说这才是『世界奉还阵』原本的用途才对」；不管他怎么解释，我也没法看透这个术式的细节。</data></node>
    <node id="缇娅拉的千年誓言与圣人结局"><data key="name">缇娅拉的千年誓言与圣人结局</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「等着我！我一定会去往师父的身边，不管你在哪里，一定会！这既不是契约也不是之外的任何东西，我要以我的意志，用我的力量，与师父的灵魂相伴！我发誓！！」；「我绝对不会让师父孤身一人的……绝对不会……！就像师父将救赎带给孤独的我一样，我也要拯救你……！不管这要经过多少年，哪怕是几千年我都会去你身边……！！」；如拉丝缇娅拉所说，可以预料到，接下来『圣人』一行人将要战胜『怪物』了吧。</data></node>
    <node id="贝丝曲奇的味觉记忆"><data key="name">贝丝曲奇的味觉记忆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这味道实在太令人怀念，只・能・认・为・这・点・心・的・做・法・是・我・教・她・的。</data></node>
    <node id="涡波与帕林库洛的记忆对质（未竟）"><data key="name">涡波与帕林库洛的记忆对质（未竟）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">自从我为了自己记忆的事质问他以来就不曾再见了。；这次我心中依旧有与他对峙的欲望。</data></node>
    <node id="诺斯菲『留恋毫发无损·不会消失』宣言与浓度更高说"><data key="name">诺斯菲『留恋毫发无损·不会消失』宣言与浓度更高说</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">既然没有任何关系，那我又怎么会消失呢。不如说，如果被关在地底待上一万年的话，反而会让我的身体的浓度更高才对；这与我的留恋毫无瓜葛，我的留恋将是毫发无损！更不可能消失！</data></node>
    <node id="千年魔导书作者之谜——异邦人关联与'相近感性'"><data key="name">千年魔导书作者之谜——异邦人关联与'相近感性'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我于是去确认了作者的名讳，但上面并没有我的名字。然而，可以确信作者拥有与我相近的感性。；从其中有只言词组暗示平行世界和异世界的存在这一点来看，可以推定这本书的执笔过程与我这样的异邦人脱不了干系。</data></node>
    <node id="拉丝缇娅拉的独立救援宣言"><data key="name">拉丝缇娅拉的独立救援宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「多亏了基督，我成为了我自己……这让我很开心哦……所以这一次，不由其他任何人，我一定会亲自将你救出来……」；「嘛，这个先不说，今天的事你可给我记好了哦。等一切结束之后，缇亚的任性你不听上个一百遍可不算完。而且我也是、相~当~地生气呢……那么今天就先到这里啦，拜~拜~。」</data></node>
    <node id="世界奉还阵决战（英雄vs帕林库洛）"><data key="name">世界奉还阵决战（英雄vs帕林库洛）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「『英雄』即将到来……为了打倒『怪物』……」；「为了与我战斗，你会来到这个魔法阵——『世界奉还阵』之中……」；继续这样下去的话，就能在当初定好的地点展开决战了吧。</data></node>
    <node id="混乱10.00门槛"><data key="name">混乱10.00门槛</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">数值达到十位数或许会满足什么条件，我总有这种预感。</data></node>
    <node id="西娅之'血'与涡波心痛"><data key="name">西娅之'血'与涡波心痛</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">理解到这点的同时，我的胸口像被揪住一样疼痛。；她的名字──不，她身上的『血』就足以牵动我的心脏。</data></node>
    <node id="格连·沃克其人"><data key="name">格连·沃克其人</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我只能用可怜来形容他就是了。</data></node>
    <node id="魔王城其他房间禁区（罗德叮嘱）"><data key="name">魔王城其他房间禁区（罗德叮嘱）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──但是，可能的话希望你不要进入其他的房间哦─」</data></node>
    <node id="拉丝缇娅拉行踪"><data key="name">拉丝缇娅拉行踪</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在她留下的信里，写下了她要与你这厮、你这厮、私、私、私私奔——。</data></node>
    <node id="帕林库洛的精神魔法战术预告"><data key="name">帕林库洛的精神魔法战术预告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──所以说，帕林库洛他是绝对不会堂堂正正地战斗的哦。他绝对不会让涡波以万全的状态战斗的，绝对会玩弄什么手段对你释放精神魔法的。肯定没错」；「需要注意的也就是缇达的魔法了。但是他的魔法我已经见识过了，只要不被黑色液体附着在身上就没问题」</data></node>
    <node id="'魔王城'之名与'支配着魔人们的王'"><data key="name">'魔王城'之名与'支配着魔人们的王'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哦，这是还是涡涡命名的呦。因为是支配着魔人们的王，因此称之为魔王城这样说来着。」；「就是这样。但是，已经有几百年没有去管50层了耶。」</data></node>
    <node id="明晨全员集合·异世界出身与技能全公开"><data key="name">明晨全员集合·异世界出身与技能全公开</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">明天早上，我打算把大家集合起来一起讲，所以你看到大家之后记得通知一声；但是，结果顺序搞反，我已经知晓了拉丝缇娅拉的秘密了。因此必须要尽快实现那个约定才行。</data></node>
    <node id="法芙纳未登场（三骑士最后一人）"><data key="name">法芙纳未登场（三骑士最后一人）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「在三骑士当中还没有出现的就只剩法芙纳了呢。⋯⋯说来惭愧，关于法芙纳的事，人家也不是很清楚。因为那家伙一直到最后都在极力避免跟人家一对一啊。人家知道的就只有他是『血之理的盗窃者』这一点罢了。</data></node>
    <node id="西娅队伍急赴帕林库洛"><data key="name">西娅队伍急赴帕林库洛</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——那么我们赶紧去帕林库洛·勒伽西那边吧。不赶紧一点的话就赶不上了——」；「关于海莉的身世，还有兄长大人的问题，我有话要问他。根据回答，我可能会跟帕林库洛一战。」</data></node>
    <node id="骑士再派循环"><data key="name">骑士再派循环</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「既然如此，那下次会派其他的骑士过来的！</data></node>
    <node id="基督和玛利亚夺还作战"><data key="name">基督和玛利亚夺还作战</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">为了能再一次握住基督和玛利亚的手——</data></node>
    <node id="全员告白审视计划（莱纳反推）"><data key="name">全员告白审视计划（莱纳反推）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她会促使自己认识的所有女孩子全都先于自己同涡波告白。；进一步地，就连在千年前与基督有瓜葛的少女们也一个不留──；将自己主张的『世・界・上・独・一・无・二・的・命・运・之・人』予以证实才行了。</data></node>
    <node id="拉丝缇娅拉的死期"><data key="name">拉丝缇娅拉的死期</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">待到圣诞祭结束的时候，她会从这个世上消失的。</data></node>
    <node id="理的盗窃者的代价（丧失之物未言明）"><data key="name">理的盗窃者的代价（丧失之物未言明）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">何其不幸，自己没能在『这里』死去，结果成为了『理的盗窃者』，并且作为『代价』还丧失了无比重要之物。；明明并不想忘却，可随着岁月的流逝终于还是忘掉了⋯⋯明明是那样拼命地探寻，可到头来自己就只是在离真正的『乐园』越来越远罢了⋯⋯</data></node>
    <node id="莱纳达到『理的盗窃者』领域的可能性"><data key="name">莱纳达到『理的盗窃者』领域的可能性</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「赫勒比勒夏因的末裔、莱纳・赫勒比勒夏因⋯⋯⋯你具有凭借不正当（正确）的手续达到与我们相同领域的可能性呢。若论及精神力的话，你毫无疑问凌驾于所有『理的盗窃者』之上。不过这也是没办法的，毕竟被选作『理的盗窃者』的条件就是具备满是空隙的心灵呀」</data></node>
    <node id="罗德的扭曲与关键时刻妨碍预测"><data key="name">罗德的扭曲与关键时刻妨碍预测</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我觉得罗德在关键的时候一定会来妨碍我们。大概守护者这一存在基本都是这样的。罗德她、毫无疑问在某种地方是扭曲的──我想要极力回避这一点」；听到莱纳的质问后，罗德的表情产生了一些异样。尽管只有一刹那的停顿，但罗德确实动摇了。；罗德露出了带有一丝怀念的微笑，转身前往魔王城的方向。</data></node>
    <node id="灵魂代价的怀旧感"><data key="name">灵魂代价的怀旧感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">好像有不知道某处的什么人，也偿付过同样的『代价』那样，有一种莫名其妙的感觉……</data></node>
    <node id="『维度・千算相杀』的封魔极限"><data key="name">『维度・千算相杀』的封魔极限</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然现在还只能化解基础魔法，但『维度・千算相杀』的成长潜力还很大。；将来有一天如果能不仅局限于对手发动魔法的瞬间，甚至可以直接捩转对手魔力的属性的话，那么在理论上对手就无法使用魔法了。</data></node>
    <node id="诺文的急速弱化"><data key="name">诺文的急速弱化</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">恐怕到了一个不小心就会让他从这个世界上消失的地步。</data></node>
    <node id="只要涡波留下就能修好（罗德的挽留逻辑与修复能力暗示）"><data key="name">只要涡波留下就能修好（罗德的挽留逻辑与修复能力暗示）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「反正只要涡波留下的话就能修好！」；孤必将否定那一切，之后重新将你纳入麾下！</data></node>
    <node id="决赛=计划第一步(真正的战斗)"><data key="name">决赛=计划第一步(真正的战斗)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这样我就打入了决赛。这就是计划的第一步。；将这份誓言揣在胸中——我真正的战斗开始了。</data></node>
    <node id="帕林库洛的必至预言"><data key="name">帕林库洛的必至预言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——我觉得你到时候还是会出手的。」</data></node>
    <node id="40层守护者封存方针"><data key="name">40层守护者封存方针</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「首先目标定为39层。总方针是在与帕林库洛做出了断之前，不要唤醒40层的守护者！」；「要是我一不小心进入40层的话可就不好意思了呢，涡波！」；只要把『连接』全部解除的话，就算是守护者也追不到这艘船上来</data></node>
    <node id="缇达魔石回收中断"><data key="name">缇达魔石回收中断</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">根本不可能再去找什么缇达的魔石了</data></node>
    <node id="失去意识前的'什么人的声音'"><data key="name">失去意识前的'什么人的声音'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最后总觉得听到了什么人的声音。；但是，没能理解到是谁的声音，我便彻底失去了意识──</data></node>
    <node id="锻冶升级瓶颈与通缉枷锁"><data key="name">锻冶升级瓶颈与通缉枷锁</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">从今往后会长还会带来更多稀少的魔石，总有一天我的水平会处理不了的哦？；「但是，我在联合国，基本都是通缉状态⋯⋯⋯去了显眼的地方，被沃克家之类的发现的话会很麻烦的⋯⋯」；「呼─唔，真是辛苦啊⋯⋯⋯就算想去也没法去吗⋯⋯」</data></node>
    <node id="涡波对贝丝的记忆缺失"><data key="name">涡波对贝丝的记忆缺失</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不过，有关她的记忆我是真的一点儿也想不起来。所以实在不明白她为什么会这么害羞。</data></node>
    <node id="魔剑BraveFluorite真相隐瞒"><data key="name">魔剑BraveFluorite真相隐瞒</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如此这般，「始祖和魔王的魔剑BraveFluorite」就算完成了。不过，我还不是会把这把剑是魔剑的事实告诉缇缇的恶鬼，所以就由衷的表示祝福。；姑且不提名字如何，这性能真了不得。还擅自附有当事人都不知情的奇妙加护。</data></node>
    <node id="同格实力与对决前的不安（魔石同化者玛利亚/帕林库洛）"><data key="name">同格实力与对决前的不安（魔石同化者玛利亚/帕林库洛）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那么与魔石同化的玛利亚和帕林库洛，应该也具有同级别的力量。；接下来将与之一决雌雄的敌人，以及将力量借给自己的同伴。；她们那深不可测的实力，让我的身体战栗不已。</data></node>
    <node id="归还原来世界"><data key="name">归还原来世界</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的首要目的是『归还』。</data></node>
    <node id="海莉的生之决意与去向"><data key="name">海莉的生之决意与去向</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我终于，明白自己该怎样去活了」；那是不再执着于死，而向往生的决意。；「如果有少年和使徒大人那样拥有能够证明自我的无比重要之物的话，我就能证明自己的存在了吗⋯⋯⋯只要我也能找到重要之物的话⋯⋯」</data></node>
    <node id="伊丽莎白・沃尔斯对涡波之战（章末钩）"><data key="name">伊丽莎白・沃尔斯对涡波之战（章末钩）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「啊啊，如果是伊丽莎白・沃尔斯殿下的话，就算是以团长大人为对手肯定也能有办法解决的！」；「就算是外貌改变了，您的脚步声也还是没变呢。团长大人」；她完全超越了她的祖父雷纳尔多。</data></node>
    <node id="缇缇的勇者之志"><data key="name">缇缇的勇者之志</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哼哼哼，人家正以勇者为目标精进中！所以正想要这种装备呢！」；「嚯，品味相当不错嘛。那可是我倾尽心血打造的英雄风格的造型啊」</data></node>
    <node id="莉帕的愿望实现宣言"><data key="name">莉帕的愿望实现宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——我·的·愿·望·也·能·实·现。」；「诺文放着不管也没问题。反正他也无法行动。」</data></node>
    <node id="消除技能『？？？』后还拉丝缇娅拉人情的誓约"><data key="name">消除技能『？？？』后还拉丝缇娅拉人情的誓约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我只能默默地接受拉丝缇娅拉的一番好意。并在心中发誓，等到消除了技能『？？？』之后，将来一定要还这个人情。</data></node>
    <node id="涡波肉体不老可能性（未证）"><data key="name">涡波肉体不老可能性（未证）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">另外，虽然还得不到证明，但肉体不老的可能性也──；我的身体跟俗话说的『怪物』应该很相近了吧。不过，我并不会畏惧这些变化。既然来到了异世界，我的身体会变得远离人类的范畴也早在预料之中。就算变成了『怪物』我仍然是我。这份誓言不会有变。</data></node>
    <node id="亿分之一胜利道路之脆弱性"><data key="name">亿分之一胜利道路之脆弱性</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那是不到亿分之一的微小的可能性。；不过只是一条只容许蹑足前行，而且满是绊脚石，一旦跌倒便会崩溃的脆弱道路罢了。</data></node>
    <node id="诺文的真正愿望(排除法一步)"><data key="name">诺文的真正愿望(排除法一步)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接下来只要用排除法去思考，我就能摸清自己『真正的愿望』了吧。；我不得不承认，它岂止不能带来幸福，甚至近乎于一种『诅咒』。</data></node>
    <node id="圣诞祭活祭执行"><data key="name">圣诞祭活祭执行</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉·弗茨亚茨乃是圣诞祭的『活祭』。</data></node>
    <node id="莱纳的下落(被沃尔斯带走)"><data key="name">莱纳的下落(被沃尔斯带走)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——嗯？好奇怪啊。莱纳这是跑到哪里去了呢。我确实是将他送到这里来了，怎么看不到人……」；「皆因雷纳尔多·沃尔斯所致……其人察觉并参与到发生于此处的战斗后，将莱纳带走了……」；当然，我还要把莱纳也带上。</data></node>
    <node id="涡波=『再诞』用魔石人类推测（始祖之器）"><data key="name">涡波=『再诞』用魔石人类推测（始祖之器）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『相川涡波』为了『再诞』而准备的『魔石人类』吧。所以，少年是绝对没办法跨越的。」；「你不是『相川涡波』。只是持有这个名字的『少年』而已。也许是和大小姐一样─────不，比那更年幼，仅数周前在迷宫诞生的『魔石人类』」；「事先准备好的记忆的可能性很高。为了不让『相川涡波』感到不可思议而『调整』了吧。千年的始祖的话，实现应该是不难的。」</data></node>
    <node id="佩艾希亚崩坏倒计时与罗德陪葬危机"><data key="name">佩艾希亚崩坏倒计时与罗德陪葬危机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">非也，很快就要结束了。在我看来，那个空间的寿命也就只剩一个月了。；罗德不愿意接受『这里』即将崩坏的事实。如果继续这样下去的话，她可能会成为『这里』的陪葬。；实话跟您说，我有一种不祥的预感……不知怎么，就是觉得不加快动作不行……</data></node>
    <node id="诺斯菲的一万年后终幕计划"><data key="name">诺斯菲的一万年后终幕计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的正式出场要留到一万年之后的终幕。；这一次我必须要好好品味（画上）『餐后甜点（句号）』才可以；如果在这里战胜我的话，那么诺斯菲可能会因留恋实现而消失。</data></node>
    <node id="缇亚的消亡危机与玛利亚的处决之约"><data key="name">缇亚的消亡危机与玛利亚的处决之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「如果『缇亚』完全消失了的话⋯⋯到那个时候，玛利亚、你要将我给⋯⋯」；「不是啊，涡波⋯⋯⋯这是、这是更早之前就已经开始的东西⋯⋯⋯所以说，已经迟了啊──」</data></node>
    <node id="『西斯』与『涡波』的名字契约：终将再会之理"><data key="name">『西斯』与『涡波』的名字契约：终将再会之理</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「纵使你不欲与我相会，我等重逢亦是必然。自盟友向『迪亚波罗・西斯』报上『涡波』之名时起，此间一切已是注定。此即『西斯』与『涡波』订下契约使然。因此，哪怕肉体早已腐朽作灰，则无论既经几世，魂与魂也必将再度联结。不管此间有何等变故，我们终将再会──不可动摇、不可改篡，此乃世界之『理』也」；那时候的我，握住了她的手。正如西斯方才所言，这是『再一次』了。我明白这是在重复一样的事。</data></node>
    <node id="帕林库洛的精神暗示与涡波抵抗力"><data key="name">帕林库洛的精神暗示与涡波抵抗力</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我动摇了，与此同时我感觉到有『什么东西』涌入了自己体内。；「……果然没法接受吗。还是老样子，涡波的抵·抗·力真强啊……」</data></node>
    <node id="罗德留恋·『这里』永续幸福与尽头无物（涡波共感）"><data key="name">罗德留恋·『这里』永续幸福与尽头无物（涡波共感）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然不知为何，但我渐渐能体会到罗德的心情了。；如果留在隔绝于世的『这里』，那这份幸福应该能永远持续下去吧。这点毋庸置疑。；纵使罗德不希望我那样做。</data></node>
    <node id="阿尔缇记忆中的次元魔法使"><data key="name">阿尔缇记忆中的次元魔法使</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为就跟我以前认识的一个人一模一样嘛。</data></node>
    <node id="涡波'变弱'与'没有记忆'的关联"><data key="name">涡波'变弱'与'没有记忆'的关联</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，阿哩⋯⋯？涡涡，怎么好像稍微变弱了一点？」；确实，与『始祖涡波』或『持有阳滝魔石的我』相比确实弱了不少。；「嗯～，对于没有记忆来说也是理所当然的事吗。」</data></node>
    <node id="再诞完成倒计时（涡波回来之前）"><data key="name">再诞完成倒计时（涡波回来之前）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">赶快趁基督不在的期间把所有的事情都办完；如果快的话只要几天时间，缇娅拉大人应该就能回到这个世界了</data></node>
    <node id="涡波与拉丝缇娅拉的战力定位危机"><data key="name">涡波与拉丝缇娅拉的战力定位危机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就在刚才，还想着要用剑保护她们两个，实际上完全没那个必要，让我受到不小的冲击。；过于完美，以至于都不需要我的索敌和拉丝缇娅拉的攻击力了。</data></node>
    <node id="拉古涅的诺文回避与『想要的东西』截断"><data key="name">拉古涅的诺文回避与『想要的东西』截断</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她一聊起诺文的事，我又从她身上感受到了和『舞闘大会』结束时一样的恶寒。；「说到底，剑就是剑。比起那个，现在我想要的东西是──啊」；那时候我产生了一股极其诡异的预感</data></node>
    <node id="联合国=二十层宣言"><data key="name">联合国=二十层宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">从·现·在·起，这·整·个·联·合·国·就·是·二·十·层。暗之理的盗窃者缇达的阶层。</data></node>
    <node id="露洁章鱼型魔人化的既视感"><data key="name">露洁章鱼型魔人化的既视感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">红色的软件动物⋯⋯？总觉得在哪里见过⋯⋯；接着，她的右臂变得和软件动物的触手一样，她用变化后的右手抓住身后的所有同伴，接着大幅拉开了与我们之间的距离。恐怕那也是『魔人返还』的力量吧。</data></node>
    <node id="缇亚的性别之谜"><data key="name">缇亚的性别之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我不禁推测缇亚其实是个女孩子。</data></node>
    <node id="贝丝体内『还残留着』的东西与千年记忆"><data key="name">贝丝体内『还残留着』的东西与千年记忆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">可能是雷纳尔多口中所谓『还残留着』的东西使然吧。；贝丝酱的表情整个僵住了。她含英咀华般将我的话再三重复。；想到与我的接触越多，越会让她遭受千年前的记忆的折磨，我便不由地与她拉开距离。</data></node>
    <node id="拉丝缇娅拉拒绝的违和（怒意急促·疑另有理由）"><data key="name">拉丝缇娅拉拒绝的违和（怒意急促·疑另有理由）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不，事到如今再深入地去思考的话，我认为她当时拒绝我是有什么别的理由⋯⋯拉丝缇娅拉那个时候对我感到了愤怒。我总觉得她的怒意并非源于我的轻率。如果能够理清这其中的原因的话，就可以再去──」；现在冷静地去回想的话，我总觉得拉丝缇娅拉当时的反应有些违和。在听到我的告白时，拉丝缇娅拉脸上的确有些喜色。我诉诸于她的好意在她看来并不是那么反感。可是，就在下一刻她却感到了愤怒。；没错──她心生怒意的时机显得有些急促。</data></node>
    <node id="拉丝缇娅拉的'经验与直觉'"><data key="name">拉丝缇娅拉的'经验与直觉'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──听到刚才的对话，真的让我体会到涡波你回来了啊。嗯，你终于回来了⋯⋯──而且果然、刚一回来你就到这里了呢⋯⋯」；「嗯～。准确的场所虽然不知道，但我还是能确信你一定活在某个地方。毕竟是涡波嘛」；「这个实在是没办法解释的有理有据啊。只能说是出于我的经验和直觉吧？」</data></node>
    <node id="我的妹妹不在这个异世界"><data key="name">我的妹妹不在这个异世界</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——啊啊，这样一来，大家『幸福』的时间就结束了啊。</data></node>
    <node id="沃尔斯灵魂解放·国民观众化执行"><data key="name">沃尔斯灵魂解放·国民观众化执行</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「啊啊，可怜的罗德。既然这样，就让我来消除你的后顾之忧好了。」；需要在『这里』继续保有意识的只有『你』和『我』、再加上『臣子』和『弟弟』，这四人就足够了。至于其他人就让他们彻底成为观众吧。；还是让沃尔斯将军的灵魂获得解放吧。</data></node>
    <node id="'像那个时候一样'——涡波曾救罗德的过去"><data key="name">'像那个时候一样'——涡波曾救罗德的过去</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「再・一・次，像那个时候一样，涡波要来救人家⋯⋯？」</data></node>
    <node id="涡波的咒术记忆缺失（专家技艺领域空白）"><data key="name">涡波的咒术记忆缺失（专家技艺领域空白）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「要说这方面的话，那涡涡可是有关『代价』领域的专家──准确来说是『咒术』的专家吧⋯⋯，你还有印象吗？」；「没了，『咒术』之类的我根本不会用。就连知识都不知道多少」</data></node>
    <node id="光之咏唱的危险（原因未言明）"><data key="name">光之咏唱的危险（原因未言明）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为再继续使用光之『咏唱』的话就危险了。</data></node>
    <node id="诺斯菲『说任性的话』留恋自白的可信度"><data key="name">诺斯菲『说任性的话』留恋自白的可信度</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但这仍然不能让我毫无保留地去相信她。要问为何，那是因为最初从她身上感受到的可疑氛围现在膨胀了好几倍。；「你真的仅・仅・只・要将任性的话说出口就够了吗⋯⋯？」；在我看来诺斯菲那家伙说的话全都可疑得不得了。说得直接一点吧，你难道不觉得她说的全是假话吗？</data></node>
    <node id="涡波的记忆片断与身上魔法的解除"><data key="name">涡波的记忆片断与身上魔法的解除</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">是跟次元魔法不同的『什么东西』在逐渐被化解。这种感觉就像是围巾的一端被人拉着从脖子上取下来一样。；——『漆黑的天空』——高耸宏伟的城堡——数不清的人痛苦地喘息着——守护着人们的戴着假面的男子与少女——同从未见过的怪物们之间的战斗——看着都觉得毛骨悚然的怪物大军——几乎要贯穿天际的走动的巨树——覆盖大陆的黑云化作巨人，播撒着绝望与灾厄——最后两人抵达了——抵达了将接触到的一切全部冻结的『怪物』身下——在即将来到『怪物』面前之时——两个人——</data></node>
    <node id="燃烧之家的对决"><data key="name">燃烧之家的对决</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「把主人、还给、我……还、给……」</data></node>
    <node id="艾德之约：『现在』与『这里』的守护誓约"><data key="name">艾德之约：『现在』与『这里』的守护誓约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">唉、真拿你没办法！既然你这么担心，那孤就同你许下『约定』好了！作为给你的奖赏，这『支配之王』同你许下『约定』！在此发誓，你的『宝物』──『世界和平』就由孤来守护！啊啊，让我们永远在一起吧，艾德！；不对！她没有死！『支配之王（Lord）』是不会死的！因为她跟我约好了啊！约好了要给我奖赏的！那个『支配之王（Lord）』是绝对不可能在约定实现之前死掉的！！</data></node>
    <node id="『堕落使徒』的制造者之谜"><data key="name">『堕落使徒』的制造者之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这把剑的做工相当不错啊。不过，制造者到底是呢？不用『神铁』的技术就能够达到这种级别的话，老朽应该认识的才对啊⋯⋯」；千年前毕竟还是个很广的范畴，没准是雷纳尔多死后诞生的剑吧。</data></node>
    <node id="技能『???』隐患存续"><data key="name">技能『???』隐患存续</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">只不过，『封印』虽然消失，但『混乱』还留着，应该认为技能『???』的隐患还在。</data></node>
    <node id="涡波『想被帕林库洛所救』的内心看破"><data key="name">涡波『想被帕林库洛所救』的内心看破</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">当我即将要透露出自己追帕林库洛一直到这里的目的时──却被玛利亚给打断了。；不对，是・你・想被帕林库洛・勒伽西所救、对吗？；「那么你为什么还在这里磨磨蹭蹭的！你到底在等什么！？难道你真的就像他说的那样在玩不成！？」</data></node>
    <node id="阿尔缇的愿望"><data key="name">阿尔缇的愿望</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如果可能的话，我希望你们能照着这个势头将阿尔缇的——啊啊，就是说刚才那个驱使火焰的女孩子。</data></node>
    <node id="希达尔克家的传唤"><data key="name">希达尔克家的传唤</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「……涡波，我接到了希达尔克家的传唤。似乎明天一整天都要被拘束在那儿的样子。」</data></node>
    <node id="帕林库洛体内的『一只眼』发声"><data key="name">帕林库洛体内的『一只眼』发声</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">对面也捕捉到了我的身影。留在帕林库洛体内的一只眼发现了隐藏起来的我。；「好了，勒伽西。少年已经十分接近『涡波』了哦。并且我也足够接近于『使徒』了。还差一点。就差一点了──」</data></node>
    <node id="海因的记忆走马灯"><data key="name">海因的记忆走马灯</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那既是海因与我们接下来将前去营救的少女一同度过的岁月的记忆，也是讲述那悔恨到足以逼迫他诅咒世界的理由的记忆。</data></node>
    <node id="魔石味道规则的设定者之谜"><data key="name">魔石味道规则的设定者之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">根据身体的相性会有不同的味道这还真是个有趣的现象。设定了这个规则的人是始祖涡波吗，还是圣人缇娅拉呢，又或者是其他人，我稍稍有些在意。不过现在想这些也没有答案，所以还是先加快脚步吧。</data></node>
    <node id="涡波=系统与迷宫规则制定者（失忆前身份线推进）"><data key="name">涡波=系统与迷宫规则制定者（失忆前身份线推进）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在『世界奉还阵』中看到过去的记忆之后，我已经明白打造出这个系统的人就是我自己了。；一边感谢着做出怪物不能跨层行动的规则的自己，我们一边在六十四层整理呼吸。</data></node>
    <node id="涡波'战后无论如何都无所谓'的空洞（莉帕察觉）"><data key="name">涡波'战后无论如何都无所谓'的空洞（莉帕察觉）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不管我是人类也好，是『怪物』也好，是『魔石人类』也罢，还是『相川涡波』都无妨。而阳滝是我的妹妹亦或不是，也无所谓。；只有莉帕感觉到了我的这种想法，她邹起了眉。</data></node>
    <node id="做梦回忆机制的丧失"><data key="name">做梦回忆机制的丧失</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">⋯⋯令人可惜的是，这一次我并没有再做梦。；无比珍贵的可以让我回忆过去的机会就这样再也不复返了。；总觉得这会导致莫大的后悔，让我十分不安。</data></node>
    <node id="再诞技术真相（海因复活成败争讼）"><data key="name">再诞技术真相（海因复活成败争讼）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「虽然确实混进了杂质，但是，那毫无疑问是海因·赫勒比勒夏因本人。我成功实现了海因的复活。而且这次我有自信做得更完美」；「不对！你就是海因·赫勒比勒夏因！不光有记忆，连性格也一样！虽然因为少年的原因，让你的性别产生了变化，但是那个笨蛋的精神确确实实地在你之中！我已经证明了只要有『血』的话就可以绕过『魂』这一点了！！」；名为海因的男人并没有复活！现在存在于此的是『再诞』失败的劣质品，海莉·维斯普洛佩！</data></node>
    <node id="玛利亚的燃烧记忆"><data key="name">玛利亚的燃烧记忆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">纵使『眼睛』告诉我，这样做会使所爱之人像■■一样化作灰烬消逝，</data></node>
    <node id="罗德『咏唱』的真正意义与埋藏心底之物"><data key="name">罗德『咏唱』的真正意义与埋藏心底之物</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">埋藏在罗德心底的东西。她在被逼上绝路时释放的『魔・法』的真正由来。；罗德那漫长的人生。折磨得她连呼吸都感到痛苦的，不得不喊出的『咏唱』的真正意义。；──将这一切都映入我的眼中。</data></node>
    <node id="玛利亚白炎烧尽『耐性』之『理』"><data key="name">玛利亚白炎烧尽『耐性』之『理』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『炎之剑』连同『耐性』这个『理（Rule）』也一并烧尽了。；无限升温的剑芯颜色也开始由红转白。颜色就跟阿尔缇曾用过的火焰一样。作为后进者的玛利亚，正渐渐地追上阿尔缇的实力。</data></node>
    <node id="艾德仍在地上等待缇缇归还"><data key="name">艾德仍在地上等待缇缇归还</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">与同伴汇合的话，对付艾德的战力也能增加了。；「不过这会延长让你和艾德相见的时间啊，这方面没问题吗？」；「嗯？没问题没问题，人家现在精神着呢，就算再过个一百年都没事哦？」</data></node>
    <node id="斯诺房间当夜禁令（'晚上绝对不可以进来'）"><data key="name">斯诺房间当夜禁令（'晚上绝对不可以进来'）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯～。那就到早上为止好了。到明天早上为止，务必要贯彻这条命令，拜托了。特别是晚上，晚上绝对不可以进来！」</data></node>
    <node id="拉丝缇娅拉与缇亚对涡波技能的异样沉默"><data key="name">拉丝缇娅拉与缇亚对涡波技能的异样沉默</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">然而不知为何，继续说下去的拉丝缇娅拉的脸色变得严肃起来。仔细一看，身旁的缇亚也一样。；看来在莱文教关系者眼中察觉到了什么东西。；很明显地是强行转移话题。</data></node>
    <node id="诺文的愿望与第三十之试练"><data key="name">诺文的愿望与第三十之试练</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我希望得到名誉和荣光。希望得到许许多多人的赞赏。</data></node>
    <node id="诺斯菲留恋之谜推进（无法实现的留恋·佩艾希亚崩壊利害）"><data key="name">诺斯菲留恋之谜推进（无法实现的留恋·佩艾希亚崩壊利害）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「就是说啊，诺斯菲你不也是有着留恋的么？而你的留恋，难道不是在地上、在未来无法实现的东西吗！？难道不是跟人家一样，只有在过去才能实现的东西吗！？难道不就是因为这样，你才没有去地上，而是来到了『过去（这里）』的么！？如果『那个空间（佩艾希亚）』崩壊了的话，最困扰的人不是诺斯菲你才对吗！？」；尽管诺斯菲当场否定了罗德的言论，但她内心的动摇是确实的。方才她身上只有少许的冷汗正在逐渐增多。；诺斯菲突然抱头蹲下。</data></node>
    <node id="海莉的未完警告"><data key="name">海莉的未完警告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「虽然如果能一直维持现在这样抵达最深部就好了。但是这一定只是虚幻缥缈的梦吧。我虽然想去相信。但是你们两人已经、变得跟我一样了。跟我一样——然后——」；「咕、呜呜——，所以少年，你听我说——，你不能变得跟我——！！」</data></node>
    <node id="罗德坚决否定『成熟大人/王』之谜"><data key="name">罗德坚决否定『成熟大人/王』之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「没、没有那回事。罗德绝对是一个比任何人都要成熟的大人。作为你的劲敌，我可以证明的，你是一个大人⋯⋯！是个比任何都成熟的大人⋯⋯！！」；「──不・对」；「没有什么不对⋯⋯！如果连『支配之王（罗德）』都不是大人的话，那还有谁有资格说自己是大人呢⋯⋯！？」</data></node>
    <node id="弗茨亚茨对基督的通缉"><data key="name">弗茨亚茨对基督的通缉</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为弗茨亚茨十有八九在通缉基督。；虽然弗茨亚茨的追兵会找上门，但是相对地也更容易跟同伴们汇合了啊」</data></node>
    <node id="涡波的'无言以对之事'"><data key="name">涡波的'无言以对之事'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">比如说，有一件事。只有那件事──一旦提及，我肯定会无言以对。；但是，到头来总算是给它压住了。多亏了『并列思考』，我能很容易地圆话。；跟心地善良的海莉不同，接下来我要面对的敌人绝不会放过放过那一点。</data></node>
    <node id="涡波的秘密计划(防她察觉)"><data key="name">涡波的秘密计划(防她察觉)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──那不能说。抱歉，拉丝缇娅拉。」；因为无论哪个都有被·她·注·意·到的可能。</data></node>
    <node id="涡波的千年存在之谜（『我到底是谁』）"><data key="name">涡波的千年存在之谜（『我到底是谁』）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">千年前的相川涡波和相川阳滝最后怎样了？；到了千年后仍然存在于此的我，到底是什么人？；正常来说，早就因为寿命问题死去了才对。</data></node>
    <node id="XiphiasSpear尸体与落海魔剑回收之约"><data key="name">XiphiasSpear尸体与落海魔剑回收之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「剑之后再捡！你先拿出风之铳剑来结果它再说！要是再让它潜入水下就麻烦了！！」；「啊。但是刚才掉出去的『XiphiasSpear』的位置可要用『维度』记住了哦。之后涡涡可要帮人家捡回来」</data></node>
    <node id="罗德的真'留恋'与'第二次'之谜"><data key="name">罗德的真'留恋'与'第二次'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──嗯～，人家想想哦。要是你能陪人家一起生活在『这里』的话，那人家会很开心的哟？因为人家的留恋，就是和平安稳地生活在『这里』呀」；即使在『这里』得到了和平与安宁，你的留恋也没有实现。；正因如此，你才会在『这里』待了整整一千年。</data></node>
    <node id="第二个客人"><data key="name">第二个客人</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">很快第二个客人，就代替玛利亚到来了。</data></node>
    <node id="冰结属性矛盾"><data key="name">冰结属性矛盾</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『Connection』和『Foam』虽然标示了出来，但『LittleSnow』却不见踪影。</data></node>
    <node id="本土北方之行：接回妹妹与同伴（救出缇亚）"><data key="name">本土北方之行：接回妹妹与同伴（救出缇亚）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">赶快去本土北方把妹妹和同伴们带回来吧。；「我很快就会带妹妹赶回来。到那时，我们两个再好好谈一谈吧。我希望你替我这样转告她」；去和大家汇合，然后将缇亚救出来</data></node>
    <node id="称号与魔石的错位"><data key="name">称号与魔石的错位</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接着，一颗魔石落入玛利亚手中。然而那颗魔石立刻失去了形态，变成一缕火焰被吸收进了玛利亚体内。</data></node>
    <node id="罗德泪之雨未终结·诺斯菲留恋（再见罗德使其振作）未达成"><data key="name">罗德泪之雨未终结·诺斯菲留恋（再见罗德使其振作）未达成</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">没错，我想要让这场泪之雨得到终结」；毕竟这可是我的留恋呀，没有办法不是么？」；「不等。要问为何，那是因为虽然您从之前开始就一直艾德艾德地说着，但其实根本没那个必要」</data></node>
    <node id="『世界奉还阵』与千年前『什么东西』的连结"><data key="name">『世界奉还阵』与千年前『什么东西』的连结</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，在故作坚强的我之前等着的，就是帕林库洛的『世界奉还阵』。那东西是跟千年前的『什么东西』紧密相连的吧。</data></node>
    <node id="使世界剧变的人物（涡波自有头绪·名字未明言）"><data key="name">使世界剧变的人物（涡波自有头绪·名字未明言）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">并且，若要论及能让世界发生如此剧变的人物，那也为数不多。；我自有头绪。恐怕就是──；但不论如何，这场剧变之下的确潜藏着某种『扭曲』，即使不情愿，它也逃不过我的『感应』</data></node>
    <node id="缇缇最后的归途（为真正的往生回故乡）"><data key="name">缇缇最后的归途（为真正的往生回故乡）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">而且──我们接下来要踏上的也是缇缇『最后』的『归途』；为了真正的往生，她这次要踏上回到故乡的道路。；缇缇最后的冒険，就这样拉开了帷幕──</data></node>
    <node id="帕林库洛的最终回合（濒死未退）"><data key="name">帕林库洛的最终回合（濒死未退）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">只要这条命还在，我就绝不束手投降！来吧，终于到了最后一回合了哦！涡波小哥！！；现在的帕林库洛根本没有防御的余地。被卷进剑闘中的他胴体被斩裂。身负已经连回复都无济于事的致命伤。；但是帕林库洛却笑了，他一如往常地笑着。</data></node>
    <node id="罗德的魔法传授宣言"><data key="name">罗德的魔法传授宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「好滴，那人家也要以符合守护者的方式消失为目标喽。既然阿雷亚斯那家伙将自己的剑术留给你们两人继承了，那人家就把魔法传授给你们好了！」；在次元魔术的学习上遇到瓶颈的我，对她说的魔法产生了一点兴趣。</data></node>
    <node id="诺文的工房密谈"><data key="name">诺文的工房密谈</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">察觉到这点，诺文嘴角轻轻一扬，接着跟艾利巴茨耳语起来。</data></node>
    <node id="罗德与诺斯菲的表面平静与『没有多少时间了』"><data key="name">罗德与诺斯菲的表面平静与『没有多少时间了』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「今天，在城里来回游走，想着做些填补⋯⋯但，已经是极限了。和两人的谈话确信了这点。罗德无论何时崩溃都不奇怪，诺斯费也是感觉到了和以往的气氛不太一样。可能，没有多少时间了」；「感觉只是表面上这样而已。至今为止与各式各样的守护者战斗的经验推测，那两个人明显很奇怪⋯⋯」；与昨天的迷宫探索结束时不同，两人的表情都变得明亮起来了。</data></node>
    <node id="表示显示未来名之谜"><data key="name">表示显示未来名之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">再有就是他自己道出的名字也跟『表示』上显示的不同。</data></node>
    <node id="阳滝复活计划（千年计划）与三人再会"><data key="name">阳滝复活计划（千年计划）与三人再会</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「要是成功了的话、呢？」；摆在前面的障壁很多。说不定又会遭遇失败。</data></node>
    <node id="骑士涡波背叛佩艾希亚的千年前时期"><data key="name">骑士涡波背叛佩艾希亚的千年前时期</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">利用这一点，孤将这里的时间轴调整到了孤与骑士涡波背叛佩艾希亚的时期。</data></node>
    <node id="莱纳体内寄存的力量与知识（秘藏手牌）"><data key="name">莱纳体内寄存的力量与知识（秘藏手牌）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这是因为如今寄存于我体内的力量和知识是秘藏的手牌，不便随意透露。；听着我的推测，目前成为了我的上司的塞拉脸上流露出钦佩之色。</data></node>
    <node id="『假面男子』记忆流入·掩埋自我"><data key="name">『假面男子』记忆流入·掩埋自我</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">当超越界限的时候，那个『假面男子』的记忆就会流入我的体内。；然后，每当做一次梦，新的记忆就会掩埋我。把我的记忆，感情，身体完全掩盖。</data></node>
    <node id="悬影哀嚎之不祥"><data key="name">悬影哀嚎之不祥</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我总觉得它们的叫声在孕育着十分不详的『什么东西』。</data></node>
    <node id="涡波真正的属性"><data key="name">涡波真正的属性</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为我的属性既不是『冰』也不是『水』；时至今日，我已经尝试过各种各样的冻结魔法，也失败了无数次。到头来我始终也发挥不出魔法『冰』『冻结』的效果范围之外的力量。很明显我没有办法领悟冻结魔法的真髓。；既然如此，我的属性就应该是──⋯⋯</data></node>
    <node id="职业获得之谜"><data key="name">职业获得之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的职业栏上什么都没有，而缇亚则是剑士。</data></node>
    <node id="『里侧』诸法则消失倒计时"><data key="name">『里侧』诸法则消失倒计时</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">恐怕再过不久，就连呼吸的空气也会归于虚无吧。</data></node>
    <node id="『DistanceMute』的『进化』——最终形态魔力缠全身"><data key="name">『DistanceMute』的『进化』——最终形态魔力缠全身</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然现在的我只能魔力缠绕于整根手臂，但这个魔法的真髓应该远不及此。恐怕它的最终形态是将魔力缠绕于全身吧。；我还能变得更强。</data></node>
    <node id="西区斯诺龙化激战(下章回收)"><data key="name">西区斯诺龙化激战(下章回收)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这也就意味着，现在双方正在进行能产生出这等余波的激战。</data></node>
    <node id="章末名单钩——'千年前最需要注意的人物'"><data key="name">章末名单钩——'千年前最需要注意的人物'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「是啊，最大的难关就是那里了吧。要是出来个不听人话的家伙就糟透了。想来，说到千年前最需要注意的人物的话──」；雷纳尔多稍作思考后，道出了那些人的名字。</data></node>
    <node id="阳滝苏醒与兄妹身魂归位"><data key="name">阳滝苏醒与兄妹身魂归位</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">话是这么说，但是青色魔石仍在睡眠状态。这是无意识的吸收。；就这样，一名少女『再诞』于这个世界。；──『始祖涡波』的躯壳，就这样变成了『相川阳滝』</data></node>
    <node id="诺斯菲『父亲大人』呼喊之谜"><data key="name">诺斯菲『父亲大人』呼喊之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「父亲大人⋯⋯」；抬头望向屋顶的少女口中轻声念出父亲一词。</data></node>
    <node id="40层守护者封印方针"><data key="name">40层守护者封印方针</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「目标首先定为39层。总方针是在与帕林库洛做出了断之前，不要唤醒40层的守护者！」；变成那样的话到时候会把你当做诱饵留在迷宫里的所以没问题。</data></node>
    <node id="明日的一起坦白(异世界来历与技能)"><data key="name">明日的一起坦白(异世界来历与技能)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">[玛利亚……。到了明天，我会将自己的一切和盘托出]；毕竟这不是只能让玛利亚一个人知道的事情啊]</data></node>
    <node id="海莉记忆继承存疑（莱纳不信任帕林库洛施术）"><data key="name">海莉记忆继承存疑（莱纳不信任帕林库洛施术）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「你在那里太好了个什么劲啊，根本就不好！确实事情的经过我是听说了，但是你不要以为我就原谅你们了诶！说到底，那个『魔石人类』到底有没有正确继承海因兄长的记忆这一点就是个问题！我可没有相信哦！毕竟施术者可是那个帕林库洛啊！」；莱纳这话说得在理。其实我也是这么想的。</data></node>
    <node id="涡波『真正的魔法』（改写世界之理）构筑"><data key="name">涡波『真正的魔法』（改写世界之理）构筑</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这就是我为了构筑出能够连世界的理也改写的『真正的魔法』而进行的『咏唱』──！！；「啊啊，没错！而这就是我・的・魔・法！为了拯救守护者（你们）而存在的魔法──！！」</data></node>
    <node id="帕林库洛的期望（海因遗愿）"><data key="name">帕林库洛的期望（海因遗愿）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我希望『帕林库洛的期望』能实现，这便是我最后的愿望。</data></node>
    <node id="贝丝的千年残留"><data key="name">贝丝的千年残留</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">好像在她的心中有着不属于她自己的什么东西一样……；只•能•认•为•这•点•心•的•做•法•是•我•教•她•的。；贝斯方才的言谈中混杂着与她年纪不符的成熟感。可能是雷纳尔多口中所谓『还残留着』的东西使然吧。</data></node>
    <node id="诺斯菲消灭沃尔斯将军计划"><data key="name">诺斯菲消灭沃尔斯将军计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「正是你的这份温柔放跑了赫勒比勒夏因。；诺斯菲接二连三的正论还是说服了罗德，她最终缓缓地点了点头。</data></node>
    <node id="始祖缇娅拉再诞预言"><data key="name">始祖缇娅拉再诞预言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「是啊，联合国五国的国教莱文教有流传下来的『预言』。——今年是‘始祖缇娅拉再诞之年’，‘剑与剑交错之际，『真·正·的·英·雄』现身’，许许多多的信徒都相信着这些『预言』哦。」</data></node>
    <node id="莱纳被送入罗德准备的『试练』场所（去向开环）"><data key="name">莱纳被送入罗德准备的『试练』场所（去向开环）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">随着这道可爱的声音，莱纳就像曲棍球一样被她射进了巨大的『连接』当中。；恐怕就是罗德准备的用于『试练』的场所。</data></node>
    <node id="被带走的'王之器'少女"><data key="name">被带走的'王之器'少女</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">现在的她正可谓是这个世界至高的宝石。是有资格暂代我等的『支配之王』的存在……！；宣告了离别的台词之后，二人便被巨树吞了进去。</data></node>
    <node id="理的盗窃者死亡诅咒→半死体化（最强力量）之当前发动"><data key="name">理的盗窃者死亡诅咒→半死体化（最强力量）之当前发动</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这是在理的盗窃者们死亡之际发动的『诅咒』。；尽管是『诅咒』，但这毫无疑问是最强的力量。；随着『半死体』的演变，大股力量自体内涌现。</data></node>
    <node id="白色怪物对涡波的注视"><data key="name">白色怪物对涡波的注视</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这些白色的怪物们仅仅只盯着我一个人看。它们眼中并没有莱纳，只有我。；它们表现出一种看到了我之后感到十分安心的感觉。这反应就像是见到了非常怀念的旧识一样。；这样就没有不挑战六十层的理由了。堪称光之阶层的六十一层和六十二层，简直就像是在如此呼唤我一般。</data></node>
    <node id="守护者留恋使命的归属预感"><data key="name">守护者留恋使命的归属预感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">理由我也说不明白。但是，我还是有一种感觉──就是实现守护者留恋的使命终究还是属于我们。；这片大草原的主人，必须由我来迎接才行。最初聆听其愿望的人，应该是我才对。</data></node>
    <node id="与赛鲁多拉的会面（协力者预期与战斗假设）"><data key="name">与赛鲁多拉的会面（协力者预期与战斗假设）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为就方才听到的而言，赛鲁多拉此人的强度足以与缇缇和诺文匹敌。；⋯⋯以防万一，我还是做好会与赛鲁多拉战斗的假设吧。；嘛，只要他的『留恋』没有变，应该就不会成为你的敌人的。放心吧放心吧」</data></node>
    <node id="梦中启示：黑暗之声与千年前的契约景象"><data key="name">梦中启示：黑暗之声与千年前的契约景象</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——两人注定的『界限』已经越过——也就是说，触及了人类的『极限』——啊啊，这样下去的话，又要演变成那样了——重演那过去的故事——那场悲剧又要重演——不可以——何等残酷的结局——不、不对——绝对不能让其重演——唯有这点我绝不允许——绝不允许——绝对绝对绝对——绝对——；一边捋起深金色的长发，中性外表的女性说道：；「——我·能·治·好·她·哦。不，应该说是我知道治好她的方法才对吗？」</data></node>
    <node id="佩艾希亚天空异变（魔石样微光）"><data key="name">佩艾希亚天空异变（魔石样微光）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「果然还是很奇怪啊⋯⋯」；注意到昨天感觉到的那种天空的扭曲变得更严重之后，我不禁止足。；仔细看去，会发现那些光与怪物们掉落的魔石闪耀的光芒很相似。</data></node>
    <node id="炼金级矿物转化的经济冲击之虞"><data key="name">炼金级矿物转化的经济冲击之虞</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这个能力犯规到可以让这个世界的宝石失去价值的地步。只要我花费时间全力炼金的话，很容易就能将市场的物价搞崩。；通过炼金，我甚至能够左右一个国家的物价，根据情况来使用的话，这东西甚至称得上战略性攻击魔法。</data></node>
    <node id="莱纳的死亡观——'迟早要死的家伙'"><data key="name">莱纳的死亡观——'迟早要死的家伙'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「如果情况危急的话，你就将我们全杀掉吧。对你来说很容易吧？不用太顾虑我们，反正在这里的人都是你放着不管迟早也要死的家伙。就算这时候死掉了也不会有什么怨言的」</data></node>
    <node id="诺斯菲留恋言行矛盾"><data key="name">诺斯菲留恋言行矛盾</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她好像十分欣喜地看着自己肩膀的伤口，与嘴上说的留恋增加了相反──她那光辉闪耀的躯体浓度稍稍淡薄了一些。虽然只有不值一提的程度，但她的存在确实变浅了一点。</data></node>
    <node id="阿尔缇的疑念"><data key="name">阿尔缇的疑念</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我就算了。我在这世上还有事要做……而且，我总觉得很快就能解消心中的那份疑念了。」</data></node>
    <node id="罗德咏唱代价的极限（心之磨耗与生命灵魂之危）"><data key="name">罗德咏唱代价的极限（心之磨耗与生命灵魂之危）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">罗德要通过『咏唱』宣泄自己的人生不存任何意义，借此削耗自己的魂，从而让自己的身体无止境地变轻。；如果继续这样不满于现在的加速而索求更进一步的加速，为了实现更进一步的加速而舍弃更多的东西的话，那就不光是心灵，甚至会危及她的生命乃至灵魂。；磨耗、融解、化作风溶入世界的，是罗德的心这点，只有我看得到。</data></node>
    <node id="『几百年』『不管』的违和感与空城之谜"><data key="name">『几百年』『不管』的违和感与空城之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『几百年』、『不管』――我从她的话语中感到了些许违和感。；最后即使整座城堡都被涵盖在『Dimension』里面，我还是连一个人都没见到。</data></node>
    <node id="『水之理的盗窃者』误认"><data key="name">『水之理的盗窃者』误认</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「难、难道说，您是相川涡波大人⋯⋯？不、不对，但是这有点奇怪。难道您是『水之理的盗窃者』⋯⋯？」；『木之理的盗窃者』叫出我的名字，同时却又呢喃着『水之理的盗窃者』一词。；明明他自己就是持有着超越人外力量的BOSS怪物，但是他这副模样，却像是人类同『怪物』相遇了一样在感到害怕。</data></node>
    <node id="迷宫建造者『某人』与最深部『奇迹』"><data key="name">迷宫建造者『某人』与最深部『奇迹』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然也能因为这是异世界的迷宫之类的理由勉强自己接受。但是，从过去诺文所说的话来看，这个『某人』的存在是可以确信的。那时候，诺文说过「对人类很体贴的『某人』，用不合风格的做法打造出了迷宫」；在迷宫的最深部有强大的力量──有『奇迹』的存在。打造迷宫的人很体贴，迷宫本身也很体贴。越是在迷宫中前进探索者就越强。；──是谁都无所谓。不管这个『某人』是什么人，跟现在的我都没什么关系。</data></node>
    <node id="魔石同化者的国级经济战力"><data key="name">魔石同化者的国级经济战力</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那么与魔石同化的玛利亚和帕林库洛，应该也具有同级别的力量。；这两个人身上，都蕴藏着可以颠覆一国经济水平的实力。</data></node>
    <node id="西斯的『降临』与心中裂缝"><data key="name">西斯的『降临』与心中裂缝</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的降临一定会更加快到来哦？就算是我，也希望心中没有裂缝的出现哦。</data></node>
    <node id="罗德对速通回地上的不满（留恋线推进）"><data key="name">罗德对速通回地上的不满（留恋线推进）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">居然能够规避称得上对我们回到地上而言最棘手的障碍──六十余层的怪物之间的战斗。以至于让我觉的继续这样下去的话可以毫不费力地回到地上。；「姆姆⋯⋯」；而这一点，罗德也注意到了吧。</data></node>
    <node id="对罗德的持续欺骗与救赎誓言"><data key="name">对罗德的持续欺骗与救赎誓言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">然而事到如今我们回到地上本身就是为了罗德好。哪怕是为了早一秒将最能够拯救她的艾德叫来，我也不能答应她的提议。；但是，我还是在心中发誓绝对会救她，并继续实施当初的方针。；「这样吗⋯⋯⋯明天人家要一个人了吗⋯⋯」</data></node>
    <node id="千年前存活长生种线索（斯科纳/托尔普）"><data key="name">千年前存活长生种线索（斯科纳/托尔普）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「啊─，没帮上忙真是不好意思。毕竟咱一直都在极力避免跟使徒大人还有『理的盗窃者』的问题扯上关系来着。不过，咱觉得其它从千年前留存至今的人或许会知道会长当时的经历哦？」；咱记得在世界树那边有作为『最后的纯血树人种』的『斯科纳・伊格德拉西尔』、以及在联合国开拓地有作为『最后的纯血龙种』的『托尔普・特鲁克』来着」</data></node>
    <node id="莱纳许誓『咏唱』的契约代价"><data key="name">莱纳许誓『咏唱』的契约代价</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">仍然完成了某种『契约』。很明显莱纳也付出了一份绝对无法无视的『代价』</data></node>
    <node id="缇亚体内使徒驱除之法的付费门槛"><data key="name">缇亚体内使徒驱除之法的付费门槛</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「帕林库洛，换一个问题。你知道将使徒从缇亚体内逼出来的办法吗？还是说，如果实现了使徒西斯的留恋的话，那家伙也会消失呢？」；「⋯⋯嗯，谁知道呢？这个问题的答案，我可能知道，也可能不知道。嘛啊，就算我知道，也不是免费的哦？要打听记忆之外的事情就需要另外付费了哦」；以我想知道的事情为饵，他盼望着真正的互相厮杀。</data></node>
    <node id="海因的棋子任务"><data key="name">海因的棋子任务</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那么我要做的就是将情况整理好，以便到时为他提供帮助。</data></node>
    <node id="涡波与千年前之王的旧怨（诓骗指控）"><data key="name">涡波与千年前之王的旧怨（诓骗指控）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「诶诶，没错正是如此。一切都已经结束了。因此就忘掉你诓骗了我等的王这件事好了。都是过去的事情了，已经与现在无关了啊」</data></node>
    <node id="北上救缇亚之旅"><data key="name">北上救缇亚之旅</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「和斯诺汇合之后，就轮到在『第二迷宫都市达利尔』的玛利亚和莉帕了呢。移动手段就跟之前一样用船如何？现在『LivingLegend号』就停靠在古尔亚德的港口，你可以直接使用。让渡的公文我很快就能发给你所以不用担心。和大家汇合之后，就拜托你北上救回缇亚了。啊啊，还有──」</data></node>
    <node id="斯诺的'我——'未竟之言"><data key="name">斯诺的'我——'未竟之言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『那、那就再见了……涡波……』</data></node>
    <node id="西斯携缇亚之身先行讨伐帕林库洛"><data key="name">西斯携缇亚之身先行讨伐帕林库洛</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「总之，我要先去帕林库洛・勒伽西那边。接下来『我们』要先行一步，送他归西。对这件事，缇亚酱也没有反对意见」；「这我办不到。──盟友涡波。因为没有这具身体的话我也无法行动。所以，缇亚酱要跟我一起去」</data></node>
    <node id="帕林库洛的翻盘之策（战斗未终）"><data key="name">帕林库洛的翻盘之策（战斗未终）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">战斗还没有结束。；如果是帕林库洛的话，即使局面到了这一步，他依然有扭转之法。；他的眼中依旧闪着光。那是一道无论怎样也绝不放弃的光。</data></node>
    <node id="罗德真正的留恋之谜"><data key="name">罗德真正的留恋之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，即使抛弃一切也想要实现的东西，那就必定是作为佩艾希亚的王所无法达成的事吧。；「不，我也没什么线索⋯⋯」</data></node>
    <node id="呼唤相川阳滝的指引（海莉遗言）"><data key="name">呼唤相川阳滝的指引（海莉遗言）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「涡波君──，你可曾试过去呼唤？」；「你仅仅只是去找，却没有试过呼唤『她』不是吗？你一直单方面地想要回到原来的世界，却不曾试图向『她』寻求帮助。明明『她』很可能已经追随你的脚步来到了这个世界呢。如果，『她』已经来到这边了的话，那么就一定会回应你的呼唤的。如今的『我』是明白的。正・因・为・是・『我』。所・以・才・能・明・白」；「接下来你只要去呼唤就可以了⋯⋯⋯仅仅如此，涡波君就一定能够找到自己的妹妹⋯⋯⋯根本不需要帕林库洛⋯⋯⋯所谓的兄弟姐妹，一直都是紧密联系在一起的。既不是通过『契约』也不是通过『血』──而是『爱』。这一点我比任何人都清楚」</data></node>
    <node id="佩露修娜的弗茨亚茨后援宣传"><data key="name">佩露修娜的弗茨亚茨后援宣传</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——然后，在那里不管是跟芙兰告白还是干些什么别的都随你的意好了。就算是跟她求婚也没问题。弗茨亚茨会全力做后援的。不管劳拉维亚想怎么说，我们都能让你成为『天上之七骑士』！」</data></node>
    <node id="千年前的传说——『英雄』与『怪物』们的战斗"><data key="name">千年前的传说——『英雄』与『怪物』们的战斗</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">梦见那千年前的传说。那『英雄』与『怪物』们的战斗。；现在这个世界上的一切，皆起因于千年前。</data></node>
    <node id="帕林库洛的笑容·战斗未终"><data key="name">帕林库洛的笑容·战斗未终</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，即使是这样──帕林库洛依旧在笑着。；他的笑容，宣示着这场战斗还远远没有结束。</data></node>
    <node id="绝不能输的战斗——地上篇主线（西斯与艾德）"><data key="name">绝不能输的战斗——地上篇主线（西斯与艾德）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉、玛利亚、斯诺、莉帕、塞拉。；掳走了缇亚的使徒西斯，还有掳走了妹妹阳滝的守护者艾德。；一场绝不能输的战斗还在等着我──所以现在就好好地──⋯⋯</data></node>
    <node id="艾利巴茨装备领取（含订制品）"><data key="name">艾利巴茨装备领取（含订制品）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「说起来，会长你拜托艾利巴茨那家伙打造的装备已经做好了哦？见你一直不来取，他还挺不安的来着，要不你去一趟吧」；说起来，我确实拜托他打造了各种各样的装备。里面应该还有为了缇亚和玛利亚订制的东西。</data></node>
    <node id="拉丝缇娅拉之眼"><data key="name">拉丝缇娅拉之眼</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「怎么了吗？还是说，『您的眼睛』看到什么了？」</data></node>
    <node id="缇亚的自我认同危机"><data key="name">缇亚的自我认同危机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">哪怕是为了『我（俺）』还能是我，我也绝对要去救基督……！</data></node>
    <node id="罗德对『支配之王』声援的暴风雨（王之身份抵触）"><data key="name">罗德对『支配之王』声援的暴风雨（王之身份抵触）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我们的『支配之王』回来了啊！！我们的救世主没有背叛我们啊！！」；「──少、少来碍事！统统退下──！！」；听到子民的声音之后，很明显在她的内心刮起了暴风雨。</data></node>
    <node id="圣人缇娅拉的后继者=莱纳（弗茨亚茨故事偏离血脉）"><data key="name">圣人缇娅拉的后继者=莱纳（弗茨亚茨故事偏离血脉）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">正与某个人物如出一辙。；『圣人缇娅拉』选中的后继者；而是『莱纳・赫勒比勒夏因』</data></node>
    <node id="年迈夫妇之声的主人身份（章末切断）"><data key="name">年迈夫妇之声的主人身份（章末切断）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">[——哦、哦—！老婆子，这孩子好像醒了啊！]；这是孤已经忘却的声音。；不对，这个声音的主人们是——……！！</data></node>
    <node id="玛利亚的目光"><data key="name">玛利亚的目光</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">无神的双目重新恢复了色彩的她看向我想要说些什么。</data></node>
    <node id="海莉的新生"><data key="name">海莉的新生</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不，把话说死还太早了。还没有人能断定。……所以，海·莉·你·也还不能就这样放弃啊。」；那是不再执着于死，而向往生的决意。</data></node>
    <node id="『这里』的异变危机(两个涡波并存)"><data key="name">『这里』的异变危机(两个涡波并存)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不然的话，有你们两个同时存在，真不知道『这里』会发生什么样的变化。；其间，我更加深刻地意识到，自己必须尽快回到地上。</data></node>
    <node id="王座交替准备完毕与命定之王"><data key="name">王座交替准备完毕与命定之王</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">（如果说是作为守护者的留恋的话，那鄙人认为非此莫属。所有的准备工作皆已完成，随时都可以实现王座的交替。统治的权柄必将归于支配『北方』的命定之王──）</data></node>
    <node id="大小姐的秘密与『总有一天亲口告诉』之约"><data key="name">大小姐的秘密与『总有一天亲口告诉』之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「总之现在一言难尽。大小姐她要我保密。作为向大小姐宣誓忠诚的骑士，我不能跟你解释。现在的我能做到的，就只是将大小姐的心意告诉你罢了」；「总有一天，大小姐会将所有的一切亲口告诉你。能否请你等她到那个时候呢。务必、拜托了⋯⋯」；当然，既然有什么事是这两人无论如何都不愿提及的，那其中就可能潜藏着非同寻常的危险。我也不能保证自己没有看漏什么重要的隐忧。</data></node>
    <node id="魔力=『毒』之谜与向使徒西斯打探之约"><data key="name">魔力=『毒』之谜与向使徒西斯打探之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在我千年前的记忆中，有将『魔力』称为『毒』的片段。由此观之，被我看作既然是异世界那么就理当存在的『魔力』可能并不是这个世界生而有之的东西。；说来，我记得作为使徒的西斯对『魔力』知之甚深。那么等之后见到她时，我就试试能不能从她口中打探出什么好了。</data></node>
    <node id="技能《？？？》箭在弦上的发动危机"><data key="name">技能《？？？》箭在弦上的发动危机</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为技能《？？？》已经是箭在弦上了。；为了守护好好不容易取回的感情的火种，绝对不能在这个时候让它发动。；现在只要我的感情有一点波动，技能《？？？》就会发动。</data></node>
    <node id="海莉存续于『世界奉还阵』·道标与记忆组合指引"><data key="name">海莉存续于『世界奉还阵』·道标与记忆组合指引</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">海莉还存在于『世界奉还阵』之中存在，也就是说现在也作为道标指明着道路。；────「这里的话，能知道一切。组合『记忆』吧。并非帕林库洛所选择的『记忆』。少年去看自己想知道的『记忆』吧。然后到达真相吧。」</data></node>
    <node id="三人同得答案的愿望(孤独消失恐惧)"><data key="name">三人同得答案的愿望(孤独消失恐惧)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">或许这是一份奢侈的心愿，但我希望到最后能三个人一起得到『答案』，然后三个人一起笑着迎来结局。；诺文·阿雷亚斯就一直在等待朋友的现身。</data></node>
    <node id="缇亚的异常征兆"><data key="name">缇亚的异常征兆</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「是啊……『我』是不必向你道歉的啊……」；我之前告知自己身世的时候，也从缇亚那里了解到了一些『使徒』的事情。因为缇亚生来背后长有白翼，所以就被『莱文教』视作了再临的使徒。；不过，在缇亚的身影消失在船舱的一瞬间，我视作装饰的白翼似乎微微颤动了一下。</data></node>
    <node id="主角的黑暗坠落"><data key="name">主角的黑暗坠落</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为帕林库洛的魔力，不仅是视野，就连大脑也被侵染成了黑色。</data></node>
    <node id="莱纳的咏唱滥用预判（为他人的代价支付）"><data key="name">莱纳的咏唱滥用预判（为他人的代价支付）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不过莱纳这小子，一定会想都不想地频繁使用的。而且还不是为了自己，而是为了其他人。因为能料到这点，因而我摆不出什么好脸色。</data></node>
    <node id="基督无意识压抑的真心话（缇缇醉后本性论）"><data key="name">基督无意识压抑的真心话（缇缇醉后本性论）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──咳哼。不过啊，莱纳。如果涡涡真的喝醉的话，那咱们说不定能看到他的本性哦。说不定还能说漏一直被他藏在心底的真心话呀小秘密之类的哦。怎么样？你不感兴趣吗？」；「天真、太天真了，涡涡！只要是人类的话就肯定有什么压抑在心的事！在无意识之中！」；连我自己都不知道的自己的真心话──如果真的能借酒力搞清楚，那还真不壊。我也很感兴趣。</data></node>
    <node id="艾德的未答之问（佩艾希亚质问悬置）"><data key="name">艾德的未答之问（佩艾希亚质问悬置）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这就是你想要的佩艾希亚吗！？把这些人当做弃子，对你来说完全无所谓吗！？」；「赶紧回答！艾德！！」</data></node>
    <node id="莱纳的大圣堂地下既视感"><data key="name">莱纳的大圣堂地下既视感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但置身于此却总感到心神不宁。；没错，简直就像我以前也曾来过这里一样⋯⋯就像我曾经在这里受到了很残酷的对待一样⋯⋯</data></node>
    <node id="成功产品与'相像的孩子要多少有多少'"><data key="name">成功产品与'相像的孩子要多少有多少'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯虽然我不行，但你可以带一个和我不同的成功产品（女孩子）走哦。跟我相像的孩子要多少有多少呢」</data></node>
    <node id="艾尔米拉德言行或为激发演技(推测)"><data key="name">艾尔米拉德言行或为激发演技(推测)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">说不定，他那些像是准备好了的台词，全部都是为了让我认真起来的演技。；不对，岂止如此，说不定他身为希达尔克家的长男的一切表现都是——</data></node>
    <node id="守护者消失机制"><data key="name">守护者消失机制</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">待到愿望成真的时候，我们便会消失。</data></node>
    <node id="前卫二人战力证明危机（领队副领队吃软饭问题）"><data key="name">前卫二人战力证明危机（领队副领队吃软饭问题）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是，现实就是如此残酷。只要我们拿不出比『Flame・Aegis』更有效率的战法，就永远轮不到我们上场。；但是，这么下去的话，领队和副领队就变成吃软饭的了。；会变成抱比自己还小的女孩子们大腿的队伍的。</data></node>
    <node id="莱纳的家庭环境"><data key="name">莱纳的家庭环境</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">像我这种被收养来的贵族，也就只有保护姐姐大人这点儿价值了。</data></node>
    <node id="诺斯菲'那天的事全都是误会'"><data key="name">诺斯菲'那天的事全都是误会'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">[请、请您等一下！涡波大人！请您听我说！那天的事全都是误会！！请您再听我——！！]；[这种事我可不想被现在的你说……而且说到底，我的目的只有涡波大人、唯有这一个人……！唯有他一人而已！！]</data></node>
    <node id="DistanceMute开发计划与对守护者底牌"><data key="name">DistanceMute开发计划与对守护者底牌</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『DistanceMute（幻之紫腕）』恐怕全都是最高位的魔法。──分别是『无法被干涉的攻击魔法』『无法被闪避的空间魔法』『无法被防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余」；「我想把这当做跟守护者（罗德）战斗时的底牌」；『你说的这个叫『DistanceMute』的魔法，现在就使得出来吗？』</data></node>
    <node id="技能《？？？》恋爱界限：发作即丧失爱情只留对方一人"><data key="name">技能《？？？》恋爱界限：发作即丧失爱情只留对方一人</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——技能《？？？》的发作就会让我丧失那份爱情，只留下拉丝缇娅拉一人。；不管怎样试图控制感情结果都不会变的吧。自己对拉丝缇娅拉的感情的背离是无法避免的。；——直到解决技能《？？？》为止。</data></node>
    <node id="破损的宝剑之谜"><data key="name">破损的宝剑之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我背后突然涌起一股寒意。</data></node>
    <node id="「缇缇」名字的原主（爷爷奶奶亡逝重要之人）"><data key="name">「缇缇」名字的原主（爷爷奶奶亡逝重要之人）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">难道说，这是对您二人而言很重要的名字⋯⋯？；因为在他们说出这个名字的一瞬间，两人都露出了有些怀念的表情。；其实这名字是自己现想的。原本是不久前死掉的这附近的一只小动物的名字。因为爷爷奶奶当初就是把曾经亡逝的重要之人的名字给了自己，所以自己也就模仿了这个行为</data></node>
    <node id="阿雷亚斯家与剑圣"><data key="name">阿雷亚斯家与剑圣</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「说话真难听啊、阿雷亚斯家的老头子。</data></node>
    <node id="『原来的世界』存在与否·亲眼确认之誓"><data key="name">『原来的世界』存在与否·亲眼确认之誓</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那个什么『原来的世界』，那玩应也是个相当扯淡的说辞啊！那种『世界』，真的存在吗！？；「啊、啊啊！是啊，我知道的……我知道啊！没有什么保证！就是因为没有，我才想去确认啊！所以我才决定要亲眼去确认啊！」；不管是『存在』，还是『不存在』。无论如何，我都不得不以其为目标。</data></node>
    <node id="超越人类极限领域后的姿态之问"><data key="name">超越人类极限领域后的姿态之问</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">继续这样积攒『经验值』的话，我们也有变得跟他们同级的可能。；但是不再被视为『人类』，而被看做『怪物』的结局实在是引人生厌。；20级──人类的顶尖级别。</data></node>
    <node id="莉帕×诺文的舞斗大会组队"><data key="name">莉帕×诺文的舞斗大会组队</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「又来了吗，我说啊，我可是因为你说无论如何都要参加才答应跟你组队的哦。要是你敢做奇怪的事，我就把你赶出队伍了啊。」</data></node>
    <node id="『涡波大人与我的开始（最初）便是结束』预告"><data key="name">『涡波大人与我的开始（最初）便是结束』预告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">像昨天晚上那样，因强制接受契约的证明而感到痛苦的涡波大人算是仅那一回；『涡波大人与我（两人）的开始（最初）』便・是・结・束！</data></node>
    <node id="不会游泳二人组与深层全浸水阻路"><data key="name">不会游泳二人组与深层全浸水阻路</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──这个一岁小孩，估计是不会游泳⋯⋯！；我首先看向了莉帕的方向。她正鼓起脸颊，屏住呼吸，拼命地抓紧塞拉。很明显她不会游泳。；──原来、这边这个三岁小孩，也不会游泳⋯⋯！？</data></node>
    <node id="弗茨亚茨选定的补位人才"><data key="name">弗茨亚茨选定的补位人才</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯那个，补充空位的人员似乎是由弗茨亚茨选定的一干人才，请你放心。我听说虽然没有斯诺那样有能，但为数不少所以应该能派上用场的」</data></node>
    <node id="魔王城空间与记忆'想起'"><data key="name">魔王城空间与记忆'想起'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在这里的话『想起』是比较容易的，涡涡这么说过喔；「欢迎回家，涡涡！我们的『魔王城』！；我以为我只有死亡或者是被吞噬两种选项，但看起来我好像意外地抵达了第三种可能性。</data></node>
    <node id="玛利亚=本时代最大敌人（西斯宣言）"><data key="name">玛利亚=本时代最大敌人（西斯宣言）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在这个时代的最大的敌人，既不是其它使徒也不是『始祖』……！而是玛利亚酱、是你啊！；「呋、呋呋，玛利亚酱对缇亚酱这么温柔真是帮大忙了！不过我可不想再跟玛利亚酱战斗了呀！？那就再见啦！！」</data></node>
    <node id="菲洛再会与转行招揽预告"><data key="name">菲洛再会与转行招揽预告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──唉，『菲洛・艾尔巴特』先生。要是下次有机会再见的话，务必请你转行不要再做海盗了啊。那样的话，到时候我一定要劝你加入我的队伍⋯⋯⋯；「唉，真是遗憾。如果能换一种跟你相遇的方式，说不定我们能成为同伴呢。⋯⋯但是很抱歉。我现在有点急事。──以后有缘的话，我们再见吧」</data></node>
    <node id="沃克家当主的不放弃(威尔格连之谜)"><data key="name">沃克家当主的不放弃(威尔格连之谜)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不过，一旦『舞斗大会』结束，你们将在顷刻间被劳拉维亚的精锐围堵。而且就算你们能逃出那张包围网，沃克家也会追你们到天涯海角。</data></node>
    <node id="技能『？？？』第二次暴走与感情的无限循环"><data key="name">技能『？？？』第二次暴走与感情的无限循环</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">【技能『？？？』暴走了】；以一定的感情为交换，使精神安定下来。；虽然在圣诞祭的前一天，我因为技能『？？？』的缘故失去了感情，但我会喜欢上拉丝缇娅拉的要因并没有消失。</data></node>
    <node id="守护者邀请者之谜(原初记忆走马灯)"><data key="name">守护者邀请者之谜(原初记忆走马灯)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——萧条的宅邸，宅邸中的庭院——唯一一人，持续不停地挥着剑的栗发青年——向这名孤高的青年搭话——因为看到了——这位青年注定要抵达修炼的末路——所以，不得不向他发出邀请——即使知道会招致青年的毁灭——还是不得不将栗发的青年堕为『地之理的盗窃者』——；因为这个记忆的主人并不是我。</data></node>
    <node id="斯诺龙化的进行性恶化（十年后设想中断）"><data key="name">斯诺龙化的进行性恶化（十年后设想中断）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为皮肤的硬化，她右肩附近的体征已经不再是人类的样貌了。恐怕这是她过度使用『龙化』的后遗症吧。；如果我时隔十年再回来的话，斯诺想必会彻底──</data></node>
    <node id="'使徒大人'与'那几位大人'（诺瓦露『完成』的推手）"><data key="name">'使徒大人'与'那几位大人'（诺瓦露『完成』的推手）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「普、普通⋯⋯？居然说被使徒大人选中的我很普通？真、真真真真不愧是英雄大人！说的话就是不一般啊⋯⋯！！」；拜那几位大人所赐，我已经『完成』了</data></node>
    <node id="斯诺与守护者缇达的对决宣言"><data key="name">斯诺与守护者缇达的对决宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「顺带一说帕林库洛那家伙现在跟守护者缇达的魔石同化了。应该变得相当强了，所以战斗的时候会强制你参战的。」；「——但是，果然我还是要努力一下。我觉得如果与守护者缇达有关的话，自己不能再去逃避了。不然的话，是没法继续前进的。」</data></node>
    <node id="罗德留恋真意自白：安宁之赏许赐某人与殒没"><data key="name">罗德留恋真意自白：安宁之赏许赐某人与殒没</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">孤尝以佩艾希亚之永久安宁作赏许赐某・人！期诺既许，岂可不予践行！当此二者两立之际，便为孤留恋清偿之时！是矣、孤将殒没！；她的内心已是满目疮痍，到了不相信那份虚假的留恋就没办法保持自我的程度。</data></node>
    <node id="世界奉还阵的不可终止与大陆溶解"><data key="name">世界奉还阵的不可终止与大陆溶解</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「那可做不到。发动已经结束了。这次既不是在边缘也不是在实验，所以就算我死了，这个魔法阵也不会终止。；不光是这片战场。在本土的城镇，连无辜的百姓都遭到了光芒无差别地普照。；尽管『世界奉还阵』的光芒尚在，但亮度已大不如前。用于转换的对象、亦即生命的存在已经被从地上完全抹去。会衰弱也是自然。</data></node>
    <node id="莉帕与'那个人'（前任术者之谜）"><data key="name">莉帕与'那个人'（前任术者之谜）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嘿嘿，真巧！这个大哥哥居然跟那个人一样！呵呵呵！都是次元属性的魔法使！来吧来吧！我空缺的术者的位置，就让这个大哥哥当好了！好了，诺文你打算怎么办！？」；说莉帕是由某人创造出来的魔法，可跟我的相性未免也好得太过分了。简直就像是我为了某种用途而准备的魔法一样……</data></node>
    <node id="致胜一击所必须用到的『那个』"><data key="name">致胜一击所必须用到的『那个』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因此我现在应该做的不是防御。；『那个』肯定还留在这个世界当中。；只要『这里』当真是罗德所期望的世界，当真是罗德自身的话，就一定──！</data></node>
    <node id="罗德的真本事与涡波的大魔法"><data key="name">罗德的真本事与涡波的大魔法</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最令人恐惧的，就是即使做出了这种惊世骇俗的破壊，罗德也还没有认真这一点。；不再更进一步地激怒罗德的话，就创造不出让我的大魔法击中罗德的机会。；刚才的战斗只不过是助兴</data></node>
    <node id="罗德的『留恋』=许赐『某·人』与殒没条件"><data key="name">罗德的『留恋』=许赐『某·人』与殒没条件</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">孤尝以佩艾希亚之永久安宁作赏许赐某·人！；当此二者并立之际，便为孤『留恋』清偿之时！是矣、孤将殒没！；已经坏掉的她，妄信着那必错无疑的『留恋』癫笑着。</data></node>
    <node id="斐勒卢托的余牌与'冰山一角'"><data key="name">斐勒卢托的余牌与'冰山一角'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯涡波阁下。那我们以后有机会再见吧。毕竟我也还没有使出全力呢啊⋯⋯──没错，我手上还有很多的牌可以打。今天的招待还只是冰山一角罢了」；「『相川涡波・基督・欧亚・弗茨亚茨・冯・瓦尔德沃克』大人。请用这边的。您原先的饮品里被投放了药物」</data></node>
    <node id="剑与盾激突的胜负（未揭）"><data key="name">剑与盾激突的胜负（未揭）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接着，就在下一个瞬间，决出了胜负。</data></node>
    <node id="暗之魔石回收与'本属涡波'之说"><data key="name">暗之魔石回收与'本属涡波'之说</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如果能确信这不是帕林库洛的陷阱的话，这东西我是想要立马给回收的。；「⋯⋯喂，帕林库洛。缇达我可就收走了哦」；「⋯⋯嗯，啊啊，说的也是。无所谓的。随你喜欢拿走就是了。本来那就是涡波小哥的东西来着」</data></node>
    <node id="雷纳尔多的'这次'既识反应"><data key="name">雷纳尔多的'这次'既识反应</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不过，面前的雷纳尔多表现出的惊讶之情甚至在我之上。他那双原本被眯细的眼睛瞪得老大，直勾勾地看着我。；「⋯⋯呼。真想不到、你居然会把这小子带到老朽这儿来啊」；「哼。这次还挺有礼貌的啊，小子⋯⋯」</data></node>
    <node id="罗德的不完全『魔石』之危"><data key="name">罗德的不完全『魔石』之危</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「难道说、罗德！没有必要做到这种地步吧！？那东西还不完全、太危险了！！」；风属性的魔力太过浓密，甚至导致了物质化。那东西作为一种存在来说实在太过沉重，以至于世界都无法负担。；那东西已经、那个像茧一样的玩意儿就是一个跟星辰同规格的──『魔石』</data></node>
    <node id="双守护者联手成敌之忧（离开迷宫不可能）"><data key="name">双守护者联手成敌之忧（离开迷宫不可能）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但，我身后涌起的这阵恶寒却挥之不去。；这不是当然的么。一旦命运稍微偏差，我就会与这两个人战斗的啊。；如果这两个人联手的话，那估计没有人是她们的对手。</data></node>
    <node id="地上艾德×地下罗德相会计划"><data key="name">地上艾德×地下罗德相会计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">搞不好只要让地上的艾德和地下的罗德相见，两个人的『留恋』就能一起实现了呢。；把阳滝从艾德手上夺回来之后，就给他绑了一路带到『这里』便是。</data></node>
    <node id="斯诺重伤后的动向"><data key="name">斯诺重伤后的动向</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯——我觉得还是不要想着跟斯诺姐姐谈话比较好哦？就凭大哥哥现在这种状态，不可能好好对话的啊。而且斯诺姐姐因为拉丝缇娅拉姐姐的说服，已经老实了不少哦……？说服的效果好到放着她不管她也能一个人解决自己的烦恼的地步了。</data></node>
    <node id="贝丝心中不属于她自己的东西"><data key="name">贝丝心中不属于她自己的东西</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她这有些羞涩的态度，乍看之下仿佛是因为对年长男性的憧憬。然而，我却有一种确信原因绝非如此的违和感。；这种感觉简直就像在她的心中有着不属于她自己的东西一样</data></node>
    <node id="突发暴雨与条件齐备的可疑（圣诞祭同条件重演）"><data key="name">突发暴雨与条件齐备的可疑（圣诞祭同条件重演）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">仿佛是回应我的愿望一样，冰凉的雨滴落在我的脸颊上。；条件凑齐的如此顺利甚至让人感到害怕。；圣诞祭那天，也是这样的状况。那一天，只有我留到了最后啊</data></node>
    <node id="佩艾希亚=『归途』的终点确信"><data key="name">佩艾希亚=『归途』的终点确信</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我们都确信，『现在』的『佩艾希亚』才是『归途』的终点──</data></node>
    <node id="祖孙光粒消散之可挽回性（回收）"><data key="name">祖孙光粒消散之可挽回性（回收）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">尽管勉强，但我的魔法《次元决战演算『前日谭』》总算是得以将她的魂成功唤回。；与此同时，她牵着雷纳尔多的手，两人一同被光吞没，随后便消失了。</data></node>
    <node id="『千年前的梦』开启(王的追忆)"><data key="name">『千年前的梦』开启(王的追忆)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">对了……那个时候，我遇到了……；为了抵达『千年前的梦』之所在，我在睡魔的引导下沉入了梦乡。</data></node>
    <node id="手环对决与自杀术式"><data key="name">手环对决与自杀术式</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「放心吧。我现在什么都没打算对你做。随便下手的话，如果里面写上了自杀的术式，那我可就困扰了。要取下手环的时候，必须要做好万全的准备……」</data></node>
    <node id="深层空祭坛的'某人'"><data key="name">深层空祭坛的'某人'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">也就是说，现在在这个迷宫深处还存在着某个人。比我们更早地来到33层，从祭坛取走了剑的『某人』——；要说这个『某人』可能是谁的话，首先可能是联合国最强的格连。但是根据昨天的交流，应该不是他。；剩下的就是剑圣芬里尔和『天上的七骑士』队伍了。</data></node>
    <node id="涡波对诺斯菲的直觉禁忌"><data key="name">涡波对诺斯菲的直觉禁忌</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不知道为什么，我就是有种直觉，那就是只有诺斯菲，我绝对不能对她出手。</data></node>
    <node id="复合咒术『咏唱』之代价清偿（后延非免除）"><data key="name">复合咒术『咏唱』之代价清偿（后延非免除）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">其中的『代价』就算我现在无法支付，最后也一定会予以清偿。；但这份『代价』却在『最深部之誓约者』的发动下受到了缓解──足以溶解内心的剧痛被后延了。</data></node>
    <node id="召唤信息之谜"><data key="name">召唤信息之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">——【召唤】欢迎回来，相川涡波——</data></node>
    <node id="最深部奇迹争夺"><data key="name">最深部奇迹争夺</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在那一个月的时间里可能最深部的奇迹就被我夺走了哦？我只用了短短几天就跨越了30层。；就算是在迷宫探索上输给了你，我到最后也不会放弃自己的愿望的。</data></node>
    <node id="缇缇的了无遗憾逝去愿望"><data key="name">缇缇的了无遗憾逝去愿望</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「现在应该还不晚。我们两个一起回去，然后结束这一切吧。那样人家的『留恋』就可以实现了。对自己的人生感到满足，也可以了无遗憾地逝去。肯定是这样」</data></node>
    <node id="『感应』的『来不及』预感与最高难度转换"><data key="name">『感应』的『来不及』预感与最高难度转换</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">如果继续这样做，那就来・不・及・了──我有这样的感觉。；「莱纳，我・们・要・在・这・次・的・迷・宫・探・索・中・直・接・回・到・地・上」</data></node>
    <node id="与艾德及阳滝交战的可能性（强化缇缇之由）"><data key="name">与艾德及阳滝交战的可能性（强化缇缇之由）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">作为BOSS角色的守护者还要强化自己这事儿实在非常离奇，不过对象是缇缇的话倒也无妨；既然接下来有和艾德以及阳滝战斗的可能，那么对她的强化也在情理之中。</data></node>
    <node id="攻击担当轮换之约"><data key="name">攻击担当轮换之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「下次再有机会的话让我来负责攻击吧。这回是为了帮助大家，就先忍忍吧」；「真没办法。──那就等下次好了。下次人家也要像涡涡一样被感谢哦。快来吧，快来个谁袭击过来啊。下次，快点来呀」</data></node>
    <node id="BOSS魔石与锻冶新装备筹备（堪比『新月琉璃』·为塞拉备武器）"><data key="name">BOSS魔石与锻冶新装备筹备（堪比『新月琉璃』·为塞拉备武器）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">最主要的目的还是魔石。BOSS怪物掉落的魔石，比一般的怪物掉落的纯度要高很多。；正好我也学会了『锻冶』技能，正值筹备新装备的时候。能得到上等的魔石的话，说不定也能打造出堪比『新月琉璃』的武器。；我也想尽快为塞拉准备合适的武器。</data></node>
    <node id="十层的空虚感"><data key="name">十层的空虚感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那炽烈而桀骜的火焰，已经再也没机会见到了。</data></node>
    <node id="海莉的死亡预告与留恋"><data key="name">海莉的死亡预告与留恋</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我一定会死去吧。今天，就在这个地方。……但是，那绝非是自暴自弃的死亡。而是为了实现比自己生命还重要的约定而不得不前往战场。所以，让我去吧。这一次，请你务必在我的身后见证这一切。——少年」；「——我现在好想看看啊，看看那·时·候没能看到的少年那帅气的模样。那既是我的留恋，也是我好不容易得到的重要的心愿」；「来吧，我来做你的对手。帕林库洛」</data></node>
    <node id="『维度·决战演算』的深层退役预感"><data key="name">『维度·决战演算』的深层退役预感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『维度・决战演算』。给这个魔法命名的创造者就是我。但是直到游戏通关──抵达迷宫最深部为止，可能都不会再使用到『维度・决战演算』了吧，这让我心中有些不忍。</data></node>
    <node id="诺斯菲留恋实现之因解明（以涡波痛苦为乐）"><data key="name">诺斯菲留恋实现之因解明（以涡波痛苦为乐）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在我拒绝她索求契约之证的时候，她的留恋得到了实现。；而她也借此得知了自己的愿望，所以现在在全力地让我感到困扰。</data></node>
    <node id="业火决战"><data key="name">业火决战</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为只有这样做，才能实现我的悲恋啊……</data></node>
    <node id="『想起』容易的空间"><data key="name">『想起』容易的空间</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在这里的话『想起』是比较容易的</data></node>
    <node id="诺斯菲与『笨蛋骑士』赫勒比勒夏因的过去渊源"><data key="name">诺斯菲与『笨蛋骑士』赫勒比勒夏因的过去渊源</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">你的这些行为老是让我联想起过去的事，拜托你克制一下不行吗？；「呵呵，这剑法真是让人怀念呢。不过，正因为它令人感怀，所以我早已惯于应付了」；「──就连逼急了想出的主意也跟那个笨蛋骑士（赫勒比勒夏因）如出一辙呢。这我也早就习惯了。毕竟我自己都不记得阻止过这种自爆招数多少次了呢。唉⋯⋯」</data></node>
    <node id="魔石人类四少女被削减的『代价』"><data key="name">魔石人类四少女被削减的『代价』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">毫无疑问，有什么重要的东西正被削减着；就好像，削减自己的灵魂一样──！；搞不好的话，恐怕至死为止她们都会持续维持魔法。</data></node>
    <node id="缇亚的过去"><data key="name">缇亚的过去</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在我的故乡，金钱和力量在手的人就能恣意妄为。</data></node>
    <node id="书物『支配之王』第一章『支配之王的觉醒』＝北方历史"><data key="name">书物『支配之王』第一章『支配之王的觉醒』＝北方历史</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──就这样，继续翻动书页，故事的第一章『支配之王的觉醒』便拉开了帷幕。；那既是『支配之王』的英雄谭，也是北方的历史。；是王的物语。</data></node>
    <node id="诺斯菲闻『缇娅拉』变色与『绝不能忘』之谜"><data key="name">诺斯菲闻『缇娅拉』变色与『绝不能忘』之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">听到我的话，诺斯菲的脸色变了。；「──缇・娅・拉」；「不、不记得人家的事情倒是没关系。但是至少、至少也要把诺斯菲的事情记起来啊。你明明记得缇娅拉不是么？</data></node>
    <node id="涡波的诅咒级重负与心灵击溃计划"><data key="name">涡波的诅咒级重负与心灵击溃计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我虽然也背负着相当程度的这些东西，但是对方背负的已经称得上是诅咒了。；如果知晓了一切，就算是『英雄』，他的内心也无法承受。；虽然堂堂正正地交战我赢不了，但是足以击垮你心灵的负债可谓无穷无尽。</data></node>
    <node id="帕林库洛追迹与精神魔法警告"><data key="name">帕林库洛追迹与精神魔法警告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">今天最重要的目的是找到帕林库洛的所在。要带她出去的话，等到确定会跟帕林库洛交战那时候就好。；「——所以说，帕林库洛他是绝对不会堂堂正正地战斗的哦。他绝对不会让涡波以万全的状态战斗的，绝对会玩弄什么手段对你释放精神魔法的。肯定没错。」；「需要注意的也就是缇达的魔法了。但是他的魔法我已经见识过了，只要不让黑色液体溅在身上就没问题。」</data></node>
    <node id="魔力物质化的记忆残留"><data key="name">魔力物质化的记忆残留</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「诶？嗯，我好像是知道……咦？我是在哪里知道的来着。那个……」</data></node>
    <node id="格连脑中的声音"><data key="name">格连脑中的声音</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，我对使徒大人的事也很在意⋯⋯而且最近开始听到声音了啊。在我脑袋里一直有说话的声音、喋喋不休地⋯⋯」</data></node>
    <node id="涡波千年前身份之谜（团长·南方的骑士·第二个救世主）"><data key="name">涡波千年前身份之谜（团长·南方的骑士·第二个救世主）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「从你那得到的力量没想到会以这种形式还给你。真是万分悲痛。」；为了避免杀戮我将剑收回了剑鞘。不管怎么说，说服他们的胜算还是有的。听他们说话的口气，应该是我以前的旧识。；「我们曾经那样相信你。我们一直以为、你是我们第二个『救世主』⋯⋯可是，为什么⋯⋯」</data></node>
    <node id="玛利亚狂化之谜"><data key="name">玛利亚狂化之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">难道说制造出这种情况的犯人的目的，就是为了妨碍我救出拉丝缇娅拉吗？</data></node>
    <node id="诺斯菲任性条件的逻辑死循环(其真实意图)"><data key="name">诺斯菲任性条件的逻辑死循环(其真实意图)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">直到罗德停止哭泣，真正恢复笑容为止，这里都是禁止通行的呀。；——我只能认为诺斯菲根本没有想让我实现她的任性的意思。</data></node>
    <node id="阿尔缇的恋爱愿望"><data key="name">阿尔缇的恋爱愿望</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——我想要成就一段恋爱。」</data></node>
    <node id="莱纳的守护之誓（归来之前片刻不离）"><data key="name">莱纳的守护之誓（归来之前片刻不离）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我向你发誓绝对会在你回来之前守护好拉丝缇娅拉；「明白。既然被基督拜托了拉丝缇娅拉的问题，那我接下来可得片刻不离啊」</data></node>
    <node id="帕林库洛的『复活相川阳滝』宣言"><data key="name">帕林库洛的『复活相川阳滝』宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哈哈。你这是什么表情。我可是说了接下来要帮你复活相川阳滝了哦？」；他要做的事本质上就相当于为我在异世界的所有战斗画上句号。</data></node>
    <node id="阳滝=西斯的'亲友'之谜"><data key="name">阳滝=西斯的'亲友'之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哼嗯～，这就是你的全力？⋯⋯真是变得有意思起来了呢，盟友。啊哈哈，『这样下去』的话，感觉久违地还能看到作为亲友的『阳滝』的脸呢，令我也甚是期待哦！」；「你说久违⋯⋯？这个世界上根本没有人认识『阳滝』！」</data></node>
    <node id="斐勒卢托未用的手牌与真实恨意"><data key="name">斐勒卢托未用的手牌与真实恨意</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">──这个人，大概对我恨之入骨。；我的手牌还没有用完；「──斐・勒・卢・托。」</data></node>
    <node id="罗德的『真正的愿望』与视线错位"><data key="name">罗德的『真正的愿望』与视线错位</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，一路走好。另外，非常感谢你，涡・波⋯⋯拜你所赐，人家真正的愿望似乎终于能够实现了呐⋯⋯」；尽管没有失败，但也不算成功──我不禁这样想道。；罗德的眼中虽然闪出了希望的光辉，但她看的根本不是我。</data></node>
    <node id="涡波的『最喜欢的人』答案"><data key="name">涡波的『最喜欢的人』答案</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">接着，我所思考出的答案是——；明确地展示出相川涡波喜欢着某个人。；根据影视剧和游戏的经验来看，有人幸福就意味着有人流泪。</data></node>
    <node id="涡波对技能『？？？』消除对象的隐瞒"><data key="name">涡波对技能『？？？』消除对象的隐瞒</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">顺道一说，仅仅在技能『？？？』的问题是我有所保留。为了大事化小，我只说明它会将一部分感情消除而已。；至于被消除的是对谁的感情我没有说。说了的话，就会让昨天的事情变得更复杂的。；虽说这是无奈之举，但是心里还是过意不去。明明发誓要信赖同伴，却无法完全实践。</data></node>
    <node id="缇亚的精神剧变"><data key="name">缇亚的精神剧变</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">缇亚的眼中没了光芒。</data></node>
    <node id="拉丝缇娅拉拒绝告白的真意"><data key="name">拉丝缇娅拉拒绝告白的真意</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她的嘴角仿佛是因为喜悦而上扬，两道柳眉却似乎是因为悲伤而皱紧。；「──但是，我・却・讨・厌・相・川・涡・波・啊」；「我可没有说谎哦。我讨厌在那一天将我们丢下的涡波。我这话有什么奇怪的吗？」</data></node>
    <node id="阿雷亚斯家的宝剑的未试新能力（魔法属性追加）"><data key="name">阿雷亚斯家的宝剑的未试新能力（魔法属性追加）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">虽然还没有尝试过，但是这把剑似乎还能增加一种使用魔法的属性。在这个世界中能够增加自身属性的情况可不寻常。从这一点看来，这把剑是相当犯规的道具。</data></node>
    <node id="民众魔石升空与再现可能"><data key="name">民众魔石升空与再现可能</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">只要有魔石的话，『这里』的民众就能够再现。；这些残留的魔石全都轻飘飘地升上了空中；还有就是在远处已经死去的民众的魂所化成的群星。</data></node>
    <node id="『次元之理』完全掌握与次元魔术真髓"><data key="name">『次元之理』完全掌握与次元魔术真髓</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是严格来讲并不是那样。次元魔术的真髓应该是别的什么东西。；作为『次元之理的盗窃者』的我，本能地理解到这一点。现在的我还不能自如地操纵『次元之理』，仅仅感知到四个次元就已经是极限了。</data></node>
    <node id="诺文的约定与名字反应"><data key="name">诺文的约定与名字反应</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「——对，没错。我是守护者。这一点我是明白的。唯有这点是不会错的。可是、可是那个时候、那家伙跟我约好了——，然后、然后——！！」；「你、你说你叫相川涡波！？」</data></node>
    <node id="莱纳的六十九层攻略指示"><data key="name">莱纳的六十九层攻略指示</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我个人推荐两人先攻略到六十九层，然后再正式前往本土──</data></node>
    <node id="缇达魔石（黑剑）遗落战场"><data key="name">缇达魔石（黑剑）遗落战场</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">只有帕林库洛的黑剑被挑飞，在白色的日轮中舞动。；需要回收的不光是他们两人。可能的话在远处的缇达的魔石也要回收。</data></node>
    <node id="罗德恢复精神之约（明早执行）"><data key="name">罗德恢复精神之约（明早执行）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「这种程度的话没问题的。我肯定会让罗德恢复精神，让她跟你和好」；在我剩下的人生中，就让我一点一点、一点一点地任性过活吧；明天，我要去实现诺斯菲的请求，让罗德打起精神──立下决意之后，我又一次沉入黑暗中。</data></node>
    <node id="亲和的血缘条件不足"><data key="name">亲和的血缘条件不足</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就把得知只有血缘的联系还不够这点当做此次的收获好了</data></node>
    <node id="斯诺的身体将变得和『理的盗窃者』相近的警告"><data key="name">斯诺的身体将变得和『理的盗窃者』相近的警告</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「斯诺啊。以后还是不要过度依仗自己天生的力量战斗为好。要善待你的身体。为了抑制魔之毒在你体内的流转，注意多用剑技去战斗吧。不然的话，总有一天你的身体会变得和『理的盗窃者』相近的」</data></node>
    <node id="风的所有者身份之谜"><data key="name">风的所有者身份之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这是一道从右侧远远吹来的强风──同时还伴以柔和的光芒。；这道风不属于罗德。这光也不属于诺斯菲。；当然，它也不属于莱纳。</data></node>
    <node id="宝石处理之途：赴联合国/『史诗探索者』本部（近期钩）"><data key="name">宝石处理之途：赴联合国/『史诗探索者』本部（近期钩）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">但是欧尼酱、这么多的水晶和黄金，你打算怎么办呢？；所以我打算去找人商量下。你要一起来吗？；就算拿到换钱的地方，这些也超过了个人交易的资金范畴了。</data></node>
    <node id="六十层不知底细的守护者（千年前猛者推定）"><data key="name">六十层不知底细的守护者（千年前猛者推定）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「谨记在心。在六十层还有不知底细的守护者。我想在那里，一定也驻守着千年前的某位猛者」</data></node>
    <node id="40层守护者与海莉队的进度竞争"><data key="name">40层守护者与海莉队的进度竞争</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「看来果然是海莉已经将守护者唤醒了呢」；——说到底，在我们相遇的那一天，海莉很可能就已经抵达39层了。；这片大草原的主人，必须由我来迎接才行。最初聆听其愿望的人，应该是我才对。</data></node>
    <node id="西娅夺还（贩奴船追击开环）"><data key="name">西娅夺还（贩奴船追击开环）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在治安看上去就很差的港口的一角。许许多多被绑架的人正在一看就是黑恶势力的男人群体的威逼下被带到船上。；「啊，已经出港了」</data></node>
    <node id="拉丝缇娅拉的笼中出身"><data key="name">拉丝缇娅拉的笼中出身</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「我快无聊死了啊。自打我诞生以来就一直待在笼中。</data></node>
    <node id="诺斯菲的密藏手牌"><data key="name">诺斯菲的密藏手牌</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「可是，要是使用了『光之理的盗窃者』的『诅咒』的话，那就无法证明我对涡波大人的思慕了。所以绝对不可以。但是使用光之『咏唱』也不行，那样我好不容易才削减的良心又会恢复的。变成『半死体』就更不用说了。但是话是这么说，我也不能在这里打出密藏的手牌。⋯⋯啊啊，这实在是──」</data></node>
    <node id="『同死神相伴的魔女』的身份与去向"><data key="name">『同死神相伴的魔女』的身份与去向</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在斯诺也确认过后，我算是断定『同死神相伴的魔女』的身份了。；而我也借此看到了这座『大洞』被赤红浸染的始末──</data></node>
    <node id="莉帕的决赛恳求(无法实现的愿望)"><data key="name">莉帕的决赛恳求(无法实现的愿望)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「也是啊……我要翻盘的话也只能那样了呢……除了恳求诺文之外已经别无他法了。我要求他不要消失……真心诚意地……」</data></node>
    <node id="诺斯菲的真正魔法（代表全部人生·疑即死）"><data key="name">诺斯菲的真正魔法（代表全部人生·疑即死）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">诺斯菲还有代表她全部人生的真正魔法没有使出来。而且那很可能是无法回避的即死魔法。</data></node>
    <node id="守护者遭遇"><data key="name">守护者遭遇</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那可是聚集了联合国最强的探索者也没能击败的怪物啊。</data></node>
    <node id="缇亚唤回战与玛利亚之约"><data key="name">缇亚唤回战与玛利亚之约</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「……我明白的。到了那个时候，我会动手的。我向你保证。」；玛利亚的声音更容易传达给缇亚吧。；比方来说，随着时间的经过，缇亚的人格有可能会渐渐被使徒西斯侵蚀。</data></node>
    <node id="未知之风与莱纳力量的真正源泉"><data key="name">未知之风与莱纳力量的真正源泉</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这道风在我和诺斯菲之间拂过，摇动我的前发。；那既不是罗德的风，当然也不是我的风。肯定也不会是诺斯菲的。；但是，我却熟悉这道风的触感。</data></node>
    <node id="『感应』守护者接触前兆警报（五十七层）"><data key="name">『感应』守护者接触前兆警报（五十七层）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">随着口角越来越激烈，罗德与诺斯菲之间的距离也越来越近。接着，两人终于来到了距彼此触手可及的位置，并向对方伸出手。；技能『感应』就在这时突然发动。；这道警告就像闪电劈过天灵盖一样震悚。</data></node>
    <node id="莱纳身体未异变之谜"><data key="name">莱纳身体未异变之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">明明如此，但我的身体并没有什么异常之处。；其实我觉得另有原因，但因为缺乏根据所以姑且用诺文敷衍过去好了。</data></node>
    <node id="缇亚与拉丝缇娅拉的旧识"><data key="name">缇亚与拉丝缇娅拉的旧识</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「只、只是同乡而已！其实也不是那么熟啦！」</data></node>
    <node id="守护者封印解放机制"><data key="name">守护者封印解放机制</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">因为每过十层就会有一个人被解放出来。所以到现在只有我们两个而已。」</data></node>
    <node id="罗德的本名（『我的名字叫⋯⋯──』截断未揭）"><data key="name">罗德的本名（『我的名字叫⋯⋯──』截断未揭）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我的名字叫⋯⋯──；我的我的、我的名字才不叫什么『支配之王（Lord）』！</data></node>
    <node id="祖孙光粒消散之可挽回性（『应该还──』）"><data key="name">祖孙光粒消散之可挽回性（『应该还──』）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">没有『魔石』仅仅只有光粒。；与原本就是活人的海莉不一样，现在尚存一丝可能性。如果是当下这极其特殊的环境的话，说不定做得到。；虽然只是我的猜测，但雷纳尔多和贝丝现在、应・该・还──</data></node>
    <node id="战后余裕与力量用途之问（含援助之约）"><data key="name">战后余裕与力量用途之问（含援助之约）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">可总有一天，如果我能帮到他们的话⋯⋯──；我不由地考虑起了救回妹妹和同伴之后的事。；用寄宿于自己体内的这份力量，我究竟该以什么为目标呢。</data></node>
    <node id="本土靠岸倒计时"><data key="name">本土靠岸倒计时</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">航行的进程也差不多要抵达本土了。快的话大概明天或者后天就能靠岸了吧。</data></node>
    <node id="罗德只属于一人的家人与最重要的宝物"><data key="name">罗德只属于一人的家人与最重要的宝物</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「罗德，跟我一起去看！去看你的过去！你肯定有只属于你一个人的家人！给我好好回想起来！就是因为你还有珍视的家人存在，你的留恋才寄存在家人的身上，你就是依靠这份留恋一直活到今天的！那就跟我一起，去过去找到你最重要的宝物！这就是拯救你的真正的『道路』──！！」；而且不知为何──我就是能知道，这个魔法还不完善。这个魔法本来应该是以共鸣魔法的形式使用的──是与最重要的人一起共同使用的魔法，但现在却缺失了那最重要的部分。；「道、『道路』──！？孤重要的宝物──！？」</data></node>
    <node id="『异邦人』与『素体』的说法冲突（一方说谎）"><data key="name">『异邦人』与『素体』的说法冲突（一方说谎）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">也就是说，有一方是在说谎？；「等，等等。在哪里不是写着『异邦人』吗⋯⋯？」；─────拉丝缇娅拉这么说的。</data></node>
    <node id="拉丝缇娅拉的人情宣言"><data key="name">拉丝缇娅拉的人情宣言</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不用啦，反正总有一天会让你还我这个人情的。」</data></node>
    <node id="缇亚与使徒西斯的重叠疑云"><data key="name">缇亚与使徒西斯的重叠疑云</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「啊啊，西斯大人！看您的样貌果然是西斯大人啊！！」；「『我（私）』——不对，不是这样的。对不起，基·督——」；我过去也听过这样的呓语。那是在迷宫第五层与缇达交战后，背着缇亚回去的路上，也听过一样的话。</data></node>
    <node id="章末钩：掏出『阿雷亚斯家的宝剑诺文』"><data key="name">章末钩：掏出『阿雷亚斯家的宝剑诺文』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">呐～，涡波。还有什么别的要特训的咩？；让我想想，还有什么呢⋯⋯；利用『并列思考』得到的结论，促使我掏出『阿雷亚斯家的宝剑诺文』</data></node>
    <node id="诺斯菲的留恋之谜"><data key="name">诺斯菲的留恋之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">若能得到涡波大人的抚摸，那我便能消失了吧。是啊，我的愿望真的仅此而已」；「⋯⋯没、没有消失诶？」；「非常感谢⋯⋯⋯不过，这似乎也不是我的留恋呢⋯⋯」</data></node>
    <node id="帕林库洛的三十层守护者交易"><data key="name">帕林库洛的三十层守护者交易</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「如果你打倒了三十层的守护者，我就告诉你。『基督』的事情、还有你今天遇到的少女们的事情，全都告诉你。——这就是交换条件了。</data></node>
    <node id="缇缇『没多少时间了』的暗示"><data key="name">缇缇『没多少时间了』的暗示</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「呼。接下来也没多少时间了，是时候收手了呢。好吧──」；「呼～。哎呀，涡涡的杰作没有浪费掉真是太好了太好了～。⋯⋯不过，既然人家没有成为勇者的天赋的话，那人家到底该做什么好呢？虽然就算这个问题得不到答案人家应该也能消失，但还是想知道啊」</data></node>
    <node id="'因成功而悲伤'的失言与再诞真相"><data key="name">'因成功而悲伤'的失言与再诞真相</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">我那时候是因为成功了才感到悲伤；「你看！你到底在说什么！？为什么成功了却会让你感到悲伤呢！！」</data></node>
    <node id="妹妹的真名（玛利亚=相川阳滝）"><data key="name">妹妹的真名（玛利亚=相川阳滝）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯——对了，优先度就设定为跟『妹妹相川阳滝』同等好了。那样就可以放心了。」</data></node>
    <node id="世界奉还阵再起动与涡波终局魔法（未完）"><data key="name">世界奉还阵再起动与涡波终局魔法（未完）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">『呜呼，森罗万物，皆已不复可还』──！；这意味着为了启动『世界奉还阵』，帕林库洛再次舍弃了防御。；而且、还是以帕林库洛为对象──</data></node>
    <node id="六十五层以深的再挑战（风龙障碍清除后）"><data key="name">六十五层以深的再挑战（风龙障碍清除后）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">位于平原中央的螺旋阶梯遭到破壊，无法登上六十五层。；再往前的探索应该跟莱纳一起进行。两个人合力的话，跟艾尔芬里斯战斗也能节约不少魔力，而且我也想先将自己的LevelUP处理好。；呜、嗯─。嘛啊，人家也知道迷宫探索是你们两个的本业就是了⋯⋯⋯没办法呢。那莱纳明天就跟着去吧⋯⋯⋯嘛，反正你们肯定又得败在艾尔芬里斯酱手下就是了</data></node>
    <node id="船上死亡包围网"><data key="name">船上死亡包围网</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">整艘船就会成为没有保险的火药库——到那时候，只要一眨眼，这艘船就会沉入汪洋。；技能『并列思考』，告诉我说「这样下去的话你小子就死定了」。；无论是谁，都不会接受大哥哥与别人在一起的事实的。毫无疑问。</data></node>
    <node id="佩艾希亚崩壊倒计时（约一个月）"><data key="name">佩艾希亚崩壊倒计时（约一个月）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「是的，她说时间还剩一个月左右。难道说您心里已经有数了吗？」</data></node>
    <node id="作用全空间的涡波色魔力干涉"><data key="name">作用全空间的涡波色魔力干涉</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「啊啊真是的、太・奇・怪・了。这万中唯一的胜机，怎么就被你抓住了⋯⋯，这实在是太・奇・怪・了呀⋯⋯！！」；可是这属性的颜色，并非是赫勒比勒夏因而是涡波大人？；竟然连我都无法察觉，这究竟是怎样的魔法⋯⋯？</data></node>
    <node id="涡波的服装行业适性"><data key="name">涡波的服装行业适性</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯─，会长这人颇有匠人气质，所以比较适合开服装店或者木工之类的。而且会长以前就跟咱说过想从事跟服装有关的行业来着呢。讲道理，咱觉得会长应该是跟咱同种类型的幕后工作者」；确实，如果没有妹妹的病和异世界等等问题，那么我真有可能会投身于这个行业。</data></node>
    <node id="始祖缇娅拉的异界联系说"><data key="name">始祖缇娅拉的异界联系说</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「说不定，莱文教的始祖缇娅拉就跟异世界有某种联系呢。就像现在的我与涡波一样。」</data></node>
    <node id="诺斯菲的『预定』与其不可测真意"><data key="name">诺斯菲的『预定』与其不可测真意</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「正如预定，是那个时候的涡波大人的姿态呢。而且，在那具身体里，是这个身体⋯⋯──终于，这样就可以证明了呢。我究竟有多么渴望这一刻⋯⋯」；「不过，涡波大人究竟缘何才失去了记忆呢？根据早先的话来看应该一切都进展顺利才是啊⋯⋯」；看上去她对我丧失记忆这件事并没有受到太大的冲击。而且对自己没有消失这件事也没有表现出过多的惊讶。</data></node>
    <node id="船旅死亡预告：姐姐们比帕林库洛更危险"><data key="name">船旅死亡预告：姐姐们比帕林库洛更危险</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">小心点哦，欧尼酱。说实话，接下来的旅程中，你要随时与死亡相伴了。既不是因为帕林库洛也不是因为怪物，而是因为姐姐们的关系，有无数的危险等着你！；欧尼酱。你绝对不能说自己喜欢谁呀或者讨厌谁哦。现在，就连小孩子都能看得出来，一旦现在的平衡崩溃的话，会发生很不得了的事情的哦？</data></node>
    <node id="诺瓦露的『代价』与超常恢复力之谜"><data key="name">诺瓦露的『代价』与超常恢复力之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">她究竟失去了什么作为『代价』？；「⋯⋯不、不要小看我在这个状态下的恢复能力和生命力！不枉我为此牺牲了人性！」</data></node>
    <node id="罗德的藏书室调查（内容不明）"><data key="name">罗德的藏书室调查（内容不明）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「哦～，涡涡。你手里拿的不是魔导书嘛。真亏你能在那乱七八糟的藏书室里找到啊～」；「不是哟，是人家去调查了一番之后才变成那样滴！反正再也不会去第二次了！」；让她内心呐喊着不想回忆起来的『过去』的某种东西⋯⋯⋯</data></node>
    <node id="罗德的迷恋凶化与理解者联络"><data key="name">罗德的迷恋凶化与理解者联络</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「恩，呜呜呜嗯嗯⋯⋯⋯不妙啊。攻略迷宫比预想当中的简单啊。这样下去的话⋯⋯⋯──」；罗德就像耍脾气的小孩子一样，但是她身上所缠绕的魔力却十分的凶恶。感觉每当我们越接近地上，这股魔力就越发的浓烈。；为了罗德的迷恋去到地上也是必要事项。不赶快和她的理解者联系的话她身上的魔力应该会不断膨胀吧。</data></node>
    <node id="帕林库洛的『留恋』与个人计划"><data key="name">帕林库洛的『留恋』与个人计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">而是更加自私自利的我个人的计划。；一切早都已经结束了。而我面前的人，也不过是一具迟早要死的尸体。；这场战斗结束的话，那份『留恋』也能够实现了吧。</data></node>
    <node id="魔石船LivingLegend号的爆炸隐患(周回二度)"><data key="name">魔石船LivingLegend号的爆炸隐患(周回二度)</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">尽管如此，还是比通常的船有着更容易爆炸的危险性。虽说是高价的魔石，但不仅只提供便利。与便利成比例的内包着危险。；再加上，要在这魔石制的船上乘上蒂娅、拉丝缇娅拉、玛利亚、斯诺，这四个人肉炸弹娘，实在是让人无法安心。；我想起了当初那完全烧毁的可怜高级住宅。</data></node>
    <node id="海莉的同型之谜：『所有物』持有与涡波多重同型"><data key="name">海莉的同型之谜：『所有物』持有与涡波多重同型</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「──这丫头，连『所有物』都有！」；少女释放出的柔和之风，跟我的『次元之冬』非常相似。</data></node>
    <node id="候补之谜"><data key="name">候补之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「你可是我很重要的『候补』啊</data></node>
    <node id="芙兰琉莱的恋慕"><data key="name">芙兰琉莱的恋慕</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">看样子那孩子可是迷上你了哦。」</data></node>
    <node id="诺斯菲的迷恋反效果膨胀（地上寻找解法）"><data key="name">诺斯菲的迷恋反效果膨胀（地上寻找解法）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">只是，理解到这时就连诺斯菲也不能大意的存在。与罗德一样，昨天开始凶恶的魔力就开始不断膨胀着。虽然尝试了许多方法消除迷恋，但，好像反而产生了反效果。；与诺斯菲也相处了一段时间了。不是应该从闭锁的地下而是该从能做许多事的地上寻找她的迷恋。</data></node>
    <node id="涡波起源'答案'临近（『表示』·初始魔法·素质优待）"><data key="name">涡波起源'答案'临近（『表示』·初始魔法·素质优待）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「但是连物品上有『诅咒』都能看出来，涡波的物品鉴定能力真是方便啊。其他的能力还能用次元魔术解释解释，但是只有这个到底怎么回事还是想不明白啊。到底是怎么构筑的魔法呢⋯⋯」；为什么我会拥有像『表示』这样便利的东西呢。一开始就会冻结魔法和次元魔术，素质也是颇受优待。；只是，这即将得出的答案，未免太──</data></node>
    <node id="夺回阳滝与地上一切（涡波·莱纳共识）"><data key="name">夺回阳滝与地上一切（涡波·莱纳共识）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「嗯，没错。尽快回到地上，夺回属于自己的一切。这一点我也赞同。」；但一直这样下去可不行，守护阳滝是我的使命。</data></node>
    <node id="帕林库洛的我主心仪之人"><data key="name">帕林库洛的我主心仪之人</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「因为听说你是我主心仪之人。所以我就抢着来看看你。」</data></node>
    <node id="涡波与罗德的再会之约（ch169）"><data key="name">涡波与罗德的再会之约（ch169）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「那么，等我在地上把事情都办完了，我会再过来的。到时候我们再一起玩吧。」；「嗯！我们约好了哦！」</data></node>
    <node id="『感应』×『最深部之誓约者』非战斗场景同时警报"><data key="name">『感应』×『最深部之誓约者』非战斗场景同时警报</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">你要问为什么，那是因为按理来说只有在我快死翘翘的时候才最为活跃的技能们──『感应』和『最深部之誓约者』居然同时发动了诶。；我从挚友和始祖那儿得到的最强的这两个技能，没有在与凶恶的怪物们战斗的迷宫攻略的时候发动，反倒是在这时候鸣响了史无前例的警报声。；只有一个啊──虽然如此，但是要理解其意义实在是过于恐怖，以至于我只能傻站在原地动弹不得⋯⋯</data></node>
    <node id="双守护者会聚成障碍的预兆（ch184开环推进）"><data key="name">双守护者会聚成障碍的预兆（ch184开环推进）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">尽管诺斯菲脸上挂着清灵的笑容，但是她的真心依旧不明。；不安像薄膜一样笼罩在心头──罗德和诺斯菲聚在一起成为障碍的可能性──我感觉到了其演变为现实的预兆。</data></node>
    <node id="世界奉还阵发动迫近（主战场中军）"><data key="name">世界奉还阵发动迫近（主战场中军）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在离开之前帕林库洛曾说过要去发动魔法阵的中心位置。；他恐怕是打算在战场的中心货真价实地发动『世界奉还阵』吧。；在知道了帕林库洛的『世界奉还阵』的危险性的现在，一秒也不能浪费。</data></node>
    <node id="拉丝缇娅拉的心意暴走（'这不对'）"><data key="name">拉丝缇娅拉的心意暴走（'这不对'）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不对……，这不对……！这样不行……！；但是，拉丝缇娅拉却挥开了我的手，拒绝了接触。；而且怕是不会有比这还出色的成果了。但是，成果在体内作用过剩也是事实。</data></node>
    <node id="涡波身体的女性化风险（魂与身体性状）"><data key="name">涡波身体的女性化风险（魂与身体性状）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不知不觉间感觉你身上女性的氛围越来越浓了啊；一旦我的『魂』本身也对女性身体予以了认可的话，那『身体』的性状向那边进行变化的可能性也不是没有。</data></node>
    <node id="海莉与海因的关联之谜（名字一字差·说辞既视感）"><data key="name">海莉与海因的关联之谜（名字一字差·说辞既视感）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">伴随着不知曾在哪儿听过的说辞，少女完成了魔法的构筑。；少女跟对我有大恩的海因很像。所以我不能弃她不顾。至少在了解她们之间的关系之前，绝不能让她死掉。我是这样想的。</data></node>
    <node id="世界奉还阵失控与『最后的声音』"><data key="name">世界奉还阵失控与『最后的声音』</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">即使这样帕林库洛也没有摆出打算停止『世界奉还阵』的样子。看来他那自己也停止不了的说辞并不是谎言。；最后总觉得听到了什么人的声音。</data></node>
    <node id="假扮基督君者出没"><data key="name">假扮基督君者出没</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">毕竟最近有不少假扮你的人出没呢；那可是联合国『舞闘大会』的优胜者啊。</data></node>
    <node id="『咏唱』之『代价』的真内容"><data key="name">『咏唱』之『代价』的真内容</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「不可。如果使用了那个支付『代价』的『咏唱』，你们是会丧失重要的东西的。；──那个技术要求的『代价』并非魔力和体力，而是更为重要的事物。</data></node>
    <node id="全员滞留一万年计划与罗德真意"><data key="name">全员滞留一万年计划与罗德真意</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">这是罗德和我一起考虑出来的令人满意的主意！！」；只不过，距罗德完全消失为止，可能需要一千年──不对需要一万年就是了！！」；罗德现在十分痛苦。罗德现在十分迷茫。罗德现在正在哭泣。</data></node>
    <node id="涡波秘藏的『犯规的魔法』（最高级次元魔术·代价沉重·仅用过一次）"><data key="name">涡波秘藏的『犯规的魔法』（最高级次元魔术·代价沉重·仅用过一次）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">在那场战斗的最后⋯⋯，我用那个犯规的魔法⋯⋯──；那是在我现在能使用的次元魔术中最高级的魔法。；而且与帕林库洛的战斗是我唯一一次使用⋯⋯，不敢保证第二次也能顺利发动。</data></node>
    <node id="千年前的南方之谜"><data key="name">千年前的南方之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「⋯⋯不，人家也不知道。千年前的『南方』到底发生了什么，在『北方』的人家不可能知晓。而且就连在最后和诺斯菲一对一的时候，彼此之间也没能好好谈上几句话。」</data></node>
    <node id="次元魔法大陆覆盖追踪计划"><data key="name">次元魔法大陆覆盖追踪计划</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「别以为你逃得了，西斯！我现在的『Dimension』就算覆盖整个大陆都不在话下！！」；追查她的办法已经在我的记忆中学到了。就跟那个最后陷入疯狂的男人一样，只要把我的次元魔法覆盖到整个大陆上就好了。；我用『Dimension』将瓦尔德本土北部平原全部覆盖住。</data></node>
    <node id="异世界同行名单（赛鲁多拉+斯诺）与危险物品入境预感"><data key="name">异世界同行名单（赛鲁多拉+斯诺）与危险物品入境预感</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「好啊，当然没关系。等我带赛鲁多拉过去的话就把斯诺也带上」；怎么说呢，总觉得自己刚才好像许下了一个非常悖道逆理的约定、就仿佛会遭到我的世界的所有生物的怨恨一样⋯⋯有种莫名其妙的感觉。就好像把斯诺带到我的世界等于是携带一个非常不得了的危险物品入境那样──</data></node>
    <node id="玛利亚・■■■■■"><data key="name">玛利亚・■■■■■</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">那熊熊燃烧着的，正·是·我·的·家。</data></node>
    <node id="异邦人技能之谜"><data key="name">异邦人技能之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「那个『异邦人』技能，在我看来却是『？？？』啊。</data></node>
    <node id="帕林库洛（勒伽西）的意图与诱敌"><data key="name">帕林库洛（勒伽西）的意图与诱敌</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">本以为是想妨碍弗茨亚茨，结果又在劳拉维亚的『史诗探索者』里打造英雄。；「在我看来，这可能不是帕林库洛而是那个名为勒伽西的存在的意志」；不够，这么凑巧的状况，给人一种对方故意引诱我们的感觉。</data></node>
    <node id="莱文教关系者的违和（注视/持有物品）"><data key="name">莱文教关系者的违和（注视/持有物品）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">然而不知为何，欲言又止的拉丝缇娅拉的脸色很差。仔细一看，身旁的缇亚也一样。；让人在意的，不如说是固有技能那边吧。底细不明的技能『？？？』还有技能『异邦人』这两个。</data></node>
    <node id="拉丝缇娅拉回归弗茨亚茨协作之谜"><data key="name">拉丝缇娅拉回归弗茨亚茨协作之谜</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">就是拉丝缇娅拉重新回到了弗茨亚茨，甚至与之协作共事这点。；这中间到底发生了什么⋯⋯？</data></node>
    <node id="技能『？？？』的真名与真正使命"><data key="name">技能『？？？』的真名与真正使命</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「新技能的准备也已经完成了。在两个『魔石』的力量下打造出的技能可是相当强力的。虽说名字还没想好就是了」；混乱减少1.00──；这个技能的名字就是──！</data></node>
    <node id="莉帕的'规则'"><data key="name">莉帕的'规则'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「真，真的不好意思。不过不行啊。因为这是我的规·则来的。……已经不早了，你也回家吧。」</data></node>
    <node id="胜利者报酬的回收未竟"><data key="name">胜利者报酬的回收未竟</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">「得赶紧带上阳滝和莱纳⋯⋯、离开这里才行⋯⋯」；需要回收的不光是她们两人。可能的话在远处的缇达的魔石也要回收。；我跟刚才的帕林库洛一样在地面上爬行起来。</data></node>
    <node id="古奈尔的「万一」委托"><data key="name">古奈尔的「万一」委托</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">不过这份威光很快就消失得无影无踪，古奈尔一边揉着我的肩膀一边拜托道「如果有个什么万一，魔王大人的事就拜托会长帮忙了！」</data></node>
    <node id="绘画保管室毁画者之谜与'真笑容到庭师为止'"><data key="name">绘画保管室毁画者之谜与'真笑容到庭师为止'</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">以这些绘画的方式呈现出的物语，到这幅『城内的庭师』为止便结束了。；不知为何，我觉得罗德真正的笑容，恐怕也就到那里为止了。；「毁掉这里的绘画的是罗德吗⋯⋯？还是说，本来就已经被毁了⋯⋯？」</data></node>
    <node id="本土行前时间紧迫（锻冶窗口关闭）"><data key="name">本土行前时间紧迫（锻冶窗口关闭）</data><data key="type">foreshadow</data><data key="status">provisional</data><data key="desc">想必去了本土之后就不会再像今天这样有时间锻冶了吧。；「毕竟时间紧迫」</data></node>
    <node id="佩艾希亚城"><data key="name">佩艾希亚城</data><data key="type">地点(城市)</data><data key="status">provisional</data><data key="desc">「没错，就是『佩艾希亚城』」；「这两个都是正式名字。无须在意」</data></node>
    <node id="天剑『诺亚』"><data key="name">天剑『诺亚』</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">原因是她的爱剑、天剑『诺亚』留在了大圣堂那边。；她的爱剑、天剑『诺亚』现在在大圣堂里</data></node>
    <node id="『启蒙家的再调律』"><data key="name">『启蒙家的再调律』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">魔法『启蒙家的再调律』</data></node>
    <node id="始祖与魔王的魔剑BraveFluorite"><data key="name">始祖与魔王的魔剑BraveFluorite</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">造就出这一全新的斯诺后，缇缇还把自己的『始祖与魔王的魔剑BraveFluorite』也递了出去。；「不用担心，正好你身边就有剑术的达人。而且这里还有适合你使用的剑。这可是传说中的勇者的剑（预定）哦。超强的哟～」</data></node>
    <node id="莉帕的感情与知识来源"><data key="name">莉帕的感情与知识来源</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莉帕自述：自己的感情经由大哥哥（涡波）的记忆和感情培育而成（『所以我跟大哥哥大概看法一致』）；知识经由与劳拉维亚国民的联结获取（含『后宫』『花花公子』等词汇——非特定人教授）；毕竟我跟劳拉维亚的国民都有联结嘛。入手了各式各样的知识；「我的感情可都是经由大哥哥的记忆和感情培育出来的呢~。所以我跟大哥哥大概看法一致吧？即使如此，还是要我说出来吗？」</data></node>
    <node id="『Torsion（捩菖蒲）』"><data key="name">『Torsion（捩菖蒲）』</data><data key="type">魔法(攻击)</data><data key="status">provisional</data><data key="desc">「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『DistanceMute（幻之紫腕）』恐怕全都是最高位的魔法。──分别是『无法被干涉的攻击魔法』『无法被闪避的空间魔法』『无法被防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余」；「在跟帕林库洛战斗时，我见识到了『始祖涡波』的三种魔法。如果我也能使用那些魔法的话，就肯定能战胜『艾尔芬里斯』」</data></node>
    <node id="咒术"><data key="name">咒术</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波过去的技能（技能值5.33）：涡波自认不仅是次元魔术的专家更是咒术的专家（据涡波自述系罗德不久前使其想起）；在对这一事实予以正确认可的瞬间，『表示』技能栏追加上了过去的技能『咒术』；此后以『诅咒』形态行使『连接』『维度』；我不仅是次元魔术的专家，更是咒术的专家──！；后天技能：体术1.56次元魔术5.33＋0.40魔法战斗0.79咒・术5.33；在我对这件事予以正确认可的瞬间，『表示』的技能栏里边追加上了过去的技能『咒术』</data></node>
    <node id="《冻结》"><data key="name">《冻结》</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">冰结魔法：冻结1.00寒冰1.00；「冰结魔法《冻结》。」</data></node>
    <node id="深海之黑暗"><data key="name">深海之黑暗</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『深海之黑暗』】</data></node>
    <node id="『Firefly·蜃气楼』"><data key="name">『Firefly·蜃气楼』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">『Firefly·蜃气楼』是利用温度差影响光的折射扰乱对手距离感的魔法</data></node>
    <node id="水羽衣SinkedShell"><data key="name">水羽衣SinkedShell</data><data key="type">道具(防具)</data><data key="status">provisional</data><data key="desc">「水羽衣SinkedShell」；防御力4对魔力8；水中行动时补正+33％</data></node>
    <node id="教会"><data key="name">教会</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">于是我直接前往了与缇亚约好的汇合地点——教会。；在这个世界里，向神献上祈祷的人非常多。</data></node>
    <node id="圣柯尔库堡"><data key="name">圣柯尔库堡</data><data key="type">地点(城堡·司令部)</data><data key="status">provisional</data><data key="desc">地点是位于港口都市柯尔库侧面的『圣柯尔库堡』；就这样一路走着，最后进入了位于城堡最上层的房间。这里是将各个部门的决策汇总起来处理的大会议室。；「之前的那个怪物正从西面向我们这边袭来！虽然数量不是十只而是一只，但也是不可小觑的威胁。现在指挥部那边正在制定以驻守在『圣柯尔库堡』的兵力迎击的计划，可能的话希望克洛伊大人也能参与指挥」</data></node>
    <node id="『次元之冬·歪冰世界』"><data key="name">『次元之冬·歪冰世界』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——全魔法解放！『次元之冬·歪冰世界』！！」；而在那里的是冰之镜。使用『魔力冰结化』和『Foam』欺骗了世界的虚像作为我的替身被斩断了。</data></node>
    <node id="『次元之冬』"><data key="name">『次元之冬』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——魔法『次元之冬（Di·Winter）』！！」；我将用于抑制分子运动的魔法延伸为了抑制敌人魔力运动的魔法。；这已经不是『次元之冬・终霜』而是完全不一样的新魔法了吧。不过我没有给这个新魔法取名。平时的话肯定瞬间就会冒出什么点子的，不过今天没有那个心情。</data></node>
    <node id="技能『???』"><data key="name">技能『???』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">只不过，『封印』虽然消失，但『混乱』还留着，应该认为技能『???』的隐患还在。</data></node>
    <node id="锻冶"><data key="name">锻冶</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">技能『锻冶』能有所成长的话，我就能自己打造对迷宫探索有用的东西了。；正因为他做得到，所以他的技能『锻冶』才会有3.12这么高。；我将她画的造型暗记下来，然后迅速在脑海中构建锻造的最佳程序。所幸自己在地下生活中给雷纳尔多打过下手，拜此所赐与技能『锻冶』相关的知识和经验都非常充足。</data></node>
    <node id="『世界炎蛇』"><data key="name">『世界炎蛇』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『璀璨星辰，无限远泛，饕餮殄灭』！『世界炎蛇』！！」；可是玛利亚的『世界炎蛇』却在MP尚存的情况下夺去了她的HP。；「——『将我一饮而尽』！『世界炎蛇』！！」</data></node>
    <node id="『次元之夜（The·Night）』"><data key="name">『次元之夜（The·Night）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">——『次元之夜（The·Night）』。；——这个魔法就是用黑夜统治世界的魔法。</data></node>
    <node id="缇达的魔石"><data key="name">缇达的魔石</data><data key="type">道具(守护者魔石)</data><data key="status">provisional</data><data key="desc">到这里，我注意到挂在西娅脖子上的项链用的是『缇达的魔石』；虽然不知道这里面有怎样错综复杂的原委，但帕林库洛・勒伽西的侄女西娅・勒伽西似乎在尝试与『缇达的魔石』产生『亲和』</data></node>
    <node id="缭乱踏破"><data key="name">缭乱踏破</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『缭乱踏破』】</data></node>
    <node id="酒馆"><data key="name">酒馆</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">我将玛利亚留在家中，来到了酒馆。；酒馆顿时一片哗然。；由于我希望至少能够在没有外人的地方进行决斗，所以带着他们来到了酒馆的后方。</data></node>
    <node id="『Growth』"><data key="name">『Growth』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『Growth』。」；【状态】状态：身体强化1.00</data></node>
    <node id="『冰BatteringRam（冰霜破城槌）』"><data key="name">『冰BatteringRam（冰霜破城槌）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">『冰BatteringRam（冰霜破城槌）』！！；她释放出的巨型冰槌从正面将我精制的冰蛇碾作齑粉。；接着『冰BatteringRam』乘势将我逼出了自己的阵地。</data></node>
    <node id="『炽天之纤炎』"><data key="name">『炽天之纤炎』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">『炽天之纤炎』！」；「『燃炽吧闪炎』，『衔尾之蛇，以彼纤纤，吞天噬地』。——『炽天之纤炎』。」；玛利亚使用了跟阿尔缇一样的火炎魔法，锐利的火焰切断了黑暗，如同切断了空间一样驰来。</data></node>
    <node id="天剑诺亚"><data key="name">天剑诺亚</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">【天剑诺亚】；攻击力7。消耗率99%</data></node>
    <node id="艾尔芬（Elfen）外套"><data key="name">艾尔芬（Elfen）外套</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">装备：铁制单手剑异界的衣服艾尔芬（Elfen）外套皮制手套异界的鞋子附有咒印的投掷短刀；『艾尔芬外套』可以在低温和高温的环境中为身体提供保护</data></node>
    <node id="『新月琉璃直剑』"><data key="name">『新月琉璃直剑』</data><data key="type">物品(武具)</data><data key="status">provisional</data><data key="desc">不知不觉间，我从『持有物品』中取出『新月琉璃直剑』挡开了拉丝缇娅拉的一闪。</data></node>
    <node id="次元魔法"><data key="name">次元魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">后天技能：次元魔法5.00？？？：？？？？？？：？？？；次元魔法:维度1.00；技能点我只分配了一点给次元魔法。</data></node>
    <node id="次元雪"><data key="name">次元雪</data><data key="type">魔法(次元魔法)</data><data key="status">provisional</data><data key="desc">「——魔法『次元之冬』、『次元雪』。」；甲板上张开冰之结界，『次元雪』于结界中飞舞。；拉丝缇娅拉释放的冰箭则在我精制的雪道引导下贯穿天空。</data></node>
    <node id="『北方的救世主』"><data key="name">『北方的救世主』</data><data key="type">称号(罗德·缇缇)</data><data key="status">provisional</data><data key="desc">「孤确实是『北方的救世主』，这毋庸置疑。可是，对那个时候的孤来说，涡波则是『孤的救世主』。</data></node>
    <node id="『QuartzParallax』"><data key="name">『QuartzParallax』</data><data key="type">魔法(水晶系·涡波)</data><data key="status">provisional</data><data key="desc">「──『QuartzParallax』！」；我在被避开的水晶楔侧面像分枝一样制造出新的水晶楔突袭，拉丝缇娅拉将火鸟的双翼伸展开，堵住水晶蚁的退路。</data></node>
    <node id="莱文（Reborn）"><data key="name">莱文（Reborn）</data><data key="type">概念(货币)</data><data key="status">provisional</data><data key="desc">莱文（Reborn）银币莱文铜币铁匕首肉干水袋止血药油打火机智能手机石子树枝；今天的报酬则是十枚铜币。</data></node>
    <node id="CannonSehr"><data key="name">CannonSehr</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">「──『GrowthExtended』！鲜血魔法『海因・赫勒比勒夏因』！再加上『CannonSehr』！！」；少女朝被打穿的信道方向使出了同样的魔法。在信道中呈一直线奔驰的拉丝缇娅拉是无法回避这一击的。拉丝缇娅拉随即被『CannonSehr』震退。；双重展开的『CannonSehr・Madness』将我们的冻结魔法抵消了。</data></node>
    <node id="FlameFlamberge"><data key="name">FlameFlamberge</data><data key="type">魔法(火炎)</data><data key="status">provisional</data><data key="desc">「——『FlameFlamberge』！」；冰刃与炎刃呈夹击之势。</data></node>
    <node id="瓦尔德"><data key="name">瓦尔德</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">他们身上的行头与在瓦尔德烂大街的货色截然不同；「你这家伙，可别看不起瓦尔德啊！」；依照当初的预定，我前往了东边的瓦尔德。</data></node>
    <node id="Alexandrite"><data key="name">Alexandrite</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">既然已经身份大白，我便不做掩饰堂堂正正地从『所有物』中取出了在迷宫深部入手的魔石。看到被我摆在工作台上的这些魔石，以艾利巴茨为首的锻冶师们无不屏气凝神。；这次锻造中用到的魔石名为『Alexandrite』『WindFluorite』『VallkundtEmerald』等等等等⋯⋯──</data></node>
    <node id="火炎魔法"><data key="name">火炎魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">先天技能：炯眼1.45；后天技能：狩猎0.67料理1.08火·炎·魔·法1.00；在她放出火炎魔法的同时，我钻向西斯的怀中，并且增强了『Dimension』用以找寻其破绽。</data></node>
    <node id="心异（Variable）·解放（Burst）"><data key="name">心异（Variable）·解放（Burst）</data><data key="type">技能(精神魔法)</data><data key="status">provisional</data><data key="desc">「将我的一切赌在这一刻！命中吧！——魔法『心异（Variable）·解放（Burst）』！！」；我如『中毒』般呼吸困难，如『沉默』般有口难言，如『麻痹』般身体麻痹，并且，明明因『恐惧』而瑟瑟发抖，却还因『昂扬』而身体燥热。</data></node>
    <node id="『北之大帝国』"><data key="name">『北之大帝国』</data><data key="type">地点·国家形态(佩艾希亚时间轴再现)</data><data key="status">provisional</data><data key="desc">城市的规模相较之前扩展到了令人难以置信的程度。；一别于往常的绿色，现在是焦褐色遍布各地。；现在存在于『这里』的，是在战争中扩大了领土，而且正处于战争之中的『北之大帝国』</data></node>
    <node id="沃克家"><data key="name">沃克家</data><data key="type">组织(贵族家门)</data><data key="status">provisional</data><data key="desc">「是这样吗，那个、我记得沃克家是劳拉维亚的大贵族来着？」；「……我和哥哥都是被收养的。沃克家有将优秀的血脉引入自身的传统。」；「最近这阵子一直在啰嗦着要我结婚什么的。在我不知情的时候，替我跟不是很熟悉的人订下了婚约。」</data></node>
    <node id="过捕护"><data key="name">过捕护</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">属性魔法2.09过捕护2.00续命2.23良机2.02；【技能『过捕护』暴走了】；以一定的感情为交换，将特定的感情予以强化</data></node>
    <node id="『亡失的殉教者』"><data key="name">『亡失的殉教者』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——魔法『亡失的殉教者』。」</data></node>
    <node id="形式"><data key="name">形式</data><data key="type">魔法(次元系)</data><data key="status">provisional</data><data key="desc">虽然规模不同，但『形式』也是能够以泡沫的形式生成次元的断层的。；之前与诺文战斗时，我就增强过『形式』的效果以对距离感上下其手。</data></node>
    <node id="瓦尔德的酒馆"><data key="name">瓦尔德的酒馆</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">那就是距离瓦尔德迷宫出入口最近的酒馆。；也是我曾经工作过的地方。；迎接我的是与以前别无二致的看板和门扉。</data></node>
    <node id="『次元・雪』"><data key="name">『次元・雪』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">魔法『次元之冬』、『次元・雪』；甲板上张开冰之结界，『次元・雪』于结界中飞舞。；拉丝缇娅拉释放的冰箭则在我精制的雪道引导下贯穿天空。</data></node>
    <node id="艾尔乌纳"><data key="name">艾尔乌纳</data><data key="type">生物(军用骑乘)</data><data key="status">provisional</data><data key="desc">有许吐司兵骑着像马一样的生物。；是因为交战地多数在平原吗，骑乘兵十分的多；「马？是在说军用的『艾尔乌纳』吗，我认为应该是可以骑的⋯⋯」</data></node>
    <node id="附有咒印的投掷短刀"><data key="name">附有咒印的投掷短刀</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">装备：铁制单手剑异界的衣服艾尔芬（Elfen）外套皮制手套异界的鞋子附有咒印的投掷短刀</data></node>
    <node id="胆怯之力"><data key="name">胆怯之力</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『胆怯之力』】</data></node>
    <node id="赫勒比勒夏因家"><data key="name">赫勒比勒夏因家</data><data key="type">组织</data><data key="status">provisional</data><data key="desc">毕竟这关系到赫勒比勒夏因家的名誉。</data></node>
    <node id="集中收束"><data key="name">集中收束</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">神圣魔法3.78神之加护3.07断罪2.00集中收束2.02</data></node>
    <node id="『御殿』"><data key="name">『御殿』</data><data key="type">地点(佩艾希亚·城堡中央玉座之殿)</data><data key="status">provisional</data><data key="desc">既然玉座镇座于此──那就意味着这里是位于城堡中央的『御殿』。；殿内只有两扇门。其一为臣民谒见之际使用的大门，其二为玉座后方为王所专用的门。；而竖在她身后──绘有应当是象征着这佩艾西亚的纹章、鸟与剑的图案的旌旗正迎风飘摇着。</data></node>
    <node id="『来自异界的救主（相川涡波）』"><data key="name">『来自异界的救主（相川涡波）』</data><data key="type">称号(相川涡波·守护者们的称呼)</data><data key="status">provisional</data><data key="desc">即・使・如・此・吾・等・也・在・等・待・着『来自异界的救主（相川涡波）』。</data></node>
    <node id="『龙化』"><data key="name">『龙化』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">『龙化』——兽人的血较为浓郁时，当事人就会拥有兽化的能力。我家塞拉酱的『狼化』就是一类。作为兽人之一种的龙人，斯诺也能做到那一点。；在联合国已确认的范围内，她是这个世界上唯一一个能化身为『龙』的人。</data></node>
    <node id="『冬之异世界（Wintry·Dimension）』"><data key="name">『冬之异世界（Wintry·Dimension）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">——魔法『冬之异世界（Wintry·Dimension）』！；这就是『冬之异世界』的力量。</data></node>
    <node id="自由之风"><data key="name">自由之风</data><data key="type">技能(风)</data><data key="status">provisional</data><data key="desc">「嗯─，虽然跟一般的冷却不同但『自由之风』是可以分裂热量的哟」；「为了人家的剑上啊！『自由之风』哟！──『风』！」；我的『维度』能够将材料每一处的热量掌握到小数点以下的单位，以此为基础配以缇缇精确无比的「自由之风」进行冷却。</data></node>
    <node id="二十四层"><data key="name">二十四层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">最值得一提的要数熔岩。沸腾的岩浆像河流一般流淌在二十四层。</data></node>
    <node id="咒术『连接』"><data key="name">咒术『连接』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『连接』的诅咒形态（不再是『魔法』而是『诅咒』）：打穿世界制造（次元之）洞穴的『诅咒』；与咒术『维度』拼合构成复合咒术『咏唱』的基座，『咏唱』成立后确实钻出了次元之穴；「──咒・术『连接』、──咒・术『维度』！！」；一个是打穿世界制造洞穴的『诅咒』，一个是支配世界的『诅咒』</data></node>
    <node id="手环"><data key="name">手环</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">这是帕林库洛为作为『异邦人』的我们解决不便之处而准备的『手环』。；「现在就是关键时刻了。涡波要比诺文更快地结束比赛，跟我们汇合。我们则要好好地修理斯诺一顿。然后在不会有任何人妨碍的准决赛中破坏掉『手环』。——上吧！」；这个『手环』就是为了释放某种魔法的代用品。</data></node>
    <node id="斯诺的免职令"><data key="name">斯诺的免职令</data><data key="type">道具(敕令文书)</data><data key="status">provisional</data><data key="desc">「诶⋯⋯这个是、斯诺大人的『免职令』⋯⋯？怎么会，为什么这么快就⋯⋯？」；递给克洛伊小姐的介绍信同时也是命令斯诺和我们同行，并安排人员补充斯诺离去造成的职位空缺的敕令。</data></node>
    <node id="阿雷亚斯家（剑圣名门）"><data key="name">阿雷亚斯家（剑圣名门）</data><data key="type">组织</data><data key="status">provisional</data><data key="desc">并且我也知道，山下的宅邸也和这里一样同属于阿雷亚斯家。</data></node>
    <node id="兑换所"><data key="name">兑换所</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">我按照工作人员的指示抵达了兑换所。；「……不，我没有那东西。」</data></node>
    <node id="『Dimension』"><data key="name">『Dimension』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">毕竟仅靠『Dimension』旁听所获取的信息较抵达20层而言还是有所欠缺。；就算数值上有些许的差距，通过『Dimension』也能轻松弥补。；「——魔法『Dimension·决战演算』、魔法『Foam』。」</data></node>
    <node id="『Connection』"><data key="name">『Connection』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">【Connection】；上级次元魔法能根据术者的力量连接次元；「尽快吧，涡波。不赶紧去『史诗探索者』那边的话，你妹妹会有危险的哦？不能用涡波的『Connection』直接去『史诗探索者』吗？」</data></node>
    <node id="VallkundtEmerald"><data key="name">VallkundtEmerald</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">这次锻造中用到的魔石名为『Alexandrite』『WindFluorite』『VallkundtEmerald』等等等等⋯⋯──</data></node>
    <node id="圣杯"><data key="name">圣杯</data><data key="type">道具(圣遗物)</data><data key="status">provisional</data><data key="desc">「『缇娅拉大人的血』非常特殊。就算是被洒到荒郊野岭，她的血也会自行活动向圣杯回笼。像这样、咕噜咕噜～⋯⋯的感觉。为了防止血重新回到圣杯之内，帕林库洛便将血散播到了『人』这一容器之中，如此一来血就无法再聚集到同一个地方了」</data></node>
    <node id="『DistanceMute（幻之紫腕）』"><data key="name">『DistanceMute（幻之紫腕）』</data><data key="type">魔法(即死)</data><data key="status">provisional</data><data key="desc">「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『DistanceMute（幻之紫腕）』恐怕全都是最高位的魔法。──分别是『无法被干涉的攻击魔法』『无法被闪避的空间魔法』『无法被防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余」；「毕竟这个是将手伸进对方的体内，直接抽出『魂』的魔法啊。物理上的防御力再高也没意义的；这个魔法很明显是在缇娅拉的帮助下创造出来的。将施加在迷宫全体的抽取魔石的术式跟次元魔术组合在一起，升华为毫不讲理地就能让敌人无法战斗的魔法。</data></node>
    <node id="鲜血魔法"><data key="name">鲜血魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">跟斯诺『龙化』那时一样，我的手背绽裂流出鲜血。血液又蒸发变成血雾将我的身体包裹起来。；这具用魔石练就的肉体，进一步接近了『人』。这就是我的鲜血魔法。</data></node>
    <node id="泪洸"><data key="name">泪洸</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">顺便一提，这些白粒被唤作『泪洸』</data></node>
    <node id="迷宫"><data key="name">迷宫</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">虽然我在迷宫中受她相救也是事实；探索迷宫的时候恐怕也难逃一劫；和玛利亚一起潜入迷宫的时候</data></node>
    <node id="洗涤黑暗之人"><data key="name">洗涤黑暗之人</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『洗涤黑暗之人』】；精神魔法补正+0.50</data></node>
    <node id="20层"><data key="name">20层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">毕竟仅靠『Dimension』旁听所获取的信息较抵达20层而言还是有所欠缺。</data></node>
    <node id="风之理的盗窃者"><data key="name">风之理的盗窃者</data><data key="type">称号</data><data key="status">provisional</data><data key="desc">『风之理的盗窃者』的力量甚至可以直接省略淬火的作业。而且说实话，缇缇的风效果甚至比水更好。</data></node>
    <node id="鲜血魔法『芬里尔・阿雷亚斯』"><data key="name">鲜血魔法『芬里尔・阿雷亚斯』</data><data key="type">魔法(鲜血魔法)</data><data key="status">provisional</data><data key="desc">──鲜血魔法『芬里尔・阿雷亚斯』；拉丝缇娅拉使用所剩不多的MP，闭上双眼咏唱出鲜血魔法。；她的发色微微改变，同时她举剑的架势水准提高了几个档次。</data></node>
    <node id="鲜血魔法『相川涡波/相川阳滝』"><data key="name">鲜血魔法『相川涡波/相川阳滝』</data><data key="type">魔法(鲜血系·借取)</data><data key="status">provisional</data><data key="desc">「──鲜血・魔・法『相川涡波/相川阳滝』」；以前，那个魔法使斯诺变得与龙相近，拉丝缇娅拉则变得与伟人相近。；接着正如那名字所宣示的，她的姿态也变得和我们相近。</data></node>
    <node id="魔法『连接』"><data key="name">魔法『连接』</data><data key="type">魔法(移动)</data><data key="status">provisional</data><data key="desc">──魔法『连接』；破壊了距离这一概念的淡紫色门扉诞生了。；我的『连接』有直通联合国的信道。要回去的话就是一眨眼的事。</data></node>
    <node id="技能『？？？』的恋爱干涉（ch69实证）"><data key="name">技能『？？？』的恋爱干涉（ch69实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">圣诞祭前夜确定的『最喜欢拉丝缇娅拉』的感情被技能『？？？』分解和重塑、丧失原样（心留愤怒，爱慕不复存在，只剩扭曲感情的残骸）；恋爱感情激化即接近发动条件：拥抱后『箭在弦上』、告白级爱意超出承受界限（技能两度以死亡警告否决缇亚商谈与直接告白）；预测：若交往深化，发作将使涡波丧失爱情只留拉丝缇娅拉一人；涡波决定冻结告白『直到解决技能『？？？』为止』（至少到击败帕林库洛·勒伽西/与妹妹重逢）；因为那份感情被技能『？？？』给分解和重塑，现在已经丧失了原样。；因为技能『？？？』已经是箭在弦上了。；我摸清了技能『？？？』对于恋爱可以承受的界限。看来会发展到告白程度的爱意是不行的。</data></node>
    <node id="神圣魔法『Inviolable·Field』"><data key="name">神圣魔法『Inviolable·Field』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——神圣魔法『Inviolable·Field』！」；光靠她们两人就铸就了比大会运营方特意准备的结界更加强力的魔法。</data></node>
    <node id="第二迷宫都市达利尔"><data key="name">第二迷宫都市达利尔</data><data key="type">地点(迷宫都市)</data><data key="status">provisional</data><data key="desc">「和斯诺汇合之后，就轮到在『第二迷宫都市达利尔』的玛利亚和莉帕了呢。移动手段就跟之前一样用船如何？现在『LivingLegend号』就停靠在古尔亚德的港口，你可以直接使用。让渡的公文我很快就能发给你所以不用担心。和大家汇合之后，就拜托你北上救回缇亚了。啊啊，还有──」；「其实就是指帕林库洛和涡波的战斗留下的大空洞了呢。不知道为什么，那里形成了跟这边的迷宫类似的东西。玛利亚她主张的『方法』就是一边在那里积蓄夺回缇亚的力量，一边寻找涡波」；巨型怪物的袭击虽然在当时尚有余力的南方诸国的处理下最终得以化解，并且还在『大空洞』周边用最快速度建造了所谓『第二迷宫都市达利尔』，以期处理后续的怪物袭击，但尽管</data></node>
    <node id="『己魂焦热之骸炎』"><data key="name">『己魂焦热之骸炎』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——魔法『己魂焦热之骸炎』！！」</data></node>
    <node id="大空洞"><data key="name">大空洞</data><data key="type">地点(灾变地形)</data><data key="status">provisional</data><data key="desc">因为不明原因的大魔法导致位于南北境界线周围的生息嚼类全部死绝，一个充满谜团的『大空洞』极其突兀地出现在了大陆上。；与之同时，在『大空洞』周围充斥着始终不散的黑云，未知的巨型怪物则从空洞中诞生不断地袭向周围各国。</data></node>
    <node id="良机"><data key="name">良机</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">属性魔法2.09过捕护2.00续命2.23良机2.02</data></node>
    <node id="莱文教圣经"><data key="name">莱文教圣经</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">圣人缇娅拉的再诞乃是记录于莱文教圣经当中的预言。而其再诞的时间就在今年。</data></node>
    <node id="FullBlazing"><data key="name">FullBlazing</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">贝丝与雷纳尔多同发之极限强化技：炽烈魔力将身体能力抬升至极限、余热化作火焰盘绕全身，如『炎之剑』（贝丝版既有技·此处明喻）般将身体化作刀刃榨出全部底力；其后突进全力袈裟斩对撞——魔法与时机全同，胜败仅由魔力之质决出（以生命为薪柴者胜一筹）；「──『FullBlazing』！！」；就像『炎之剑』一样，两人将自己的身体化作了刀刃，榨出全部的底力，将力量强化到极限。；结果便是贝丝的剑被大斧击碎。</data></node>
    <node id="《完全治愈》"><data key="name">《完全治愈》</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——《完全治愈》。好了，治疗结束~。」；「『晖捋为谣』，『梳水入幻，此血不归』，『荫蔽天地』——」</data></node>
    <node id="世界树"><data key="name">世界树</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">那棵树被称作世界树（Yggdrasill），而圣人听到的好像就是世界树的声音哦。</data></node>
    <node id="白樱（Pieris・EithéA）"><data key="name">白樱（Pieris・EithéA）</data><data key="type">物种(树木)</data><data key="status">provisional</data><data key="desc">「哦哦。都到了能看到这种树的地方了吗。那是北方特有的树种。而且尤属在佩艾希亚最为常见。名字叫作『白樱（Pieris・EithéA）』。可能是因为艾德本身也是开白花的树人种吧，他对白樱一向颇为青睐」；「既然性格温厚，那确实不无可能。⋯⋯说起来，艾德好像经常待在跟那边那些一样的开着白花的树下读书来着」</data></node>
    <node id="艾尔多拉琉学院"><data key="name">艾尔多拉琉学院</data><data key="type">组织</data><data key="status">provisional</data><data key="desc">他既是那个希达尔克家的长男，同时又是艾尔多拉琉学院的主席骑士、也是精锐云集的公会『绝世』的会长！</data></node>
    <node id="圣诞祭"><data key="name">圣诞祭</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">为了纪念和称颂创建了联合国的英雄们，每年都会举办祭典。</data></node>
    <node id="『魔石人类』"><data key="name">『魔石人类』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">这才是弗茨亚茨的斐勒卢托和元老院的雷琪预定之中的『魔石人类』的真髓。只为了成为与我不同的『某人』而特别强化的魔法之一端。</data></node>
    <node id="艾丽娅的发夹"><data key="name">艾丽娅的发夹</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">【艾丽娅的发夹】；可以让持有者的魔力小幅上升；说着我为缇亚戴上了『艾丽娅的发夹』。</data></node>
    <node id="大圣堂"><data key="name">大圣堂</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">竟然在大圣堂里三句不离你！；我想肯定是在大圣堂吧？；正好那家伙就在大圣堂，离这里也不算远。</data></node>
    <node id="黑虫石"><data key="name">黑虫石</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">『表示』上说这颗黑色的结晶名叫『黑虫石』。；与普通的魔法石不同，是由虫属性的魔力构成的魔法石。</data></node>
    <node id="阳祝日"><data key="name">阳祝日</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">店长跟我说阳祝日是休息日来着。</data></node>
    <node id="『次元之联结（Deny·Entia）』"><data key="name">『次元之联结（Deny·Entia）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「我乃『慕影死神』！曾是只为了屠戮人类而被创造出来的魔法！是仅仅为此而生的存在！这世间所有生命皆是我的饵食！——『次元之联结（Deny·Entia）』！！」；莉帕设置的『联结』不仅只在我身上存在，只要略微使用次元魔法我就能感觉到，她现在是在从劳拉维亚的所有居民身上汲取魔力。</data></node>
    <node id="魔法『冰之矢』"><data key="name">魔法『冰之矢』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">魔法『冰之矢』；拉丝缇娅拉释放的冰箭则在我精制的雪道引导下贯穿天空。；那么搞起～。──『冰之矢』！</data></node>
    <node id="维度・千算相杀（Counting）"><data key="name">维度・千算相杀（Counting）</data><data key="type">魔法(次元属性·涡波·魔法战特化)</data><data key="status">provisional</data><data key="desc">「──『维度・千算相杀（Counting）』」；这个戏法的奥秘非常单纯，就是将对手的魔法构筑予以捩转。；「在我展开这个魔法的期间的话，可能就是这样。不过这样的话在近距离战斗中实力就会有所减弱。『维度・决战演算』是近身战特化的魔法，而『维度・千算相杀』就是魔法战特化的魔法了呢。正所谓一长一短吧」</data></node>
    <node id="『飞翔翠石制轻铠路易芬理德』"><data key="name">『飞翔翠石制轻铠路易芬理德』</data><data key="type">道具(防具)</data><data key="status">provisional</data><data key="desc">缇缇在船头一跃而起，只见艾利巴茨打造的『飞翔翠石制轻铠路易芬理德』在阳光的照耀下熠熠生辉</data></node>
    <node id="剑术"><data key="name">剑术</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">后天技能：剑术2.12神圣魔法0.89；不过她好歹也是掌握着高水平的剑术之人；先天技能：剑术1.01冰结魔法2.00</data></node>
    <node id="『Foam』"><data key="name">『Foam』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——魔法『Dimension·决战演算』、魔法『Foam』。」；第一个打算尝试的魔法是『Foam』。；其间，我注意到了『Foam』对『Dimension』有辅助效果。</data></node>
    <node id="『冬之异世界·四重奏（Winter维度Quartetto）』"><data key="name">『冬之异世界·四重奏（Winter维度Quartetto）』</data><data key="type">魔法(四人共鸣)</data><data key="status">provisional</data><data key="desc">换句话说这是我们四个人的共鸣魔法。说它升华为『冬之异世界・四重奏（Winter维度Quartetto）』这样的大魔法也不为过。；我蹬着冰柱在水中移动着，不时也在水底奔驰。速度虽然不如水栖怪物快，但是相对的，伽鲁夫纳多杰里的速度也减慢了。『冬之异世界・四重奏（Winter维度Quartetto）』跟『过密次元的真冬（TheOverWinter）』一样可以妨碍敌人的行动。；通过『冬之异世界・四重奏』的帮助，现在地利五五分了。</data></node>
    <node id="『次元决战演算『先谭』』"><data key="name">『次元决战演算『先谭』』</data><data key="type">魔法(次元系·未来视)</data><data key="status">provisional</data><data key="desc">但是，为了到达魔法『次元决战演算『先谭』』所看到的胜利的未来，我必须要在这里战斗。；不，搞不好，魔法『次元决战演算『先谭』』是特别容易感知到的魔法也说不定。毕竟在战斗之前使用的时候，我就感觉到自己的魔力沁入世界之中了。；毕竟，我已经用出了自己的王牌、魔法『次元决战演算『先谭』』和魔法『致亲爱的一闪』，但诺斯菲却没有使出她自己真正的魔法。</data></node>
    <node id="【状态】"><data key="name">【状态】</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">【状态】；【状态】状态：身体强化1.00；【状态】</data></node>
    <node id="Light・VariantWall"><data key="name">Light・VariantWall</data><data key="type">魔法(光系·防御)</data><data key="status">provisional</data><data key="desc">「就凭这种程度的魔法！──『Light・VariantWall』！！」；黑光宛如一面朝向上空的盾牌挡下倾注如雨的风之枪。</data></node>
    <node id="『QuartzBullet』"><data key="name">『QuartzBullet』</data><data key="type">魔法(水晶系·涡波)</data><data key="status">provisional</data><data key="desc">「最后一击──『QuartzBullet』！」；「『QuartzBullet』『QuartzBullet』『QuartzBullet』！！」</data></node>
    <node id="『Shift』"><data key="name">『Shift』</data><data key="type">魔法(次元魔术)</data><data key="status">provisional</data><data key="desc">「──次元魔术『Shift』」；我最近刚获得的魔法『Shift』；因为『Shift』和『次元斩裂剑』只是引发空间错位的魔法，并不具备物理层面的攻击力。</data></node>
    <node id="TowsSchussWind・GrandFall"><data key="name">TowsSchussWind・GrandFall</data><data key="type">魔法(风系·共鸣)</data><data key="status">provisional</data><data key="desc">「共鸣魔法『TowsSchussWind・GrandFall』！！」；那个魔法仅仅只是互相补足的魔法。两人魔力的个性互相衬托，乘算出最高级的风之魔法。</data></node>
    <node id="技能『兽化』"><data key="name">技能『兽化』</data><data key="type">技能(兽人变身)</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉骑在兽化的塞拉背上，趾高气扬地指着前方喧闹着。；「我明白的。我会以大小姐的──不，以所有人的安全为最优先考虑。我这『兽化』就是为此才存在的」</data></node>
    <node id="『自由之风』"><data key="name">『自由之风』</data><data key="type">理(风之理·被盗窃)</data><data key="status">provisional</data><data key="desc">『风之理的盗窃者（罗德・缇缇）』盗取了『自由之风』。</data></node>
    <node id="艾利巴茨制作的法衣"><data key="name">艾利巴茨制作的法衣</data><data key="type">道具(法衣)</data><data key="status">provisional</data><data key="desc">「艾利巴茨制作的法衣」；防御力5对魔力2；装备者的木魔法+0.05──</data></node>
    <node id="『黑骑兵之裹足』"><data key="name">『黑骑兵之裹足』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">……魔法『黑骑兵之裹足』。」</data></node>
    <node id="次元决战演算『前日谭』"><data key="name">次元决战演算『前日谭』</data><data key="type">魔法(涡波)</data><data key="status">provisional</data><data key="desc">──魔法映出了『过去』的世界。；『次元决战演算『前日谭』』的效果逐渐解除，世界的景象开始向『现在』回归。我眼中被置换的世界变回了原本的模样。；因为刚发动『次元决战演算『前日谭』』而变得敏锐的感觉──、能够读取世界走向的技能『感应』──、至今为止和守护者战斗的经验──、全都告诉我事情不会那么简单。</data></node>
    <node id="暗魔法『不罚的大英雄』"><data key="name">暗魔法『不罚的大英雄』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">【最终防卫术式：暗魔法『不罚的大英雄』发动了】；『认识阻碍』+10.00</data></node>
    <node id="『Default（行路渐歧）』"><data key="name">『Default（行路渐歧）』</data><data key="type">魔法(空间)</data><data key="status">provisional</data><data key="desc">「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『DistanceMute（幻之紫腕）』恐怕全都是最高位的魔法。──分别是『无法被干涉的攻击魔法』『无法被闪避的空间魔法』『无法被防御的即死魔法』，哪怕只学会一种对付那条龙都绰绰有余」</data></node>
    <node id="Dimension·决战演算"><data key="name">Dimension·决战演算</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">「不过，我也有对策！『Dimension·决战演算』！！」；「我要到阳滝的身边去！给我把『道路』连通！次元魔法！——《次元决战演算『先谭』（Dimension·GradientRealize）》！！」；——我·能·够·认·知·的·次·元·的·数·量·增·加·了·一·个。</data></node>
    <node id="阿尔缇魔石"><data key="name">阿尔缇魔石</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">事实上拥有阿尔缇魔石的玛利亚就可以无止境地增强实力来着]</data></node>
    <node id="续命"><data key="name">续命</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">属性魔法2.09过捕护2.00续命2.23良机2.02</data></node>
    <node id="技能『魔力风刃化』"><data key="name">技能『魔力风刃化』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">他用的并不是技能『魔力物质化』。一定要说的话，就跟我的『魔力冰结化』很像。；要给这取名的话，就叫技能『魔力风刃化』好了。</data></node>
    <node id="智能手机"><data key="name">智能手机</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">不仅如此，手机上报示的时间也差了好几年</data></node>
    <node id="一年后的伙伴分布（ch213）"><data key="name">一年后的伙伴分布（ch213）</data><data key="type">设定(现状)</data><data key="status">provisional</data><data key="desc">「嗯，大家都没事哦。都是多亏了斯诺她拼命地劝解呢。于是乎，玛利亚她现在正在西方的迷宫以到达最深部为目标中。我想莉帕应该跟她在一起」；「因为斯诺心地比较善良，所以她会同时为我和玛利亚双方提供协助。那～个，我记得她现在这个时候应该是作为我们的代表在本土供职来着？现在的职务是在前线总司令负伤期间担任代理总司令哦」</data></node>
    <node id="雷纳尔多的外套"><data key="name">雷纳尔多的外套</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷纳尔多为储藏室昏睡的莱纳保暖特意盖在其身上的外套；雷纳尔多消散后由涡波接手披在身上——涡波自述这用宽松外套裹住身体的模样『跟过去的我倒是有些相似』（与始祖涡波形象之对应·据涡波自述）；不计损耗的魔力消费很快就带来了成果。莱纳如今正躺在储藏室的地上。雷纳尔多为了不让他着凉还特意将自己的外套盖在莱纳身上。；接着我也将一直拿在手中的雷纳尔多先前盖在莱纳身上的外套披在身上。；这用宽松的外套裹住身体的模样，跟过去的我倒是有些相似。</data></node>
    <node id="『Ice·锁』"><data key="name">『Ice·锁』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">只有作为施法者的我能够将之溶解并正常使用。——名字就叫魔法『Ice·锁』吧。</data></node>
    <node id="绘画的保管室"><data key="name">绘画的保管室</data><data key="type">地点(魔王城内)</data><data key="status">provisional</data><data key="desc">带着这样的考量，我进一步扩展『维度』，随后便在藏书室的角落发现了一道门。；没有一幅是完好无损的。绝大多数的油画都被撕碎，或揉成一团。其中还有被刀划破的画。；而且不是出自理性，而是一种本能的破壊。</data></node>
    <node id="血传魔法"><data key="name">血传魔法</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">你需要直接饮用注满我魔法术式的血。</data></node>
    <node id="信"><data key="name">信</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">在她留下的信里，写下了她要与你这厮、你这厮、私、私、私私奔——。</data></node>
    <node id="元老院"><data key="name">元老院</data><data key="type">组织</data><data key="status">provisional</data><data key="desc">「如今接受元老院的委任掌管此处的人是我。而他们是我的客人。换句话说，这里没有你的一席之地」</data></node>
    <node id="『Firefly·幻影』"><data key="name">『Firefly·幻影』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">『Firefly·幻影』是用火焰创造出人形幻影的魔法。</data></node>
    <node id="古利亚德"><data key="name">古利亚德</data><data key="type">地点(国)</data><data key="status">provisional</data><data key="desc">『舞闘大会』结束后，从劳拉维亚逃出来的我们向着南方国家古利亚德前进。</data></node>
    <node id="地魔法『Earth』"><data key="name">地魔法『Earth』</data><data key="type">魔法(地属性·基础)</data><data key="status">provisional</data><data key="desc">地属性的基础魔法『Earth』。操纵泥土的魔法。；──地魔法『Earth』；沙子就像被磁铁吸引的铁砂一样，开始吸附到剑上。</data></node>
    <node id="拉丝缇娅拉的实力停滞（血之余量）"><data key="name">拉丝缇娅拉的实力停滞（血之余量）</data><data key="type">设定(人物状态)</data><data key="status">provisional</data><data key="desc">跟一年前分别的时候相比，她的级别基本没有成长，这让我感到有些违和。过去了一年的时间，可拉丝缇娅拉的级别和技能竟然了无变化，这不合她的风格。；「没有的事。就算级别提高了也没有意义。我的强度早已完成，没有成长的余地了。大家在不断地习得新的魔法和技能，但我却只有基础数值能够提高⋯⋯跟玛利亚和斯诺比起来，我的成长太过迟缓了啊⋯⋯」；曾几何时，十层守护者阿尔缇说过拉丝缇娅拉的『血』已经没有余量。这份隐忧到了现在似乎成为了致命性的问题。</data></node>
    <node id="瓦尔法拉"><data key="name">瓦尔法拉</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">「我们打过赌你会不会带我离开『瓦尔法拉』的。嘿嘿~，那个，是我赢了对吧？」</data></node>
    <node id="孤儿院"><data key="name">孤儿院</data><data key="type">地点(佩艾希亚·罗德出身设施)</data><data key="status">provisional</data><data key="desc">之后，失去了监护人的她被孤儿院收养，在那里她邂逅了众多未来的将星。；但是跟前面的小屋不同，这一栋房子规格稍大。根据一连串的发展，我推测这画的是『孤儿院』。；而在孤儿院前面的孩子们当中，站着与我认识的现在的罗德拥有・一・模・一・样・的姿态的她。</data></node>
    <node id="神圣魔法"><data key="name">神圣魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">后天技能：剑术2.12神圣魔法0.89；不过，既不是始祖的神圣魔法，架刀的姿势也是有形无神。；和从缇亚那里看来的神圣魔法非常相似</data></node>
    <node id="『？？？』"><data key="name">『？？？』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">【技能『？？？』暴走了】；以一定的感情为交换，使精神安定下来。；后天技能：次元魔法5.00？？？：？？？？？？：？？？</data></node>
    <node id="魔石戒指"><data key="name">魔石戒指</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">【魔石『震风』的戒指】寄宿着『震风』的力量的戒指；海因手上的一枚戒指应声碎裂，旋即便有一股浓郁的魔力化作一道暴风</data></node>
    <node id="Sylph•Rokh•Bringer"><data key="name">Sylph•Rokh•Bringer</data><data key="type">物品(剑)</data><data key="status">provisional</data><data key="desc">他连忙深深地鞠了一躬并为获赠『Sylph•Rokh•Bringer』的事道谢。；因为我的改造，让『Rokh•Bringer』完全变成风属性的武器了啊。</data></node>
    <node id="古尔亚德国"><data key="name">古尔亚德国</data><data key="type">地点(国)</data><data key="status">provisional</data><data key="desc">甩掉弗茨亚茨和瓦尔德两国派出的追兵，潜伏于南方的古尔亚德国。</data></node>
    <node id="Foam•捩菖蒲（Torsion）"><data key="name">Foam•捩菖蒲（Torsion）</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">——魔法『Foam•捩菖蒲（Torsion）』！；用游戏的语言来说，这是攻击MP而不是HP的魔法。</data></node>
    <node id="『旋风击』"><data key="name">『旋风击』</data><data key="type">技能招式(飞踢)</data><data key="status">provisional</data><data key="desc">受死吧、『旋风击』！！」；缇缇很快就振作气势使出一记猛烈的飞踢。；XiphiasSpear的鳞片在这招面前就跟饼干一样不堪一击，直接被伤到了骨肉。</data></node>
    <node id="『维度·多重展开』"><data key="name">『维度·多重展开』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「状态——，……嗯，能行。魔法『维度·多重展开』。」；顺带一说，这个『维度·多重展开』是『维度』的衍生魔法。；「没办法，用『Dimension・多重展开』来找些能收留他们的好地方吧。」</data></node>
    <node id="通信机"><data key="name">通信机</data><data key="type">魔法(联络)</data><data key="status">provisional</data><data key="desc">（涡波大人明鉴。──正是鄙人、『木之理的盗窃者』艾德。何必如此慌张，这不就是鄙人以前与涡波大人还有赛鲁多拉大人通力合作打造出的联络魔法吗？记得名字是叫⋯⋯『通信机』。没错，是叫『通信机』的魔法）；艾德根据我的反应推断出了我记忆的状态。看来施加于这棵树上的振动魔法不仅能够传达声音，还能获得影像信息。</data></node>
    <node id="『兽化』"><data key="name">『兽化』</data><data key="type">魔法(变身能力·塞拉)</data><data key="status">provisional</data><data key="desc">之后响起了劈啪劈啪的骨肉变形的声音，随后莉帕代替塞拉小姐说道。；回过头去，面前的塞拉小姐已是『兽化』的姿态了。</data></node>
    <node id="焦土踏破、疾驰无息之魂"><data key="name">焦土踏破、疾驰无息之魂</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">贝丝与雷纳尔多以同样咏唱释放的同样魔法之一（地属性系大魔法咏唱名）；两人以同样的咏唱释放出同样的魔法，但纺出的魔力在质上截然不同；并且理所当然地、两人以同样的咏唱释放出同样的魔法──；「──『勖兮奋哉、吼哮不绝之焰』！『焦土踏破、疾驰无息之魂』！」</data></node>
    <node id="解毒药"><data key="name">解毒药</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">普通的解毒药。适用于去除『毒蜂』的毒性。；有5％的概率可以解除其它种类的毒性。</data></node>
    <node id="魔法『水晶剑』"><data key="name">魔法『水晶剑』</data><data key="type">魔法(水晶系·剑)</data><data key="status">provisional</data><data key="desc">「──魔法『水晶剑』！」；就像『冰结剑』一样，水晶覆盖到剑的表面。这是为了能自如地运用水晶魔法『Quartz』而做的练习。；数不尽的触手朝拉丝缇娅拉挥去，我的水晶剑将这些触手一一切断。</data></node>
    <node id="瓦尔德本国"><data key="name">瓦尔德本国</data><data key="type">地点(国家)</data><data key="status">provisional</data><data key="desc">「……我们接下来将抵达的『本土』是这个世界上最大的大陆。在那里以『北方』和『南方』为界，正进行着世界上最大规模的战争。而瓦尔德本国就处于这场战争的最前线。」；为了隐藏『LivingLegend号』，我们将它停靠在本土东北部瓦尔德本国东端的海崖下。</data></node>
    <node id="奥兰（Oria）大剑"><data key="name">奥兰（Oria）大剑</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">肉干水袋油麻痹针解毒药奥兰（Oria）大剑皮袋皮制手套皮靴布衣木弓铁匕首没有印记的箭矢打火机智能手机石子树枝十位魔法石九位魔法石；『奥兰大剑』的效果则是在与比自己更强的对手战斗时能发挥出真正的价值。</data></node>
    <node id="Red・StingDagger"><data key="name">Red・StingDagger</data><data key="type">道具(短剑)</data><data key="status">provisional</data><data key="desc">「Red・StingDagger」；攻击力3；装备者火魔法+0.10</data></node>
    <node id="辉线疾走"><data key="name">辉线疾走</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『辉线疾走』】</data></node>
    <node id="【修坏的阿雷亚斯家宝剑】"><data key="name">【修坏的阿雷亚斯家宝剑】</data><data key="type">物品(魔剑)</data><data key="status">provisional</data><data key="desc">【修坏的阿雷亚斯家宝剑】攻击力2；这把剑经由艾利巴茨之手得到了修缮。被熔解的刀身由新月线形石弥补，剑柄用水晶做了颇具匠心的改良。但因为强行修复的缘故，剑的锋利度并没有恢复。</data></node>
    <node id="『新月琉璃制直剑』"><data key="name">『新月琉璃制直剑』</data><data key="type">物品(武器)</data><data key="status">provisional</data><data key="desc">【新月琉璃制直剑】；攻击力4。将装备者敏捷的10％补加为攻击力。；在结晶格雷姆刚挥出拳头的瞬间，我就用剑横向对它的身体施以斩击。仅仅凭此一击，结晶格雷姆就被切成两半，上半身咣当一声掉落到地面。手感有如切断了一块塑料泡沫。</data></node>
    <node id="『耶梦加得之炎』"><data key="name">『耶梦加得之炎』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「──『我自衔尾，逡巡蹒跚，如梦似幻』『璀璨星辰，无限远泛，饕餮殄灭』、『耶梦加得之炎』－！！」；一道禁忌之炎在光之庭院内奔驰而过。</data></node>
    <node id="北之帝国"><data key="name">北之帝国</data><data key="type">地点(千年前北方国家)</data><data key="status">provisional</data><data key="desc">这无数的民众全都是兽人。而这座城市也与佩艾希亚相似。在我也熟悉的佩艾希亚大道上，以这名翠色的少女为中心，军队列阵前行庆祝着战争的胜利。；原因很容易就能猜得出来，大概是这个时期只有兽人才能进入北方之类的吧；「不是，我就说了我不是那个意思啊。她看上去真就给我这种感觉啊……可是，那毕竟是北之帝国的国王大人啊……」</data></node>
    <node id="『哀哭之仔的黑暗』"><data key="name">『哀哭之仔的黑暗』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——呵、呵呵，魔法『哀哭之仔的黑暗』。」</data></node>
    <node id="舞斗大会"><data key="name">舞斗大会</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">也就有了以战斗为业之人比拼实力决定何人立于顶峰的『舞斗大会』。；「是『一之月联合国综合骑士团舞会』的参加者是吧。那么，请在这里签字。」；「那是偶数月份举办的大会。一月的是『骑士团』向的，也就是组成三人小队进行淘汰战的模式。」</data></node>
    <node id="玛利亚已失去『眼睛』"><data key="name">玛利亚已失去『眼睛』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚自陈已没有『眼睛』，无法据此判断涡波是否说谎（『我只能相信你』）；涡波回应时看着玛利亚失去的双目——身体状态于本章对话中直接确认；「……我已经没有『眼睛』了。所以，我无法明白涡波先生是否在说谎。我只能相信你。」；我看着玛利亚失去的双目答道。</data></node>
    <node id="『寒冰·速成箭』"><data key="name">『寒冰·速成箭』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——应用魔法『寒冰·速成箭』。」；这是之前那个只能造出冰块的被我认为毫无价值的魔法『寒冰』的应用。；「——魔法『Ice·速成箭』。」</data></node>
    <node id="WindFluorite"><data key="name">WindFluorite</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">这次锻造中用到的魔石名为『Alexandrite』『WindFluorite』『VallkundtEmerald』等等等等⋯⋯──；缇缇细想起来，在构思的过程中她看向使用的魔石的残骸。</data></node>
    <node id="『紫苑』"><data key="name">『紫苑』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——神圣魔法『紫苑』。」</data></node>
    <node id="法芙拉河"><data key="name">法芙拉河</data><data key="type">地点(河川)</data><data key="status">provisional</data><data key="desc">将西北方的艾尔多拉琉与西南方的劳拉维亚分隔开来的河流名为『法芙拉』。；整个船队目前被分成了东西南北四个区域。我现在就在船队的『北』区。</data></node>
    <node id="火之余烬的披戴者"><data key="name">火之余烬的披戴者</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『火之余烬的披戴者』】</data></node>
    <node id="魔法屋"><data key="name">魔法屋</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">在距离酒馆不远处的地方就有一家『魔法屋』。；于是立刻带着她前往了劳拉维亚规模最大的魔法商店──魔法屋。；我们刚到入口便被拦下要求出示身份的证明。</data></node>
    <node id="【黑铠艾尔芬里德】"><data key="name">【黑铠艾尔芬里德】</data><data key="type">物品(武具)</data><data key="status">provisional</data><data key="desc">【黑铠艾尔芬里德】；装备者的敏捷-10％</data></node>
    <node id="MegistusBoots"><data key="name">MegistusBoots</data><data key="type">道具(靴)</data><data key="status">provisional</data><data key="desc">在这些东西的旁边还摆着给我使用的手套和靴子。可能是为了配合我的发色吧，这些东西的主色是黑色，然后上面用银线加以点缀。；「MegistusBoots」；装备者的敏捷+0.10</data></node>
    <node id="北铳王流古武术"><data key="name">北铳王流古武术</data><data key="type">技能武术(流派)</data><data key="status">provisional</data><data key="desc">「既、既然如此！那接下来就是『北铳王流古武术』！受死吧、『旋风击』！！」；毕竟是千年前使铳剑的支配之王的招式，叫这个名字也无可厚非。</data></node>
    <node id="柯尔库"><data key="name">柯尔库</data><data key="type">地点(港口城市)</data><data key="status">provisional</data><data key="desc">这里是瓦尔德本国东部的港口城市，名叫『柯尔库』；但是在远处一看，发现戒备十分森严。足足有五米高的墙壁围着城镇，全副武装的士兵们把持着关口。；果然，因为瓦尔德本国距离战场最近，所以警戒的等级很高。</data></node>
    <node id="属性魔法"><data key="name">属性魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">属性魔法2.09过捕护2.00续命2.23良机2.02</data></node>
    <node id="十三层"><data key="name">十三层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">和湿地生态的十三层截然不同</data></node>
    <node id="公会『绝世』"><data key="name">公会『绝世』</data><data key="type">组织(公会)</data><data key="status">provisional</data><data key="desc">「容我做一下自我介绍。我乃公会『绝世』的会长，艾尔米拉德·希达尔克。幸会。」；遵从他指示的所有人总是不忘在句尾加上一声「不愧是希达尔克家出身」。；他既是那个希达尔克家的长男，同时又是艾尔多拉琉学院的主席骑士、也是精锐云集的公会『绝世』的会长！</data></node>
    <node id="魔法石"><data key="name">魔法石</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">『表示』上说这个仄暗透明的结晶是『十位魔法石』。；十位魔法石九位魔法石；「啊，是浅层的魔石吗。这些的价值一律是一枚铜币。」</data></node>
    <node id="缇亚的基督依存与扭曲恋慕（ch69确认）"><data key="name">缇亚的基督依存与扭曲恋慕（ch69确认）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕与涡波回顾：失去『基督』的缇亚精神直接崩溃，对『基督』的依存到会看到幻觉的地步；失忆期涡波曾与缇亚约会（她一刻未松手）；莉帕断言『缇亚姐姐她也喜欢着大哥哥』且谁都不会接受涡波与别人在一起；涡波判断其感情扭曲程度不亚于玛利亚和斯诺；「呜嗯，人家没在开玩笑呢。听好了？缇亚姐姐她也喜欢着大哥哥，所以绝对不能去找她商量。」；失去了『基督』的缇亚，精神直接就崩溃了。缇亚对『基督』的依存，到了甚至会看到幻觉的地步。；她没有一刻放开过我的手。</data></node>
    <node id="飞翔翠石制轻铠路易芬理德"><data key="name">飞翔翠石制轻铠路易芬理德</data><data key="type">道具(防具)</data><data key="status">provisional</data><data key="desc">她指的是一副玛利亚和缇亚无法使用的给女性打造的轻铠。；与其说是铠甲不如说是复数板甲的集合体。一定要说的话应该是一整套的防具更好吧。；「嚯，品味相当不错嘛。那可是我倾尽心血打造的英雄风格的造型啊」</data></node>
    <node id="魔法（FlyShoots）"><data key="name">魔法（FlyShoots）</data><data key="type">技能魔法(风弹系)</data><data key="status">provisional</data><data key="desc">「说起来，你怎么不用在迷宫喊得贼起劲的那个『魔弹（FlyShoots）』了？」；「姆？啊啊，毕竟那招是涡涡教人家喊得，不是人家自己起的名字嘛。虽然用那个确实更强力一些⋯⋯但只要不是万不得已人家是不会用的」</data></node>
    <node id="法尼亚"><data key="name">法尼亚</data><data key="type">地点(国)</data><data key="status">provisional</data><data key="desc">满足上述条件的国家我记得有个叫『法尼亚』的。；「那可是相当远啊。我是从法尼亚过来的，您知道吗？」</data></node>
    <node id="魔石『诺文』"><data key="name">魔石『诺文』</data><data key="type">道具(魔石)</data><data key="status">provisional</data><data key="desc">只要运用『DistanceMute』，与魔石『诺文』相『连接』就可以了！也就可以『咏唱』出他的人生了！就这样在真正的意义上将挚友的剑『阿雷亚斯家的宝剑诺文』从手中挥出──！！</data></node>
    <node id="『斯特拉斯领域』"><data key="name">『斯特拉斯领域』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——神圣魔法『完全治愈』、神圣魔法『斯特拉斯领域』『神圣箭』『神圣箭』『神——」</data></node>
    <node id="【持有物品】"><data key="name">【持有物品】</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">【持有物品】；异象陡生，空间扭曲着将肉干吞没。</data></node>
    <node id="共鸣魔法『Flame・Aegis（守护炎）』"><data key="name">共鸣魔法『Flame・Aegis（守护炎）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">这个魔法是为了守护涡波先生的魔法。──那就叫它共鸣魔法『Flame・Aegis（守护炎）』好了；共鸣魔法『Flame・Aegis』；遍及回廊的火焰来回激荡，闯进领域内的怪物们一瞬间就被全数蒸发了。</data></node>
    <node id="魔力生成匮乏"><data key="name">魔力生成匮乏</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">接下来是因为失血导致的『魔力生成匮乏』。</data></node>
    <node id="第一百层"><data key="name">第一百层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">抵达迷宫的最深部，也就是第一百层的话，似乎就能『实现任何愿望』。</data></node>
    <node id="ExWind"><data key="name">ExWind</data><data key="type">技能(风魔法)</data><data key="status">provisional</data><data key="desc">「爆裂吧，『ExWind』！」；缠绕经由魔法生成的暴风，海莉化作最速之利箭奔驰而出。</data></node>
    <node id="复合咒术『咏唱』"><data key="name">复合咒术『咏唱』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">浸透世界的『咏唱』的原典之正式名字：以咒术『连接』（打穿世界制造洞穴）与咒术『维度』（支配世界）拼合、念出誓词（『于此起誓，种种罪过，吾当清偿』『纵此世之终结至来，此誓亦无毁弃之日』→『冀请赐吾予彼等救赎之力』）成立，从世界钻出的洞穴中摄取无限热量强行补足魔力；代价为溶解心灵的剧毒剧痛（本次经『最深部之誓约者』发动被后延）；涡波自述为创始者并进行了正式的『咏唱』（叙述者自述）；莱纳以一字之差（亦）许誓型成立——效果很小、除储备魔力外基本无作用，但仍完成某种『契约』并付出绝对无法无视的『代价』；浸透世界的『咏唱』的原典──它的正式名字为复合咒术『咏唱』；作为创始者我进行了正式的『咏唱』；「是矣！</data></node>
    <node id="『赤之护身符』"><data key="name">『赤之护身符』</data><data key="type">物品(魔法道具)</data><data key="status">provisional</data><data key="desc">【赤之护身符】；装备者的火属性抗性+20％</data></node>
    <node id="『绝冲风击』"><data key="name">『绝冲风击』</data><data key="type">技能招式(喊名)</data><data key="status">provisional</data><data key="desc">「接招吧、『绝冲风击』！」；虽然并没有在使用魔法，但缇缇却喊出了招式名。</data></node>
    <node id="『正道』"><data key="name">『正道』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">大抵都会选择通过『正道』直奔十五层。」；「既然如此，那你为何不在『正道』休息。少给我撒这种一捅即破的谎。」；听起来这条经过修缮的道路被称为『正道』</data></node>
    <node id="SehrFang"><data key="name">SehrFang</data><data key="type">魔法(风系)</data><data key="status">provisional</data><data key="desc">「『SehrFang』！」；四只风锥浮现在空中。上下各两只的风锥为了碾碎冰蛇而射出。</data></node>
    <node id="大洞"><data key="name">大洞</data><data key="type">地点(迷宫)</data><data key="status">provisional</data><data key="desc">最后就是位于第二迷宫都市中心的『大洞』了。；虽然据传闻来说，那里应该是一个充当『西之迷宫』的『大洞』，可是⋯⋯；在这之前，『大洞』应该修建有方便探索者潜入的石制阶梯吧，然而因为火红的熔岩，阶梯此时只剩下了几抹残骸。</data></node>
    <node id="医院"><data key="name">医院</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">为了保证医疗水平，我选定了瓦尔德规模最大的一家医院。</data></node>
    <node id="白石纱衣"><data key="name">白石纱衣</data><data key="type">道具(防具)</data><data key="status">provisional</data><data key="desc">在罗列于眼前的众多装备中，我首先审视的是玛利亚和缇亚专用的装备。；「白石纱衣」；防御力3对魔力3</data></node>
    <node id="断罪"><data key="name">断罪</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">神圣魔法3.78神之加护3.07断罪2.00集中收束2.02</data></node>
    <node id="Raked・Blade"><data key="name">Raked・Blade</data><data key="type">道具(诅咒剑)</data><data key="status">provisional</data><data key="desc">──Raked・Blade；攻击力5精神污染+1.50；一瞬间就像发生了化学反应般，剑开始喷发出薄雾。</data></node>
    <node id="『瓦尔法拉』"><data key="name">『瓦尔法拉』</data><data key="type">设施(移动剧场)</data><data key="status">provisional</data><data key="desc">『舞斗大会』的举办地是流经劳拉维亚国和艾尔多拉琉国的运河。比赛会在浮在运河上的巨型移动剧场『瓦尔法拉』里进行。；也就是说，要在不属于任何一个国家的地方举办，自然也不适用于任何国家的法律。犯罪者们也就可以不用在乎自己的罪名参加大会了。</data></node>
    <node id="鲜血魔法『威尔·琉克』"><data key="name">鲜血魔法『威尔·琉克』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——鲜血魔法『威尔·琉克』，神圣魔法『Light』！」</data></node>
    <node id="拉丝缇娅拉的年龄（三岁）"><data key="name">拉丝缇娅拉的年龄（三岁）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">就事实而言拉丝缇娅拉才三岁（『不是同龄或者稍微年幼一点的级别』/情感未发育健全阶段的常规判断——涡波视角）；涡波以原世界伦理（重罪意识）与『成恋人则难回原世界』为由对恋情却步；就事实而言，拉丝缇娅拉才三岁。正常来想的话，还是情感没有发育健全的阶段。；首先，拉丝缇娅拉才三岁。这不是同龄或者稍微年幼一点的级别。；要是跟拉丝缇娅拉变成恋人的话，在那之后，也就不能大手一挥就回到原来的世界里去了。</data></node>
    <node id="世界剧变：平均级别急升与魔石人类普及（ch213）"><data key="name">世界剧变：平均级别急升与魔石人类普及（ch213）</data><data key="type">设定(世界)</data><data key="status">provisional</data><data key="desc">「我现在已经没什么特别的了。这一年来，世界的平均级别有了急剧的提高。『魔石人类』也早已不足为奇。就凭现在的我⋯⋯举个例子来说，你身边的莱纳和守护者，想必都能在谈笑间将我打倒吧」</data></node>
    <node id="世界树（Yggdrasil）"><data key="name">世界树（Yggdrasil）</data><data key="type">地点(弗茨亚茨本国)</data><data key="status">provisional</data><data key="desc">可得尽快去把弗茨亚茨本国的『世界树（Yggdrasil）』给烧了才行呢；「事不宜迟那我们这就出发吧。目标是南方弗茨亚茨本国的世界树。去了那里的话，应该就能遇到被称为千年前的贤者的使徒迪普拉库拉了吧。如此一来，我们一定能获知击败『支配之王』的方法，说不定还能知道如何找到涡波先生──」</data></node>
    <node id="『讴歌不平的叛逆者』"><data key="name">『讴歌不平的叛逆者』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">——魔法『讴歌不平的叛逆者』。」</data></node>
    <node id="『诅咒』"><data key="name">『诅咒』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">我知道拉丝缇娅拉是以破坏『手环』为目的的。因此，『诅咒』在较早的阶段产生了反应。；我的『拟神之眼』感觉到此前一直在束缚涡波的『诅咒』消失了。</data></node>
    <node id="谒见室"><data key="name">谒见室</data><data key="type">地点(佩艾希亚城内)</data><data key="status">provisional</data><data key="desc">在我印象里那本应是她最为忌讳的场所。那是王的谒见室。；在谒见室最深处的王座——的后面，她以体育座的姿势待在那里。；对此，罗德点了点头。接着，她以稳健的步伐——坐·到·了·王·座·上。</data></node>
    <node id="『火焰箭』"><data key="name">『火焰箭』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「『火焰箭』！」；而被那道镭射击穿胴体的锯齿甲虫则是当场毙命；「我知道了。上吧，『火焰箭』！」</data></node>
    <node id="莱文（Reborn）教"><data key="name">莱文（Reborn）教</data><data key="type">组织</data><data key="status">provisional</data><data key="desc">根据这个大陆的主要宗教莱文（Reborn）教的传承，所谓『使徒』乃是神的代行者。；教会的神父将我唤作『使徒』并无比尊崇。</data></node>
    <node id="『亡灵一闪（Von·A·Wraith）』"><data key="name">『亡灵一闪（Von·A·Wraith）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——魔·法『亡灵一闪（Von·A·Wraith）』。」；也就是说这一剑，是连余光都不留寸分的一闪。</data></node>
    <node id="深渊次元的真夜（TheRiverineTonight）"><data key="name">深渊次元的真夜（TheRiverineTonight）</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「呵呵呵！两位都使用了了不得的魔法啊。不光剑法高超、连魔法也精通什么的，太犯规了吧。但是没用的！本身就是魔法的我要比大哥哥更擅长操纵这个魔法！——『深渊次元的真夜（TheRiverineTonight）』！！」；「对于大哥哥来说这是个有时间限制的魔法，但是我来用的话就没有那个限制了！！」；「欧尼酱，总之先解决掉这股风好了！──『深渊次元的真夜』！」</data></node>
    <node id="『焦热世界』"><data key="name">『焦热世界』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">——魔法『Flame·决战炎域』、魔法『焦热世界』！！」</data></node>
    <node id="中央广场"><data key="name">中央广场</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">走了几分钟之后我就找到了中央广场。</data></node>
    <node id="鲜血魔法『芬里尔·阿雷亚斯』"><data key="name">鲜血魔法『芬里尔·阿雷亚斯』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">从寄宿血中的数量过千的『人』的记忆中，我选择了剑圣『芬里尔·阿雷亚斯』。本来预定要提供给圣人再临的肉体，完全再现出了近代最强的剑士的实力。；如今年龄已近六十的剑圣芬里尔。他那世界最高峰的老练的剑术，如今降临在了世界最高峰的年轻肉体上。</data></node>
    <node id="旅店"><data key="name">旅店</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">她不但非法入侵了我所居住的旅店、一把将我扑倒、甚至还对我施加了魔法；我直接前往了店主告诉我的留宿价格最便宜的旅店。</data></node>
    <node id="希达尔克家"><data key="name">希达尔克家</data><data key="type">组织(贵族家门)</data><data key="status">provisional</data><data key="desc">他既是那个希达尔克家的长男，同时又是艾尔多拉琉学院的主席骑士、也是精锐云集的公会『绝世』的会长！；「并且，这对我来说也一样。身为希达尔克家的长男，我有着承受任何苦难的义务。为了希达尔克家，不管要踏上多么艰辛的道路我都不会犹豫。</data></node>
    <node id="『SehrWind』"><data key="name">『SehrWind』</data><data key="type">魔法(中级风魔法)</data><data key="status">provisional</data><data key="desc">「——『SehrWind』！」；那是我见过无数次的中级风魔法。是我惯于应付的引发暴风的魔法构筑。；以罗德那庞大的魔力释放出的『SehrWind』已经超越了暴风的等级——成为了爆炸的气浪。</data></node>
    <node id="『FlameFlamberge』"><data key="name">『FlameFlamberge』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『FlameFlamberge』！」</data></node>
    <node id="魔法『冻结』"><data key="name">魔法『冻结』</data><data key="type">魔法(冻结)</data><data key="status">provisional</data><data key="desc">──魔法『冻结』；我将海面冻住，在海上跑起来。</data></node>
    <node id="守护者"><data key="name">守护者</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">「没错，就是出现在迷宫十层和二十层的大Boss。」；那可是聚集了联合国最强的探索者也没能击败的怪物啊。</data></node>
    <node id="新月线形石"><data key="name">新月线形石</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">【新月线形石】</data></node>
    <node id="表示"><data key="name">表示</data><data key="type">系统机能(状态栏表示)</data><data key="status">provisional</data><data key="desc">就我来说，能够将属性的数值一直表示到小数点后两位。；即是状态栏上所无法『表示』的『数值无法表现的数值』。</data></node>
    <node id="泳衣（涡波手制八件）"><data key="name">泳衣（涡波手制八件）</data><data key="type">道具(衣物)</data><data key="status">provisional</data><data key="desc">纠结来纠结去，我制成的泳衣造型便自然地十分古朴，是用绳子固定泳衣的形式。；因为是以性能为优先的实用品，所以绝对不会发生游泳时脱落的问题的。</data></node>
    <node id="冰结魔法"><data key="name">冰结魔法</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">先天技能：剑术1.01冰结魔法2.00；冰结魔法：冻结1.00寒冰1.00；剑术4.89冰结魔法2.58+1.10</data></node>
    <node id="神之加护"><data key="name">神之加护</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">神圣魔法3.78神之加护3.07断罪2.00集中收束2.02</data></node>
    <node id="深翠之始"><data key="name">深翠之始</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『深翠之始』】；Str补正+0.10——</data></node>
    <node id="守护者的魔石"><data key="name">守护者的魔石</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">【守护者的魔石】；守护者缇达的魔力结晶</data></node>
    <node id="『始祖和魔王的魔剑BraveFluorite』"><data key="name">『始祖和魔王的魔剑BraveFluorite』</data><data key="type">道具(剑)</data><data key="status">provisional</data><data key="desc">『始祖和魔王的魔剑BraveFluorite』已向XiphiasSpear的背后斩去。；结果『始祖和魔王的魔剑BraveFluorite』砰地一下就从缇缇的双手中飞了出去。；而缇缇则打算利用这个机会去回收自己的佩剑。</data></node>
    <node id="『慕影死神（格林·利姆·莉帕）』"><data key="name">『慕影死神（格林·利姆·莉帕）』</data><data key="type">魔法(知性魔法·莉帕)</data><data key="status">provisional</data><data key="desc">──魔法『慕影死神（格林・利姆・莉帕）』 级别19──；我确认了一遍塞拉小姐和莉帕的状态。</data></node>
    <node id="鲜血魔法『海因・赫勒比勒夏因』"><data key="name">鲜血魔法『海因・赫勒比勒夏因』</data><data key="type">魔法(鲜血魔法)</data><data key="status">provisional</data><data key="desc">「──『GrowthExtended』！鲜血魔法『海因・赫勒比勒夏因』！再加上『CannonSehr』！！」；拉丝缇娅拉就着冲锋的势头全力释放出风魔法。</data></node>
    <node id="技能『魔力物质化』"><data key="name">技能『魔力物质化』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「……这个，我记得是叫技能『魔力物质化』？」；「诶？嗯，我好像是知道……咦？我是在哪里知道的来着。那个……」；在『魔力物质化』的加持下，剑身被延长了。</data></node>
    <node id="咒术『维度』"><data key="name">咒术『维度』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『维度』的诅咒形态：支配世界的『诅咒』，掌握次元之穴的深处；与咒术『连接』拼合构成复合咒术『咏唱』的基座；「──咒・术『连接』、──咒・术『维度』！！」；不过咒术『连接』确实钻出了次元之穴──，咒术『维度』掌握了次元之穴的深处──，</data></node>
    <node id="王近卫骑士团"><data key="name">王近卫骑士团</data><data key="type">组织(佩艾希亚·千年前王国近卫)</data><data key="status">provisional</data><data key="desc">「──请不要小看我们，我们乃荣耀的『王近卫骑士团』的一员。就算对手是团长殿下，也别想轻易从这里通过。」；从左边到右的级别依次为27，24，28，24──五人都是可以和我比肩的高级别人员。；这礼仪端正的姿态和那份强大的实力，让我不由的想起地上的『天上的七骑士』。</data></node>
    <node id="水晶魔法『Quartz』"><data key="name">水晶魔法『Quartz』</data><data key="type">魔法(水晶·地之理)</data><data key="status">provisional</data><data key="desc">──水晶魔法『Quartz』──；转换成了操纵水晶的『地之理的盗窃者』的魔力，侵蚀着飞舞的沙粒。；普通的石头变成了宝石，沙子变成了金砂，各种各样的东西纷纷转化为各种各样的矿物。全都由我的意志来决定。</data></node>
    <node id="风之铳剑"><data key="name">风之铳剑</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德·缇缇所持武器：与诺斯菲联手封路后自北侧现身时手持（本章首次独立成setting；ch0184/0194仅散见）；手持风之铳剑的罗德从北侧现身。</data></node>
    <node id="『维度・暗夜（Dark）』"><data key="name">『维度・暗夜（Dark）』</data><data key="type">魔法(暗系·莉帕)</data><data key="status">provisional</data><data key="desc">「我跟塞拉姐姐去会会它哦～。──魔法『维度・暗夜（Dark）』」；她们跑过的轨迹上残留下黑暗，扭曲了次元，逐渐封锁住敌人的视野。；充斥于现场的黑暗顷刻间全部消散。</data></node>
    <node id="『疾风弹』"><data key="name">『疾风弹』</data><data key="type">技能招式(风弹)</data><data key="status">provisional</data><data key="desc">「⋯⋯毕竟人命关天，没办法呢。贯穿、然后尽情奔驰吧！『疾风弹』！」；被铳剑刺穿的XiphiasSpear亟欲潜入水中逃匿。但没等它成功，缇缇的铳剑就已经在它体内射出了风之弹。；你要问我觉得『疾风弹』和『魔弹（FlyShoots）』哪个好</data></node>
    <node id="沃尔斯家"><data key="name">沃尔斯家</data><data key="type">家名·宅邸(伊丽莎白・沃尔斯本家)</data><data key="status">provisional</data><data key="desc">「绝对要找到他！这里离沃尔斯家很近！再等一下团长代理就会过来了！在此之前一定要拖住他！」；可是我用『维度』却找不到沃尔斯家，看来并不是沃尔斯家已经不存在了，而是时间太久房子发生了相当大的变化而已。；──大量的火花在沃尔斯家的前廊进发。</data></node>
    <node id="『注视』"><data key="name">『注视』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">所以我特意使用『注视』观察了一番。；我使用『注视』，比较自己和雷迪安特的数值。</data></node>
    <node id="共鸣魔法『冰・Aegis（守护冰）』"><data key="name">共鸣魔法『冰・Aegis（守护冰）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">共鸣魔法『冰・Aegis（守护冰）』；甲板上张开冰之结界，『次元・雪』于结界中飞舞。；模仿成功了。</data></node>
    <node id="中央剧场船"><data key="name">中央剧场船</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">它的入口宛如一道城门，城门周围则建有好几十个塔状建筑。跟其它的船只不同，它不是经由战舰修改而成，而是从一开始就作为剧场船建造的。</data></node>
    <node id="『Impulse』"><data key="name">『Impulse』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「这样吗……我还是觉得无属性的『Impulse』最合适。这个是比较正规的攻击魔法。」；「——『Impulse』！！」；戴在脚尖的魔法道具碎裂，振动魔法的冲击奔袭于我的右腕。</data></node>
    <node id="Dimension•曲战演算（Difference）"><data key="name">Dimension•曲战演算（Difference）</data><data key="type">技能(次元魔法)</data><data key="status">provisional</data><data key="desc">——『Dimension•曲战演算（Difference）』！！；就跟次元属性的『次元之冬』差不多。；在此基础上，只要使用『Dimension·曲战演算』稍稍调整一下二者攻击的轨迹就可以了。调整的距离不到一厘米，但效果显著。</data></node>
    <node id="ChromeGlove"><data key="name">ChromeGlove</data><data key="type">道具(手套)</data><data key="status">provisional</data><data key="desc">在这些东西的旁边还摆着给我使用的手套和靴子。可能是为了配合我的发色吧，这些东西的主色是黑色，然后上面用银线加以点缀。；「ChromeGlove」；装备者的技巧+0.10</data></node>
    <node id="『FlameCutter』"><data key="name">『FlameCutter』</data><data key="type">魔法(炎系·拉丝缇娅拉)</data><data key="status">provisional</data><data key="desc">「唔，你这──『FlameCutter』！」；「『FlameCutter』『FlameCutter』『FlameCutter』！！」</data></node>
    <node id="魂之水晶"><data key="name">魂之水晶</data><data key="type">物品(矿物)</data><data key="status">provisional</data><data key="desc">「我记得它是在西边很远处的灵山那里出现的怪物来着。这矿物的级别相当高，名字叫『魂之水晶』。嘿~，原来在迷宫里也能入手这个东西啊。」；「使用你之前委托打造的那把剑就能斩断的。『新月线形石』作为矿物比『魂之水晶』要更为优秀。寄宿的魔力量大有不同。」</data></node>
    <node id="耶梦加得之炎"><data key="name">耶梦加得之炎</data><data key="type">魔法(火焰系)</data><data key="status">provisional</data><data key="desc">「──『耶梦加得之炎』」；话音刚落，自少女体内进发的火焰便齐聚为一头炎龙。；炎龙翻身飞出，沿着『大洞』盘旋而上并灼烧着附在内环上的一切。不，灼烧这个词不够准确，火龙那登峰造极的热量让所过之处全部被熔解为了岩浆。</data></node>
    <node id="绿之克星"><data key="name">绿之克星</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得了称号『绿之克星』】</data></node>
    <node id="诈术"><data key="name">诈术</data><data key="type">技能(欺骗系)</data><data key="status">provisional</data><data key="desc">后天技能：诈术1.33交涉1.06──；得到了技能『诈术』；因为不能用《Dimension》所以花了不少时间。然而，我终于夺尽了男人的『诈术1.33』，并到达了『诈术1.34』</data></node>
    <node id="【队伍】"><data key="name">【队伍】</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">迪亚布罗·西斯加入了队伍</data></node>
    <node id="王的谒见室"><data key="name">王的谒见室</data><data key="type">地点(魔王城)</data><data key="status">provisional</data><data key="desc">罗德正待在城堡的中心位置。那是在我印象中应本应是她最为忌讳的场所。；那是王的谒见室。；伴随着Baki的声音玉座的顶端部分被捏碎了。然而罗德并不在乎，她继续喊道。</data></node>
    <node id="白樱"><data key="name">白樱</data><data key="type">道具(联络媒介·树木)</data><data key="status">provisional</data><data key="desc">源头是我们附近的──在绿化活动中被种植而成的开着白花的『树』；果然，『木之理的守护者』艾德要想实现留恋，作为姐姐的缇缇的存在是不可或缺的──从『白樱』那儿传来的声音，令我如此确信。</data></node>
    <node id="复合鲜血魔法『假想诺文・阿雷亚斯』"><data key="name">复合鲜血魔法『假想诺文・阿雷亚斯』</data><data key="type">魔法(鲜血·复合)</data><data key="status">provisional</data><data key="desc">「──复合鲜血魔法『假想诺文・阿雷亚斯』！」；拉丝缇娅拉使出的魔法是昨天特训的成果。；拉丝缇娅拉的剑率先斩裂了伽鲁夫纳多杰里的躯体。</data></node>
    <node id="次元之晖昀"><data key="name">次元之晖昀</data><data key="type">魔法(光系)</data><data key="status">provisional</data><data key="desc">──『维度・决战演算』、『次元之晖昀』！！</data></node>
    <node id="『开辟之华炎』"><data key="name">『开辟之华炎』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">『开辟之华炎』！！」</data></node>
    <node id="光之御旗（NosfiFLAG）"><data key="name">光之御旗（NosfiFLAG）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲临战所持光之旗（自南侧现身时手中握着）；称号形态本章两见：『光之御旗（诺斯菲）』（行311·胜利未来中）与『救世之御旗』（行362·与『支配之王』并称）；即千年前『南』之最强战力、地上传说的『勇者』；首先，手中握着光之旗的诺斯菲自南侧现出了身影。接着、；自诞生以来便宿命不凡，在死后缔造的传说依然被歌颂不绝的『支配之王』与『救世之御旗』──；伴随着这句话，诺斯菲手中旗帜的光芒变得更加耀眼。</data></node>
    <node id="本土"><data key="name">本土</data><data key="type">地点(大陆)</data><data key="status">provisional</data><data key="desc">我们终于抵达了『本土』。；跟身为开拓地的东部大陆不同，被称作『本土』的大陆基本上都经由人手开发过了。这里存在着十余个大国，到处都是历史悠久的市镇。；「……我们接下来将抵达的『本土』是这个世界上最大的大陆。在那里以『北方』和『南方』为界，正进行着世界上最大规模的战争。而瓦尔德本国就处于这场战争的最前线。」</data></node>
    <node id="『管理领域之外』"><data key="name">『管理领域之外』</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">「这里可是迷宫，而且还是在『管理领域之外』的地方。你应该有所觉悟了吧，小鬼。」；我之前是走在『管理领域之外』，所以才会遭到人的攻击</data></node>
    <node id="联合国的一夫多妻制"><data key="name">联合国的一夫多妻制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕：联合国里有不少一夫多妻制国家，富商和贵族中尤其普遍；莉帕据此提议涡波迎娶全员（后宫）以维持船上平衡；涡波以现代日本不认可/自己是日本人/憧憬纯爱为由拒绝；「在联合国里有不少一夫多妻制的国家呢。特别是富商和贵族当中尤其普遍哦？」；现代日本是不认可一夫多妻的，我是日本人。有坚决拒绝的理由。；「我绝对要贯彻纯爱……所·谓·的·人，必·须·跟·唯·一·的·命·运·之·人·结·合……」</data></node>
    <node id="LightKnife"><data key="name">LightKnife</data><data key="type">技能(光魔法)</data><data key="status">provisional</data><data key="desc">「正是如此，请您立刻同意。——『LightKnife』。」；诺斯菲莞尔一笑，随即咏出魔法。光聚集在她手中形成了一把看上去就很锋利的小刀，接着她将小刀比在我的脖子旁边。；「正是如此，请您立刻同意。──『LightKnife』」</data></node>
    <node id="始祖和魔王的魔剑BraveFluorite"><data key="name">始祖和魔王的魔剑BraveFluorite</data><data key="type">道具(魔剑)</data><data key="status">provisional</data><data key="desc">超重、超硬、壊不了──以这三项原则打造的魔剑。；「始祖和魔王的魔剑」；攻击力7</data></node>
    <node id="不会消失的火焰"><data key="name">不会消失的火焰</data><data key="type">物品</data><data key="status">provisional</data><data key="desc">其二是在第十层获取『不会消失的火焰』。</data></node>
    <node id="御殿"><data key="name">御殿</data><data key="type">地点(佩艾希亚·魔王城王座大厅)</data><data key="status">provisional</data><data key="desc">既然王座坐镇于此——那就意味着这里是位于城堡中央的御殿。；殿内只有两扇门。其一为臣民谒见之际使用的大门，其二为王座后方为王所专用的门。；饰有华奢刺绣的红色地毯自大门开始向王座延展。</data></node>
    <node id="『境界战争』"><data key="name">『境界战争』</data><data key="type">战争</data><data key="status">provisional</data><data key="desc">稍稍用『维度』确认了一番，结果明白了他们是在议论「那个开拓地的英雄来到了这里」云云。他们投向我的眼神里充满了对英雄参加『境界战争』的期待。</data></node>
    <node id="『Firefly·阳炎』"><data key="name">『Firefly·阳炎』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『Firefly·阳炎』。这样就能看清楚了。」；不光是我们，玛利亚也能看得一清二楚。虽然她的双眼只是义眼，但可以利用火焰收集周围的信息。</data></node>
    <node id="『次元雪』"><data key="name">『次元雪』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">这便是『Foam』和『Freeze』的组合技。要命个名的话，那就叫魔法『次元雪（Di·Sonw）』好了。</data></node>
    <node id="称号『彷徨于地上之人』"><data key="name">称号『彷徨于地上之人』</data><data key="type">概念(称号)</data><data key="status">provisional</data><data key="desc">【获得称号『彷徨于地上之人』】；地魔法补正+0.50</data></node>
    <node id="冻结魔法『利特尔降雪』"><data key="name">冻结魔法『利特尔降雪』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">我服下了冻结魔法『利特尔降雪』的魔石，但是没有发生任何变化。</data></node>
    <node id="『阿雷亚斯流剑术』"><data key="name">『阿雷亚斯流剑术』</data><data key="type">技能魔法(流派)</data><data key="status">provisional</data><data key="desc">「是啊，到『舞斗大会』开始之前，你就把我的阿·雷·亚·斯流剑术精进到大师的水平吧。」；换言之，就是挥剑时要将时间、重心移动、轨迹的误差全部缩小至亿分之一以下。</data></node>
    <node id="历基亚国"><data key="name">历基亚国</data><data key="type">国家</data><data key="status">provisional</data><data key="desc">「斯诺大人会哭！？⋯⋯不不，就算您说不许进入、可是接下来还有怪物讨伐的报告书以及招待塞斯提亚和历基亚国公主的事情要处理啊！」</data></node>
    <node id="黑云"><data key="name">黑云</data><data key="type">设定(现象·世界之毒)</data><data key="status">provisional</data><data key="desc">「你说什么⋯⋯是那个不会消散的黑云吗⋯⋯？」；「正是。从世界中泄漏出来的毒，为了寻找宿主而彷徨于世，而后就变作了这些黑云。因为这个原因，世界上所有的生物的级别都会变得易于上升。概而言之就是非常危险。另外，虽然只是推测，不过『兽人』的出生率应该也会上升吧」；「抱歉，会长。原理这种深层次的东西就实在不是咱能弄清楚的了。不过，咱推测地表的崩壊应该是招致这场异变的关键。由此看来的话，这次的诱因应该就是一年前的『大灾厄』了吧。至于更深层次的原因，恐怕只有使徒大人和圣人大人她们，又或者是会长你自己才知道了」</data></node>
    <node id="魔石船『LivingLegend』号"><data key="name">魔石船『LivingLegend』号</data><data key="type">载具(魔石船)</data><data key="status">provisional</data><data key="desc">在魔石船『LivingLegend』号的甲板上，我尽情地享受着海风的吹拂。；驶向本土的航程可谓一帆风顺。；在我和莉帕将船的航行稳定下来之后，我们在拉丝缇娅拉的主导下分配好了各自的房间。</data></node>
    <node id="代价咏唱体系"><data key="name">代价咏唱体系</data><data key="type">概念</data><data key="status">provisional</data><data key="desc">即使没有MP也能释放魔法的方法。以记忆为代价的咏唱，以感情为代价的咏唱，以生命为代价的咏唱。；将过去当做薪柴，令现在燃烧得更加旺盛。这正是火炎魔法的神髓。；「就算你这么问、只是因为这一年来支付『代价』的『咏唱』已经成为了世界的一般常识了呀。我想但凡是使用魔法的人基本都知道的⋯⋯」</data></node>
    <node id="直感"><data key="name">直感</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">先天技能：直感1.77</data></node>
    <node id="达利尔"><data key="name">达利尔</data><data key="type">地点(第二迷宫都市·本土中央)</data><data key="status">provisional</data><data key="desc">踏上了前往位于本土中央的『第二迷宫都市达利尔』的旅途；「是的，然后再经『达利尔』前往北方的『佩艾希亚』」</data></node>
    <node id="『世界冰蛇』"><data key="name">『世界冰蛇』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『将此星辰一饮而尽』！『世界冰蛇』！！」</data></node>
    <node id="十五层"><data key="name">十五层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">大抵都会选择通过『正道』直奔十五层。」</data></node>
    <node id="十层"><data key="name">十层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">这里正所谓是我的体内。说整个十层就是我本人之写照也不为过。」；能在迷宫里安全地调度火焰的地方可只有这里哦？而且怪物也不会出现在这里。</data></node>
    <node id="并列思考"><data key="name">并列思考</data><data key="type">技能</data><data key="status">provisional</data><data key="desc">因为『并列思考』是妹妹的才能，因此现在的我在思考上没有多少余力。；可能失去技能『并列思考』对我来说并不是弱化，而是一种强化吧。</data></node>
    <node id="WindFlamberge"><data key="name">WindFlamberge</data><data key="type">技能(风魔法)</data><data key="status">provisional</data><data key="desc">「——『WindFlamberge』！」；SkyWolf的身体被一刀两断，化作光芒消失了。</data></node>
    <node id="弗茨亚茨大圣堂"><data key="name">弗茨亚茨大圣堂</data><data key="type">地点</data><data key="status">provisional</data><data key="desc">其占地面积足足有三个东京巨蛋那么大，外侧围有人工护城河</data></node>
    <node id="斯诺不擅长对付守护者"><data key="name">斯诺不擅长对付守护者</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺过去因守护者缇达有过惨痛经历（『原因似乎是那个战斗狂搞的』——涡波推测为其埋头迷宫探索时期）；玛利亚此前也说过类似的话（涡波回想）；但斯诺宣言若与守护者缇达有关便不再逃避；看来，斯诺不擅长对付守护者啊。；「嗯。以前，因为守护者缇达的关系有过比较惨的经历——」；「——但是，果然我还是要努力一下。我觉得如果与守护者缇达有关的话，自己不能再去逃避了。不然的话，是没法继续前进的。」</data></node>
    <node id="魔力变换（LevelUP）"><data key="name">魔力变换（LevelUP）</data><data key="type">魔法(神圣系)</data><data key="status">provisional</data><data key="desc">「『汝者，刮目自省而可也』！『此间光辉』，『乃是生命飘渺虚幻之一瞬』──！！」；对吧，罗德！！──神圣魔法『魔力变换（LevelUP）』！！」；得到了所有这一切的帮助，缇缇『LevelUP』了。</data></node>
    <node id="Light•幻影（Phantom）"><data key="name">Light•幻影（Phantom）</data><data key="type">技能(光魔法)</data><data key="status">provisional</data><data key="desc">——光魔法『Light•幻影（Phantom）』。；而LizardFlyer了无踌躇地继续在闪光中突进，并用它们那锋利的翅膀将诺斯菲的身体斩断——看上去如此，可实际上却只是掠过了她的身体，就像穿过了三维影像一样。</data></node>
    <node id="『缇娅拉大人的血』"><data key="name">『缇娅拉大人的血』</data><data key="type">圣遗物(血液)</data><data key="status">provisional</data><data key="desc">一年前，大小姐和我确实是为了找到『缇娅拉大人的血』而回到弗茨亚茨的。；「『缇娅拉大人的血』非常特殊。就算是被洒到荒郊野岭，她的血也会自行活动向圣杯回笼。像这样、咕噜咕噜～⋯⋯的感觉。为了防止血重新回到圣杯之内，帕林库洛便将血散播到了『人』这一容器之中，如此一来血就无法再聚集到同一个地方了」</data></node>
    <node id="《寒冰》"><data key="name">《寒冰》</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">冰结魔法：冻结1.00寒冰1.00；「我试试，上吧！冰结魔法《寒冰》！」；这是之前那个只能造出冰块的被我认为毫无价值的魔法『寒冰』的应用。</data></node>
    <node id="『LimitBreak・SehrWind・G・EndBurst』"><data key="name">『LimitBreak・SehrWind・G・EndBurst』</data><data key="type">技能魔法(风属性大魔法)</data><data key="status">provisional</data><data key="desc">──风魔法『LimitBreak・SehrWind・G・EndBurst』哦哦！！；接着，从其它方向诞生的又一道暴风也席卷而成。随后还有第三道、第四道──从四面八方而来的暴风汇合在一处。成百上千的暴风络合在一起，不到一秒便化作了覆盖整个海域的巨型龙卷风。；缇缇那精准无比的魔力操作让龙卷风的攻击对象局限于怪物之上。</data></node>
    <node id="血术"><data key="name">血术</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">魔法战斗2.27血术5.00神圣魔法1.03；魔法战斗2.27血术5.00神圣魔法1.03；但是拉丝缇娅拉的血中记录着多种多样的魔法和经验。</data></node>
    <node id="『Dimension·黑泡沫（Nightmare）』"><data key="name">『Dimension·黑泡沫（Nightmare）』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">——魔法『Dimension·黑泡沫（Nightmare）』！</data></node>
    <node id="勖兮奋哉、吼哮不绝之焰"><data key="name">勖兮奋哉、吼哮不绝之焰</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">贝丝与雷纳尔多以同样咏唱释放的同样魔法之一（火焰系大魔法咏唱名）；祖孙同术释因于『流着相同的血』（据雷纳尔多语）；才一口气的功夫，火焰属性与地属性的大魔法便纵横交错，缠绕着火焰的剑与斧更是被挥舞得激烈无比。；「──『勖兮奋哉、吼哮不绝之焰』！『焦土踏破、疾驰无息之魂』！」</data></node>
    <node id="LightStuff"><data key="name">LightStuff</data><data key="type">技能(光魔法)</data><data key="status">provisional</data><data key="desc">「涡波大人！——魔法『LightStuff』！！」；然而连同窗户在内的所有出口都被拼成格状的光棒锁死了。所有的光中都蕴含着多得扯淡的魔力，让我逃无可逃。；「涡波大人！──魔法『LightStuff』！！」</data></node>
    <node id="十四层"><data key="name">十四层</data><data key="type">地点(迷宫层)</data><data key="status">provisional</data><data key="desc">「——嗯，这么听来，十四层的怪物好像不是很多啊。」；和湿地生态的十三层截然不同，十四层简直是不毛之地；十四层的高温会夺去人体的水分。</data></node>
    <node id="『神圣箭』"><data key="name">『神圣箭』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——神圣魔法『完全治愈』、神圣魔法『斯特拉斯领域』『神圣箭』『神圣箭』『神——」</data></node>
    <node id="异邦人"><data key="name">异邦人</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「嗯？从我的角度来看，基督你的技能有五个，分别是『剑术』『冰结魔法』『次元魔法』『异邦人』和『？？？』，怎么了？」</data></node>
    <node id="『ImpulseBreak』"><data key="name">『ImpulseBreak』</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">「——『ImpulseBreak』！」；既然已经出现了不由斯诺给予最后一击就无法打倒的怪物，我便需要避免自己一个人前进。；「——『ImpulseBreak』！！」</data></node>
    <node id="艾尔多拉琉"><data key="name">艾尔多拉琉</data><data key="type">地点(国/势力)</data><data key="status">provisional</data><data key="desc">据芙兰琉莱所言，她们似乎是迷宫西侧的国家艾尔多拉琉的学生。</data></node>
    <node id="『炎之矢・散花（FallFlower）』"><data key="name">『炎之矢・散花（FallFlower）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">自群星（Flame・Ageis火焰阵）倾泻的雪白之雨：无数近似于光线的火焰魔法坠落于庭院，击碎所有泡沫、贯穿肉眼看不到的『某物』——露洁诺瓦露的魔法包围网仅一瞬间灰飞烟灭；『炎之矢』的群体散射形态（共鸣魔法的本命之箭）；「『炎之矢・散花（FallFlower）』！」；紧接着，雪白之雨自群星倾泻而出。；暴虐的火焰魔法击碎了在庭院中展开的所有泡沫，贯穿了肉眼看不到的『某物』。露洁和诺瓦露精心打造的魔法包围网，仅在一瞬间便灰飞烟灭了。</data></node>
    <node id="迷宫创立真相（救阳滝计划）"><data key="name">迷宫创立真相（救阳滝计划）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（记忆内）千年前战争以无人死亡收场后，始祖涡波与缇娅拉共同制定救阳滝计划：将其他『理的盗窃者』的魔石一一抽取、以其全部提升阳滝身体的限界值→将世界所有『魔力』灌注其体→带往『最深部』升华至超越『怪物』的更高次元以治其病与假死（始祖认可西斯『集中魔力』之说本为『治疗』）；为此打造『迷宫』——让被大陆吞噬的『魔石』『想起收束（Drop）』（※与ch79『回想收束』近名，用语两形待终审统一）的系统+开拓通往世界最深部的道路；始祖以『魔力净化（LevelDown）』千年为代价将自己的魔石放入阳滝体内暂取主导权（『次元与水之理的盗窃者』/合称『时空水流的盗窃者』），以正确顺序收集魔力变换以避免怪物化、抵</data></node>
    <node id="迷宫探索进度·第五次（ch191）"><data key="name">迷宫探索进度·第五次（ch191）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">两人队伍（涡波+莱纳）第五次探索：经『连接』通过'到五十七层尽头为止的捷径'，抵'放眼望去传世纯白的空间'；因诺斯菲的魔法周围怪物不多且均无敌意；'通往五十六层的楼梯就在眼前'；通过到五十七层尽头为止的捷径。；回到了放眼望去传世纯白的空间。；多亏了诺斯菲的魔法，周围的怪物数量不多。虽然也有能够目视到怪物不过都没有敌意。通往五十六层的楼梯就在眼前。</data></node>
    <node id="升级与祈祷制度"><data key="name">升级与祈祷制度</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">等级概念公共知识（图书馆常见记载）；升级非自动：需①运气好持有相应技能者（如拉丝缇娅拉）或②信仰虔诚者多年修行（公共机关/教会神父）施行；祈祷本身是升级的一环（神父颂祷含升级咏唱）——故宗教把持升级、联合国由宗教指示建成（主角推断）；一般生活至其年龄应有3级左右；「嗯，在这边这个世界，只有运气不错的人持有相应的技能。再有就是信仰虔诚的人经过多年的修行也能掌握相应的能力。；这是因为祈祷本身是升级的一部分所致。</data></node>
    <node id="贵族义务论与涡波的平民幸福论(第四轮对撞)"><data key="name">贵族义务论与涡波的平民幸福论(第四轮对撞)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾尔米拉德：身为贵族不轻松，斯诺明白义务才成为沃克家养女，须以全部人生实现贵族义务并引以为荣；长男有为家族承受任何苦难的觉悟。涡波反驳：『更加微小！更加谦逊！更加平和的幸福也存在于世上』——夺人自由加以束缚的思考方式全看不惯（把本应宣泄给诺文和斯诺的话全部宣泄而出）；「身为一名贵族而活并不是件轻松的事。但是，斯诺是在明白这一点的情况下，才成为了沃克家这一大贵族的养女。所以就算斯诺为此感到痛苦，也是当然的。；「更加微小！更加谦逊！更加平和的幸福，也是存在于世上的不是吗！？为什么贵族就是不明白！？为什么非要执着于『英雄』啊！？艾尔米拉德！！」</data></node>
    <node id="守护者魔石亲和性力量机制（ch120实证+推测）"><data key="name">守护者魔石亲和性力量机制（ch120实证+推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">实证：守护者的魔石与使用者稍微有点亲和性即得本章级力量（宝剑Quartz）；推测：与魔石同化/结合的玛利亚和帕林库洛具同级别、可颠覆一国经济水平的实力；守护者的魔石与使用者之间稍微有点亲和性就有这种程度的力量。；那么与魔石同化的玛利亚和帕林库洛，应该也具有同级别的力量。；想想与守护者的魔石结合后发生剧变的玛利亚和帕林库洛，就觉得还差得远。</data></node>
    <node id="斯诺龙化战斗形态全貌"><data key="name">斯诺龙化战斗形态全貌</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">鲜血魔法FlySophia 咏唱发动：血雾成龙形包裹→苍翼撑裂衣服→浅紫色魔力波状浸透全场（一瞬间支配）→苍色龙腕（坚硬皮肤+浓厚魔力挡缇亚魔法，代价灼伤）；『龙之风』=纳入全场风的异物（束缚/加速）；『龙之翼』+龙之风=炮弹级加速；『纠缠性质的魔力』反向压迫；Impulse·Howling=龙鳞+咆哮化振动凶器（震颤结界/撼动瓦尔法拉与大海/Dragon·Ardor=凝缩振动球经龙之风安定化解放）；臂力经龙化毫无疑问世界首位；一对苍翼撑裂衣服在她背后伸展开来。络合在一起的斯诺的魔力呈螺旋形膨胀，浅紫色的魔力以波状浸透到整个竞技场。；「——『Impulse·Howling』！」；「为什么，你们</data></node>
    <node id="『庭师』与『老师』——姐弟本有人生"><data key="name">『庭师』与『老师』——姐弟本有人生</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇缇对艾德：无论『支配之王』还是『宰相』、说到底都只是『过家家的游戏』、并非二人应有的姿态；人家是『庭师』、而你是一个『老师』——那才是真正该走过的人生；草原世界无需王与宰相，两人回去像孩子一样生活；姐弟如亡灵徘徊于一千年后的世界、宛如迷了路的孩子，皆因承受不起王传说与北方诸国之重量；「无论是『支配之王』还是『宰相』，说到底都只是『过家家的游戏』⋯⋯并不是我们应有的姿态。人家是『庭师』，而你是一个『老师』⋯⋯那才是我们真正该走过的人生。回想一下那片草原吧，艾德。『王』和『宰相』什么的，对那个世界来说全无必要。让我们回到那里，两个人一起生活吧。就像孩子一样⋯⋯」；「人家已经把那个什么『支配之王</data></node>
    <node id="『境界战争』南方总况（ch222）"><data key="name">『境界战争』南方总况（ch222）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">南方视角：非最前线但柯尔库=南方诸国重要据点/海军司令部/补给中继点；两大联盟交战前途多舛（有玉石俱焚之忧）；异常的报告、战域、事态如过江之鲫充斥门庭；克洛伊感到『时代更替的风头浪尖、至今为止的常识全部被打碎换新』的预感；虽然称不上是本土『境界战争』的最前线，但这里毫无疑问是南方诸国重要的据点。；『北方同盟』和『南方联盟』之间进行的这场『境界战争』，说明白点可谓前途多舛。</data></node>
    <node id="诺文梦的报偿结构(赞扬即真愿)"><data key="name">诺文梦的报偿结构(赞扬即真愿)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">临终梦揭示真愿最终形态：每日修练的报偿=孩子们的赞扬（好厉害/真努力）+挚友在场——非荣光非家名；愿望实现/报偿得到/留恋消失→人生最幸福笑容的道别与安眠；『这个微笑就是他的人生并非没有意义的证明』（千年时光后终得报偿）；这个微笑就是他的人生并非没有意义的证明。；经过了千年的时光、栗发的少年诺文·阿雷亚斯得到了报偿。</data></node>
    <node id="莱文教与异世界的传承知识（ch116）"><data key="name">莱文教与异世界的传承知识（ch116）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉（莱文教现人神）与缇亚：莱文教传承中有暗示异世界存在的文献；与莱文教关系匪浅者一定程度上知晓异世界存在；传承载『异邦人』被认为是超出『理』之外的来访者、且能更容易地抵达『理』（传承暧昧、详情不明）；始祖缇娅拉或与异世界有联系（推测态）；此情报弗茨亚茨图书馆未藏，莱文教地位甚高者所言可信性不低；「嗯，有的。在莱文教的传承中，有暗示异世界存在的文献⋯⋯」；即使在弗茨亚茨的图书馆里也没有得到这份情报。因为她们都是莱文教中地位甚高之人，所说的话可信性不低。；「姑且来说，在莱文教的传承中『异邦人』这一存在，被认为是超出『理』之外的来访者⋯⋯⋯确实记载着异邦人能够更容易地抵达『理』来着」</data></node>
    <node id="迷宫30-34层地理（ch70更新）"><data key="name">迷宫30-34层地理（ch70更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">30层=水晶花田消失、变无机质辽阔石质空间（'换了一副面貌'）；31层=沙海（格雷姆与鱼形怪物游荡/水晶披甲难对付；怪物经验值高——一只约1000点）；32层=复归走廊状+天花板异常高+走廊内流小河（水晶河底），飞行系怪物增多（唤起22层里约鹰苦战记忆）；33层=河流浅滩为主、水栖系怪物增多（矿物系高防减少）；34层=本话首探终点；30层也是换了一副面貌。原本的水晶花田不见了踪影，只剩下了无机质的辽阔石质空间。；沙海无限远泛。格雷姆与鱼形怪物在沙漠中游荡着。；当然，也存在跟之前不一样的地方。天花板异常得高，走廊内流着小河。</data></node>
    <node id="迷宫40层『大草原』"><data key="name">迷宫40层『大草原』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">阶梯下行壁色由深绿转黄绿，尽头为广阔『大草原』：无任何障碍、脚边几十厘米高的草、潮湿、凉爽风拂面、目视可从一端望到尽头；守护者未出现、空无一人（据推断守护者已被海莉唤醒且仍存活——若被打倒则应像其他守护者房间一样连草都不长）；无威胁时是单纯没意思的世界，被队伍用作狩猎间的休息场；那是一片『大草原』；只靠目视就能从这一端望到尽头。但是40层守护者却并没有出现。；如果有别人将守护者打倒了的话，这里就会像其他守护者的房间一样连草都不长的。</data></node>
    <node id="『想起收束（Drop）』"><data key="name">『想起收束（Drop）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波为迷宫施加的新术式：'只要在迷宫里，任何人都能轻松做到'；以魔石为中心、空气中的魔力聚集构成肉体而使人再生——直接再生则苏醒者继承其最后的记忆；不加干预则再现'原原本本的他们'；对升天后的魔石（有人格无自我）再次发动亦可将之唤醒；罗德评价'何等骇人的魔法'；[魔石？说起来，涡波说过迷宫里施加了一个叫『想起收束（Drop）』的新术式来着……说只要在迷宫里，任何人都能轻松做到……也就是说，这些魔石是……]；这就是『想起收束（Drop）』。何等骇人的魔法。；直接让魔石再生的话，那么苏醒的人会继承最后的记忆。</data></node>
    <node id="33层地形与怪物构成（ch119）"><data key="name">33层地形与怪物构成（ch119）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">33层构造大多是河流和浅滩；与之联动敌人种类变化：矿物系高防怪物减少、水栖系怪物变多；涡波预期'水系的怪物对火焰的耐性应该很强'被实战推翻——'不过就是点水，在压倒性的热量面前没有任何意义'，接触光线瞬间即被彻底蒸发，水栖矿物无异。※与库内 ch0071 记录（33层祭坛群/34层石制回廊覆水及膝）不合，存疑留终审；33层的构造大多是河流和浅滩，顺应着这一变化，敌人的种类也不一样了。；矿物系的高防怪物减少，水栖系的怪物变多了。；水系的怪物对火焰的耐性应该很强。</data></node>
    <node id="帕林库洛体内使徒与『勒伽西』称呼（据海莉）"><data key="name">帕林库洛体内使徒与『勒伽西』称呼（据海莉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉（经涡波转述）：『你的体内现在有一名使徒的存在』；涡波称情报来源为『同样是使徒的勒伽西』——『勒伽西』此处指帕林库洛本人（姓氏称呼形，ch0147 已录艾德称呼形）还是其体内使徒，原文两可【存疑分开建，待 R4】；涡波欲借决战使帕林库洛吐出该使徒所知的西斯情报（据称态）；据海莉所说，你的体内现在有一名使徒的存在；我确实想从同样是使徒的勒伽西口中打探西斯的情报</data></node>
    <node id="技能《感应》机制（ch115实证）"><data key="name">技能《感应》机制（ch115实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">超越《理》预测未来光景、于平常日子察觉《死亡》威胁（'感知到世界之《理》的剑士的直觉'）；发动时佩剑《阿雷亚斯家的宝剑诺文》闪耀；系'从挚友身上继承而来'；与《Dimension》并用使感觉'比常人要敏锐一倍'（察觉玛利亚/斯诺的好感）；涡波信赖其判断（'不觉得判断会错'——死亡预判'肯定会发生对我而言不太好的事'）；技能《感应》超越了《理》，预测出未来的光景。；感知到世界之《理》的剑士的直觉，在这样平常的日子里察觉到了《死亡》的威胁。；我不觉得技能《感应》的判断会错。</data></node>
    <node id="舞斗大会的爱之奖励传统"><data key="name">舞斗大会的爱之奖励传统</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">大会传统：『对女性献以爱意的勇士，用手中胜利获得无上奖励』——艾尔米拉德每场献爱之誓约演出即此传统的体现，观众沸腾、运营方感激；「在『舞斗大会』中有着『对女性献以爱意的勇士，用手中胜利获得无上奖励』的传统！而希达尔克卿正是将此传统予以体现的骑士！在每一场比赛中讴歌着对斯诺大人的爱，让无数的观众为之沸腾！作为大会的运营方真是感激不尽！！」</data></node>
    <node id="魔石人类（JewelCross）病理与『再诞』仪式（ch71·据称）"><data key="name">魔石人类（JewelCross）病理与『再诞』仪式（ch71·据称）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉诊断：魔石人类特有症状=榨尽体内魔石能量→体内空空如也半死不活；失血过多并发魔力缺乏症（MP不轻易恢复）；魔石人类本就短命（海莉'身体内部破烂不堪'、余命恐不足半年）；吞魔石可暂复（海莉吐血时取魔石欲吞）。『再诞』：圣人缇娅拉的仪式、据拉丝缇娅拉/海莉称帕林库洛模仿之欲令海因再诞；因尸体材料不足补充『基督·欧亚』的血而失控；海莉身体向女性性征转变（原因不明）；再现满是漏洞（海因记忆残缺）；拉丝缇娅拉断言'圣人缇娅拉的『再诞』魔法怎么可能是帕林库洛模仿的来的'；「这是『魔石人类（JewelCross）』特有的症状。由于榨尽了体内魔石的能量，她的体内变得空空如也。……简单来说，她已经半</data></node>
    <node id="诺文剑术的特性（ch120论析）"><data key="name">诺文剑术的特性（ch120论析）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：一般剑术以人类规格为假想敌，诺文的剑术却以巨船级怪物为假想敌挥剑、彻底只用剑战斗；据涡波：诺文无法使用魔法，故不论何时都只能用剑解决问题；然而诺文的剑术却是以这艘船这么大的怪物为假想敌挥剑的；但是这个剑术是彻底地、只用剑战斗的技能。这太异常了；诺文他无法使用魔法啊，所以才不论何时都只能用剑去解决问题的呢</data></node>
    <node id="王之肖像画"><data key="name">王之肖像画</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">此前在保管室看到的、绘有完美的王之英姿的画；本章其碎片漂浮在罗德身边，被罗德以过大规格的暴风彻底粉碎；之前曾在保管室里看到的一幅画如今正漂浮在罗德身边。；那是绘有完美的王之英姿的──肖像画的碎片。；将绘画彻底粉碎。</data></node>
    <node id="涡波的通缉状态与劳拉维亚人脉"><data key="name">涡波的通缉状态与劳拉维亚人脉</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据本章：涡波在联合国'基本都是通缉状态'，去显眼地方恐被沃克家之类发现→无法寻访更有名的锻冶师（艾利巴茨建议落空）；另一面：曾以史诗探索者会长身份守护劳拉维亚，'这个国家就像自家的庭院一样'——全国工房与优秀锻冶师分布尽知；另因诺文之福'狠狠赚了一笔'（资金宽裕）；「但是，我在联合国，基本都是通缉状态⋯⋯⋯去了显眼的地方，被沃克家之类的发现的话会很麻烦的⋯⋯」；对于曾经以『史诗探索者』会长的身份守护过劳拉维亚的我来说，这个国家就像自家的庭院一样。；但是多亏了诺文的福，现在狠狠赚了一笔。旅行中也有了不少闲暇。也多了很多需要装备的同伴。</data></node>
    <node id="缇娅拉大人的血（回收进度ch221更新）"><data key="name">缇娅拉大人的血（回收进度ch221更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">被散播出去的『缇娅拉大人的血』这一年持续蒐集，现已收集约九成：拉丝缇娅拉体内四成、床上魔石人类少女体内约五成，只差几个人（再过一个月、快则几天可齐）。血现处沉眠状态故安全；唤醒必须准备像圣诞祭那时候一样的大型仪式。体内有一定量的血可令寻找持有血的『魔石人类』更容易、抽取血的作业也不难。代价=缇娅拉大人的感情会影响宿主（拉丝缇娅拉昨日对基督冷淡之因——莱纳据塞拉说法指摘，拉丝缇娅拉自认知晓其感情是使命）。；我们这一年里一直在蒐集被散播出去的『缇娅拉大人的血』。；目前在我的身体里有四成，那边那孩子的体内差不多有五成]；因为我体内有一定量的血的话，寻找拥有『缇娅拉大人的血』的『魔石人类』也会容易一些</data></node>
    <node id="魔弹『风之矢・散花』"><data key="name">魔弹『风之矢・散花』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德咏唱构筑的魔弹（FlyShoots/FallFlower）：翠色魔法阵随咏唱加速巨大化、双翼伸展洒落翠羽，魔法阵应声进散、翠线全部分解为无数绿点=『风之矢』，坠落如骤雨倾盆；射穿瓦砾后轨迹于极下方偏转、如活物不断变轨尾随目标；风矢数可达三百四十四（据涡波演算）；「『加速、而后进溅』、『花碎之瓣全数作风驱驰』！──魔弹（FlyShoots）『风之矢・散花（FallFlower）』！！」；冠以子弹之名的魔法随此宣言一同构筑完成。；那无数的绿点──无一例外皆是『风之矢』</data></node>
    <node id="柯尔库（ch224）"><data key="name">柯尔库（ch224）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本土正处于战争，但柯尔库安全、「战火绝对不会烧到柯尔库城下」（据克洛伊）；最大理由为代理总司令斯诺・沃克镇守；涡波一行与芙洛拉船队同样以此为目的地，翌晨抵达柯尔库港；「确实本土正处于战争，但『柯尔库』是安全的。战火绝对不会烧到柯尔库城下。请放心吧，涡波大人、芙洛拉殿下」；「毕竟镇守『柯尔库』的，可是我们的代理总司令──斯诺・沃克大人啊！无论发生什么问题，斯诺大人都会予以解决的！！」；而她这把握得恰到好处的诅咒也成为了我在抵达『柯尔库』港的前夜听到的最后一句话──</data></node>
    <node id="西斯的神圣魔法铁壁（光翼·光盾·光腕）"><data key="name">西斯的神圣魔法铁壁（光翼·光盾·光腕）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">足以包裹身体的光翼+伸缩自如的光腕+神圣魔法产生的大量防御膜——涡波全开诺文剑术的超高速剑闪（'没有剑士能够防住'级）仍无法够到；『维度』找出的防御薄弱处亦无法以剑突破——'单纯的在物理上没有丝毫的间隙'；战术弱点线索：相当厌恶背部被击（夹击中始终护背站立）；在这种夹击的情况下，西斯不经意间保护背部着背部就这样站着。；撇开这些不说，还有光腕在等着，这防御可以说宛如铁壁一般。；恐怕这个世界上没有剑士能够防住这个剑术，就算如此，也没能够到西斯。</data></node>
    <node id="瓦尔德本土航路（ch130）"><data key="name">瓦尔德本土航路（ch130）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">船位=联合国西南方的海上（联合国之外），正向瓦尔德本土航行中——与船旅死亡预告/瓦尔德本土追讨线同轨；「这里是联合国西南方的海上。现在在朝瓦尔德本土航行中」</data></node>
    <node id="魔法效果随想象改变"><data key="name">魔法效果随想象改变</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">酒馆魔法使谈话：魔法的效果随想象改变——『维度·决战演算』即例证（近战特化的想象衍生）；在酒馆听魔法使聊天的时候，有谈到魔法的效果随想象改变的话题。</data></node>
    <node id="守护者留恋与消逝规则（本章呈现）"><data key="name">守护者留恋与消逝规则（本章呈现）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者怀有『留恋』：诺斯菲预期『若能得到涡波大人的抚摸，那我便能消失』并以守护者使命未完自解未消失；以留恋为由的请求，明知守护者相关规则的守护者无法拒绝（罗德无法拒绝诺斯菲的称赞请求）；留恋了结与否为守护者存续关键——本章三度试探（抚摸/摸头/称赞）均未实现，诺斯菲不明自身留恋为何；「那么，就拜托您了。请您触碰、抚摸我吧。哪怕只有一次，若能得到涡波大人的抚摸，那我便能消失了吧。是啊，我的愿望真的仅此而已」；既然明白守护者相关的规则，那么罗德便无法拒绝。；但看来我作为守护者的使命还没有完成呢。⋯⋯为什么会这样呢。⋯⋯是啊，到底为什么会这样呢</data></node>
    <node id="魔法『■道落土（Lord・Of・Lord）』"><data key="name">魔法『■道落土（Lord・Of・Lord）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的领域魔法（■为原文脱字，判例3原样保留）——本章确认'构建于周围的《■道落土（Lord·Of·Lord）》已经被解除'；随之风之道途和墙壁消散，世界重归一无所有的虚无之空；曾几何时间，构建于周围的《■道落土（Lord·Of·Lord）》已经被解除。；风之道途和墙壁也都已消散，世界重归一无所有的虚无之空。</data></node>
    <node id="『本土』"><data key="name">『本土』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">相对东部开拓大陆（联合国侧开拓地）的被称作『本土』的大陆：基本上经人手开发过，存在十余个大国，到处是历史悠久的市镇；东北部为瓦尔德本国东端（海崖/绝壁/难涉足森林/黄土绿草平原）；涡波观感与联合国附近开拓地无太大区别；我们终于抵达了『本土』；跟身为开拓地的东部大陆不同，被称作『本土』的大陆基本上都经由人手开发过了。这里存在着十余个大国，到处都是历史悠久的市镇。；这里就是『本土』。说实话，我觉得跟联合国附近的开拓地没什么太大的区别。</data></node>
    <node id="迷宫六十六层(天空阶层)与风龙封锁"><data key="name">迷宫六十六层(天空阶层)与风龙封锁</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">纯粹天空阶层（'没有回廊和错综复杂的路径，就是纯粹的天空'）；『Dimension』探测：草原直径二十公里、边缘石壁+天花板包围、高约一千米、中央螺旋阶梯（长约同高）上下端洞穴通各层——封闭空间出入口仅此二洞穴+崖边高位『Connection』门（'以高位的次元魔法（Connection）为基础，辅以更高位的次元魔法打造'+空间固定，密度远超涡波之作）；镇守者=风龙艾尔芬里斯（位阶67）盘踞空中阻通往六十五层的阶梯；66-67层除风龙外无一匹怪物、无法升级（自下而上攻略超出迷宫设计前提——'迷宫是为了将挑战者向『最深部』引导而创造的'）；往下（67层）通行无障碍但有两只更大规格的龙；罗德三策：</data></node>
    <node id="迷宫60~66层环境与怪物配置(ch91)"><data key="name">迷宫60~66层环境与怪物配置(ch91)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫阶层特色：十层『火炎』/三十层『水晶』/四十层『草原』/六十层『光』（柔和光/大理石地面光滑如瓷砖/白色光晶飘升；六十一层之光则刺眼）；66层=空之世界、艾尔芬里斯镇守中央螺旋阶梯；65层=以阶梯为主体构成的三维迷宫、LizardFlyer（可回避一切物理攻击/以风中和敌方魔法攻击/以风为感觉器官故对光魔法敏感）；64层=GreenHighElement（精灵系/索敌范围广/瞬移接近）；63层=PaleGriffin（狮鹫兽/并非畏惧死亡的生物故『交流』无效）；62层=PiercePigeon（羽毛为流光魔力/轻盈）；59层石材发光刺眼影响视野；57层回廊宽五十米且一路直通上层；被罗德之风</data></node>
    <node id="『世界奉还阵』完全解放与召唤库（ch160更新）"><data key="name">『世界奉还阵』完全解放与召唤库（ch160更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据帕林库洛：阵范围囊括本土的一半、变换对象远不止战场上这几万人——几十万乃至成千上万的活物都将被吞噬到大陆之内作为召唤'库存'（此前被烧毁的远非全部）；召唤速度此前被其有意抑制、完全解放后越来越快且无法制御（暴走因其之故，据帕林库洛言）；阵『中心』内LevelDown无法避免，唯『理的盗窃者』加护例外——持『地』魔石者与持诺文剑者不受侵蚀，放开魔石的涡波亦不受影响（第三魔石存在之证）；「那不是当然的吗！被烧毁的那些还远远不是全部！『世界奉还阵』的范围可是囊括了本土的一半之多，变换对象远远不止战场上这几万人！几十万──不，成千上万的活物都将被吞噬到大陆之内！哈哈，库存可还多的是呢！？」；由此可见</data></node>
    <node id="忘却扩散（Reverse）"><data key="name">忘却扩散（Reverse）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德首次构筑的非风属性咒术（自述『跟风属性不同』）；在城堡周边卷起旋风，触及者瞬间化作齑粉/光粒，残留魔石升空；罗德以此令『这里』国民全部退场；──咒术『忘却扩散（Reverse）』！！；触及旋风的人，都在一瞬间化作了齑粉；罗德要让存在于『这里』的国民全部退场</data></node>
    <node id="复活阳滝计划（千年计划概要）"><data key="name">复活阳滝计划（千年计划概要）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">始祖涡波主导（技术=缇娅拉的抽魂术式）的千年计划全貌：①先经『魔力净化（LevelDown）』——让大陆将阳滝的身体也吞噬并将级别净化为1级（预定耗时一千年，年数当时计算中），净化结束后才进入下一阶段；②将『水之理的盗窃者』与『次元之理的盗窃者』两颗魔石放入阳滝的身体，始祖涡波以自己的魔石暂时取得主导权、驱使其身体前往世界的『最深部』（合称案：『次元与水之理的盗窃者』，'干脆合起来叫『时空水流的盗窃者』'）；③将其他『理的盗窃者』们的魔石一一抽取，用全部魔石提升阳滝身体的限界值（扩展承受魔力的器皿容量以避免怪物化）；④在『迷宫』中按合理（正确）顺序逐个收集被『想起收束（Drop）』的『魔力』和</data></node>
    <node id="赫勒比勒夏因家（兄弟结构）"><data key="name">赫勒比勒夏因家（兄弟结构）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳为赫勒比勒夏因家辈分最小的弟弟，海因为其兄长（'海因兄长'）；莱纳以'海因兄长的代替'自居向拉丝缇娅拉明确立场、请求被告知可告知海因之事（海因为拉丝缇娅拉方可被告知一切之人=其教育者）。海因亲族与七骑士席位的既有关联本章未涉。；他是赫勒比勒夏因家辈分最小的弟弟莱纳。；你大可以将我看作海因兄长的代替，我也正有此意。；所以我希望你能把觉得可以告知海因兄长的事都告诉我]</data></node>
    <node id="『LivingLegend号』（ch224）"><data key="name">『LivingLegend号』（ch224）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主帆于先前怪物袭船战中挂彩；克洛伊提议由船队以备用帆布缝纫凑合修缮；涡波一行泊留客船期间由船队精锐进行修复与牵引；为船队解围之后，虽然我们想要尽快离开，但考虑到『LivingLegend号』的主帆已经挂彩所以是没机会实现了。；在我们被带进房间休息的这段时间，『LivingLegend号』会由船队的精锐们进行修复和牵引工作，所以大可放心休息。</data></node>
    <node id="HP代价魔法体系"><data key="name">HP代价魔法体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">阿尔缇传授玛利亚的火炎魔法（世界炎蛇/FlameFlamberge）=同时消耗HP与MP之魔法（MP尚存亦夺HP；不减最大HP但单次即削）——与主角『MP枯竭后以最大HP补偿』（ch0006）机制不同源；玛利亚：反正被攻击就会当场牺牲故HP多少无所谓（效率主义生死观）；「没错。阿尔缇教给我的两种魔法『世界炎蛇』『FlameFlamberge』是同时消耗HP和MP的魔法。</data></node>
    <node id="缇亚-使徒同体对话持续（涡波推测）"><data key="name">缇亚-使徒同体对话持续（涡波推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波推测：缇亚状态一直有些奇怪'恐怕就是因为一直在跟使徒对话的缘故'，'即使是身体被夺走的现在也依旧在继续着对话'——同境况举证（'既然缇亚都没有放弃，那我也不能'）；作战上'在与使徒西斯的战斗中，唤回缇亚的意识恐怕是最关键的'、玛利亚的声音更易传达；缇亚的状态之所以一直有些奇怪，恐怕就是因为一直在跟使徒对话的缘故。并且即使是身体被夺走的现在也依旧在继续着对话。；在与使徒西斯的战斗中，唤回缇亚的意识恐怕是最关键的。</data></node>
    <node id="『绝冲风击・改』"><data key="name">『绝冲风击・改』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇缇在敌人正上方将剑劈下所放的新技（自称'之前虽然没好好握住，不过这次可不一样了！'——与ch223海上决战其『绝冲风击』斩击被XiphiasSpear坚硬鳞片弹飞佩剑一节相衔接）；仅仅如此就产生了广域魔法的效果：震耳欲聋的爆炸声中以巨型西瓜虫所在位置为中心、公路被砸成环形山口地貌，敌人被砍个稀烂利索断气；缇缇自愁用剑的全力攻击拿捏不好力道（大剑未习惯）；「──之前虽然没好好握住，不过这次可不一样了！接招吧、『绝冲风击・改』！！」；仅仅如此就产生了广域魔法的效果。随着一道震耳欲聋的爆炸声，以巨型西瓜虫所在位置为中心，公路被砸成了一座环形山口的地貌。当然，敌人也被砍了个稀烂，非常利索地断气儿了。</data></node>
    <node id="风魔法『风』（罗德）"><data key="name">风魔法『风』（罗德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德将基础魔法中的基础『风』钻研至登峰造极：基础咏唱『玉座既临路一条』『残躯已化风束千』式（『玉座既临路一条』『残躯已化风千束』『孤以此生铭此愿』『遍历悠世凭徒步』——不久前向涡波/莱纳讲授魔法时用过）后一瞬间改变整个天候、放出与上位魔法『Sehr・Wind』同等力度的广范围强风；无咏唱接二连三连发——以风调节体势平衡（『W・I・N・D』）、空中打造『埝板』立足、引导剑刃无视惯性连袭；其失重空间般剑舞已达别种技能水准（涡波评：应以『风剑术』形容）；罗德主张只要将基础钻研至登峰造极就无所不能；──『玉座既临路一条』。『残躯已化风千束』、『孤以此生铭此愿』『遍历悠世凭徒步』！；「──风魔法『风』。</data></node>
    <node id="涡波与莱纳的地上位阶（20级以上·怪物领域）"><data key="name">涡波与莱纳的地上位阶（20级以上·怪物领域）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本章叙述：'我和莱纳都是超过20级的存在'；'在地上与其说是「英雄」不若说是到达了「怪物」这种让人畏惧的领域的存在'——两人的地上威胁定位自述（两大高手房内闹战'世界最顶级'的战力注脚）；我和莱纳都是超过20级的存在。；在地上与其说是「英雄」不若说是到达了「怪物」这种让人畏惧的领域的存在。</data></node>
    <node id="即死魔法的同构与空隙（亡灵一闪／■道落土／前日谭）"><data key="name">即死魔法的同构与空隙（亡灵一闪／■道落土／前日谭）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺文『亡灵一闪（Von・A・Wraith）』、罗德『■道落土（Lord・Of・Lord）』、涡波『次元决战演算『前日谭』』三者同构：无法回避无法防御的即死魔法；共同弱点=准备动作耗时太久。■道落土因罗德单人强行使用（本应两人共鸣），在铺『道路』的魔法与『流星』坠落的魔法之间横亘巨大空隙——涡波据此判断'机会唯有这一次'，于构筑完成前一瞬迈步狂奔；魔法『■道落土（Lord・Of・Lord）』与『亡灵一闪（Von・A・Wraith）』一样，毫无疑问都是无法回避无法防御的即死魔法。；那就是准备动作耗时太久了。；也就是说，这也是无法回避无法防御的即Si魔法。</data></node>
    <node id="魔力=毒与怪物化机制（据涡波自述）"><data key="name">魔力=毒与怪物化机制（据涡波自述）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『魔力』其实是『毒』；'积攒太多『魔力（毒）』的话就会变成『怪物』'；因无人察觉无人援手→西斯复活与记忆复苏未能阻止；涡波崩壊时间线：海莉邂逅时间点附近已现预兆→吃下艾德的魔法为决定性→'在那个时候，毫无疑问我就已经壊掉了'（据涡波自述，接海莉'货真价实的崩壊'预言）；因为我没能察觉到『魔力』其实是『毒』这一点，所以没能阻止使徒西斯的复活和记忆的复苏。；积攒太多『魔力（毒）』的话就会变成『怪物』这件事，等注意到的时候已经迟了。；在与海莉邂逅的时间点附近崩壊的预兆就已经出现了，吃下艾德的魔法则是决定性的。在那个时候，毫无疑问我就已经壊掉了。</data></node>
    <node id="魔王城旅店规则与罗德公职"><data key="name">魔王城旅店规则与罗德公职</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『魔王城』旅店：一天十枚铜币/间；'之后支付的铜币数量越多房间的规格也会越大'；厨房浴场可自由使用（十枚铜币因此算便宜实惠）。配套法（罗德自言'这条法律是人家刚刚想好的'，'毕竟人家可是国王哟'）：露宿会被逮捕、被捕关三天禁闭——自警团负责执行。罗德公职自述：'虽然确实是国王，但是人家的工作是『庭师』哦。另外副业则是自警团的工作'。全城市民的铁制品由雷纳尔多一人负责修理（涡波帮工预定）。；「谁让你们没问人家嘛～。⋯⋯啊，对了！如果你们想使用城堡里的房间的话，就收你们一天十枚铜币好了～。从今天开始，『魔王城』旅店就正式开始营业啦～」；『顺带一说，如果被逮捕的话就要关三天的禁闭！这条法律是人家刚刚</data></node>
    <node id="『魔王』"><data key="name">『魔王』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">己方对罗德的称呼（据涡波于本章悟得其因果）；另涡波自述『剑术』因与『魔王』的数秒剑闘而大幅成长——该处所指待终审挂接（判例1 不自动合并）；虽然只有数秒的时间，但是拜与『魔王』的剑闘所赐，我的『剑术』已经成长到了前所未有的高级别。；此时此刻，见到这一幕，我终于明白作为『支配之王』的罗德被敌人唤作『狂王』，被己方称为『魔王』的因果。</data></node>
    <node id="涡波与拉丝缇娅拉的契约与角色分工（ch114重申）"><data key="name">涡波与拉丝缇娅拉的契约与角色分工（ch114重申）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：契约内容=《让我过得开心》；《英雄》是她要扮演的角色（'可不要抢戏呀'），涡波=她的物语的《主人公》；她不要求涡波当英雄、不收谢罪（'作为同伴的话互相帮助是理所当然的，道歉反而让人困扰'）；她感激涡波让她认识到《我是我自己》；涡波评其思考方式'了不起'（叹服）；契约的内容是《让我过得开心》。并没有要你做什么《英雄》哦。不如说，那是我要扮演的角色可不要抢戏呀；作为我的物语的《主人公》还是很努力了哦。涡波让我认识到了《我是我自己》这一点。；作为同伴的话互相帮助是理所当然的，道歉反而让人困扰。</data></node>
    <node id="守护者的使命与迷宫根源（诺文证言）"><data key="name">守护者的使命与迷宫根源（诺文证言）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者被赋予实现留恋的机会+使命=将人类引导至一百层；一百层寄存异常的『力量』（实现任何愿望的传闻）——守护它还是转让它诺文亦不知；守护者强度固定=与所在阶层相符（'三十层的boss不符合三十层该有的强度人类会很困扰'）；迷宫对人类很体贴=由『一个很体贴的人』创造（'不能说是谁创造的『规则』'——诺文识得创造者：'这不合那个人的风格'）；守护者向探索者提供情报有『规则』限度；状态栏与技能概念=千年前诺文死前不久才流传开来；『技巧』『素质』数值与技能习得相关（数值高则掌握易）；「这个嘛，我也不是特别了解。我知道的，就只有自己被赋予了实现留恋的机会，同时作为交换，我有将人类引导至一百层的使命。」；</data></node>
    <node id="共鸣剑术与即兴共鸣魔法机制"><data key="name">共鸣剑术与即兴共鸣魔法机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">共鸣剑术＝只有使用相同的『剑术』才能实现的同调+只有以同一个人为师才能做到的共鸣（'虽然不能说是共鸣魔法，但是亦可以称之为共鸣剑术'）；两人即兴使出的剑技可达'被唤作技的领域'（涡波莱纳首例=阿雷亚斯流共鸣剑术『雪风』）；共鸣魔法侧——莱纳未经任何练习即接受涡波冷气、双方魔法络合，仅即兴便完成凶恶共鸣魔法（次元之冬・朔风）；这是只有我们两人才能使出的剑技，是只有使用相同的『剑术』才能实现的同调，是只有以同一个人为师才能做到的共鸣。虽然不能说是共鸣魔法，但是亦可以称之为共鸣剑术，感觉到这一点，我喊道：；莱纳接受了我的冷气。不可思议的是，明明没有经过任何练习，我们的魔法便络合在一起，仅在即兴之下便</data></node>
    <node id="技能『最深部之誓约者』（前『？？？』）的本质与打造缘起"><data key="name">技能『最深部之誓约者』（前『？？？』）的本质与打造缘起</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波（取回记忆后的认知）：该技能不是夺取感情的技能、没有寄宿『恶意』；本质＝『真正的成长』——为了不仰赖『级别』这种浮于表面的东西而特别打造、为了让其不论发生什么都绝对不会放弃拯救阳滝；缘起＝『始祖涡波』痛感内心脆弱（灵魂易在命运面前屈服、被比自己还小的『缇娅拉』所救而后悔不甘），为让心灵脆弱的自己能跨越挫折而打造；'它不是为了不让『涡波』死掉而存在的技能。这个技能『？？？』是为了不让『阳滝』死掉而存在的'——为将阳滝送往最深部而造的尚未完成失败作；「并且这个技能也不是夺取感情的技能！也没有寄宿什么『恶意』！！」；这个技能的本质并不是对感情的废弃。这是为了不仰赖『级别』这种浮于表面的东西而特</data></node>
    <node id="次元决战演算『先谭』效果定性（ch209）"><data key="name">次元决战演算『先谭』效果定性（ch209）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自述：契机可能系先谭之力，'那可不是这么便利的魔法。只是效果浅薄的『未来视』——仅仅只是知晓可能性的魔法'，胜因归为跨越试练的成长；据诺斯菲推测：其为'将符合自己心意的未来化作现实的魔法'（误认，'连命运都能操控在手'）；战斗前使用时'魔力沁入世界之中'故易被『维度』感知；这是『将符合自己心意的未来化作现实的魔法』⋯⋯？」；但是，那可不是这么便利的魔法。只是效果浅薄的『未来视』──仅仅只是知晓可能性的魔法而已。；不，搞不好，魔法『次元决战演算『先谭』』是特别容易感知到的魔法也说不定。毕竟在战斗之前使用的时候，我就感觉到自己的魔力沁入世界之中了。</data></node>
    <node id="手环的代用品本质"><data key="name">手环的代用品本质</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">手环=为了释放某种魔法的代用品（与涡波见识过的魔法道具就是一样的）——魔法的发动无法被阻止（『次元之冬』也阻止不了）；暗属性大魔法消耗超负荷→龟裂→破碎；破碎=诅咒消失条件；这个『手环』就是为了释放某种魔法的代用品。；因此，魔法的发动是无法被阻止的。就算是『次元之冬』也阻止不了。</data></node>
    <node id="『英雄』涡波传闻（联合国东北扩散·ch135）"><data key="name">『英雄』涡波传闻（联合国东北扩散·ch135）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据菲洛（原骑士·了望手）听闻的传闻：最近流入耳中——现身联合国东北的『英雄』逸闻，'缔造出等同于神话伟业的超越人类领域的『英雄』'；其名曰『剑圣』『最强』；身负众多异名：『屠龙者（DragonSlayer）』『守护者杀手（GuardianKiller）』『迷宫记录保持者（DungeonHolder）』『蜃气楼统率者MirageGuildMaster』『剑圣后继者』『雪之骑士』『天然英雄』『圣女花婿』『历代最强』『舞闘大会冠军』等——因异名太多人们直接称呼其为『英雄』，'再优秀的勇者在他缔造的伟业面前也会黯然失色'；菲洛判断船上少年'可能就是那位『英雄』本人了'并断定'根本没有胜算可言'。本章新</data></node>
    <node id="勒伽西家的别墅"><data key="name">勒伽西家的别墅</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">位于离海很远的平原郊外（经广场与市场可达）；勒伽西家长期不使用的产业，被西娅队伍擅自借用；木制朴素、家居品少、走廊天花板结蜘蛛网、各处积尘老旧；大门至门口经最低限度打扫；客厅（有大桌子）平时不用、积灰由莱纳以风魔法清理。；似乎别墅在距离海边很远的地方。；走过了广场和市场，来到了靠近平原的郊外。那里建有一幢了不起的大别墅。；「这就是勒伽西家的别墅了。话是这么说，只是因为长期不使用的缘故，现在被我们擅自借用一阵子罢了」</data></node>
    <node id="阿尔缇与联合国的合作契约"><data key="name">阿尔缇与联合国的合作契约</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">阿尔缇=与联合国成合作关系的守护者（瓦尔德侧）——知情者屈指可数；瓦尔德与阿尔缇间有契约（帕林库洛不能对其行动出手干涉的国际掣肘）；在ch0016祭典的介入被帕林库洛评为『能帮着添柴的类型』；「咦、那不是、与联合国成合作关系的守护者、瓦尔德的阿尔缇吗？」</data></node>
    <node id="莱文教（ch72侧写）"><data key="name">莱文教（ch72侧写）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">联合国军以莱文教为主要宗教（北方亦有信奉国）；信徒发自内心地相信千年前战争的历史记载（缇娅拉/西斯胜利史观）；拉丝缇娅拉（曾为莱文教所迫险些失去性命）以「就因为是自家人所以才能做出严格的判定」力挺其为『很优秀的宗教』（与大陆其他宗教相比挺干净）；涡波侧证：初濒死时受莱文教骑士们救助+海因和塞拉的行为品性、训诫无强制性只引导行善；千年前战争真相疑（涡波批判立场）；原奴隶男子型虔诚信徒（西斯大人再临膜拜骚动）；「哎呀哎呀，涡波你会那么想也没办法啦。不过，信仰着莱文教的人可是发自内心地相信着这一历史记载的哦，希望你不要给它批判得太狠了呢。对于活在当下的人民来说，莱文教姑且是『很优秀的宗教』啊。」；拉</data></node>
    <node id="北方"><data key="name">北方</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">联合国的敌国（新兴国）：艾德卷走资金人脉逃亡于此；'就好像千年前的传说再现一样'立『支配之王（Lord）』为王、艾德任宰相；急速强大致『境界战争』再激化；涡波判读：艾德欲使千年前『北方』与『南方』之战重演（北方=千年前之战的一方）；逃到了我们的敌国北方那儿去了；那个新兴国可真厉害；并且，如果我的猜想没有错的话──他这么做都是为了让千年前的『北方』与『南方』的战争重新上演。</data></node>
    <node id="涡波的记忆流入与自我掩埋机制（自述）"><data key="name">涡波的记忆流入与自我掩埋机制（自述）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波自述：异常感自劳拉维亚出发后立马感到，跨越与诺文的战斗得到新力量后，力量'勒住自己的脖子'（像向更厉害的某人借来）；'当超越界限的时候，那个『假面男子』的记忆就会流入我的体内'，越超越人类界限（级别与状态）流入越强；每做一次梦新记忆便'把我的记忆，感情，身体完全掩盖'；升级积存的是『壊的东西』而非『经验值』；接下诺文『亡灵一闪』实赖'身上本来没有的记忆与经验'防下；那个异常感是从劳拉维亚出来后立马感到的。；当超越界限的时候，那个『假面男子』的记忆就会流入我的体内。；然后，每当做一次梦，新的记忆就会掩埋我。把我的记忆，感情，身体完全掩盖。</data></node>
    <node id="『维度』（Dimension）"><data key="name">『维度』（Dimension）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波核心感知/演算魔法（本章用例）：察觉以超高速射来的子弹；与远程武器相性好、完全掌握风弹弹道全数避开；对磁力结界作出分析并意识到危险性（联动『感应』警报）；确认天空被开大洞；集中於罗德一人（魔力不浪费方针）；与原世界知识一同判明罗德魔法正体；接下来我的魔力不能有丝毫的浪费。与诺斯菲有关的问题全部交给莱纳处理，我将『维度』集中到罗德身上。；就在这时、『维度』察觉到了以超高速向我射来的子弹。；但我使用的『维度』与远程武器的相性很不错。我完全掌握了风弹的弹道，并全数避开。</data></node>
    <node id="涡波·帕林库洛状态栏快照（ch153·决战前）"><data key="name">涡波·帕林库洛状态栏快照（ch153·决战前）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛・勒伽西：HP456/512 MP390/392 职业：无 级别22；力量15.21 体力19.45 技巧12.12 速度18.22 贤能10.11 魔力14.01 素质4.89；先天观察眼1.47；后天剑术1.89 神圣魔法1.23 精神魔法3.90 体术1.87 咒术2.55——与最后所见基本无变化。相川涡波：HP369/370 MP520/920－400 职业：探索者 级别20；力量11.55 体力13.12 技巧17.11 速度20.86 贤能17.12 魔力46.44 素质7.00；先天剑术4.89 冻结魔法2.58＋1.10；后天体术1.56 次元魔术5.25＋0.10 感</data></node>
    <node id="『○之理的盗窃者』召唤体系"><data key="name">『○之理的盗窃者』召唤体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛口径：『地之理的盗窃者』已『以我理想的形式消失了』；『最新受到召唤的『木之理的盗窃者』』行动在其预定范畴之内——结合其等待『英雄』抵达决战，木之理的盗窃者疑即相川涡波（推断，存疑分开标）；『理/盗窃者』称呼与召唤机制本章未展开；『地之理的盗窃者』以我理想的形式消失了。而最新受到召唤的『木之理的盗窃者』的行动也在预定的范畴之内。</data></node>
    <node id="阿尔乌那（此世之马）"><data key="name">阿尔乌那（此世之马）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">军用『阿尔乌那』——外貌与马相似的生物，柯尔库一带平原骑兵的坐骑（因附近皆平原故骑兵很多）；玛利亚会骑；涡波判断『这个词指的就是这个世界的马』，打算在阿尔乌那和马之间创建直接映射。；「马？是说军用的『阿尔乌那』吗？我确实会骑……」；恐怕这个词指的就是这个世界的马了吧。以后就在阿尔乌那和马之间创建直接映射好了。；许多卫兵都骑在一种外貌与马相似的生物上。</data></node>
    <node id="『Ex・Wind』"><data key="name">『Ex・Wind』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德自称以魂铸就的魔弹：原型为连地上的探索者都熟练使用的风属性中级移动魔法（莱纳也会、原本不具攻击力），罗德使出后判若云泥——踏穿超越星辰规模的魔法阵（其当立足点）粉碎无遗、风炸裂填满世界，如从世界上消失般向宇宙极深处飞去后化作自天际坠来的翠星『流星』；其真身为全力飞奔的体术、却引发魔法现象：速度臻于极致令空气灼燃、全身放射青色光辉，流星所过之处世界被撕裂、不以魔力仅凭物理力量将次元撕开裂口；一旦被击中就是消灭、擦伤即死、近身身体必被拆散、远离亦因热量与冲击令HP顷刻归零（据涡波判断）；这便是！以孤之魂铸就的魔弹！；E、『Ex・Wind』──？；以如此恢弘的气势，使出的却是莱纳也会的风属性魔法</data></node>
    <node id="『表示』（状态显示系统）"><data key="name">『表示』（状态显示系统）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">此世界的状态显示系统：呈现状态栏（姓名/HP/MP/职业/等级/属性/技能与数值/称号）与物品描述——『注视』所见祭坛武具描述即其载体（'『表示』上的描述实在是再危险不过'，诅咒/精神污染数值载于其上）；新技能习得由『表示』认可（新增『缝纫』'现在又有了『表示』认可自己的才能'）；西娅'根据『表示』来看她什么才能都没有'技能栏空空如也；缇亚'『表示』上HP没有变化'但体力大量消耗——显示值与实际体力存在偏差；『表示』上的描述实在是再危险不过。；现在又有了『表示』认可自己的才能，超感动。；确实正如海莉所说，根据『表示』来看她什么才能都没有。技能栏更是空空如也。</data></node>
    <node id="『风之理的盗窃者』"><data key="name">『风之理的盗窃者』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的称号：国家、大陆、星辰⋯⋯甚至宇宙都在其支配之下的风之化身的王号；本章试练以其为名开幕；涡波自认同时只有自己拥有战胜此称号者（罗德）的力量；以崩壊的世界为舞台，『风之理的盗窃者』的『试练』就此开幕。；国家、大陆、星辰⋯⋯甚至宇宙都在其支配之下的风之化身。；那就是『风之理的盗窃者』、罗德。</data></node>
    <node id="『魔石人类』谎言的揭穿"><data key="name">『魔石人类』谎言的揭穿</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">海莉临终推翻自己先前的主张：据其自述，被『世界奉还阵』吞没之后『终于得到了『她』的记忆』，故断言『果・然・是我搞错了⋯⋯！你并不是什么『魔石人类』』，并称『所有的拼图终于凑齐了⋯⋯你的器尚未崩壊，果然是命运的安排』（本章切片内仅见海莉更正面，带相当确信；涡波记起当初指认者正是海莉本人）；「没关系的。被『世界奉还阵』吞没之后，我终于得到了『她』的记忆。果・然・是我搞错了⋯⋯！你并不是什么『魔石人类（魔石人类』⋯⋯！」；当初说我是『魔石人类』的就是海莉。而事到如今她本人又为何亲口推翻了这个说法呢。；「所有的拼图终于凑齐了。⋯⋯涡波君。你能坚持到现在，真是辛苦了。你能走到这一步，真是太好了。你的器尚</data></node>
    <node id="千年前『魔力=毒』与黑紫魔力侵蚀"><data key="name">千年前『魔力=毒』与黑紫魔力侵蚀</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前时代『魔力』被人称呼为『毒』；男子感情暴走失控喷出的魔力为不详黑紫——将接触的一切侵蚀、把存在的次元扭曲崩坏（墙壁无创却可见外侧/地砖下露出大地断层）；该现象与守护者展现全力时的魔力同类（侵蚀世界的凶恶魔力的胎动）；男子复仇路上不做多想一味收集『毒』提升级别渐成怪物（据记忆再生内容）；魔力的颜色是不详的黑紫。它将接触到的一切全部侵蚀，将其存在的次元扭曲、崩坏。；这魔力是如此异常，我知道类似的魔力。就跟守护者的魔力一样。；在这个时代，『魔力』被人称呼为『毒』。</data></node>
    <node id="千年前战争传说与疑点（ch72说明回）"><data key="name">千年前战争传说与疑点（ch72说明回）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据玛利亚：千年前那段时间的描述基本是传说，不以接近神话的形式传承就留不到现代（文献动辄吞天裂地级）；战争结束的转折点=敌方使徒的『魔法阵』几乎吞噬大陆全土生物，知情者基本没了，据记载最终战死者敌我合计『九成』；'千年前的战争似乎就是一切的开端'（拉丝缇娅拉），现在的战争基本可看作那场战争的延长；据拉丝缇娅拉（弗茨亚茨传说）：两名使徒从天而降→迪普拉库拉宣告背叛与『北方』狂王协力→正义使徒西斯与圣人缇娅拉统合『南方』人类交战→『北方』魔物（一脚踏平国家的巨树/笼罩整个大陆的黑云不死者/将碰触到的一切全部冻结的大冰蛇）被缇娅拉'只用一根手指'撂倒、败者洗心革面成同伴→打败狂王、说服迪普拉库拉→其以</data></node>
    <node id="归还原世界的方法论（ch70）"><data key="name">归还原世界的方法论（ch70）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉=继续遵从以迷宫最深部为目标的方针（'除此之外没有别的办法'）；玛利亚=继续钻研次元魔法（『Dimension』/『Connection』路线）；涡波补充=抵达大陆本土后拜访大国图书馆及贤者；涡波拒绝斯诺'留在这个世界生活'提案——'我不能置妹妹阳滝于不顾'（据玛利亚'非常了不得的兄妹爱'）；「我觉得就这样继续遵从以迷宫最深部为目标的方针就好。除此之外没有别的办法了。」；「再考虑其他可能性的话，就是涡波先生继续钻研自己的次元魔法了呢……」；当然，也不能放弃对其它手段的探索。我还打算在抵达大陆本土之后，就去拜访大国的图书馆以及贤者之类的。</data></node>
    <node id="世界奉还阵暴走（ch83）"><data key="name">世界奉还阵暴走（ch83）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛之战后阵处于暴走态：'继续这样下去的话，根本不存在什么胜利者，所有人都会死的'——无数地裂重合、能称作平地的地方不复存在，倒地者会被吞没到大地的裂缝中；战场地形变为'山谷连绵不绝的的黑色山脉'；'『世界奉还阵』打算吞没留在战场上的一切'，被裹者随大地'落向大陆底部的底部'。；『世界奉还阵』现在的暴走确实在孕育着这样的凶兆；看向周围，已经根本不存在什么平原和荒野了。；『世界奉还阵』打算吞没留在战场上的一切。</data></node>
    <node id="联合国社会扭曲的冰山一角（废弃魔石人类·奴隶增加·ch219）"><data key="name">联合国社会扭曲的冰山一角（废弃魔石人类·奴隶增加·ch219）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据本章所见与艾尔自述：整个联合国低龄层的平均级别上升（练习场有比艾尔更年幼但级别不低的孩子；涡波归因艾德影响）；被废弃的『魔石人类』实情（艾米丽须定期投药维持特殊身体）与奴隶总数的增加带来的问题并存；原委类似的探索者队伍越来越多（练习场内即有）；这一切是『一年里被强行刺激发展的文化的扭曲之处』的冰山一角（涡波切身体会）；整个联合国低龄层的平均级别上升问题由此可见一斑。；被废弃的『魔石人类』的实情。；奴隶总数的增加带来的问题。</data></node>
    <node id="植入人格的淡漠化迹象"><data key="name">植入人格的淡漠化迹象</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇莉评涡波'居然是这么淡漠的人吗'——涡波自觉'丝毫不觉得自己淡漠/感情相当丰富'却意识到言行确实显得薄情（对斯诺的态度冷漠）；'这样子简直就像——'的联想被头痛打断——改篡人格对情感层的压平（flattening）迹象，与记忆抵抗躯体证据群同族对照；我丝毫不觉得自己是个淡漠的人，不如说，我觉得自己的感情是相当丰富的——才对，这么一想，我意识到自己刚才那些话的确显得有些薄情。于斯诺而言，我的态度的确有些冷漠。；我是这么理性且缺乏人情味的人吗……？</data></node>
    <node id="诺斯菲『渴望犯错』宣言与崩壊（留恋真形全容）"><data key="name">诺斯菲『渴望犯错』宣言与崩壊（留恋真形全容）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">核心命题：『正确的做法永远都不会得到报偿』——千年前故作老成做正确的事失去一切（错失将涡波大人收入手中的机会、只余『死亡』与『后悔』）；『人越是正确就会变得越不幸』『做正确的事只是出于教导者的私利』；不想再作通情达理的人（装好孩子太艰辛）、想成为不明事理的孩子；对涡波与罗德单纯羡慕（无嫉妒敌意）故单纯模仿；昨日一连串骚动中内心动摇最剧烈者并非罗德而是诺斯菲；正在逐渐崩壊（自心灵支柱起）；原定顺序（先回地上→救妹妹→拯救罗德→取回记忆→最后传达心情）被其自认正确却主动否定；留恋=不断犯错中变得幸福、在幸福中迎来幸福的结局；要颠覆自己人生的一切、将生涯所有荣耀推翻重来（不这么做就会窒息）；「因・为</data></node>
    <node id="玛利亚的火炎魔法原理(以过去为燃料)"><data key="name">玛利亚的火炎魔法原理(以过去为燃料)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚的火炎魔法以过去为燃料——为保留火炎魔法经验而失去家人全部记忆；『我能有家人的记忆反而是怪事』=手环植入虚假家人记忆的破绽；义眼（炼狱自抉双目后遗）可借火焰收集信息；火焰层次高于暗之理（莉帕无法干涉火之理的盗窃者的魔法）；代价型魔法：燃烧过去才能发动（世界炎蛇/落日天炎）；「为了以防万一而没有消除我火炎魔法的经验是你们的失算呢。我的火炎魔法是以过去为燃料的魔法。因为这个原因，我失去了家人所有的记忆。；状态：精神污染1.65记忆篡改1.04记忆障碍1.02认识阻碍1.34黑暗1.33</data></node>
    <node id="技能暴走体系"><data key="name">技能暴走体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">存在同型代价结构技能：以一定的感情为交换触发暴走——技能『？？？』（使精神安定/混乱补正+1.00，主角持有）与技能『过捕护』（将特定的感情予以强化，缇亚持有）——二者暴走格式完全同型（【技能『＊＊＊』暴走了】+代价说明）；触发与情感的关联为共性；以一定的感情为交换，将特定的感情予以强化</data></node>
    <node id="LevelUP/Status体系=千年前男子所创『咒术』『变换』"><data key="name">LevelUP/Status体系=千年前男子所创『咒术』『变换』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前记忆所示：男子受使徒等唆使创造出『咒术』——即LevelUP/Status体系（『什么LevelUP啊！什么Status啊！真是滑稽不堪』）；缇娅拉称其想出的『变换』术式拯救无数人、使其成为英雄乃至救世主（结果=散布在天空的魔力聚集到一处、拯救世界）；男子自嘲到头来全如使徒所想、自己不过掌心跳梁小丑、『咒术就是咒术，诅咒就是诅咒』——体系的诅咒性与创造者记述待主线回收（据记忆再生内容+人物台词）；「师父，等等！再这样下去你会失去自我的！如果『变换』再继续下去，师父你的身体也会变成那样的！」；什么『LevelUP』啊！什么『Status』啊！真是滑稽不堪！；「但是多亏了师父你想出的『变换』</data></node>
    <node id="艾尔多拉琉与一级探索者考试"><data key="name">艾尔多拉琉与一级探索者考试</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫西侧国家艾尔多拉琉：魔法文化发达、勤勉、教学机构众多、迷宫旁大陆最大学院；一级探索者资格考试=收集一至十层Boss掉落品+于十层采集『不会消失的火焰』（排名竞争制；最高水平学生中仅少数有权挑战；光靠家族权柄无法取得）；光靠家族的权柄是无法取得一级探索者的资格的。</data></node>
    <node id="魔力=『毒』假说（非本世界固有说）"><data key="name">魔力=『毒』假说（非本世界固有说）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波千年前记忆中有将『魔力』称为『毒』的片段；由此观之，被涡波看作'既然是异世界那么就理当存在'的『魔力』可能并不是这个世界生而有之的东西；因『魔力』扭曲了人的姿态、导致大型怪物泛滥成灾、依靠魔力驱使的魔法使『代价』这种离经叛道的东西大行于世；据涡波记忆：作为使徒的西斯对『魔力』知之甚深；在我千年前的记忆中，有将『魔力』称为『毒』的片段。由此观之，被我看作既然是异世界那么就理当存在的『魔力』可能并不是这个世界生而有之的东西。；因为『魔力』的原因扭曲了人的姿态，因为『魔力』的原因导致了大型怪物泛滥成灾、因为依靠『魔力』驱使的魔法的原因让『代价』这种离经叛道的东西大行于世。；说来，我记得作为使徒的</data></node>
    <node id="光之理区域攻略方针（五十九~五十五层）"><data key="name">光之理区域攻略方针（五十九~五十五层）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲（光属性专家兼迷宫主人）说明：光属性基本以『交流』为主、并非『争斗』而是『交流』——此即『光之理』的理想；基本由光属性构成的怪物不对其他生物产生过多敌对行动、其楼层附近怪物无攻略必要（一一确认过于浪费时间）；附近怪物是『懂得话语的孩子』、层主温厚的性格反映出怪物温厚的性格（据诺斯菲声称）；到五十五层都能以这种步调前进；若有攻略必要、则是接近五十层左右怪物属性开始变化的时候；「虽说就是这样的属性了⋯⋯⋯我们就先来微微说明一下吧，光属性基本以『交流』为主。并非『争斗』而是『交流』──这边是『光之理』的理想」；「虽然是这么说，我认为我的楼层附近的怪物没必要攻略。基本由光属性构成的怪物并不会对</data></node>
    <node id="奴隶制度与拍卖场"><data key="name">奴隶制度与拍卖场</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">这个世界存在奴隶（身戴镣铐者行走街头）；瓦尔德治安差区有避人耳目的奴隶拍卖场（深夜营业、专人接待、数十奴隶经洗浴化妆打扮提升商品格调）；国家默许其存在；果然是奴隶的拍卖场。</data></node>
    <node id="五国联合国（ch216）"><data key="name">五国联合国（ch216）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">联合国成员国按顺时针环列：瓦尔德→古尔亚德→劳拉维亚→艾尔多拉琉→弗茨亚茨（本章涡波自瓦尔德南下巡历）；联合国内部跨国境无繁琐手续；劳拉维亚直辖公会『史诗探索者』需介绍信准入；继瓦尔德之后整个联合国按照顺时针顺序转一圈数下来是古尔亚德・劳拉维亚・艾尔多拉琉・弗茨亚茨。；昨天去了一趟弗茨亚茨我就注意到，在这个联合国中跨越国境没有太多琐碎的手续，可以说非常省心。；一边和缇缇两人一起在瓦尔德南下，我一边思考今天的行程和MP的使用方法。</data></node>
    <node id="记忆改篡的植入人格"><data key="name">记忆改篡的植入人格</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛改篡的具体形态：①兄妹设定（玛利亚=妹妹/体弱多病/母亲遗托）②救命恩人设定（迷宫初遇+火灾二次救命）③火灾失忆（无死者认知）④手环=绝对必要品的执念（术式锚点）⑤义眼供给（玛利亚失明由来的再解释）⑥基督·欧亚期记忆全抹——但违和感（纽扣扣错感）无法消除（相川涡波的核心未触：『我不会触及相川涡波的核心』ch0029 之兑现）；「总而言之，那个手环是最奇怪的。那·个·时·候，你根本没有戴着这样的手环。」</data></node>
    <node id="缇缇的盗窃者称呼与支配之王指认（ch220）"><data key="name">缇缇的盗窃者称呼与支配之王指认（ch220）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波当面称缇缇为『风之理的盗窃者』（'而且这次还有作为『风之理的盗窃者』的你在身边'）；叙述并指认缇缇=『千年前的支配之王本人』——与 ch216 缇缇自称'千年前的「理的盗窃者」'线合流，与诺斯菲『光之理的盗窃者』并置，按判例1 不自动合并、关系留终审；而且这次还有作为『风之理的盗窃者』的你在身边，用不了多久就到了」；如此这般，既然出自千年前的支配之王本人之口，那这话确实有相当的说服力。</data></node>
    <node id="『这里』的入城法则（ch191实证）"><data key="name">『这里』的入城法则（ch191实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">城门大敞、'没有拒绝任何人进入的意思'，但居民无人入城——贝丝：'我们不是城里的人啊'；涡波判读：'不论发生什么，国民都不得进入城中。他们的这一行为实际上暗示了『这里』的一条法则'；城门本身是大敞着的，没有拒绝任何人进入的意思。；「诶？因为，我们不是城里的人啊。所以，才会先这样感到困扰」；不论发生什么，国民都不得进入城中。他们的这一行为实际上暗示了『这里』的一条法则。</data></node>
    <node id="海盗七船船队与近海治安（ch135）"><data key="name">海盗七船船队与近海治安（ch135）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">越接近本土海盗袭扰越频繁（据玛利亚推测·近战场故，民间以改航路减敌袭为对策选项）；本章第二波=七艘船队炮击来袭（『LivingLegend号』近旁水柱），据涡波『维度』侦察判断其刚抢掠完回程、船内有刚捕获的奴隶与非战斗人员，海盗有舍弃非战斗者不顾之虞故须小心战斗；全员决议抓捕审问其执着袭击的理由；前夜来袭的海盗船已被暴走的拉丝缇娅拉单独歼灭；「估计是吧。我认为越是接近本土，这种事就会越来越频繁」；水柱在『LivingLegend号』附近升起。；拓展『维度』，我发现了远处的船队。数量为七。来了一群。</data></node>
    <node id="公会制度"><data key="name">公会制度</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">利害一致的探索者互助组织，形态多样（隶属国家至初心者自发）；大规模公会受国家定期委托退治棘手怪物（委托带时限）；国家定期就会像这样委托有实力的探索者退治怪物。</data></node>
    <node id="联合国次元魔术的落后（ch219）"><data key="name">联合国次元魔术的落后（ch219）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">市售次元属性魔石四魔法全与涡波已有魔法酷似：『Lag』（消费MP1/次元魔术的基础/将各种现象的时间予以迟滞——似其独创时滞魔法『次元・雪』）、『Shift』（让特定的东西沿一条线错位——接近『次元斩裂剑』）、『TimeShift』（操纵术者的时间感——类似『维度・决战演算』）、『Default』（瞬移半步——『按照说明书来看』即市售最上级）；魔法学院教学认为次元属性是稀有属性（据涡波听闻），实际落后到令其扼腕；次元魔术的基础。根据术者的力量，将各种现象的时间予以迟滞。；或者说的直接点，就跟我利用『形式』研发的独创时滞魔法──『次元・雪』非常像。；虽然不能说完全一样，但『Shift』就接近于『</data></node>
    <node id="『拟神之眼』（ch126）"><data key="name">『拟神之眼』（ch126）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉用以确认他人状态的能力：借此确认涡波技能『？？？』发动（『混乱的数值上升了』）；拉丝缇娅拉用『拟神之眼』确认了我的状态。；「诶、『？？？』发动了⋯⋯？啊，是真的啊。混乱的数值上升了」</data></node>
    <node id="贝丝=伊丽莎白·死者形态与记忆缺陷"><data key="name">贝丝=伊丽莎白·死者形态与记忆缺陷</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">同指证据：诺斯菲当面称冲入前廊的少女骑士为『伊丽莎白』并受其答谢应命；雷纳尔多断言『你早已成为一个死者』『同样作为死者』；贝丝自述怀有『生前的愤怒』与『千年来的遗憾』；不记得祖父雷纳尔多（『我的祖父？您到底在说些什么？』）；被雷纳尔多指自我早早崩壊、留恋不如老朽；「呋呋呋，人我好好地帮你留住了哦，伊丽莎白。真亏你能注意到我那细微的魔力信号呢。；「贝丝，现在在我们身后的那小子并不是你所熟悉的团长殿下。而且你早已成为一个死者。；自己生前的愤怒、还有这千年来的遗憾</data></node>
    <node id="技能？？？完全解（退还机制）"><data key="name">技能？？？完全解（退还机制）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">混乱≥10.00 超过技能极限→『退还』：积存的负面感情（+利息）强制返还——从发动日起的绝望/孤独/焦躁/屈辱/压力/被改篡不快/死亡恐惧/精神污染/恋慕全部一齐涌回；连环发动只增利息不减本金→技能？？？本质=残次品（有上限的感情置换装置）；被封印后终结；从那一天，刚来到这个异世界时茫然无措、在迷宫中彷徨、被人欺骗、要被狼吃掉的前一瞬间的精神开始，一直到今天为止的所有负面感情全都上门来讨债。</data></node>
    <node id="三使徒体系与莱文教传承（ch77更新）"><data key="name">三使徒体系与莱文教传承（ch77更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据帕林库洛（部下=莱文教信徒口径佐证传承常识）：使徒一共有三位——①引导圣人缇娅拉的『西斯』②致使北之王疯狂的『迪普拉库拉』（两者为信徒传承所知）③第三位使徒『勒伽西』：从始至终作壁上观、未留下任何传承但确实存在；勒伽西家独有使命=『在一千年后的未来，继承一位使徒的力量』，执行仪式中侄女西娅为『再诞』容器；「都不是，其实使徒一共有三位。第三位使徒从始至终没有发挥任何作用，只是在一旁作壁上观而已。自然也没有留下任何传承。但是即使如此他也是确实存在的。而那第三位使徒的名字是勒伽西。使徒勒伽西。」；「勒伽西家拥有其他贵族所没有的使命。那是『在一千年后的未来，继承一位使徒的力量』这一使命。我的改变，可</data></node>
    <node id="『咏唱』"><data key="name">『咏唱』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德持续行使的复合咒术行为（以『加速』等词句为核）：代价=宣泄自己的人生不存任何意义、削耗自己的魂使身体无止境变轻；其心磨耗、融解、化作风溶入世界——仅涡波拜『维度』所赐听得到咏唱、看得到此过程；若继续索求更进一步的加速、为此舍弃更多的东西，就不光是心灵、甚至会危及生命乃至灵魂（据涡波观察）；因为『咏唱』的『代价』和战斗的兴奋感，让她的情绪高涨到了极点。；罗德要通过『咏唱』宣泄自己的人生不存任何意义，借此削耗自己的魂，从而让自己的身体无止境地变轻。；如果继续这样不满于现在的加速而索求更进一步的加速，为了实现更进一步的加速而舍弃更多的东西的话，那就不光是心灵，甚至会危及她的生命乃至灵魂。</data></node>
    <node id="涡波的力量变质（超越守护者的怪物化）"><data key="name">涡波的力量变质（超越守护者的怪物化）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛的骑士理想剑闪在涡波眼中与慢动作无异（自据=能看到『表示』）——'我正在变成超越守护者的『怪物』'；黑液散弹百余发一个不差全避（『维度・决战演算』空间掌握+状态赋予的强大身体能力）；'跟缇达交战时我不可能做得出的动作现在却能轻而易举地实现'；自评'已经不是成长，而是变质了'；代价面=失去『并列思考』致思维迟钝；我正在变成超越守护者的『怪物』；运用『维度・决战演算』的空间掌握能力，加上状态赋予的强大身体能力，我一个不差地全数避开。；跟缇达交战时我不可能做得出的动作现在却能轻而易举地实现。曾经心中的神技现在也能轻描淡写地使出。</data></node>
    <node id="迷宫深层规则三则（ch179实证）"><data key="name">迷宫深层规则三则（ch179实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">①BOSS怪物再出现间隔：'迷宫内的BOSS怪物被打倒后到再度出现为止间隔应该是一个小时'（据莱纳）；②怪物不能跨层行动：跨过层与层之间的出入口后所有LizardFlyer当即停止追击——'低阶层的规则在深层也是通用的'，涡波并自称该规则为自己所制定；③深层怪物感知范围极广：'只能认为它们可以利用风感知敌人'（据涡波推测）；迷宫内的BOSS怪物被打倒后到再度出现为止间隔应该是一个小时；接着，在我们跨过了层与层之间的出入口之后，所有LizardFlyer当即停止追击。看来，低阶层的规则在深层也是通用的。；果然跟低阶层的怪物不一样，感知范围不是一般的广。只能认为它们可以利用风感知敌人。</data></node>
    <node id="北方乐园传闻"><data key="name">北方乐园传闻</data><data key="type">传闻·概念</data><data key="status">provisional</data><data key="desc">南方魔人间流传『一直往北走会抵达『魔人』的乐园』——缇缇信之北逃并自认抵达（『『这・里』就是『乐・园』』）；千年后自白真乐园=灰烬中的小屋与草原，『『乐园』并不是『佩艾希亚』』；──『这・里』就是『乐・园』；传闻是真的啊。一直向北走，最后是会抵达『乐园』的。；『乐园』并不是『佩艾希亚』</data></node>
    <node id="境界战争"><data key="name">境界战争</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据塞拉：北方与联合国侧激化中的战争——『在与北方的「境界战争」激化的当下，包括所有盟国在内，弗茨亚茨绝对不可以对外表露出任何窘态』；构成拉丝缇娅拉无法接受涡波邀请的现实背景；在与北方的『境界战争』激化的当下，包括所有盟国在内，弗茨亚茨绝对不可以对外表露出任何窘态。</data></node>
    <node id="『新月琉璃』"><data key="name">『新月琉璃』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波实打实铸造而成的剑（与罗德魔力构筑的铳剑对举）：冲至罗德面前顺势挥出、未击中身体传来铁器撞击钝音；遭罗德一瞬间解除铳剑实体穿透【近名警示：疑为库内『新月琉璃制直剑』/『新月琉璃直剑』，按原文写法立名，归并留R4】；冲到她面前之后我顺势挥出『新月琉璃』。不过没有击中她的身体，传来的是铁器撞击的钝音。；与实打实铸造而成的『新月琉璃』不同，罗德的铳剑是用魔力构筑而出的。</data></node>
    <node id="迷宫的想起收束（Drop）机制"><data key="name">迷宫的想起收束（Drop）机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据斯诺（学院知识）：迷宫=将大地积攒的魔力和过去集中收束再退返大陆的循环器；会掉落过去的道具（『想起收束（Drop）』）；绝大多数探索者无法触及的二十三层以下，这类物品因未被取用而残留（祭坛+剑=过去的遗物/可能是过去的名剑）；「……那个恐怕是迷·宫·本·身·的·掉·落·品。」；「归根究底，这里本就是将过去的遗产退返回大陆的地方。迷宫担当着将大地积攒起来的魔力和过去集中收束起来再退返的循环器的作用。——如此如此、这是我在学院那边获悉的。」</data></node>
    <node id="帕林库洛的驻地大堡垒（ch144实测）"><data key="name">帕林库洛的驻地大堡垒（ch144实测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据西娅的信=当地诸堡垒中最大者=帕林库洛所在地。『维度』远程实测：要塞面积1000㎡；高高的塔与密集石造平屋互相连接构成；三角形防壁张开；高度近コルク街道的两倍——异世界所见建筑物中相当优秀的防御壁，威压感连联合国的弗茨亚茨大圣堂都要逊色；中央有四方数十米的庭院（=三名异常魔力者对峙处）；因魔石线情报先达，全堡垒已识入侵者、进入临战状态；西娅那里拿到的信来看，这之中最大的堡垒就是帕林库洛的所在地。；那个要塞的面积为1000㎡，由高高的塔和石造的平屋十分密集。互相连接构成的、三角形的防壁张开着，他的高度是コルク街道的近两倍，在这异世界见到的建筑物中，是相当优秀的防御壁。；不愧是连联合国的弗茨亚茨</data></node>
    <node id="三仇人素质论（莱纳转述，据海莉）"><data key="name">三仇人素质论（莱纳转述，据海莉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莱纳叙述（其中加护一项转引海莉说法）：『帕林库洛·勒伽西』是『神童』且'身上还有着『使徒』的加护'；『基督·欧亚』是『异邦人』，'他的素质达到了传说中的『始祖』的领域'；『拉丝缇娅拉·弗茨亚茨』是『现人神』，'她的身体跟『圣人』有相同的规格'——莱纳自评远不及三人（'是比垃圾都不如的渣滓'）。；『帕林库洛·勒伽西』是『神童』。按照海莉小姐的说法他身上还有着『使徒』的加护。；『基督·欧亚』是『异邦人』。他的素质达到了传说中的『始祖』的领域。；『拉丝缇娅拉·弗茨亚茨』是『现人神』。她的身体跟『圣人』有相同的规格。</data></node>
    <node id="拉丝缇娅拉的现人神称号与联合国上层地位（据缇缇）"><data key="name">拉丝缇娅拉的现人神称号与联合国上层地位（据缇缇）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇缇对克洛伊的言及：'联合国上层的现人神拉丝缇娅拉・弗茨亚茨'——全名形（拉丝缇娅拉・弗茨亚茨）、称号（现人神）与联合国上层地位并见（据缇缇声称）；而联合国上层的现人神拉丝缇娅拉・弗茨亚茨对斯诺下达的指示就是要她配合我们的暗杀计划</data></node>
    <node id="缇亚的白羽与『莱文教』再临使徒视作（ch131重申）"><data key="name">缇亚的白羽与『莱文教』再临使徒视作（ch131重申）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">'缇亚生来背后带有白羽，所以就被视作了『莱文教』再临的使徒'；本人主张除魔力有些高外其他地方跟普通人没什么区别；白羽'颇为小巧可爱'不仔细观察注意不到，涡波视作奇特装饰；本章异变：其身影消失船舱的瞬间白羽'似乎微微颤动了一下'；我之前告知自己身世的时候，也从缇亚那里了解到了一些『使徒』的事情。因为缇亚生来背后带有白羽，所以就被视作了『莱文教』再临的使徒。；不过，在缇亚的身影消失在船舱的一瞬间，我视作装饰的白羽似乎微微颤动了一下。</data></node>
    <node id="『狂王』"><data key="name">『狂王』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">敌人对罗德的称呼（据涡波于本章悟得其因果）；此时此刻，见到这一幕，我终于明白作为『支配之王』的罗德被敌人唤作『狂王』，被己方称为『魔王』的因果。</data></node>
    <node id="阿雷亚斯流剑术"><data key="name">阿雷亚斯流剑术</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">特性=柔软性：设想各种局面而诞生，可在任何场合当场找出对应策略，战斗每过一秒让使用者变强；由专精于此的涡波继承；阿雷亚斯流剑术最棘手的地方，就是它的柔软性。；战斗每过一秒就会让使用者变得更强</data></node>
    <node id="五十层的世界"><data key="name">五十层的世界</data><data key="type">地点(迷宫·六十六层里侧)</data><data key="status">provisional</data><data key="desc">位于六十六层里侧的空间，『将人家的一切展现而出的五十层的世界』——无青空白云、无光，空气淡薄近窒息，无风，只回响『世界崩壊的悲鸣』与绝命般哀嚎；缇缇（罗德）记忆回归后于此发出千年『悲鸣』；映入眼中的是位于六十六层里侧的空间。；同时也是将人家的一切展现而出的五十层的世界⋯⋯一个空空如也的地方。；能听到的只有世界崩壊的悲鸣。只有绝命般的哀嚎一直在周围回响。</data></node>
    <node id="魔剑『堕落使徒』"><data key="name">魔剑『堕落使徒』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳的魔剑，已断（'之前断掉的'），仍别在其腰间；莱纳另身戴大量风属性魔法道具；身上戴着大量风属性的魔法道具，腰间别着之前断掉的魔剑『堕落使徒』</data></node>
    <node id="振动通信魔法"><data key="name">振动通信魔法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺·沃克的技术：『纠缠性质的魔力』注入魔石+『古代魔法』声音再现=远距扩音通信（复数魔石同时发声如扩音器阵列）；领先世界数阶段的个人技术（魔石线只能传达魔力不能传声）；与次元魔法结合=惊异武器（帕林库洛评价）——辅佐会长的约定手段；（没错。将我的『纠缠性质的魔力』注入魔石当中，再运用『古代魔法』将声音再现出来。</data></node>
    <node id="诅咒的无意识防卫机制全貌"><data key="name">诅咒的无意识防卫机制全貌</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">新月琉璃直剑自动防御（手环破坏目标早期反应）；一次见识的技巧即刻纳为己有：芙兰琉莱体术/塞拉剑术（低身见招拆招）/拉古涅双剑伎俩/赫勒比勒夏因双剑术/格连·斯诺·艾尔多拉琉学院体术+连拉丝缇娅拉的『血』都陌生的异世界体术（不存在于联合国）；断肘冰冻固定握剑；最终手段选魔法（次元之冬构筑因大脑过缓失败）；黑紫瞳色=手环紫色魔力从后脑侵入；无意识态=思考归零纯反射+视力唯一信息源；『诅咒』的完成度之高委实令人惊讶。它竟然能将仅仅见识过一次的技巧纳为己有。明明我本人都未必做得到。；不，既然连我的『血』也感到陌生……那这说不定是不存在于联合国的异世界的体术。</data></node>
    <node id="雷霆之魔弹（磁力加速魔弹）"><data key="name">雷霆之魔弹（磁力加速魔弹）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德换装弹种（咏唱『迅雷疾风共铸圆环』『将此异弹烙入我魂』→『奔驰超越吧！雷霆之魔弹啊』）：铳剑凝聚收束闪电生成筒状磁力结界（一类的东西）——与正常魔法世界画风不一致、来自涡波原世界的知识；射出缠绕紫电的弹丸，初速度之后仍能继续『加速』；并非次元魔术却令弹道空间扭曲；首发为调整误差的试射即贯穿涡波方才所处空间；──『迅雷疾风共铸圆环』『将此异弹烙入我魂』！！；那独特的电流运动、毫无疑问是在生成一种筒状的磁力结界（一类的东西）。；「奔驰超越吧！雷霆之魔弹啊──！！」</data></node>
    <node id="素体计划全貌"><data key="name">素体计划全貌</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斐勒卢托总指挥的国家级工程：拉丝缇娅拉=圣人缇娅拉留下的『再诞魔法』素体——诞生三个月即素体固定（肉体年龄调至十六以赶上始祖预言年份的三年后圣诞祭）；赋予现人神地位；多层精神魔法（制造过程中施加）+血中术式（含常识语言）+帕林库洛定期检查三重保险；教育者海因负责培养至不辱圣人水准并诱导其毫无怨言接受仪式；国家决定+莱文教总体意志+始祖遗言三位一体；在始祖预言的年份，在命中注定的那一天献上十六岁的完成品乃是我们的使命。</data></node>
    <node id="涡波×缇缇共同锻造法（ch217）"><data key="name">涡波×缇缇共同锻造法（ch217）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇缇按指示赤手将锤击难裂的高级魔石碾作粉尘并切成八段（一息完成常需数小时）；缇缇以『自由之风』分裂热量冷却，涡波以『维度』将热量掌控至小数点以下并按百分比下达出力指示（'再下调百分之四'）——两人经『连接』互通内心，初次尝试即配合天衣无缝；『风之理的盗窃者』之力可直接省略淬火工序；涡波以超出人类领域的臂力挥锤并追加稀有魔石提高剑强度；她赤手空拳地就将用锤子敲打也难生裂隙的高级魔石碾作粉尘。看到这一幕，在场的锻冶师们又倒吸了一口凉气。这次是因为心生畏惧。；只在一息之间缇缇就完成了正常来说需要几个小时才能结束的作业。；「嗯─，虽然跟一般的冷却不同但『自由之风』是可以分裂热量的哟」</data></node>
    <node id="亡灵一闪"><data key="name">亡灵一闪</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺文释放过的招式；罗德全魔力集中时的气息与其同类——『世界的理受到侵蚀的恐怖感』（涡波对照）；而是跟诺文释放『亡灵一闪』那时一样，有一种世界的理受到侵蚀的恐怖感。</data></node>
    <node id="『世界奉还阵』"><data key="name">『世界奉还阵』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">不知何时铺展在大陆上的魔法阵，蕴藏'整座大陆都会被掀翻'之可怖魔力；诺斯菲战败之际欲从中吸取力量（'只要用这世界奉还阵的话'），力量过巨非一人可驱使致暴走——阵之运作突变为'将整座大陆的一切都溶解殆尽的凶险的杀阵'，吞噬诺斯菲与罗德（二人同归于尽）；将被吞噬的佩艾希亚之民化为魔石散落于迷宫空间；据孤推断：阵之真正目的或为对『理的盗窃者』的捕获/吸收，其力量或为涡波之杰作（涡波对理的盗窃者的厌恶甚至在其对世界的仇视之上）——均标注为孤之推断；她打算从不知何时铺展在大陆上的魔法阵中吸取力量。；[就、就算这样我也不如你吗！？既然如此，那就再撰取更多的力量——！给我更多更多的力量——！只要用这『世界奉</data></node>
    <node id="迷宫38层（植物回廊）"><data key="name">迷宫38层（植物回廊）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">自37层水中阶层下行的阶层：回廊遍布浅滩，墙壁如热带雨林般生长大量植物；植被茂密程度自第一层之后再未见过；水栖类怪物减少、植物类怪物增加（移动能力普遍低）——38层回避敌人难度为各层最低，仅靠『维度』无需莉帕魔法即可无事故通过；回廊遍布浅滩这点倒是跟之前一样，但是墙壁上就如同热带雨林一般生长着大量的植物。；植被如此茂密的区域自第一层之后再未见过。；水栖类的怪物减少，植物类的怪物增加了。</data></node>
    <node id="迷宫61~66层构造与通用规则（ch90探明）"><data key="name">迷宫61~66层构造与通用规则（ch90探明）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">66层=空之世界（草原+中央螺旋阶梯+艾尔芬里斯支配天空；被破坏物经时间自行修复——'应该是使用了魔力的『想起收束（Drop）』的一种应用'，据涡波推测）；65层=壅塞的三维阶梯迷宫（螺旋/四面倾斜/曲线阶梯构成'森罗万象的三维迷宫'；LizardFlyer每千米平均十匹）；64层=石质回廊+瘆人冷风+GreenHighElement；63层=地面发强光（迷宫如白昼）；62层=地面墙壁天花板皆发光（眩目太阳印象/视野大幅受限/牵手行进）；61层=天花板化作与太阳等同之物（光灼眼球）；通用规则：怪物不跨层追击（'低阶层的规则在深层也是通用的'）；Boss被打倒后至再度出现间隔约一小时（据莱纳）；</data></node>
    <node id="千年前『魔力』称『毒』与守护者同类黑紫魔力"><data key="name">千年前『魔力』称『毒』与守护者同类黑紫魔力</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">记忆旁白：『在这个时代，『魔力』被人称呼为『毒』』；男子感情暴走失控喷出的魔力呈不详黑紫，侵蚀所触一切、将存在次元扭曲崩壊（墙壁无创却可见外侧/地砖下露出大地断层）；据涡波识别：『就跟守护者的魔力一样。当守护者展现出全力的时候，也会发生一样的现象』『这是侵蚀世界的凶恶魔力的胎动』；男子复仇路中『不做多想地一味收集着『毒』，提升自己的级别』；在这个时代，『魔力』被人称呼为『毒』；魔力的颜色是不详的黑紫。它将接触到的一切全部侵蚀，将其存在的次元扭曲、崩壊。；这魔力是如此异常，我知道类似的魔力。就跟守护者的魔力一样。当守护者展现出全力的时候，也会发生一样的现象。</data></node>
    <node id="记忆抵抗的躯体证据（火焰飓风疑点与Freeze共鸣）"><data key="name">记忆抵抗的躯体证据（火焰飓风疑点与Freeze共鸣）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">①涡波保有『12级单独打倒二十三层火焰飓风Boss』的记忆但自我怀疑其真实性；②24层Freeze流通过好（『魔力的流通效果好过头了』）+对热/火焰理解驾轻就熟（『以前曾抑制过更甚热量的什么东西』的体感）——与ch38持剑寒意同族=核心记忆残留/抵抗的躯体层证据群（译注所述web/文库情节混杂不入库）；我有自己在二十三层打败了那个叫火焰飓风的Boss的记忆。只是，我对此有些怀疑。；就好像我以前曾抑制过比这个阶层的热量更甚的什么东西一样……莫名的驾轻就熟。；魔·力·的·流·通·效·果·好·过·头·了。</data></node>
    <node id="魔法『次元决战演算『前日谭』』（维度・GradientRecall）"><data key="name">魔法『次元决战演算『前日谭』』（维度・GradientRecall）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波倾尽全力的魔法的真正价值=将《未来》和《过去》连接在一起（此前两次发动所观测的《未来》《过去》皆非其本来的力量）。本章于MP0/HP26状态下超限第三次构筑：'这次与刚才不同，不只有从绘画中抽取出来的魔石，我要调动起这个空间内所有的魔石，重新进行咏唱'，将比五百年更早的《过去》与现在连接——北方诸国各时间线场所重叠于六十六层、万众之魂以泪洸具现复还（'在这个地方将他们想起收束（Drop）出来'）；被涡波自评为'就算这是改窜生命、亵渎死者、忤逆自然理法的邪门外道的魔法，我也不在乎'；效果随缇缇带风魔力的道别而解除——'我忤逆世界的理争取而来的时间终于结束，一切都复归于应有的姿态'。本章原文另</data></node>
    <node id="迷宫攻略计划革命(57层Connection+怪物护卫)"><data key="name">迷宫攻略计划革命(57层Connection+怪物护卫)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲自荐可与六十层附近的怪物『交流』使其反过来保护『Connection』转移魔法门（仅限六十层附近/需相当温顺的怪物）——此前涡波从未在守护者阶层以外设置『Connection』（『正道』结界妨碍+可能被怪物破坏两大理由）；据此于五十七层通往五十六层的阶梯附近安全设置『Connection』并以光魔法交流周边怪物、确保折跃点；可大幅缩短路程（涡波甚至动了回地上后去艾尔多拉琉学院拐一名光属性魔法学生入队的念头）；地下第五天即从六十六层困局推进至五十六层附近；与这附近的怪物进行『交流』的话，甚至可以让它们反过来保护您的魔法门。；泼您冷水真是不好意思，只限六十层附近才可以哦？另外就是要相当温顺的</data></node>
    <node id="新生超大型怪物群与无统率战场（ch160）"><data key="name">新生超大型怪物群与无统率战场（ch160）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">完全解放后诞生的怪物与此前中等体型不同——全是比大型还大型的超大型：撕裂天空舞于黑暗的蜈蚣/破土通天的树精/充斥黑暗的气体状怪鸟/独眼四足巨鬼/血口大张的蝙蝠群/八眼巨狼等无数高级别怪物（『表示』确认级别相当高）；凭迷宫回廊根本装不下的体型源源自地面诞生；未被统率故不紧咬追击（与此前有别）、亦有袭向帕林库洛者（巨型蜈蚣撕裂其液体之躯）——经怪物同化可被误认为同伴；不过，新的怪物们跟方才召唤的那些相比样子有些不同。之前尽是些中等体型的怪物，而现在出现的全都是比大型还大型的、超大型怪物。；撕裂天空舞动于黑暗之中的蜈蚣。破土而出直通天际的树精。不知不觉间充斥于黑暗之中的气体状怪鸟。从未见过的无数高级</data></node>
    <node id="『这里』现状与全责归因（据诺斯菲声称+涡波自认）"><data key="name">『这里』现状与全责归因（据诺斯菲声称+涡波自认）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲声称：存在于『这里』的人与物全部受到涡波的影响——首先诺斯菲与罗德二人，其次佩艾希亚国及其历史、王近卫骑士团成员与市民、生活文化，『全─部，都是您导致的』；涡波内心承认句句属实：因千年前的自己『这里』才以现在的形式存在，『相川涡波』『始祖涡波』『骑士团长』等名词在『这里』根深蒂固，存在于『这里』的一切都憎恨、追逐着他并索要罪孽的偿还——过去的自己犯下罪孽却逃避了应有的惩罚；其次还有佩艾希亚国以及其历史，王近卫骑士团的成员和市民、以及生活文化；全─部，都是您导致的！；而且她说的全部都是『事实』。</data></node>
    <node id="『注视』与『拟神之眼』性能差"><data key="name">『注视』与『拟神之眼』性能差</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波『注视』级别高于拉丝缇娅拉『拟神之眼』（'之前还以为是反过来的'）：涡波可显示至小数点后两位、装备物品与道具可见；拉丝缇娅拉看不到小数点、装备物品不可见、怪物情报部分可见、无机物情报完全不可得；『持有物品』被推测为次元魔法+古代魔法的应用（据拉丝缇娅拉）；涡波自游戏经验定名注视（Analyze）/持有物品（The·Pouch）；「然后就是涡波能力的事了呢……感觉涡波的『注视』，要比我的『拟神之眼』级别更高啊……」；就我来说，能够将属性的数值一直表示到小数点后两位。但是拉丝缇娅拉则根本看不到小数点。；就定为『注视（Analyze）』以及『持有物品（The·Pouch）』了。</data></node>
    <node id="拉丝缇娅拉的魔法底力（血中记录·ch119）"><data key="name">拉丝缇娅拉的魔法底力（血中记录·ch119）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">次元魔术未登录其血中（据其自述'太小众'）；冻结魔法不少；血中记录多种多样魔法与经验并活用于强化构筑；对决中短时间彻底改变构筑方式、超越无咏唱极限缩短构筑时间、手脚并用施法并用假动作隐蔽弹道、从四面八方施展不同属性魔法——叙述评'在战斗方面天赋异禀'；自断无法像缇亚那样魔力收束故威力低；次元魔术太小众了，以至于没有登录进我的血中啊。冻结魔法倒是有不少的说⋯⋯；魔力总量是我比较强。但是拉丝缇娅拉的血中记录着多种多样的魔法和经验。；在这么短的时间内，就彻底改变了自己的魔法构筑方式。超越了无咏唱，将魔法的构筑时间极限缩短。</data></node>
    <node id="MP枯竭后的生命代价规则"><data key="name">MP枯竭后的生命代价规则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莱纳自述（作为既有知识陈述）：'MP枯竭之后还要使用魔法的话，代价就是将生命当做薪柴'——榨出魔力的代价是燃烧生命（'我能感觉到自己的生命正在燃烧'）。；我能感觉到自己的生命正在燃烧。；MP枯竭之后还要使用魔法的话，代价就是将生命当做薪柴。恐怕这就是我今天使用的最后的魔法了。</data></node>
    <node id="弗茨亚茨的英雄谭计划"><data key="name">弗茨亚茨的英雄谭计划</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉人生全脚本（已被决定好的）：满心欢喜接受仪式成为圣人缇娅拉→以圣诞祭为舞台登场→奇迹之力开拓迷宫（正道延展+从格连手中接过最强之名——格连本人也是协助者）→舞斗大会优胜轰动大陆→凯旋弗茨亚茨本国→以活传说/圣人身份就任前线总大将投身大陆北部战争→为弗茨亚茨攫取战争胜果；她的英雄谭偏好本身疑为人为诱导塑造；再从格连手中接过最强之名。顺带一说，让渡名号的格连本人也是协助者的一员。</data></node>
    <node id="树人（Dryade）"><data key="name">树人（Dryade）</data><data key="type">种族(魔物)</data><data key="status">provisional</data><data key="desc">艾德血中所混魔物；其可见特征『全都被剔除掉了』（茶色头发处本应生有树人特征），仅衣服下残留——南方所受处置的痕迹；缇缇因同境遇不追问（『你也有不少自己的苦衷吧』）；是树人（Dryade）；因为一眼就能看得到的特征全都被剔除掉了⋯⋯现在只有藏在衣服下的地方还留着一些</data></node>
    <node id="第六十六层的背面（迷宫外侧结构）"><data key="name">第六十六层的背面（迷宫外侧结构）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德：'这里'在迷宫里面，以阶层数表示即『第六十六层的背面』，正确来说应称『外侧』——在此什么都没有的区域，'涡涡'用次元魔术将过去存在的『北』的王国原样做了出来；'在这里的话『想起』是比较容易的，涡涡这么说过'（据罗德转述）。涡波对此无记忆，并断言有能力做到此事的只会是一千年前的『始祖涡波』——迷宫存在'背面/外侧'新领域，非迷宫联合国亦非大陆本土；「『这里⋯』在迷宫里面呦⋯⋯」；「这里是涡涡为人家特别制造出的空间呦。如果要用阶层数来表示的话，就是『第六十六层的背面』呢。」；「背，背面⋯⋯？迷宫还存在背面这种东西？」</data></node>
    <node id="技能《？？？》对涡波感情的作用机制（ch114）"><data key="name">技能《？？？》对涡波感情的作用机制（ch114）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">曾将涡波对拉丝缇娅拉的恋慕'分解和重塑'→丧失原样：理性仍明白喜欢、感情跟不上、'让人心情高昂的爱慕已经不复存在'，仅余对此的愤怒与'遭到扭曲的感情的残骸'；发动临界与情绪挂钩：稍有疏忽/感情有一点波动即发动；涡波对策=压抑感情波动（'守护好不容易取回的感情的火种'）；本章涡波自评'症状比想象得还严重'；但是，因为那份感情被技能《？？？》给分解和重塑，现在已经丧失了原样。；虽然理性明白自己喜欢拉丝缇娅拉，但是感情却跟不上。；咕……，症状比想象得还严重……。不妙了啊……</data></node>
    <node id="佩艾希亚天气异变(暴风雨)"><data key="name">佩艾希亚天气异变(暴风雨)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">天气从未发生过变化的佩艾希亚如今被暴风雨支配——『就像之前的五十层那样，户外风雨大作』；失去天花板与墙壁的御殿遭受不断降注的雨水浇打；暴风雨同时扰乱『Dimension』的魔力探测；天气从未发生过变化的佩艾希亚，不知为何如今正被暴风雨所支配。就像之前的五十层那样，户外风雨大作。</data></node>
    <node id="会长的翻译魔法·方言调整（ch224）"><data key="name">会长的翻译魔法·方言调整（ch224）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据古奈尔：她本只普通地说自己老家的方言，千年前会长（相川涡波）嫌听起来太麻烦、用自己世界的方言对其语音加以「调整」；她抱怨这番对话千年前也进行过一次（据古奈尔声称）——库内近名『语言自动翻译现象』（cand-setting-f2ee48226cfa），关联判例1留R4；「那还不都是因为会长你的翻译魔法的原因嘛！明明咱这边就只是在普普通通地说自己老家的方言而已，可是会长却说什么听起来太麻烦就用自己世界的方言进行了调整啊！话说这番对话总觉得千年前也进行过一次吧！啊～，有点怀念诶！！」</data></node>
    <node id="『魔石人类』共通特征（级别初始化·全员『素体』·素质=寿命交换）（据海莉）"><data key="name">『魔石人类』共通特征（级别初始化·全员『素体』·素质=寿命交换）（据海莉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：『魔石人类』在级别1即有着各式各样的技能，'级别的初期化是『魔石人类』的典型特征'；'那个异样的高『素质』应该是以自己的寿命交换的'（涡波寿命不长由此外告知）；涡波转述反证：'魔石人类全员，有着技能『素体』'系魔石人类之证明——但被海莉指其隐藏持有『素体』而推翻；「『魔石人类』的话，即使是级别1的时候，在级别1有着各式各样的技能的事就能说明。级别的初期化是『魔石人类』的典型特征。而且，那个异样的高『素质』应该是以自己的寿命交换的。」；「那个，魔石人类全员，有着技能『素体』，这难道不是『魔石人类』的证明吗⋯⋯？但是我却没有那个⋯⋯！」</data></node>
    <node id="会（主）长（人）称呼"><data key="name">会（主）长（人）称呼</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺对会长的称呼实为 Master（译注明示）——『被你这样的女孩子如此称呼有点瘆得慌』→改称名字；斯诺自身意志淡薄（温驯+怠惰双面）的性格档案补充；真不愧是会（主）长（人）……</data></node>
    <node id="容器论三重并列（圣人缇娅拉／使徒西斯／始祖）（据海莉）"><data key="name">容器论三重并列（圣人缇娅拉／使徒西斯／始祖）（据海莉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：『圣人缇娅拉』的容器=大小姐（拉丝缇娅拉；'大小姐'指称据库内 ch138 用例）、『使徒西斯』的容器=缇亚、少年（涡波）=始祖为『再诞』而准备的『魔石人类』——容器结构首次三重并列；辅证对照：海莉（海因材料源）与海因'互相谦让着身体' vs 缇亚与使徒'互相抢夺着身体'（谦让/抢夺两种身体共有形态，后者缇亚争夺失败被吞没）；「恐怕，现在在这里的少年不识『相川涡波』本人。和『圣人缇娅拉』的容器大小姐一样，『使徒西斯』的容器缇亚一样，────少年是，始祖的」；「混杂在一起的我们，我希望请就这样请称呼我为『海莉』。以我的场合，从材料源的骑士海因那里，也互相谦让着身体⋯⋯⋯⋯」；相反缇亚的场</data></node>
    <node id="迷宫深层生态（21-23层）"><data key="name">迷宫深层生态（21-23层）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">21层：狂怒者群体（闻惨叫聚集；越二十层大型怪泉涌致正道难修）；22层：垂直高回廊+里约鹰（一击脱离/负伤即逃/求援；怪物不跨层追击）；23层：高温消耗（24层有岩浆——据格连）+耐久型怪物；正道终于23层=人类攻略极限（联合国一年到20层，21-23层耗时数年）；在过去，联合国只花了一年不到的时间便攻略至二十层，然而，二十一层到二十三层的攻略却拖了数年有余。</data></node>
    <node id="迷宫难度递减规律与六十层带怪物性质"><data key="name">迷宫难度递减规律与六十层带怪物性质</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">越往上走，迷宫的难度就会越低（涡波）；越接近六十层，没有战意的光属性怪物越多、攻略越来越轻松；在双守护者随行下涡波和莱纳丝毫没有消费HP和MP便自六十六层连下至六十层；到了六十层基本上以后就没有难关——回到地上这事儿已经是稳了（涡波判断）；这之后，诺斯菲还是一样给罗德戴着高帽，迷宫攻略也由此一帆风顺。越接近六十层，没有战意的光属性怪物越多，所以攻略一直都是越来越轻松。；我和莱纳就这么丝毫没有消费HP和MP便抵达了六十层。；到了这里的话，基本上以后就没有难关了吧。毕竟越往上走，迷宫的难度就会越低。</data></node>
    <node id="世界奉还阵（中心完全发动态）"><data key="name">世界奉还阵（中心完全发动态）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（再演重申，原设 ch0081；本章为174话原版细切片独立证据）阵之『中心』故咏唱更短、发动更快；发动完成后不依赖帕林库洛生死不可终止（『非边缘非实验』）；吸收周围火焰（玛利亚火焰障壁因此消失）；刨除Level与最大HP、将生物溶解为纯粹魔力（『像钻石粉一样晶莹地漂浮在空中』后逐一渗透白色大地）——怪物/人/野兽昆虫一律平等，唯持『理的盗窃者』魔石者例外；南军士兵认知中该阵=『就是那个计划当中的』『魔法阵』悲愿（信息不对称）；据涡波领会：帕林库洛侍奉国家晋升为将的一切皆为此瞬间（『全都是为了这一瞬而已』——推断态）；因为这里是『世界奉还阵』的『中心』。因此发动起来也更快了。；从魔力的流向来看</data></node>
    <node id="诺斯菲的留恋真形（ch197定形）"><data key="name">诺斯菲的留恋真形（ch197定形）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲当着涡波自白的留恋真形：仅仅只是想永远待在涡波大人身边、永远永远看着他痛苦的样子，为此要重新与涡波成为夫妻；自认爱与恨同时调和、这是『稍有些可爱的复仇』、『大多数人临死之际都会有的留恋』；宣称要重复『不正确的事』、犯下更多『错误』；须维持身体在不会消失级别的『平衡』；涡波确认『这个模样便是诺斯菲的真心』——昨夜她最感幸福时想的正是此事；我想要永・远・永・远・在・您・身・边・看・着・您・痛・苦・的・样・子。；我觉得这可是大多数人临死之际都会有的留恋。；我要将『不正确的事』重复一遍又一遍，犯下更多更多的『错误』！</data></node>
    <node id="次元之冬的极限（魔法道具与浸透魔法）"><data key="name">次元之冬的极限（魔法道具与浸透魔法）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本章两处极限实证：①无法干涉写在魔法道具之中的已经完成的魔法（魔石散炎戒指等碾碎施放型——对策=物理回避/冰膜护胸花）；②浸透到身体内部的强化魔法（Growth 身体强化0.70）无法施加干扰；既有极限=对自由构筑中的咏唱魔法有效（衰减/抹消/错开）——'次元之冬'的作用域边界明确化；『次元之冬』无法干涉写在魔法道具之中的已经完成的魔法。；使用者是佩露修娜·库艾伽。因为是浸透到身体内部的魔法，所以无法施加干扰。</data></node>
    <node id="千年前的喃喃：魔法阵·迷宫·再诞（据艾德）"><data key="name">千年前的喃喃：魔法阵·迷宫·再诞（据艾德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（再演重申，据艾德被『维度』窃听的自语）'涡波大人不仅是『魔法阵』和『迷宫』，就连『再诞』也失败了？无论是谁的『悲愿』都没能实现？所以对守护者的规则才会这样不完善？要是这样的话，在那之后世界到底变成什么样了──'；又言'忘掉你诓骗了我等的王这件事好了'（对涡波〔或其前世〕的千年罪指控）；涡波确认自己对此人此'过去'毫无记忆；「──怎、怎么会是这样？也就是说，涡波大人不仅是『魔法阵』和『迷宫』，就连『再诞』也失败了？无论是谁的『悲愿』都没能实现？所以对守护者的规则才会这样不完善？要是这样的话，在那之后世界到底变成什么样了──！」</data></node>
    <node id="拉丝缇娅拉的'两人份回应'（ch220·据塞拉）"><data key="name">拉丝缇娅拉的'两人份回应'（ch220·据塞拉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据塞拉（基督醉酒期间所告，莱纳复述、塞拉今确认'我想就是这样不会有错'）：圣人缇娅拉大人目前沉眠于拉丝缇娅拉体内，故此前拉丝缇娅拉面对基督的告白给出的是'两人份的回应'——ch213-215 拒绝之谜的塞拉版解释；莱纳因此顺水推舟选择与塞拉一同行动；「好的──我记得昨天提到圣人缇娅拉大人目前正沉眠于拉丝缇娅拉体内是吧？所以之前拉丝缇娅拉面对基督的告白，她给出的是两人份的回应是吗？」；「⋯⋯我想就是这样不会有错」；在基督醉酒的期间从塞拉口中听到这个原因的我顺水推舟地选择了和塞拉一起行动。</data></node>
    <node id="风之『咏唱』与孤版『加速』"><data key="name">风之『咏唱』与孤版『加速』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">咏唱=涡波传授、可对精神干涉之术，代价机制：'风之咏唱往往会让内心的重量减轻——换句话来说就是对内心的磨耗……用小刀一片一片地削刮比血肉还要重要的心'；真髓='以为了自己为目的，使用只为了自己而存在的话语，将自己的一切表现出来'；孤濒临崩坏时对'绝对不应当出手的东西'出手，创作属于自己的咏唱『加速』（'『加速』、『加速』……孤乃加速之魂'；前四句='玉座既临路一条/残躯已化风千束/孤以此生铭此愿/遍历悠世凭徒步'），以丧失为代价换取从不安恐惧中解脱的禁断快乐，借以勉强保持自我；[对、对了！使用涡波传授的『咏唱』就可以对精神进行干涉了……只要把『咏唱』的内容做些调整……然后利用『代价』应该就可以</data></node>
    <node id="塞斯提亚国"><data key="name">塞斯提亚国</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">芙洛拉殿下的祖国、临近弗茨亚茨国的国家；国王次女芙洛拉一直住在海对面的联合国，因开拓地局势凶险而归国本国王都（据克洛伊介绍与涡波所述现代地理）；除此之外也谈到了公主殿下的故乡塞斯提亚是临近弗茨亚茨国的国家这种现代地理知识。；「芙洛拉殿下是塞斯提亚国国王的次女，拥有王位的第四继承权。虽然一直以来都住在海对面的联合国，但因为最近开拓地的局势也变得凶险起来，所以她接下来要回到本国的王都」</data></node>
    <node id="阿雷亚斯家的宝剑诺文·能力明细（ch120实录）"><data key="name">阿雷亚斯家的宝剑诺文·能力明细（ch120实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">镶有守护者诺文魔石的剑；攻击力18，攻击力与装备者的级别共同计算；装备者能够仿行诺文・阿雷亚斯的剑术；可以改变形状；装备者的地魔法+2.00；──阿雷亚斯家的宝剑诺文；镶有守护者诺文魔石的剑；攻击力18</data></node>
    <node id="英格利特商会"><data key="name">英格利特商会</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前由尚未被称『始祖』的相川涡波与古奈尔因共同兴趣裁缝合办（涡波任『会长』），不久涡波甩手一切离会；古奈尔独力坚持运营为人民服务，以从涡波处获得的异世界知识为武器发展为执世界牛耳的一等一大商会；对古奈尔亦有以商会为后盾保护成为稀有人种之自己的目的；现为古奈尔领衔的『英格利特大商会』；咱就只是一个千年前、在『相川涡波』还没有被唤作『始祖』的时候一起合作过一段时间，借此赚了一笔钱的小人物而已。当时两个人一起组织了一家商会；在那之后，因为她跟我兴趣相投所以就一起行动了，并且就是在我们共同行动的时候组建了英格利特商会。当然，这也不全是因为兴趣相投，对她来说也有以商会为后盾保护成为稀有人种的自己的目的</data></node>
    <node id="帕林库洛的『咒术』精神攻击"><data key="name">帕林库洛的『咒术』精神攻击</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：帕林库洛'一如既往地擅长精神攻击'、'只在自己处于优势的时候才予人恩惠⋯⋯恰恰是卑鄙小人的做法'；据其对涡波说明：'这是帕林库洛的得意伎俩。一边谈话一边揪住别人内心的缝隙，操弄他人的精神。是偏离了常轨的『咒术』'——涡波受染实录：混乱7.87／精神污染1.22／认识阻碍0.23（自认程度轻得'跟平时没什么两样'）；「你还是一如既往地擅长精神攻击呢，帕林库洛。但是，只在自己处于优势的时候才予人恩惠这种做法，恰恰是卑鄙小人的做法」；「这是帕林库洛的得意伎俩。一边谈话一边揪住别人内心的缝隙，操弄他人的精神。是偏离了常轨的『咒术』」；──状态：混乱7.87精神污染1.22认识阻碍0.23──</data></node>
    <node id="英雄的社交经济学"><data key="name">英雄的社交经济学</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">舞会=打个照面就能催生上千枚金币的利益场+一个照面延伸过千人脉+一份契约拯救千生命的战场价值（斯诺论）；金币握手=人情投资（回绝则人情没了甚至结怨恨——『英雄』被敬而远之的传闻影响）；『英雄』对国家有利可图故被捧起牟利；涡波初次照面所得已够玛利亚医疗费级——'不觉间已踏进没法回头的地方'；「……这里可是打个照面就能催生上千枚金币的利益的地方。也是只要结识一个人就可以延伸出过千的人脉的地方。在这里订下一份契约或许就会在某处的战场上拯救过千的生命。因此这也是对劳拉维亚有益的出色的工作。」；也就是说，『英雄』这一存在对国家来说是有利可图的。所以要将我这样的新星捧成『英雄』牟利。</data></node>
    <node id="迪亚布罗·西斯状态栏（ch39实测）"><data key="name">迪亚布罗·西斯状态栏（ch39实测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">等级11/职业剑士：HP179/182 MP821/831；力量6.32 体力5.39 技巧3.02 敏捷3.18 贤能9.99 魔力45.12 素质5.00；状态：加护1.00；先天技能：神圣魔法3.80 神之加护3.08 断罪2.00 集中收束2.05 属性魔法2.10 过捕护2.12 续命2.24 良机2.03；后天：剑术0.10；？？？：？？？（状态栏底行未知项）——魔力45.12 异常高+魔力远超HP承载规格；名字：迪亚布罗·西斯HP179/182 MP821/831职业：剑士；？？？：？？？</data></node>
    <node id="古尔亚德国的地理定位"><data key="name">古尔亚德国的地理定位</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">联合国南端·唯一临海国（港口众多）——七人逃亡首站与出海基地；古尔亚德国位于联合国的南端。；因为古尔亚德是联合国中唯一临海的国家，故而港口众多。</data></node>
    <node id="涡波千年前记忆范围（自白）"><data key="name">涡波千年前记忆范围（自白）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自述：现在的他没有千年前的记忆，所记得的『也就只有妹妹和使徒她们，再有就是缇娅拉的事情』；罗德指其唯独记得妹妹酱之事却不记得诺斯菲是问题——记忆结构的选择性存疑；另自述失忆缘由：千年前的最后遭到『使徒勒伽西』的妨碍，导致在不完全的状态下被迷宫召唤出来（据涡波自述，转告诺斯菲）；「其实现在的我没有千年前的记忆。所以说，我并不认得你是谁。；「就算你这么跟我说⋯⋯⋯但是我记得的，也就只有妹妹和使徒她们，再有就是缇娅拉的事情了啊⋯⋯」；似乎是因为在千年前的最后遭到了一个叫使徒勒伽西的家伙的妨碍来着，结果导致我在不完全的状态下被迷宫召唤了出来。</data></node>
    <node id="《守护者》与留恋消散机制"><data key="name">《守护者》与留恋消散机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">死后的理的盗窃者之身份；在乐园中之人=与守护者共同点众多的'拟似的守护者'，亡逝机制亦相似：发自心底认同并接受一切、感到幸福之时生命便在该状态下终结——身体化作光的粒子升天成为漂浮于漆黑穹顶的明星（魔石）；该魔石'依旧残留有当事人的人格，但却丧失了自我'（状态如尸体），可再次发动想起收束以'只有人格没有自我'之态唤醒；魂过于致密者（如罗德）无法随之消散；带着生涯最美的笑容，他的身体逐渐转变为光的粒子。；调查的结果表明：漂浮在空中的明星——也就是魔石，依旧残留有当事人的人格，但却丧失了自我。；[正是，简要来说，就是在诸位发自心底地感到幸福的时候，生命便会在那个状态下终结。『这里』就是为了让所有人</data></node>
    <node id="白樱（达利尔·艾德传声之树）"><data key="name">白樱（达利尔·艾德传声之树）</data><data key="type">地点·媒介物</data><data key="status">provisional</data><data key="desc">第二迷宫都市达利尔中负责传递艾德声音的树木：随其怒吼颤悚、震落树叶与白花；缇缇靠近触摸振动之树并在战后以风敲打树木向树对面喊话——存疑：与 ch0207『白樱树』（缇缇家旁纪念树）是否同株原文未判明，分开建不合并（判例1口径）；负责传递艾德声音的『白樱』颤悚着，只见树叶和白花纷扬而下。接着便是一道仿佛呕出鲜血的怒吼盈满了『第二迷宫都市达利尔』；缇缇不光提问，同时还伸手触摸振动着的树木。；这些风的目标是周围所有的树木，缇缇一边用风敲打这些树木一边向树对面的人喊话。</data></node>
    <node id="三技能才能归属（阳滝才能判明）"><data key="name">三技能才能归属（阳滝才能判明）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『水之理的盗窃者』魔石剥离后，『冻结魔法』和『并列思考』完全消失、『剑术』数值减少——涡波对照状况判明这三个技能并不是自己的才能、而是阳滝的才能；『剑术』的感觉产生错乱；连『次元之冬』也因无法操纵冷气而不可再使用（冻结属性相关被刨除）；因为『水之理的盗窃者』的魔石被剥离，我的身体丧失了平衡。因为失去了一个人的素质，我的状态数值减少了。；『冻结魔法』和『并列思考』完全消失了。；对照状况来看，我意识到这三个技能并不是我的才能，而是阳滝的才能。</data></node>
    <node id="魔王城=佩艾希亚城双正式名与无人现状（ch172）"><data key="name">魔王城=佩艾希亚城双正式名与无人现状（ch172）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据雷纳尔多：魔王城的另一正式名为『佩艾希亚城』，'这两个都是正式名字。无须在意'；武器/魔法道具需求存在，但'现在已经没有人待在会产生需求的场所'（城内除现居者外无人，原因未明）；其不打武器只因无相应订单（即便有也都是生活用的魔法道具）；此信息'与罗德口中有些不同'（涡波注记）；需求不是没有。但现在已经没有人待在会产生需求的场所了；「没错，就是『佩艾希亚城』」；「这两个都是正式名字。无须在意」</data></node>
    <node id="『魔石线』（ch153·决战地位于线上）"><data key="name">『魔石线』（ch153·决战地位于线上）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛踏地明示现决战地『也在「魔石线」之上』，与『世界奉还阵』『中心』宣告同句——『魔石线』与『世界奉还阵』的空间从属关系为本章新证（承 ch147 濒死续唱时魔石线发光的媒介观察）；表示这里也在『魔石线』之上。同时宣告这里就是『世界奉还阵』的『中心』</data></node>
    <node id="被赋予的使命论（莉帕洞察）"><data key="name">被赋予的使命论（莉帕洞察）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莉帕对三人的同构诊断：诺文被『阿雷亚斯家赋予的使命』所困/斯诺被『沃克家赋予的使命』所困/涡波被『某人赋予的使命』所困（'你们的境况都是一样的'——唯『英雄』对涡波非必须故生疏离感）；英雄否定论（'我并不觉得那是多么美好的东西'）；三重意志成为共同的精神根基——涡波自省'想要去依靠莉帕的自己感到羞愧'；「……诺文被『阿雷亚斯家赋予的使命』所困，斯诺姐姐被『沃克家赋予的使命』所困。而同样的，大哥哥你也被『某人赋予的使命』所困。只是在这之中，『英雄』的存在对大哥哥来说不是必须的，所以让你产生了疏离感吧？……其实在我看来，你们的境况都是一样的。」</data></node>
    <node id="莱纳的特制木手铐"><data key="name">莱纳的特制木手铐</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳双手所戴木制手铐：蕴含魔力、为特制品——莱纳腕力本可破坏木制却'无法用腕力挣脱'；系'队伍里有捆绑兴趣的同伴'所戴，非其本人亲自取下则拿不下来；佩戴非莱纳本意；莱纳自称'戴着也不碍事'（战斗中无法使用双手的问题其本人未视为障碍）；我瞟了手铐几眼。那手铐是木制的，一般来说如果莱纳用力应该很容易就能破壊掉。但是也能看出手铐里蕴含着魔力，是特制的东西，可能因此才无法用腕力挣脱吧。；「用不着。反正戴着也不碍事」；「你真缠人啊，我知道了啦！我给你说明行不行！这是被队伍里有捆绑兴趣的同伴戴上的啦！如果不是那家伙本人亲自取下来的话，这个手铐就是拿不下来的啊！」</data></node>
    <node id="守护者应对经验则（据涡波归纳）"><data key="name">守护者应对经验则（据涡波归纳）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">从以往经验看，应付守护者'比起与之敌对，与其交谈是个比较有效的选项'；回溯：初战的缇达是战斗狂、其他三个人都没有突然袭击过来——愿望是『好玩的事』的缇达属特殊存在；本章罗德亦无敌意（'眼前这位名为罗德的少女确实没有任何敌意'），交谈成立；但是，从以往的经验中可以知道，对于应付守护者来说，比起与之敌对，与其交谈是个比较有效的选项。；眼前这位名为罗德的少女确实没有任何敌意。回想过去，除了初战的缇达是个战斗狂之外，其他三个人都没有突然地袭击过来。；也许，愿望是『好玩的事』的缇达是属于特殊的存在吧。</data></node>
    <node id="迷宫56~50层环境与怪物配置(ch92)"><data key="name">迷宫56~50层环境与怪物配置(ch92)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">56层=通常模式石质回廊（光属性影响下无好战怪物、安全范围）；行至深处光属性荫蔽到头（亮度下降/如坏灯泡忽明忽暗）；55层=怪物已无光属性、模样狰狞凶猛、天花板稍高如肮脏石窟、怪物主动袭击（狼型SkyWolf：位阶52/四肢由魔力构成可踏空而行/前足化钩爪/反应极快/被WindFlamberge一刀两断）；55→54层途中山道峡谷地带（以『Wind』浮力如羚羊登崖）；54层部分地貌同前、大部分石质回廊；53/52层强行军通过；50层=『风之理的盗窃者』阶层、辽阔草原狂风不休（构造与艾德四十层相似）、越近中央云层越厚终降暴雨成风暴=罗德哭泣之象征（呼应阿尔缇第十层『此处景象乃是我的写照』）；光之</data></node>
    <node id="缇缇的成长异常"><data key="name">缇缇的成长异常</data><data key="type">现象</data><data key="status">provisional</data><data key="desc">年龄不过两位数而体格超祖父母、与成人无异；发色草绿→通透翠色、羽翼复原；『就好像『世界』在有意催促人家快些长大一样』——异常成长速度被叙述为『世界』的有意行为；相对地艾德个头几乎不变；尽管混有夏比之血的族类成长速度都偏快，但这样反常的成长速度还是有些异样。明明自己的年龄还不过两位数；就好像『世界』在有意催促人家快些长大一样。；成长速度迅速的人家虽然年龄还不到两位数，但身高却超过了爷爷和奶奶，拥有一副与成人无异的身体。</data></node>
    <node id="亡灵一闪的魔法原理(无魔力咏唱)"><data key="name">亡灵一闪的魔法原理(无魔力咏唱)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">颠覆『魔法是使用魔力构筑的』世界前提：诺文通过『咏唱』支付『代价』（恐为其人生本身）实现无魔力魔法——『说不定，只要有那个『代价』魔力就不是必要的了。不对，难道说魔力本就是『代价』的替代品吗』；感应驱使下顺身体指引仅挥一剑的招数=剑士最终境界·剑之终点；缔造魔法的始祖定义其为魔法；虽说这里是个无视了原本世界中的物理法则的世界，但它的魔法还是立足于一定的法则之上的。而在那之中就有『魔法是使用魔力构筑的』这一前提。；不对，难道说魔力本就是『代价』的替代品吗……？</data></node>
    <node id="研究院（魔石人类研究）"><data key="name">研究院（魔石人类研究）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莱纳：露洁与诺瓦露'是从研究院那边把她们带出来的'，海莉以'因为跟我一样'为由主张收容；涡波由『素体』『魔石人类』『研究院』等词得出国家层面的魔石人类研究属不人道行径的印象（本章推断，非实证）。；「是从研究院那边把她们带出来的。海莉小姐说是『因为跟我一样』什么的，所以也没办法喽」；『素体』『魔石人类』『研究院』『跟海莉一样』；这些冰冷的话语，只能给我以一种不好的印象。看来国家在进行的关于『魔石人类』的研究是不人道的行径。</data></node>
    <node id="『世界奉还阵』机制（ch161更新）"><data key="name">『世界奉还阵』机制（ch161更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">阵与『最深部』相接（据帕林库洛旧言，涡波本章亲证）——阵下为'世界深渊'级广阔空间，满满世界之『真理』『记忆』与『力量』；非人可忍空间（涡波可入因身体接近『怪物』），仅滞留即侵蚀心灵；呼唤特定之名（阳滝）可致阵世界震动与应答；可强化阵之『羁绊』于广大世界中搜索；以自力到达『最深部』取出'能让现实得到确认的『记忆』'为可能；阵深处之声会引发『灵魂』反射反应；没想到是如此的广阔的黑暗。帕林库洛说过把『世界奉还阵』和平『最深部』连接在了一起。通过他说的，正所谓可以称呼为世界深渊的世界，地面上张开的『世界奉还阵』的下面十分的广阔。；那里是满满的世界的『真理』『记忆』与『力量』；仅仅只是这样而已，『世界</data></node>
    <node id="技能『？？？』暴走·混乱·『反馈』机制（ch161全解）"><data key="name">技能『？？？』暴走·混乱·『反馈』机制（ch161全解）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">暴走='与一部分的感情为交换，使精神安定化'+混乱补正+1.00；『状态』栏表示出一切异常、混乱值变动；混乱10.00=界限——达成即'超越了技能『？？？』的界限'，积存混乱把原来感情『反馈』回来（连本带利：恶感情与记忆+『爱情』，超过致死量、足以让心壊死）；为抑感情技能会再发动→『反馈』循环='绝望的连锁反应，死的一方通行'；发动可任意为之（非自动）；本章涡波全解放『并列思考』自行处理感情破循环——首次脱循环系靠帕林库洛精神魔法（外力）；与一部分的感情为交换，使精神安定化。；────混乱10.00达成，超越了技能『？？？』的界限。；积存的混乱，把原来的感情『反馈』了回来。</data></node>
    <node id="守护者制度"><data key="name">守护者制度</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫第十层与第二十层各镇守大Boss『守护者』：知性超群、可于迷宫自由穿行（低层亦可能遭遇）；聚集联合国最强探索者亦未能击败；近年罕见现身如谈资；正道铺设（至23层）途中试练未被完成、二十层后难度跃升致停滞；「没错，就是出现在迷宫十层和二十层的大Boss。」</data></node>
    <node id="深层探索的MP枯竭风险（ch127）"><data key="name">深层探索的MP枯竭风险（ch127）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">归船需以『连接』造门耗MP；反复激战后涡波MP所剩无几——'一个不小心，可能会遭遇没有MP无法从迷宫中出去的状况'；来到深层后必须对MP枯竭风险多加留意、有必要重新制定今后的探索方针；MP不足时可由莉帕帮忙补充；「好了，那我这就把门造好。──『连接』」；一个不小心，可能会遭遇没有MP无法从迷宫中出去的状况。来到了深层之后，必须要对这个风险多加留意才行。</data></node>
    <node id="次元魔术境界论（领域交错·级别超越）"><data key="name">次元魔术境界论（领域交错·级别超越）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『这是让『领域』和『领域』相交错的魔法』——『DistanceMute』使施术者的领域与对象领域连接：物理上仅如蚊叮，魔法层面上『次元魔术使（相川涡波）这一凶恶的病原体正在侵蚀艾尔芬里斯的存在』；『在次元魔术使面前体积和距离是没有意义的』；『达到了这个境界之后，级别的强弱已经是细枝末节的问题，早就可以超越其上』——系谱：『圣人缇娅拉』奠基→『始祖涡波』完成；但是，在魔法的层面上，当下的状况，则是次元魔术使（相川涡波）这一凶恶的病原体正在侵蚀艾尔芬里斯的存在。；无论体型如何巨大都没关系。在次元魔术使面前体积和距离是没有意义的。；这是让『领域』和『领域』相交错的魔法。</data></node>
    <node id="世界奉还阵（千年前魔法阵·再现）"><data key="name">世界奉还阵（千年前魔法阵·再现）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（再演重申·原设 ch0080；本章为168话原版切片独立证据）帕林库洛濒死续唱之阵的正体=咒术『世界奉还阵』——『那个千年前将你们吞噬的『魔法阵』』、已完全覆盖『本土』北部、为莉帕（『死神』）们的天敌魔法；本章运用实证：①改变魔力吸收率之活用——结界内『魔石人类』无法战斗（拉丝缇娅拉面色发青跪地=魔石不足症状；莉帕呼吸困难丢镰刀=魔力不足）；②对象集中设置（对塞拉・蕾蒂安忒——中庭『魔法线』之光收束射向）；③蕴含可抹杀人的存在之力（塞拉存在本身变薄弱/『表示』数值肉眼可见减少/似『魔石线』吸收『级别』——实为吸收『魔力』）；④『持有魔石』者难生效（据帕林库洛：『所以说『持有魔石』的人就是难对</data></node>
    <node id="玛利亚的持续头痛（同型症状）"><data key="name">玛利亚的持续头痛（同型症状）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚身体恢复顺利可正常行动，但头痛仍续；对拉丝缇娅拉·弗茨亚茨/迪亚布罗·西斯二名无印象；涡波判断『搞不好玛利亚的头痛跟我的症状是同种类型』（改篡副作用的同型性）——解纵横字谜式的接近感；「头痛是吗？确实、还有一些……」；「突然之间是怎么了……？我没什么印象……」；但她的头痛仍在继续，搞不好玛利亚的头痛跟我的症状是同种类型。</data></node>
    <node id="柯尔库（港口城市）与魔石线"><data key="name">柯尔库（港口城市）与魔石线</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">瓦尔德本国东部的港口城市（无迷宫故冒险者/探索者少、因近战场驻军成反比增多）；街景与联合国的古尔亚德没有多少不同（古尔亚德=对照级提及）；战时警备森严：五米高城墙+全副武装士兵把守关口、无凭信赴关口即被拘留（涡波一行有联合国罪行暴露之虞，行贿留作最后手段）；城墙警戒线『魔石线』——一瞬间翻越则无反应（被当作鸟兽）；商业一般繁荣，但居民活力外表下暗藏阴翳（前线紧张感/火药味）；这里是瓦尔德本国东部的港口城市，名叫『柯尔库』；但是在远处一看，发现戒备十分森严。足足有五米高的墙壁围着城镇，全副武装的士兵们把持着关口。；「不不，不会有间谍有我们这样的本事的哦……只要在一瞬间翻过城墙的话，『魔石线』是不</data></node>
    <node id="决赛观众席全景(声援结构)"><data key="name">决赛观众席全景(声援结构)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一边倒结构：基本无人给怪物诺文加油（联合国以迷宫为中心·被怪物杀过同伴者众）vs 涡波粉（斯诺/玛利亚/缇亚[未认可宣言]/塞拉点心/拉丝缇娅拉前排/史诗探索者全员[艾利巴茨=两剑锻造者·最年少会员=初对手·波鲁扎克·缇莉]/贵族[塔利亚家康纳·科菲尔德家凯因]/圣诞祭要人/七骑士[芙兰琉莱缺席寻莱纳]/莱纳阴影潜伏无杀意/克劳+店长+玲小姐/艾尔米拉德/接待员姐姐粉丝俱乐部）；唯一例外=孤儿院孩子们；「应援方向一边倒啊。说诺文是怪物的话，就没办法坦率地给他加油了啊。联合国是以迷宫为中心的国度。被怪物杀死了同伴和家人的人有的是。在他们之间，要给怪物加油可是需要勇气的。」；「看啊看啊，那个！那把</data></node>
    <node id="魔术式体系"><data key="name">魔术式体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">以文字形式将人们使用的魔法构造再现；对其注入魔力即可发动，但使用者对魔术式的理解与相性亦重要；'魔法和魔术式是两个不同的领域'（擅长魔法≠擅长魔术式，如擅长运动≠擅长运动科学）；镌刻魔术式的魔石市价高昂（凝结熟练匠人相当长的时间与气力、不容瑕疵）；最高级例=玛利亚服下的『萤火』『Impulse』魔石；涡波因次元魔术使的魔法理解＋研究者气质而'还是挺了解的'；那是指以文字的形式将人们使用的魔法构造再现出来的事情。再对其注入魔力的话，就能顺利地发动魔法。；魔法和魔术式是两个不同的领域。；每一个那样的魔石，都凝结了熟练匠人相当长的时间和气力。</data></node>
    <node id="魔人变还与魔人化（ch221首录）"><data key="name">魔人变还与魔人化（ch221首录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『魔人变还』=LevelUp的进行超过人类原本的极限导致身体的怪物化；后天变化（联合国『兽人』为天生种族），成因=吸收魔之毒剂量过大、毒侵蚀带来各种负面影响。高等级兽人将『兽化』用到魔人变还水平可将实力提高到异常水准，代价=平时肉体变得与怪物相近；带有代价的『龙化』『兽化』现被统称为『魔人化』（例证：斯诺·沃克的『龙化』——一时强化、后遗症身体向龙演变）。该说法据莱纳所闻系其与基督不在的一年里由艾德推广开来。文内异写：行45『魔人返还』与行50『魔人变还』同指（'拉丝缇娅拉口中的这个词'）。；明明塞拉酱到26级就已经濒临『魔人返还』的界限了，但莱纳居然还没到啊。；『魔人变还』——拉丝缇娅拉口中</data></node>
    <node id="守护者的消失条件与『家人』假设（ch191更新）"><data key="name">守护者的消失条件与『家人』假设（ch191更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德自述'就这样在『这里』继续生活下去的话，人家就会消失了'且'佩艾希亚的和平是现在最期望'（与接引艾德方案表面矛盾）；诺斯菲自称'可能很快就要因为留恋实现而消失了'——涡波依'身体存在感的强度'判断不至立即消失（还需听取几次任性）；涡波诊断：罗德'就因为一直都没有一个心意相通的人陪在你身边，所以你才不论过了多久都没办法消失'→需要『家人』；「就这样在『这里』继续生活下去的话，人家就会消失了⋯⋯所以，不用叫艾德过来也可以⋯⋯因为佩艾希亚的和平就是人家现在最期望的了⋯⋯」；「对你来说『家人』的存在应该是不可或缺的。就因为一直都没有一个心意相通的人陪在你身边，所以你才不论过了多久都没办法消失。我认</data></node>
    <node id="守护者的威压与常人耐受"><data key="name">守护者的威压与常人耐受</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">来自守护者的压力足以令一般人当场吓昏（叙述）；克洛伊坚持对峙属例外级耐受力；缇缇的威压方案（令敌方总司令无法行动→双方群龙无首→战争自然僵局；瘫痪整条前线；灭掉双方）被涡波依其女王时期经历判定为非虚张声势；毕竟是来自守护者的压力，一般人的话早就已经吓昏了。克洛伊小姐能坚持这么久实属不易。；关键是让双方平等地陷入群龙无首的状况。如此一来，在一段时间里战争自然会陷入僵局</data></node>
    <node id="『魔人返还』计划（艾德）"><data key="name">『魔人返还』计划（艾德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据艾德：让以『兽人』形式得到安定化的同胞之血『再次活性化』——把身体被『魔之毒』秽犯、因异常性遭周围排斥的存在重新孕育出来，再把『魔人』重新作为共通认识创造，使佩艾希亚复原为『魔人』之国；实现北方全体预计只要五十年（有『支配之王』在；先称一千年可成被缇缇怒斥后以宰相口吻改算）；手段=激化南北战争烈度、把士兵逼上绝路支付『代价』、拣选有能之人促进人类成长→魔人返还者自然增多→遭普通人畏惧贬斥→北方向被排挤的新生魔人伸援→将魔人聚于旗帜之下的『北方同盟』彻底击溃『南方联盟』、世界统合为一；艾德自辩其愿望非魔人消却、而是作为支配之王的宰相打造属于魔人的乐园、与王携手铸就世界和平；（正因如此，鄙人现在</data></node>
    <node id="次元魔术特化与四维感知（『先谭』机制）"><data key="name">次元魔术特化与四维感知（『先谭』机制）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">体内魔石只剩『次元之理的盗窃者』后次元魔术反得特化加强（刨除与冻结属性魔力相关的一切→对次元属性理解更深）；借此实现对『次元之理』的掌握；可认知次元数量增加一个——在纵・横・高的三次元空间添加一道时间轴、世界延伸（刹那世界群中光完全停止运动/时间感彻头彻尾转变）；该力量近似『预知』但严格来讲并不是；令人感到讽刺的是，在身体内的魔石只剩下『次元之理的盗窃者』这一个之后，我的次元魔术反而得到了特化加强。刨除了与冻结属性的魔力相关的一切之后，我对次元属性的理解变得更深了。；我借此而可以实现对『次元之理』的掌握。；在原本只有纵・横・高的三次元空间中，又添加了一道时间轴。仅仅如此，就让我能看到的世界延伸</data></node>
    <node id="MP超支的HP补偿机制"><data key="name">MP超支的HP补偿机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">MP 枯竭后仍可继续施法：不足的 MP 由最大 HP 补偿（生命值随施法不断削减——『我的生命在不断削减着』）；主角以近乎自毁的冻结代价冻僵缇达；不够的MP会由命——、由最大HP来补偿。</data></node>
    <node id="『光之理的盗窃者』=60层守护者（ch90推测）"><data key="name">『光之理的盗窃者』=60层守护者（ch90推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波推测：'这种亮度、光芒……恐怕在六十层的守护者应该就是『光之理的盗窃者』了吧？'；规律佐证（莱纳）：'接近『木之理的盗窃者』艾德的阶层的时候，也尽是有自然气息的地方啊。果然，现身的守护者跟周围的阶层有共通性'→涡波：'应该是守护者的力量对周围的阶层产生了影响吧'；莱纳判断其非神圣魔法专家（'神圣魔法和光魔法是不同的东西'）；涡波对光魔法'信息少得可怜，只是稍微了解一点魔法的倾向'（非战斗偏向型）；这种亮度、光芒……恐怕在六十层的守护者应该就是『光之理的盗窃者』了吧？；是啊，说来接近『木之理的盗窃者』艾德的阶层的时候，也尽是有自然气息的地方啊。果然，现身的守护者跟周围的阶层有共通性吗。；应</data></node>
    <node id="咏唱与咒术体系(罗德讲授)"><data key="name">咏唱与咒术体系(罗德讲授)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">【话192版·涡波失忆后重授再证】据罗德讲授：『咏唱』严格来说是『咒术』的一种——'将用『咒术』增强『魔法』的力量这个说法美化了之后才冠以了『咏唱』这个名字'；『咒术』基本＝'以什么为牺牲并将之转换为力量'、是'与『魔法』在某些方面互为表里'的独立技术（非魔法的一种类）；被莱纳称作神圣魔法的『LevelUP』本质＝『咒术』（'将『毒』作为代价牺牲掉之后转变为力量'）；'所有人应该都在无意识的层面掌握了『咒术』的基础'、进阶只需另授与『魔术式』不同的『咒术式』；『代价』梯度：一般＝'支付与咏唱所花费的相等时间'→随危险度提高＝'失去第二天理应回复的魔力以及体力'→更严重＝不可逆精神变化；属性代价</data></node>
    <node id="『连接』运用现状（ch216）"><data key="name">『连接』运用现状（ch216）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波MP最大值1275，单纯计算最多可设置十二个『连接』；已在酒馆设置一个（剩十一个）；本章于古尔亚德繁荣港口的人迹罕至小巷新设一个；以各地设点缩短联合国内行动时间；我现在MP的最大值为1275。单纯计算一下的话最多可以设置十二个『连接』；因为已经在酒馆设置了一个，所以还剩下十一个。；「在各地设置好『连接』行动的话，应该能节省不少时间吧⋯⋯好的，那么我们先去古尔亚德，然后再前往劳拉维亚吧」</data></node>
    <node id="帕林库洛的战时动向"><data key="name">帕林库洛的战时动向</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：帕林库洛=擅长辅助魔法的骑士、『天上的七骑士』时代战力老是吊车尾（仿真战一次都没赢过塞拉）、绝不会堂堂正正战斗、定会对涡波玩弄手段释放精神魔法；据西娅：现任『南方』总大将的参谋、在最前线指挥军队、位置距柯尔库稍偏北；涡波在劳拉维亚时已闻其作为将领被召回本土；数日前致信西娅（书信本章为涡波所得）；「没错。在『天上的七骑士』时代，基本上他的战斗能力老是吊车尾哦。仿真战里一次都没赢过塞拉呢。」；我在劳拉维亚的时候，就听说过帕林库洛作为将领被召回了本土这件事，果然那家伙目前正处于战争的中心。；「知道的！就在前几天才收到他的来信，里面有提到的。正好我们队伍也要赶去他身边！」</data></node>
    <node id="魔石人类的特征与『容器』说（海莉论）"><data key="name">魔石人类的特征与『容器』说（海莉论）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉声称：等级初始化是『魔石人类』典型特征；所有魔石人类均有技能『素体』（身份证明）；异常之高的『素质』以自身寿命为代价；涡波是千年前的传说中被创造的唯一『魔石人类』——为始祖『相川涡波』的『再诞』准备的『容器』，制造用了相当多的人做材料（旁证：使用少年之血后海莉出现性别转变等问题）、其16年记忆极可能是事前准备的『调整』；技能『？？？』的效果即是对他的调整（不丧命/不崩溃/能一直前进）；其现有症状=留存于容器之中的始祖涡波的血渐渐活化。以上为海莉推测+自证；涡波保留违和感（帕林库洛主导海莉诞生，其认识或被动手脚、拦截或为陷阱）。；等级的初始化是『魔石人类』的典型特征。；为了制造出少年这一『</data></node>
    <node id="风之理"><data key="name">风之理</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">风的理（法则）；被罗德自称为『盗取』的对象，构成其毁灭性力量的来源；被孤盗取的『自由之风』啊！风之理啊！；孤将『风之理』打进了施展于这个空间内的涡波的魔法中</data></node>
    <node id="『炎之矢』（玛利亚·全力版）"><data key="name">『炎之矢』（玛利亚·全力版）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚咏唱的单调火焰弹丸因其巨大魔力量质变：连熔岩也能融化、大小可让大型魔兽一瞬间蒸发、'只要不死花上几个月就能够得到治疗的这种赦免感全无'；本章两度使用——预读西斯逃跑路线直击（被光翼包裹防御，无烧伤）+追击战'那就可以不顾虑的上了'的无限制支援射击（'这一带都会变成灰烬'级火力）；「『炎之矢』」；使得这个炎弹拥有了连熔岩也能融化的力量，这个炎弹的大小能够让大型魔兽一瞬间蒸发。；只要不死花上几个月就能够得到治疗的这种赦免感全无。强大的魔法。</data></node>
    <node id="千年前南北战争证言补充（诺斯菲/罗德口述）"><data key="name">千年前南北战争证言补充（诺斯菲/罗德口述）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲自述：南方『御旗』诺斯菲与北方『骑士团长』涡波大人置于对立面（罗密欧与朱丽叶式悲剧命运），诺斯菲迎来死亡、涡波活下来并打造迷宫；据罗德：诺斯菲之死为其自爆（『那不是你自己擅自自爆的么』），诺斯菲自解『如果不使用足以毁灭自我的魔力，就没法胜过你』；诺斯菲因罗德而被大陆吞噬，战后打造迷宫时两人曾冷静沟通过；双方均自称『为了世界和平』而战；诺斯菲自陈对南北皆无留恋、对世界和平不执着，罗德斥其『当时的领袖居然把这种话说出口了』；「──我的名字叫做诺斯菲。曾经作为南方阵营的『御旗』置身于战争之中。那时候的涡波大人则是北方阵营的『骑士团长』。我们的关系简直跟罗密欧与朱丽叶如出一辙，悲剧性的命运将你</data></node>
    <node id="海莉≠海因判定（记忆继承者非本人）"><data key="name">海莉≠海因判定（记忆继承者非本人）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉断定'那孩子不是海因，完完全全是两个人…只是因为有记忆所以有些相似'；'圣人缇娅拉的『再诞』之魔法怎么可能是帕林库洛模仿的来的嘛'（据其言可反推帕林库洛曾试图模仿『再诞』——推断标注）；玛利亚附议：海莉的血和魂与海因'太过异质'；涡波存疑（'海因的余韵还是在的'）但未反驳；旁白：海莉自称为失败作、主张自己不是海因，但其临别之言令涡波感觉'简直就是海因在跟我说话'；众人确信海因・赫勒比勒夏因已经不在；「不不，那个不是明摆着的么。那孩子不是海因，完完全全是两个人呢。不管是外表还是气质都是。说到底只是因为有记忆所以有些相似罢了。再说了，圣人缇娅拉的『再诞』之魔法怎么可能是帕林库洛模仿的来的</data></node>
    <node id="佩艾希亚时间轴扭曲·千年前战时状态（ch195）"><data key="name">佩艾希亚时间轴扭曲·千年前战时状态（ch195）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德/诺斯菲扭曲时间轴后佩艾希亚再现千年前大战之时（据罗德的话：大战之后或正酣）：街道草木燃烧殆尽、房屋倒塌废墟、暴风雨中无一人影；空间化作帝国面积扩大、昨日信息与地图尽数失效（雷纳尔多的家等『本该在此的事物早已消失不见』）；焦烟废墟/空空如也的商店/塞满烧焦尸体的仓库/驻士兵的城寨；国家规模粮食短缺（购买无门、偷亦无物可偷）；兽人骑士巡逻；点缀在街道两旁的草木被燃烧殆尽，仅剩的一点自然之景也全都枯萎变色。到昨天为止还都完好无损的众多房子也已纷纷倒塌，化为废墟被雨水浇打。；根据罗德的话来考虑，现在的『这里』是千年前大战的之后──或者也有可能是大战正酣之时。；但是，本该在此的事物早已消失不见。这</data></node>
    <node id="『英雄』涡波传闻（联合国东北扩散·ch72）"><data key="name">『英雄』涡波传闻（联合国东北扩散·ch72）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据菲洛（海盗船了望手）听闻：最近流入耳中的传闻=现身联合国东北的『英雄』逸闻——缔造出让听众怀疑耳朵的、等同神话伟业的超越人类领域的英雄；其名曰『剑圣』『最强』；身负众多异名：『屠龙者（DragonSlayer）』『守护者杀手（GuardianKiller）』『迷宫记录保持者(DungeonHolder)』『蜃气楼统率者MirageGuildMaster』『剑圣后继者』『雪之骑士』『天然英雄』『圣女花婿』『历代最强』『舞斗大会冠军』等——因异名太多人们直接称呼其为『英雄』；再优秀的勇者在其伟业面前也黯然失色。另一侧面：目睹其力量者视其为『怪物』（菲洛意识断绝前持续唤『英雄涡波』为『怪物』/被救</data></node>
    <node id="迷宫35层"><data key="name">迷宫35层</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">全层积水的水下阶层：石制回廊灌满水、既不特别宽广也不狭窄、无三维错综道路→可如无重力空间般蹬地前进；魔力在水中流通性不好→次元魔术效力变差、『维度』索敌范围缩小至十分之一以下（仰赖视觉的场合增加）；怪物=跟鲟鱼一样扁平、身体两侧如刀刃锐利的异形鱼群（会呼唤同伴、直击可将身体切成两段）；振动魔法是鱼型怪物的弱点；怪物死后化作光芒消失；阶层中心附近有空气横穴（休息点）；本章涡波队找到通往36层的阶梯；只是一如既往的石制回廊灌满了水而已。既不特别宽广也不特别狭窄，也没有什么设计的很三维的错综复杂的道路。因此也就不用特别去游泳，像在无重力空间里一样依靠蹬地前进就好。；一进入35层就将『维度』缓缓地浸透</data></node>
    <node id="枪械未流通于这个世界"><data key="name">枪械未流通于这个世界</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波旁白：『我知道枪械并没有流通于这个世界。但是罗德手中的东西确实是铳剑的形状』——罗德右臂翠色魔力固化出的超身长武器为铳/铳剑形，来源未明（涡波首见）；我知道枪械并没有流通于这个世界。但是罗德手中的东西确实是铳剑的形状。；那是一把长度超过罗德身高的『铳』；不对，从前端的锐器看来，应该说是铳剑更为准确。</data></node>
    <node id="拟似共鸣魔法（冰火魔树）与无名爆裂魔法"><data key="name">拟似共鸣魔法（冰火魔树）与无名爆裂魔法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">昨日商讨研究的魔法组合（'不管帕林库洛做什么都能让我们战胜他'的预案；准确为玛利亚一人想出、涡波为实现其杀意代构术式）；发动=玛利亚自火焰之壁抽火转换新魔法＋涡波『次元之冬』冷气铺展→魔力熔合（非红非青亦非紫）于火之『决斗场』盛器上生出冰火双重魔树（以涡波身体为根基/淡青冻结树干/水晶色枝芽/火炎熏染绽放真红之花/透明甚过清水）；机能=终结技干涉（『DarkSphere』黑球尽数吞没于『次元之冬』领域+火炎之花吞噬=强行『魔法相杀』；真红之花如蛇缠身剥夺防御逃亡）；最终形态=想像'水蒸气爆炸'：『次元之冬』×『Flame・决战炎域』魔力收束压缩成宝石结晶瞬间炸裂（白色暴风/陨石坠地轰鸣/余波熔</data></node>
    <node id="迷宫外观"><data key="name">迷宫外观</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">巨大而奇怪的遗迹：中央直参天际大树、枝桠点缀形色宝石（远看似七彩花朵）；『搞不好那不自然的装饰里面也是迷宫的一部分』；予主角自我意识俯视感与莫名亲近感/『很早之前就知道这座迷宫』的奇妙预感；在其中央耸立着一颗直参天际的大树</data></node>
    <node id="世界奉还阵的真正目的（兄妹分离封印）"><data key="name">世界奉还阵的真正目的（兄妹分离封印）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据帕林库洛宣言：准备『世界奉还阵』的真正目的=将涡波与阳滝分离→破壊身体的平衡→将两者的力量同时封印（『哥哥的身体』中载着『妹妹的灵魂』，『妹妹的身体』里装着『哥哥的灵魂』──两个人谁都无法发挥真正的力量）；涡波推断（'恐怕就是这个'）与之相合；并自省若无海莉帮助而内心崩溃，见到沉睡的阳滝可能立即丧失战意、顺从帕林库洛展示的『道路』；「哈哈！不过，那边跟『水之理』的亲和看来是被我成功破除了啊！封住我身体的冰被解开了哦！？『哥哥的身体』中载着『妹妹的灵魂』，『妹妹的身体』里装着『哥哥的灵魂』──这样一来两个人谁都无法发挥真正的力量了吧！！」；帕林库洛准备出『世界奉还阵』的真正目的恐怕就是这个。；</data></node>
    <node id="狂王"><data key="name">狂王</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的称呼之一：据罗德语，『被敌人（诺斯菲）唤作狂王』；被敌人（诺斯菲）唤作『狂王』的孤的真本事</data></node>
    <node id="死神的千年前初例记载"><data key="name">死神的千年前初例记载</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诅咒书所载（涡波评可信性低——千年前事难以正确流传/出自地方神话）：千年前人类与怪物大战中，一体'诅咒'突然出现于进军骑士团中心残杀大量士兵（剑与魔法无效/如雾消散再现背后）；最终某无名骑士与死神同归于尽——唯一消灭法=逆着它从死角处发来的攻击施以回击（以自己的首级做交换）；此后名为'死神'的诅咒再未出现；据记载，对『死神』这一『诅咒』的最初确认是在千年前的某个战场上。；无名的骑士以自己的首级做交换，斩落了『死神』的首级。</data></node>
    <node id="五十层与五十一层夹缝的『拒绝折返』构造"><data key="name">五十层与五十一层夹缝的『拒绝折返』构造</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫的一半、五十层与五十一层的夹缝间成为拒绝折返的构造：五十一层为完全空洞、与六十六层同样广阔的空间与高度但中央没有螺旋楼梯；恐怕本来是难以降落的楼层，而迷宫逆向行走（自下向上）的状况下又产生其他困难问题——本章以『维度・多重展开』测距+长距离『Default』垂直突破解决；然后，和六十六层同样广阔的空间与高度但是──中央却没有螺旋的楼梯。；迷宫的一半，五十层与五十一层的夹缝间，成为了拒绝折返的构造。；恐怕，本来是难以降落的楼层，但是迷宫的逆向行走的状况来看，又产生了其他的困难问题。与六十六层不同，站在寸草不生的地面上向着只做这个迷宫的家伙发牢骚边向天空凝视着。</data></node>
    <node id="南方"><data key="name">南方</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前战争的自称宿敌方（『来自宿敌『南方』的侵略』——再现战争时代的背景侵略者）；对贝丝而言南方侵略/千年前战争/罗德与诺斯菲的操弄都不重要，她眼中只有涡波；来自宿敌『南方』的侵略、千年前的战争、操纵自己生存的世界的罗德和诺斯菲──这些对贝丝来说都不重要，映在她眼中的只有我。</data></node>
    <node id="罗德的铳剑"><data key="name">罗德的铳剑</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德右手武器（原文未命名）：魔力构筑而成、可一瞬间解除实体直接穿透对方之剑；枪剑双机能（本章弃铳用剑——『她要发挥的是剑的机能』）；凝聚闪电与磁力；如置换弹壳般排出漆黑魔力再装填凝练；纤细枪身内展开真空束射管与凶恶『力场』；罗德并没有打算以铳的形式迎战，她要发挥的是剑的机能。；罗德的铳剑是用魔力构筑而出的。接着她在一瞬间解除铳剑的实体，直接穿透了我的剑发起攻击。；就像是置换弹壳一样，铳剑排出一股染得漆黑的魔力，接着重新凝练更多的魔力。</data></node>
    <node id="守护者艾德的战斗形态（ch83）"><data key="name">守护者艾德的战斗形态（ch83）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾德不会使用武器，通常只能任后卫；一对一别无他法时以袖中小树枝应战；施放辅助魔法『Growth·Extended』『SenseBless』『BranchWoodShell』强化自身，'将他那完全不擅长战斗的身体勉强拉到能够战斗的水准'；被强化的小树枝可跟宝剑交锋并迸发火光；战斗能力低，撤退判断迅速果断。；守护者艾德并不会使用武器。；「——『Growth·Extended』！『SenseBless』『BranchWoodShell』！！！」；这样才能将他那完全不擅长战斗的身体勉强拉到能够战斗的水准。</data></node>
    <node id="火焰感知通信"><data key="name">火焰感知通信</data><data key="type">技能魔法</data><data key="status">provisional</data><data key="desc">曾几何时我也见过一样的光景。跟主人一起去迷宫第十层的时候，我也见过火焰像这样开口说话。</data></node>
    <node id="涡波的怪物化进行（ch80）"><data key="name">涡波的怪物化进行（ch80）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">Status中『力量』和『速度』已开始超越人类领域、向『怪物』方向转化（旁观上万战争内心毫无波动——自问是怪物化还是千年前战争经验使然）；旁观战争产生『因为我在旁观所以这些人才会死』的被害妄想式罪恶感（自认确有以数万人为对手也能摆平的能力、劝诫自己『难道你是想当神不成』）；对士兵杀意自律丧失（自然涌现杀无赦之念）；自称正在变成超越守护者的『怪物』；以封印『并列思考』与『？？？』、机械式无心状态维持行动；我居然率先浮现除了就算杀掉这些碍事的士兵也没办法这样的想法。；不可思议的是，我的内心毫无波动。到底是因为我已经变成『怪物』的缘故呢，还是因为千年前战争的经验使然呢。还是说二者皆有呢。；不过这也是</data></node>
    <node id="属性与容量体系"><data key="name">属性与容量体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">水晶球搭手测血之性质与容量→可知能掌握的魔法种类与容量（一人可掌握的魔法有限）；玛利亚=中坚魔力+火与无双重属性；主角=次元属性（透明色·非常稀有且久远·容量水晶不可测）；稀有属性目录含『星』『太阳』『光』『暗』等，次元属性魔法仅『Connection』『Foam』两种；只要将手搭在这个水晶上的话，就能够测出当事人的血的性质与容量。</data></node>
    <node id="魔弹『重崩色之非风剑（NachtCult・Gram）』"><data key="name">魔弹『重崩色之非风剑（NachtCult・Gram）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德最强魔弹（据罗德声称为『过去的你所传授』『传授来射人的魔法』——涡波推断即始祖涡波）：纤细枪身内如镰鼬般生成无数真空束射管、魔力在空间内制造扭曲、反复压缩膨胀空气直至引发小范围近似重力崩壊现象——形成与正常魔法世界画风不一致的凶恶『力场』；射出漆黑子弹划出『暗线』（黑线）；涡波以『维度・曲战演算』捩转空间令其在命中前偏折，仍轰穿『佩艾希亚』结界开黑洞般大洞；仅余波即震断涡波左臂；重复进行对空气的压缩和膨胀，直至引发范围虽小却近似于重力崩壊的现象。；──魔弹（FlyShoots）『重崩色之非风剑（NachtCult・Gram）』噢噢噢！！；那并非一道『光线』而是应该用『暗线』来形容的黑线。</data></node>
    <node id="迷宫34-35层水域地形（ch126）"><data key="name">迷宫34-35层水域地形（ch126）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">34层BOSS房水位曾漫及天花板（施术者=水母BOSS消失后回落复原）；通往35层的阶梯浸于水中无法通行（涡波称自己一人能过）；队伍决意折返、练习游泳后再挑战；因为施术者的消失，本来漫及天花板的水位开始下降了。我立即浮上水面，并帮助怀里的拉丝缇娅拉调整呼吸。；与水母BOSS的战斗结束后，我们朝迷宫的深处继续前进。基本上采取回避战斗的模式前进，所以探索进展很快。；将手伸向阶梯，戳出扑哧扑哧的声音。</data></node>
    <node id="记忆修复机制(魔之毒增量·ch92)"><data key="name">记忆修复机制(魔之毒增量·ch92)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">因使徒勒伽西而没能继承的『始祖涡波』记忆碎片、随蕴藏在身的『魔之毒』不断增加而逐渐修复（归还的记忆如自水底上翻的泡沫接连涌现）；梦内可依本能/因缘选定特定对象的记忆回看（本次=罗德→诺斯菲）；梦醒后再入眠不再做梦——回忆过去的机会一去不返；因为使徒勒伽西而没能继承的『始祖涡波』的记忆的碎片纷纷复苏。毋庸置疑，随着蕴藏在身的『魔之毒』不断增加，我的记忆也会逐渐修复。；射入水中的光越来越多。可以预料到，在光填满这水中世界的时候，我的梦便会宣告结束。；可惜的是，这一次我并没有再做梦。</data></node>
    <node id="『血』与『魂』人格观（ch131重申）"><data key="name">『血』与『魂』人格观（ch131重申）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉/玛利亚：'人之所以为人，最关键的就是『血』与『魂』'；'只有记忆的话说不上『再诞』'；'我们的圣人缇娅拉才会那么注重『血』与『魂』的转移'；判定海莉『血』『魂』与海因'太过异质'故非同一人。涡波原世界价值观（记忆=人生存着的证明/幻想小说中替换记忆人格求不老不死）在此世不通——'都有魔法存在了，魂自然也是存在的喽，那么在这边证明自我的东西就是『魂』'；「不不，只有记忆的话说不上『再诞』的吧⋯⋯？」；「正常来说就是那么一回事哦，涡波先生。人之所以为人，最关键的就是『血』与『魂』」；「没错没错。所以，我们的圣人缇娅拉才会那么注重『血』与『魂』的转移哦。⋯⋯不过，海莉那孩子的『血』和『</data></node>
    <node id="涡波=『魔石人类』可能性（据海莉·涡波存疑）"><data key="name">涡波=『魔石人类』可能性（据海莉·涡波存疑）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉示唆：涡波'有可能不是相川涡波'（魔石人类；千年前的『相川涡波』想要取代他）；涡波自认在预想范围内（并列思考预演对应）、打击'远远不及圣诞祭最后的绝望'、'既不是马上就要死掉，也不会变得无法帮助阳滝和缇亚'；同时未盖棺论定——疑帕林库洛对海莉认识动手脚+并列思考发现'些微异常'；被示以我是『魔石人类』的可能性，确实让我受到了打击。看来我似乎有可能不是相川涡波。；就算千年前的『相川涡波』想要取代我，那也无妨。；只是这种程度的事实，远远不及圣诞祭最后的绝望。</data></node>
    <node id="千年前四旅人的使命与身份隐蔽"><data key="name">千年前四旅人的使命与身份隐蔽</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">四旅人（始祖涡波〔假面〕/使徒西斯〔金发〕/阳滝〔黑发〕/缇娅拉〔最年少〕）自认『一小撮随波逐流的旅人』；唯一要务=『魔力』的收集；身份绝对不能暴露——若始祖涡波接近那位王，『北方就不会有我们的容身之处』（缇娅拉告诫）；我们就是一小撮随波逐流的旅人，而且我们的身份是绝对不能暴露的啊。；「现在我们要做的只有一件事。那就是『魔力』的收集。你可千万不要搞错了啊，盟友」</data></node>
    <node id="『支配之王』（称号）"><data key="name">『支配之王』（称号）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">ch205 源头揭示：此名出自奈落之底那本书的题名（扉页目录『支配之王』四字）；罗德激烈否认其为己名——'我的名字才不叫什么『支配之王（Lord）』！'（真名于'我的名字叫⋯⋯──'处截断未揭）；并库内既有『支配之王』（ch202）／支配之王（Lord）（ch200），跨写法由 R4 归一；写在上面的是『支配之王』四个字。；支、支配之王？『支配之王（Lord）』？；我的我的、我的名字才不叫什么『支配之王（Lord）』！</data></node>
    <node id="铳剑"><data key="name">铳剑</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的武器：刃枪两用（可持刃交锋亦可枪口射击）；枪击子弹会爆炸但穿透力不强、被城墙挡下；可解除形态空出右臂；我一边咋舌一边挥剑架开罗德的铳剑。；罗德拉开距离将铳剑的枪口冲向我。；不过子弹却被挡在城墙外爆炸了。</data></node>
    <node id="人类20级＝极限领域（级别体系知识）"><data key="name">人类20级＝极限领域（级别体系知识）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波：20级=人类的顶尖级别，即人类的『极限领域』；接下来迷宫探索顺利推进的话'我迟早要超越这个『领域』吧'；过去伟人（圣人缇娅拉/使徒西斯与传说英雄全员）在其眼中皆『怪物』，积攒经验值则己队亦有变得同级的可能；自认正迈向他们的『领域』——超越极限后的自身姿态悬置为问；继续这样积攒『经验值』的话，我们也有变得跟他们同级的可能。；20级──人类的顶尖级别。；也就是说这是人类的『极限领域』</data></node>
    <node id="佩艾希亚的寿命(崩坏倒计时)"><data key="name">佩艾希亚的寿命(崩坏倒计时)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲鉴定（自陈若论魔法鉴定能力无人出其右/从不说谎，雷纳尔多亦证其不会说谎）：『那个空间』寿命所剩无多——约一个月（视天空扭曲程度或撑不到一个月）；其一开始设定的寿命即一千年（过去的涡波本计划千年后抵达『这里』，再久即浪费空间与魔力）；构成魔力为次元属性而非光属性，故延长寿命唯有涡波的空间系次元魔法（但涡波自认用不了/对『持有物品』的解析无进展）；雷纳尔多自涡波出现以来早见预兆；居民（除罗德外）早已做好崩坏觉悟；天空扭曲恶化（如魔石之光的微光闪烁）；非也，很快就要结束了。在我看来，那个空间的寿命也就只剩一个月了。；我已经听说了那个空间的由来了。在此之上进行推测的话，恐怕那里一开始设定的寿命</data></node>
    <node id="格连状态栏（ch43实测）"><data key="name">格连状态栏（ch43实测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">等级28/职业斥候：HP331/342 MP92/92；力量7.22 体力8.55 技巧11.78 敏捷13.79 贤能10.01 魔力5.26 素质2.19；先天技能：幸运1.02+厄运2.75（双稀有先天）；后天地魔法1.22 武器战斗1.17 探索1.11 匿踪1.56 药师1.10 盗窃1.66——技能丰富型斥候build（非正面硬碰）；涡波观感：'搞不好其实斯诺比他要……'（魔力素质对优于格连）；姓名：格连·沃克 HP331/342 MP92/92职业：斥候；等级：28</data></node>
    <node id="迷宫35层浸水层与游泳必要性"><data key="name">迷宫35层浸水层与游泳必要性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">35层完全浸在水里（不会游泳无法抵达36层）；迷宫路途100层之多；涡波目标=抵达40层前全员学会游泳；另据海莉自称数日跨越30层；「大家在进行游泳的练习哦。毕竟35层完全浸在水里嘛」；「确实不会游泳的话是无法抵达36层的呢。再考虑100层之多的路途，确实要趁现在精通游泳才行啊。不错的判断」；「⋯⋯是啊。可能的话，希望能在抵达40层之前让所有人都学会游泳。</data></node>
    <node id="乘船离开联合国·同船成员(ch113)"><data key="name">乘船离开联合国·同船成员(ch113)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波一行现乘船离开联合国航行中；涡波睡前以《Dimension》确认船的行进路线与重要部分；据涡波对『夫君』称呼连锁反应的设想，同船者含玛利亚（火上浇油型）/斯诺/拉丝缇娅拉（一脸愉悦煽风点火『一触即发！』）/缇亚（不会有什么好脸色）/塞拉小姐（无法预测的大脑回路）/莉帕（客套两句就去避嫌的『好友』『唯一的正常人』）——若莉帕离开整艘船将成为没有保险的火药库；跟沃克家诀别之后，从长年的枷锁中脱身的斯诺现在是随心所欲了。在乘船离开联合国的现在，她的松懈算是到了顶点。；在入睡之前打算最后确认一下船的行进路线。；一旦身为唯一的正常人莉帕离开的话，整艘船就会成为没有保险的火药库。</data></node>
    <node id="已死之人留下的『楔子』"><data key="name">已死之人留下的『楔子』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自述：'纵使数量过万的『楔子』灰飞烟灭，同伴们的『楔子』也纷纷被拔除，我的心中依旧还留着一根旧时的楔子'（海因所留）；帕林库洛'打算将所有足以紧密地固定住我这一存在的楔子全部拔除掉'，但'千算万算终究还是算漏了自己无法触及已死之人留下的『楔子』'——正是这枚楔子令其放弃如梦似幻的幸福、拒绝救济之手；海莉与莱纳=两根新楔子；纵使数量过万的『楔子』灰飞烟灭，同伴们的『楔子』也纷纷被拔除，我的心中依旧还留着一根旧时的楔子。；不过他千算万算终究还是算漏了自己无法触及已死之人留下的『楔子』这一点。；其实我心里是想要握住那只手结束这一切的。但是，钉进体内的『楔子』却让我无法选择那条路。</data></node>
    <node id="魔法『DistanceMute』"><data key="name">魔法『DistanceMute』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">次元属性魔力沁染全身、身体偏差一个次元——得类似『透化』之效，可如幽灵穿墙般在结界中移动（'魔法的效果简单粗暴地被发挥了出来'）；涡波自认已习惯使用、'也觉得在以后的战斗中都会仰赖它的力量'；「──『DistanceMute』！覆盖我的全身！！」；亏了魔法『DistanceMute』，我的身体偏差了一个次元；魔法的效果简单粗暴地被发挥了出来。就像幽灵穿过墙壁一般，我的身体得以在结界中移动。</data></node>
    <node id="状态栏更新(ch91)"><data key="name">状态栏更新(ch91)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波：lv25/HP353/MP1165(-200)；力量14.01体力15.54技巧20.77敏捷25.87贤能20.79魔力45.23素质6.21；先天剑术3.79；后天体术1.56/次元魔法5.33(+0.40)/魔法战斗0.79/感应3.56/指挥0.89/后卫技术1.01/编织1.15/诈术1.34/锻冶1.00/神铁锻冶0.56——新增『指挥』『后卫技术』；魔力与MP总量成长最显著，战斗直接相关技能不见起色。莱纳：lv27/HP409/MP102/281；先天风魔法2.57；后天神圣魔法1.27/剑术2.38/血术1.12/魔力操作0.89/集中收束0.56/最适行动1.22/不屈</data></node>
    <node id="阿雷亚斯的断魔之剑最终形态（ch209）"><data key="name">阿雷亚斯的断魔之剑最终形态（ch209）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">魔法『致亲爱的一闪』＝诺文独有技能、阿雷亚斯的断魔之剑最终形态；需将其剑圣人生烙印于『咏唱』、借DistanceMute与魔石『诺文』相连接方能挥出；出鞘后对手无论作何反应都已太迟（唯直觉可将伤害抑制到最小）；效果＝扭曲次元、盗取世界之理、无视所有障碍越过光之壁；她知道阿雷亚斯的断魔之剑──其最终的形态。；这一剑是独属于诺文的技能。以前多亏了与莉帕的『连接』我才得以理解诺文的人生，但现在『连接』已断。想要成功的话还有很多欠缺。；这并非是多亏了她的身体能力也不是反射神经的功劳。『致亲爱的一闪』一旦出鞘对手无论作何反应都已太迟。也就是说，诺斯菲是靠直觉避开的。</data></node>
    <node id="西娅·勒伽西队伍的编成"><data key="name">西娅·勒伽西队伍的编成</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">在场成员=西娅・勒伽西、海莉・维斯普洛佩、莱纳・赫勒比勒夏因、露洁与诺瓦露，及最后现身的高大治疗者男子（据涡波『表示』鉴定=四十守护者『木之理的盗窃者』）；'看来我们队伍里的所有人都聚齐了呢'；队伍借居勒伽西家别墅、正赶赴帕林库洛处。；「唔？看来我们队伍里的所有人都聚齐了呢」；西娅・勒伽西。；海莉・维斯普洛佩。</data></node>
    <node id="饮酒年龄规则（原来的世界与这边世界的差异）"><data key="name">饮酒年龄规则（原来的世界与这边世界的差异）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据基督：'从年龄上来看，在我的世界里我还不能碰这东西，但在这边的世界却没有那个限制'；原来的世界本有'在特别的日子举办的孩子也可以碰酒的酒宴'；只要严守饮用限度，饮酒并非那么引人忌讳；从年龄上来看，在我的世界里我还不能碰这东西，但在这边的世界却没有那个限制。</data></node>
    <node id="木制的义手"><data key="name">木制的义手</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波为35层探索专门制造的探索装备：让缇亚跟斯诺在水中紧紧联结起来的东西（缇亚牵住、斯诺握持）；设计成跟斯诺的手尺寸完全匹配的钩状故不会轻易脱离；斯诺自嘲该定位没法划水；功能上=守护缇亚的联结装置（一旦松手关系到缇亚生死）；顺带一提斯诺握着的是木制的义手。是我为了这次探索专门制造的能够让缇亚跟斯诺紧紧联结起来的东西。；因为设计成跟斯诺的手尺寸完全匹配的钩状，所以不会轻易脱离。；「就算我想，但是这个定位，也没法划水的⋯⋯」</data></node>
    <node id="西斯的白色纯粹魔力"><data key="name">西斯的白色纯粹魔力</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">再配置后可视化涌出的白色魔力如雾：密度绝不输守护者、纯度更胜（'什么都没有混入的纯粹魔力''没有表现出任何犹豫和迷恋'）；魔力超100→技能效果增加（涡波：'接下来发生什么也不会觉得不可思议'）；代价=身体能力降至'不知道能否正常生活'的数值；魔法战取胜无望——涡波遂改近身肉搏；身体能力下降到了不知道能否正常生活的数值。可是舍弃这些其他的东西本来就十分突出的魔力又得到了进一步的升华。；魔力超过了100.00；随着淡淡的发光的同时可视化的白色魔力就像雾一般从身体涌现出来。这股魔力的密度绝不输给守护者。</data></node>
    <node id="始祖涡波躯壳的存在构造"><data key="name">始祖涡波躯壳的存在构造</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛道明+涡波确认：被召唤者为被遗弃在『最深部』的『始祖涡波』躯壳——体内没有灵魂（作为『灵魂』的『次元之理的盗窃者（涡波）』的魔石在当前涡波这边→当前涡波才能借阳滝身体以『我』的姿态行动）；是没有核的躯壳，岂止理性、恐怕连意识都没有，只顺从镌刻于身体的本能行动；但'为了得到比自己失去的『魂』更加重要的东西——只要有这份欲求——纵使只剩下一具没有灵魂的空壳，也还能行动'；状态无法正常『表示』（名字模糊不清乱码）——因连存在本身也很不安定，如海市蜃楼般随时可能消失；级别46+先天技能次元魔术9.23+后天技能无数（含家务/料理/织纫/洗脑/调教/暗杀等生活与密计类——数量多到战斗中数不过来）</data></node>
    <node id="白樱树"><data key="name">白樱树</data><data key="type">地点·纪念物</data><data key="status">provisional</data><data key="desc">缇缇家旁开着白花的巨树（花瓣飘点自家屋顶）；艾德最爱凝视此树（『总觉得很喜欢、对这棵树』）；缇缇千年留恋的锚点——『是回到那棵白樱树旁的人字形小屋里去啊！』；在家附近有一棵开着白花的巨树。我此时就在它附近劈些柴火。；总觉得很喜欢、对这棵树；是回到那棵白樱树旁的人字形小屋里去啊！</data></node>
    <node id="魔石线"><data key="name">魔石线</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（ch80 城堡布线设定之再演，本章为170话原版切片独立证据）中庭庭院内铺有『魔石线』，为帕林库洛预先准备之物——涡波推测其于待在劳拉维亚期间灌注心血完成此『魔法阵』（'稍微一看就知道是很难解析的术式。不管是破壊还是解除，都需要相当的时间'，『维度』观察规模足以覆盖一国乃至吞没大陆）；其影响圈即世界奉还阵波及范围（海莉受劝救出莱纳后'赶快逃到这个『魔石线』影响不到的地方'）；尽管期待着能让莱纳帮忙一起去追帕林库洛，但是现在没那么多时间了。我瞥了庭院内的『魔石线』一眼。；帕林库洛说这是他准备好的东西。；恐怕是在我待在劳拉维亚期间，他灌注了一番心血才完成了这个『魔法阵』。这个『魔法阵』有不可小觑</data></node>
    <node id="雷鲁的真相说明（治疗论与幸福计划）"><data key="name">雷鲁的真相说明（治疗论与幸福计划）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据雷鲁（Dimension测谎通过）：手环=守护涡波异世界生活（失去=所有幸福消逝毋庸置疑）；双子之事'为了你好不能告诉你'（知道会成为重负/走苦难道路/失去幸福——'那条路不是你这样善良的孩子该走的'）；记忆操作定性=被掩藏的都是『不幸』的记忆+暧昧处理='为了治疗'；『那一天的大火灾』=悲惨事件（玛利亚极其痛苦的遭遇——推测失明时点）；完美计划=让涡波成为劳拉维亚英雄+玛利亚得到幸福；交易本质=三十层讨伐节点→仍想改变现状→和盘托出真相（否则放弃全盘计划切入下一计划）；——也不置可否。但是有一点希望你不要误会。被掩藏的都是『不幸』的记忆。是为了让你们能幸福地生活而对不必要的记忆作了暧昧的处</data></node>
    <node id="赛鲁多拉（ch227·据缇缇口述全貌）"><data key="name">赛鲁多拉（ch227·据缇缇口述全貌）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇缇口述+涡波整理：千年前仅凭自己的力量成为那个时代的总司令、仅以自身才能获得与缇缇比肩的力量（涡波评'实在是太恐怖了'）；『龙』之『魔人』且上天赋予战斗才华；成为『无之理的盗窃者』已是最后的事情（故缇缇不了解其那份力量）；性格粗枝大叶、理解不了弱者心情、总把严苛话挂嘴边，但本性不坏、明白自身缺点故尽可能对弱者施援；缇缇从未见过他发自心底的笑容，留恋或与其'毛病'相关——严格来说留恋或=治好那个毛病；其毛病=普通生活闲得发慌、无聊到坐立不安，自述'总会感到非常空闲和无聊'，结果产生想逃到『异世界』的想法、否定自己北方国民乃至这个世界居民的身份；因缇缇成为王后丧失余裕，缇缇始终没能真正理解其毛</data></node>
    <node id="迷宫外魔石化法则（ch223）"><data key="name">迷宫外魔石化法则（ch223）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫外（海上/大自然）死掉的怪物不会变成魔石；魔石化术式为迷宫所独有、外面无掉落现象；但怪物尸体可回收解剖利用——各有长短；看着静止于海上的怪物和船只──我不禁想到这里和迷宫不一样，死掉的怪物并不会变成魔石。；魔石化的术式既然是为迷宫所独有，自然在外面就不会有掉落的现象。但怪物的尸体却可以回收起来解剖利用，所以算是各有长短吧。</data></node>
    <node id="赌场规则与魔石探测"><data key="name">赌场规则与魔石探测</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">高级赌场为防出千禁用魔法、各处设能感知魔法的魔石（稍发光亮即被赶出）；轮盘规则与涡波原世界几乎无异（仅名目数字略异，有庄家负责、珠子转动中可加注）；牌卡混入魔石碎片防出千——但也意味着赌场方可编入魔法术式、与赌场勾连者可随意出千；店方只干预赌局是否正常进行、桌外纠纷不介入（对菲伊的暴力冲突选择默认，涡波推断与贿赂及国家压力有关）；所持金额不足时以替代物（含人身）抵债系可商定的常有条款；在高级赌场中，为了防止出千而被禁止使用魔法。各处都设置着能够感知魔法的魔石。只要那些魔石稍微的发出一点光亮，我就会被赶出去吧。；轮盘赌的规则和我的世界没有什么变化，只是名字和数字稍微有些不一样的程度而已。因为有庄</data></node>
    <node id="『这里』的再现法则"><data key="name">『这里』的再现法则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">为将『这里』作为地上再现而设定的种种法则随崩壊沦于疯狂：重力脱轨（大地崩碎后瓦砾不坠而漂浮）、时间崩坏（世界加速）；据涡波推断，空气与其余一切无形法则也将消失；为了将『这里』作为地上再现而设定的种种法则也沦于疯狂。；其中最明显、最脱轨的就是『重力』；所有的瓦砾都轻飘飘地浮在空中，简直就像宇宙空间一样。</data></node>
    <node id="魔力变换（LevelUp）真相"><data key="name">魔力变换（LevelUp）真相</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳所用咏唱（『汝者，刮目自省而可也』『此间光辉，乃是生命飘渺虚幻之一瞬』等）为教会神官每天早上诵读、大家都耳熟能详的通用咏唱（涡波初闻自拉丝缇娅拉、其后数次在迷宫中听过）；LevelUp 真身为将『魔力』转化为『变换结果（状态）』的魔法，正式名字为咒术『魔力变换（LevelUP）』；莱纳此次向世界直接索取并自偿『代价』：将被阵溶解的海莉的『魔力』连同灵魂全部吸入、转化为自己的血肉——灵魂格段上升到更高次元的货真价实 LevelUp（经历生离死别的真正成长）；涡波评『不是『诅咒』而是『神圣』』（引缇娅拉话语）并目睹证明其神圣性的灵魂之光；这不是莱纳即兴的创作，更不稀奇少见。而是教会的神官们每天</data></node>
    <node id="本土舰队军备与魔石远程武器（ch223）"><data key="name">本土舰队军备与魔石远程武器（ch223）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">遇袭船队舰只总数十艘以上且基本为军舰，军人皆饱经训练的百战之士、临危不乱；各舰体型可与『LivingLegend号』媲美，舷侧并非火炮而是利用魔石打造的远程武器——因文明发展方向不同，魔石的动力与武器均与联合国侧有差别；舰只的总数在十艘以上，而且基本都是军舰。船上的军人正运用魔法迎击袭来的小型怪物群。；舷侧装有火炮──并非如此，而是利用魔石打造的远程武器。看来因为文明的发展方向有所不同，不仅是魔石的动力，就连武器也有所差别。</data></node>
    <node id="魔法『DistanceMute・繋心（Access）』"><data key="name">魔法『DistanceMute・繋心（Access）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波于本章战斗中命名的'连接心与心的魔法'：把手腕伸入对方胸口、经『连接』将想法与感情连续诉诸对方（『交流』）；可反向利用共鸣魔法成立的连接条件同时攻略四人；与光魔法不同无法对精神上下其手/无镇静作用，但发自内心的倾诉可传达（对纯真者立竿见影）；对常人极危险（据缇缇：'普通人会被一击必杀'）。原文另有 DistanceMutte 拼写变体（章行317）；「──『DistanceMute・繋心（Access）』！」；这个技术──是连接心与心的魔法。；把手腕伸进了她的胸口</data></node>
    <node id="赫勒比勒夏因的双剑术"><data key="name">赫勒比勒夏因的双剑术</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">赫勒比勒夏因家传双剑术：钳型挥出、自左及右/自右及左的连续攻杀、交差接剑；诺斯菲亦已习得且水准在莱纳之上（莱纳对照确认『毫无疑问』）；诺斯菲称对其剑法『早已惯于应付』；与此同时为了直取敌人的首级，我将双剑摆作钳型挥出。；「呵呵，这剑法真是让人怀念呢。不过，正因为它令人感怀，所以我早已惯于应付了」；「这、这是⋯⋯竟然是赫勒比勒夏因的双剑⋯⋯！？」</data></node>
    <node id="组队系统细则"><data key="name">组队系统细则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">①一人战斗他人摸鱼亦均分经验；②最大有效距离2-3人无差（约百米，正道结界变则）；③多人队伍经验值微衰减；④分配方式均分不变——加『Connection』维持成本=最大MP上限-200（家↔二十层常设门）；光是维持一个就令我可调度的MP上限下降了一百点左右。</data></node>
    <node id="『大灾害』南方记录（ch222·别名『大灾厄』）"><data key="name">『大灾害』南方记录（ch222·别名『大灾厄』）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一年前发生的『大灾厄』（=库内『大灾害』（一年前）之异写，判例4 并入+别名登记）：不明原因的大魔法→南北境界线周围生息嚼类全部死绝＋充满谜团的『大空洞』突现大陆＋周围黑云不散＋未知巨型怪物自空洞诞生袭各国；南方当时尚有余力化解袭击并于空洞周边速建第二迷宫都市达利尔；仅『大灾厄』本身即招致过万军民伤亡；后续世界各地巨型怪物荼毒＋原有怪物活动越发活跃（北方受损在南方之上）；而这一切的缘始便是一年前发生的『大灾厄』；因为不明原因的大魔法导致位于南北境界线周围的生息嚼类全部死绝，一个充满谜团的『大空洞』极其突兀地出现在了大陆上。；但这也无可奈何，仅仅是『大灾厄』本身就招致了过万的军民伤亡，紧随其后的</data></node>
    <node id="世界奉还阵的怪物召唤（兽之军势）"><data key="name">世界奉还阵的怪物召唤（兽之军势）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">材料=阵转换士兵肉体所得魔力+从大地深处溢出的异色魔力，络合凝缩后物质化出『鸟的脏器，骨胳，血肉，羽毛』；个体名录：WindLever（Rank35·全长约5米怪鸟）；批量五体——ツリーダイダス（木躯双头犬）/リザードフライ（空中大型蜥蜴）/ピッドジャイアント（雕首巨人）/ムーンレスフォウ（独眼两对翅蝙蝠）/アンコンケラブル（内部空荡却活动自如的铠甲），Rank30上下；『DarkCloth』黑铠强化（暗属性强化魔法·妨害冰刃·疑对精神施加影响）；怪物『状态』不显示（名字与Rank可『注视』）；迷宫外怪物死亡不立刻化光消失（尸体留存→被帕林库洛吸收修复身体）；战术=数量倍增（『下次是这次的一倍</data></node>
    <node id="技能『？？？（IllWill）』对策规约"><data key="name">技能『？？？（IllWill）』对策规约</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">消除=不可能（'消除技能这种事前所未闻'）；封印=不可能（据拉丝缇娅拉：帕林库洛用了魔法+『咒术』并借『暗之理的盗窃者』缇达之力）；现行对策='只能尽力不让它发动'+混乱超过8.00禁止涡波战斗（10.00即发狂；本话涡波混乱6.98）；改名『？？？（IllWill）』由拉丝缇娅拉主导（涡波亦自定『注视（Analyze）』『持有物品（The·Pouch）』）；拉丝缇娅拉视其为'削减涡波情感上限/会消除对某人的思慕'的敌对技能——涡波对同伴隐瞒'被消除的是对谁的感情'；「封印应该也做不到吧。恐怕，帕林库洛那家伙不仅仅用了魔法，还使用了『咒术』吧。；「总而言之，混乱超过8.00的话涡波就不许战斗了</data></node>
    <node id="共鸣魔法（WEB版ch118知识锚定）"><data key="name">共鸣魔法（WEB版ch118知识锚定）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">组合魔法战术：在骑士团和军队当中被广泛使用；例——常见魔法『炎之矢』由10人组合释放可生成巨大火矢、效果强于10人各打各的；实现需要相性与一定训练；探索者认识中'出力不讨好'、没有相当组织性一般用不上；知识出处=涡波自述'在图书馆和酒馆里了解过'；涡波×莉帕的『致亲爱的一闪』亦为共鸣魔法；缇亚×玛利亚组合被涡波评为'跟我认识中的『共鸣魔法』完全是两个概念'——'升华到另一种境界的两个魔法互相络合，进一步升华为更高级的别种魔法'（跨版本注：与库内ch70设定'共鸣魔法与Flame·Aegis'为同一知识双版本）；我有关于那方面的知识。在图书馆和酒馆里了解过是种被称为『共鸣魔法』的技术。；在骑士团</data></node>
    <node id="千年前神铁锻冶技术与表示冠名规则（ch172）"><data key="name">千年前神铁锻冶技术与表示冠名规则（ch172）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷纳尔多的锻冶属'现在已经绝迹的千年前的技术'：挥锤引发魔力奔流、网状附着铁面强化并固定形态（'这绝不是一般的锻冶技术。不对，这可能已经是跟锻冶不同的另一种技术了吧'）；冷却工序并用火焰魔法/水魔法/地魔法；铁锤为刻有魔术式的魔法道具；技能『锻冶』3.12=远超专家极限的人类至宝级；经一定技术改造后的道具在『表示』中于名字前冠施工者人名（'雷纳尔多的铁锅'——'通过技术『神铁锻冶』，升华为了高位的存在'）；铁器与锤子每次碰撞，魔力便沁染在铁器上。而魔力就像在强化铁器一般延伸成网状附着于铁的表面，在冷却的同时将铁的形态固定。；在现在已经绝迹的千年前的技术面前，我被震撼得说不出话。；通过技术『神铁</data></node>
    <node id="级别上限与身体异变（塞拉26/莱纳无异常）"><data key="name">级别上限与身体异变（塞拉26/莱纳无异常）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据说级别的提升一旦过度、当事人的身体就会异变。塞拉自述级别极限=26、已濒『魔人返还』界限，'已经无法再变强了'，继续魔力变换（LevelUp）将像过去的始祖他们一样异化（据塞拉）；莱纳级别远在其上（'你的级别没有上限'）身体却无异常——公开解释=曾在一段时间里使用『诺文』（镶守护者魔石之剑）战斗，私下自认另有原因但缺乏根据。据拉丝缇娅拉：拥有阿尔缇魔石的玛利亚可无止境地增强实力。；我已经无法再变强了。；如果『魔力变换（LevelUp）』再继续下去的话，那么我似乎就会像过去的始祖他们一样发生异化。；因为你的级别没有上限啊]</data></node>
    <node id="玛利亚的赤瞳（火球义眼·炯眼类力量）"><data key="name">玛利亚的赤瞳（火球义眼·炯眼类力量）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">失去双目的眼睑之下两颗似红宝石的赤瞳炽烈灼燃=凝缩的火球；超出既知的'火焰代行视觉机能'——蕴含跟视觉机能不同的『某种力量』，与玛利亚先前因失明而丧失的技能『炯眼』同类；能将涡波内心一五一十看透、不允许任何伪装和逞强（本章用于看破其'想被帕林库洛・勒伽西所救'的欲求）；在她那已经失去了双目的眼睑之下。；这其中蕴含着跟视觉机能不同的『某种力量』；她的赤瞳正将我的内心一五一十地看透。</data></node>
    <node id="迷宫上层构造与六十六层攻略坐标"><data key="name">迷宫上层构造与六十六层攻略坐标</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">六十六层风龙为涡波返回地上的当前阻碍；'只要突破了六十六层，之后的敌人只会越来越弱'（据涡波）；迷宫'怎么也是十的好几倍数的阶层'且'迷宫的构造有多麻烦'不可大意；六十层另有'不知底细的守护者'——涡波推定'一定也驻守着千年前的某位猛者'，雷纳尔多称'最大的难关就是那里了吧'；只要突破了六十六层，之后的敌人只会越来越弱。；怎么也是十的好几倍数的阶层，马虎不得。；「谨记在心。在六十层还有不知底细的守护者。我想在那里，一定也驻守着千年前的某位猛者」</data></node>
    <node id="魔石人类与研究院"><data key="name">魔石人类与研究院</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">露洁/诺瓦露系自『某个研究院』救出的魔石人类（海莉以『跟我一样』为由收留）；二人因『材料』相似而相貌声线相同（非双胞胎）；战斗会减少体内魔石（二人以此为由谎称感冒避战）；莱纳：『反正都是不久于人世的人』——其至今已送别许多魔石人类；二人=先天星魔法+属性魔法+血术的特殊属性魔法使（后天素体）；涡波由此推断国家进行的魔石人类研究是不人道行径；西娅状态栏无『素体』却给人相似的异样感；「是从某个研究院里面把她们救出来的。海莉说是‘因为跟我一样’什么的，所以也没办法喽。」；「不是什么双胞胎。只是制造她们的『材料』相似罢了。」；「你不用记住她们的样子也无所谓。反正都是不久于人世的人。只有两个人还算是少的</data></node>
    <node id="创造魔法者=一部分人"><data key="name">创造魔法者=一部分人</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚/芙兰琉莱称魔法不可创造（只存在于故事）——但主角已自创五个应用魔法（决战演算/多重展开/Ice·Arrow/次元雪/Ice·Flamberge）；『好像只有故事里出现的英雄般的「一部分人」拥有创造魔法的能力』——主角自认即其人；正以既存魔法想像改造法开发新冰结魔法；好像只有故事里出现的英雄般的『一部分人』拥有创造魔法的能力。</data></node>
    <node id="魔法起源：魔力变换与变换结果的开发（千年前）"><data key="name">魔法起源：魔力变换与变换结果的开发（千年前）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前城堡大厅中，始祖涡波（假面男子）与圣人缇娅拉在魔法阵上精炼体内魔力、失败即反复分解构筑并将术式记录成书；开发『魔力变换（Levelup）』与『变换结果（Status）』——命名取自始祖原世界常见词汇；目标是推广到全体国民，使无人再称『魔力』为『毒』；始祖自述上次成果并非『魔法』而是『咒术』，此次要创造不需要那么多代价之物。此即『传承中的「魔法」的起源』、据称由始祖创造的魔法的基础。；在魔法阵上精炼体内的魔力，因为失败而不断地重复着分解与构筑，再将结果一个接一个地记录在书籍上。；从今往后就再也不会有人将『魔力』称为『毒』了；『魔力变换』是『升级（Levelup）』，『变换结果』叫『属性（S</data></node>
    <node id="光魔法与神圣魔法的区别（据莱纳）"><data key="name">光魔法与神圣魔法的区别（据莱纳）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据'对神圣魔法了解得很详细的莱文教骑士莱纳'：神圣魔法和光魔法是不同的东西；与暗魔法相对的光魔法大多作用于精神——暗魔法带来异常，光魔法引导精神恢复正常、包含回复魔法故常与神圣魔法相混淆；非偏向战斗的类型→60层守护者应非神圣魔法特化（基督与莱纳的推断：'下一位守护者应该就不是特化了神圣魔法的人了吧'）；「我觉得应该不是。因为神圣魔法和光魔法是不同的东西」；既然对神圣魔法了解得很详细的莱文教骑士莱纳这么说，那下一位守护者应该就不是特化了神圣魔法的人了吧。；与暗魔法相对的光魔法也大多都是作用于精神的魔法。但是跟带来异常的暗魔法不同，光魔法都是引导精神恢复正常的魔法。</data></node>
    <node id="手环的深层心理写入（梦中揭示）"><data key="name">手环的深层心理写入（梦中揭示）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛在涡波败北后施加的『诅咒』：手环被设定为比生命还重要的东西（写进深层心理）+最优先守护；优先度=与『妹妹相川阳滝』同等；指令='戴着它完成第二十之试练和第三十之试练'；话术='施加点错觉而已/不会触及核心'；效果=伸手即恶寒僵直+思考上锁镣铐；记忆机制=每晚梦中重放曾经记忆但醒来必忘（血拳为 nightly 遗迹）；「就把这个『手环』设定为比生命还重要的东西好了。要是不最优先守护这东西的话我可就困扰了啊。我就把它写进深层心理中去了哦？」；说什么「施加点错觉而已」啊，什么叫「不会触及核心」啊。</data></node>
    <node id="玛利亚《眼睛》丧失与'选择相信'"><data key="name">玛利亚《眼睛》丧失与'选择相信'</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据玛利亚自述：已失去《眼睛》，无法再辨别涡波是否说谎（'我只能相信你了'）；此前涡波曾在罪恶感驱使下言[成为我的东西也行][死掉也无所谓]，玛利亚据此拒绝既往契约提议——'不是因为无法相信而拒绝，是因为选择了相信才拒绝的'；代之以涡波'[不会再留下我一个人][不会弃我而去]'的承诺（涡波应允'绝对不会'，并言'不会再跟你说谎了'）；对我说[成为我的东西也行][死掉也无所谓]之类的话；[……我已经失去《眼睛》了。所以，我已经无法明白涡波先生是否在说谎了。我只能相信你了]；因为涡波先生已经跟我说过了。[不会再留下我一个人][不会弃我而去]了——。我相信你的话]</data></node>
    <node id="生者价值第三者赋予论（海莉主张）"><data key="name">生者价值第三者赋予论（海莉主张）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：'能够赋予生者价值的绝非自己。只有愿意相信你的人才能赋予那份价值⋯⋯只有借助第三者的帮助，才能够证明自己是自己'（自述'有人教会了我这个道理'）——以此解释莱纳一言即为证明；并推广至涡波：'我根本不觉得你是什么『始祖涡波』！更不是什么『涡波』或『基督』！少年就是少年！我也好莱纳也好，还有倒在那边的少女也一样，我们都是这样认为的'；「能够赋予生者价值的绝非自己。只有愿意相信你的人才能赋予那份价值。；「──少年也是一样的哦！我根本不觉得你是什么『始祖涡波』！更不是什么『涡波』或『基督』！少年就是少年！</data></node>
    <node id="『半死体（HalfMonster）』"><data key="name">『半死体（HalfMonster）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">理的盗窃者死亡之际之『诅咒』引发的变异形态（'毫无疑问是最强的力量'）：诺斯菲例——咆哮、难保人形、半身蛇化（半蛇人种Lamia/光之蛇）、力量解放超越身体界限致生命被削减仍坚持战斗、'不再是光之御旗，而是光本身'；罗德例——风之茧中如羽化般蜕变、魔法拟态翼消散天生翼重现、耳与手足生羽成新翼、大股力量自体内涌现；一边化作『半死体（HalfMonster）』诺斯菲一边咆哮着。；[这是、光之蛇——！？不对，是半蛇人种（Lamia）！？]；在风之茧中，孤像羽化一样逐渐蜕变为『半死体（HalfMonster）』。</data></node>
    <node id="悲恋的哲学"><data key="name">悲恋的哲学</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">阿尔缇的恋爱观：传达不到/实现不了则生而无义——一同赴死/痛下杀手也要抢过来/直到神志不正常的恋爱才是『悲恋』才是真正的恋爱；其留恋根源=生前无果之恋（心爱之人与不识之人幸福生活/死后持续后悔千年）；唆使玛利亚=『通过玛利亚连同我的悲恋一起实现』；直到没有别的选择，神志也不再正常。这才是，这才算得上，只有『悲恋』才称得上真正的恋爱啊！！</data></node>
    <node id="魔法医疗水平"><data key="name">魔法医疗水平</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">立足于魔法的医疗颇为先进（魔法器具辅助治疗）；但断肢再接极难（最好环境+最高魔法亦困难，断后处置迟+粗糙自愈则无从处理）；失血致魔力生成匮乏（专门摄食+器具，约一周）；义肢可备但影响平衡/剑用/魔力构筑；虽然我们这边会准备义肢，但对剑的使用和魔力的构筑毫无疑问会产生不良的影响。</data></node>
    <node id="『素体』（隐藏于涡波技能板·据海莉）"><data key="name">『素体』（隐藏于涡波技能板·据海莉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：'少年确实持有『素体』技能。所以我在说『魔石人类』的话题'——『素体』为魔石人类全员共有的证明技能（涡波原以自己无『素体』为反证，自认'不是在天涯海角的孤身一人…确实有着回去的地方'的希望被否定）；位于'看不见的技能'之下，与涡波自认的『异邦人』显示冲突；「────什，你在说什么？在那里不是写着吗⋯⋯，『素体』⋯⋯⋯在看不见的技能下面好好地有着『素体』技能⋯⋯」；「到底在说什么？少年确实持有『素体』技能。所以我在说『魔石人类』的话题」</data></node>
    <node id="迷宫第66层『里侧（另一侧）』（ch84）"><data key="name">迷宫第66层『里侧（另一侧）』（ch84）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德：『这里』是迷宫里面；以阶层数表示＝『第六十六层的里侧』，正确来说好像是『另一侧』；此地为『涡涡为人家（罗德）特别制造出的空间』——在什么都没有的领域中用次元魔法将过去存在的『北方』王国就那样做了出来（据罗德转述，『涡涡是这么说的来着』）；在此『想起』比较容易；涡波排除法确认非迷宫联合国也非大陆本土；现涡波推断有能力做到者只会是一千年前的『始祖涡波』；「『这·里』是·迷·宫·里·面·哦。」；就是『第六十六层的里侧』呢。；涡涡用次元魔法，将过去存在的『北方』王国，就那样做了出来。</data></node>
    <node id="职业制度"><data key="name">职业制度</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">状态栏含职业位（缇亚=剑士）；职业疑在升级时提供属性加成（缇亚力量体力可圈可点之假说）；获得职业的明确条件不明——书上无载、酒馆被反问、缇亚曰『只要拿着剑就是剑士喽』；我的职业栏上什么都没有，而缇亚则是剑士。</data></node>
    <node id="境界战争（现状）"><data key="name">境界战争（现状）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据玛利亚（一般常识）：人类同族之间的争斗（并无种族问题/人类vs魔物不成立）；以莱文教为主要宗教的联合国军vs其余同盟国军；现以联合国军所在的『南方』与同盟国军所在的『北方』区分，民间通称『境界战争』；并非因宗教而起（北方亦有信奉莱文教的国家）、无明确缘由、不知何时开始一直持续（各国自己的盘算和寻求的权益）；进行于世界最大大陆『本土』的南北界上、世界最大规模；瓦尔德本国处最前线。据拉丝缇娅拉（国家机密）：联合国高层从很早之前就一直想得到『北方』的一部分领地，为此已打了一千年的仗（现战争=千年前战争的延长）。越接近本土海盗船数量越多（近战场）；「不是的，并没有涉及种族的问题。这是人类同族之间的争</data></node>
    <node id="阳滝生存真相（魂抽出·假死状态）"><data key="name">阳滝生存真相（魂抽出·假死状态）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇娅拉断言（记忆内向始祖涡波说明）：『魂』的抽出成功——那个魔石就是阳滝，'阳滝姐还没有死。她还活着'；阳滝曾一度被师父刺穿心脏，无论是身体还是魂都接近假死状态（心脏被刺穿却能以假死状态了事）；她跟现在的帕林库洛和之前的诺文处于类似状态（心脏被刺穿化为『完死体（怪物）』）；缇娅拉成功在那种状态下仅将『魔石（魂）』抽取出来；魔石（魂）仍处于睡眠状态、唤醒不易；此即涡波推断'一直被帕林库洛隐藏起来的真相'——帕林库洛'涡波和阳滝都已经死了'的说法被颠覆（'缇娅拉的主张颠覆了至今为止的所有前提'）；──缇娅拉一直坚持着阳滝还活在人世的主张。；「嗯，就是这样。所以说阳滝姐还没有死。她还活着」；「话是</data></node>
    <node id="光之理的盗窃者"><data key="name">光之理的盗窃者</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲的称号：特性=倾向捕获/对话而非厮杀、不擅'粗俗血腥的厮杀'（莱纳判读）；持有『诅咒』；使用光之『咏唱』会使'好不容易才削减的良心'恢复；另有『半死体』化之忌（诺斯菲自述）；这肯定就是『光之理的盗窃者』的特性了。；「可是，要是使用了『光之理的盗窃者』的『诅咒』的话，那就无法证明我对涡波大人的思慕了。所以绝对不可以。但是使用光之『咏唱』也不行，那样我好不容易才削减的良心又会恢复的。变成『半死体』就更不用说了。但是话是这么说，我也不能在这里打出密藏的手牌。⋯⋯啊啊，这实在是──」</data></node>
    <node id="二十八·二十九层的阶层特性"><data key="name">二十八·二十九层的阶层特性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">二十八层=虹色回廊（七色未知矿石墙壁，硬度较水晶稍柔；离壁矿石失辉变黑=不可变现；虹之格雷姆墙壁奇袭）；二十九层=无信道的广阔沙地空间（非守护者阶层的例外构造）+沙下大洞直通三十层（漩涡蚁狮填补——消失即沙崩）；沙地过软近战困难；三十层=七彩矿物花+水晶柱钟乳洞空间（完成度高于28/29层——'二十八·二十九层是受到了这一层的影响'）；不再是清一色澄净的白之世界，变成了多姿多彩的虹色世界。；二十九层跟之前的所有阶层相比都颇具特色。</data></node>
    <node id="魔法习得机制"><data key="name">魔法习得机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">掌握魔法的正道=服用刻着魔术式的魔石→血对魔术式进行记忆（魔法使家系的孩子因祖先服用过而先天可用；无服用史者无法使用）；『创造魔法』只存在于童话（主角与阿尔缇原以为凭才能联想创造魔法是常识——时代错位）；刻有神圣魔法的魔法石可作装饰（结婚戒指消灾用）；是通过服用刻着魔术式的魔石，让梭巡于体内的血对魔术式进行记忆。</data></node>
    <node id="海盗船情势（战场临近）"><data key="name">海盗船情势（战场临近）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：因距离战场较近，海盗船数量增多；来袭船先假扮商船交涉，见船员皆为小孩即态度豹变袭击（据玛利亚）；因袭击失败也能『安稳地回去』，故会反复来犯；被驱离的首船疑似将一行位置泄露给同伴；船员仅三名女孩的船被视为'美味的猎物'；「也就是说，他们是海盗哦。因为距离战场较近，海盗船的数量似乎就变多了。；再加上就算袭击失败了也能『安稳地回去』，那当然会反复来袭击了嘛。再说船员还只有三个女孩子。不管谁听了都会觉得是美味的猎物不是～」；「那艘船一开始是假扮成商船来跟我们交涉的⋯⋯，但是船员的代表一看到我们都是小孩子，态度就豹变，袭击过来了啊」</data></node>
    <node id="通信机开发与涡波的近卫骑士团长时期"><data key="name">通信机开发与涡波的近卫骑士团长时期</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据艾德：『通信机』系昔日艾德与涡波大人、赛鲁多拉大人三人通力合作打造；因赛鲁多拉之名被提及，涡波推知为其担任佩艾希亚近卫骑士团长时期之事（本人现完全不记得）；施加于树上的振动魔法能传达声音并获得影像信息——艾德据涡波反应判定其已取回一部分丧失的记忆；（涡波大人明鉴。──正是鄙人、『木之理的盗窃者』艾德。何必如此慌张，这不就是鄙人以前与涡波大人还有赛鲁多拉大人通力合作打造出的联络魔法吗？记得名字是叫⋯⋯『通信机』。没错，是叫『通信机』的魔法）；既然还提到了赛鲁多拉的名字，那就应该是我担任佩艾希亚的近卫骑士团长的时候的事了吧。不过说实话，我现在完全不记得了。；艾德根据我的反应推断出了我记忆的状态。</data></node>
    <node id="混乱与『退还』机制（技能『？？？』）"><data key="name">混乱与『退还』机制（技能『？？？』）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">技能『？？？』暴走：以一定的感情为交换令精神安定（混乱补正+1.00/所有状态异常被转换为混乱）；混乱达10.00超过技能极限时，将积存的混乱变回原来的感情予以『退还』——加足利息后一切（绝望、孤独、焦躁、屈辱、压力、不快、恐惧、污染乃至『恋心』）连同负面感情与记忆一并返还（超越致死量的感情集合/足以使心灵坏死）；连续发动将陷入由绝望连锁构成的通往死亡的单行道式恶性循环；本章对抗法：自身意志主动发动+完全解放『并列思考』进行感情处理（超越极限/脑神经迸火花/滴鼻血）；最终解：克服过去后以命名升华的技能『退还』感情（混乱-1.00）而非废弃；【技能『？？？』暴走了】；混乱达到了10.00，超过了</data></node>
    <node id="佩艾希亚(迷宫六十六层里侧·魔王城)的构造与真相"><data key="name">佩艾希亚(迷宫六十六层里侧·魔王城)的构造与真相</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">漂浮于虚空的世界=『迷宫六十六层里侧』=『魔王城』（正式名称双轨：'没错，就是『佩艾希亚城』'——'这两个都是正式名称'）；千年前『北方』王国的再现（千年前兽人称『魔人』、'一千年前的『北方』可是『魔人』最后的乐园'）；黑云蔽空（居民仰黑天称好天气）；无武器无纷争的兽人城邑（木构建筑为主/与自然融合/植物取代『魔石线』装饰/料理与和风文化由'涡涡推广'）；与地上世界文化对照（联合国瓦尔德酒馆/迷宫联合国）；经济：货币不通用（'这不是能在『这里』使用的金币'）、地上魔石在此仅低等级货（'至少也得准备出中位的魔石'）、变现仅限锻冶场；真相（据雷纳尔多）：始祖涡波千年前为罗德创造、为实现其所有愿望、</data></node>
    <node id="魔石的构造与起源（涡波解析·ch218）"><data key="name">魔石的构造与起源（涡波解析·ch218）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波以『维度・决战演算』解析：魔石以鲜血魔法与『DistanceMute』的复合为基本、混杂类似神圣魔法之物——'毫无疑问跟始祖和圣人的力量有瓜葛'；此世之人经自己之手写入新魔法、改良成可服以习得魔法的魔石；涡波可准确读取其中魔术式但不能完全理解（读取'就像是被突然塞了一堆公式一样'；自评'还是达不到曾经的始祖和圣人的水平'）；不服用即习得判定不可能（'最理想的情况是不须服用魔石就能习得寄宿在其中的魔法，但看来是不可能了'）；据缇缇：'这个所谓的魔石代行的属性是『血』'（'凭感觉人家就觉得是这么回事'）；这东西虽然以鲜血魔法和『DistanceMute』的复合为基本，但也混杂着类似于神圣魔法</data></node>
    <node id="兽人（千年前称『魔人』）"><data key="name">兽人（千年前称『魔人』）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德：'现在是叫兽人啊，千年前可是叫做『魔人』呢'；形态多样——兔耳、狗耳、全身鳞片的蜥蜴人、鸟翅膀、鱼鳍皆有，'每个人都有动物的耳朵或是尾巴'；可用『咒术』辨明涡波'确实不是人'；因'『这里』很和平所以也不需要什么骑士团长'、'骑士什么的，和我们已经没什么关系了'；「现在是叫兽人啊，千年前可是叫做『魔人』呢。一千年前的『北方』可是『魔人』最后的乐园哦。」；走在大桥前面的行人，没有一个是纯粹的人类。令人惊讶的是，每个人都有动物的耳朵或是尾巴。；「不过，只要用『咒术』看过，就知道他确实不是人啊。」</data></node>
    <node id="手环的感情操纵实证（三法全败）"><data key="name">手环的感情操纵实证（三法全败）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波亲试：①自主切断——剑至手环前手自动失力（无关意志）；②怪物破坏——防御瞬间恐惧支配大脑→身体擅自拔剑杀敌（'将手环看得跟妹妹同等重要'的感情被写入）；③被动挨打——任由殴打身体仍回避保护手环（'像保护比自己生命还重要的东西'）；强行尝试伴随呕吐感倦怠感恶化——'有某种东西操弄了我的感情'；愤怒记忆触发三重意志共鸣（'不许摆弄他人的命运'）；原因很简单，在剑即将切断『手环』的一瞬间，我使剑的手突然没了力气。；在『手环』即将被破坏的一瞬间，恐惧支配了我的大脑，那是一种对即将失去无比重要之物的恐惧。</data></node>
    <node id="『连接』门色个体差（ch130更新）"><data key="name">『连接』门色个体差（ch130更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波原以为『连接』的魔法门全为淡紫色；观察海莉的『连接』门为翡翠色——门色随个人魔力性质改变；仔细观察她的『连接』的话，会发现跟我的有点不一样。她的魔法门颜色是翡翠色的。我本来以为『连接』全都是淡紫色的来着，看来根据个人魔力的性质颜色会发生改变呢。</data></node>
    <node id="涡波的推理链（假名说与大火灾推测）"><data key="name">涡波的推理链（假名说与大火灾推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷鲁说明后的自主推理：基督=假名（既知）→玛利亚亦假名？('玛利亚这个名字也是假名，只是我没有注意到那一点？因为这个手环的缘故？'）→妹·妹·的·名·字·有·蹊·跷→流向推测：异世界迷来的兄妹+假名迷宫探索+同伴=拉丝缇娅拉与缇亚→多重不幸复合→『那一天的大火灾』→队伍支离破碎→兄妹被史诗探索者保护→玛利亚失明于其时；难解点=为何连涡波的记忆也封印（'我也有堪比玛利亚失去视力那样的不幸的记忆吗'）；全员温和（无人抱恶意/过于安逸的配置）自觉；首先，我和玛利亚迷失到了这个异世界，然后我报上了『基督』这一假名开始进行迷宫探索。那时候的同伴则是拉丝缇娅拉和缇亚。然而，多重不幸复合在一起，最终招致了『</data></node>
    <node id="『连接』运用规则（ch117更新）"><data key="name">『连接』运用规则（ch117更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">出发前可预置多个『连接』出口（30层），转送可'一口气'抵达；预置代价=最大MP大幅下降（涡波391/796−400），以升级技能点全投魔力补强；莉帕侧=与诺文分别后『不存在于那里的诅咒』消失、仍用其他魔法，因过度记忆流入危险仅维持最小限度、现连接对象仅涡波（他人因隐私回避，莉帕亦嫌恶死神能力）；反向规则=解除全部『连接』则守护者无法追到船上（守护者可经『连接』追及的推论）；确认到随时都能够从迷宫30层开始启程后，我切入正题。；只是因为过度的记忆流入有些危险，所以只维持着最小限度的『连接』；现在跟莉帕之间有联结的只有思考较理性的我一个人而已</data></node>
    <node id="柯尔拉纳"><data key="name">柯尔拉纳</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">柯尔库西北、直行约一晚路程的街道（黄昏抵达）：与贸易中心的港町不同、规模小得多；无柯尔库式高墙、仅石头围栏包裹；如战争中的街道般可见许多监守士兵、潜入须小心魔石线；对拥有『维度』者而言'就像猴子一样'（易避开）；涡波于此以金钱交换购入军马、翻越石栏夜行离街；柯尔库的西北方继续前进，在黄昏的时刻到达了目的地的新街道。；新街道名为柯尔拉纳。；与贸易中心的港町不同，这里的规模小得多。没有柯尔库一样的高墙，只是石头的围栏包裹着，但是就像战争中的街道一样，可以看见许多监守的士兵。</data></node>
    <node id="20级上限与记忆流入机制"><data key="name">20级上限与记忆流入机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">人类在等级和属性方面的上限为20级；涡波超出20级越多，千年前『假面男子』的记忆流入越多——跨越某种界限时记忆就会流入脑中；每次做梦，新记忆便多侵蚀他一分（记忆/感情/身体）；此前曾于诺文『亡灵一闪』时经历同类记忆回放并借此挡下攻击；记忆觉醒钥匙推测=守护者相遇+『并列思考』+升级属性提高+艾德魔法等全部叠加；深层心理如迷宫般错综复杂，『感觉都是为了将我诱往最深部』。；从至今为止的趋势上看，就是人类在等级和属性方面的上限——20级，我超出20级越多，记忆的流入就越多。；当我跨越了某·种·界·限时，那个『假面男子』的记忆就会流入我的脑中。；那是在诺文使出『亡灵一闪』的时候。</data></node>
    <node id="血刻咏唱『代价』体系（魔石人类第二形态）"><data key="name">血刻咏唱『代价』体系（魔石人类第二形态）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">先天的才能人为移植、特化单一才能、全员同样调整、生来以『咏唱』支付『代价』的『魔石人类』（据斐勒卢托）；涡波0.1秒『维度』审查解明：魔力自血中发散（血=记忆魔术式的器官；对照圣人缇娅拉曾将人格刻于血中）→血中刻有支付『代价』的『咏唱』语句、驱动血即触发魔术式→MP完全不消耗（HP19/19 MP112/112 四人皆然）而构成大魔力；发动痛苦'就好像，削减自己的灵魂一样'；与玛利亚（削减『记忆』）·缇缇（削减『自我』）的『咏唱』同类；一边持续释放着这等水平的魔力，MP却・完・全・没・有・变・动。；魔力并非从身体的深处而是从血中发散了出来。这与这个世界使用魔法的道理相悖。血是记忆魔术式的器官。</data></node>
    <node id="六十层试练现状（ch190）"><data key="name">六十层试练现状（ch190）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波考量：若在此给予诺斯菲所冀求的一切，六十层的试练就此终结的可能性并非没有（对其而言是有魅力而轻松的提案，被理性否定）；若留恋真为『说任性的话』，则同六十守护者的战斗或可以此方式结束——但涡波虽说不上非常怀疑，仍不轻易相信；如果在这里给予她所冀求的一切的话，那么六十层的试练就此终结的可能性并非没有。；但在这时得知可以以这样的方式结束同六十守护者的战斗</data></node>
    <node id="迷宫人造说（涡波推论）"><data key="name">迷宫人造说（涡波推论）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波推论：迷宫非天然形成，经某人之手在某种目的下制造——依据=难度梯级设计对人类有所关照（正道铺设等）；『到底是谁制造了这个迷宫』为持续追问的悬案；这个迷宫一定是经·某·人·之·手在某种目的下制造出来的。</data></node>
    <node id="诺文生前史(阿雷亚斯家旧貌与死神生涯)"><data key="name">诺文生前史(阿雷亚斯家旧貌与死神生涯)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">生前阿雷亚斯家：破宅独居童年+最强剑士家训+禁见山下孩子（家名一体教育）→战场死神（黑红色连杀记忆/世人恐惧不赞/舞会一次未参加过/友军发狂初杀）→圣女近卫骑士（无英雄实感）→死后成只求荣光名誉斩敌的怪物；千年前南军死神=诺文、北军牌=始祖之慕影死神；世人并没有称我为『英雄』，而是将我称为了『怪物』。；就这样，少年恪守着血亲的遗言，成长为一名希冀阿雷亚斯家繁荣的青年，从来不曾背弃家训，成为了一名不使用魔法的剑士。</data></node>
    <node id="帕林库洛的试练设计（舞会章自觉）"><data key="name">帕林库洛的试练设计（舞会章自觉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波自觉：斯诺剧变=回想帕林库洛之言所致——'这个状况是帕林库洛在很早之前就已经设计好了的'；威胁结构：揭穿劳拉维亚的谎言→着迷于涡波的少女（斯诺）泪水决堤+涡波/玛利亚/斯诺全员不幸 vs 选择成为联合国『英雄』→全员得到『幸福』；此难关=帕林库洛预告的更严苛『试·练』（起点=初见斯诺那一天）；期限=舞斗大会（两天）——败北 repeat 的恐惧与'为·了·守·护·那·个·誓·言'；也就是说，这个状况是帕林库洛在很早之前就已经设计好了的。；自己（涡波）也好，妹妹（玛利亚）也罢，连同那边那名少女（斯诺）在内，所有人都会变得不幸。那样真的好吗——如此这般地在我耳边嚅嗫。</data></node>
    <node id="涡波的魔法学习界限与仿造法则（ch119）"><data key="name">涡波的魔法学习界限与仿造法则（ch119）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波能使用的冻结魔法很少（仅『冻结』『冰』两个），'能使用的魔法面真是窄'（据拉丝缇娅拉）；曾服冻结魔法『利特尔降雪』魔石无任何变化→自断'我能学会的魔法只有次元魔术而已'（推断）；另'具体想像对魔法的影响举足轻重。我的魔法基本上也都是仿造的'（涡波自述）；反而我会使用的冻结魔法很少。只有『冻结』和『冰』两个；涡波能使用的魔法面真是窄啊⋯⋯；我服下了冻结魔法『利特尔降雪』的魔石，但是没有发生任何变化。</data></node>
    <node id="赫勒比勒夏因・二重奏剑"><data key="name">赫勒比勒夏因・二重奏剑</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳'真正的共鸣魔法'：宣言三连名（『血与魂的共鸣』『将世界斩裂的生命之双剑』，其名为『赫勒比勒夏因・二重奏剑』）；实态=两对双剑各具剑法+双重魔法之后再辅以双重魔法的四重连携——'每一把剑都寄宿着不同的风格，每一个魔法都彼此独立'；「──我要上了，『光之理的盗窃者』。这便是我真正的共鸣魔法、『血与魂的共鸣』『将世界斩裂的生命之双剑』！其名为──『赫勒比勒夏因・二重奏剑』！！」；「──『风之矢』！『DivineArrow』！」；──在双重击出的魔法之上，再辅以双重的魔法。</data></node>
    <node id="昔日南方战力名录（据艾德）"><data key="name">昔日南方战力名录（据艾德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据艾德：如今的南方已经没有多少可用之才；过去要面对以『使徒迪普拉库拉』为首、加上『诺斯菲・弗茨亚茨』『诺文・阿雷亚斯』『缇达・兰斯』『法芙纳・赫勒比勒夏因』等众多棘手敌人、但现在一个都没有；这次北方才是战争的主导者；如今的南方已经没有多少可用之才了。在过去，以『使徒迪普拉库拉』为首，加上『诺斯菲・弗茨亚茨』『诺文・阿雷亚斯』『缇达・兰斯』『法芙纳・赫勒比勒夏因』等人，我们要面对太多棘手的敌人，但现在一个都没有！</data></node>
    <node id="『再诞』仪式"><data key="name">『再诞』仪式</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉自白与拉丝缇娅拉对谈：帕林库洛为友人海因实施、模仿圣人缇娅拉的『再诞』仪式；材料=海因·赫勒比勒夏因的身体（'特别订制品'=使用所有的血）；因尸体材料不足补充『基督・欧亚』之血→'所有的计算全部失控'→失败；失败表现：身体向女性性征转变（转变理由至今不明，亦非海因血输给基督・欧亚血）+再现满是漏洞（记忆残缺/无本人实感）；拉丝缇娅拉判断'如果是『再诞』的话，现在在这里的你就应该是男性才对'；也就是说帕林库洛想要让海因『再诞』呢。通过模仿圣人缇娅拉『再诞』的仪式；从因为尸体的材料不足而补充了『基督・欧亚』的血开始，所有的计算就全部失控了；海因・赫勒比勒夏因的血流失过多了。为了补充而不得不少</data></node>
    <node id="千年前世界的货币与价值体系"><data key="name">千年前世界的货币与价值体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前城市流通货币与迷宫联合国货币完全不同（质地/铸造方法皆异），地上金币不可使用（雷纳尔多：'这不是能在这里使用的金币'）；地上魔石在此被评'破烂'、新月线形石仅'低级别'，需中位以上魔石方有支付力（据地上旧闻'千年前的魔石质量比现在高'+涡波亲见过去高性能装备互证）；水晶魔法精制的黄金钻石同样不值钱（'就算你拿出黄金和钻石之类的东西，在这边也不值钱的啊'）；丝线锥子等日用品反而高价。成因：全城仅雷纳尔多能精工魔石矿石（缺精工场所→难成魔石钻石饰品习惯→无『魔石线』则无宝石美学品味）＋此时代学魔法靠自身力量不使用魔石。魔石'只有在这里（锻冶场）才能变现'。；「虽然有点对不住，不过这钱用不了。</data></node>
    <node id="迷宫30-31层环境（ch117）"><data key="name">迷宫30-31层环境（ch117）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">30层变貌：水晶花田消失，'只剩下了无机质的辽阔石制空间'，'感受到了跟阿尔缇那时一样的悲怆感'（守护者楼层变貌的既例感）；31层与29层无大异（沙地材质/地面硬度稍变）；沙海无限远泛、视野无壁无向；哥雷姆与鱼形怪物游荡、'身上都披着看上去就很坚硬的水晶'；『维度』可把握区域构造/敌人位置/下一层阶梯，但沙海内部无法完全掌握（沙地下藏敌的攻击风险）；30层也是换了一副面貌。原本的水晶花田不见了踪影，只剩下了无机质的辽阔石制空间。；感受到了跟阿尔缇那时一样的悲怆感，我们就来到31层。；沙海无限远泛。哥雷姆与鱼形怪物在沙漠中游荡着。怪物们身上都披着看上去就很坚硬的水晶。</data></node>
    <node id="佩艾希亚结界现状（ch199外膜破损）"><data key="name">佩艾希亚结界现状（ch199外膜破损）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『佩艾希亚』本体=始祖打造出的结界：魔弹『重崩色之非风剑』偏折后在天空凿穿『宛如教科书插图里的黑洞一样巨大』的漆黑洞穴——强行制造出的风穴旋即导致周围空间龟裂、绽裂蔓延使天空逐渐剥落塌陷，结界外膜『就像鸡蛋壳一样被轰碎了』；涡波抗议『不要再朝佩艾希亚射了』、罗德不以为意（『只要涡波留下的话就能修好』）；一个宛如教科书插图里的黑洞一样巨大的漆黑洞穴凿穿了名为『佩艾希亚』的结界。；被强行制造出的风穴旋即导致了周围空间的龟裂。空间的绽裂开始逐渐蔓延，让天空逐渐剥落塌陷。始祖打造出的结界的外膜，就像鸡蛋壳一样被轰碎了。；「⋯⋯那、那你光射我就行！不过不要再朝『佩艾希亚』射了！！」</data></node>
    <node id="主角家庭背景"><data key="name">主角家庭背景</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">相川涡波在原世界无双亲、有一名『妹妹』；担忧自己消失后妹妹孤身留在家中——『归还』动机的感性支柱；虽然没有双亲，不过我还有『妹妹』呢。</data></node>
    <node id="身体与魔石的错装机制"><data key="name">身体与魔石的错装机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">正常来说『水之理的盗窃者』的魔石对涡波这边（借阳滝身体的）身体是必要的，而『始祖涡波』的身体需要的是『次元之理的盗窃者』的魔石；但没有了『魂』、依靠本能行动的始祖涡波不能做出理性判断——遵照本能为不再分离，将紧紧抱在胸前的『水之理的盗窃者』的魔石小心收入自己体内，'『身体』和『魔石』产生了错装'；'『始祖涡波的身体』得到了『阳滝的灵魂』'这个式子的答案开始侵蚀现实——躯壳经魂优先变化『再诞』为少女相川阳滝（兄妹身魂颠倒：阳滝魂入始祖躯壳/涡波魂留阳滝身体）；正常来说，『水之理的盗窃者』的『魔石』对我这边的身体来说是必要的。而『始祖涡波（你那边）』的身体需要的是『次元之理的盗窃者』的魔石。；为了</data></node>
    <node id="『表示』怪物判定：二十守护者（TwentyGuardian）"><data key="name">『表示』怪物判定：二十守护者（TwentyGuardian）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛完死体化后『表示』先产生乱码（'Na■Nk帕林■理的■伽西HP■/5■2MP───/39-职Lass'，判例3原样照录不猜测），继而数据变换为'二十守护者（TwentyGuardian）暗之理的盗窃者'——『表示』将其确认为怪物；完死体=心脏完全停止、HP0仍能活动的『彻底的尸体』；Na■Nk帕林■理的■伽西HP■/5■2MP───/39-职Lass；用『维度』听去，帕林库洛的心脏已经完全停止跳动了。；这副模样可以称得上是『完死体（怪物）』了。</data></node>
    <node id="『咏唱』与『魔法宣言』机制（ch90）"><data key="name">『咏唱』与『魔法宣言』机制（ch90）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『咏唱』=莱纳从罗德处习得的魔法技术（'程度较轻的'如『天路垂临』『续道碧霄』——诵出后周围之风纳入支配，魔力浓度与先前判若两人）；怪物侧存在等效机制：LizardFlyer翅膀鸣响（'嗡嗡、地'，非人语）=具有『咏唱』效果的『魔法宣言』，用于发动『魔法相杀』（柔和之风顷刻化解莱纳全力风魔法）；其相杀破绽=迎击时须静止（无法同时移动与相杀，据涡波推测）；莱纳诵出从罗德那里学到的程度较轻的『咏唱』，紧接着周围的风便被纳入到他的支配之下。；尽管这并非人语，但却是具有『咏唱』效果的『魔法宣言』。；紧接着，莱纳的『Sehr·Wind』便遭到了『魔法相杀』。</data></node>
    <node id="涡波传说扩散与立场（据缇莉声称）"><data key="name">涡波传说扩散与立场（据缇莉声称）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇莉声称：涡波现称号集合=『最强』『英雄』『剑圣』『守护者杀手』（另『天然英雄』）；舞斗大会战绩被吟游诗人讴歌、剧场船『瓦尔法拉』上演其活跃戏剧且受众渐增；劳拉维亚子民视其为'拯救囚禁公主的白马王子'（『史诗探索者』积极推广此传闻）；对外口径=公会背地里的实际支配者、会长一职永久保留（名号借用）；涡波本人自述'在联合国基本都是通缉状态'、盘算改名回基督；文书积压=舞斗大会夺冠后出走所致；现在的你可是『最强』的『英雄』，同时还是『剑圣』以及『守护者杀手』。；在那之后剧场船『瓦尔法拉』还上演了讲述你这段活跃经历的戏剧；「你说什~么呢。史诗探索者的会长一职永久保留。它永远都是属于涡波君的东西哦？」</data></node>
    <node id="南北境界战争形态（别动队小规模交锋）"><data key="name">南北境界战争形态（别动队小规模交锋）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波夜穿战场地带所见：非纠集大部队互角的打法，主战场之外别动队间频繁小规模交锋；步兵彻底分散行动（推测：因魔法存在，聚集易成攻击目标，或此世独特战术）；交战士兵等级无超过十者；他骑行长驱直入——箭矢以剑挡、魔法以『次元之冬』化解，均不构成威胁。；在主战场之外，别动队之间进行着频繁的小规模交锋。；步兵没有聚集在一起，而是彻底地分散行动。；不过交战中的士兵没有等级超过十的</data></node>
    <node id="莱纳的风魔法飞跃（ch90）"><data key="name">莱纳的风魔法飞跃（ch90）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳风魔法水准'提高了好几个次元'（与先前判若两人；以前仅以风魔法辅助、因攻击力不足而主用剑）；要因（据涡波归纳）：继承海莉的魂+提升等级魔力大增+以守护者艾德和罗德为师学魔法+掌握『咏唱』技术+增幅风魔法的魔剑Sylph·Rokh·Bringer；从罗德处习得轻量咏唱『天路垂临』『续道碧霄』与『Jaeger·Wind』；其余实战术式：Sehr·Wind（暴风）/Wind（多重牵制·风之坐垫）/Ex·Wind（爆炸推进）/WindFlamberge（风强化剑）；MP效率（66层再战仅耗约50）；仍无法凌驾位阶67的艾尔芬里斯；莱纳诵出从罗德那里学到的程度较轻的『咏唱』，紧接着周围的风便被纳入到</data></node>
    <node id="黑洞"><data key="name">黑洞</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『这里』空中与地下各有一个黑洞；佩艾希亚结界失效后开始拓展、黑色侵蚀蔓延；接着，以漂浮在空中的黑洞为背景，她翠色的魔力居中闪耀。；位于空中的黑洞开始拓展，地下的那个也是一样，黑色逐渐侵蚀蔓延。</data></node>
    <node id="守护者封印与地上活动"><data key="name">守护者封印与地上活动</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">每过十层解放一名守护者（现仅二：阿尔缇10/缇达20，因人类封印解除至23层为止）；守护者不被迷宫束缚——可变装上街（结界削弱力量但不禁止；缇达时不时变装散步）；十层=阿尔缇体内（火焰空间/无怪物/安全调度火焰唯一处）；向十层火焰搭话即可向阿尔缇传讯；阿尔缇持凭依/寄生能力（无害凭依恋爱当事人体验感情）；因为每过十层就会有一个人被解放出来。</data></node>
    <node id="次元魔术的属性模仿特性与传授不可（据罗德）"><data key="name">次元魔术的属性模仿特性与传授不可（据罗德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德：涡波'以前就能依靠次元魔术捏造出其他属性魔法的效果来着'、专精次元'确实是最有效率的方法'、无需勉强学习其他属性魔法；但其具体做法罗德亦不知（'人家并不知道具体的做法！因为涡涡是个超级秘密主义的人嘛！'）——'就连擅长魔法的罗德都没办法将上位的次元魔术传授'；涡波复述确认：'次元魔术是能够对风魔法之类的东西进行模仿的'；涡波结论：唯一传授者＝『始祖涡波（自己）』→替代学习途径＝'直接读千年前的魔导书'（藏书室）；「涡涡那么做也确实是最有效率的方法呢。你以前就能依靠次元魔术捏造出其他属性魔法的效果来着，所以不用勉强自己学习其他属性的魔法也无所谓哦」；「果然，次元魔术是能够对风魔法之类的东</data></node>
    <node id="诺文水晶的特性（据艾德）与Quartz应用"><data key="name">诺文水晶的特性（据艾德）与Quartz应用</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">水晶魔法『Quartz』（诺文之剑的魔法，莱纳咏唱）：将剑刺入大地生成水晶——本章两用：其一'水晶就像苔藓一样覆盖地面，并裹住了'基督、挡下艾德藤蔓；其二将周围土转换为矿石、'覆盖上我和基督的身体'如雕像、外构厚防御壁成'圆形的水晶玉'。据艾德：'这是诺文大人的水晶！？那不是什么人都无法击碎的东西吗！'（未尝试击碎即后撤）；「这是诺文大人的水晶！？那不是什么人都无法击碎的东西吗！」；将剑刺入黑色的大地，生成水晶。</data></node>
    <node id="光魔法『光』（诺斯菲）"><data key="name">光魔法『光』（诺斯菲）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲战前构筑的基础魔法（光系）：以有些不快的表情构筑完成战前准备；莱纳的战场被称作『南侧』的光（与罗德『北侧』的风对举）；被人死瞪着的诺斯菲以有些不快的表情构筑好魔法，结束了战前准备。；「──光魔法『光』。罗德，涡波大人他们似乎是打算将我们两个分割开来呢」；就这样，我走向『北侧』的风中，莱纳则迈进『南侧』的光中。</data></node>
    <node id="神圣魔法的原形（缇娅拉开发）"><data key="name">神圣魔法的原形（缇娅拉开发）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">梦中缇娅拉构筑的魔法被涡波认出是『神圣魔法』——完成度异样地低、术式不完善，但确为原形；照此顺利进化下去，迟早会变成涡波所认识的『神圣魔法』。神圣魔法源于千年前缇娅拉之手。；这是『神圣魔法』。；不过，这个魔法确实是『神圣魔法』的原形。；尽管现在还很拙劣，但就照这样顺利地进化下去，迟早有一天会变成我所认识的『神圣魔法』吧。</data></node>
    <node id="五国地理与国境"><data key="name">五国地理与国境</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">五国领地环绕迷宫建设，距迷宫越近国与国距离越短；国境建石墙（上敷魔石线）但越境无任何手续；原来五国的领地是环绕迷宫建设的，所以距迷宫越近，五国之间的距离也就越短。；但我注意到石墙上也有那个所谓的『魔石线』</data></node>
    <node id="魔术式与锻冶速习机制"><data key="name">魔术式与锻冶速习机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">魔术式=以文字形式再现魔法构造、注入魔力即发动（使用者理解与相性重要；市售镌刻术式魔石高价=凝结匠人时间气力；最高级例=玛利亚服下的『Firefly』『Impulse』魔石）；涡波速习法=『Dimension·多重展开』俯瞰劳拉维亚全工房锻冶师动作+赛莉协力并行读书+实践修正（『Dimension』毫米级动作调整）——数小时得锻冶0.69（'几十分钟练就中坚锻冶师手腕'据艾利巴茨）；代价=MP体力骤减/体温骤升；此法复现自昨日特训习得『魔法战斗』（'只要再重复这个行为就行了'）；魔法与魔术式是两个领域（擅长魔法≠擅长魔术式）；那是指以文字的形式将人们使用的魔法构造再现出来的事情。；像这种镌刻了</data></node>
    <node id="罗德的『绘画』（四幅）"><data key="name">罗德的『绘画』（四幅）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">漂浮在被蹂躏世界空中的数张『绘画』：只有小孩子涂鸦的水准却被用最豪华的画框装饰起来；画着『草原和人字形屋顶的房子』『一对兽人老夫妇』『孤儿院』『城堡的庭院』；世界被蹂躏至斯仍毫发无损（依罗德的期望/世界法则）。内含魔石：蕴藏的魔力微弱却散发阵阵令人温暖的翠色光芒——被涡波遵・循・罗・德・的・期・望抓取，以『DistanceMute』抽出魔石挪入断左手掌，用作'扣进罗德心中'的最后一击之物；那些『绘画』只有小孩子涂鸦的水准──但却被用最豪华的画框装饰了起来。那上面画着的是『草原和人字形屋顶的房子』、『一对兽人老夫妇』、『孤儿院』、『城堡的庭院』；就算连世界都被蹂躏成这般模样，但唯有那些绘画仍旧毫</data></node>
    <node id="技能『？？？』与『并列思考』的禁用与暴走"><data key="name">技能『？？？』与『并列思考』的禁用与暴走</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波自我规则：'绝对不能使用的两个技能『？？？』和『并列思考』'；技能『？？？』：乱七八糟人际关系之源、'连死都不被允许'；『并列思考』：擅自运作、一旦开始就停不下来、令世界流逝变慢、做出大量痛苦预测（'妹妹不存在，我也不存在之类的推测'、'打击严重到几乎胃穿孔'）、越用越偏离人类范畴；本章已暴走——'不赶紧抑制住就麻烦了⋯⋯⋯不，已经迟了吗'；──绝对不能使用的两个技能『？？？』和『并列思考』；在那当中自然有妹妹不存在，我也不存在之类的推测。；多亏如此，世界的流逝变得更慢了。</data></node>
    <node id="千年前遗产论（帕林库洛史观）"><data key="name">千年前遗产论（帕林库洛史观）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛论：『现在这个世界上的一切，皆起因于千年前。无论去往何处，无论你是何人，都能触及到千年前』——开拓地的『迷宫』与拜伦西斯大陆的『境界战争』皆千年前那帮人留下的遗产；反言之『要怎样才能从千年前的束缚中挣脱出来才是困难』，众人皆被『命运』和『出身』玩弄于鼓掌（自语；部下仅能理解成历史与现状相连）；「不，你说错了。现在这个世界上的一切，皆起因于千年前。无论去往何处，无论你是何人，都能触及到千年前。开拓地的『迷宫』是这样，这拜伦西斯大陆的『境界战争』也是这样，全都是千年前那帮人留下的遗产啊……」；反过来说，要怎样才能从千年前的束缚中挣脱出来才是困难。你也好我也好，全都被『命运』和『出身』玩弄于</data></node>
    <node id="守护者彼此不一定全都相识"><data key="name">守护者彼此不一定全都相识</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇缇不知阿尔缇其名（仅知『火之理的盗窃者』名号、无交集）却知晓魔法『格林・利姆・莉帕』及其来历——涡波据本章对话确认'守护者彼此之间不一定全都相识'为新情报；「原来如此。虽然人家知道有『火之理的盗窃者』这么一号人物存在，但没什么交集呢，这样啊，名字叫阿尔缇吗⋯⋯」；看来缇缇跟阿尔缇之间没有产生过交流。我一边确认着守护者彼此之间不一定全都相识这个新情报，一边接着报告道。</data></node>
    <node id="魔王"><data key="name">魔王</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的称呼之一：据罗德语，曾『被己方（涡波）称为魔王』；本章叙述中亦以『魔王（罗德）』指称；用曾经被己方（你）称为『魔王』；多亏了与魔王（罗德）这样强大的对手交锋</data></node>
    <node id="斯诺的振动魔法全域监听"><data key="name">斯诺的振动魔法全域监听</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉揭示：将无属性的振动魔法修炼至极致的斯诺，凡与声音相关什么都做得到——瓦尔法拉全船由高级船只+大量魔石构成=她的特殊魔力可肆意浸透（'不管我们在哪里谈话内容都逃不过她的耳朵'）；魔石传声双向（宣战/欲言又止的对话均经房间魔石）；'我会·一·直·听·着·的'的持续监听宣言——与涡波Dimension同级的 surveillance 能力（'简直就像是跟我的Dimension做对手一样'）；「对将无属性的振动魔法修炼至极致的斯诺来说，但凡是跟声音有关的就什么都做得到。而这个船队全部由高级船只组成则更助长了这一点。作为媒介的魔石足够的多，所以斯诺特殊的魔力能够肆意浸透其中。不管我们在哪里，</data></node>
    <node id="技能『剑术』（涡波）"><data key="name">技能『剑术』（涡波）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波最高级别技能：防御技法=回抽剑柄末端柄头叩击来袭剑刃将其错开；水准自认高于罗德，但因对手动作速度太快+不讲道理的架势/剑招/重心变动（超出『剑术』范围的『风剑术』）被压制在防守中；涡波『真本事还根本没有发挥出来』却默不作声不告知对手；通过回抽剑柄末端的柄头，叩击袭向自己的剑刃将其错开，借此实现了防御。；因而虽然我具备最高级别的技能『剑术』，却还是被罗德压制在防守中。；我『剑术』的真本事还根本没有发挥出来这事没必要特地告知自己的对手。</data></node>
    <node id="手制泳衣工艺与异世界材料制约"><data key="name">手制泳衣工艺与异世界材料制约</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">数小时制成八件=状态与技能的犯规恩惠：剑术化境的思考注意力（'双手比机器更精确'）+『维度』毫米以下测量免量具+脑内三维构想免设计图+『并列思考』八件并行压缩工时；材料制约：异世界无橡胶且『所有物』内无替代品→绳系固定古朴造型；性能优先、尺寸完全合身（'绝对不会发生游泳时脱落'）；剑术臻于化境的我，思考和注意力都远超常人。现在我的双手已经比机器更精确了吧。；再加上可以测量到毫米以下单位的『维度』，布料的各种面积都手到擒来，自然也用不着测量工具。；纠结来纠结去，我制成的泳衣造型便自然地十分古朴，是用绳子固定泳衣的形式。</data></node>
    <node id="水之理的盗窃者（阳滝魔石）"><data key="name">水之理的盗窃者（阳滝魔石）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前缇娅拉自心脏被师父刺穿而假死的阳滝体内单独抽出的『魔石（魂）』——如蓝宝石般美丽的青色魔石，持续睡眠状态至今；寄宿【停止世界的流动】之理：其冷气可连同物质之外的空间、时间甚至魔力一并冻结（冰结的极致/流动着的液体全部冻结/冷酷得足以将生命的脉动也一并停止）；千年来作为涡波体内的第二魔石（『冰结魔法』『并列思考』『剑术』等才能之源），本章被始祖躯壳夺走错装；亦为帕林库洛灌入躯壳之『毒』的净化者（魔石无意识吸收其魔力）；亦即『水之理的盗窃者』的魔石。；「话是这么说，但『水之理的盗窃者』的魔石（魂）仍然处于睡眠状态。；帕林库洛打算用来强化黑刃的液体开始被『水之理的盗窃者』的冷气冻结。</data></node>
    <node id="魔法适性与余白"><data key="name">魔法适性与余白</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一人可掌握的魔法有限（血之术式余白）：主角=只有次元属性适性（其他魔法无法掌握——LittleSnow 未得之因）；拉丝缇娅拉=余白已满（『已经彻底完成了』）故无法习新；故二十四层对策（熔岩驱除+耐高温）只能教给玛利亚与缇亚；因为你只能掌握次元魔法，所以我也无可奈何。」</data></node>
    <node id="瓦尔德新居"><data key="name">瓦尔德新居</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主角年租十金币的独幢木构豪宅（4LDK级）：山丘上俯瞰居民街/采光好近迷宫；魔石线入户供能（水洗·烧水·生火+魔石浴缸）；铁与魔石之门锁（宝石钥匙）安全性媲美原世界；厨房胜酒馆——ch14『留在家中』之家；再加上『魔石线』一直铺设到了住房内部，所以还兼备水洗•烧水•生火等用途的魔法道具。</data></node>
    <node id="翼人种"><data key="name">翼人种</data><data key="type">种族</data><data key="status">provisional</data><data key="desc">传说中『支配之王』所属种族（『根据传说『支配之王』就是『翼人种』』）；特征=背生羽翼；爷爷据此推测缇缇非『变异种』而是翼人种（『连特征也非常相似』）；缇缇宣名时自称『支配这片大陆的翼人之王』；搞不好缇缇其实不是什么变异种，而是『翼人种』呐。根据传说『支配之王』就是『翼人种』。而且连特征也非常相似；人家──不，『孤』乃是支配这片大陆的翼人之王！继承最悠久的魔血的末裔，将此世上的一切纳入支配之下的王、『罗德（Lord）』！面对尔等草芥，孤绝无败北之理！！</data></node>
    <node id="六十六层『这里』的本质（ch209）"><data key="name">六十六层『这里』的本质（ch209）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">'这个草原是为了她而准备的世界'——『这里』不论『表侧』还是『里侧』全部是为缇缇而准备的空间；只要在『这里』战斗缇缇就是最强的（可如'那个时候的莱纳'般无止境地变强）；已消失者构成的魔力残渣'连魂都不剩，更不可能会有意识'、却尽为缇缇身体所引；诺斯菲另声称该空间'即使过上几万年也能与过去相连'、且'只要再让罗德的心屈从就会复苏'、'您就是按照这种规则创造出了这里'（据诺斯菲声称——创造者归属存疑）；这个草原是为了她而准备的世界，这一点即使是现在也没有改变。；果然，『这里』不论『表侧』还是『里侧』，全部都是为了缇缇而准备的空间。；其中已经连魂都不剩。更不可能会有意识。</data></node>
    <node id="迷宫39层（森林级植物猎场）"><data key="name">迷宫39层（森林级植物猎场）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">植被森林级（成倍增加/视野全绿/藤蔓一望无际/脚边水仍多）；构造类似1层特殊区域，昆虫系怪物比想象少、以植物类为主（播撒古怪花粉的花/食蝇草状大张口的草/高粘树液的树）；多拟态待机型怪物——『维度』观察力也难简单识破（但涡波『表示』『表现』可辨、危险度近零）；打倒敌人不会一口气聚集=低风险刷级猎场；BOSS可用『维度』避开；层内多个祭坛道具已消失（先行者痕迹）；狩猎所需仅『维度』/神圣魔法/『表示』/『剑术』四样（状态异常攻击可由拉丝缇娅拉神圣魔法治疗）；在39层植被比之前更加茂密，已经跟森林一个级别了。；播撒古怪的花粉的花。食蝇草一样大张着口的草。流着粘度极高的树液的树。；这一层的好处就是就</data></node>
    <node id="暗之理的盗窃者（完死体）战斗特性"><data key="name">暗之理的盗窃者（完死体）战斗特性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">物理攻击无效——被斩断的断面瞬间接合（'跟我用剑斩过瀑布一样'）；形态：兽足+双臂化两把野太刀、野兽级加速度；攻击模式在野兽一击与骑士架势间瞬间切换；舍身攻击不顾防御；较缇达另具独有『技术』『策略』；自毁心脏亦不碍活动；帕林库洛的身体被斩断了不假──但是断面瞬间就实现了接合。这一幕就跟我用剑斩过瀑布一样，我的反击没有效果。；我再次明确到物理攻击对『暗之理的盗窃者』无效这一事实。；他解除了一只手臂的刀刃化。尽管速度等同于野兽，但是架势是货真价实的骑士。</data></node>
    <node id="『连接』往返机制（迷宫↔船）"><data key="name">『连接』往返机制（迷宫↔船）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚MP将尽时请涡波'使用『连接』'，涡波'作出『连接』'后众人走过即穿过门、见辽阔青空回到『LivingLegend号』甲板——『连接』为连接迷宫与魔导船的通行手段，由涡波应请发动（其本体归属魔法抑或船之机能本章未明【待确认】）；差不多MP要用光了。拜托你使用『连接』了，涡波先生；我按照吩咐，作出『连接』。；穿过了门就看到了辽阔的青空。</data></node>
    <node id="魔石线（城市警戒与情报传递网）"><data key="name">魔石线（城市警戒与情报传递网）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">城市警戒与情报传递设施：潜入克拉布布布布布布布布布布布布布布尔时需要注意的只有『魔石线』（在『Dimension』面前其余防卫形同虚设）；经魔石线传递情报的速度比涡波的行进还快——涡波推测城堡守军或借此先知其动向（初以为城堡混乱系己身林中行动所致，后查明实为西斯艾德先袭）。；需要注意的只有『魔石线』；如果利用『魔石线』的话，情报传递的速度会比我的行进还要快。</data></node>
    <node id="LivingLegend队伍的崩壊（七人→二人）"><data key="name">LivingLegend队伍的崩壊（七人→二人）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">当初离开劳拉维亚时『本来还以为没有人能敌得过LivingLegend队伍』，不知不觉间队伍陷入崩壊状态（涡波自认『从来就没有顺顺利利地打赢过几场仗』）；本章拉丝缇娅拉、塞拉、斯诺、莉帕四人经『连接』离队后仅剩涡波与玛利亚；原本共有七人的队伍成员不断减少，终于只剩下了我和玛利亚。；当初离开劳拉维亚的时候，本来还以为没有人能敌得过LivingLegend队伍。结果不知不觉间队伍就陷入了崩壊的状态。其实仔细想来，自己从来就没有顺顺利利地打赢过几场仗。</data></node>
    <node id="地上一年后剧变（表里实察·ch210）"><data key="name">地上一年后剧变（表里实察·ch210）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">六十六层之战后两日涡波重返地上的实察：表侧生机勃勃、无论哪里都洋溢着生气，危险职业者亦如沐春风——'西部开拓时代、亦或是经济高速发展期'（涡波联想）；但'被表侧世界当做食粮的里侧世界必然也会有同样的成长'——贫民的数量明显倍增、一触即发的危险氛围与火药味、被主人舍弃的奴隶为数不少（其中混有少许『魔石人类』的身影）；缇缇指'那个奇怪的黑云也不见了'；涡波判这场剧变之下潜藏某种『扭曲』、被『感应』捕捉——'像是在看着一件摆在摇摇欲坠的展台上的尚未完成的艺术品'；那个奇怪的黑云也不见了；但不论如何，这场剧变之下的确潜藏着某种『扭曲』，即使不情愿，它也逃不过我的『感应』；那么被表侧世界当做食粮的里侧世</data></node>
    <node id="雷纳尔多的豪宅"><data key="name">雷纳尔多的豪宅</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷纳尔多之前居住的宅邸（涡波以残留风韵确证）：宅邸面积扩大、相应建有新建筑物、工房被拆除；前廊摆着富丽堂皇的家具；现为诺斯菲与被其重创的雷纳尔多所在处、涡波对峙舞台；有庭院与正门；与ch0189千年前（诺斯菲照料始祖涡波）宅邸是否同栋未确证——存疑分开建，留R4；接着，我确信了这栋豪宅就是雷纳尔多之前居住的地方。虽然宅邸的面积扩大、相应地建有新的建筑物，工房也被拆除，但这里仍然残留着那栋宅邸的风韵。；就跟『维度』得到的情报一样，雷纳尔多和诺斯菲就在摆着富丽堂皇的家具的前廊之内。但两人的状况差别就大了。</data></node>
    <node id="亲和（概念增强）"><data key="name">亲和（概念增强）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳在第二次Quartz咏唱中感到'帕林库洛和基督口中那个叫做亲和的东西在不断增强'——'亲和'为帕林库洛与基督提及的概念（概念定义出自前章之口，本章仅记述莱纳与诺文之间其增强）；帕林库洛和基督口中那个叫做亲和的东西在不断增强。</data></node>
    <node id="缇缇的守护者力量减弱与酒精生效（ch214自察）"><data key="name">缇缇的守护者力量减弱与酒精生效（ch214自察）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇缇自察：'跟以前比起来对酒的分解速度变慢了⋯⋯？'，自猜'是因为六十六层的战斗过后，守护者的力量减弱的原因⋯⋯？'（疑问形自估）；据基督（基于与缇缇的记忆之旅）：此前'各样各样的毒物对她都是没有效果的'，'现在似乎变得和以前不同了。酒精好像对她产生了一定的影响'——守护者衰减的体感证据（与 ch190 诺斯菲魔力衰减·身体稀薄同谱）；「姆！？姆姆姆？确实，跟以前比起来对酒的分解速度变慢了⋯⋯？是因为六十六层的战斗过后，守护者的力量减弱的原因⋯⋯？」；根据此前和缇缇一起度过的记忆之旅看来，各样各样的毒物对她都是没有效果的。不过现在似乎变得和以前不同了。酒精好像对她产生了一定的影响。</data></node>
    <node id="圣人缇娅拉与世界史"><data key="name">圣人缇娅拉与世界史</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">圣人=能听到大陆中央世界树（Yggdrasill）之声者，以此获得世界所没有的知识唤起奇迹；缇娅拉·弗茨亚茨=最先创造魔法者/九种属性魔法的创造者/弗茨亚茨的缔造者（本圣诞祭即其祭）；莱文教圣人众多（圣诞祭有三个+诸神祭典）；圣装游行=扮缇娅拉同伴祈无病无灾（越近诞辰圣人力量越强）；联合国五国=各自本土（大陆大国）的边陲殖民地，与本国互不接壤；而且她可是最先创造出魔法的人哦。另外，弗茨亚茨也是她缔造的。」</data></node>
    <node id="魔法『Shunposhion・Feather』"><data key="name">魔法『Shunposhion・Feather』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">西斯脱离用魔法（临别咏唱'再见了『基督』'）：光翼张翅、白色羽毛大量飞舞遮蔽视线，全部羽毛如烟花逐一炸裂——强冲击破坏涡波体式；西斯借势贴身高速通过后张翼飞向'即使伸长手中的剑也无法够到的遥远高空'，地上仅余飘落白羽；再见了『基督』，魔法『Shunposhion・Feather』！；光翼张开羽翅煽动着，白色的羽毛大量的飞舞在空中。；宛如烟花一般的一个个炸裂开来的羽毛，这一个个冲击都十分的强烈，让我的体式崩壊。</data></node>
    <node id="『冰结剑』×『炎之剑』双重夹击"><data key="name">『冰结剑』×『炎之剑』双重夹击</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波×玛利亚交换气息后从左右的炎冰双刃夹击：涡波『冰结剑』+玛利亚『炎之剑』同时斩下——被西斯『DivineCircle』防住弹开（'就好像叩击山峦一般的感觉'），两人被推回后方；──魔法『冰结剑』！」；「──『炎之剑』！」；炎刃与冰刃的双重夹击。</data></node>
    <node id="『维度』的长用进化→『次元决战演算『先谭』』（ch230）"><data key="name">『维度』的长用进化→『次元决战演算『先谭』』（ch230）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波在达利尔长时间于同一场所使用『维度』，其展开效果实现进化，升级为更高水准的次元魔术『次元决战演算『先谭』』——效果为未来视：'这个以未来视为效果的魔法──告诉我诺瓦露根本没有胜利的可能'，只需沿其展示的胜利之路走下去即可取胜；它升级为了更高水准的次元魔术『次元决战演算『先谭』』；这个以未来视为效果的魔法──告诉我诺瓦露根本没有胜利的可能。</data></node>
    <node id="瓦尔德本土北部战场（科斯特/科纳/利维拉/阿尔德纳）"><data key="name">瓦尔德本土北部战场（科斯特/科纳/利维拉/阿尔德纳）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（再演，原设 ch0080；171话原版切片独立证据）四地区＝瓦尔德国北面的科斯特地区、科纳地区＋北面劳拉维亚国的利维拉地区、阿尔德纳地区——观测此四区即覆盖与这场战争相关的所有士兵行动；战场形态：深入后已无法判明南北、不分敌我的双方混战地区、斥候遍地；越近『中心』士兵密度越大（几十人部队稀奇、成百上千人杀阵常见）；散布各地的不少村落冒烟——军队掠夺行为依旧（莱文教温和宗教与魔法技术发达亦不改变战争本质）；我按照地图的显示，顺便确认着地名。瓦尔德国北面的科斯特地区和科纳地区。还有北面的劳拉维亚国的利维拉地区和阿尔德纳地区。通过掌握这四个地区的状况，我得以观测到与这场战争有关的所有士兵的行动。；</data></node>
    <node id="『支配之王』（书籍）"><data key="name">『支配之王』（书籍）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">落在奈落之底洞穴角落的一本书——在'什么都没有'的世界中唯一异物、存在感极强（'正因为这是一个什么都没有的世界，所以孤才会被这名为书的异物吸引'）；扉页目录写着『支配之王』四个字，第一章题名『支配之王的觉醒』；据陌生声音声称'为了搞出那本书可是把命都折了'；翻开后第一章拉开帷幕——既是『支配之王』的英雄谭，也是北方的历史，是王的物语；『这里』什么都没有──本应如此，但在这个什么都没有的地方，自己却看到了一本书。那是一本默默落在这个洞穴角落里的书。；那本书实在是太具有存在感。正因为这是一个什么都没有的世界，所以孤才会被这名为书的异物吸引，向它伸出手。；写在上面的是『支配之王』四个字。</data></node>
    <node id="艾德的'我王'与王之器资质论（据艾德）"><data key="name">艾德的'我王'与王之器资质论（据艾德）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据艾德独白：'现在的她正可谓是这个世界至高的宝石。是有资格暂代我等的『支配之王』的存在'；'王之器就危险了'须加快动作；'所有的魔石都是为了我王而存在的'；'反正对鄙人的计划来说涡波大人本来就不是必要的呢'——王之器=暂代支配之王的器、魔石尽归'我王'、涡波(基督)非计划必需（均为艾德阵营声称）；现在的她正可谓是这个世界至高的宝石。是有资格暂代我等的『支配之王』的存在；毕竟所有的魔石都是为了我王而存在的</data></node>
    <node id="『乐园』"><data key="name">『乐园』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">语义流变三段：①千年前南方传言'在北方的尽头有一座乐园'→魔人移民大量流入北方；②罗德死后将迷宫内佩艾希亚定义为'为了所有人都能幸福而存在的世界……是涡波和孤共同打造的，最后的『乐园』'，同时是'孤的坟墓'——让所有人不留遗憾地死去之地；③罗德自评其空壳化：'这些人基本都是没有了魂的空壳。空有外壳的和平'；[启禀『支配之王』，在向移民打听过之后，据说是因为在现在的南方有一个传言，传言说在北方的尽头有一座乐园]；[『这里』是为了所有人都能幸福而存在的世界……是涡波和孤共同打造的，最后的『乐园』]；因为『这里』不仅仅是『乐园』，同时还是『孤的坟墓』。</data></node>
    <node id="罗德的实力坐标（据涡波评价）"><data key="name">罗德的实力坐标（据涡波评价）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">魔力足以匹敌实力全开的诺文或玛利亚（守护者级怪物）；速度：涡波以次元魔术完全掌握其行动仍无法反应、被瞬间制住双腕（'罗德只是单纯的，在我能做出什么反应之前迅速的行动了'）；魔法为其真正擅长——涡波自评『维度』完成度极高、'地上能对『维度』做到『魔法相杀』的人类一个都没有'，海因使用同样的魔法全力也仅能做到妨碍，罗德却轻描淡写完成相杀；涡波判断'如果罗德是敌人的话，恐怕没有任何胜算吧'；她的魔力十分的庞大。是足以和实力全开的诺文或玛利亚匹敌的巨大魔力。；确实利用了次元魔术，将那个行动完全掌握了。但是，其速度却快到让人无法反应，罗德就这样迅速贴近并制住了我的双腕。；罗德只是单纯的，在我能做出什么反</data></node>
    <node id="『领域』与次元魔术的普遍才能论（据千年魔导书）"><data key="name">『领域』与次元魔术的普遍才能论（据千年魔导书）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据魔导书记载：所有存在'都在自己的内部拥有专属的『领域』'——人是兽、地上之岩石、天边之云彩乃至『世界』本身皆'无一例外'；领域在潜移默化中成为次元魔术的才能，故『次元魔术』'似乎是所有人都拥有的才能'、'任何人只要有心就能习得'（其它属性魔法无才能则终生不可用）；次元魔术即'对这些普遍存在的『领域』进行干涉'——以『领域』为目标伸手是'无法用数字表示的魔法的次元''在常识束缚之外的只有魔力存在的世界'；『次元属性』在现代地上稀奇、千年前却十分普遍；原因是所有的存在都在自己的内部拥有专属的『领域』，而这在潜移默化中就成为了『次元魔术』的才能。；书上甚至还写有这样一番豪言壮语：其它的属性魔法如果</data></node>
    <node id="艾尔芬里斯战力评估（据莱纳+初战实证）"><data key="name">艾尔芬里斯战力评估（据莱纳+初战实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">级别67（黯淡之龙的两倍以上；体型十倍至可能五十倍、凌驾高山远超云海）；深不可测的魔力+风龙属性（空中战斗所向披靡；风魔法使速度与感知均为顶尖）；知性不差通晓战斗策略且无一丝骄气；接触风即被其感知；飞行速度比莱纳快；本场攻防未认真（对人约如甩开小苍蝇的程度）；只把接近空中的东西当做敌人、对落地者无兴趣；级别在黯淡之龙的两倍以上。体型则是十倍──不、搞不好足足有五十倍。；镇守通往六十五层的阶梯的，就是这么一个怪物；先不说只要接触到风的话就会被它感知到，而且它明明是那种体型，飞行的速度却比我还快的呀⋯⋯</data></node>
    <node id="千年后的阿雷亚斯家变质"><data key="name">千年后的阿雷亚斯家变质</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺文所知的阿雷亚斯家与千年后相比脱胎换骨：血脉联系尚在，但家训与剑术风格大相径庭、旧家远比今家优异——『我想要守护的家在千年后的世界里已经不复存在』→绝望与恐怖的孤独感；胜芬里尔时唯一想法=尽快逃离称赞现场；可是两者无论是家训还是剑术风格都大相径庭。；换句话说，我想要守护的『家』，在千年后的世界里已经不复存在了。这让我深感绝望，并受到一阵恐怖的孤独感侵扰。</data></node>
    <node id="归还原世界的方针（ch116）"><data key="name">归还原世界的方针（ch116）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：'就这样继续以迷宫最深部为目标的方针就好。除此之外没有别的办法了'（缇亚同调——对莱文教关系者而言迷宫最深处存在奇迹性'某种东西'为理所当然）；玛利亚提议钻研次元魔术为他策（涡波认可『维度』『连接』有一定可能性）；涡波总方针=信传承探迷宫+锻炼实力+并行收集情报（拟抵大陆本土后拜访大国图书馆与贤者）；'就这样一直留在这个世界里生活'的提案被涡波以妹妹阳滝为由否决；「我觉得就这样继续以迷宫最深部为目标的方针就好。除此之外没有别的办法了」；缇亚也一样点点头。对她们两人来说在迷宫的最深部存在着奇迹性的『某种东西』似乎是理所当然的。；当然，也会同时收集其他手段的情报。我也打算在抵达大陆本</data></node>
    <node id="技能发动的主动意识条件(诈术非万能)"><data key="name">技能发动的主动意识条件(诈术非万能)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">入手『诈术』也不算万能——不主动意识去发动技能的话就基本没什么效果；被动状态存在死角：精通『感应』与『诈术』的涡波（舞闘大会优胜/赌场一日最高水平资产家）完完全全被少女骗到，『不如说不做到那种地步（集中用『感应』观察）根本看不出来』；精通『感应』与『诈术』的我、在舞闘大会获得优胜的我、在这个赌场一天之内就变成最高水平资产家的我完完全全被那个少女骗到了。；看来即使入手了『诈术』也不能算是万能的。；不主动意识去要发动技能的话就基本没什么效果。</data></node>
    <node id="迷宫与系统=相川涡波作品说（ch141）"><data key="name">迷宫与系统=相川涡波作品说（ch141）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波推定：包括『表示』『所有物』等在内的众多系统恐怕都是『相川涡波』开发的东西（'就像那个男人在梦中一脸愉快地开发『魔力变换（LevelUP）』和『变换结果（状态）』一样'）；'甚至就连那座『迷宫』都是『相川涡波』的作品'——故诺文才会对'涡波'这个名字做出那样的反应（据涡波推测）；诺文谈到的某个人物=打造出迷宫的对人类温柔的『某人』'很可能就是我。尽管没有确证，但是从诺文的态度来看，是我的可能性很高'；昔日自以为跟妹妹在一起故未细问——'到了现在看来实在是败笔。我已经失去了再次跟诺文确认的机会了'；恐怕这些都是『相川涡波』开发的东西。就像那个男人在梦中一脸愉快地开发『魔力变换（LevelUP</data></node>
    <node id="迷宫探索队伍编成（第三次·四人·双守护者）"><data key="name">迷宫探索队伍编成（第三次·四人·双守护者）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">第三次探索队伍=相川涡波＋莱纳＋罗德·缇缇＋诺斯菲（诺斯菲点名'涡波大人，罗德，赫勒比勒夏因，然后是我'），含两名守护者、'迄今为止最高的队伍'战力；目标=打倒风龙（艾尔芬里斯）凑装备练魔法、突破迷宫返回地上（罗德口径'到达地上不是那么容易的'）；时间坐标=地下生活第五天·第三次挑战（前日已至六十层）；粮秣=仅单程数日份（雷纳尔多薪水购入收纳入'「所持品」'，对价=带回艾德之约）；出发准备已 于'维艾西亚'完成；「那么，涡波大人，罗德，赫勒比勒夏因，然后是我的队伍吗。但是，如说是这个成员的话⋯⋯呼呼，呼呼呼，稍微有点怀念的感觉呢⋯⋯」；「姆，又是探索迷宫吗？真的是充满想要回去的心呢⋯⋯⋯昨天也</data></node>
    <node id="双重记忆三重并列（缇亚·使徒西斯／涡波·始祖涡波／帕林库洛·勒伽西）"><data key="name">双重记忆三重并列（缇亚·使徒西斯／涡波·始祖涡波／帕林库洛·勒伽西）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：'就像缇亚大人持有『使徒西斯』的记忆。少年你拥有『始祖涡波』的记忆一样，帕林库洛也拥有双重的记忆。就是没有在传承中留下事迹的『第三名使徒勒伽西』的记忆'——记忆持有者×使徒/始祖的三重同构并列；与库内『容器论三重并列（圣人缇娅拉／使徒西斯／始祖）（据海莉）』为不同并列结构（归并留 R4）；「就像缇亚大人持有『使徒西斯』的记忆。少年你拥有『始祖涡波』的记忆一样，帕林库洛也拥有双重的记忆。就是没有在传承中留下事迹的『第三名使徒勒伽西』的记忆」</data></node>
    <node id="『某人』与迷宫的体贴（迷宫建造者知识·ch132回顾+实证）"><data key="name">『某人』与迷宫的体贴（迷宫建造者知识·ch132回顾+实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺文昔日所言：'对人类很体贴的『某人』，用不合风格的做法打造出了迷宫'——因规则限制到最后也未告知『某人』是谁，但从其说辞看来打造迷宫的人确实存在；本章35层空气横穴被涡波推定为其为探索者准备的休息点（新实证）；诺文所保障：迷宫最深处有强大力量『奇迹』存在；'打造迷宫的人很体贴，迷宫本身也很体贴。越是在迷宫中前进探索者就越强'；涡波态度——『某人』是谁都无所谓、现在重要的只有诺文所保障之事；虽然也能因为这是异世界的迷宫之类的理由勉强自己接受。但是，从过去诺文所说的话来看，这个『某人』的存在是可以确信的。那时候，诺文说过「对人类很体贴的『某人』，用不合风格的做法打造出了迷宫」；虽然因为规则的限</data></node>
    <node id="泪洸（TearRay）天候"><data key="name">泪洸（TearRay）天候</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾尔芬里斯消亡时『覆盖天际的巨体渐渐透明化，转换成了光芒』，『光之雨淅淅沥沥地降注在辽阔的草原上』——『仅仅一头艾尔芬里斯的消亡，就造就了泪洸（TearRay）的天候。级别达到60的怪物魔力密度有多高一目了然』；光之雨淅淅沥沥地降注在辽阔的草原上。；仅仅一头艾尔芬里斯的消亡，就造就了泪洸（TearRay）的天候。级别达到60的怪物魔力密度有多高一目了然。</data></node>
    <node id="联合国的一夫多妻制（ch115再证）"><data key="name">联合国的一夫多妻制（ch115再证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕：联合国里不少国家行一夫多妻制、'特别是富商和贵族当中尤其普遍'（ch69 同源设定再证）；涡波以'现代日本是不认可一夫多妻的，我是日本人'为由拒否，自陈憧憬'一流剧情里那种纯爱'、无恋爱经历；在联合国里有不少一夫多妻制的国家呢。特别是富商和贵族当中尤其普遍哦？；现代日本是不认可一夫多妻的，我是日本人。有坚决拒绝的理由。；明明如此，我才不要在连一次正经的恋爱都没谈过的情况下，就走进披着后宫外皮的坟墓呢！</data></node>
    <node id="荣光的诅咒性(英雄幻影论·诺文版)"><data key="name">荣光的诅咒性(英雄幻影论·诺文版)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">荣光=一旦入手便永远纠缠在身之物（近乎诅咒）：接近英雄后迎来的是贵族派阀钻营/勋章爵位人生设计/眼神死的应对——涡波与斯诺先于诺文领会（舞会体验）故忌讳英雄；斯诺因此想把英雄身份推给他人承担；诺文自认追寻的是虚无缥缈的幻影；可是现实并没有如此甜蜜。而想要从那份『荣光』的阴翳下逃走又是不可能的。它是一旦入手便会永远纠缠在身的东西。；斯诺肯定也是知道的。所以她才想将『英雄』的身份强推给他人承担。</data></node>
    <node id="想起（Flashback）机制"><data key="name">想起（Flashback）机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波经由LevelUP使魂接近曾经的始祖涡波时发生的记忆回想现象——'是获得魔力的『次元之理的盗窃者』的魔石，取回了原本的力量的现象'；发作兆：'像是头上起了静电一样，我感到一股微痛'，记忆'一点一点地'回想；涡波'我的本能将如何最大限度地去活用这一现象的方法告诉了我'→就寝沉入最适合整理记忆的场所；──像是头上起了静电一样，我感到一股微痛。；这是每次经由LevelUP让我的魂接近曾经的始祖涡波时就会发生的想起（Flashback）。；是获得魔力的『次元之理的盗窃者』的魔石，取回了原本的力量的现象。</data></node>
    <node id="组队经验值分配常识"><data key="name">组队经验值分配常识</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">组队讨伐经验值平均分配（募集同伴告示亦载分配惯例）；主角立『对半分』铁则以避纷争；虽然是缇亚结果了敌人，但经验值却是平均分配的。</data></node>
    <node id="『支配之王（Lord）』传说"><data key="name">『支配之王（Lord）』传说</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">比千年前世界更久远时代的传说：大陆北方家喻户晓的英雄谭（'很久很久以前'开头），主人公为翼人之王——'支配这片大陆的翼人之王！继承最悠久的魔血的末裔，将此世上的一切纳入支配之下的王、罗德（Lord）'；英雄谭将其人生擅自分章（支配之王的觉醒/孤儿院篇/佩艾希亚防卫篇/北方夺还篇等），对和平日常一笔带过、只重战斗；真实来历=孤（缇缇）借传说之名行复仇之事的家家酒，'打着自己是支配之王的幌·子'；称号不并入罗德本名（永不合并）；它讲述的是一个将比千年前的世界还要久远时代的传说——『支配之王（Lord）』的故事化作了现实的少女的物语。；[——『孤』乃是支配这片大陆的翼人之王！继承最悠久的魔血的末裔，</data></node>
    <node id="LevelUP/BonusPoint系统本质与制定者（ch179自认）"><data key="name">LevelUP/BonusPoint系统本质与制定者（ch179自认）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">升级时获得BonusPoint与技能Point各一点（本章实录）；系统本质据涡波推断=通过对『魔力变换（LevelUP）』的应用，作成可将余剩魔力随机应变地补足到任何方面的机制——'绝对是我个人兴趣暴走下的产物'；打造者=涡波自己（据其在『世界奉还阵』中看到的过去记忆，本人自认）；级别解锁条件：莱纳会使用神圣魔法，否则两人'连级别都会被锁死'（据涡波）；点数可分配至『魔力』『次元魔术』等能力项；「BonusPoint」获得了一点BonusPoint。；在『世界奉还阵』中看到过去的记忆之后，我已经明白打造出这个系统的人就是我自己了。；想来这个系统的本质应该是通过对『魔力变换（LevelUP）』的</data></node>
    <node id="千年前史料改篡构造（ch220）"><data key="name">千年前史料改篡构造（ch220）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">现存历史记录皆为千年前『世界奉还阵』一战取胜后、为『始祖涡波』『圣人缇娅拉』『使徒勒伽西』『火之理的盗窃者阿尔缇』四方有利而改篡的内容（据涡波判读）；九成历史事记自始无迫害魔人记录（相关事件当做不曾发生处理）；不对一般人提供的资料（凭塞拉介绍信获浏览权）亦与活证据缇缇的表述出入甚大；通说=『圣人缇娅拉』和同伴打倒反派『支配之王』；缇缇自认千年前支配之王曾对国家历史动过各种手脚（据本人）；而且人家当初就对国家的历史动过各种各样的手脚的说。；如此这般，既然出自千年前的支配之王本人之口，那这话确实有相当的说服力。；到了图书馆之后，虽然我利用『维度』尽可能地找出了与千年前有关的资料，但内容全都谈不上正</data></node>
    <node id="诅咒魔法的代价与衰退史"><data key="name">诅咒魔法的代价与衰退史</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据图书馆诅咒书：远古盛行诅咒类魔法→圣人缇亚拉构建魔法基础后走向荒废（代价：不仅耗MP还削HP/损害身体/削减寿命/致病/失败即殒命/常招反噬——双刃剑）；人们自然排斥之；据上面说，在遥远的过去盛行许多『诅咒』类的魔法。不过在圣人缇亚拉这么一个人物构建出魔法的基础后，诅咒这一类的魔法似乎就走向了荒废。；如果这个说明是正确的话，那么『慕影死神』的术者是我，而对象则是诺文。也就是说，『慕影死神』是不仅会杀死诺文，同时还是有可能杀死我的『诅咒』。</data></node>
    <node id="精神魔法控制与解除窗口"><data key="name">精神魔法控制与解除窗口</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉受从诞生起持续施加的精神魔法控制（术式镌刻血肉——缇亚断言非简单解咒可除）；弗茨亚茨不会把带轻生精神魔法的身体原封转交伟人→仪式开始前桎梏会被解除=营救唯一窗口；对神圣魔法有造诣的缇亚的判断；施加在她身上的应该是牢牢镌刻于血肉之中的高级魔法术式。</data></node>
    <node id="『置换』"><data key="name">『置换』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波命名的新现象：缇亚的魔力如血液循环般脉动转换——'无论既经多少替换，缇亚魔力的质依旧未发生改变。尽管不曾改变──但发生了替换是货真价实的'；完成后人格由缇亚切换为西斯（脸庞不变、表情/造句遣词/举手投足/眼神全异）；与舞闘大会那时的剧变不同、似恶灵凭依而实非；置换后西斯与缇亚共同拥有身体；涡波以'就像千年前的『圣人缇娅拉』使用拉丝缇娅拉的身体要进行『再诞』一样，千年前的『使徒西斯』也利用缇亚的身体复活了'类比（'只能这么想'，推断级）；面前的存在不是缇亚这一事实已经无需怀疑。甚至跟舞闘大会那时的剧变都不同。这是该称作『置换』的现象。；缇亚的魔力咕咚咕咚地开始脉动。魔力开始了转换，就像血液循</data></node>
    <node id="『辉腕』（非实体右手）"><data key="name">『辉腕』（非实体右手）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">置换后于缇亚本已失去的右臂前端生出的光辉夺目非实体右手：表面浮现几何学纹样，『维度』细察判明为'高密度的魔法阵组成了手臂的形状'；活动灵活如活物；受缇亚体内『技能』抵抗影响曾扭曲趋于解除，经西斯对缇亚宣誓让步后安定，但'跟一开始相比，还是稀薄了些'；接着缇亚本已失去的手臂前方便生出光辉夺目的非实体右手。；那只辉腕就像活的一样富有生气、灵活自如。但是定睛一看，会发现手臂上浮现着几何学的纹样。使用『维度』仔细观察，我明白了那是用高密度的魔法阵组成了手臂的形状。；西斯的光之手产生了扭曲。</data></node>
    <node id="状态异常体系"><data key="name">状态异常体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">已见状态异常：混乱（补正递增）/精神污染/黑暗（习惯剥夺）/部位麻痹/出血/昂扬（战斗狂化技巧劣化）/沉默（夺言语）/恐惧/加护——精神系异常可经技能『？？？』部分解除；缇达为状态异常中心战斗型；状态：混乱5.30精神污染2.00黑暗1.00部位麻痹1.00出血0.31</data></node>
    <node id="魔王军近卫骑士团长传说（『这里』兽人间）"><data key="name">魔王军近卫骑士团长传说（『这里』兽人间）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德当众宣称：'他就是我们魔王军的近卫骑士团长涡涡''涡涡毫无疑问是最强的『魔人』哦'；兽人间流传其传说（'果然是本尊啊！传说中的那个！''不是说是假面骑士来着么'——本尊'什么都没戴'）；但'『这里』很和平所以也不需要什么骑士团长了'；「嗯，他就是我们魔王军的近卫骑士团长涡涡！」；「你再好~好的感受一下。涡涡毫无疑问是最强的『魔人』哦。」；怎么什么都没戴啊，不是说是假面骑士来着么</data></node>
    <node id="诺斯菲的『诅咒』（与莉帕对照）"><data key="name">诺斯菲的『诅咒』（与莉帕对照）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲自述：『诅咒』为其生前拥有之物，本以为死过一次已净化，实则仍留残渣（握手时应激莱纳，其发誓不再让残渣浮上表面）；另自陈『全赖于『诅咒』的解除，我才能体验到如此新鲜的感觉（能与人握手）』即诅咒本体已解除；涡波旁白比照莉帕『在被认知到的期间内无法作为实体存在』（解除条件『诺文的死亡』）推测其解除条件为『自身的死亡』（反推，未证实）；诅咒具体内容本章未明；「非、非常抱歉。我原本以为自己身上的『诅咒』已经完全消失了，但似乎还留着一些残渣的样子。我绝对没有加害你的意思。请务必要相信我⋯⋯！」；「是的，是我生前拥有的东西。本以为死过一次之后就已经得到净化了，但看来并非如此。；「呵呵。全赖于『诅咒』</data></node>
    <node id="『暗之理的盗窃者』的半死体与完死体"><data key="name">『暗之理的盗窃者』的半死体与完死体</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">半死体：自残泄出紫色魔力反而增加魔力、黑液包裹全身（血由红转黑）、断面接合再生（右臂/双眼复元但眼球全黑）——姿态接近曾与涡波交战的守护者（缇达型）；弱点=冰结——冻结断面即无法再生（『如果他的身体跟缇达一样的话』）；物理斩击无效（断面瞬间接合，『就跟我用剑斩过瀑布一样』）；对策论：连破『地之理的盗窃者』绝对防御的共鸣魔法『致亲爱的一闪』对本场合恐怕无效，唯有连续冰结魔法。完死体：自碎心脏后为『彻底的尸体』——『注视』上Status乱码（na■nk帕林■理的■伽西HP■/5■2MP—-—/39-职lass），数据变换为Monster：二十守护者（TwentyGuardian）暗之理的盗窃者，『</data></node>
    <node id="联合国（地上国家）"><data key="name">联合国（地上国家）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波向雷纳尔多介绍：'现在在迷宫上面有着叫联合国的规模庞大的国家。在那里有许多的探索者、不对是探索者的存在，所以我想技能高超的锻冶师应该是非常吃香的哦'——支撑其邀雷纳尔多地上开锻冶屋（'我会介绍熟人的工房给您的'）的依据；「现在在迷宫上面有着叫联合国的规模庞大的国家。在那里有许多的探索者、不对是探索者的存在，所以我想技能高超的锻冶师应该是非常吃香的哦。然后呢⋯⋯──」</data></node>
    <node id="罗德的咏唱与代价支付（ch191）"><data key="name">罗德的咏唱与代价支付（ch191）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玉座后反复吟咏『我无法抉择行进之路』『我乃风』『妾身之灵魂将得以加速』——无魔法行使、翠色魔力丝毫不增，却'确实在支付着某种『代价』'＝'只有舍而没有得的行为'；罗德自比'能够让心情变轻松的诅咒（咒术）'；代价的性质与去向未明；「『我无法抉择行进之路』『我乃风』──、以及『妾身之灵魂将得以加速』『得以加速』『得以加速』、『得以加速』──⋯⋯」；但是，不仅没有在行使什么魔法，她那翠色的魔力也丝毫没有增加。然而经由这份『咏唱』，她确实在支付着某种『代价』；「嗯，没事的⋯⋯这就跟能够让心情变轻松的诅咒（咒术）那类东西差不多⋯⋯」</data></node>
    <node id="迷宫阶层生态（1-5层）"><data key="name">迷宫阶层生态（1-5层）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一层昆虫系居多+植被区（森之女王域）；三层湖泊河流多、水栖类出现率高（飞鱼）；五层氛围阴晦（爪瑙蝎等）；特殊区域在层深处；30岁娴熟探索者约10级上下=一层至五层的普通探索水准；三十岁左右的娴熟探索者的级别大抵也不过10级上下</data></node>
    <node id="『表示』状态异常栏与『烂醉』检测（ch214）"><data key="name">『表示』状态异常栏与『烂醉』检测（ch214）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">基督的防醉预案：'更何况我还有『表示』可用。一旦在状态异常栏上看到了『烂醉』一项，那我悬崖勒马便是。预防措施可谓万无一失'——『表示』状态异常栏可显示『烂醉』项的运用例（句末译注（流星：…）点破其滞后性，属元文本不入档）；更何况我还有『表示』可用。一旦在状态异常栏上看到了『烂醉』一项，那我悬崖勒马便是。预防措施可谓万无一失。</data></node>
    <node id="光魔法原理(『交流』属性)"><data key="name">光魔法原理(『交流』属性)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲（光属性专家/迷宫镇守者）说明+实战验证：光魔法立足『交流』而非『争斗』（『光之理』的理想）；与暗魔法最大不同=无法强制改变他人内心，须彼此心意相通、得到互相认可后方可对特定感情进行缓和；对纯粹遵循本能的野兽以『继续战斗就会被杀』的威慑打消斗志——本质依赖施术者压倒性魔力（除她外恐无人能以光打消LizardFlyer的斗志）；依我方态度仍可能再开战（勿刺激/以观光心情前进最安全）；『Light』不受对手级别和魔力影响、但为敌我相性左右（对不畏死的狮鹫兽无效）；光属性怪物一般不对其他生物采取敌对行动（六十层附近无需攻略/至五十五层可如散步通过；五十层附近怪物属性转变）；但是，与暗魔法不同</data></node>
    <node id="位阶与素质论"><data key="name">位阶与素质论</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">怪物『位阶』（Rank）≈『足够与之交战的等级』（Level）；等级之外『素质』决定成长速度——素质不足者（玛利亚1.52/格连）等级越高与规格外者（涡波7.00/缇亚5.00/拉丝缇娅拉4.00）差距越大；『数值无法表现的数值』高者（拉古涅）另当别论；我发现所谓『位阶』（Rank）的意思差不多相当于「足够与之交战的等级（Level）」。</data></node>
    <node id="始祖涡波记忆复苏机制（ch189实录）"><data key="name">始祖涡波记忆复苏机制（ch189实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">因使徒勒伽西之故未能继承给涡波的始祖涡波记忆，随蕴藏在身的『魔力』不断增加而逐渐修复——归还的记忆如自水底上翻的泡沫接连涌现；睡眠梦境为整理与复苏场所（此前已做过同样的整理之梦）；可从记忆群中遵从本能选看『与现在的我因缘最深』者；外部刺激可中断记忆变换；因为使徒勒伽西的缘故而没能继承的始祖涡波的记忆的碎片纷纷复苏。；毋庸置疑，随着蕴藏在身的『魔力』不断增加，我的记忆也会逐渐修复。</data></node>
    <node id="魔法道具修复与魔术式铭刻工艺（据雷纳尔多传授）"><data key="name">魔法道具修复与魔术式铭刻工艺（据雷纳尔多传授）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">修复分两层：外形重接（'只是外形的话，很轻易就能修复回原状'）不等于取回强度（'光是外形恢复并不能取回它们原来的强度'，故一般武器防具'用壊即丢，修复起来并不划算'）；取回力量须『神铁锻冶』级工艺——将术式文字刻回复原装备、铭刻魔术式以激发魔石之力，精密性要求'达到了超人的级别'；含魔石/魔术式的装备修复需专用道具（与修纯铁制品做法大不同）；结婚礼装戒指可改造为MP储存具（存入多余回复魔力）；但光是外形恢复并不能取回它们原来的强度。；也就是将魔术式铭刻到修好的武器和防具上，将魔石的力量予以最大限度的激发。；「因为这些装备使用了魔石啊。其中不乏刻有魔术式的东西。如果要连同这些一起修复的话，就必须</data></node>
    <node id="弗茨亚茨大圣堂地下（ch220）"><data key="name">弗茨亚茨大圣堂地下（ch220）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">大圣堂地下设数重结界与一重重被封锁的门扉构成的信道（最低限度照明、无恶臭、较迷宫回廊整洁）；回廊尽头最厚重门扉内=大圣堂最坚固结界庇护的石造房间（光照唯一一根蜡烛、仅中央一张床铺、别无他物）——藏匿已逝少女之处；信道令莱纳既视感、心神不宁；拉丝缇娅拉当前计划在此说明（防涡波次元魔术窃听）；这里是弗茨亚茨大圣堂的地下。；在抵达这里的路上，我们穿过了一重又一重的结界，推开了一道又一道被封锁的门扉。；随着设置在回廊尽头的最为厚重的门扉被推开，我们走进了在大圣堂最坚固结界庇护之下的房间。</data></node>
    <node id="地之理的盗窃者之理(矿物不伤)"><data key="name">地之理的盗窃者之理(矿物不伤)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">怪物化诺文的绝对防御：全身水晶铠甲下【不会被世界上任何一种矿物所伤】之『理』（涡波假说·感应支撑）——冰结剑/振动解放（冰结剑·冲击）/世界冰蛇/会心斩击全部无效（伤害值恒0）；弱点唯有超越理的一闪（致亲爱的一闪）；虽然没什么根据，但『地之理的盗窃者』恐怕【不会被世界上任何一种矿物所伤】。这就是这个世界的『理』。；作为诺文的——不对，应该是作为人类的强大消失了。</data></node>
    <node id="无魔力无思考涡波更强论"><data key="name">无魔力无思考涡波更强论</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉分析：平时涡波的浪费清单（考虑琐碎耗MP/对能力保留/动态视力反射神经白费/执着耍帅用剑/怜悯敌人/完美主义消极）在无思考态全部消失——只余『守护手环』单一想法+反射判断+适当运用见识过的技巧；闭眼第六感全回避光箭雨+岩石冲袭；「这、这什么情况……难道说，不依赖次元魔法，没有了多余考虑的涡波更强么……？」；他·闭·上·眼·睛，在什么也看不到的情况下将雨点般的攻击尽数躲了过去。在第六感的引导下，涡波在这样的阵势中甚至连擦伤都没受。</data></node>
    <node id="魔王城与城邑的漂浮地理（ch84）"><data key="name">魔王城与城邑的漂浮地理（ch84）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">古堡外貌圆锥状、内含森林一般广大的庭院；被大河环绕（规模大到令涡波想起劳拉维亚的法芙拉河），仅一座桥连接城外（进攻唯有走桥）；河外围城邑辽阔至地平线、人潮如织、可确信是繁荣国家；但城邑之外：一片漆黑的天空＋地平线附近被截断的大地＋平原海洋皆无的一片虚无——看起来就像城堡和整座城市正在一片黑暗中漂浮；此即涡波被世界奉还阵吞没后抵达的『第三种可能性』之地；『魔王城』之名出自『涡涡命名』（因为是支配着魔人们的王）——命名者指现涡波或始祖涡波待确认；是条大到足以令我想起劳拉维亚的法芙拉河的河流；在那里的是一片漆黑的天空，以及地平线附近被·截·断的大地。；看起来就像是这座城堡和整座城市正在一片黑暗中漂浮</data></node>
    <node id="柯尔库战线对斯诺的战力依赖（据克洛伊声称）"><data key="name">柯尔库战线对斯诺的战力依赖（据克洛伊声称）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据克洛伊拦阻时声称：『境界战争』海战均势基本依靠斯诺之力维持；斯诺若离开→『北方同盟』将趁机进攻/各种方面平衡被打破/'斯诺大人的力量对这里而言是绝对必要的'；现在『境界战争』的海战那边也基本都是依靠斯诺大人的力量才能保持均势的哦</data></node>
    <node id="魔王城后方的花田"><data key="name">魔王城后方的花田</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">以面积巨大为特点的魔王城后方、'在城堡和街道之外的场所'的空间：'各种各样的花尽情绽放'，微风拂花；贝丝白日在此发呆眺花（雷纳尔多闻之若有所思但拒绝带回）；夜里诺斯菲独自在此'一个人抱着腿望天'——本章初披露的新场所；在以面积巨大为特点的魔王城后方，想不到会有一个各种各样的花尽情绽放的空间。；而诺斯菲则待在先前贝丝酱所在的花田里，一个人抱着腿望天。</data></node>
    <node id="阳滝非血缘妹妹论（据海莉声称）"><data key="name">阳滝非血缘妹妹论（据海莉声称）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：'那个叫阳滝的女孩子，并不是身为魔石人类的少年你真正的妹妹'（无血缘）——故质问其执念意义，并称'少年心中抱有的对相川阳滝的思念是假货'；涡波回应：救助不需血缘、对阳滝心意'尽管一开始可能是假的，但是现在已经变成真的了'（未接受为前提变更）；「所以说，你在那儿为了阳滝为了阳滝为了阳滝个什么劲儿啊！我不是说了那个叫阳滝的女孩子，并不是身为魔石人类的少年你真正的妹妹了不是吗！？；「你说的不对哦，海莉。尽管一开始可能是假的，但是现在已经变成真的了啊。就像我想去救缇亚一样，对阳滝这个女孩子的心意也绝无虚假。</data></node>
    <node id="DarkCloth强化五匹怪物名录"><data key="name">DarkCloth强化五匹怪物名录</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">木躯的双头犬ツリーダイダス／飞在空中的大型蜥蜴リザードフライ／雕首的巨人ピッドジャイアント／独眼并长有两对翅膀的蝙蝠ムーンレスフォウ／内部空荡却活动自如的铠甲アンコンケラブル——皆级别30上下、经帕林库洛暗系强化魔法DarkCloth黑铠强化（实力不明）；怪物『状态』不显示（涡波以『表示』读名字级别）；此处非迷宫、怪物死后不立刻化光消失；木躯的双头犬，ツリーダイダス。飞在空中的大型蜥蜴，リザードフライ。雕首的巨人，ピッドジャイアント。独眼并长有两对翅膀的蝙蝠，ムーンレスフォウ。内部空荡却活动自如的铠甲，アンコンケラブル；只不过怪物们的『状态』跟人类不一样不会显示出来。；这里不是迷宫。因此怪物们</data></node>
    <node id="涡波状态快照与诈术夺取(ch0109)"><data key="name">涡波状态快照与诈术夺取(ch0109)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">先天技能：剑术4.89 冻结魔法2.58＋1.10；后天技能：体术1.56 次元魔术5.25＋0.10 感应3.56 并列思考1.46 编织1.07 诈术1.02(牌局中初得)→1.34(终局)；『我终于夺尽了男人的「诈术1.33」，并到达了「诈术1.34」』——技能等级夺取实证（『这样便进一步得到了状态上的参数的保障』）；涡波：『只要有意识地去学，没有我得不到的技能』（称'和诺文说的一样'）；先天技能：剑术4.89冻结魔法2.58＋1.10；后天技能：体术1.56次元魔术5.25＋0.10感应3.56并列思考1.46；编织1.07诈术1.02</data></node>
    <node id="守护者与阶层环境的共通性（光之理推测）"><data key="name">守护者与阶层环境的共通性（光之理推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据基督×莱纳对谈（推测口径）：60层守护者'恐怕就是『光之理的盗窃者』'（呼应61-62层的强光）；先例——'接近『木之理的盗窃者』艾德的阶层的时候，也尽是有自然气息的地方'→'应该是守护者的力量对周围的阶层产生了影响吧'；守护者未必特化自身魔法类型——'像诺文和缇达那样，守护者与自身的魔法无关依旧实力强劲的场合也不是没有'（基督希望保持完全状态接触）；「是啊，说来接近『木之理的盗窃者』艾德的阶层的时候，也尽是有自然气息的地方啊。；「应该是守护者的力量对周围的阶层产生了影响吧。；不过，像诺文和缇达那样，守护者与自身的魔法无关依旧实力强劲的场合也不是没有。</data></node>
    <node id="同伴自抑魔法解除因果链（据涡波回顾）"><data key="name">同伴自抑魔法解除因果链（据涡波回顾）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇亚与拉丝缇娅拉曾各自对自身施加魔法（缇亚=抑制西斯；拉丝缇娅拉=抑制自己的恋心），被艾德回复状态异常的魔法一并解除→两人崩壊、'我重要的伙伴变成了『使徒』'；拉丝缇娅拉或另有被解魔法（涡波未打听、'估计跟圣人缇娅拉有关联'）；涡波对'不是相川涡波'的指摘靠演技糊弄（原文自纠正：'在海莉──不对是在海因的面前'）；缇亚抑制西斯的魔法被解除，拉丝缇娅拉抑制自己的恋心的魔法也一样。；结果却被艾德那回复状态异常的魔法给解除了。；拉丝缇娅拉那边，搞不好被解除的还有其他类的魔法。因为当时早已没有了余裕所以我没有打听，不过估计跟圣人缇娅拉有关联。</data></node>
    <node id="涡波的无魔力战斗运用(赌技)"><data key="name">涡波的无魔力战斗运用(赌技)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">禁魔环境下的替代战法：『我不使用任何魔力，挑战胜负』——肉眼动态视力+运动能量/速度/假定移动距离计算，由次元魔术经验、状态参数『技术』『贤明』与技能『并列思考』支撑，理论预测内以『感应』微调；对人对局记忆对方言行/感情/习惯/视线移动持续预测下一手（自比『舞闘大会』对『天上的七骑士』一战要领）；Dimension 不可用时不补肌肉运用把握，但『感应』仍可掌控局面走势；我不使用任何魔力，挑战胜负。；操纵次元魔术的经验、状态中『技术』『贤明』的参数、技能『并列思考』使之成为可能。；这和『舞闘大会』时的比赛也有相似之处。我以与『天上的七骑士』那一战相同的要领记忆着敌人的动向。</data></node>
    <node id="魔石人类的统合论争（不可能论vs未可断定论）"><data key="name">魔石人类的统合论争（不可能论vs未可断定论）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据海莉：'两个人统合在一起什么的，是不可能做到的！我就没能做到啊'（以自身失败为证）；涡波反驳'把话说死还太早了。还没有人能断定'，并方针化——助阳滝后让始祖涡波归还身体、与其交涉统合（'让他让步'）；辅证=缇亚疑似正与使徒持续对话且未放弃；两个人统合在一起什么的，是不可能做到的！我就没能做到啊！！」；「不，把话说死还太早了。还没有人能断定。；等成功帮助了阳滝之后，我是打算让他把身体还给我的哦</data></node>
    <node id="守护者魔石的价值重证(弗茨亚茨上层执念)"><data key="name">守护者魔石的价值重证(弗茨亚茨上层执念)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">弗茨亚茨上层红了眼地想要入手守护者魔石；守护者魔石的确有着与其相符的价值——只要看到帕林库洛和玛利亚状态值的变化就一目了然（据涡波视点，本章重证 ch0062 同型事实）；弗茨亚茨上层红了眼地想要入手的守护者魔石。而守护者魔石的确有着与其相符的价值。；只要看到帕林库洛和玛利亚状态值的变化就一目了然。</data></node>
    <node id="五国联合国"><data key="name">五国联合国</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">信奉同一宗教的五个国家依教诲围绕巨大『迷宫』组成联合国进行攻略；据宗教传承，跨越试练抵达最深部第一百层可『实现任何愿望』（看板记载；主角觉通关条件充满人为信息）；组成联合国进行攻略</data></node>
    <node id="四人共鸣魔法的实战代价（ch126）"><data key="name">四人共鸣魔法的实战代价（ch126）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波+拉丝缇娅拉+莉帕+塞拉四人经『连接』的共鸣魔法全力发动仅数秒即令全员失去一半以上MP，莉帕积攒的MP基本耗尽——『实在难以经常应用于实战中』；34层BOSS战以此共鸣魔法（冻结魔法）终结；虽然全力使用魔法只有几秒的时间，但是全员仍然失去了一半以上的MP。多亏了莉帕才积攒下来的MP基本上都被消费掉了。；我们四人的共鸣魔法虽然强力，但是实在难以经常应用于实战中。</data></node>
    <node id="法尼亚（玛利亚故乡）"><data key="name">法尼亚（玛利亚故乡）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据玛利亚：其故乡法尼亚别说海、连江河湖泊都很罕见→故玛利亚不会游泳；「是的。我的故乡法尼亚别说海了，就连江河湖泊都很罕见……」</data></node>
    <node id="航程与乘船现状(ch112)"><data key="name">航程与乘船现状(ch112)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">魔石船《LivingLegend》号自古尔亚德港出航驶向本土，摆脱追兵获自由时间；同船同伴含玛利亚/斯诺/拉丝缇娅拉/缇亚/莉帕等，涡波为船上唯一男性；分房后休养《舞斗大会》疲劳；航程一帆风顺但涡波身心透支——其回顾列举疲劳源：与玛利亚/斯诺/拉丝缇娅拉等同伴清算约定、自己的身世揭晓引发的问题、联合国立场难以接受、对敌船迎击中无意间提高名声、迷宫探索坎坷（难以抵达第四十层）；驶向本土的航程可为一帆风顺。；在船这一封闭空间内，只有自己一个男性的憋屈。；让人难以接受的我在联合国的立场。</data></node>
    <node id="缇缇的『理的盗窃者』自称（ch216）"><data key="name">缇缇的『理的盗窃者』自称（ch216）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇缇对涡波所言：「人家是千年前的『理的盗窃者』」（解释莱纳忧其缺乏常识的语境：涡涡是『异邦人』、人家是千年前的『理的盗窃者』）——与既有『光之理的盗窃者』（诺斯菲）称呼线的关系未定，按判例1 不自动合并；「这说明他就是有这么担心咱们啊。毕竟涡涡是『异邦人』，人家是千年前的『理的盗窃者』。在他看来就是如此缺乏常识喽。虽然是主动提出分头行动的，但他心里恐怕是百感交集吧」</data></node>
    <node id="佩艾希亚的真正姿态=北方同盟(战争之世)"><data key="name">佩艾希亚的真正姿态=北方同盟(战争之世)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">御殿被SehrWind轰毁后城市构造变貌：领土规模扩至难以置信（超越国家、成国家群/帝国级），原『世界尽头』般诡异边缘已看不到；一别往常绿色、焦褐色遍布各地，大雨中火种仍未熄灭（正处战争）——『和平的国度佩艾希亚已经消失了』；罗德宣告『这便是「这里」真正的姿态……我等的真相……和孤一起历数罪状吧。就算要再花上一千年』；涡波直觉=千年前被涡波与罗德舍弃的『北方同盟』；和平的国度佩艾希亚已经消失了。；如今存在于『这里』的，是在战争中扩大了领土，而且正处于战争之中的北方诸国。；「这便是『这里』真正的姿态……这才是我等的真相。涡波啊，和孤一起历数罪状吧。就算要再花上一千年……」</data></node>
    <node id="技能？？？反向诱发"><data key="name">技能？？？反向诱发</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">技能『？？？』可被主动诱发：反向加剧不安/恐惧即触发暴走（本章3次实战运用）；其『以一定的感情为交换』的代价结构由此确认；但不视『昂扬』为需消除的负面状态（不消除battle狂化）；那就反过来让不安加剧，借此诱发技能『？？？』便是。</data></node>
    <node id="舞闘大会后逃亡行程与购船计划"><data key="name">舞闘大会后逃亡行程与购船计划</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『舞闘大会』结束后数小时，涡波一行逃离劳拉维亚、目的地南方国家古利亚德；因无法直接出海停步；据拉丝缇娅拉：普通客船会招致源源追兵→提案自购船只；已找到几个人也能开动的特殊船但价格过度；购船目的之一=船内安心设置『连接』利于今后（大部分为其个人兴趣）；赌场筹钱为达成手段；『舞闘大会』结束后，从劳拉维亚逃出来的我们向着南方国家古利亚德前进。；如果像傻瓜一样老实地直接乘普通客船的话，追兵会源源不断地被派出来，拉丝缇娅拉如是说。；这不是什么壊事，能在船内安心设置『连接』的话，对今后也有好处。不过，的确大部分都只是拉丝缇娅拉的个人兴趣罢了。</data></node>
    <node id="吸血种（吸血鬼）"><data key="name">吸血种（吸血鬼）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前吸血种『魔人』对人类掳掠、吸食、操纵乃至破坏国家，世人称之『吸血鬼』；其为不死的存在，杀死方式唯有让同样作为吸血鬼的存在吸食其血液（近似对魂的吸收）；吸血鬼一族已于千年前被歼灭；纯血吸血种今仅存古奈尔一人——魔眼受封印、雾化仅数秒、蝙蝠化反而更弱、无异常怪力、再生力差、无生产眷属与繁殖能力、亦无吸血鬼常见弱点，被同族蔑称『半吊子的劣等种』而受排挤；其体质近似不老不死；在那个时代中，吸血种的『魔人』犯下的不人道的行径在各种各样的场所可谓是劣迹斑斑。；对人类进行掳掠、吸食、操纵、甚至破壊国家的存在──世人称呼这一群体为『吸血鬼』；说得清楚一点，就是因为将不死的吸血鬼杀死的方式是让同样作为吸血</data></node>
    <node id="诺斯菲的『诅咒』(先天咒术式)"><data key="name">诺斯菲的『诅咒』(先天咒术式)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲生前因身体被先天植入某咒术式，处于常时向周围散布『咒术』的状态：带『魅惑』力量的光（曾以此统率南方的士兵）；对实力强悍者无效（涡波/罗德可将光完全无效化、莱纳亦不受影响）；成为守护者的过程中得到一定净化（罗德证实昔日『刺眼的圆光』已消失、二人同得解放），但自称仍留有残渣（与莱纳握手引发其过剩反应）；涡波类比莉帕诅咒（内容『在被认知到的期间内无法作为实体存在』/解除条件『诺文的死亡』）推测诺斯菲的解除条件为『自身的死亡』；……生前的我，因为身体被先天植入了某个咒术式，所以处于一种时常向周围散布某种『咒术』的状态。；是带有『魅惑』力量的光。我就是依靠这道光统率南方的士兵们的。；对实力强悍的人</data></node>
    <node id="佩艾希亚的创造目的与千年崩坏（据雷纳尔多揭示）"><data key="name">佩艾希亚的创造目的与千年崩坏（据雷纳尔多揭示）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据[雷纳尔多]声称：千年前『始祖涡波』打造迷宫时为向罗德致谢，专门为她打造'可以实现所有愿望的空间'=『佩艾希亚获得和平安宁的世界』；其真实机能是消耗罗德的『魂』——按预定百年罗德即应消失；最初一百年察觉罗德的留恋并非'佩艾希亚的和平与安宁'；两百年世界开始崩溃、三百年人的魂开始毁壊、五百年左右一切都疯了；城与人（无论人还是物）从大陆的记忆经『想起收束（Drop）』打造，魂已消磨殆尽连原型都不剩，唯罗德的『魂』'结实过头'完整保留记忆；空间对千年前的怨念有处置机能（所有人互相原谅）却独无法终结罗德。据[涡波]自认：打造出这个空间的恐怕就是自己；「『这里』是小子你为了罗德而创造的空间。因此，『这</data></node>
    <node id="迪亚布罗·西斯（缇亚）先天技能栏（ch70快照）"><data key="name">迪亚布罗·西斯（缇亚）先天技能栏（ch70快照）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">Lv14/15/16三次状态栏快照：神圣魔法3.81／神之加护3.08（状态栏另示'加护1.00'）／断罪2.00／集中收束2.05→2.06／属性魔法2.10／过捕护2.45→2.20／续命2.24／良机2.03；后天剑术0.11；另有掩码行『？？？？？？』；对比注：拉丝缇娅拉先天亦有神圣魔法1.03——涡波怼语'你要这么说的话，缇亚也能用神圣魔法不是嘛'；状态：加护1.00；神圣魔法3.81神之加护3.08断罪2.00集中收束2.05；属性魔法2.10过捕护2.45续命2.24良机2.03</data></node>
    <node id="魔石人类的寿命机制（体内魔石折损）"><data key="name">魔石人类的寿命机制（体内魔石折损）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据露洁声称：魔石人类参战会减少体内魔石、即折损寿命（'还是说，莱纳君想让柔弱的我们早点死掉么？'）；据莱纳：露洁诺瓦露'不久于人世'；二人非双胞胎、系相似『素体』分别制成。；「因为嘛～、要是露洁我们去战斗的话，体内的魔石会减少的呀～。还是说，莱纳君想让柔弱的我们早点死掉么？」；「不是什么双胞胎。只是制造她们的『素体』相似罢了」；「你不用记住她们的样子也无所谓。反正都是不久于人世的人。这样对你来说更好」</data></node>
    <node id="『水之理的盗窃者』真髓＝冻结的极致"><data key="name">『水之理的盗窃者』真髓＝冻结的极致</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">冷气中寄宿『水之理』＝「停止世界的流动」之理：流动液体全遭冻结、冷酷得足以将生命脉动一并停止；『冰结剑』一击冻结的不仅是物质——连同空间与时间、甚至魔力都被冻住；修复不能（帕林库洛'已经不是无法修复的程度了。『魔力』根本无法运转'）。世界法则：状态的构成基础是『魔力』、魔法构筑也靠『魔力』实现，魔力被封印则身体能力甚至不如小孩子；这冷气当中寄宿着『水之理』。亦即「停止世界的流动」之理。；连同物质之外的、空间与时间，甚至还有魔力都被冻住了。这就是『水之理的盗窃者』的真髓──冻结的极致。；状态的构成基础就是『魔力』。魔法的构筑也要『魔力』来实现。如果连魔力都被封印的话，那么身体能力甚至都不如小孩子</data></node>
    <node id="神圣魔法与火焰的连携破击（缇亚×玛利亚）"><data key="name">神圣魔法与火焰的连携破击（缇亚×玛利亚）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">二连破击档案：第一击＝缇亚『Sion』（光削弱敌魔法威力）+玛利亚『炎之剑』（火焰一刀两断）；第二击＝玛利亚『Flame・决战演算』打造火炎道路+缇亚『炎之矢』经路射出（'因为她们有手下留情，所以射出的不是光线，依然保留了火的形式'）——与流汗释放的双子相反二人'一脸轻松'，火焰轻而易举贯穿魔力聚合体、仅余波即吹飞露洁诺瓦露；玛利亚打造出火炎的道路，缇亚的炎之箭则经由这条道路射出。；火焰魔法仍然轻而易举地就贯穿了魔力聚合体，只靠火焰爆炸的余波就将露洁和诺瓦露吹飞了。</data></node>
    <node id="缇亚的名字谱系"><data key="name">缇亚的名字谱系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">无名诞生（母视其为恶魔拒赋名）→五岁奇迹后依村传说被冠『西斯』（使徒西斯：天降神使与英雄结婚子孙为村民）→被唤作恶魔（迪亚布罗）+使徒（西斯）双源并称→叛逃后自取少年名『缇亚』→自称『我（俺）』（少年）与『我（私）』（原少女/关键誓言时回归）切换——『表示』显示其名为迪亚布罗·西斯（ch0004 未来名之谜）；既被唤作恶魔（迪亚布罗），又被唤作使徒（西斯）的『我（私）』的人生，可谓是滑稽不堪。</data></node>
    <node id="试练"><data key="name">试练</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者的『试练』：本章据诺斯菲称罗德正为之准备、为合计第五次（涡波抵达五十层正是实行最好时机）；规则（据诺斯菲）：镇守阶层之守护者所应行之事唯一——除却已备资格者一概不予通行，未通过罗德所欲行之『试练』者不可自五十层通过；抵达守护者阶层之人负有接受试练的义务；「直截了当地说，她正在为『试练』做准备」；镇守阶层之守护者所应行之事唯一：除却已备资格者，一概不予通行。；您有接受的义务。没错，这是作为抵达守护者阶层之人应尽的义务」</data></node>
    <node id="诺斯菲的契约与『契约的证明』"><data key="name">诺斯菲的契约与『契约的证明』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据文本：诺斯菲对涡波持有『妻子』身份、涡波持『丈夫』立场；『契约的证明』为诺斯菲认定可实现留恋之物——与『夺走涡波大人的一切』同义，该行为被涡波判断为接近强奸的出格之事并遭拒；事后诺斯菲自认『您索求契约的证明什么的，实在是过于冒昧了』，阻挡退路的光棒随之消失；「我很清楚这并不正确。但即使如此，我也要夺走涡波大人的一切。现在、就在这里⋯⋯」；她（拉丝缇娅拉）的存在，才是让我始终无法接受诺斯菲『妻子』身份的理由。；若从理性的角度出发，最好的做法应该是利用作为『丈夫』的立场来驱使诺斯菲这名守护者才对。</data></node>
    <node id="主角队伍的经验值特例"><data key="name">主角队伍的经验值特例</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主角队伍（含玛利亚）经验值始终均等分配（与级别差无关）——他队=击杀者独得；分配极限距离约一百米；有『正道』类结界处极限距离变则；带人练级=一日可产熟练探索者（玛利亚3→7级/日）——被玛利亚评『犯规』；主角隐匿此能力（恐遭国家逮捕）；『经验值的分配始终均等，与级别差无关』</data></node>
    <node id="管理领域内外规则"><data key="name">管理领域内外规则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫内『管理领域之外』无规则、探索者可互相攻击（领队据此砍伤主角）；修缮道路（正道）属管理领域之内、人与人相安无事（主角推断并验证）；「这里可是迷宫，而且还是在『管理领域之外』的地方。你应该有所觉悟了吧，小鬼。」</data></node>
    <node id="涡波能力构成剧变（阳滝魔石拔除后）"><data key="name">涡波能力构成剧变（阳滝魔石拔除后）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">冻结魔法不可用（『冻结魔法是我妹妹的才能』）——现在只会次元魔术，有自信用好的仅『维度』『形式』『连接』三魔法且全无直接攻击力；自认特化辅助/非战斗系生产要员（先天才能反映性格论：独『魂』无战斗系技能理所当然，阳滝才是超级攻击性才能者）；技能表与最终确认时相比无变化，但素质微减+魔力相应减——对魔石拔除而言影响小得反常、原因找不到头绪；级别22=沉眠中莱纳作为治疗一环施LevelUP（罗德提醒勿放置可升级状态）；跟帕林库洛之战的乱码状态已恢复，『表示』跟上变化；从而我也可以再次确认阳滝的魔石被拔除后产生的影响了。技能跟最后一次确认的时候相比没有发生变化。但是其他的数值则发生了变动。；首先是按理</data></node>
    <node id="深层祭坛与诅咒武具（ch71）"><data key="name">深层祭坛与诅咒武具（ch71）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">沙海上的台形祭坛（削去上半部的金字塔状）插剑式；30层之外联合国探索者不曾涉足故保存完好；祭坛武具基本带『精神污染』诅咒（Raked・Blade：攻5/精污+1.50；CallOuter：防6/精污+1.20；AllConfess：防4/耐魔1/精污+0.50/混乱+1.00+；BloodSword：攻4/吸血暂增攻/精污+0.50/兴奋+1.00）；无诅咒装饰品皆无魔力无效；诅咒无法解除→涡波以『表示』鉴定后一律破壊（无污染威胁的碎片冻结回收备二次利用）；24层祭坛曾出『堕落使徒』（=校对版 Rokh·Bringer，与斯诺探索时）——与 ch0071 同名归并（WEB源重证）；祭坛的形状大</data></node>
    <node id="缇娅拉大人『再诞』计划（ch221全貌）"><data key="name">缇娅拉大人『再诞』计划（ch221全貌）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">目的=实现缇娅拉大人的『再诞』+将拉丝缇娅拉体内所有与缇娅拉大人有关的因素全部归零（分割后既不对玛利亚心中有愧、也能堂堂正正直面斯诺、并可确认涡波与她是否会错了意）。容器=魔石人类少女的遗体（寿命不到一年·走完自己的人生·死后志愿供体——'我们不会做与斐勒卢托一样的行径'）。作业常伴危险：一旦有差错，作为贮藏血之容器的拉丝缇娅拉可能被摧垮。对涡波绝对保密：若知情他会强行将血清除（以『DistanceMute』轻而易举实现）并妨碍再诞。成功之代价=她不再是『特别』的、『素质』被带走一部分，从此无法与涡波并肩（无法同探迷宫/无法同旅行/完成邂逅时订下的『契约』成天方夜谭）。现发'再诞大作战再开宣言</data></node>
    <node id="重力系共鸣魔法（露洁×诺瓦露）"><data key="name">重力系共鸣魔法（露洁×诺瓦露）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">二人重叠咏唱发动的共鸣魔法：『Gravity·Greed』=空间上下颠倒+数十人份超重压制，另有泡沫状展开（形似次元魔法Foam、触之物直坠坠地）；『Gravity·Daemon』=不可视『某物』如奔驰大地的巨兽掀地追踪猎物（具追踪性）；涡波解析：看似操纵重力、实则可能干涉浮力/引力/斥力/摩擦力等『各种力』——遂放弃以原世界物理解读（『魔法甚至能够改写世界的法则』）；两系均可被强力火焰魔法贯穿蒸散；这是对『重力』——或者说是操纵某种与之类似东西的魔法。；乍一看就像是在操纵着重力一样。但实际上说不定是对浮力、引力、斥力、摩擦力进行了干涉。；露洁和诺瓦露精心打造的魔法包围网，仅在一瞬间便灰飞烟灭</data></node>
    <node id="左手无名指戒指习俗的跨世界差异"><data key="name">左手无名指戒指习俗的跨世界差异</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">左手无名指=婚约指位之习俗仅涡波原世界存在（'那个习俗应该只存在于我的世界里'）；本世界无该指位习俗，但戒指本身仍用于结婚仪式——故赠戒给女孩会诱发误会反应（'把那种东西送给女孩子，当然会诱发这种反应'）；那个习俗应该只存在于我的世界里。；虽说左手无名指戴戒指是只有我那个世界才有的习俗，但是戒指本身仍然被使用于这边的结婚仪式中。</data></node>
    <node id="莉帕的大镰（本体一部分·『所有物』同等机能）"><data key="name">莉帕的大镰（本体一部分·『所有物』同等机能）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕自述：大镰'其实就是我本身的一部分'；'只要有魔力的话就可以收放自如'；'仅限这把镰刀的话我能够发挥像欧尼酱的『所有物』同等的功能'——平时从虚空掏出（校对版 ch0071 同述，WEB源重证）；莉帕一边迁就拉丝缇娅拉，一边从虚空中掏出大镰。；「这把镰刀其实就是我本身的一部分啊。只要有魔力的话就可以收放自如的！仅限这把镰刀的话我能够发挥像欧尼酱的『所有物』同等的功能哟！」</data></node>
    <node id="『流星』的攻击规模与余波（ch204实录）"><data key="name">『流星』的攻击规模与余波（ch204实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德的『流星』：流星本身只有一个人那么大，但攻击范围却是整个世界（躲开直击无意义）。坠落→引发遍及世界的冲击波→连身为次元魔术使的涡波都相形见绌的空间扭曲（毫无防备触及则肉身顷刻被撕成碎片）→如海啸般紧随的暴风（『维度・曲战演算』应付不了：皮肤灼烂/鼓膜被摧残/时间感消弭/身体如鸿毛踊动）。涡波以魔法『Default』拉开距离躲过直击，以『维度・曲战演算』使空间扭曲偏离原有轨道，暴风受害压至最小仍HP削减九成；只要利用魔法『Default』的效果，我完全可以与『流星』拉开很远的距离。但是我事先知道就算躲过去也没有意义。因为虽然流星本身只有一个人那么大，但它的攻击范围却是整个世界。；这股冲击波甚</data></node>
    <node id="37层"><data key="name">37层</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">通往迷宫37层的阶梯完全浸水（与35层同型）；涡波据此决断当日撤退——下次沿最短路径、以更完全状态挑战，并需准备更多储存空气的皮袋；据拉丝缇娅拉预估，明日可'一口气到39层'；通往37层的阶梯又是完全浸在水中的样子。；「⋯⋯不，今天就先到这里吧。把握了35层和36层的路就已经足够了」；而且也了解到需要准备更多储存空气的皮袋了。</data></node>
    <node id="『血』中的『术式』"><data key="name">『血』中的『术式』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波与莱纳的血中刻有魔法『术式』；光属性魔力沁染入『血』、以刻在血中的『术式』为对象直接行『交流』（对象非『生物』而是『血』）——结果：对诺斯菲使用魔法会双重发动、以正反相抵的『相杀』形式失效；双重发动消耗的是沁入体内的诺斯菲魔力而非本人魔力（『我们的魔力没有减少』）、无违和感与负担、难以事前察觉（与暗魔法硬来方式相对、特别具融合性）；「光属性的魔力沁染到了我们的『血』里！？」；对象不是『生物』而是『血』；而且因为对象是没有意识的『术式』，所以可以无条件地用『交流』解决许可与否的问题。</data></node>
    <node id="DistanceMute（远隔强制清除之能）"><data key="name">DistanceMute（远隔强制清除之能）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">被莱纳称为'犯规的魔法'：涡波利用『DistanceMute』可以轻而易举地将（血的清除等）付诸实践——拉丝缇娅拉对涡波保密的担忧前提（'为了免除后患''为了安全考虑'涡波会选择将血从其体内取出——据拉丝缇娅拉预判）。；而且利用『DistanceMute』这个犯规的魔法，他可以轻而易举地将之付诸实践。</data></node>
    <node id="次元魔法使的技能拷贝特性"><data key="name">次元魔法使的技能拷贝特性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺文揭示：次元属性的魔法使长于观察——用次元魔法仔细观察+记忆持有技能者的行动，仅此即可将技能纳为己有；配合涡波的骇人信息获取+全分析理解+精准仿效才能=能学会世上所有技能（'毫无阻碍…轻而易举'）；推翻'人生技能只增一到两个'的世界常识；涡波此前仅持三技能是因'没有尝试去学/无意识视作难掌握之物'；「你听好，只要满足了条件的话就是很简单的。次元属性的魔法使长于观察。使用你的次元魔法仔细地去观察、记忆持有技能的人的行动。仅仅如此你就能把技能纳为己有了。涡波你能够获取数量骇人的信息，同时还具备将其全部分析理解的能力。在此之上，你还有准确地将之仿效出来的才能。所以你一定能再现我的剑技。」；在一个人</data></node>
    <node id="艾德的『留恋』暴走（ch230）"><data key="name">艾德的『留恋』暴走（ch230）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波判明：艾德现状与迷宫中陷入狂乱的缇缇和诺斯菲同型——'这正是因『留恋』而暴走的守护者的特征。虽然声音彼此交错，但思绪全然是两道平行线'：放着重逢的姐姐不顾只盯涡波、放弃与缇缇沟通自断结论（'鄙人就当做是自己的忠诚在接受考验好了'）；涡波解读其心中全部想法='赌上作为臣子的一切，誓要讨伐逆贼，只为了拯救自己那遭受蛊惑的王'；这正是因『留恋』而暴走的守护者的特征。虽然声音彼此交错，但思绪全然是两道平行线。；（咕⋯⋯！──鄙人就当做是自己的忠诚在接受考验好了）；放着好不容易才重逢的姐姐不顾，他一而再再而三地喊着我的名字。</data></node>
    <node id="名字与言灵法则（据涡波认知）"><data key="name">名字与言灵法则（据涡波认知）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波：只有被赋予名字，魔法和技能才能发挥出其真正价值；只有被赋予名字，心中跃动的思念才能变为力量、化作言灵作用于世界；'我只要按照自己的喜好给它命名便足矣'（命名权在持有者）——本章对技能命名的机制依据；只有被赋予了名字，魔法和技能才能发挥出它的真正价值。；只有被赋予了名字，心中跃动的思念才能变为力量，化作言灵作用于世界。</data></node>
    <node id="魂优先于肉体法则"><data key="name">魂优先于肉体法则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『在这个世界，『魂』的优先度比『肉体』更高』——魂影响身体形态：涡波以己魂借阳滝之身仍保持『我』之姿；始祖躯壳纳入阳滝魔石后血肉蠢动、骨骼/肌肤质色/头发质长乃至性别尽数改变、『相川涡波』模样消散——再诞为阳滝少女；魔石（魂）错装/剥离亦致技能栏随失（冰结魔法/并列思考自涡波状态栏完全消失/剑术数值减少——三技能实为阳滝才能）；在这个世界，『魂』的优先度比『肉体』更高。；『始祖涡波』的血肉蠢动着，就连骨胳也开始变化。肌肤的质和颜色，头发的质和长度也变化着，渐渐变成了别人。『相川涡波』的模样渐渐消散。岂止如此，就连性别也改变了。；『冰结魔法』和『并列思考』完全消失了。</data></node>
    <node id="罗德的风之咏唱『加速』与心之代价"><data key="name">罗德的风之咏唱『加速』与心之代价</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德反复咏唱『加速』系词句（『加速加速加速矣吾之魂』/『孤乃袈夙（加速）之魂矣』/『焕翠光（加速）…奔驰无羁之魂（加速）』等）——减轻心中压力使情绪更愉悦的『咏唱』，代价=心遭一而再再而三的磨耗；过呼吸发作时靠其平复紊乱呼吸（习惯化行为）；涡波观感其依存程度如罹患药物成瘾症的患者；风之咏唱的『代价』另被用于变回曾经（千年前）的样子；追捕中自述『孤之弹丸亦是加速之魂』『日日夜夜加速不息』。与库内涡波技能『加速』（代价=安全）名同实异，不合并、留R4。；「──『加速』、『加速』『加速』『加速』、『加速加速加速矣吾之魂』──」；最后，忍受不住折磨的罗德将手伸向了『咏唱』的『代价』；这是减轻心中的压力</data></node>
    <node id="千年前物语对斯诺托出（轮廓ch226再述）"><data key="name">千年前物语对斯诺托出（轮廓ch226再述）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波主讲+缇缇补足：与使徒西斯/圣人缇娅拉/妹妹阳滝三人共度之日→阳滝因使徒西斯之过失化作怪物→自暴自弃的涡波得圣人缇娅拉拯救；涡波自称大陆千年传说主要登场人物之一的始祖本人；同伴中与千年前有瓜葛者仅缇亚与拉丝缇娅拉（据涡波）；斯诺以童话视之接受、玛利亚预计同反应（据涡波推测）；在那之后，阳滝因为使徒西斯的过失化作了怪物，而因此变得自暴自弃的我得到了圣人缇娅拉的拯救；还自称是其中主要登场人物之一的始祖本人；跟千年前有瓜葛的只有缇亚和拉丝缇娅拉两个人。</data></node>
    <node id="本土（大陆）概况"><data key="name">本土（大陆）概况</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与开拓地东部大陆相对、被称作『本土』的大陆基本经由人手开发，存在十余个大国、到处是历史悠久的市镇；瓦尔德本国位于其上、距战场最近故警戒等级高；涡波一行将LivingLegend号停靠在本土东北部瓦尔德本国东端的海崖下隐匿（防止帮助奴隶/对付海盗的船情报泄露）；我们终于抵达了『本土』。；跟身为开拓地的东部大陆不同，被称作『本土』的大陆基本上都经由人手开发过了。这里存在着十余个大国，到处都是历史悠久的市镇。；为了隐藏『LivingLegend号』，我们将它停靠在本土东北部瓦尔德本国东端的海崖下。</data></node>
    <node id="代价咏唱体系南方军现状（ch222）"><data key="name">代价咏唱体系南方军现状（ch222）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">这一年来于街头巷尾传播开来的技术已魔法部队全员习得（成功迎击的自信尚存）；该技术要求的『代价』并非魔力和体力，而是更为重要的事物（内容未明示）；斯诺以司令官权限禁止对十倍规模怪物使用——『我不希望本应发挥在与北方的战斗中的你们的力量白白流失在这种地方⋯⋯最重要的是，我不忍心看到你们支付『代价』的模样』；「可能我们真的力有未逮！但就是为了这种时候，才有『咏唱』的用武之地！」；这一年来于街头巷尾传播开来的技术已经被魔法部队的全员习得，所以成功予以迎击的自信还是有的。；──那个技术要求的『代价』并非魔力和体力，而是更为重要的事物。</data></node>
    <node id="四人状态面板快照（ch119·探索前后）"><data key="name">四人状态面板快照（ch119·探索前后）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">章首拉丝缇娅拉受玛利亚所托为二人操作升级（面板先后示迪亚波罗・西斯级别16/玛利亚级别15）；探索后甲板确认：相川涡波=探索者·级别19·HP301/331·MP366/849－400·素质7.00；拉丝缇娅拉・弗茨亚茨=骑士·级别19·HP735/783·MP338/353·素质4.00（职业栏'骑士'为库内新见，对照 ch0014 英雄/ch0039 无）；迪亚波罗・西斯=剑士·级别18·HP220/269·MP182/1107；玛利亚=无职业·级别17·HP159/264·MP23/1065。经验值来源=歼灭大量高级别怪物；因为歼灭了大量高级别的怪物，经验值积攒了很多。；相川涡波HP30</data></node>
    <node id="迷宫32层：水晶走廊环境变迁"><data key="name">迷宫32层：水晶走廊环境变迁</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">由沙漠型阶层'变回了28层以前的走廊状'，墙壁材质仍为水晶、较沙海易行；差异点：天花板异常得高、走廊内流小河（美丽清澈、河底水晶闪耀）；怪物构成变化——虫类动物类怪物不多、飞行系数量增加（水晶鸟型怪物，本段未获名：'连水晶的鸟型怪物的名字都不知道'）；曾于22层以里约鹰为对手苦战的记忆令前锋二人面露苦色（飞行系应对是短板，本次因有魔法使而补强）；不再是沙漠一般的阶层，变回了28层以前的走廊状。墙壁的材质依然是水晶，但要比在沙漠中前进容易不少。；当然，也存在跟之前不一样的地方。天花板异常得高，走廊内流着小河。；虫类动物类的怪物不多，取而代之的飞行系的怪物数量增加了。</data></node>
    <node id="六十五层的地形与怪物（ch209）"><data key="name">六十五层的地形与怪物（ch209）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">六十五层＝'纵横无尽交错的阶梯迷局，由天空所编制的世界'；栖息无数迷宫怪物LizardFlyer——'曾经极具威胁的怪物如今已经不再令人畏惧'（缇缇风魔法聚怪+莱纳剑斩一瞬解决）；接着，首先到达的是六十五层。；纵横无尽交错的阶梯迷局，由天空所编制的世界。；在那里的是无数迷宫怪物LizardFlyer。</data></node>
    <node id="手环取下计划（安全解体方针）"><data key="name">手环取下计划（安全解体方针）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉方针：不破坏而取下——帕林库洛制道具内含不明术式（爆炸物/自杀术式风险）→'拥有所有的魔法知识的我+拥有世界最强大魔力的缇亚'协力，有时间即可解体任意术式；前提=涡波弱化至无法反击（约会/不眠/茶会）+比赛窗口（大会中无人可妨碍）+警戒（莉帕Dimension对诺文奇袭）；赛程=第四战拉丝缇娅拉vs斯诺/准决赛vs涡波——'已经不做人的四支队伍'（我们/涡波/斯诺/守护者）争霸格局；『手环』就交给我和缇亚好了。计划是在把涡波变得遍体鳞伤之后，再好好地取下来。」；这个大会不过是已经不做人的四支队伍在战斗而已呢。我们、涡波、斯诺、还有守护者四只队伍。毫无疑问，优胜者必然是这四支队伍中的一</data></node>
    <node id="异邦人召唤"><data key="name">异邦人召唤</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者的阶层在人类初次抵达时发动的术式，将『理的盗窃者』唤醒（诺斯菲说明）；本章实证：执行召唤的术式可被诺斯菲『交流（篡改）』改换召唤对象（预定五十层=罗德→诺斯菲本人），因该术式现状态『跟没有使用者的魔法差不多』；这个呢，是守护者的阶层在人类初次抵达的时候，发动『异邦人召唤』的术式，将『理的盗窃者』唤醒的现象；我对执行召唤的术式进行了『交流（篡改）』，将召唤对象从罗德转变为了我自己</data></node>
    <node id="迪亚布罗·西斯状态栏（置换前后）"><data key="name">迪亚布罗·西斯状态栏（置换前后）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">置换初时（剑士职业）：HP293/293 MP1202/1202，职业剑士，等级20，力量10.01 体力8.31 技巧4.80 敏捷4.94 贤能16.67 魔力70.34 素质5.00；『名字还是迪亚布罗·西斯。状态依旧只有「加护」』。西斯嫌咒术『集中收束』存在莫名的龃龉、属性偏重力量不合其近战定位，宣言『重·置·吧』——重置后：HP142/142 MP1489/1672，职业：使徒，等级20，力量0.21 体力0.41 技巧0.24 敏捷0.44 贤能1.00 魔力112.67 素质5.00；身体能力降至日常生活堪忧水平，魔力特化超过100.00；其白色魔力密度不逊于守护者、单就质量更胜</data></node>
    <node id="奴隶解放的现实边界(无依靠者无法自活)"><data key="name">奴隶解放的现实边界(无依靠者无法自活)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缺乏经验知识的孩子们无法活用眼前机会（恐怕都是被毫无道理地夺去家族的孩子）；眼神空虚完全放弃生存希望者，解放即必然曝尸荒野；存在不当奴隶就无法活下去的人（涡波判断）——只能作为奴隶卖到奴隶市场（正直市场也得看运气）；解放附带一定量金钱但之后必须靠自己；『只要还活着，总有一天会遇到好事』只能如此相信；恐怕都是些被毫无道理地夺去家族的孩子们吧。；眼神空虚，完全放弃了生存的希望。；只能作为奴隶卖出去了，我虽然是个笨蛋，但存在不当奴隶就无法活下去的人这种事情我还是能明白的。</data></node>
    <node id="千年前迎入北方之理由(罗德自述)"><data key="name">千年前迎入北方之理由(罗德自述)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德声称：千年前其不顾一众臣子反对、于王座之上将身为『南联盟』领袖之夫的涡波迎入北方；对臣下用的借口冠冕堂皇，真实理由=只有涡波曾劝孤舍弃王位、并批评其老气措辞『实在很奇怪』、要孤说话更孩子气一些；罗德自认『北方的救世主』，而当时的涡波对孤而言是『孤的救世主』（当时未说出口）；罗德自评千年前言词恢弘不可一世的王『其实不过只是一个孩子』；千年前，端坐在这王座之上，言词恢弘不可一世的王其实不过只是一个孩子。；遥想当年，孤就是在这王座之上、在一众臣子的反对之下，将涡波纳入麾下的啊。；千年前，孤究竟出于何种理由，才将身为『南联盟』领袖之夫的涡波迎入北方……你知道吗？</data></node>
    <node id="炎之剑（贝丝版·火焰辅助定位）"><data key="name">炎之剑（贝丝版·火焰辅助定位）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚等亦持有的眼熟魔法（本章对照提及）；贝丝版为拔剑覆焰的剑技强化——火焰充其量只是一种辅助、并没有光靠火就能斩杀敌人那种程度的力量（涡波评，见其火焰即止颤）；其咏唱形态带前缀『噬咬侵蚀之』；溅到袖口的火苗如浇油般越烧越旺、有遍及全身之势（涡波切断袖口弃之）；贝丝把剑从腰间拔出，并将火焰覆于其上。看到这眼熟的魔法，我的身体不由发生颤栗。但跟玛利亚她们的『炎之剑』不同，贝丝的火焰充其量只是一种辅助。；「──『噬咬侵蚀之』！『炎之剑』！！」；溅到衣服袖口的火苗就像被浇过油一般越烧越旺。再这样下去不一会儿火焰就会遍及全身，我立刻切断袖口将之甩到一旁。</data></node>
    <node id="『可以让所有人幸福的魔法』"><data key="name">『可以让所有人幸福的魔法』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">过去的圣人缇娅拉为拯救世界而创造的神圣魔法，亦为救赎所有《理的盗窃者》而存在；即始祖涡波施加在迷宫中的术式——本章《前日谭》唤魂时空中魔石降下无数淡薄泪洸、逐渐膨胀形成人的轮廓（'与怪物显现在迷宫中的瞬间颇为相似'），'每一束光中都切实地蕴含着灵魂'，世界为光溢满；无数淡薄的泪洸开始于空中飘洒。而泪洸的诞生之源正是空中的魔石。；这便是始祖涡波施加在迷宫中的术式，既是过去的圣人缇娅拉为了拯救世界而创造的《可以让所有人幸福的魔法》，也是为了救赎所有《理的盗窃者》的——神圣的魔·法；世界为光溢满。</data></node>
    <node id="魔人"><data key="name">魔人</data><data key="type">种族·社会范畴</data><data key="status">provisional</data><data key="desc">与魔物混合之人（『你跟什么魔物的混合』决定身份）；南方待遇恶劣、隔阂日深（『『人类』与『魔人』之间的隔阂越来越严重了』）——缇缇因此北逃；北方=魔人同胞互助之地（无血缘亦家人的自家规矩；村中有赤牛血/黑狼血等混血者）；南方终以『魔人狩猎』为理由发动侵略；南方旧地『魔物已经遭到清除』；最近这些年来与南方之间的关系──不，应该说是『人类』与『魔人』之间的隔阂越来越严重了啊。据说在南方『魔人』的待遇非常糟，想必丫头你也是饱受其害吧？；没有血缘关系也无所谓。咱们有咱们自己的规矩，决定是否是家人也一样。按照那个规矩来说，丫头你就是老夫的家人；像是混有赤牛的血的人、还有混有黑狼的血的人⋯⋯</data></node>
    <node id="『庭师』"><data key="name">『庭师』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇缇的自评职业：'人家能做好的，充其量也就只有一个《庭师》罢了！也就《庭师》这种不起眼的工作最适合自己！'（《支配之王》《魔王》《狂王》等称号'根本就和人家不相称'，'说什么支配，顶多也就支配些小动物而已'）；雷纳尔多临别赠言'佩艾希亚的庭师缇缇那一直停滞的时针终于重新开始了走动'；人家能做好的，充其量也就只有一个《庭师》罢了！；佩艾希亚的庭师缇缇那一直停滞的时针终于重新开始了走动。</data></node>
    <node id="『剑术』"><data key="name">『剑术』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波的技能：将『感应』给出的天方夜谭般答案化作现实——以最合适出剑顺序配以最合适身体动作、不存一丝瑕疵地连续斩除风矢（三剑开隙→侧身潜入→反复斩除）；因与『魔王』数秒剑闘成长到前所未有的高级别（据自述）；但是就算是这种阵容，凭借我现在的『剑术』应该也是有办法对付的。；虽然只有数秒的时间，但是拜与『魔王』的剑闘所赐，我的『剑术』已经成长到了前所未有的高级别。；这个问题由技能『感应』来回答，接着技能『剑术』则负责将那天方夜谭般的答案化作现实。</data></node>
    <node id="『支配之王（Lord）』称号（ch199）"><data key="name">『支配之王（Lord）』称号（ch199）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德自称『立于一切顶点的支配之王（Lord）』、战斗中亦自称『魔王』；佩艾希亚骑士们尊其为『支配之王』/救世主（『我们的支配之王回来了啊！！我们的救世主没有背叛我们啊！！』）、称此城为『支配之王的故乡』；罗德本人对声援表情扭曲、叱退『少来碍事！统统退下』；另有称号『风之理的盗窃者』（守护者中速度首屈一指）；想要抓住守护者中速度首屈一指的『风之理的盗窃者』，不使用点卑鄙的手段的话，那估计连碰都碰不到她。；就是这么强！所以孤才会成为立于一切顶点的『支配之王（Lord）』！！；「啊啊、终于回来了吗！？回到这『支配之王』的故乡！！」</data></node>
    <node id="涡波失去冰结属性才能（ch90追认）"><data key="name">涡波失去冰结属性才能（ch90追认）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自述：'因为失去了冰结属性的才能，攻击手段锐减的我只能采用这种配置'——现攻击手段仅'奇袭之后使用DistanceMute'一种；故采斥候后卫定位（莱纳骑士前卫）、不需攻击力防御力；另外说一下，我的装备只有『新月琉璃』和那两个护身符而已。；探索还是以莱纳为主。我的职责是用魔法辅助他。；那就是作为骑士的莱纳是队伍的前卫，而作为斥候的我则是队伍的后卫这样吧。因为失去了冰结属性的才能，攻击手段锐减的我只能采用这种配置。</data></node>
    <node id="涡波崩坏要因链（魔力=毒·回想收束）"><data key="name">涡波崩坏要因链（魔力=毒·回想收束）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波独白：『魔力』其实是『毒』、积蓄过多即成『怪物』——因无人察觉（含自己）而未能阻止使徒西斯的复活与记忆的复苏；『并列思考』成天擅自做恶性预测将其逼紧；技能『？？？』致人际关系乱七八糟、且『连死都不被允许』；崩坏时间线：与海莉邂逅时点附近已现预兆→吃下艾德的魔法（回复状态异常）为决定性——同时解除了缇亚抑制西斯的魔法与拉丝缇亚拉抑制恋心的魔法（后者或与圣人缇娅拉关联，涡波推测）；帕林库洛的『世界奉还阵』对涡波过去记忆进行『回想收束』——所展示的阳滝之死与『非相川涡波』根据均为真货（由魔法阵效用可判）→支撑其存在的根基彻底崩溃；因为我没能察觉到『魔力』其实是『毒』这一点，所以没能阻止使徒西斯</data></node>
    <node id="玛利亚真正力量与迷宫辅助定位"><data key="name">玛利亚真正力量与迷宫辅助定位</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本章实演玛利亚真正力量=数秒烧尽数平方公里内过万怪物、地面熔岩化的绝大火力——涡波'总算明白了为什么在迷宫探索时她只负责辅助了'；白色炎之剑光辉不逊于『世界奉还阵』；这就是玛利亚真正的力量。我总算明白了为什么在迷宫探索时她只负责辅助了。；白色的炎之剑闪耀出不逊于『世界奉还阵』的光辉。</data></node>
    <node id="「自由之风」"><data key="name">「自由之风」</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德最大出力蓄力时驱使的风：自己也无法控制将吹向何方，不会被任何事物所干涉，但却能干涉任何事物。聚集而成的风绝非泛泛之物，与罗德的双翼混杂在一起变得巨大无比，构成包裹涡波的风之囚笼；那是「自由之风」；那风自己也无法控制将吹向何方，不会被任何事物所干涉，但却能干涉任何事物。；罗德的双翼与「自由之风」混杂在一起变得巨大无比。</data></node>
    <node id="血的极限一般说法与不适用（涡波·缇缇·ch218）"><data key="name">血的极限一般说法与不适用（涡波·缇缇·ch218）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">世界一般说法：'一旦过度服用魔石达到了血的极限，那么就没办法再掌握新的魔法'；据缇缇：'『理的盗窃者』应该是没有极限的哦'（缇缇于 ch216 自称'千年前的『理的盗窃者』'）；涡波自析：自开发之『次元决战演算『前日谭』』等延伸'不是刻在血中，而是刻在脑子里的。不，准确来说的话应该是刻在了我的魔石（魂）当中'——该说法'于我们就是不适用的了'；既定方针：'利用先人的智慧将魔法刻在血中，而自己只负责开发新的魔法'；『理的盗窃者』应该是没有极限的哦？；这些都不是刻在血中，而是刻在脑子里的。不，准确来说的话应该是刻在了我的魔石（魂）当中才对吧。；如此一来，那么这个世界的一般说法『一旦过度服用魔石达到</data></node>
    <node id="涡波当前能力状态（魔石拔除后·ch172）"><data key="name">涡波当前能力状态（魔石拔除后·ch172）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『水之理的盗窃者』魔石被拔除→冻结魔法完全不可用（与构筑难度无关，'就是做不到的样子'）；涡波身上仅剩次元属性魔力（'如今我真的是只剩下这一种属性了'）；MP耗尽状态下次元魔术辅助不可用仍可纯体力杂活；失去技能『并列思考』（妹妹的才能）并自认为强化（非弱化）；『Default』满状态一次只能使用几回；与居民交流也是迷宫攻略重要一环（据其观念）；然而，因为『水之理的盗窃者』的魔石被拔除，现在我完全失去了那方面的才能。；恐怕是我身上只有次元属性魔力的缘故吧。如今我真的是只剩下这一种属性了。；可能失去技能『并列思考』对我来说并不是弱化，而是一种强化吧。</data></node>
    <node id="阿雷亚斯家的宝剑诺文（能力·ch70更新）"><data key="name">阿雷亚斯家的宝剑诺文（能力·ch70更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">嵌有守护者诺文魔石的剑：攻击力17→19（与持有者等级联动）；持有者能再现诺文·阿雷亚斯的剑术；可以改变形状；持有者地魔法+2.00；超常硬度（石英巨蟹夹剑掰折反自毁蟹钳）；新能力=将涡波的次元魔力转换为『地之理的盗窃者』魔力（水晶魔法『Quartz』，经剑内诺文'许可'后成立）；'能够增加自身属性'在此世界相当异常；嵌有守护者诺文的魔石的剑；可以改变形状。持有者地魔法+2.00；攻击力与持有者等级相当</data></node>
    <node id="佩艾希亚（北方国家·千年乐园）"><data key="name">佩艾希亚（北方国家·千年乐园）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">起源补全：位于大陆北方中心地带的国家，首都于北方战败之际被南军攻克，孤儿院被占为押放'污秽的魔人'之地；佩艾希亚王族半数于事前逃走（罗德怒斥'不配称为王族'）；罗德率反乱军夺还王城→新生佩艾希亚国诞生、罗德即王位（三重期望：王族举止/总大将英明/革命家感染力）；死后于迷宫内再现战前之姿，罗德以千年将其缔造成魔人『乐园』后毁于孤手、化作虚无。原文行948出现'佩艾西亚'变体写法一处（不另立名）；位于大陆北方中心地带的佩艾希亚首都，被南军攻克了。城陷之时正是北方战败的瞬间。；[是的。虽说有不少王族战死，可是这……、恐怕有半数都在事前逃走了……]；最后将孤捧上了王位，新生的佩艾希亚国也就此诞生。</data></node>
    <node id="世界奉还阵的真正目的"><data key="name">世界奉还阵的真正目的</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据帕林库洛宣称（对涡波）：如果我赢不了『涡波（汉字）』，那就把『涡波（片假名）』拉出来——让作为『怪物』的『始祖涡波』来充当作为『英雄』的『少年』的对手；'这本来是我谱写的计划的终曲⋯⋯不过既然到了最后一回合也用不着再保留什么了！这就是我打造出『世界奉还阵』的真正目的'——即本阵的终局用途=召唤始祖涡波躯壳与涡波对决（与 ch156'原本用途'说并行的目的面新证）；让作为『怪物』的『始祖涡波』来充当作为『英雄』的『少年』的对手便是。虽然这本来是我谱写的计划的终曲⋯⋯，不过既然到了最后一回合也用不着再保留什么了！这就是我打造出『世界奉还阵』的真正目的！！</data></node>
    <node id="莉帕的『联结』现状（ch70）"><data key="name">莉帕的『联结』现状（ch70）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与诺文分别后『不存在于彼处的诅咒』已解除，但『联结』能力留存（其他魔法仍可用）；因记忆过度流入危险只维持最小限度；现联结对象仅涡波一人（'思考较理性'；他人因介意隐私回避）；莉帕自身不喜欢作为死神的能力；此联结即首探方案中涡波魔力补给（'依靠莉帕将魔力分给我进行补充'）的通道；顺带一说，莉帕的『联结』这一能力还留存着。经过与诺文的分别，『不存在于彼处的诅咒』虽然已经解除，但仍然能使用其他的魔法。；现在跟莉帕之间有联结的只有思考较理性的我一个人而已。其他人都因为介意隐私问题而回避了『联结』。</data></node>
    <node id="技能『？？？』的混乱联动与战斗限制（ch116）"><data key="name">技能『？？？』的混乱联动与战斗限制（ch116）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：混乱超过8.00涡波即不许战斗；到10.00就会发狂（'本来的话不是0.00我甚至都不愿意让你外出的'）——涡波经'相反立场'反问被论破后接受、遵从其判断；技能消除=前所未闻不可行；技能封印=不可——据拉丝缇娅拉推测帕林库洛以魔法+『咒术』并借『暗之理的盗窃者』缇达之力施为，'就算是我们也模仿不来的'；现行方针=只能拼命不让它发动；「封印应该也做不到吧。恐怕，帕林库洛那家伙不仅仅用了魔法，还使用了『咒术』吧。而且还是借用了『暗之理的盗窃者』缇达的力量，就算是我们也模仿不来的⋯⋯」；「总而言之，混乱超过8.00的话涡波就不许战斗了呢」；「这不是当然的嘛。到了10.00的话就会发狂了</data></node>
    <node id="雷纳尔多的魔法锻冶·神铁锻冶"><data key="name">雷纳尔多的魔法锻冶·神铁锻冶</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">锻冶过程消费魔力：铁锤刻有魔术式（'可以被称为魔法道具的铁锤'），锤击间魔力如网状附着铁器表面、冷却同时固定形态——涡波评'这绝不是一般的锻冶技术…可能已经是跟锻冶不同的另一种技术'；冷却工序并用火焰/水/地魔法补正铁器强度（普通铁锅升华為上位存在）；经一定技术改造的道具在名称前冠以施工者名（【雷纳尔多的铁锅】/通过『神铁锻冶』升华——注释如传说武器）；魔石装备修复需特殊道具+将术式文字刻回恢复原状的装备（超人级精密作业，涡波以其属性应付无苦/会铭刻简单魔术式）；千年前遗物（33层拾获品）能入其法眼；其工房构造与『史诗探索者』的『工房』相似但规格更高；技能『锻冶』3.12=人类至宝级热量精准掌</data></node>
    <node id="共鸣魔法『Inviolable・冰Room』"><data key="name">共鸣魔法『Inviolable・冰Room』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">冻结魔法×神圣魔法的复合结界（停止空间内动作）；由魔石人类四少女全员『亲和』缔造的大共鸣魔法（同属性魔力+天衣无缝配合）；强度异常：10级上下的四人冻结近30级的涡波、莱纳与守护者缇缇（'从『表示』上来说，这是绝对不可能产生的力量'）；以使徒为假想敌打造（据斐勒卢托）；随四人战意丧失而解除；被涡波以 DistanceMute 次元偏差突破；「『『『──共鸣魔法『Inviolable・冰Room』』』』」；我马上就明白了这是冻结魔法和神圣魔法的复合型。是停止空间内动作的单纯的结界。；但在这个结界中，现在级别近30的我和莱纳竟然也动不了。连守护者缇缇进食的手也停了下来。</data></node>
    <node id="守护者留恋解消现象（ch190实证）"><data key="name">守护者留恋解消现象（ch190实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者的留恋实现时发生的现象：心中的遗憾得到清偿→维持身体的存在变得困难→存在淡薄到几乎要从世界上彻底消失（魔力以肉眼可见速度衰减、身体变稀薄）；诺斯菲本章部分解消为实证（本人亦知其意义）；先例并提：诺文『能够因一份简单的愿望得到实现便消失』；她的魔力正以肉眼可见的速度衰减着。；这是守护者的留恋实现时发生的现象。是因为心中的遗憾得到清偿，导致维持身体的存在变得困难的现象。；「诶⋯⋯，身、身体变稀薄了⋯⋯？这个是、留恋的解消⋯⋯？」</data></node>
    <node id="佩艾希亚与世界（『这里』）的千年期限构造"><data key="name">佩艾希亚与世界（『这里』）的千年期限构造</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲（雷纳尔多背书'那位诺斯菲应该是不会说谎的'）：『这里』再过约一个月崩坏；'这个世界似乎从一开始就是以存在一千年为条件创造出来的'；能延长这里的寿命者唯涡波的次元魔术；雷纳尔多：已死之身者在此度过千年、'『这里』终究是类似于墓地的地方，灭亡是注定的，只是方式有别罢了'、居民早有崩坏觉悟（'想必罗德除外就是了'）；涡波自责'如果我能够使用空间系的次元魔术的话，可能就能想些办法了'（其所能为次元魔术，空间系尚不能）；「这个世界似乎从一开始就是以存在一千年为条件创造出来的。诺斯菲说能够延长这里的寿命的，就只有我的次元魔术而已」；「小子，你不用在意『这里』的问题。我等早就做好了无论何时崩壊都无</data></node>
    <node id="分组与『干死帕林库洛小队』"><data key="name">分组与『干死帕林库洛小队』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">抓到帕林库洛前数日分两组行动：出发组4人=涡波/拉丝缇娅拉/玛利亚/缇亚（自称队伍名『干死帕林库洛小队』），留守组3人=莉帕/塞拉/斯诺守船；分组理由=人多显眼+次元魔法使莉帕与涡波分开行动（两者以次元魔法沟通方便）；留守炊事名义塞拉、实际预计由莉帕准备；涡波队常态=一男六女（同性同伴缺失为其胃痛源之一）；「总而言之，要跟涡波一起去本土的也就我和玛利亚还有缇亚而已了。这样就漂亮地4对3了呢。」；「涡波的要求只有希望作为次元魔法使的莉帕跟你分开行动而已，不是吗？」；「就是这样，我们要以4人小队行动喽。队伍名就叫『干死帕林库洛小队』。」</data></node>
    <node id="斯诺的三次龙化悲剧史"><data key="name">斯诺的三次龙化悲剧史</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">让斯诺认真到使用『龙化』的情况共三次皆招极致悲剧：第一次毁灭故乡/第二次杀死自己憧憬的『英雄』/第三次害死帮助自己逃亡的挚友——昨天对拉丝缇娅拉为第四次（缇莉口述，译注指向斯诺外传）；『遍布失败的人生』→惯于放弃一切；「……以前，让斯诺认真到使用『龙化』的情况一共有三次。但不管哪一次都招来了极致的悲剧。第一次毁灭了自己的故乡，第二次杀死了自己憧憬的『英雄』，第三次害死了帮助自己逃亡的挚友。然后昨天的比赛是第四次。现在，斯诺一定觉得自己又要失去重要的东西了……」；根据状态栏上的信息，她现在没有外伤。但不同于外伤的某种东西残留在了斯诺的身体上，并在对她进行侵蚀。『状态』将此现象表示为了『龙化』。</data></node>
    <node id="四大贵族与联合国权势结构"><data key="name">四大贵族与联合国权势结构</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据缇莉（贵族讲座）：王家居顶端（王族权威近年下滑）；唯弗茨亚茨制度特殊——教会地位更胜王族（王族权势较弱）；贵族中有力的基本只有上级贵族（中坚有时不如有势力商人）；四大贵族=赫勒比勒夏因、希达尔克、沃克、阿雷亚斯（'在这四个姓氏面前可一定得恭顺些'）；希达尔克家=劳拉维亚王家血脉+联合国五国内相当有权势的贵族；那么，在那些贵族当中不得不认真对待的，就是刚才谈到的希达尔克家了，也就是俗称的四大贵族之一。概而言之，赫勒比勒夏因、希达尔克、沃克、阿雷亚斯、在这四个姓氏面前可一定得恭顺些啊。；据说希达尔克家不仅有劳拉维亚王家的血脉，同时也是联合国五国内相当有权势的贵族。</data></node>
    <node id="帕林库洛的材料观"><data key="name">帕林库洛的材料观</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主角（『英雄』）与玛利亚（『半守护者』）=实验动物/实验材料；海因遗体=创造超越拉丝缇娅拉存在的『材料』（头颅保存展示）；曾对阿尔缇与玛利亚施加过精神操作的自白（『类似于我对阿尔缇大姐和玛利亚小妹妹做过的事…再加上暗之理的盗窃者的力量』）——其实验/创造的最终目的仍未明言；只要活用这里的『材料』，创造出超越拉丝缇娅拉·弗茨亚茨的存在也不是梦话。</data></node>
    <node id="千年前北方兽人入境限制"><data key="name">千年前北方兽人入境限制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">推测该时期只有兽人才能进入北方——故四旅人以魔法变装猫耳猫尾入城；选择猫耳猫尾系始祖涡波的兴趣（现涡波对过去的自己无语）；虽然能够推测是因为这个时期只有兽人才能进入北方之类的缘故，但会选择猫耳猫尾肯定是因为我的兴趣。</data></node>
    <node id="守护者艾德的战斗形态（ch166）"><data key="name">守护者艾德的战斗形态（ch166）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者不使用武器、'只能做一个后卫'；一对一别无他法时以袖中小树枝战斗（自述先证+本章实证'确实不是武斗派的人'）；以辅助魔法『Growth・Extended』『SenseBless』『BranchWoodShell』强化身体'勉强拉到能够战斗的水准'；强化后的小树枝可与宝剑交锋迸出火光；战斗能力很低、撤退判断迅速果断；回避战斗优先、目标物回收至上；守护者艾德并不会使用武器。；「──『Growth・Extended』！『SenseBless』『BranchWoodShell』！！！」；艾德的战斗能力很低。因此他做出撤退的判断也很迅速果断。</data></node>
    <node id="罗德千年前王姿与双称号（ch189记忆实录）"><data key="name">罗德千年前王姿与双称号（ch189记忆实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前罗德于北方凯旋：南方被唤作『狂王』、这边（北方）被尊称为『支配之王』；北之帝国之王且为女王；凯旋式上民众全是兽人、军队以她为中心列阵（之城与佩艾希亚相似）；盛装=丝绸衣物+奢华铠甲+宝石王冠+马尾披散+背后羽翼不掩饰伸展、满溢威严气魄——与平时朴素风格大相径庭；现涡波断言其无论以前还是现在都沉浸在痛苦中渴求帮助；明明是女王，但罗德的表情却如此威风凛凛、高贵典雅、孤高傲世、冷漠乏然；虽说在南方被唤作『狂王』什么的，在这边却被尊称为『支配之王』了呢。</data></node>
    <node id="迷宫设计意图与逆攻略死角"><data key="name">迷宫设计意图与逆攻略死角</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫为将挑战者向『最深部』引导而创造（前提=自上而下攻略）、『为了让人变强而设计』（涡波自认创造者）；未考虑自下而上、以『地上』为目标的逆行情况——66/67层仅风龙、无杂怪可刷经验、无法回低层升级：逆行者陷入无成长途径的死胡同；跟以往不同，我们现在并不以『最深部』而是以『地上』为目标进发的。；我知道这座迷宫就是为了让人变强而设计出来的。毕竟创造者就是我本人嘛。；迷宫是为了将挑战者向『最深部』引导而创造的。</data></node>
    <node id="『异邦人』的和食·文化推广（『这里』）"><data key="name">『异邦人』的和食·文化推广（『这里』）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">城邑餐厅料理与联合国瓦尔德的酒馆'截然不同'而与涡波故乡一致：'酒与酱油的味道''或许是使用了料酒''味噌汤'与日料凉拌菜；店内装潢'与我的世界的风格很像'、店员统一制服（'这是迷宫联合国所没有的文化'）——涡波按：'可以窥见『异邦人』扎实的推广活动'；罗德：'因为就是涡涡推广的''涡涡教授的料理被人家推广到了大街小巷'；这些跟我在联合国瓦尔德的酒馆见到的截然不同。；酒与酱油的味道在口中扩散。或许是使用了料酒吧。；可以窥见『异邦人』扎实的推广活动。</data></node>
    <node id="魔法使对决规则（划线阵地战）"><data key="name">魔法使对决规则（划线阵地战）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉（'突然想起来'的魔法使间决斗规则）：先画好阵地（用脚在地面划线）、站在线上用魔法互怼；'使用魔法之外的手段迎击、以及离开站位就算输'；涡波评'是个不错的训练方式'并照划；说到魔法使之间进行决斗的规则嘛⋯⋯，就要像这样，先画好阵地；拉丝缇娅拉用脚在白雪皑皑的甲板上划出一条线。；──站在这条线上，然后用魔法互怼。使用魔法之外的手段迎击、以及离开站位就算输</data></node>
    <node id="公馆（旅馆）战场"><data key="name">公馆（旅馆）战场</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾德魔法草原化的庭院+玛利亚炎弹轰穿的墙壁洞口：火花点燃庭草着火；火力全开有'他们说了我们可以随意使用公馆'的许可（'这一带都会变成灰烬'）；拉丝缇娅拉自墙壁洞现身；燃烧中一度滞留拉丝缇娅拉（涡波血气上头遗忘）；凶恶的炎弹包裹着西斯就这样将旅馆的墙壁燃烧殆尽。；「可以吗！？这一带都会变成灰烬哦？！」；「现在是紧急情况！他们说了我们可以随意使用公馆！应该没什么问题！」</data></node>
    <node id="莉帕的联结体系全貌"><data key="name">莉帕的联结体系全貌</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『联结』传感情亦可传经验：莉帕恐制作大量联结从数不胜数的人身上汲取经验情感（无上限则对象=劳拉维亚全体国民/几天=几百年阅历）——不合年龄态度的来源；与涡波的联结=监视+次元魔法师承（次元之冬几天内全数掌握）；与帕林库洛的联结=操作其手环；感情高涨时思考经联结双向暴露（双方用假话牵制）；莉帕很可能制作了大量的『联结』，并从数不胜数的人身上汲取了经验和情感。；如果『联结』没有上限，那对象就是劳拉维亚国全体国民。</data></node>
    <node id="天上之七骑士现状（ch49更新）"><data key="name">天上之七骑士现状（ch49更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">三席空缺→海因亲族填两席（序列第六芙兰琉莱·赫勒比勒夏因+第七莱纳·赫勒比勒夏因=新加入）→尚余一席待补（总长佩露修娜属意涡波=海因意志继承者，被拒）；序列第一佩露修娜·库艾伽（总长）/倒数第三拉古涅·卡伊库欧拉；七骑士持弗茨亚茨推荐书参加舞斗大会；基督·欧亚的罪状经弗茨亚茨×劳拉维亚交易勾销（佩露修娜口径）；「相川·涡波殿下。如您所知，『天上之七骑士』有三席空缺。虽然海因·赫勒比勒夏因的亲族填补了两席，但仍有一席待补。唉，说实话，这真是相当让人困扰的境况。作为骑士之象征的『天上之七骑士』如果一直只有六人，实在无法成为他国的表率。……因此，我等目前正在寻找能继承海因意志的优秀骑士。」</data></node>
    <node id="『这里』的年代悖论与'美好拣选'构成假说"><data key="name">『这里』的年代悖论与'美好拣选'构成假说</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">史书载佩艾希亚在英雄谭之后'一直深陷战火之中，不曾再有过和平时期'，则『这里』所再现的当为战前数年和平时期，'但如果是这样又没法解释雷纳尔多的年龄'（涡波指摘）；涡波假说：'说不定这里是只将佩艾希亚美好的地方拣选出来后打造而成的世界。对『想起收束』的成法和顺序稍加注意的话，应该不是做不到'；旁证：保管室毁画状态亦可能在城堡被『想起收束』时即已如此（涡波猜想之一）。；不过，这样想来，『这里』现在的年代就有点不可思议了。；根据史书的记载，在那之后佩艾希亚就一直深陷战火之中，不曾再有过和平时期。；既然如此，那是将战前数年的和平时期给再现出来了吗。不过，如果是这样又没法解释雷纳尔多的年龄。</data></node>
    <node id="涡波魔力状态（纯次元属性）"><data key="name">涡波魔力状态（纯次元属性）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波当前魔力='没有混杂冻结属性的纯粹的次元属性的魔力'；经预知魔法『次元决战演算「先谭」』后'对次元魔术的理解提高了一个水准'——自判为使用新次元魔术的最佳时机（'找不到比现在更好的时机了'）。另一方面'在无法使用冻结魔法的现在'手牌减少，开发新魔法以补充；开发方式=打坐统筹魔力、想像始祖魔法的构成（曾以肉身直接吃下该魔法一击）。；当我使用预知魔法『次元决战演算「先谭」』的时候，我感觉到自己对次元魔术的理解提高了一个水准，而且现在我的魔力是没有混杂冻结属性的纯粹的次元属性的魔力。要使用新的次元魔术，可以说找不到比现在更好的时机了。；在无法使用冻结魔法的现在，为了补充自己减少的手牌，我将意识集</data></node>
    <node id="舞斗大会参赛者人身自由保障规则"><data key="name">舞斗大会参赛者人身自由保障规则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">参赛者的人身自由由联合国保障——涡波以此为盾挡沃克家抓捕（『就算沃克家跟劳拉维亚联系密切，但其它四国可不一样/不在乎同另外四国爆发争端也没关系』）；大会结束后保障失效=围堵预告；「如果你打算违背斯诺的意愿把她抓起来的话，我就要叫人了。虽说斯诺在比赛中战败，但是她仍然是『舞斗大会』的参赛者。她的人身自由由联合国保障。</data></node>
    <node id="回想收束与守护者记忆机制（涡波推断）"><data key="name">回想收束与守护者记忆机制（涡波推断）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（ch141 再演+扩，库名沿用 ch0079）涡波推断：'那一天出现在迷宫内的我，是迷宫对千年前的『回想收束（Drop）』'？'我也是跟其他的守护者一样的，被迷宫『回想收束（Drop）』出来的怪物吗'？依据=一开始便持有技能『次元魔术』『冻结魔法』『剑术』+过高素质状态+突然出现在迷宫里；称号自推——冻结魔法先天而次元魔术后天→『冰之理的盗窃者』、更可能『水之理的盗窃者』（'所以我创造出的魔法，才不管哪一个都有强烈的冬或雪的印象。因此艾德才称呼我为『水之理的盗窃者』吗'）；守护者力量按所在层受限（据回忆：诺文=30层守护者力量限3成→涡波因在1层被召唤故与一层相符化为1级？）；『回想收束』出</data></node>
    <node id="当今世界实力排序（据莉帕）"><data key="name">当今世界实力排序（据莉帕）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕：现在在这个世界上比玛利亚更强的就只有北方的『支配之王（Lord）』而已——故玛利亚就算给世界树烧成灰也不会被人抓起来；「不用担心啦。现在在这个世界上比玛利亚更强的就只有北方的『支配之王（Lord）』而已。就算给世界树烧成灰也不会被人抓起来的，放心吧放心吧」</data></node>
    <node id="HP代MP的生命燃烧机制（ch127实证）"><data key="name">HP代MP的生命燃烧机制（ch127实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">燃烧生命作薪柴的魔法运用：MP枯竭后仍可重启魔力供给且'魔法的力量却更强了'——用HP代替MP的超越极限力量，代价为最大HP递减（352→347→341，单回合约-50='小孩子份量的生命值'）；以生命为代价的魔法远强于通常魔法（可化解莉帕最强黑暗魔法；涡波自陈'我自己亲身体验过'故知其棘手）。另有放弃魔法构筑、有意让风属性魔力暴走的自爆式迎击：可化解斩击但己身受创+魔力消费更多（'如果说会被你的剑击败的话，那到时候就像这样炸开便是'）；我知道这个现象是怎么回事。燃烧生命作薪柴的魔法运用。用HP代替MP的超越极限的力量。；这次不是MP，而是最大HP在以肉眼可见的速度减少着。我的『表示』清清楚楚</data></node>
    <node id="迷宫物体自修复与风龙交战规则"><data key="name">迷宫物体自修复与风龙交战规则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫内的物体经过一段时间之后会自行修复（涡波推断：应该是使用了魔力的『想起收束（Drop）』的一种应用——之前被破坏的中央螺旋阶梯已恢复原状）；六十六层风龙交战规则：风龙对地上行走者全无兴趣，仅到六十五层与六十六层中间的位置才袭击过来（据莱纳所言）——要与风龙战斗似乎只能攀登位于中央的螺旋阶梯；正如莱纳所言，只有到了六十五层和六十六层中间的位置它才会袭击过来。；要与风龙战斗的话，似乎只能攀登位于中央的螺旋阶梯了。；之前被破壊的阶梯已经恢复了原状。在迷宫内的物体经过一段时间之后就会自行修复。应该是使用了魔力的『想起收束（Drop）』的一种应用吧。</data></node>
    <node id="『表示』对人使用与条件附加"><data key="name">『表示』对人使用与条件附加</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『注视』对人类有效（显示【状态】：姓名/HP/MP/职业/等级/六维/技能），隐私视同无物；可心念附加显示条件（如只看姓名+等级+技能）；无性别识别功能；我还发现在进行『表示』时可以附加相应的条件。</data></node>
    <node id="队伍系统的组队机制"><data key="name">队伍系统的组队机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">【队伍】面板：对话满足条件即可组队（【ＸＸＸ加入了队伍】+队长显示）；一人可与多人分别结成二人小队而对方互不知情（缇亚/玛利亚/拉丝缇娅拉各以为单独组队）——机制空隙；在缇亚、玛利亚、拉丝缇娅拉三人眼中，只不过是和我单独组成了二人小队罢了。</data></node>
    <node id="涡波的力量弱化与记忆缺失（ch84）"><data key="name">涡波的力量弱化与记忆缺失（ch84）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德近距离制住涡波后指出『怎么好像稍微变弱了一点』；涡波自认与『始祖涡波』或『持有阳滝魔石的我』相比弱了不少、且在罗德面前如此无力太过异常（双手被制完全动弹不得）；罗德归因『既然没有记忆，那也是当然的』；另：睡过头身体迟钝但对魔法构筑没有影响——记忆缺失与力量水平的关联成为主线疑点；「嗯？奇怪……？涡涡，怎么好像稍微变弱了一点？」；确实，现在的我与『始祖涡波』或『持有阳滝魔石的我』相比弱了不少。但是，在对方面前如此无力也太过异常了。；「嗯~，既然没有记忆，那也是当然的吗。」</data></node>
    <node id="莉帕的三重意志受信与联结传情"><data key="name">莉帕的三重意志受信与联结传情</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">联结（纹样）不只传送魔力还流通感情——莉帕通过联结收到梦中涡波的凄厉呐喊（『不许摆弄他人的命运』『绝不可容许谎言』『不能混淆自己的愿望』）并'相信那个声音'；'我刚才说的这些，其实就是大哥哥你的话'；以此为根基否决被强加的杀人使命（'任谁都不能摆弄我的命运。我会继续抵抗这虚伪的感情。因为我就是我'）——ch42 三重意志传达的送达确认（回传环节仍未完成）；通过这个『联结』，不仅是魔力，连感情也会在我们之间流通，如果是这样，那么莉帕刚才的发言就可以理解了。；「没问题的……因为我是不会输的……——我绝对不会输给『抹杀诺文』这种被·强·加·的·使·命。任谁都不能摆弄我的命运。我会继续抵抗这虚伪的感情</data></node>
    <node id="拉丝缇娅拉的地位与战力"><data key="name">拉丝缇娅拉的地位与战力</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">表示面板：职业=英雄/等级15/素质4.00/血术5.00/天剑诺亚（攻7·消耗率99%）——人类顶级战力；姓氏=国名（王称名权贵百余名之一，政事由众王共同议定=吞并小国之后遗症）；自诞生起被笼中豢养（深闺）；以拟神之眼可见他人状态；名字：拉丝缇娅拉·弗茨亚茨HP670/689MP312/315职业：英雄</data></node>
    <node id="魔王与勇者(双救世主传说)"><data key="name">魔王与勇者(双救世主传说)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德=凭力量登上王座的『魔王』（如雷贯耳的称号『狂王』『魔王』『支配之王』）；诺斯菲=以纯粹力量统率骑士的『勇者』（南之『御旗』）；二者即『作为传说流传至今的魔王和勇者』、『守护大陆，引导大陆的救世主与救世主』；千年前战争中涡波为『北方同盟』的『骑士团长』、诺斯菲为『南方联盟』的『御旗』；二人皆边走边自愈回复、疾走达技能『缩地』『瞬步』水平、罗德持『剑术』诺斯菲持『枪术』、『魔法战斗』数值恐高于涡波——涡波评其联手则无人能敌、堪称异世界物语的最终Boss；嗯？那不是肯定的吗？再怎么说人家也是凭借力量登上的王座——用涡涡的话来说就是『魔王』大人了哦。；用涡涡的话来说，那诺斯菲就是『勇者』大人了捏</data></node>
    <node id="西娅·勒伽西队伍的构成"><data key="name">西娅·勒伽西队伍的构成</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">成员=领队西娅·勒伽西（据莱纳被称勒伽西家的『人柱』/『笨蛋领队』）+海莉·维斯普洛佩（因伤休养中）+新人莱纳（被队友戴上取不下的特制木手铐/以『兄长大人的记忆』为饵入队）+魔石人类露洁/诺瓦露+艾德（四十层守护者、被称老师）；据点=柯尔库郊外靠近平原的勒伽西家别墅（长期闲置的朴素木屋、被队伍擅自借用）；目的地=帕林库洛处（莱纳问罪/西娅探亲）。露洁/诺瓦露的状态栏名为伊蕾娅斯（ElevenS）与布蕾娅斯（ProtoS）——『看到少女们的名字』确证同指，但红/黑对应关系原文未明示【待确认】；「……等等。为什么你会认识勒伽西家的『人柱』？」；「这就是勒伽西家的别墅了。话是这么说，只是因为长期闲置</data></node>
    <node id="半死体化"><data key="name">半死体化</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾德向帕林库洛提议'不如现在就『半死体化』如何？'（以其维持现姿态则局势一边倒为前提）；帕林库洛答'在这么多人的环境下做得到才怪哦'并称另有安排——多人环境下难以实行（本章仅对话层；库内 ch0080 同源后续另有展开，归 R4）；不如现在就『半死体化』如何？；在这么多人的环境下做得到才怪哦。我可也有我的安排来着啊</data></node>
    <node id="魔石亲和机制（解除与未解除之差）"><data key="name">魔石亲和机制（解除与未解除之差）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛侧：其与『水之理』的亲和被涡波（阳滝魔石再诞过程）成功破除——封住其身体的冰被解开、所有能力值剧烈减少、只剩不怎么擅长的剑术；他误判涡波同样解除（'明明都是解除了与『魔石』的亲和的人，条件不应该是一样的才对吗'）。涡波侧：与魔石的亲和并未解除——'我可是阳滝的哥哥！比我跟阳滝的身体亲和度还高的东西，这个世界上怎么可能存在'（兄妹身体亲和度最高，故仍能构筑最强次元魔术）；「──咕，唔唔！为什么，我打不赢吗！？明明都是解除了与『魔石』的亲和的人，条件不应该是一样的才对吗⋯⋯！！」；「我跟你可不一样！我跟『魔石』的亲和并没有解除！用的身体不对所以就无法发挥『次元之理的盗窃者』的力量了？──那</data></node>
    <node id="史诗探索者现状（ch121更新）"><data key="name">史诗探索者现状（ch121更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本部位于劳拉维亚（涡波旧办公室，现资料文件堆积）；会长一职对涡波永久保留=名义摆设（无权限、无法退出），名号被借作'背地里的实际支配者'以便利办事；公会积极推广涡波'白马王子/英雄'传闻（据缇莉口径）；文案工作由缇莉・琉克负责；格连以末席暂留（失『最强』名号后）；波鲁扎克同待；内部戏称'斯诺粉丝应援会'；受理涡波的宝石变现委托并承诺换成现金；「你说什～么呢。史诗探索者的会长一职永久保留。它永远都是属于涡波君的东西哦？」；「被人认为我们公会背地里的实际支配者是涡波君的话，我们办起事来也会方便不少嘛。你的名号，就借用了哦？」；「你说的没错哦。⋯⋯并且，我们『史诗探索者（斯诺粉丝应援会）』的会长，就</data></node>
    <node id="佩艾希亚（66层里侧城市，ch90）"><data key="name">佩艾希亚（66层里侧城市，ch90）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">66层里侧的绿意祥和城市与『佩艾希亚』之名关联：'再现出佩艾希亚和平安宁的机能今天也运作顺利'（据雷纳尔多：HighSkyBeryl'在『佩艾希亚』也是一等一的物件'）；城市构造——四米高树列合拢构成的信道（树荫光斑）、建在大树上的住宅+以树干为台阶的阶梯、'岂止是宝石和铁器，就连石材都没用上'故城内大树极多；罗德任庭师修剪（'无论走在哪里都没有绝对的阴郁'）；雷纳尔多的宅邸/工房在此；居民照常打招呼【存疑：佩艾希亚指里侧城市本体或其所再现的千年前原型城，原文未明断】；这里依旧是个绿意盎然的祥和城市。再现出佩艾希亚和平安宁的机能今天也运作顺利。；比方说，左右两边并排林立的高度约四米的树木合在一</data></node>
    <node id="莉帕的术式特性（术者言语理解）"><data key="name">莉帕的术式特性（术者言语理解）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莉帕能理解术者（涡波）之言却不能理解诺文之言（'大哥哥的话能够浸透到我的体内…跟那个人的魔力一样的缘故'）；推测=创造者写入的术式（听从术者指示/不被攻击对象的话打动）——具备意识的攻击魔法的合理设计；该设定令涡波涌起渗血级怒火（对莉帕被物化待遇的愤怒）；这很有可能是她被创造者赋予的一种特性。；内心深处涌起了一股令我自己都感到吃惊的怒火，不觉间攥紧的拳头甚至渗出了鲜血。</data></node>
    <node id="『理的盗窃者』法则（不老不死·守护者化·死亡诅咒）"><data key="name">『理的盗窃者』法则（不老不死·守护者化·死亡诅咒）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">本章体系性揭示：①使徒制造出的《理的盗窃者》不老同时不死——'只要留恋还在的话，你们就无法轻易死掉'，罗德·缇缇留恋最为深重；②《理的盗窃者》死后会成为《守护者》，在千年后的《迷宫》里等待具备资格者的到来，'那名具备资格之人应当可以让《守护者》消失'；③死亡之际发动『诅咒』——魂创令身体自判濒死而开始变异、蜕变为半死体，'毫无疑问是最强的力量'；④不老实例：孤'从那一天'起身体年龄固定、身高丝毫不长只有魔力反常膨胀，艾德后亦自行不老化；⑤据涡波声称：成为理的盗窃者的罪过『代价』使其失去某段过去（留恋所在）；——使徒制造出的《理的盗窃者》在不老的同时也是不死的。所谓不死，其实就是说只要留恋还在的</data></node>
    <node id="迷宫怪物掉落机制"><data key="name">迷宫怪物掉落机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">怪物死后随光芒消失（无亡骸）、掉落结晶（魔法石类）；结晶成色与怪物毛色相似（巨狼→翠色结晶）；虫系掉黑虫石（虫属性魔力）；主角经巨狼与黑环萤两例验证此推测；而在狼消失的地方则留有一颗闪耀着翠色光芒的结晶。</data></node>
    <node id="拉丝缇娅拉的消耗（圣诞祭后连续战斗）"><data key="name">拉丝缇娅拉的消耗（圣诞祭后连续战斗）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">眼下起黑眼圈（'至高的美貌产生了些许瑕疵'——原文语）、起身摇摇晃晃站不稳、回答没有气力；涡波归因：'自圣诞祭之后就一直在战斗的缘故'；涡波因顾虑其疲惫而犹豫是否深谈（最终只传达最低限度的事项）；在眼睛下方还起了点黑眼圈，让她那至高的美貌产生了些许瑕疵。；那个拉丝缇娅拉居然摇摇晃晃地有些站不稳。；拉丝缇娅拉的消耗会这么大，都是因为自圣诞祭之后就一直在战斗的缘故。</data></node>
    <node id="升级追忆机制(魔石取回力量)"><data key="name">升级追忆机制(魔石取回力量)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波每次升级→灵魂接近曾经的始祖涡波→产生追忆闪回（守护者们过往姿态鲜明浮现）；此为获得魔力的『次元之理的盗窃者』的魔石取回原本力量的现象；本能告知了最大限度活用该现象的方法——沉入深层心理最底部的黑暗、于睡梦引导下抵达『千年前的梦』之所在；这是每当升级让我的灵魂接近曾经的始祖涡波时便会产生的追忆。；是获得魔力的『次元之理的盗窃者』的魔石取回了原本力量的现象。；为了抵达『千年前的梦』之所在，我在睡魔的引导下沉入了梦乡。</data></node>
    <node id="大灾厄"><data key="name">大灾厄</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">近来的世界级事态：致历基亚国公主（古奈尔）的外交负担加重；古奈尔自称『大灾厄』啥的跟咱没关系（据古奈尔）；只是近来因为『大灾厄』的原因，她作为公主的负担重了起来。就在她为外交事务努力的时候恰好遇到了为船队解围的我和缇缇，总结起来就是这么一回事了──；「不、不妙。这把真心不妙了哇。为啥咱老是要遭这种罪啊。果然就应该老老实实地窝在没有敌人的自宅才对啊⋯⋯『大灾厄』啥的，明明就跟咱没关系的说！」</data></node>
    <node id="海因『再诞』成败之争（ch158双声）"><data key="name">海因『再诞』成败之争（ch158双声）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛声称（据其声称）：海莉='混进了杂质但毫无疑问是海因・赫勒比勒夏因本人'、复活成功且'这次有自信做得更完美'、'只要有『血』的话就可以绕过『魂』'、海莉性别变化系'因为少年的原因'；海莉·莱纳断言：'帕林库洛是没有能力让死者复生的''你在复活海因这件事上失败了'、海莉='以海因为原料创造、持有部分记忆但不是一个人的『再诞』失败劣质品'；涡波立场：'即使到现在我依然认为她就是复苏的海因'但终局仍宣告'他（海因）并不在这里⋯⋯你在骗我呢'；帕林库洛矛盾点自曝：'我那时候是因为成功了才感到悲伤'；我已经证明了只要有『血』的话就可以绕过『魂』这一点了！！；现在存在于此的是『再诞』失败的劣质品，</data></node>
    <node id="『试练』规则补章(ch92)"><data key="name">『试练』规则补章(ch92)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">罗德正为『试练』做准备（对涡波而言合计第五次）；涡波抵达五十层=实行试练最好时机；镇守阶层之守护者所应行之事=除却已备资格者一概不予通行（二人未通过罗德所欲行之试练故不可自此通过）；诺斯菲主张：抵达守护者阶层者有接受试练的义务、且须对『过去』负责任；「直截了当地说，她正在为『试练』做准备。」；得知合计起来算是第五次的『试练』正在逼近，我的思考速度因紧张而更上了一层楼。；「正是，镇守阶层之守护者所应行之事唯一：除却已备资格者，一概不予通行。</data></node>
    <node id="莱文教与异世界的传承（ch70新层）"><data key="name">莱文教与异世界的传承（ch70新层）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉（莱文教现人神）与缇亚（高位关系者）：莱文教传承中有暗示异世界存在的记载；『异邦人』被认为是超出『理』之外的来访者、能更容易地触及『理』（传承暧昧详情不明）；始祖缇娅拉或与异世界有某种联系（推测）；弗茨亚茨图书馆未载此情报（'即使在弗茨亚茨的图书馆里也没有得到这份情报'）；另：二人看到涡波『注视』/『持有物品』时神色不对、欲言又止后强行转移话题——莱文教视角的违和点未言明；「嗯，有的。在莱文教的传承中，有暗示异世界存在的记载……」；即使在弗茨亚茨的图书馆里也没有得到这份情报。；「姑且来说，在莱文教的传承中，『异邦人』这一存在被认为是超出『理』之外的来访者……我记得有提到异邦人能更容</data></node>
    <node id="『世界奉还阵』机制（ch157更新）"><data key="name">『世界奉还阵』机制（ch157更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">用作转换对象的生命已被从地上完全抹去（数万士兵灰飞烟灭）→阵光尚在但亮度大不如前；阵中『连接』难以维持稳定；据涡波推测与千年前的『什么东西』紧密相连；对涡波过去记忆施行『回想收束』——所示记忆为真货，构成'『相川阳滝』的死已经是不可动摇的事实'（据涡波自述）；尽管『世界奉还阵』的光芒尚在，但亮度已大不如前。用于转换的对象、亦即生命的存在已经被从地上完全抹去。会衰弱也是自然。；但是在这『世界奉还阵』之中，要想让『连接』维持稳定化似乎很难办到。；『世界奉还阵』是将我过去的记忆进行了『回想收束』，那是货真价实的事实。</data></node>
    <node id="迷宫31~35层环境与深层之水（ch71）"><data key="name">迷宫31~35层环境与深层之水（ch71）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">31层=沙海（水晶质回廊）；34层起转为石制回廊、表层覆水及膝（栖息Boss伽鲁夫纳多杰里与眷属鱼群）；35层完全浸水（不会游泳无法抵达36层，迷宫有100层之多）；迷宫之水特殊——魔力很难浸透（地面海河可轻易用『维度』把握，卷版表记『Dimension』）；Boss区域水位直达天花板、无法呼吸（WEB144话双源实录）；离开34层之后迷宫内部的构造又变了。；水晶回廊变回了原来的石制回廊，能让人回想到诺文的那些特征都不复存在。作为代替，新阶层的特征是『水』；回廊的表层全部被水覆盖。水位及膝，行进起来相当困难。</data></node>
    <node id="店长背景"><data key="name">店长背景</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">酒馆店长原本是非常有名的迷宫探索者（对蛮横客人寸步不让、怒喷客人数次、为玲小姐解围）——故能在迷宫附近开店；录用不经详细确认、自称眼光不会出错；这家店长原本是个非常有名的迷宫探索者</data></node>
    <node id="千年前婚姻真相(诺斯菲×始祖涡波)"><data key="name">千年前婚姻真相(诺斯菲×始祖涡波)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德揭露+诺斯菲承认+雷纳尔多佐证：诺斯菲是始祖涡波千年前之『妻•子』；婚姻由使徒西斯安排（为将初战败北的涡波吸收进自己阵营，令其与南之『御旗』缔结）；诺斯菲定性=徒具形式的婚姻/充斥虚伪和欺瞒的契约、并未许下爱的誓言，主张承认夫妻关系的国家早已不在故现在不是夫妻；罗德主张『只要共同许下了爱的誓言，那就应该是永恒的关系』并要求涡波回想夫妻生活；莱文教传承无相关记载（涡波推测或为缇娅拉的关照/或自己当作不存在/亦不排除谎言可能）；佩艾希亚居民与千年前登场人物皆知此事；莱纳亦初闻；因为诺斯菲可是涡涡的『妻•子』啊！！；……我•们•并•没•有•许•下•爱•的•誓•言。那不过是徒具形式的婚姻。是充斥</data></node>
    <node id="咏唱代价的失控与依存(罗德)"><data key="name">咏唱代价的失控与依存(罗德)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">咏唱=减轻内心负担之咒；代价=心遭一而再再而三的磨耗；反复使用中『咏唱』渐渐失控、话语伴生不同的意义、简易咏唱变得越来越沉重；激烈争辩后罗德过呼吸、忍受不住而将手伸向『咏唱』的『代价』；呈依存态（瘾君子一般的表情）但双眼中依旧寄宿理性——在咏唱影响下保持冷静、会话仍能继续；究竟是因为激烈的争辩还是感情的压迫呢，罗德表现出过呼吸的症状。；但随着罗德不断使用，『咏唱』渐渐失控，话语中伴生不同的意义。；被凌乱的翠发掩盖的罗德的双眼中依旧寄宿着理性。</data></node>
    <node id="『血』"><data key="name">『血』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">莱纳体内可被诺斯菲之光支配之物（原文表记『血』）：莱纳自述『之前吃过一次亏』故本章决意主要依靠剑战斗；本章光之御旗的目标不是『血』而是莱纳自身；就算『血』会受到支配也无妨。；反正之前吃过一次亏，这次我早就决定主要依靠剑来战斗了。；它要支配的不是『血』而是我自身。</data></node>
    <node id="世界奉还阵（大陆级魔法阵）"><data key="name">世界奉还阵（大陆级魔法阵）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛以使徒勒伽西之力构筑的覆盖拜伦西斯大陆的魔法阵，本名『世界奉还阵』；原型为勒伽西家秘传魔法、帕林库洛幼年改良后引而不发至今；施工方式=『在不被敌人察觉到的情况下对大陆的『魔石线』动手脚』；在南方联盟内为重要机密；已显著提升南军士气；发动后『对面肯定会陷入一片混乱』、北方同盟必将败北；帕林库洛预定在此阵中迎击涡波决战；「为了与我战斗，你会来到这个魔法阵——『世界奉还阵』之中……」；「那个是勒伽西家秘传的魔法啦。然后我在小时候对它进行了改良，引而不发直到现在。一旦发动的话，对面肯定会陷入一片混乱的。」；「真想不到居然能在不被敌人察觉到的情况下对大陆的『魔石线』动手脚……帕林库洛长官实在是一</data></node>
    <node id="『维度・曲战演算』"><data key="name">『维度・曲战演算』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波维度系魔法（本章实战首用）：物理回避不可能时『捩转空间以求改变射线的轨迹』——令『重崩色之非风剑』黑线在即将命中前因次元错位偏折朝空中飞去（边回避边构筑、与罗德同时发动）；「──『维度・曲战演算』！！」；所以真招还是捩转空间以求改变射线的轨迹。；因为次元的错位，它改变了轨道朝空中奔驰而去。</data></node>
    <node id="『光之理的盗窃者』"><data key="name">『光之理的盗窃者』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲的称号——风之试练终结后'现在就只剩下『光之理的盗窃者』要解决了'；其战场因六十六层表里重合而移至草原，遭涡波、缇缇、莱纳三对一合围；现在就只剩下『光之理的盗窃者』要解决了。；如今我和缇缇还有莱纳三个人对诺斯菲形成了合围，局势由二对二转变为了三对一。</data></node>
    <node id="雪与魔力结晶(冬之异世界的物证)"><data key="name">雪与魔力结晶(冬之异世界的物证)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">此世界的『雪』=魔力结晶： ordinarily 只在大陆北方可见的罕见之物（众人魔力结晶魔力结晶地称呼）；涡波经上空水分凝结魔法在竞技场内人工降雪（气温下降+湿度上升+密闭结界=只此一日此地可行的条件）；诺文儿时见过雪（怀旧）；诺文用手接取飘舞于空中的白色结晶，语气十分疑惑。；「见是见过……但是，真是不敢置信。居然能在这种地方看到……照理说，『雪』是只有在大陆北方才能看到的东西……」</data></node>
    <node id="『亲和』机制"><data key="name">『亲和』机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与魔石产生『亲和』可获取信息（西娅以『缇达的魔石』为对象；玛利亚督促其把精力放在亲和上、信息量仍不够用、西娅已至极限）；本次实验收获=只有血缘的联系还不够；涡波回想『火之理的盗窃者』阿尔缇与『暗之理的盗窃者』帕林库洛两人的终幕中也提到过『亲和』这个词；「只不过就是把迷宫的入口堵死而已。比起这种事，西娅还是把精力放在『亲和』上吧。因为就刚才获得的那些信息根本就不够用啊」；并且在听到『亲和』这个词之后，我回想起了『火之理的盗窃者』阿尔缇以及『暗之理的盗窃者』帕林库洛两人的终幕。她们两人口中也提到过『亲和』这个词。；就把得知只有血缘的联系还不够这点当做此次的收获好了</data></node>
    <node id="罗德的返老还童与『孤』自称(风之咏唱代价)"><data key="name">罗德的返老还童与『孤』自称(风之咏唱代价)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据罗德：利用风之咏唱的『代价』『姑且让孤变回了曾经的样子』——非变老而是返老还童、『总算是变回孩子了』；老成语体为其原本风格（自述千年前因时日太久年纪太大、说话方式糟得不成样子）；翠色马尾解开；自称由日常体转为『孤』；涡波以『表示』确认其为本体罗德（【五十守护者（FiftyGuardian）】风之理的盗窃者）；罗德称呼自己为『孤』。；【五十守护者（FiftyGuardian）】风之理的盗窃者；「算是利用了风之咏唱的『代价』吧，姑且让孤变回了曾经的样子。」</data></node>
    <node id="斯诺的怠惰成因（反复失败史）"><data key="name">斯诺的怠惰成因（反复失败史）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据斯诺自述：曾是干劲满满怀梦的少女（幼年任副会长）→『失败了·一·次·又·一·次』后认定努力太傻→怠惰慵懒随波逐流（对结婚/人生皆『无可奈何』式放弃）；认定与涡波有同族意识（同类惨痛失败者）；提及失败时面容扭曲=初见认真表情；「……那个时候，我还只经历过一次失败，所以充满了希望。可是在失·败·了·一·次·又·一·次之后，就觉得努力实在太傻了。于是我就变·成·这·样·了。仅此而已，就这么简单。」；「……嗯，我觉得这可能是出于同族意识吧。因为我知道涡波跟我一样都是经历过惨痛的失败的人。」</data></node>
    <node id="相川涡波的技能板（ch145数值公开）"><data key="name">相川涡波的技能板（ch145数值公开）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">原文公开（涡波自视）：先天技能 剑术4.89·冻结魔法2.58＋1.10；后天技能 体术1.56·次元魔术5.25＋0.10·感应3.56·并列思考1.48·编织物1.07·诈术1.34·魔法战斗0.73·锻造0.69；其下为两层不可见技能『？？？』『？？？』——第一层=一直带来麻烦的技能『？？？』，第二层涡波自认知见应为『异邦人』、海莉断言其下藏『素体』；先天技能：剑术4.89冻结魔法2.58＋1.10；后天技能：体术1.56次元魔术5.25＋0.10感应3.56并列思考1.48；一直带来麻烦的技能『？？？』</data></node>
    <node id="次元戒指"><data key="name">次元戒指</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">基督赠给莱纳的戒指：于本章突然破碎，溢出的魔力无关莱纳意志擅自构筑起魔法（次元属性），由风之臂发动——自『什么也没有的空间』拔出圣剑片翼；紧接着，就像是证明这点一般，基督赠给我的『次元戒指』突然破碎。；更进一步地，从戒指中溢出的魔力无关乎我的意志擅自构筑起了魔法。；「这个魔法，不是『风』⋯⋯？难不成是、『连接』⋯⋯？」</data></node>
    <node id="魔石的世界价值与帕林库洛战力构成（ch163）"><data key="name">魔石的世界价值与帕林库洛战力构成（ch163）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">魔石'只要一颗在手就能得到与一国之力匹敌'；帕林库洛能与涡波争锋全凭体内『暗之理的盗窃者』魔石（涡波评：'这个魔石可谓是万恶之源'）；其黑刃以黑色液体构成、可增质强化，液体可被水之理冷气冻结而衰减；魔力被封后其对怪物召唤、四肢修复、液体操纵、魔法构筑均无能为力——'搞不好现在的他就连一个小孩子都打不过'；对这只要一颗在手就能得到与一国之力匹敌的魔石，帕林库洛的态度就像是对待不小心掉在地上的零钱一样。；不管是对怪物的召唤，还是四肢的修复，就连对液体的操纵和魔法的构筑也做不到了，他已经无能为力了。</data></node>
    <node id="『这里』补充法则(ch92)"><data key="name">『这里』补充法则(ch92)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">不论发生什么、国民（居民）不得进入城中——贝丝等居民因『不是城里的人』而困于城门外，构成『这里』的又一条法则；与此并行：罗德恢复精神、诺斯菲任性与留恋消解等变化接连发生=千年前因缘三人齐聚令千年停滞的佩艾希亚开始产生变化；「诶？因为，我们不是城里的人啊。所以，才会像这样感到困扰。」；不论发生什么，国民都不得进入城中。他们的困境暗示了『这里』的又一条法则。；先是我的现身、接着是与罗德的邂逅，再之后是诺斯菲的登场，随着为千年前的因缘所纠缠的三人在『这里』齐聚，始终停滞不前的佩艾希亚产生了变化。</data></node>
    <node id="大灾厄后世界生态（大型怪物增生）"><data key="name">大灾厄后世界生态（大型怪物增生）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据斯诺：从那场『大灾厄』之后世界各地就一直是这个模样，但交通流量没有受到太大影响——盗贼的数量相对减少，公路上行进的危险前后无太多变化；涡波直感：本土有不少大型怪物、虽不频繁遭遇但因『维度』拓展范围很广而有泛滥错觉（旅途屡次绕行、时间拖长）；成因三说并存——帕林库洛的『世界奉还阵』暴走所致吗（涡波推测）／大地的崩壊改变了怪物的生存环境／据说被蕴藏在世界底部的魔力发生泄漏（斯诺转述）；缇缇据千年前经验投魔力原因一票；「从那场『大灾厄』之后，世界各地就一直是这个模样了呢。不过，交通流量倒是没有受到太大的影响。因为盗贼的数量也相对减少了啊。在公路上行进的危险前后并没有太多变化」；「原来是这样啊⋯⋯不</data></node>
    <node id="魔石『门』之戒指"><data key="name">魔石『门』之戒指</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">寄宿『门』之力量的魔石戒指：自『所有物』取出、灌注魔力后捏碎，一连串魔法构筑造出魔法门（『连接』用）；为海莉所持，以其仅有的魔力发动；──魔石『门』之戒指；寄宿着『门』的力量的戒指──；在我的目送下，海莉使用仅有的魔力捏碎了戒指。接着，一连串的魔法构筑便造出了魔法门。</data></node>
    <node id="船内人际平衡与'人不会轻易变坚强'论"><data key="name">船内人际平衡与'人不会轻易变坚强'论</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莉帕：这艘船的平衡'如此勉强地维持着，已经完全超过欧尼酱你的想象'；大家'表面上看起来是改变了，但是实际上只是把激烈的感情隐藏起来了而已'（引斯诺'人是不会那么容易就变坚强的'，并以自己对诺文分别未愈为例）；涡波'大家都经历了试炼……我想要相信'之盼被技能群与莉帕齐否定；……总而言之，这艘船的平衡现在是如此勉强地维持着，已经完全超过欧尼酱你的想象了。一定要注意哦？你都那么凛然地与诺文送别了，要是没过几天就因为被女人捅死而在那个世界里与挚友再会了的话，诺文就实在太可怜了呀；就像斯诺姐姐说的那样，人是不会那么容易就变坚强的哦，欧尼酱。大家啊，虽然表面上看起来是改变了，但是实际上只是把激烈的感情隐</data></node>
    <node id="火焰感知视觉（玛利亚）"><data key="name">火焰感知视觉（玛利亚）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">玛利亚自剜双目后获得的代偿：双手撑出空间造火焰即可感知周围环境信息（阿尔缇同款能力——魔石入体的继承）；『只要有火我就能看得见』；「没事的，只要有火我就能看得见。</data></node>
    <node id="魔石人类于世界奉还阵中心的存在限制（ch158实录）"><data key="name">魔石人类于世界奉还阵中心的存在限制（ch158实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">海莉作为『魔石人类』'是不能出现在这里的。是不可能也不应该出现在这里的'；其身体持续溶解（以风魔法中和阵影响但'根本算不上完美'，死亡确实迫近，久留将与先前士兵同运）；莱纳身体同样溶解中；两人均为高级别骑士、'一时半会儿是不会完全溶解的'；海莉级别16（曾达30多级、约减半）HP73／176 MP82／265－100 职业无——身体状况恶化未见好转；毕竟作为『魔石人类』的她，是不能出现在这里的。是不可能也不应该出现在这里的。；尽管她在使用风魔法中和『世界奉还阵』的影响，但是根本算不上完美。；她们两人都是高级别的骑士，一时半会儿是不会完全溶解的吧。</data></node>
    <node id="技能速习法（涡波·诺文论）"><data key="name">技能速习法（涡波·诺文论）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺文所言（经『编织』『诈术』习得证实）：与领域专家重复'训练/比试'行为即可习得对应技能——『魔法战斗』←与拉丝缇娅拉训练；『锻冶』←与锻冶师们比试观察；支撑=『并列思考』迅速学习＋『维度』信息处理；代价=MP与体力骤减、体温骤升；无需本人以往经验（'并没有我亲自去的必要'）；我回想起昨天与战斗专家拉丝缇娅拉的训练中，自己学会了『魔法战斗』这个技能。也就是说，只要再重复这个行为就行了。；只要在这里，从现在开始，与锻冶技术的专家们比试一番，学会技能『锻冶』就行了。；既然已经学会了『编织』『诈术』，证明了诺文所言不虚，就有尝试的价值。</data></node>
    <node id="艾德（木之理的盗窃者）的能力体系"><data key="name">艾德（木之理的盗窃者）的能力体系</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">四十守护者（FortyGuardian）·木之理的盗窃者（位阶四十守护者）——被海莉们解放后随队、被称『艾德老师』。能力全在辅助/回复侧：自称『只要人还没死就续得过来…治疗领域无人可出鄙人之右』、不会任何攻击魔法（至多用回复光干扰注意力）、辅助魔法只对真正的人类效果最好；对露洁诺瓦露的究极强化=Growth/SensePress/BranchwoodSheild（身体强化24.77/魔力强化30.98/魔法障壁3.28——数十倍级、『超越理的魔法』）；领域=CarefulField/StrengthField/RemoveField（广域回复+辅助、庭院化为草原、似迷宫第四十层）；另有『Sle</data></node>
    <node id="『天上的七骑士』"><data key="name">『天上的七骑士』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一年后体制：拉古涅自称就任总长并把持大圣堂全部警备；前总长佩露修娜与副总长因战争出差；莱纳（原席）获复归邀请被其暂缓（'还没有回过老家通报一下'）；莱纳曾以原七骑士身份为后盾威压警备骑士。※原文另作『天上之七骑士』（ch49译段变体）——近名并合留R4（判例4）；「呼呼呼～。其实我，最近当上了『天上的七骑士』的总长哦！所以，这里的所有警备工作都在我的把持之下喽！」；因为佩露修娜总长和副总长因为战争而出差了的缘故；现在就复归『天上的七骑士』怎么样？</data></node>
    <node id="传说终末的真相（无人死亡的最温柔讨伐）"><data key="name">传说终末的真相（无人死亡的最温柔讨伐）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">千年前『北』与『南』大战的结局实况（本章记忆亲见，颠覆'始祖涡波应会因缇娅拉的讨伐而迎来死亡'的既有传说口径）：两人在生息嚼类已不留一人的死之荒野上迎面而立，经过数度争吵后上演天裂地吞的幻想性激战（与玛利亚和帕林库洛的战斗同级），但这场最后的战斗根本没有人死——缇娅拉持续高呼'阳滝姐还活着'说服暴走的始祖涡波，其愤怒渐渐缓和、在希望之光的照耀下渐渐丧失战意，最终跪倒在地像个孩子一般失声痛哭；她用这个世界上最温柔的讨伐方式打败了『怪物』（缇娅拉手中寄宿着希望=青色魔石）；在那生息嚼类已不留一人的死之荒野上，『始祖涡波』与『缇娅拉』迎面而立。；根据传说，在这之后始祖涡波应该会因缇娅拉的讨伐而迎来死</data></node>
    <node id="『缇娅拉大人的再诞』计划（ch220）"><data key="name">『缇娅拉大人的再诞』计划（ch220）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据塞拉：目标=令沉眠于拉丝缇娅拉体内的缇娅拉大人再诞；前提=回收寄宿于一年前量产『魔石人类』中的『圣人缇娅拉大人的血』（回收作业进行中）；决意源=一年前经『木之理的盗窃者』的魔法所见缇娅拉记忆（判其心地善良又极其强大、确信能助涡波）；替代案玛利亚『提高级别』建议未被接受；容器=大圣堂地下已逝少女；'这一年来，所有的准备基本都已告成'（余下话头由拉丝缇娅拉亲自接手）；莱纳以'既然自己没办法帮助想要帮助的人，那就将能够帮到他的人从千年前呼唤过来'概括之；「──在一年前被量产出来的『魔石人类』当中有寄宿着『圣人缇娅拉大人的血』的人。大小姐和我们现在就在进行相关的回收作业」；所以我们便以『缇娅拉大人的</data></node>
    <node id="缇亚的真实人格(虚荣与逞强)"><data key="name">缇亚的真实人格(虚荣与逞强)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉评：缇亚是个虚荣的孩子，特别喜欢在『基督』面前逞强——晕倒时最稳定；等醒了的时候涡波说要破坏什么她都会毫不犹豫照办；对重视约定和章法的缇亚来说假名无法接受（呆然无声）；「不是哦，这才是这孩子真正的样子。因为缇亚是个虚荣的孩子，所以特别喜欢在『基督』面前逞强呢。」；「缇亚大人在晕倒的时候是最稳定的，这样就可以放心了。」</data></node>
    <node id="涡波后天技能一览（ch129状态栏）"><data key="name">涡波后天技能一览（ch129状态栏）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">体术1.56／次元魔术5.25＋0.10／感应3.56／并列思考1.47／魔法战斗0.72／诈术1.34／编织1.07／缝纫0.68（本章新得）／锻冶0.69；技能增加自评如'集邮'有'收藏家般的满足感'；'等到一切都结束之后'或从事服饰相关工作的念头；──后天技能：体术1.56次元魔术5.25＋0.10感应3.56并列思考1.47魔法战斗0.72诈术1.34编织1.07缝纫0.68锻冶0.69──；如果等到一切都结束之后，我去从事跟服饰有关的工作也不壊呢。；看着一点点增加的技能，我微微一笑。</data></node>
    <node id="迷宫中部的自净与掉落"><data key="name">迷宫中部的自净与掉落</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">死在迷宫中的怪物不留尸体只留魔石；迷宫具自净能力（吞噬遗留物——如缇亚断手被迷宫吞噬不可回收，或有以垃圾秽物为食的怪物）；眷属不因Boss死亡而消失（狂怒袭来）；死在迷宫之中的怪物并不会留下尸体，会留下的只有被唤作魔石的矿石罢了。</data></node>
    <node id="魔法『FlameAccel』（雷纳尔多）"><data key="name">魔法『FlameAccel』（雷纳尔多）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷纳尔多的魔法：发动后豪腕揪住涡波脖颈、以强大力量将其甩向宅邸深处——用于中断涡波对贝丝的说服并强制使其离场（来自友方的意外攻击，涡波无法及时回应）；「──『FlameAccel』」；雷纳尔多的豪腕揪住了我的脖颈，接着一股强大的力量直接将我甩向后方。</data></node>
    <node id="『大灾害』（一年前）"><data key="name">『大灾害』（一年前）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波判读=其与帕林库洛之战；『世界奉还阵』吞噬多人；世界由艾德一年间重振；『境界战争』因其暂告休战；说起一年前的『大灾害』话，应该就是我和帕林库洛战斗的那件事。；在那场『大灾害』中明明『世界奉还阵』吞噬了那么多人</data></node>
    <node id="『DistanceMute』的真髓与正确运用"><data key="name">『DistanceMute』的真髓与正确运用</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波本章自述：『DistanceMute』的真正力量并不是收割敌人的生命，它是为了将寄存于重要之物当中的宝贵记忆留存于世而被创造出来的魔法。本章运用：①如第一次对桌子做过的那样，从罗德的『绘画』中抽取魔石（蕴藏魔力微弱却散发阵阵令人温暖的翠色光芒），挪入先前被罗德的魔法震断的左手掌；②最后借助其力量将左臂直接刺入罗德体内——因『正确运用』，罗德甚至没有注意到刺入胸口的左臂；这『DistanceMute』的真正力量，并不是收割敌人的生命。它是为了能像现在这样，将寄存于重要之物当中的宝贵记忆留存于世而被创造出来的魔法。；然后就像我第一次对桌子做过的一样，将魔石从这些『绘画』中抽取出来。；因为『D</data></node>
    <node id="『魔石线』零魔力脉动异常"><data key="name">『魔石线』零魔力脉动异常</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">正文叙述的不可能现象：帕林库洛到头来没有成功用出魔力、右臂中连一滴魔力也没有流通，但『世界奉还阵』却开始了脉动——按理即使魔术式和魔力本身已在『魔石线』中备妥，若没有外界魔力的触发就不会有任何反应（为成功干涉魔法阵那一滴魔力无论如何都必要）；『魔石线』却如回应其愿望般再次发光并剧烈震动→大地如被捏碎的饼干般到处龟裂（与方才的怪物召唤现象相似、规模云泥之差）——启动条件异常的机理未明；到头来，帕林库洛仍然没有成功用出魔力。他的右臂中就连一滴的魔力也没有流通。；──然而，『世界奉还阵』却开始了脉动。；接着大地就像是块被捏碎的饼干一样到处都是龟裂。</data></node>
    <node id="『迷宫』的不完全诞生（规则拔除）"><data key="name">『迷宫』的不完全诞生（规则拔除）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『迷宫』=始祖涡波相当久之前的旧计划重启（'──就是『迷宫』啊'）：目的为实现让被大陆吞噬的『魔石』『想起收束（Drop）』的系统+开拓通往世界『最深部』的道路；缇娅拉的抽魔石术式将被施加于『迷宫』之中（'只要这个『迷宫』完成的话，阳滝肯定能够复活'）；由始祖涡波在战争终结的遗迹打造；因勒伽西背刺，完成只差一步——未及施加与『记忆』和『守护者』有关的『规则（Rule）』、未给『迷宫』和『技能』起好名字，始祖涡波被吞没到『迷宫』之中，作为核心的『迷宫』的『规则』就这样漂亮地被拔除；不完全的『迷宫』/『技能』/『记忆』/『魂』——即诺文会做出「不合他风格」评价的原因，也是涡波失去记忆的原因；「没错</data></node>
    <node id="魔法屋的现状（一年后·ch219）"><data key="name">魔法屋的现状（一年后·ch219）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">瓦尔德街角如旧书店般不张扬的魔法屋（一年前涡波与玛利亚造访过；店员姐姐经营）：大型店买不到的少见魔石此处有售且可每种备双；院内有供常客使用的魔法练习场（购魔石者同样可用）；一年间景气不少——当初空无一人的练习场现有多组探索者（含比艾尔更年幼但级别不低的孩子）；就像坐落于街道角落的不为人知的旧书店一样，既不张扬又不显寒酸。；「──嘿诶～，要的都是些少有的魔石呢。我想想，现在店里正好有卖。我这就去给你拿来」；除了我们和艾尔君他们以外，院子里还有大概两组的探索者。当初我和玛利亚来这里的时候整个练习场空空如也，由此看来这一年里这家店也景气了不少。</data></node>
    <node id="阿雷亚斯家剑法"><data key="name">阿雷亚斯家剑法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据菲洛（原骑士）鉴别：阿雷亚斯家为『剑圣』辈出之家；涡波登船战所用剑技即其家剑法——'一眼看去似乎很迟缓，但其中却蕴含着精练到极致的『技能』'；但涡波的剑法'比我至今为止见过的任何一个骑士都要沉着，都要优美'，胜过名闻一国的剑术家/著名的剑术大赛优胜者/任何一位阿雷亚斯家的贵族骑士；一眼看去他的剑招似乎很迟缓，但那其中却蕴含着精练到极致的『技能』。多亏曾是骑士之身我才明白。那是『剑圣』辈出的阿雷亚斯家的剑法。；但是少年的剑法，却比我至今为止见过的任何一个骑士都要沉着，都要优美。</data></node>
    <node id="『表示』与『拟神之眼』的性能差（ch116）"><data key="name">『表示』与『拟神之眼』的性能差（ch116）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自述比较：『表示』可将状态数值显示至小数点后两位（0.00）；『拟神之眼』（拉丝缇娅拉固有）看不到小数点，装备物品与道具也看不了，怪物等生物情报部分可见、无机物情报完全得不到——涡波技能性能更高（拉丝缇娅拉亦认可）；拉丝缇娅拉自述看到『异邦人』显示故信涡波出身；『所有物』被评'更了不得'，据拉丝缇娅拉推测为次元魔术与古代魔法的应用（推测态）；涡波当初曾疑视网膜被动手脚，现已接受其为魔法；「然后就是关于涡波的能力的事情了呢⋯⋯⋯感觉涡波的『表示』，要比我的『拟神之眼』级别更高啊⋯⋯」；就我来说，能够将状态的数值一直表示到小数点后两位0.00的地步。但是拉丝缇娅拉则根本看不到小数点。而且装备</data></node>
    <node id="世界奉还阵（第八卷终战状态）"><data key="name">世界奉还阵（第八卷终战状态）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">海莉不用体内魔力、自铺展大地的『魔石线』汲取阵中魔力转化为魔法，将阵变为自己的友方（帕林库洛判定其手段：故意让身体被溶解以进入魔法阵『内部』，故其魔法远超以往水准）；阵因海莉之故『变得乱七八糟』（据帕林库洛言）；阵的光芒变强但较最初黯淡、较之前的极光有些发黑（『暗之理的盗窃者』的魔力所致）；帕林库洛宣言彻底完成阵为其唯一剩路；阵之『中心』即迷宫第二十层（暗之理的盗窃者帕林库洛的阶层）；三人于洞穿世界的穴中坠往阵下『最深部』；而是从铺展在大地上的『魔石线』中汲取魔力，并将之转化为魔法。毫无疑问，她将『世界奉还阵』变为了自己的友方。；「──！？你是为了进入魔法阵的『内部』才故意让身体被溶解的！？但</data></node>
    <node id="玛利亚的火焰魔法体系（全魔力解放）"><data key="name">玛利亚的火焰魔法体系（全魔力解放）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『闪耀吧炎剑』宣言后火焰变逆十字架之『剑』——高度远超云层、体积足以吞噬城镇且持续膨胀；『将地平线一同斩裂』之『Flame·火焰之剑』横扫——如海啸席卷、战场炼狱化、有意避开涡波（飓风眼）；续转『Flame』『Flamberge』：剑芯红→白（阿尔缇同级）→白金→近乎透明圣光（呼阿尔缇之名后）；『Flamberge』连同『耐性』这个『理（Rule）』也一并烧尽（无视抗性熔化DeepDurahan）；咏唱的代价类似性（呐喊转变为火焰）；代价=MP枯竭并削减最大HP；无通常攻击手段、只可魔法（燃料消耗远大于涡波）；没有通常攻击手段的她战斗方式只有使用魔法一途。不管再怎么擅长操纵魔力，燃料终究要比我</data></node>
    <node id="第五十层『这里』的构成法则"><data key="name">第五十层『这里』的构成法则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『这里』=始祖创造的以实现罗德的愿望为规则的空间；这五十层的世界=罗德其人之写照，是经罗德之手诞生的只为了罗德而存在的罗德所期望的阶层——故在这里唯有罗德的『绘画』绝对不会被破壊，无论什么人都破壊不掉。现状：已没有什么『北方』和『南方』的概念，岂止国家连大地都已化作虚无，敌人也好家人也好全都不存在；世界被罗德的飞踢搅得一团糟；因为『这里』是始祖创造的以实现罗德的愿望为规则的空间。；而这五十层的世界又是罗德其人之写照，是经罗德之手诞生的只为了罗德而存在的罗德所期望的阶层。；所以在这里，只有这些画绝对不会被破壊。无论什么人都破壊不掉。</data></node>
    <node id="弗茨亚茨城"><data key="name">弗茨亚茨城</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">南方首都（使徒所在之城，与诺斯菲·弗茨亚茨同姓）；罗德与涡波沿国境南下、沿非战争地带接近其后方时与诺斯菲遭遇；双半死体激战波及城下——'就像被上千道飓风席卷过后那样，南方的首都濒于崩坏'（此主要由南方的救世主诺斯菲所致）；在那之后，孤与涡波一同沿国境南下，前往使徒所在的弗茨亚茨城。；就像被上千道飓风席卷而过那样，南方的首都濒于崩坏。</data></node>
    <node id="北方战线现势与暗杀计划公开（ch226）"><data key="name">北方战线现势与暗杀计划公开（ch226）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">北方同盟盟主=『支配之王（Lord）』；艾德暗中操纵『北方』；缇缇宣告二人将经她与涡涡等之手消失；预断'再过几天『北方』的统一战线就会崩溃'；据缇缇：联合国上层的现人神拉丝缇娅拉・弗茨亚茨指示斯诺配合暗杀计划（叙述注明缇缇'添油加醋地让理由变得圆润'）；因为作为北方同盟盟主的『支配之王（Lord）』将会消失。同时，在暗地里操纵『北方』的『艾德』也一样会消失；联合国上层的现人神拉丝缇娅拉・弗茨亚茨</data></node>
    <node id="佩艾希亚战争时代再现（ch196实况）"><data key="name">佩艾希亚战争时代再现（ch196实况）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波陈述：『这里』到处都是千年前的『始祖涡波』的敌人；时间拖得越久敌人增加的越多；且尽是些涡波完全没有印象、却习惯于与其战斗的骑士——与迷宫怪物不同，这里每个人都在思考抓住他；其他骑士已『不成器地在这里磨耗殆尽（迎来终结）』（据贝丝语），唯贝丝记忆连续例外；我的──不对，这里到处都是千年前的我『始祖涡波』的敌人。时间拖得越久，敌人增加的越多。而且还尽是一些明明我对他们完全没有印象，但是他们却习惯于与我战斗的骑士。；跟迷宫里的怪物不同，这里的每一个人都思考着想要抓住我，实在是麻烦至极。；虽然其他人似乎都已不成器地在这里磨耗殆尽（迎来终结）了</data></node>
    <node id="『异邦人召唤』术式"><data key="name">『异邦人召唤』术式</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者阶层在人类初次抵达时发动『异邦人召唤』术式、将『理的盗窃者』唤醒（涡波此前只知守护者会被召唤、不知术式之名）；该术式现况=如无使用者的魔法般状态；诺斯菲与执行召唤的术式『交流』、将五十层召唤对象由罗德改为自身（自称篡改关系到迷宫根底的术式很容易）；「对了，现在的涡波大人是不知道的来着？这个呢，是守护者的阶层在人类初次抵达的时候，发动『异邦人召唤』的术式，将『理的盗窃者』唤醒的现象。」；「没错，原定应在五十层得到召唤的确实是罗德。不过，就在不久前，我与执行召唤的术式进行了『交流』，将召唤对象从罗德转变为了我自己。；诺斯菲轻描淡写地表示，自己篡改了关系到迷宫根底的术式。</data></node>
    <node id="魔人（起源·南北认识分裂·兽人改称案）"><data key="name">魔人（起源·南北认识分裂·兽人改称案）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">'突然出现在世上的种族——特指身体带有怪物的特征的人'；据当时学者解释：因『世界的毒』影响致身体向怪物方向演变；北方出现数量远多于南方——北方视作特性、南方视作病症；南方诸国采彻底铲除国策引发北方反冲，爆发将大陆一分为二的战争（战初各地掀起魔人狩猎）；艾德宏愿：'总有一天要将『魔人』这个词从世界上抹去'，因'魔'字污秽联想而改以'能让人联想到自然的恩惠'的『兽人』——需整合大陆、耗时几百年甚至一千年；『魔人』——那是一个突然出现在世上的种族——特指身体带有怪物的特征的人。；而其结果，就是大陆南方的诸国采取了将『魔人』这一存在彻底铲除的国策，由此引发了大陆北方的反冲——于是爆发了将大陆一分为二的</data></node>
    <node id="守护者力量=残存留恋总量机制（ch209实证）"><data key="name">守护者力量=残存留恋总量机制（ch209实证）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">同为守护者而魔力量明显不同——'残存下来的留恋的总量之不同直接的反映在了力量上'；缇缇因接受大家的送别、留恋半分解消致存在微弱而被压制；诺斯菲留恋深重获相当程度强化（重伤亦危及生命）；明明两人同为守护者，但是明显的魔力的量却不同。；结果，残存下来的留恋的总量之不同直接的反映在了力量上，缇缇变成了被压制的一方。；虽说因为留恋深重赋予了她相当程度的强化，但这似乎也是危及生命的重伤。</data></node>
    <node id="回复魔法与千年前记忆共有（据拉丝缇娅拉）"><data key="name">回复魔法与千年前记忆共有（据拉丝缇娅拉）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：涡波那时候受到了跟她一样的回复魔法，因此肯定也看到了千年前记忆的片段——她以此责问涡波对缇娅拉之事闭口不提、却只想和她在一起（把缇娅拉大人看作烫手山芋）。；竟然还跟与她神似的『魔石人类（我）』告白什么的；既然涡波那时候受到了跟我一样的回复魔法，那他肯定也看到了千年前记忆的片段不是么。</data></node>
    <node id="战场兵力规模（据帕林库洛称）"><data key="name">战场兵力规模（据帕林库洛称）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据帕林库洛战场宣言：南方兵力将近两万、北军一万五千左右、袭向玛利亚的怪物大军数量迟早会达到三万（牵制涡波离玛利亚的话术成分存疑）；「喂喂，真的要把小妹妹一个人抛下不管吗？这场战役南方的兵力可有将近两万。北军也有一万五千左右。袭向小妹妹的怪物大军数量迟早会达到三万哦」</data></node>
    <node id="『连接』的安否确认"><data key="name">『连接』的安否确认</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『连接』机制：莉帕留在船上时可借此确认探索队伍的安否；若莉帕同行则船侧无法得知队伍状况——本章莉帕同行致玛利亚在甲板担心等到夜晚；涡波据此定'尽可能跟莉帕分开行动'方针（本章写法『连接』，与库内『联结』疑同名异写）；如果莉帕留在船上的话还能够通过『连接』确认我们的安否，但是这一次她也同行的话，船这边就没办法得知我们的状况了。</data></node>
    <node id="塞拉的『兽化』（ch126）"><data key="name">塞拉的『兽化』（ch126）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">塞拉可『兽化』——兽化后以口咬住莉帕的衣服携带其逃至安全地带（遭遇战撤离行动）；塞拉则『兽化』后咬着莉帕的衣服带着她逃到了安全的地带。拉丝缇娅拉也一样躲开了。</data></node>
    <node id="斯诺的龙化后遗症（右臂硬化·ch226确认）"><data key="name">斯诺的龙化后遗症（右臂硬化·ch226确认）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">一年间右臂显著变化：皮肤硬化致右肩附近体征不再呈人类样貌（衣服掩盖、由涡波『维度』看破）；叙述推断为过度使用『龙化』的后遗症；'仅仅过去一年就到了这等地步'→数年后恶化可期（'时隔十年斯诺想必会彻底──'话头中断）；因为皮肤的硬化，她右肩附近的体征已经不再是人类的样貌了。恐怕这是她过度使用『龙化』的后遗症吧。；仅仅过去一年就到了这等地步，那么不难想像再过数年会是何种模样。</data></node>
    <node id="Foam转移战术机制"><data key="name">Foam转移战术机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『Foam』的泡沫可转移到接触物（如敌方剑身）上：被转移处的空间被特化、范围缩小→『Dimension·决战演算』专注该物动向，剑动作精确到毫米级实时反馈——对剑士战超绝优势；战斗后以想像撤销；精度也大幅提高，可以将双方的剑的动作精确到毫米级并且实时反馈给我。</data></node>
    <node id="龙的生态与屠龙经济学"><data key="name">龙的生态与屠龙经济学</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据斯诺：黯淡之龙=『不划算的龙』（强但悬赏低——只做生存必要最低限度的掠夺故优先级低，'只是因为别的龙都死了，所以舍弃了荣耀苟活着'）；联合国开拓地原有另三条强欲之龙（焚村/袭街/食人/掠宝→高额悬金→讨伐者被反杀不少→最终全被格连讨伐——斯诺此段目光游移被Dimension捕捉说谎，谎点未明）；龙人=体内流着龙的血（斯诺对龙的同情推测）；怪物尸体不化光=迷宫特有（迷宫被编入相应术式）——迷宫外首例尸体实证；「不至于不可思议。不如说，『黯淡之龙』至今一直没有被讨伐反而是理所当然的。」；斯诺是龙人，她的体内流着龙的血，或许是有所同情吧。</data></node>
    <node id="魔力捩转生成法（三段构筑·ch219）"><data key="name">魔力捩转生成法（三段构筑·ch219）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波本章确立的跨属性发动法：①集中于自己的『血』、以刻在血中的魔术式为基础构筑『维度・决战演算』并指向自身以加强自我认识；②『DistanceMute』如手术般伸手入胸在释放魔力的魔石（魂）上打造『连接』；③『Shift』将自魔石（魂）溢出的所有魔力予・以・捩・转——次元的『扭曲的魔力』进一步扭曲变换为异属性（铸回『冰冷的魔力』）；魔力生成牵强但构筑如教科书般标准；『冰之矢』本体消费3而三段事前准备共耗十倍；最后，我将从自己的魔石（魂）中溢出的所有『魔力』予・以・捩・转。；次元属性那『扭曲的魔力』发生了进一步的扭曲，由此变换为完全不同种属性的魔力。我要铸就的是我以前使用的『冰冷的魔力』；按照资</data></node>
    <node id="斯诺的心灵诊断(拉丝缇娅拉)"><data key="name">斯诺的心灵诊断(拉丝缇娅拉)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺的心灵很幼小：身体长大+拥有比任何人强的力量但心灵完全没有发育——大概从陷入绝望的那一天起心灵就一直没有成长；成熟得浪费的肉体+孩子的心灵（与拉丝缇娅拉同型）；未能觉察自己异常的恋慕之心；被喜欢的人彻底讨厌的恐惧=新枷锁；虽然身体长大了，又拥有比任何人都要强的力量。但心灵却完全没有发育。；她和我一样，都有一具成熟得浪费的肉体，可心灵却只是个孩子。</data></node>
    <node id="六十层休憩空间特性（光辉石之层）"><data key="name">六十层休憩空间特性（光辉石之层）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">六十层由光辉石的大理石构成；光充满全层却不灼烧眼睛、照在身上令人冷静；房间清净使体力与MP得到充分恢复；层主诺斯菲能察觉敌人侵入本层、休憩无需戒备四周；若诺斯菲保持友好、这里的休息空间可谓不错的地方——本次四人于此野餐小睡数十分钟；没有任何大消耗便突入了有光辉石的大理石所构成的六十层。；六十层充满了光可是却并没有灼烧眼睛的感觉，不如说，光照在身上感觉让人冷静。；不知道是不是因为这个房间十分的清净体力和MP都得到了充分的恢复。</data></node>
    <node id="始祖涡波三大魔法"><data key="name">始祖涡波三大魔法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波在与帕林库洛战斗时见识的『始祖涡波』三魔法，判读'恐怕全都是最高位的魔法'：『Torsion（捩菖蒲）』=『无法被干涉的攻击魔法』／『Default（行路渐歧）』=『无法被闪避的空间魔法』／『DistanceMute（幻之紫腕）』=『无法被防御的即死魔法』（将手伸进对方体内直接抽出『魂』；构成=施加在迷宫全体的抽取魔石的术式×次元魔术的组合升华；据涡波推测与始祖缇娅拉共同研发、'恐怕是最强魔法的一种'）。三魔法均为始祖涡波'专门为了自己创造的魔法'（原创），'而最适合使用那些魔法的人当然就是我（涡波）'。；「那三种魔法、『Torsion（捩菖蒲）』、『Default（行路渐歧）』、『Dis</data></node>
    <node id="队伍游泳能力（ch126）"><data key="name">队伍游泳能力（ch126）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉与莉帕不会游泳（拉丝缇娅拉成长于无海无湖之地）；塞拉只会狗刨式；涡波会游泳（归因于上过体育课）；涡波推测留在船上待机的三人也不会游泳；「拉丝缇娅拉不会游泳对吧？」；「嗯嗯，人家也不会游泳！」；「感谢二位开朗的回答。再然后塞拉的话只会狗刨式⋯⋯」</data></node>
    <node id="拜伦西斯大陆（第八卷新舞台）"><data key="name">拜伦西斯大陆（第八卷新舞台）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">开拓地的联合国侧称之为『本土』的大陆；其上有划分北方与南方的境界线，为『境界战争』舞台；帕林库洛称它与开拓地『迷宫』一样『全都是千年前那帮人留下的遗产』；在开拓地的联合国那边被称作『本土』的拜伦西斯大陆。；开拓地的『迷宫』是这样，这拜伦西斯大陆的『境界战争』也是这样，全都是千年前那帮人留下的遗产啊……</data></node>
    <node id="世界奉还阵暴走（ch166）"><data key="name">世界奉还阵暴走（ch166）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">帕林库洛死后阵持续失控：无数地裂重合、平地尽失，战场化为'山谷连绵不绝的黑色山脉'，倒地者将被吞入大地裂缝；莱纳感到其'打算吞没留在战场上的一切'；终局将被水晶玉封存的莱纳与基督吞入黑色大地坠向'大陆底部的底部，深处的深处'——'我们在『世界奉还阵』的战斗终于在彻底的意义上，迎来了终结'（战斗层面终结≠阵停止）；无数的地裂重合在一起，还能称作平地的地方已经不复存在。；『世界奉还阵』打算吞没留在战场上的一切。；我们在『世界奉还阵』的战斗终于在彻底的意义上，迎来了终结。</data></node>
    <node id="五十六层光属性安全地带与属性变化指标"><data key="name">五十六层光属性安全地带与属性变化指标</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">五十六层以光属性怪物为中心、其不好战故不引发袭击、可作安全地带（据诺斯菲说，涡波以遇怪未被袭印证）；回廊深处光亮越是减少、有时可见电灯泡样闪烁之处——是正从光属性的安全圈脱离、敌人属性可能变化的指标（诺斯菲预告处）；脱离安全圈后即遇凶猛的风属性怪物（五十五层）；在这途中，虽然与几头怪物相遇但并没有受到袭击。和诺斯菲说的一样，有着光属性的特色的怪物并不好战。看来这个五十六层能作为安全地带。；越是前进光亮越是减少，有时还能看到像电灯泡一样闪烁着的地方。这是意味着正从光属性的安全圈脱离的指标。；「啊啊，一直在前进呢。这里就是诺斯菲所说的敌人的属性可能要变化的地方呢」</data></node>
    <node id="弗茨亚茨国家概况"><data key="name">弗茨亚茨国家概况</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫北面骑士国家；五国中最有钱；迷宫旁水渠唯一；尊奉一位伟大骑士为始祖、重骑士道、以贵族为核心；土地分一百区编号、身份越高所居编号越小（主角位于二十一区，往前二十二区商店街、回走二十区公共机关/中介所）（警备兵与看板信息）；可不是么，骑士国家真不是白叫的。在环绕迷宫的五国当中，弗茨亚茨可是最有钱的。；弗茨亚茨的土地被划分为了一百个区域，每个区域都有属于自己的编号。</data></node>
    <node id="千年前大战八杰名录（雷纳尔多列举）"><data key="name">千年前大战八杰名录（雷纳尔多列举）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据雷纳尔多：战时名声最显赫的八人=南之『御旗』诺斯菲+其三名守护骑士（缇达・兰斯/诺文・阿雷亚斯/法芙纳・赫勒比勒夏因）+北之『狂王』罗德+其麾下艾德/涡波/赛尔德拉；诺斯菲三骑士千年前强大超群——生前罗德与涡波两人合力亦不曾击溃一人；名录中无使徒与缇娅拉之名（涡波感到违和：或许她们千年前并不像地上流传的那样活跃——涡波推测）；三骑士中两人（缇达/诺文）现已经化魔石；此外便是北之『狂王』罗德。加上她麾下的艾德、涡波、赛尔德拉。战时属这八人名声最为显赫」；在雷纳尔多罗列出的这些危险人物中没有出现使徒和缇娅拉的名字，这不觉让人感到违和。；似乎缇达、诺文、法芙纳三骑士的强大在千年前也是超群绝伦的。</data></node>
    <node id="『LivingLegend号』航路（ch71）"><data key="name">『LivingLegend号』航路（ch71）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">拉丝缇娅拉一行乘『LivingLegend号』位于联合国西南方海上、朝瓦尔德本土航行中；甲板为泳训/钓鱼场所；塞拉言'这里不是弗茨亚茨，而是『LivingLegend』号'；海莉队亦以瓦尔德本土为据点（'跟正在追寻帕林库洛的大小姐一行应该还会有见面的机会'）；「这里不是弗茨亚茨，而是『LivingLegend』号。我们已经是探索者了，必须要学会忍耐才行。」；「这里是联合国西南方的海上。现在在朝瓦尔德本土航行中。」；「……那么我先告辞了。不过，我们是以瓦尔德本土为据点活动的，所以跟正在追寻帕林库洛的大小姐一行，应该还会有见面的机会吧。那时候也请多多关照了呢。」</data></node>
    <node id="魔人与兽人的千年史（圣人缇娅拉改造说）"><data key="name">魔人与兽人的千年史（圣人缇娅拉改造说）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据艾德：『魔人』一词已从现在的世界上销声匿迹——恐怕是最后留存下来的圣人缇娅拉大人采取了相应手段、影响了二人死后的世界（语气苦涩：到头来还是借圣人缇娅拉之手而非自己）；据缇缇：圣人缇娅拉将『魔人』改造为『兽人』正是为实现艾德的未竟悲愿、魔人一词消失即其愿望达成之结果；缇缇在联合国和『柯尔库』看过现代街头后断言：这世上已无遭受凌虐的『魔人』、所有『兽人』脸上挂满笑容、从容悠然与人类并肩而行；「你错了，艾德。就算人家现在去拯救北方的臣民，那也是与曾经的臣民所不同的别人！而且这世上已经没有遭受凌虐的『魔人』了！在人家来到这里之前，已经走过了很多国家！也遍历了很多的城市！所有的『兽人』脸上挂着的都是笑</data></node>
    <node id="守护者迷恋的增减对照（罗德/诺文/诺斯菲）"><data key="name">守护者迷恋的增减对照（罗德/诺文/诺斯菲）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与完成迷恋而消失的诺文不同，罗德的迷恋在变大、存在感好像在增加（其缠绕魔力越接近地上越浓烈凶恶）；诺斯菲也同样——自昨天起凶恶的魔力就开始不断膨胀、尝试了许多方法消除迷恋反而产生反效果；涡波判断：两名守护者都需要到达地上、应从能做许多事的地上（而非闭锁的地下）寻找她们的迷恋；且必须尽快联络罗德的『理解者』、否则她身上的魔力应该会不断膨胀；与完成迷恋而消失的诺文不同，感觉迷恋在变大并且存在感好像在增加的样子。；只是，理解到这时就连诺斯菲也不能大意的存在。与罗德一样，昨天开始凶恶的魔力就开始不断膨胀着。虽然尝试了许多方法消除迷恋，但，好像反而产生了反效果。；与诺斯菲也相处了一段时间了。不是应该从闭</data></node>
    <node id="迷宫35层·水中阶层"><data key="name">迷宫35层·水中阶层</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波（甲板口述）：35层完全在水里面，如果不能游泳就完全无法前进——全员游泳练习的直接动因；「所以，迷宫中有海这件事情是真的吗？」；「啊阿，是真的。35层完全就在水里面。如果不能游泳就完全无法前进」</data></node>
    <node id="Earthquake"><data key="name">Earthquake</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">贝丝的地属性大魔法（咏唱形态『──『戮力擒之』！『Earthquake』！！』，『戮力擒之』为咏唱前缀碎片）：落地即受地震影响、如被扫堂腿击中屈膝至几乎跌倒；其原先站立地点以巨响炸裂、地面掀翻茶色土尘飞溅（『FlameAccel』起动的伴随破坏）；贝丝真正擅长的不是火而是地属性魔法（涡波评），其魔法多对『地面』施加影响；但是不可以大意，她真正擅长的应该不是火而是地属性的魔法。；「──『戮力擒之』！『Earthquake』！！」；但我刚一落地就受到了地震的影响，整个人如同被扫堂腿击中一般屈膝。只差一点体势就会彻底崩溃让我跌倒在地。</data></node>
    <node id="等级序列世界观（莱纳论与罗德千年前证言，ch90）"><data key="name">等级序列世界观（莱纳论与罗德千年前证言，ch90）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莱纳：'这世上的一切都是在等级序列的支配之下的'（『基督』=『始祖』/罗德=『王族』/己=『孤儿院出身的贵族养子』故地位最低；'要是我真觉得自己跟始祖和王对等了，那回到地上之后可就不妙了'）；罗德印证：'千年前的世界一样给人这种感觉。无论在哪里都存在着阶级、序列、还有差别'；莱纳断言'无论哪个时代都是被阶级和序列支配的。这可是永远不会消弭的东西'——地上世界序列压力的间接揭示；这世上的一切都是在等级序列的支配之下的。而『基督』是『始祖』，罗德是『王族』，我则是『孤儿院出身的贵族养子』。；要是我真觉得自己跟始祖和王对等了，那回到地上之后可就不妙了。；可能确实是这样呢……也许莱纳才是对的。千年前</data></node>
    <node id="光属性怪物的物理免疫与MP攻击（ch186实战）"><data key="name">光属性怪物的物理免疫与MP攻击（ch186实战）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">光属性魔力时常在敌人身上流动的怪物物理攻击无效（据诺斯菲指导+本章实战验证）：WhiteSnake被莱纳剑闪精准命中而不被斩裂；IllusionistKnight拥有可完全抵消物理攻击的防御力（一切全凭『剑术』、无魔法迹象）；精灵系怪物无一例外免疫物理（剑直接穿过HolyElement身体）；对策=风魔法斩击（ScytheWind/魔力风刃化·X形斩断铠甲）或直接攻击魔力——『形式・捩菖蒲』为攻击MP而非HP的魔法（爆炸无物理性影响、却能对敌人魔力造成莫大影响）；另：丧失敌意的怪物被外力（罗德凶恶魔力之风）侵扰后眼睛颜色转黑恢复袭击（无敌意状态可逆转）；向我们逼近的WhiteSnake遭到了莱</data></node>
    <node id="FlameAccel"><data key="name">FlameAccel</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">无咏唱的地与火双属性加速魔法，雷纳尔多曾经使用过（据涡波判读）；灼热魔力使双脚闪耀淡红色光芒；推测可暂时增强筋力、让筋力发挥出超越极限的力量（涡波推测）——异常力量加持下的剧烈加速可轻易无视距离概念；将全身魔力用途全变换为加速时双方距离瞬间缩减为零；代价大：贝丝约两分钟即速度衰减、剧烈喘息（消耗不止体力、MP亦尽即败因）；这一现象的原因被我用『维度』捕捉到了。这是无咏唱的地与火双属性的魔法。是雷纳尔多曾经使用过的加速魔法──『FlameAccel』；这速度实在可怕。因为『FlameAccel』灼热的魔力，她的双脚甚至闪耀出淡红色的光芒。这恐怕是可以暂时增强筋力的魔法吧。；恐怕是『FlameAc</data></node>
    <node id="血刻『咏唱』与口诵『咏唱』的二重叠加（ch230）"><data key="name">血刻『咏唱』与口诵『咏唱』的二重叠加（ch230）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">三名年幼『魔石人类』的魔力机制：生来便被刻进血中的『咏唱』自动进行——'她们的血伴随着热量流经全身，同时生产出多得惊人的魔力'（远超状态所示数值）；再叠加亲口诵祷的『咏唱』，两者合二为一释放神圣魔法（共鸣魔法）；战斗中再补第三重『咏唱』恢复光矢之力——累计三重的『代价』惨重，'作为让她们释放出不逊于斯诺的魔力的代价，三名『魔石人类』会牺牲相应的重要之物'（据涡波判断）；牺牲内容本章未揭示；这跟之前那次一样，也是因为生来便被刻进血中的『咏唱』所致。她们的血伴随着热量流经全身，同时生产出多得惊人的魔力。；除了刻在血中的自动进行的『咏唱』之外，还加上了她们亲口诵祷的『咏唱』，两者合二为一最终释放出神</data></node>
    <node id="斯诺的精神构造（本心暴露实录）"><data key="name">斯诺的精神构造（本心暴露实录）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺·沃克放弃了人生的一切：异常脆弱的心灵使她将一切选择托付给别人（只选最轻松的流向）；三连害怕（做选择/担责任/搞砸）→'无可奈何'式放弃；平时的从容=逞强伪装（余裕尽失即崩坏——义母/上流阶级面前尤其）；崩坏形态=自责自问（'又是我做错了什么吗…因为我不好…?'）+注视无异常（非精神攻击=本心）；'轻易说不来会演变成无法挽回的事态，所以只能暧昧'；她只是也只能，顺着轻松的流向生活着。因为异常脆弱的心灵，使她将一切选择都托付给了别人。；也就是说，这是斯诺的本心。</data></node>
    <node id="迷宫地形与生态对应原则"><data key="name">迷宫地形与生态对应原则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">经验法则（未出过错）：迷宫地形与怪物生态对应——河流→水栖怪物/森林→昆虫怪物/热气→火焰怪物；二十七层水晶回廊=水晶系怪物栖息之印证（透明水晶质墙壁硬度超一般水晶=变异矿物）；基本上来说迷宫的地形与怪物的生态都是互相对应的。有河流的话就是水栖怪物、有森林则是昆虫怪物、热气则是火焰怪物、虽然是经验之谈，但这个经验还没出过什么错。；这里一反二十五层前后那种熔岩地带，变回了凉爽的回廊。</data></node>
    <node id="『魔石人类』的地上现状（一年后·ch210）"><data key="name">『魔石人类』的地上现状（一年后·ch210）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">艾米丽的『表示』状态栏记有『素体』技能、涡波判其为『魔石人类』；试探询问后艾尔十分坦然地表示『魔石人类』的存在并没什么稀奇，令涡波不免惊讶（地下一年间地上状况大变）；被主人舍弃的奴隶中亦混有『魔石人类』身影——地上已是能孕育出艾尔+艾米丽这种组合的环境；在状态栏上记有『素体』这一技能。再看她身上这种不协调的氛围，可以肯定她是一名『魔石人类』；他十分坦然地表示说『魔石人类』的存在并没什么稀奇；其中甚至还混有少许『魔石人类』的身影。</data></node>
    <node id="『烧焦的异界鞋』"><data key="name">『烧焦的异界鞋』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波的鞋：脚步声被贝丝当作其特征（『既然她说我的脚步声是特征⋯⋯』）；为消脚步声脱下收进『所有物』、光脚奔跑（脚底受损伤亦别无他法）——贝丝远望此举先惊讶后悲叹；「既然她说我的脚步声是特征⋯⋯」；虽然这会让脚底受损伤，但也别无他法。我将『烧焦的异界鞋』收进『所有物』中，尽可能减轻脚步声。</data></node>
    <node id="莱文教传承中的始祖地位"><data key="name">莱文教传承中的始祖地位</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据莱纳（弗茨亚茨骑士·虔诚莱文教信徒·教会授勋·对始祖忠诚誓约）：始祖在莱文教传承中'最了不起'、'搞不好你要比弗茨亚茨的任何人都要伟大'；基督=信仰的始祖一事莱纳此前从海莉处听说；涡波自称'本身我就不记得多少作为『始祖』的记忆了'、请莱纳'像平时一样把我当做基督对待'；莱纳应'无论你是神也好还是别的什么也罢，对我来说你就是你'。涡波以'那应该是两人的目的之一（千年后和平国家获得最大权力）'自解。；「『始祖涡波』的魔法吗。光是听你说，就觉得全是出神入化的玩应儿啊。虽然已经从海莉那儿听说过基督是我们信仰的始祖大人来着了⋯⋯，但是还是觉得难以置信啊。这感觉可真奇妙」；「当然啦，那可是最了不起的哦。</data></node>
    <node id="翠色石子"><data key="name">翠色石子</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">形状圆滑、半透明的翠色石子——不比宝石通透，阳光下有独特光辉；被幼年罗德（草绿色头发的女孩）视作最重要的宝物；摔脱手后沿渐陡的草原滚落遗失；坠入奈落之底后寻遍落石数十年数百年也无可替代者——'唯有那个『美丽的石子』本身，再也不会被我找到了'；是'只有在那个时候，只能在那片草原上寻获的宝物'（长大成人后再无机会寻获）；那是一块形状圆滑、半透明的翠色石子。虽然不比宝石那般通透，但在阳光的照射下却有种独特的光辉。；结果握在她手中的小石头也因为摔的这一跤脱手了。；然而，唯有那个『美丽的石子』本身，再也不会被我找到了。</data></node>
    <node id="『千年前的梦』"><data key="name">『千年前的梦』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">位于'沉没在深层心理最底部的黑暗'的记忆之所＝最适合整理记忆的场所；涡波就寝时'为了抵达『千年前的梦』之所在，我在睡魔的引导下沉入了梦乡'——整理千年记忆/回溯篇的入口；沉没在深层心理最底部的黑暗。；为了抵达『千年前的梦』之所在，我在睡魔的引导下沉入了梦乡。</data></node>
    <node id="西迷宫遗址"><data key="name">西迷宫遗址</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">被冠以『西迷宫』这个名字的涡波与帕林库洛的战场的遗址；一行自柯尔库汇合斯诺后驱车西行的当前目的地；据拉丝缇娅拉和斯诺口中得到的信息，玛利亚和莉帕似乎正待在那里，将这两人带上之后即可改向北方进发；当下的目的地是被冠以『西迷宫』这个名字的我和帕林库洛的战场的遗址。；根据从拉丝缇娅拉和斯诺口中得到的信息来看，玛利亚和莉帕似乎正待在那里，将这两人带上之后，我们就可以改向北方进发了。</data></node>
    <node id="帕林库洛=『暗之理的守护者』·咒术骑士（ch149自陈）"><data key="name">帕林库洛=『暗之理的守护者』·咒术骑士（ch149自陈）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">（再演重申·原设 ch0080 实体观察；本章升级为 setting 记录）据帕林库洛自陈：『『暗之理的守护者』的力量并不是我的全部，我原本就是使用『咒术』战斗的骑士啊！』——正体定位=使用咒术战斗的骑士、暗之理守护者之力仅为其一部分；可对特定对象定向解放『暗之理的盗窃者』之力（右臂蠕动渐化黑色液体——『这一变化就跟缇达一样』）；另与塞拉有『被告诫过不要直接接触我』的旧约及『仿真战中一次都没赢过』的宿敌史；『暗之理的守护者』的力量并不是我的全部，我原本就是使用『咒术』战斗的骑士啊！；这一变化就跟缇达一样。帕林库洛只针对斯诺解放出了『暗之理的盗窃者』的力量。；你是最棘手的一个。不仅没什么弱点，而</data></node>
    <node id="诺文的怪物化恐惧与留恋波动"><data key="name">诺文的怪物化恐惧与留恋波动</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">弱点实证：特化对人战斗+缺乏魔法攻击应对（龙之风/尾巴反应不及——'连黯淡之龙那种程度的攻击都反应不过来，实在奇怪'）；差点死→『怪物化』恐惧全暴露（'一旦怪物化会丧失理性…大家都会被我——'）；后悔使留恋加重→力量回复（幸福消留恋vs后悔增留恋的双向paradox——'诺文现在是如此后悔，以至于连留恋都在不断加重'）；衰弱程度远超涡波想象；也就是说，诺文现在是如此后悔,以至于连留恋都在不断加重——；「不对,这是致命性的失态！我的『怪物化』，并不是我自己一个人的问题！如果陷·入·了『怪物化』的状态，我会丧失理性的。会变得与怪物无异。如果在这种地方『怪物化』了，那简直不堪设想！」</data></node>
    <node id="拉丝缇娅拉状态栏（ch39实测）"><data key="name">拉丝缇娅拉状态栏（ch39实测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">等级16/职业无：HP708/709 MP325/325；力量11.73 体力11.12 技巧7.14 敏捷8.40 贤能12.98 魔力9.13 素质4.00；先天技能：武器战斗2.14 剑术2.03 拟神之眼1.00 魔法战斗2.27 血术5.00 神圣魔法1.03；后天：读书0.52 素体1.00——拟神之眼=其『能看到』能力的技能名侧证；姓名：拉丝缇娅拉·弗茨亚茨HP708/709MP325/325职业：无；武器战斗2.14剑术2.03拟神之眼1.00</data></node>
    <node id="大圣堂攻略战果"><data key="name">大圣堂攻略战果</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主角单骑突破五名七骑士防线（雷迪安特/拉古涅/侯普思/魔法队长/佩露修娜）+帕林库洛解结界；零死者零负伤；海因独挡其余五骑遍体鳞伤；逃亡战果=拉丝缇娅拉夺还+海因雷迪安特战力加入+缇亚归队（散花火力）——六人组+Connection 轮换制的迷宫探索计划；一个人也没有落下、敌人也没有出现死者、拉丝缇娅拉也在这里。</data></node>
    <node id="35层的空气横穴（『休息地点』）"><data key="name">35层的空气横穴（『休息地点』）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">35层中心附近回廊上的孤立死胡同横穴：内部无水、像看不见的墙将水阻隔在外侧、进出不费力；水压与气压作用维持空气块（如洗澡时倒扣容器摁入水中的现象）；涡波推定为『某人』有意做手脚、为让探索者更容易通过35层而设的『休息地点』（『并列思考』肯定推测）；唯一出入口、一旦被怪物袭击无处可逃；用途=调整呼吸+皮袋补气（本章实用后即刻出发）；接着在35层的中心附近，回廊上出现了一个奇怪的横穴。使用『维度』确认的话，发现那里面的空间没有水。；明明是这样，却像是有一堵看不见的墙一样将水阻隔在了外侧。但我们没怎么费力就进来了。；那个『某人』为了让人更容易地通过35层而制造出了这个『休息地点』。这么想的话，这个空</data></node>
    <node id="帕林库洛的咒术（精神攻击）"><data key="name">帕林库洛的咒术（精神攻击）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">得意伎俩=一边战斗一边谈话、揪住他人内心的缝隙操弄精神——『偏离了常轨的『咒术』』（海莉解说）；实测效果：涡波状态=混乱7.87/精神污染1.22/认识阻碍0.23（涡波自认与平时无异程度之轻亦自注）；魔法与精神状态紧密相连——受攻者丧失构筑精密魔法的余裕（『Dimension』基础都难保）；可用神圣魔法调整治疗（莱纳执行）；海莉评『你还是一如既往地擅长精神攻击呢，帕林库洛。但是，只在自己处于优势的时候才予人恩惠这种做法，恰恰是卑鄙小人的做法』；魔法跟精神状态是紧密相连的。至此，我已经完全丧失了构筑精密魔法的余裕。就连作为次元魔法基础的『Dimension』都要保不住了。；「你还是一如既往地擅</data></node>
    <node id="守护者体系更新：五十守护者（ch84）"><data key="name">守护者体系更新：五十守护者（ch84）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">50层守护者＝『风之理的盗窃者』，状态栏标注【五十守护者（FiftyGuardian）】；本体名罗德·缇缇（千年前『支配之王（Lord）』，本人承认）；据其自述因种种原因被『世界奉还阵』吞噬后成为守护者，但已有几百年没有去管50层；守护者＝以守护对应层为目的被召唤的怪物（涡波认知口径）；涡波既往经验：除初战的缇达（战斗狂）外其余三名守护者均未突然袭击；面对守护者时交谈比敌对有效；【五十守护者（FiftyGuardian）】风之理的盗窃者；但这也是理所当然的。她也是守护者——是以守护50层为目的被召唤的怪物。；「就是这样。但是，已经有几百年没有去管50层了耶。」</data></node>
    <node id="魔石人类的魔石耗损症状与短命（ch0128更新）"><data key="name">魔石人类的魔石耗损症状与短命（ch0128更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：『魔石人类』特有症状=体内魔石耗损至极限→身体如被掏空、奄奄一息；可通过提供魔石回复（白色少女治疗中曾要求提供数个魔石）；『魔石人类』通常很短命；拉丝缇娅拉自称『最高杰作』故无此问题（据其自称）；白色少女状态异常到拉丝缇娅拉'完全无法理解发生了什么事情'且'看起来也不像是失败的样子'；「这是『魔石人类』特有的症状喔。由于体内的魔石被耗损到了极限，身体会有如被掏空一般⋯⋯⋯简而言之，会变得奄奄一息喔」；「她的身体早已破烂不堪了⋯⋯虽然通常来说『魔石人类』是很短命的，但我完全无法理解发生了什么事情，才会导致她变成现在这种糟糕的状态⋯⋯看起来也不像是失败的样子，这样的话不就像是⋯⋯」；</data></node>
    <node id="『强欲转换』"><data key="name">『强欲转换』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">露洁×诺瓦露追捕用魔法：两名少女脚边溅起水花般的大量泡沫（形态似次元魔术『形式』），手掌大小的泡沫像肥皂泡一样漂浮试图填满庭院；接触之物笔直坠地（树叶一碰即倒）——与追踪性『某物』构成立体捕捉网，涡波判断被触者恐被束缚于地面；被火焰魔法箭雨全数击碎；「『强欲转换』！」；两名少女的脚边溅起水花一般的大量泡沫，形态跟次元魔术『形式』类似。；被『某物』撞倒的大树周围飞舞着众多树叶。一片树叶刚一碰到那泡沫，便立马笔直地摔倒地上。</data></node>
    <node id="魔法『Earthquake』（雷纳尔多）"><data key="name">魔法『Earthquake』（雷纳尔多）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">雷纳尔多使用的魔法：与贝丝先前使用的同名但『威力却不可同日而语』；脚甫一落地即引发整栋宅邸震颤，墙壁绽开龟裂、玄关支柱崩毁；崩毁的支柱全部为承重关键——精确掌握宅邸构造的定点破坏；目的只有一个：让涡波远离此处去救莱纳；「──『Earthquake』！！」；这是先前贝丝使用的魔法。；整栋宅邸便轰地一声震颤摇晃。</data></node>
    <node id="奴隶制度细则"><data key="name">奴隶制度细则</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">颈环（未缔约可物理破坏；滴血缔结主从契约防逃逸）；奴隶市场入夜后由合法转非法（战争受害者以外者上台面）；奴隶被带到联合国后只能依靠买主生存（无归宿无援手=逃无可逃）；玛利亚式自认：心中的桎梏决定的主从关系（颈环不在亦为奴）；颈环、颈环的信息你难道不登录吗……？这么下去的话我搞不好会被别人偷去的哦！</data></node>
    <node id="复合咒术『咏唱』的机制与损耗（ch204）"><data key="name">复合咒术『咏唱』的机制与损耗（ch204）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『咏唱』=叙述自己的人生以构筑魔法。罗德侧：三番五次使用后'现在的意识绝对不会正常'（搞不好连现在是『何时』、在跟谁做些什么都不明不白）；本章真『咏唱』（涡波初闻即能领悟这才是她真正的咏唱）：『此身乃是于地狱路上疾走之魂』『世界（你）既堕孤（我）至此』『则深渊之下，无论既经几时，此恨不绝』；通过咏唱罗德体内涌出无尽魔力并从周围采集。涡波侧：同样以复合咒术『咏唱』叙述自己的人生反用先谭（『既然未来得以与现在联结』『则现在亦当与过去相连』『只为等待，世界（你）将我忆起『想起』之时到来』）；咏唱=我流魔法构筑的极致、守护者们抵达的『为了盗窃理而编织的魔・法』的真髓（教给莱纳之物）；「──『此身乃是于</data></node>
    <node id="『Dimension』浸透率与理解度挂钩机制"><data key="name">『Dimension』浸透率与理解度挂钩机制</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波实证：Dimension 的浸透率与其对物质/现象的理解程度挂钩——熔岩/火焰类热物（24-25层级）理解力异常强可浸透；二十八层虹色矿石则完全无法灌入魔力（离壁即失辉变黑的未知矿物）；计划向艾利巴茨学习矿石知识以解锁浸透；看来『Dimension』的浸透率跟我对物质和现象的理解程度挂钩。；然而，落到我手里的矿石失去了先前的光辉，干脆变成了黑色的石块。</data></node>
    <node id="『这里』四人体制构想(观众论)"><data key="name">『这里』四人体制构想(观众论)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲声称：需在『这里』继续保有意识的只有罗德（『你』）与诺斯菲（『我』）、再加上『臣子』和『弟弟』四人；其他人『就让他们彻底成为观众吧』；称『这样做更接近于你所期望的世界』；罗德被其接二连三的正论说服；需要在『这里』继续保有意识的只有『你』和『我』、再加上『臣子』和『弟弟』，这四人就足够了。至于其他人就让他们彻底成为观众吧。；诺斯菲接二连三的正论还是说服了罗德，罗德缓缓地点了点头。</data></node>
    <node id="迷宫里侧"><data key="name">迷宫里侧</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">『这里』本是被建造在迷宫里侧这一空无一物空间之上的东西；佩艾希亚崩壊后重新降临；既不属于涡波的世界也不属于异世界；据涡波推断，空气/重力/运动/热量等一切无形之物都将在此消失；原本『这里』就是被建造在迷宫里侧这一空无一物的空间的东西。；这就是『里侧』这一场所。；既不属于我的世界，也不属于这个异世界。一个不属于任何地方的空间。</data></node>
    <node id="玛利亚身世（法尼亚边境）"><data key="name">玛利亚身世（法尼亚边境）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">法尼亚边境乡下黑发黑目一族村落：农活/狩猎/家务的共同体生活；『眼睛』迫使看破一切本质而无所适从（根本性改良法浮现/传统狩猎无效率感）；战争流言→军队驻扎→玛利亚谏言参战→村毁——『眼睛』加速但村子地理位置注定毁灭（黑发黑目之族在这个时代注定毁灭的命运）；■■曾教其『那双眼睛是上天赠予你的礼物』（面容已烧忘）；村子的毁灭是它的命运。而我的『眼睛』确实导致了它加速毁灭。</data></node>
    <node id="迷宫35～40层构造（ch72更新）"><data key="name">迷宫35～40层构造（ch72更新）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">35层=石制回廊灌满水（不特别宽广/无三维错综道路/蹬地如无重力前进）；35→36层阶梯=漩涡（瀑布状滑落着陆）；36层=浅滩（水位比34层高许多/水从墙壁涌出/水草丛生）；37层=通往阶梯完全浸水（与35层同型，当日撤退）；38层=浅滩+墙壁如热带雨林般大量植物（植物类怪物增加/移动能力低/回避敌人难度最低的一层）；39层=植被森林级+脚边浅水（植物类怪物为主/昆虫系比想象少/特化拟态与奇袭/被涡波确认为狩场——打倒敌人不会一口气聚集、节奏慢风险低；发现多个祭坛但道具已被取走）；40层=广阔『大草原』（无障碍/几十厘米高的草/守护者房间——守护者未出现；草原长草=守护者还活着，若被打倒则连草</data></node>
    <node id="涡波的魔力属性论（冰冷/扭曲·推测）"><data key="name">涡波的魔力属性论（冰冷/扭曲·推测）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波推测（自评理论粗糙但八九不离十）：冻结魔法『冰』需要『冰冷的魔力』而其现在只能生产次元属性的『扭曲的魔力』；以前因体内两种魔石并存可产生『虽然扭曲但也兼具冰冷的魔力』故能并用冻结魔法与次元魔术；阳滝的魔石被拔除后『冰』只能造出扭曲又不成器的冰块；吞石可强制理解构筑方法但魔力属性不合便无法正常发动（唯『冰』尚有手感）；不过在这失败连连的魔法群中，唯有一个魔法我有些手感。；曾一度得以随心所欲地操控的『冰』在阳滝的魔石被拔除的现在已经只能打造出扭曲又不成器的冰块了。；虽然还是我的推测，不过我认为原因在于冻结魔法『冰』需要的是『冰冷的魔力』，而我却只能生产出次元属性的『扭曲的魔力』。以前是因为体</data></node>
    <node id="守护者'总有一日消失'的特性"><data key="name">守护者'总有一日消失'的特性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者具有总有一天会消失的特性（叙述将其归于守护者共性）；斯诺据此对'千年前老婆'诺斯菲的存在感释怀（'是守护者吗⋯⋯？既、既然这样，那可能没关系'）；看来是多亏了诺斯菲作为守护者的总有一天会消失的特性所赐。；「是守护者吗⋯⋯？既、既然这样，那可能没关系⋯⋯？」</data></node>
    <node id="《Zeitlos·Wind》分解魔法"><data key="name">《Zeitlos·Wind》分解魔法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">海因的高级风魔法：分解对手魔法之力——用以自我解除帕林库洛的『咒术』（咒术=超越极限的辅助，解除则濒死者将倒——海因凭自身意志站立推翻此定数）；与 ch0016 之战中干扰Dimension的同名魔法为不同应用；于是我用风之魔法将之解除。这个魔法是分解对手魔法的高级风魔法。</data></node>
    <node id="帕林库洛的战斗方式（拉丝缇娅拉证言）"><data key="name">帕林库洛的战斗方式（拉丝缇娅拉证言）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据拉丝缇娅拉：『天上的七骑士』时代其战斗能力基本吊车尾（仿真战一次都没赢过塞拉）；以辅助魔法为中心的骑士（涡波认知一致）；'绝对不会堂堂正正地战斗''绝对不会让涡波以万全的状态战斗的，绝对会玩弄什么手段对你释放精神魔法'；另据涡波：需注意缇达的魔法（黑色液体，不附着即无碍）；「没错。在『天上的七骑士』时代，基本上他的战斗能力老是吊车尾哦。仿真战里一次都没赢过塞拉酱呢」；「──所以说，帕林库洛他是绝对不会堂堂正正地战斗的哦。他绝对不会让涡波以万全的状态战斗的，绝对会玩弄什么手段对你释放精神魔法的。肯定没错」</data></node>
    <node id="第五十层『这里』"><data key="name">第五十层『这里』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">始祖千年前制定'遵从罗德的期望转变姿态'的规则——本章罗德嘶喊'孤真正渴求的根本、根·本·不·是《这·里》'后，《阶层》如脉动心脏般震颤、不存一物的空间裂痕剥落溃崩：非物理力破坏，而是源于魔法术理的法则的崩坏（世界只是在服从法则）；与作为表侧的六十六层缝合（表里界线遭破坏、两个世界开始合二为一），通往地上的门户已开；涡波判读'两者合二为一才是真正为了罗德而存在的阶层——可是结果这个阶层并没有彻底竣工'（存疑：'所谓表里的构想可能就是错误的'）；决战后《支配之王》在《这里》不复存在、缇缇离巢（臣民嘱'不要再回到『这里』了'）；孤真正渴求的根本、根·本·不·是《这·里》；这一次世界并非是因为物理上</data></node>
    <node id="『无法表现为数值的数值』（守护者战成长）"><data key="name">『无法表现为数值的数值』（守护者战成长）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与守护者的战斗经验带来状态无法『表示』的成长：'魔力的浸透比以前要通畅了很多'；与阿尔缇之战→火焰理解度提高；与诺文之战→矿物理解力提高（对照'不管怎样的攻击都不会使之受损的诺文的水晶'，31层矿物解析容易）；『维度』曾在公会会长期覆盖整个街市（高魔力消耗的区域浸透用法沿用）；不可思议地，魔力的浸透比以前要通畅了很多。；同守护者之间的战斗经验，让我获得了成长。即是状态无法『表示』出来的『无法表现为数值的数值』；就跟与阿尔缇的战斗让我对火焰的理解度提高了一样，经过与诺文之间的战斗，我对矿物的理解力也提高了。</data></node>
    <node id="帕林库洛的战争城堡"><data key="name">帕林库洛的战争城堡</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">西娅书信所指、战场平原诸城中规模最大者：占地约一平方公里，高耸瞭望塔与石造建筑密集，外围三角形护墙高度足有柯尔库的两倍——涡波所见异世界建筑中最了不起的一个（森严仅次于联合国弗茨亚茨大圣堂）；涡波抵达时已被入侵者（西斯与艾德）先袭、士兵多处昏倒、完全进入临战状态；城堡中央有宽几十米的开放中庭，三名魔力异常者（帕林库洛/西斯/艾德）聚于此。；那是一座占地一平方公里左右的大型城堡。高耸的了望塔和石结构建筑一个挨着一个。外围建有三角形的护墙，其高度足有柯尔库的两倍。；虽然不如联合国那边的弗茨亚茨大圣堂，但其森严仍然给人以强烈的印象，让外敌不敢轻易进犯。；原来是有入侵者先于我发动了袭击。城堡各处都有士</data></node>
    <node id="迷宫61~64层环境（ch180·话数版探明）"><data key="name">迷宫61~64层环境（ch180·话数版探明）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">64层=石造回廊（'终于找回了以往那种风格'）、通风过好、持续冷得瘆人的风；63层=无甚特色但地面发强光、'照得迷宫像在白天一样明亮'，通往下一层的路好找；62层=地面墙壁天花板皆发光、'好似眩目的太阳'、视野极大受限须眯眼（基督『维度』无碍、莱纳须Wind或牵手）；61层=天花板'完全化作了与太阳等同之物'、光灼烧眼球染红视野；基督观察'果然越往上层走，敌人就会越来越弱'（PaleGriffin平衡无单项、61-62层怪物无敌意）；另：连续行进四小时+战斗致体力精神损耗（不出现在状态表示上）；虽然天花板还是悬得那么高，但基本都是石造的回廊。；一定要说的话，那就是相较于以往，这层回廊的地面在发</data></node>
    <node id="交流"><data key="name">交流</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺斯菲光魔法之核心（原文亦记作『交流（篡改）』）：本章实证其对无意识之『术式』可无条件解决许可与否的问题——光属性魔力沁入『血』中直接与术式交流，令对方魔法双重发动（正反相杀）；对生物侧『不具有强制力』的说法被涡波斥为假（『什么不具有强制力的『交流』都是假的』）；诺斯菲自称『抓住对手的『弱点』再『交流』是和平交涉的基本原则』；我对执行召唤的术式进行了『交流（篡改）』，将召唤对象从罗德转变为了我自己；而且因为对象是没有意识的『术式』，所以可以无条件地用『交流』解决许可与否的问题。；「恕我直言。抓住对手的『弱点』再『交流』是和平交涉的基本原则」</data></node>
    <node id="守护者的留恋驱动真相（诺文证言）"><data key="name">守护者的留恋驱动真相（诺文证言）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺文：守护者都已经死了——靠残存的留恋驱动身体；留恋完成即失去力量、夙愿实现即消失；心脏停跳→完全怪物化（打倒怪物化个体=第三十之试练完成）；守护者=被召唤现身（跟召唤一样——突然被召唤出会混乱）；莉帕为仪式最后被卷入的附带品非守护者；十层与二十层守护者已死（诺文确认）；「归根究底，守护者都已经死了。如果不是靠残存的留恋驱动身体，我们根本没法生存。因此留恋完成了我们就会失去力量，夙愿实现了我们就会消失。」；「没有，十层和二十层的守护者好像都死了。」</data></node>
    <node id="守护者的消失方式与魔石化"><data key="name">守护者的消失方式与魔石化</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">守护者'实现了留恋之后'化作魔石（诺文的魔石呈剑形=『阿雷亚斯家的宝剑诺文』）；罗德视桌上诺文之剑为'自己未来的姿态'、宣言'以符合守护者的方式消失为目标'；诺文的消失被称为'真是个符合守护者的消失方式'；「是的，正是诺文的魔石。实现了留恋之后的他化作了剑。顺带一说，阿雷亚斯家的剑术被传授给了我和莱纳继承」；「真是个符合守护者的消失方式啊，诺文那家伙⋯⋯」</data></node>
    <node id="帕林库洛的位置与『南方』战局"><data key="name">帕林库洛的位置与『南方』战局</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据西娅声称：帕林库洛在距当地稍偏北方向的最前线指挥军队，正担任『南方』总大将的参谋；涡波在劳拉维亚时已闻其作为将领被召回本土、现处战争中心（旧闻印证）；本章舞台为本土（据海莉：'这么快就来到本土了呀'）；西娅队伍的目的地同为帕林库洛处。；「我知道哦！叔父大人的话，在距离这边稍微偏北的方向。据说他现在正在最前线指挥军队来着！」；我在劳拉维亚的时候，就听说过帕林库洛作为将领被召回了本土这件事，果然那家伙现在正处于战争的中心处。；听说叔父大人正在担任『南方』总大将的参谋哦</data></node>
    <node id="『支配之王（Lord）』"><data key="name">『支配之王（Lord）』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">决战终局：'在《这里》，《支配之王》已经不复存在'——缠绕缇缇的凶恶魔力雾散、为战斗而生的凶恶之风化作拂过草原的清风溶入世界；'压迫于她身上的『支配之王（Lord）』的存在已经消失，她的身体终于变得与曾经一样轻盈'；臣民'在对缇缇予以认可的同时，逐渐将自己的王的存在从心中涂抹消去'，谢罪感谢'这并非是对『支配之王』——而是对少女缇缇的谢罪和感谢'；如今只剩地上的艾德一人仍在期待『支配之王（Lord）』；缇娅拉时代英雄谭《支配之王》的全部内容=背负救世使命的缇缇（罗德·缇缇）；在《这里》，《支配之王》已经不复存在。；在对缇缇予以认可的同时，逐渐将自己的王的存在从心中涂抹消去；这并非是对『支配之王</data></node>
    <node id="『DivineCircle』"><data key="name">『DivineCircle』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">西斯防御魔法：光漂浮于两人之间防住冰炎双重魔法刃——全力斩下的刀刃如叩山峦般被弹开，涡波玛利亚被推回后方；「──『DivineCircle』！」；光在我们两人间漂浮并且防住了我们的魔法刃。</data></node>
    <node id="咒术『集中收束』"><data key="name">咒术『集中收束』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">西斯用以调整（缇亚之体）状态配置的咒术：初次配置失衡——筋肉与力量过度突出致难以行动（与其非持械战斗流派不合，'明明我不是手持武器战斗的角色'）；经响指'重新修正吧'再洗点数（力量0.21／魔力112.67等）——该表达方式令涡波联想原世界'游戏'的点数重分配；咒术『集中收束』是不是有点在平衡方面出了点问题，很难行动，为什么在筋肉和力量上这么突出，明明我不是手持武器战斗的角色。；「没有办法，重新修正吧」；「游戏」的事情</data></node>
    <node id="涡波体内双魔石并存（当前态）"><data key="name">涡波体内双魔石并存（当前态）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波体内同时存在两枚魔石——自己的『次元之理的盗窃者』的魔石＋阳滝的『水之理的盗窃者』的魔石；'心脏跃动之声虽是唯一。但亦是重合之音。只因有两个灵魂在共同演奏'；阳滝（涡波一直在寻找的妹妹）的所在之处＝涡波的身体本身（'一直都在'，其声自体内可闻）——ch162 千年计划'双魔石共体'设想的当前实证；「现在这里一共有两个魔石！既有我自己的『次元之理的盗窃者』的魔石！又有阳滝的『水之理的盗窃者』的魔石！这两个同时存在啊！！」；自己一直在寻找的妹妹、『阳滝』的所在之处──就是我的身体本身。；心脏跃动之声虽是唯一。</data></node>
    <node id="诺文的剑化与守护约定"><data key="name">诺文的剑化与守护约定</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">诺文现即『阿雷亚斯家的宝剑诺文』——『现在诺文本人都握在我手里了』；涡波战斗中调用『诺文的剑术经验』（对浮空双剑等特殊条件战亦无先例）；涡波与诺文有约：由涡波好好守护莉帕、绝对不能漏过任何她可能遇到的危机（亦为保留与莉帕联结的理由之一，必要时可分力量给她）；现在诺文本人都握在我手里了，肯定不会像上次那样出现什么变故的吧。；双剑如同被人持在手中一般，用诡异的剑法骚扰着我。即使是在诺文的剑术经验中，也没有在这样特殊的条件下战斗过。；既然我跟诺文约定过会好好守护莉帕，那就绝对不能漏过任何她可能遇到的危机。</data></node>
    <node id="『Dragon・Wave』振动壁魔法"><data key="name">『Dragon・Wave』振动壁魔法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">斯诺释放的振动魔法，将『绝冲风击・改』的余波抵消；系斯诺对无属性的魔法进行一些改造后完成——利用龙的魔力将魔法名喊出时产生的音波的振动增幅，从而打造出一道振动壁；涡波（几天前在联合国服下大量魔石）对其构造十分了解，但几乎掌握所有魔法的他亦无力仿效；为精通稀有的『古代魔法』的斯诺结合自己『龙人』特性的产物；实战效果堪称完美、无任何碎屑飞溅；「──『Dragon・Wave』！！」；而这一击的余波经由斯诺释放的振动魔法而被抵消。；这是利用龙的魔力将魔法名喊出时产生的音波的振动增幅，从而打造出一道振动壁的魔法。</data></node>
    <node id="舞斗大会规则细则（实战版）"><data key="name">舞斗大会规则细则（实战版）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">标准规则=『击落胸花』或『击落武器』二选一；对战方式与赌注由双方商讨定（耗时过长由主持人裁标准规则）；种子队制（劳拉维亚代表涡波初战免除）；四区各竞技船（原巨型战舰改造圆筒竞技场/魔石线+麦克风魔石扩声）+中央剧场船；告发袭击可致退场逐出瓦尔法拉；魔石线监控存在失效区（莱纳手脚）；「作为劳拉维亚国的代表，相川·涡波大人的初战被免除了。也就是种子队的待遇。因此，请您于下午前往北区的竞技场。」；「咦、咦？什么记录都没留下……？不对，这是『魔石线』的机能没有发挥作用……？」</data></node>
    <node id="『连接』设置限制与五十五层近路"><data key="name">『连接』设置限制与五十五层近路</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迄今未在元守护者的阶层以外设置『连接』的两大理由：①『正道』的结界十分的碍事②怪物有可能破坏掉『连接』；据诺斯菲声称：对其阶层附近的怪物『交流』、怪物反而有可能来保护魔法门——但条件为仅能创建于六十层附近（『光之理的盗窃者』的阶层附近）且须是温顺的怪物；由此无守护者阶层（三十层为止）的近路计划失败、改于五十五层设置『连接』可缩短十层数量的路程、照此步调还有几天就能到达地上；回忆起迄今为止没有在元守护者的阶层以外设置『连接』的理由。；说先『正道』的结界十分的碍事。接着是怪物有可能破壊掉『连接』。这两点。；「这时候就需要我出场了。对这附近的怪物『交流』的话，反而来保护魔法门的可能性也是有的」</data></node>
    <node id="涡波=迷宫与系统创造者自白（ch90）"><data key="name">涡波=迷宫与系统创造者自白（ch90）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波自白：'在『世界奉还阵』中看到过去的记忆之后，我已经明白打造出这个系统的人就是我自己了'（属性点/技能点系统的本质=对『魔力变换（Levelup）』的应用，'作成可以将余剩的魔力随机应变地补足到任何方面的机制'+'这绝对是我个人兴趣暴走的产物'）；'一边感谢着做出怪物不能跨层行动的规则的自己'；'因为造出这座迷宫的人好像就是我自己来着。所以马马虎虎地能够猜出配置的怪物的目的和倾向来的'（据怪物外表与名字按原世界游戏经验推测能力'一猜一个准'）；另自述同伴过于优秀令战斗经验偏颇（'拜玛利亚和缇亚所赐，不少怪物连进入我的视野都做不到就被干掉了'——缇亚的狙击/拉丝缇娅拉的无双/玛利亚的守护炎</data></node>
    <node id="语言自动翻译现象"><data key="name">语言自动翻译现象</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">主角日语被自动替换为当地语言、当地语言书籍/言语对主角自动呈日语；非日语人群无障碍理解其日语——『日语被翻译成了这种奇妙的语言，而这种奇妙的语言也被翻译成了日语』；主角恐惧：若非魔法则须对脑动手玩弄记忆人格；日语被翻译成了这种奇妙的语言，而这种奇妙的语言也被翻译成了日语。</data></node>
    <node id="共鸣魔法与『Flame·Aegis』"><data key="name">共鸣魔法与『Flame·Aegis』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">共鸣魔法=骑士团/军队广泛使用的组合魔法战术（例：10人合放『FlameArrow』生成巨大火矢>各打各的；需相性与训练；探索者视为出力不讨好）；知识出处=图书馆与酒馆（涡波自述'在图书馆和酒馆里了解过'）；涡波×莉帕『致亲爱的一闪』亦为共鸣魔法；缇亚×玛利亚组合超脱常规共鸣（'升华到另一种境界的两个魔法互相组合'）：玛利亚『Flame·决战炎域』+『Firefly』提供火焰索敌/火轮枪身/反光板弹道引导，缇亚以『FlameArrow』（镭射级/『FlameArrow·散花』弹幕）贯穿；战果=以队伍为中心半径1公里瞬时清场、MP消耗仅个位数、玛利亚索敌不亚于『Dimension』；涡波命名共鸣</data></node>
    <node id="决斗宣誓与魔石线记录"><data key="name">决斗宣誓与魔石线记录</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">在大国的『魔石线』上做出决斗宣言即于该国留下记录——违誓被定为毁约重犯遭通缉；迷宫『正道』上亦敷有魔石线可用；正道附近斗殴即时暴露（警备稽查再证）；如果在大国的『魔石线』上做出决斗的宣言的话，那就会在该国留下记录。</data></node>
    <node id="咏唱改写原理(致亲爱的一闪的诞生)"><data key="name">咏唱改写原理(致亲爱的一闪的诞生)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">亡灵一闪的再现失败（非己咏唱=伪物/无构筑眉目）→莉帕逆流补全拼图（二人眼中的诺文人生合流：出身才能剑皆致孤独/被道具般利用至破灭/死后仍被强制战斗）→不改完全再现而改写（二人都希望改变诺文的人生）→新咏唱『被世界拒绝的剑啊！由我们来继承』=人生修改的意志宣示——魔法名亦改=升华；「——『被世界拒绝的剑啊』！『由我们来继承』——！！」；因为我和莉帕都希望将诺文的人生予以改变。</data></node>
    <node id="诺斯菲的留恋真目（据其自述·存疑）"><data key="name">诺斯菲的留恋真目（据其自述·存疑）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据诺斯菲声称：留恋=『说任性的话』——生前从未说过任性话，只要能化解那份怨念便怎样都好；『犯错』=对至今为止『正确的事』的否定（只要去『否定』就足够）；本次解消『并非全部』；其生前被冠以『圣女』『偶像』『御旗』『精灵』之称（其自嘲语）。可信度存疑：莱纳断言全是假话、涡波存疑——见同名伏笔条；「啊哈哈。正是，虽然并非全部，但看来确实如此。这样一来，我终于明白了。自己真正的留恋、它的『真面目』究竟是什么」；「看起来是这样的，涡波大人。对我来说所谓的『犯错』，只是对至今为止的『正确的事』进行否定罢了。没错，只要去『否定』就足够了⋯⋯」；我这种人居然也能称什么『圣女』做什么『偶像』、叫什么『御旗』说什</data></node>
    <node id="涡波失忆与『重新来过』的起源"><data key="name">涡波失忆与『重新来过』的起源</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">时代与时代相联结：千年后（对现在的涡波而言是几周前的事），『涡波（我）』在黑暗的回廊中、自己打造的迷宫中醒来——明明是自己打造的『迷宫』却像是被拐进来一样畏惧着，搞不懂发生了什么、半狂乱状态下四处逃窜，又一次开始『重新来过』；失忆的原因=不完全的『记忆』（勒伽西背刺致计划不完全执行）；涡波自认'──不，这就是我自己的事情啊。已经毫无疑问了'（当前涡波与始祖涡波的同一性自觉——存疑，与相川涡波/始祖涡波关系候选挂接留终审，判例1）；也是我失去了记忆的原因。；在黑暗的回廊中，在自己打造的迷宫中醒来的『涡波（我）』；简直就像是第一次迷失在异世界中一样的涡波，又一次开始『重新来过』</data></node>
    <node id="技能『？？？』的情感处理真相与感情返还"><data key="name">技能『？？？』的情感处理真相与感情返还</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波被『？？？』夺去的不仅仅只有负面的感情——每次使用时对阳滝的感情都会被削减；该技能那过于合理的情感处理源于『始祖涡波』的后悔（为了不再重复同样的错误、不再给缇娅拉添麻烦，他决定在抵达最深部之前适当减轻对阳滝的感情）；『最深部之誓约者』可行感情的返还（而非废弃）——返还后的兄妹爱使『涡波』与『阳滝』产生亲和、转变为抵达『次元之理』的『力量』；我被『？？？』夺去的不仅仅只有负面的感情。；事到如今我才意识到。这个技能那过于合理的情感处理源于『始祖涡波』的后悔。为了不再重复同样的错误，为了不再给缇娅拉添麻烦，他决定在抵达最深部之前，适当减轻对阳滝的感情。；那是每次使用技能『？？？』的时候，都会被削</data></node>
    <node id="城市边缘无底悬崖与永久『连接』门"><data key="name">城市边缘无底悬崖与永久『连接』门</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫内侧城市边缘=大地延展中断的悬崖，环绕全城；崖下深不见底黑暗（掷石无声吞没、无回声）；远观如城市漂浮于黑色天空；崖边矗立显眼的紫色『连接』——完成度异常：密度远高于涡波所造之门、无散溃感，系以高位次元魔术『连接』为基础、辅以更高位次元魔术连同空间固定的强化版，永远镇座无人能毁；穿门即经次元跳跃从迷宫内侧到表侧；这座城市的边缘──亦即大地的延展就在这里中断，化作了悬崖。；悬崖将整个城市环绕起来。从远处望向这里的话，看到的估计是一幅一座城市漂浮在黑色的天空中的景象吧。；而在悬崖边上，矗立着一道相当显眼的紫色的『连接』</data></node>
    <node id="大自然怪物增殖（ch223）"><data key="name">大自然怪物增殖（ch223）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">与迷宫不同，在大自然中怪物数量可增殖到敌人总数过千的程度（『维度』探测直证）；用『维度』探测过后，我发现敌人的总数过千。；跟迷宫不同，在大自然中的怪物数量居然可以增殖到这种地步。</data></node>
    <node id="西斯与守护者的MP可见性差异"><data key="name">西斯与守护者的MP可见性差异</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">跟守护者不同，西斯MP减少的状况可以用『表示』看到——本章奇袭战以此为计时依据（30秒/15秒/数秒递推至归零）；守护者侧无此可见性；而且跟守护者不同，西斯MP减少的状况是可以用『表示』看到的。</data></node>
    <node id="艾尔米拉德的魔法剑技一体战术"><data key="name">艾尔米拉德的魔法剑技一体战术</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">浑然一体的柔软剑技+高速释放魔法（一切行动经理论打磨无多余）：Ice·Phalanx（捏碎佩饰道具发射冰桩）/LightingLine（紫电）/WindBurst（无咏唱强风）/AquaSpread（席卷地面水魔法）/FlameArrow（火矢）/Impulse（脚尖道具振动魔法）；等级20·骑士·魔力18.10·敏捷7.29；被夺剑后转体术打击战；魔法道具连携=其即发魔法的实体载体；艾尔米拉德的强大就在于他那浑然一体的柔软剑技和高速释放的魔法。一切的行动都经过了理论的打磨，丝毫没有多余。；艾尔米拉德理所当然地准备好了对策。他捏碎了身上戴着的魔法道具，将已经完成的冰结魔法射向我。；力量4.79</data></node>
    <node id="『魔石人类』（曝光后）"><data key="name">『魔石人类』（曝光后）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">国家隐匿的魔法技术被艾德曝光→『魔石人类』研究院一齐崩溃、引发大混乱（约半年前——据拉古涅）；弗茨亚茨其后仍从艾德买取技术继续产出（四侍女=技术结晶，据斐勒卢托自白）；因为艾德曝光了这件事的缘故，『魔石人类』的研究院一齐崩溃而引发了大混乱呢；这里的『魔石人类』们就是那些技术的结晶</data></node>
    <node id="佩艾希亚千年前史合证（史书·英雄谭·学者手记）"><data key="name">佩艾希亚千年前史合证（史书·英雄谭·学者手记）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据藏书室史书与英雄谭（本国史书，涡波持'权且一看'保留态度）：北方诸国趋亡时被唤作『支配之王』的少女登场，北方击退南方侵略→数年和平→南方重整反扑（涡波判读=千年前爆发的大战）；年表载雷纳尔多・沃尔斯率军多胜。据英雄谭：罗德・缇缇=大陆北方边境出生的弃儿→被双亲舍弃→隐居老夫妇收养→老夫妇死于南军士兵→幼年以谋略击退南军→孤儿院收养（邂逅未来将星/艾德在列）→城堡『庭师』→率孤儿院同伴夺回被占城池→取代殉国王族改号『王（Lord）』→凭稀世魔法才能与王者气质四处征战→'罗德体内流着北方传说中最古老悠久的王族的血'被公之于众→万民俯伏，王中之王『支配之王』诞生→'『罗德/Lord』的永恒之战正式</data></node>
    <node id="缇亚的超规格魔法战力(本章实证)"><data key="name">缇亚的超规格魔法战力(本章实证)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">FlameArrow 初速肉眼难追→斯诺手背挡开后流弹数道龟裂『魔石线』结界（比战争用结界花费更多时间金钱/集结数名魔法使也无法伤其分毫的本应级别）；Divine·Wall 光壁完全防御 Dragon·Ardor；Divine·Arrow+Divine·Wall 魔法相杀；拉丝缇娅拉评：斯诺虽也是世界最高级魔法使，但相比缇亚还是差的太多；Symposion·Noah 巨大光球/DivineArrow・ShineLine 光箭雨/FireArrow·散花 火雨；他们会慌张也是当然的。毕竟这比在战争中使用的结界花费了更多的时间和金钱。就算集结数名娴熟的魔法使也绝对无法打出一点伤痕——本应如此。；但</data></node>
    <node id="罗德的千年史(史书·英雄谭·学者手记合证)"><data key="name">罗德的千年史(史书·英雄谭·学者手记合证)</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据佩艾希亚史料（雷纳尔多评史书'光是看一下上面的年表就能感到满是瑕疵'）：北方诸国趋亡时『支配之王（Lord）』现身、北方团结于『北方同盟』战旗之下击退南方侵略→数年和平→南方重组『南方联盟』反扑；英雄谭：罗德=大陆北方边境出生的弃儿→被双亲舍弃→隐居老夫妇收养→老夫妇死于丧尽天良的南军士兵→幼年即以谋略击退南军→孤儿院收养（邂逅未来将星、艾德在列）→一座城堡的『庭师』→战时率孤儿院同伴夺回被占城池→告别庭师改号『王（Lord）』→北方四处征战捷报频传→'罗德体内流着北方传说中最古老悠久的王族的血'被公开→万民俯伏、王中之王『支配之王』诞生→'『罗德/Lord』的永恒之战正式开幕'（至此无始祖</data></node>
    <node id="圣柯尔库堡魔法部队（ch222）"><data key="name">圣柯尔库堡魔法部队（ch222）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">圣柯尔库堡所属部队（职务组织称呼，无专名，R6 规则2 抽取）：全员习得付代价的『咏唱』；一名士官主动请命率队替斯诺分忧（『沃克代理司令殿下！这次的事还是交给我们魔法部队去处理吧！』）被驳回；其人先前对年少斯诺升任代理司令颇有微词、如今态度今非昔比；「沃克代理司令殿下！这次的事还是交给我们魔法部队去处理吧！」；他先前虽然对比自己年少的斯诺大人升任代理司令一事颇有微词，但现在的态度已是今非昔比。对斯诺大人的健康状况感到担心的他表示愿意率队替她分忧。</data></node>
    <node id="迷宫31层：沙海环境与经验值经济"><data key="name">迷宫31层：沙海环境与经验值经济</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">31层为沙海阶层：宝石鱼自沙中隆起处以背鳍外露方式接近（WEB版怪名）；怪物经验值很高——'只要打倒一匹，就能让玛利亚获得1000点左右的经验值'；10级以下的必要经验值'基本上也就几万'，级别平衡耗时短；本次探索主要目的=将级别平衡（先拔高玛利亚级别）；沙海中的一处隆起。宝石鱼像鲨鱼一样露出背鳍向我们逼近。；所幸，31层的怪物经验值很高。只要打倒一匹，就能让玛利亚获得1000点左右的经验值。10级以下的必要经验值基本上也就几万，花不了多少时间。</data></node>
    <node id="魔法命名理论（喊名=代价+想像辅助）"><data key="name">魔法命名理论（喊名=代价+想像辅助）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">基督的独有主张（自称'人生的经验'传授）：将刻意喊出魔法名当成类似『咏唱』的东西、把喊名当成『代价』；'毕竟魔法最重要的就是想像'——喊名+注音（书本注音）令脑海浮现字义、辅助想像，可使魔法效果产生很大变化；'我就用这个方法开发出了各种各样的魔法'，自称'源自莱文教的『始祖』的名正言顺有理有据的魔法运用'；劝莱纳脱教科书统一名束缚（'总不能永远被那些千篇一律的东西束缚'、'我们早就脱离学生的级别了'）；动机自辩=攸关性命的情报分享而非私欲；实证=莱纳喊『风刃剑』后效果提升；「就像一种类似于『咏唱』的东西啦。将刻意喊出名字这点当成『代价』。大概、估计、一定」；顺带一说我就用这个方法开发出了各种各</data></node>
    <node id="『血』与『魂』人格观（ch71·据拉丝缇娅拉/玛利亚）"><data key="name">『血』与『魂』人格观（ch71·据拉丝缇娅拉/玛利亚）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">人之所以为人最关键是『血』与『魂』（玛利亚口述·旧时代用语）；圣人缇娅拉注重血与魂的转移；只有记忆说不上『再诞』；据此判定海莉≠海因（其血与魂跟海因相比太过异质）；涡波内心保留异议（原世界价值观中记忆是生存证明）；「正常来说就是那么一回事哦，涡波先生。人之所以为人，最关键的就是『血』与『魂』。」；「没错没错。所以，我们的圣人缇娅拉才会那么注重『血』与『魂』的转移哦。……不过，海莉那孩子的『血』和『魂』跟海因相比都太过异质了。」；「不不，只有记忆的话说不上『再诞』的吧……？」</data></node>
    <node id="冰结魔法（涡波初始体系）"><data key="name">冰结魔法（涡波初始体系）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">涡波初始即会的魔法体系之一（'一开始就会冰结魔法和次元魔法，素质也是颇受优待'——其安排与理由即涡波起源疑问的一部分，'我·已·经·快·要·得·出·答·案·了'）；精细应用：依原世界知识判明鱼类眷属游动必要部位、仅冻结该部位瘫痪之（非冻结整片水域）；'没有内核的冰结魔法'=仅作框架的共魔法构筑法（单人使用无意义、待共鸣者灌注——Ice·Aegis之基）；对伽鲁夫纳多杰里：冰结魔法侵蚀使其'已经没有任何保护核心的手段'；一开始就会冰结魔法和次元魔法，素质也是颇受优待。；再利用冰结魔法将部位冻结起来阻碍它们的行动而已。；接着我发动了没有内核的冰结魔法。是只有我一个人使用的话便没有任何意义，仅仅作为</data></node>
    <node id="『风之铳剑』"><data key="name">『风之铳剑』</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇缇（罗德）的武器：败北时以'和小孩子胡闹无异的动作'高举砸下、乱挥（'她的攻击里已经没有任何的技术。当然也没有风魔法的应用。只是小孩子在胡闹而已'）；被涡波的《新月琉璃》正面交锋斩断后化作风就此消散；接着，她以和小孩子胡闹无异的动作高举手中的铳剑，就像要确认我的存在那般砸了下来。；她的攻击里已经没有任何的技术。当然也没有风魔法的应用。；被斩断的铳剑化作风就此消散。</data></node>
    <node id="赫勒比勒夏因之神圣双剑"><data key="name">赫勒比勒夏因之神圣双剑</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">银白色光辉的成对圣剑（每柄称『片翼』）；丧失的片翼于本章备齐：一柄经次元魔术自虚空拔出、一柄自莱纳腰间拔出，由两条风之臂持用；四剑（与阿雷亚斯家的宝剑诺文、Sylph・堕落使徒合计）各有明确意志与敌视诺斯菲的意向、抵抗其光的感染；剑主被诺斯菲指认为阿雷亚斯/兰斯/赫勒比勒夏因三骑士；──如今，丧失了片翼的圣双剑在此备齐。；「哈⋯⋯、哈哈哈哈！原来是这么回事啊！另一把『片翼』原来是在海莉小姐手上吗！不对、是在我体内吗！！」；此时已经有另一条新的风之臂在另一侧的肩膀上生成。生成之后它立即将我腰间那把备用的剑拔出。</data></node>
    <node id="『魔法相杀』效果节制律（ch119）"><data key="name">『魔法相杀』效果节制律（ch119）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">'『魔法相杀』的效果，受见没见过对象魔法的节制很大'——对第一次看到的魔法以『次元之冬』妨碍较难；对手渐习惯后构筑破绽收窄、可乘间隙反打；若构筑无破绽则相杀不可用（涡波语：'如果构筑没有破绽的话我就用不了这招了'）；还不是你的魔法构筑太嫩的锅。这个对决规则的话，我用『魔法相杀』不是合情合理的么；对第一次看到的魔法使用『次元之冬』妨碍会比较难。加上拉丝缇娅拉渐渐习惯了『魔法相杀』，魔法构筑的破绽越来越小。；『魔法相杀』的效果，受见没见过对象魔法的节制很大。</data></node>
    <node id="魔法道具版『连接』不受世界奉还阵影响"><data key="name">魔法道具版『连接』不受世界奉还阵影响</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">海莉咏唱『连接』并捏碎作为魔法道具的戒指，打造出翠绿色的魔法门；此门'并没有受到『世界奉还阵』的影响而消失'、状态稳定（涡波推测'是因为使用了魔法道具的原因'）；用途=将晕倒的玛利亚送至安全地带（近名警示：与『链接』(ch144)、『联结』(ch49莉帕纹样)为变体，照录原文写法、归并留终审【待确认】）；她捏碎了一个作为魔法道具的戒指，打造出翠绿色的魔法门。；这道『连接』的魔法并没有受到『世界奉还阵』的影响而消失。</data></node>
    <node id="36层"><data key="name">36层</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">迷宫36层：浅滩回廊（'不再是遍布整个回廊的水，而是浅滩'），水位较34层高许多；水从墙壁涌出、到处生长水草；35→36层阶梯为漩涡瀑布状（无法反抗重力、被35层的水吞没，'像被掷到地上一样着了陆'）；敌人级别提升但探索难度与往常无异；小个子成员（缇亚/莉帕）身高不足基本靠游泳前进；在36层等待着我们的，不再是遍布整个回廊的水，而是浅滩。；没有连续两层都要持续水中探索真是太好了。不过跟34层的水位比起来36层要高上许多。；水从墙壁里涌出，到处生长着水草。</data></node>
    <node id="风之臂"><data key="name">风之臂</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">自莱纳体内强风收束而成的手臂状存在：肩部成臂、与莱纳意思相通、仅作攻击辅助；由化为风的复数魔力（含一名令莱纳怀念的女性之声）融合而成；经破碎的次元戒指发动次元属性魔法、自虚空拔出圣剑片翼；两臂各持一柄片翼并独立释放魔法；风以我的肩膀为支点开始收束，最终获得了形体。；风构成的形状为『手臂』；风之臂为了抓住目瞪口呆的诺斯菲而采取了行动。慑于这诡异的手臂，诺斯菲纵身一跳拉开了与我之间的距离。</data></node>
    <node id="缇亚的身世"><data key="name">缇亚的身世</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">天生拥有大量魔力+背后一对纤小羽翼（非纯正人类）；母亲诞其时视作恶魔、双亲弃养送教会；神父尊为使徒养育；十岁悟孤独；国家以歉收为口实征收，辗转权贵展示奇迹；归乡见弟弟受宠→『我（私）』之死与叛逃；不仅如此，我的身体也有别于普通人，在背后长有一对纤小的羽翼。我似乎并不是一个纯正的人类。</data></node>
    <node id="『魔石』=力量核心体系与拔石战法"><data key="name">『魔石』=力量核心体系与拔石战法</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">在这个异世界『魔石』就是力量的核心；『失去了自身魔石的怪物面临的结局只有一个』（巨体透明化转为光芒而消亡）；最高明的战斗方式=瓦解核心——涡波：『在理解了这个世界的构造之后，就再也不需要什么华丽的魔法了啊。只要钻到敌人背后拔除魔石就够了』；确信『不会再输给只有力量强大的怪物』，同时自觉『好不容易来到了剑与魔法的世界，我却要使用作弊招数一路通关』的一抹空虚；失去了自身魔石的怪物面临的结局只有一个。；「⋯⋯在理解了这个世界的构造之后，就再也不需要什么华丽的魔法了啊。只要钻到敌人背后拔除魔石就够了」；在这个异世界中『魔石』就是力量的核心。</data></node>
    <node id="奈落之底"><data key="name">奈落之底</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">草原坡道尽头绝壁之底的洞穴：前后左右被石壁包围、地面岩石构成、有无数普通石子滚落其中——'既不许生亦不许死的黑暗『地狱』'；罗德在此寻宝数十年数百年、被囚整整一千年，至内心与自我相继崩溃发笑，自认人生终点即此；'深渊/地狱/洞穴'为描述语不另登记别名；最终坡道化作了一道绝壁，而我就在上面向下坠落、坠落──然后狠狠地撞到了奈落之底，我就那样连打了好几个滚。；我最终坠落的地方，是一个前后左右都被石壁包围起来的洞穴。；就这样──过去了一・千・年。</data></node>
    <node id="佩艾希亚天上魔石的正体（魂·可被唤回为人）"><data key="name">佩艾希亚天上魔石的正体（魂·可被唤回为人）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据涡波对照记忆的确信：王近卫骑士团五骑魔力的光芒与曾在佩艾希亚天空闪烁的魔石淡薄光芒一模一样——「那魔力的光辉──不，这魔石（魂）的光辉我曾经见过」；他们到昨天为止还作为魔石漂浮在天空（「和平的世界不需要带剑的骑士」）；由罗德与诺斯菲扭曲时间轴唤回现世。天上魔石=魂、可还原为人——本章首示的关键机制事实；那魔力的光辉──不，这魔石（魂）的光辉我曾经见过。；他们魔力的光芒和那些魔石当时在天上闪烁着的淡薄光芒一模一样。；他们到昨天为止还作为魔石漂浮在天空。和平的世界不需要带剑的骑士，这也是理所当然的。</data></node>
    <node id="拉丝缇娅拉公开说法（大圣堂回归传闻·ch210）"><data key="name">拉丝缇娅拉公开说法（大圣堂回归传闻·ch210）</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">据日樱等酒馆听闻的说法：基督君当初因担心拉丝缇娅拉大人作为现人神的生活太过不自由而在大圣堂将她劫走，其后与弗茨亚茨的神官们交涉要求改变其待遇；拉丝缇娅拉大人在尽情体验过外面的世界之后接受了自己的使命回到大圣堂、现致力于完成那份使命。涡波判'基本都是胡扯的'、但作为对那个事件的矫饰不失妥当；基督君你当初不是因为担心拉丝缇娅拉大人作为现人神的生活太过不自由，所以才在大圣堂将她劫走了么？；基本都是胡扯的。；就是拉丝缇娅拉重新回到了弗茨亚茨，甚至与之协作共事这点。</data></node>
    <node id="守护者战斗特性"><data key="name">守护者战斗特性</data><data key="type">setting</data><data key="status">provisional</data><data key="desc">缇达型守护者：变形战斗体（双刀/大锤/液化自由转换）、可多次死亡复活（『死了两次』）、被冰冻部分无法液化恢复、精神魔法特化（操纵人内心的黑暗）；泥接触为强效魔法发动前提；对『冷静/假动作/判断力/观察力』评价高于蛮力；「虽然你的力量也不可小觑，但最棘手的还是那份『冷静』、『假动作』、『判断力』、『观察力』。」</data></node>
